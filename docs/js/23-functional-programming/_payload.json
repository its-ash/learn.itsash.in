[{"data":1,"prerenderedAt":919},["ShallowReactive",2],{"page-\u002Fjs\u002F23-functional-programming":3},{"id":4,"title":5,"body":6,"description":27,"extension":913,"meta":914,"navigation":125,"path":915,"seo":916,"stem":917,"__hash__":918},"content\u002Fjs\u002F23-functional-programming.md","23 — Functional Programming",{"type":7,"value":8,"toc":905},"minimark",[9,13,18,274,278,282,514,516,520,535,548,565,574,580,584,605,620,660,672,685,689,692,829,878,882,901],[10,11,5],"h1",{"id":12},"_23-functional-programming",[14,15,17],"h2",{"id":16},"core-principles","Core Principles",[19,20,22],"code-wrapper",{"language":21},"javascript",[23,24,28],"pre",{"className":25,"code":26,"language":21,"meta":27,"style":27},"language-javascript shiki shiki-themes github-light github-dark","\u002F\u002F Pure functions — same input → same output, no side effects\nconst pure = (a, b) => a + b          \u002F\u002F ✅ pure\nconst impure = (a) => a + Math.random() \u002F\u002F ❌ impure (random)\n\n\u002F\u002F Immutability — don't mutate, create new\nconst add = (arr, val) => [...arr, val]    \u002F\u002F ✅ new array\nconst badAdd = (arr, val) => { arr.push(val); return arr }  \u002F\u002F ❌ mutates\n\n\u002F\u002F Composition — build from small functions\nconst pipe = (...fns) => x => fns.reduce((v, f) => f(v), x)\n","",[29,30,31,40,86,120,127,133,169,209,214,220],"code",{"__ignoreMap":27},[32,33,36],"span",{"class":34,"line":35},"line",1,[32,37,39],{"class":38},"sdCPZ","\u002F\u002F Pure functions — same input → same output, no side effects\n",[32,41,43,47,51,54,58,62,65,68,71,74,77,80,83],{"class":34,"line":42},2,[32,44,46],{"class":45},"svdQ7","const",[32,48,50],{"class":49},"sIsaT"," pure",[32,52,53],{"class":45}," =",[32,55,57],{"class":56},"ssxIu"," (",[32,59,61],{"class":60},"sCrzJ","a",[32,63,64],{"class":56},", ",[32,66,67],{"class":60},"b",[32,69,70],{"class":56},") ",[32,72,73],{"class":45},"=>",[32,75,76],{"class":56}," a ",[32,78,79],{"class":45},"+",[32,81,82],{"class":56}," b          ",[32,84,85],{"class":38},"\u002F\u002F ✅ pure\n",[32,87,89,91,94,96,98,100,102,104,106,108,111,114,117],{"class":34,"line":88},3,[32,90,46],{"class":45},[32,92,93],{"class":49}," impure",[32,95,53],{"class":45},[32,97,57],{"class":56},[32,99,61],{"class":60},[32,101,70],{"class":56},[32,103,73],{"class":45},[32,105,76],{"class":56},[32,107,79],{"class":45},[32,109,110],{"class":56}," Math.",[32,112,113],{"class":49},"random",[32,115,116],{"class":56},"() ",[32,118,119],{"class":38},"\u002F\u002F ❌ impure (random)\n",[32,121,123],{"class":34,"line":122},4,[32,124,126],{"emptyLinePlaceholder":125},true,"\n",[32,128,130],{"class":34,"line":129},5,[32,131,132],{"class":38},"\u002F\u002F Immutability — don't mutate, create new\n",[32,134,136,138,141,143,145,148,150,153,155,157,160,163,166],{"class":34,"line":135},6,[32,137,46],{"class":45},[32,139,140],{"class":49}," add",[32,142,53],{"class":45},[32,144,57],{"class":56},[32,146,147],{"class":60},"arr",[32,149,64],{"class":56},[32,151,152],{"class":60},"val",[32,154,70],{"class":56},[32,156,73],{"class":45},[32,158,159],{"class":56}," [",[32,161,162],{"class":45},"...",[32,164,165],{"class":56},"arr, val]    ",[32,167,168],{"class":38},"\u002F\u002F ✅ new array\n",[32,170,172,174,177,179,181,183,185,187,189,191,194,197,200,203,206],{"class":34,"line":171},7,[32,173,46],{"class":45},[32,175,176],{"class":49}," badAdd",[32,178,53],{"class":45},[32,180,57],{"class":56},[32,182,147],{"class":60},[32,184,64],{"class":56},[32,186,152],{"class":60},[32,188,70],{"class":56},[32,190,73],{"class":45},[32,192,193],{"class":56}," { arr.",[32,195,196],{"class":49},"push",[32,198,199],{"class":56},"(val); ",[32,201,202],{"class":45},"return",[32,204,205],{"class":56}," arr }  ",[32,207,208],{"class":38},"\u002F\u002F ❌ mutates\n",[32,210,212],{"class":34,"line":211},8,[32,213,126],{"emptyLinePlaceholder":125},[32,215,217],{"class":34,"line":216},9,[32,218,219],{"class":38},"\u002F\u002F Composition — build from small functions\n",[32,221,223,225,228,230,232,234,237,239,241,244,247,250,253,256,259,261,264,266,268,271],{"class":34,"line":222},10,[32,224,46],{"class":45},[32,226,227],{"class":49}," pipe",[32,229,53],{"class":45},[32,231,57],{"class":56},[32,233,162],{"class":45},[32,235,236],{"class":60},"fns",[32,238,70],{"class":56},[32,240,73],{"class":45},[32,242,243],{"class":60}," x",[32,245,246],{"class":45}," =>",[32,248,249],{"class":56}," fns.",[32,251,252],{"class":49},"reduce",[32,254,255],{"class":56},"((",[32,257,258],{"class":60},"v",[32,260,64],{"class":56},[32,262,263],{"class":60},"f",[32,265,70],{"class":56},[32,267,73],{"class":45},[32,269,270],{"class":49}," f",[32,272,273],{"class":56},"(v), x)\n",[275,276,277],"p",{},"::",[14,279,281],{"id":280},"immutability-patterns","Immutability Patterns",[19,283,284],{"language":21},[23,285,287],{"className":25,"code":286,"language":21,"meta":27,"style":27},"\u002F\u002F Array — non-mutating alternatives\nconst arr = [1, 2, 3]\nconst added = [...arr, 4]           \u002F\u002F instead of push\nconst removed = arr.filter(x => x !== 2)  \u002F\u002F instead of splice\nconst updated = arr.map(x => x === 2 ? 20 : x)  \u002F\u002F instead of arr[1] = 20\n\n\u002F\u002F Object — non-mutating updates\nconst user = { name: 'Alice', age: 30 }\nconst updated = { ...user, age: 31 }  \u002F\u002F shallow update\nconst { age, ...rest } = user          \u002F\u002F delete key (age removed from rest)\n",[29,288,289,294,322,347,385,427,431,436,461,486],{"__ignoreMap":27},[32,290,291],{"class":34,"line":35},[32,292,293],{"class":38},"\u002F\u002F Array — non-mutating alternatives\n",[32,295,296,298,302,304,306,309,311,314,316,319],{"class":34,"line":42},[32,297,46],{"class":45},[32,299,301],{"class":300},"snvgF"," arr",[32,303,53],{"class":45},[32,305,159],{"class":56},[32,307,308],{"class":300},"1",[32,310,64],{"class":56},[32,312,313],{"class":300},"2",[32,315,64],{"class":56},[32,317,318],{"class":300},"3",[32,320,321],{"class":56},"]\n",[32,323,324,326,329,331,333,335,338,341,344],{"class":34,"line":88},[32,325,46],{"class":45},[32,327,328],{"class":300}," added",[32,330,53],{"class":45},[32,332,159],{"class":56},[32,334,162],{"class":45},[32,336,337],{"class":56},"arr, ",[32,339,340],{"class":300},"4",[32,342,343],{"class":56},"]           ",[32,345,346],{"class":38},"\u002F\u002F instead of push\n",[32,348,349,351,354,356,359,362,365,368,370,373,376,379,382],{"class":34,"line":122},[32,350,46],{"class":45},[32,352,353],{"class":300}," removed",[32,355,53],{"class":45},[32,357,358],{"class":56}," arr.",[32,360,361],{"class":49},"filter",[32,363,364],{"class":56},"(",[32,366,367],{"class":60},"x",[32,369,246],{"class":45},[32,371,372],{"class":56}," x ",[32,374,375],{"class":45},"!==",[32,377,378],{"class":300}," 2",[32,380,381],{"class":56},")  ",[32,383,384],{"class":38},"\u002F\u002F instead of splice\n",[32,386,387,389,392,394,396,399,401,403,405,407,410,412,415,418,421,424],{"class":34,"line":129},[32,388,46],{"class":45},[32,390,391],{"class":300}," updated",[32,393,53],{"class":45},[32,395,358],{"class":56},[32,397,398],{"class":49},"map",[32,400,364],{"class":56},[32,402,367],{"class":60},[32,404,246],{"class":45},[32,406,372],{"class":56},[32,408,409],{"class":45},"===",[32,411,378],{"class":300},[32,413,414],{"class":45}," ?",[32,416,417],{"class":300}," 20",[32,419,420],{"class":45}," :",[32,422,423],{"class":56}," x)  ",[32,425,426],{"class":38},"\u002F\u002F instead of arr[1] = 20\n",[32,428,429],{"class":34,"line":135},[32,430,126],{"emptyLinePlaceholder":125},[32,432,433],{"class":34,"line":171},[32,434,435],{"class":38},"\u002F\u002F Object — non-mutating updates\n",[32,437,438,440,443,445,448,452,455,458],{"class":34,"line":211},[32,439,46],{"class":45},[32,441,442],{"class":300}," user",[32,444,53],{"class":45},[32,446,447],{"class":56}," { name: ",[32,449,451],{"class":450},"sJ6F3","'Alice'",[32,453,454],{"class":56},", age: ",[32,456,457],{"class":300},"30",[32,459,460],{"class":56}," }\n",[32,462,463,465,467,469,472,474,477,480,483],{"class":34,"line":216},[32,464,46],{"class":45},[32,466,391],{"class":300},[32,468,53],{"class":45},[32,470,471],{"class":56}," { ",[32,473,162],{"class":45},[32,475,476],{"class":56},"user, age: ",[32,478,479],{"class":300},"31",[32,481,482],{"class":56}," }  ",[32,484,485],{"class":38},"\u002F\u002F shallow update\n",[32,487,488,490,492,495,497,499,502,505,508,511],{"class":34,"line":222},[32,489,46],{"class":45},[32,491,471],{"class":56},[32,493,494],{"class":300},"age",[32,496,64],{"class":56},[32,498,162],{"class":45},[32,500,501],{"class":300},"rest",[32,503,504],{"class":56}," } ",[32,506,507],{"class":45},"=",[32,509,510],{"class":56}," user          ",[32,512,513],{"class":38},"\u002F\u002F delete key (age removed from rest)\n",[275,515,277],{},[14,517,519],{"id":518},"tips-tricks","💡 Tips & Tricks",[275,521,522,526,527,530,531,534],{},[523,524,525],"strong",{},"Memoize pure functions for free performance"," — Since a pure function's output only depends on its input, you can cache results in a ",[29,528,529],{},"Map"," keyed by arguments: ",[29,532,533],{},"const memo = new Map(); const cached = x => memo.has(x) ? memo.get(x) : memo.set(x, fn(x)).get(x)",". This is only safe because there are no side effects to worry about.",[275,536,537,543,544,547],{},[523,538,539,542],{},[29,540,541],{},"Object.freeze"," enforces immutability at runtime"," — ",[29,545,546],{},"const config = Object.freeze({ url: '...' })"," throws (in strict mode) or silently fails (non-strict) on mutation attempts — useful for catching accidental mutation bugs during development.",[275,549,550,543,553,556,557,560,561,564],{},[523,551,552],{},"Point-free style reads like a pipeline",[29,554,555],{},"const getNames = arr => arr.map(u => u.name)"," can become ",[29,558,559],{},"const getNames = arr => arr.map(prop('name'))"," with a small ",[29,562,563],{},"prop"," helper, making transformations read declaratively instead of imperatively.",[275,566,567,543,570,573],{},[523,568,569],{},"Currying enables partial application for reuse",[29,571,572],{},"const multiply = a => b => a * b; const double = multiply(2)"," — turns a generic function into specialized, reusable ones without rewriting logic.",[275,575,576,579],{},[523,577,578],{},"Structural sharing keeps immutable updates cheap"," — Libraries like Immer let you \"mutate\" a draft while producing a new immutable object under the hood, avoiding the performance cost of deep-cloning large structures on every update.",[14,581,583],{"id":582},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[275,585,586,543,589,592,593,596,597,600,601,604],{},[523,587,588],{},"Spread only performs a shallow copy",[29,590,591],{},"const updated = { ...user, address: user.address }"," still shares the same nested ",[29,594,595],{},"address"," object — mutating ",[29,598,599],{},"updated.address.city"," also mutates the original ",[29,602,603],{},"user.address.city",", silently breaking the \"immutability\" you thought you had.",[275,606,607,543,612,615,616,619],{},[523,608,609,611],{},[29,610,541],{}," is shallow too",[29,613,614],{},"Object.freeze({ nested: { a: 1 } })"," prevents adding\u002Fremoving\u002Freassigning top-level keys, but ",[29,617,618],{},"frozen.nested.a = 2"," still works fine — nested objects are not frozen automatically.",[275,621,622,543,625,628,629,632,633,636,637,640,641,644,645,648,649,651,652,655,656,659],{},[523,623,624],{},"Array methods that look pure sometimes aren't",[29,626,627],{},".sort()"," and ",[29,630,631],{},".reverse()"," mutate the array ",[523,634,635],{},"in place"," and also return it, unlike ",[29,638,639],{},".map()","\u002F",[29,642,643],{},".filter()",". ",[29,646,647],{},"const sorted = arr.sort()"," looks immutable but actually reorders ",[29,650,147],{}," itself — use ",[29,653,654],{},"[...arr].sort()"," or the newer ",[29,657,658],{},"arr.toSorted()"," to avoid the mutation.",[275,661,662,543,668,671],{},[523,663,664,667],{},[29,665,666],{},"Math.random()"," inside a \"pure-looking\" arrow function breaks referential transparency",[29,669,670],{},"const roll = () => Math.random() > 0.5"," produces different results for identical (zero) input, so it can't be memoized or reasoned about like a true pure function, even though it takes no arguments and looks side-effect-free.",[275,673,674,543,681,684],{},[523,675,676,677,680],{},"Destructuring rest (",[29,678,679],{},"...rest",") to \"delete\" a key still copies everything else",[29,682,683],{},"const { password, ...safeUser } = user"," is a common pattern to strip sensitive fields, but on large objects this is an O(n) shallow copy every time — fine for typical use, but a hidden cost in hot loops over big records.",[14,686,688],{"id":687},"spot-the-bug","🧠 Spot the Bug",[275,690,691],{},"What does this log?",[19,693,694],{"language":21},[23,695,697],{"className":25,"code":696,"language":21,"meta":27,"style":27},"const original = { name: 'Alice', tags: ['admin', 'staff'] }\n\nfunction promote(user) {\n  const updated = { ...user, tags: user.tags }\n  updated.tags.push('superadmin')\n  return updated\n}\n\nconst promoted = promote(original)\nconsole.log(original.tags)\nconsole.log(promoted.tags)\n",[29,698,699,726,730,746,762,777,785,790,794,808,819],{"__ignoreMap":27},[32,700,701,703,706,708,710,712,715,718,720,723],{"class":34,"line":35},[32,702,46],{"class":45},[32,704,705],{"class":300}," original",[32,707,53],{"class":45},[32,709,447],{"class":56},[32,711,451],{"class":450},[32,713,714],{"class":56},", tags: [",[32,716,717],{"class":450},"'admin'",[32,719,64],{"class":56},[32,721,722],{"class":450},"'staff'",[32,724,725],{"class":56},"] }\n",[32,727,728],{"class":34,"line":42},[32,729,126],{"emptyLinePlaceholder":125},[32,731,732,735,738,740,743],{"class":34,"line":88},[32,733,734],{"class":45},"function",[32,736,737],{"class":49}," promote",[32,739,364],{"class":56},[32,741,742],{"class":60},"user",[32,744,745],{"class":56},") {\n",[32,747,748,751,753,755,757,759],{"class":34,"line":122},[32,749,750],{"class":45},"  const",[32,752,391],{"class":300},[32,754,53],{"class":45},[32,756,471],{"class":56},[32,758,162],{"class":45},[32,760,761],{"class":56},"user, tags: user.tags }\n",[32,763,764,767,769,771,774],{"class":34,"line":129},[32,765,766],{"class":56},"  updated.tags.",[32,768,196],{"class":49},[32,770,364],{"class":56},[32,772,773],{"class":450},"'superadmin'",[32,775,776],{"class":56},")\n",[32,778,779,782],{"class":34,"line":135},[32,780,781],{"class":45},"  return",[32,783,784],{"class":56}," updated\n",[32,786,787],{"class":34,"line":171},[32,788,789],{"class":56},"}\n",[32,791,792],{"class":34,"line":211},[32,793,126],{"emptyLinePlaceholder":125},[32,795,796,798,801,803,805],{"class":34,"line":216},[32,797,46],{"class":45},[32,799,800],{"class":300}," promoted",[32,802,53],{"class":45},[32,804,737],{"class":49},[32,806,807],{"class":56},"(original)\n",[32,809,810,813,816],{"class":34,"line":222},[32,811,812],{"class":56},"console.",[32,814,815],{"class":49},"log",[32,817,818],{"class":56},"(original.tags)\n",[32,820,822,824,826],{"class":34,"line":821},11,[32,823,812],{"class":56},[32,825,815],{"class":49},[32,827,828],{"class":56},"(promoted.tags)\n",[830,831,832,836,864],"details",{},[833,834,835],"summary",{},"Answer",[275,837,838,839,842,843,846,847,850,851,855,856,859,860,863],{},"Both log ",[29,840,841],{},"[\"admin\", \"staff\", \"superadmin\"]"," — the spread ",[29,844,845],{},"{ ...user, tags: user.tags }"," copies the ",[29,848,849],{},"tags"," ",[852,853,854],"em",{},"reference",", not the array itself, because spread is shallow. Pushing to ",[29,857,858],{},"updated.tags"," mutates the exact same array that ",[29,861,862],{},"original.tags"," points to, so the \"immutable-looking\" update leaks a mutation back into the original object.",[275,865,866,869,870,873,874,877],{},[523,867,868],{},"The lesson",": shallow copies only protect the top level — nested arrays and objects need their own copy (",[29,871,872],{},"[...user.tags]"," or ",[29,875,876],{},"structuredClone",") to be truly immutable.",[14,879,881],{"id":880},"key-takeaways","Key Takeaways",[883,884,885,889,892],"ul",{},[886,887,888],"li",{},"Pure functions are testable, cacheable, and predictable — prefer them.",[886,890,891],{},"Never mutate inputs — return new arrays\u002Fobjects (spread, map, filter).",[886,893,894,640,897,900],{},[29,895,896],{},"pipe",[29,898,899],{},"compose"," build complex logic from small focused functions.",[902,903,904],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font