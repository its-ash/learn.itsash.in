",[32,221,223,225,228,230,232,234,237,239,241,244,247,250,253,256,259,261,264,266,268,271],{"class":34,"line":222},10,[32,224,46],{"class":45},[32,226,227],{"class":49}," pipe",[32,229,53],{"class":45},[32,231,57],{"class":56},[32,233,162],{"class":45},[32,235,236],{"class":60},"fns",[32,238,70],{"class":56},[32,240,73],{"class":45},[32,242,243],{"class":60}," x",[32,245,246],{"class":45}," =>",[32,248,249],{"class":56}," fns.",[32,251,252],{"class":49},"reduce",[32,254,255],{"class":56},"((",[32,257,258],{"class":60},"v",[32,260,64],{"class":56},[32,262,263],{"class":60},"f",[32,265,70],{"class":56},[32,267,73],{"class":45},[32,269,270],{"class":49}," f",[32,272,273],{"class":56},"(v), x)\n",[14,275,277],{"id":276},"immutability-patterns","Immutability Patterns",[19,279,280],{"language":21},[23,281,283],{"className":25,"code":282,"language":21,"meta":27,"style":27},"\u002F\u002F Array — non-mutating alternatives\nconst arr = [1, 2, 3]\nconst added = [...arr, 4]           \u002F\u002F instead of push\nconst removed = arr.filter(x => x !== 2)  \u002F\u002F instead of splice\nconst updated = arr.map(x => x === 2 ? 20 : x)  \u002F\u002F instead of arr[1] = 20\n\n\u002F\u002F Object — non-mutating updates\nconst user = { name: 'Alice', age: 30 }\nconst updated = { ...user, age: 31 }  \u002F\u002F shallow update\nconst { age, ...rest } = user          \u002F\u002F delete key (age removed from rest)\n",[29,284,285,290,318,343,381,423,427,432,457,482],{"__ignoreMap":27},[32,286,287],{"class":34,"line":35},[32,288,289],{"class":38},"\u002F\u002F Array — non-mutating alternatives\n",[32,291,292,294,298,300,302,305,307,310,312,315],{"class":34,"line":42},[32,293,46],{"class":45},[32,295,297],{"class":296},"snvgF"," arr",[32,299,53],{"class":45},[32,301,159],{"class":56},[32,303,304],{"class":296},"1",[32,306,64],{"class":56},[32,308,309],{"class":296},"2",[32,311,64],{"class":56},[32,313,314],{"class":296},"3",[32,316,317],{"class":56},"]\n",[32,319,320,322,325,327,329,331,334,337,340],{"class":34,"line":88},[32,321,46],{"class":45},[32,323,324],{"class":296}," added",[32,326,53],{"class":45},[32,328,159],{"class":56},[32,330,162],{"class":45},[32,332,333],{"class":56},"arr, ",[32,335,336],{"class":296},"4",[32,338,339],{"class":56},"]           ",[32,341,342],{"class":38},"\u002F\u002F instead of push\n",[32,344,345,347,350,352,355,358,361,364,366,369,372,375,378],{"class":34,"line":122},[32,346,46],{"class":45},[32,348,349],{"class":296}," removed",[32,351,53],{"class":45},[32,353,354],{"class":56}," arr.",[32,356,357],{"class":49},"filter",[32,359,360],{"class":56},"(",[32,362,363],{"class":60},"x",[32,365,246],{"class":45},[32,367,368],{"class":56}," x ",[32,370,371],{"class":45},"!==",[32,373,374],{"class":296}," 2",[32,376,377],{"class":56},")  ",[32,379,380],{"class":38},"\u002F\u002F instead of splice\n",[32,382,383,385,388,390,392,395,397,399,401,403,406,408,411,414,417,420],{"class":34,"line":129},[32,384,46],{"class":45},[32,386,387],{"class":296}," updated",[32,389,53],{"class":45},[32,391,354],{"class":56},[32,393,394],{"class":49},"map",[32,396,360],{"class":56},[32,398,363],{"class":60},[32,400,246],{"class":45},[32,402,368],{"class":56},[32,404,405],{"class":45},"===",[32,407,374],{"class":296},[32,409,410],{"class":45}," ?",[32,412,413],{"class":296}," 20",[32,415,416],{"class":45}," :",[32,418,419],{"class":56}," x)  ",[32,421,422],{"class":38},"\u002F\u002F instead of arr[1] = 20\n",[32,424,425],{"class":34,"line":135},[32,426,126],{"emptyLinePlaceholder":125},[32,428,429],{"class":34,"line":171},[32,430,431],{"class":38},"\u002F\u002F Object — non-mutating updates\n",[32,433,434,436,439,441,444,448,451,454],{"class":34,"line":211},[32,435,46],{"class":45},[32,437,438],{"class":296}," user",[32,440,53],{"class":45},[32,442,443],{"class":56}," { name: ",[32,445,447],{"class":446},"sJ6F3","'Alice'",[32,449,450],{"class":56},", age: ",[32,452,453],{"class":296},"30",[32,455,456],{"class":56}," }\n",[32,458,459,461,463,465,468,470,473,476,479],{"class":34,"line":216},[32,460,46],{"class":45},[32,462,387],{"class":296},[32,464,53],{"class":45},[32,466,467],{"class":56}," { ",[32,469,162],{"class":45},[32,471,472],{"class":56},"user, age: ",[32,474,475],{"class":296},"31",[32,477,478],{"class":56}," }  ",[32,480,481],{"class":38},"\u002F\u002F shallow update\n",[32,483,484,486,488,491,493,495,498,501,504,507],{"class":34,"line":222},[32,485,46],{"class":45},[32,487,467],{"class":56},[32,489,490],{"class":296},"age",[32,492,64],{"class":56},[32,494,162],{"class":45},[32,496,497],{"class":296},"rest",[32,499,500],{"class":56}," } ",[32,502,503],{"class":45},"=",[32,505,506],{"class":56}," user          ",[32,508,509],{"class":38},"\u002F\u002F delete key (age removed from rest)\n",[14,511,513],{"id":512},"tips-tricks","💡 Tips & Tricks",[515,516,517,521,522,525,526,529],"p",{},[518,519,520],"strong",{},"Memoize pure functions for free performance"," — Since a pure function's output only depends on its input, you can cache results in a ",[29,523,524],{},"Map"," keyed by arguments: ",[29,527,528],{},"const memo = new Map(); const cached = x => memo.has(x) ? memo.get(x) : memo.set(x, fn(x)).get(x)",". This is only safe because there are no side effects to worry about.",[515,531,532,538,539,542],{},[518,533,534,537],{},[29,535,536],{},"Object.freeze"," enforces immutability at runtime"," — ",[29,540,541],{},"const config = Object.freeze({ url: '...' })"," throws (in strict mode) or silently fails (non-strict) on mutation attempts — useful for catching accidental mutation bugs during development.",[515,544,545,538,548,551,552,555,556,559],{},[518,546,547],{},"Point-free style reads like a pipeline",[29,549,550],{},"const getNames = arr => arr.map(u => u.name)"," can become ",[29,553,554],{},"const getNames = arr => arr.map(prop('name'))"," with a small ",[29,557,558],{},"prop"," helper, making transformations read declaratively instead of imperatively.",[515,561,562,538,565,568],{},[518,563,564],{},"Currying enables partial application for reuse",[29,566,567],{},"const multiply = a => b => a * b; const double = multiply(2)"," — turns a generic function into specialized, reusable ones without rewriting logic.",[515,570,571,574],{},[518,572,573],{},"Structural sharing keeps immutable updates cheap"," — Libraries like Immer let you \"mutate\" a draft while producing a new immutable object under the hood, avoiding the performance cost of deep-cloning large structures on every update.",[14,576,578],{"id":577},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[515,580,581,538,584,587,588,591,592,595,596,599],{},[518,582,583],{},"Spread only performs a shallow copy",[29,585,586],{},"const updated = { ...user, address: user.address }"," still shares the same nested ",[29,589,590],{},"address"," object — mutating ",[29,593,594],{},"updated.address.city"," also mutates the original ",[29,597,598],{},"user.address.city",", silently breaking the \"immutability\" you thought you had.",[515,601,602,538,607,610,611,614],{},[518,603,604,606],{},[29,605,536],{}," is shallow too",[29,608,609],{},"Object.freeze({ nested: { a: 1 } })"," prevents adding\u002Fremoving\u002Freassigning top-level keys, but ",[29,612,613],{},"frozen.nested.a = 2"," still works fine — nested objects are not frozen automatically.",[515,616,617,538,620,623,624,627,628,631,632,635,636,639,640,643,644,646,647,650,651,654],{},[518,618,619],{},"Array methods that look pure sometimes aren't",[29,621,622],{},".sort()"," and ",[29,625,626],{},".reverse()"," mutate the array ",[518,629,630],{},"in place"," and also return it, unlike ",[29,633,634],{},".map()","\u002F",[29,637,638],{},".filter()",". ",[29,641,642],{},"const sorted = arr.sort()"," looks immutable but actually reorders ",[29,645,147],{}," itself — use ",[29,648,649],{},"[...arr].sort()"," or the newer ",[29,652,653],{},"arr.toSorted()"," to avoid the mutation.",[515,656,657,538,663,666],{},[518,658,659,662],{},[29,660,661],{},"Math.random()"," inside a \"pure-looking\" arrow function breaks referential transparency",[29,664,665],{},"const roll = () => Math.random() > 0.5"," produces different results for identical (zero) input, so it can't be memoized or reasoned about like a true pure function, even though it takes no arguments and looks side-effect-free.",[515,668,669,538,676,679],{},[518,670,671,672,675],{},"Destructuring rest (",[29,673,674],{},"...rest",") to \"delete\" a key still copies everything else",[29,677,678],{},"const { password, ...safeUser } = user"," is a common pattern to strip sensitive fields, but on large objects this is an O(n) shallow copy every time — fine for typical use, but a hidden cost in hot loops over big records.",[14,681,683],{"id":682},"spot-the-bug","🧠 Spot the Bug",[515,685,686],{},"What does this log?",[19,688,689],{"language":21},[23,690,692],{"className":25,"code":691,"language":21,"meta":27,"style":27},"const original = { name: 'Alice', tags: ['admin', 'staff'] }\n\nfunction promote(user) {\n  const updated = { ...user, tags: user.tags }\n  updated.tags.push('superadmin')\n  return updated\n}\n\nconst promoted = promote(original)\nconsole.log(original.tags)\nconsole.log(promoted.tags)\n",[29,693,694,721,725,741,757,772,780,785,789,803,814],{"__ignoreMap":27},[32,695,696,698,701,703,705,707,710,713,715,718],{"class":34,"line":35},[32,697,46],{"class":45},[32,699,700],{"class":296}," original",[32,702,53],{"class":45},[32,704,443],{"class":56},[32,706,447],{"class":446},[32,708,709],{"class":56},", tags: [",[32,711,712],{"class":446},"'admin'",[32,714,64],{"class":56},[32,716,717],{"class":446},"'staff'",[32,719,720],{"class":56},"] }\n",[32,722,723],{"class":34,"line":42},[32,724,126],{"emptyLinePlaceholder":125},[32,726,727,730,733,735,738],{"class":34,"line":88},[32,728,729],{"class":45},"function",[32,731,732],{"class":49}," promote",[32,734,360],{"class":56},[32,736,737],{"class":60},"user",[32,739,740],{"class":56},") {\n",[32,742,743,746,748,750,752,754],{"class":34,"line":122},[32,744,745],{"class":45},"  const",[32,747,387],{"class":296},[32,749,53],{"class":45},[32,751,467],{"class":56},[32,753,162],{"class":45},[32,755,756],{"class":56},"user, tags: user.tags }\n",[32,758,759,762,764,766,769],{"class":34,"line":129},[32,760,761],{"class":56},"  updated.tags.",[32,763,196],{"class":49},[32,765,360],{"class":56},[32,767,768],{"class":446},"'superadmin'",[32,770,771],{"class":56},")\n",[32,773,774,777],{"class":34,"line":135},[32,775,776],{"class":45},"  return",[32,778,779],{"class":56}," updated\n",[32,781,782],{"class":34,"line":171},[32,783,784],{"class":56},"}\n",[32,786,787],{"class":34,"line":211},[32,788,126],{"emptyLinePlaceholder":125},[32,790,791,793,796,798,800],{"class":34,"line":216},[32,792,46],{"class":45},[32,794,795],{"class":296}," promoted",[32,797,53],{"class":45},[32,799,732],{"class":49},[32,801,802],{"class":56},"(original)\n",[32,804,805,808,811],{"class":34,"line":222},[32,806,807],{"class":56},"console.",[32,809,810],{"class":49},"log",[32,812,813],{"class":56},"(original.tags)\n",[32,815,817,819,821],{"class":34,"line":816},11,[32,818,807],{"class":56},[32,820,810],{"class":49},[32,822,823],{"class":56},"(promoted.tags)\n",[825,826,827,831,859],"details",{},[828,829,830],"summary",{},"Answer",[515,832,833,834,837,838,841,842,845,846,850,851,854,855,858],{},"Both log ",[29,835,836],{},"[\"admin\", \"staff\", \"superadmin\"]"," — the spread ",[29,839,840],{},"{ ...user, tags: user.tags }"," copies the ",[29,843,844],{},"tags"," ",[847,848,849],"em",{},"reference",", not the array itself, because spread is shallow. Pushing to ",[29,852,853],{},"updated.tags"," mutates the exact same array that ",[29,856,857],{},"original.tags"," points to, so the \"immutable-looking\" update leaks a mutation back into the original object.",[515,860,861,864,865,868,869,872],{},[518,862,863],{},"The lesson",": shallow copies only protect the top level — nested arrays and objects need their own copy (",[29,866,867],{},"[...user.tags]"," or ",[29,870,871],{},"structuredClone",") to be truly immutable.",[14,874,876],{"id":875},"key-takeaways","Key Takeaways",[878,879,880,884,887],"ul",{},[881,882,883],"li",{},"Pure functions are testable, cacheable, and predictable — prefer them.",[881,885,886],{},"Never mutate inputs — return new arrays\u002Fobjects (spread, map, filter).",[881,888,889,635,892,895],{},[29,890,891],{},"pipe",[29,893,894],{},"compose"," build complex logic from small focused functions.",[897,898,899],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-da