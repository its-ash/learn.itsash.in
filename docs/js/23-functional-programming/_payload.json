[{"data":1,"prerenderedAt":914},["ShallowReactive",2],{"page-\u002Fjs\u002F23-functional-programming":3},{"id":4,"title":5,"body":6,"description":27,"extension":908,"meta":909,"navigation":125,"path":910,"seo":911,"stem":912,"__hash__":913},"content\u002Fjs\u002F23-functional-programming.md","23 — Functional Programming",{"type":7,"value":8,"toc":900},"minimark",[9,13,18,274,278,510,514,530,543,560,569,575,579,600,615,655,667,680,684,687,824,873,877,896],[10,11,5],"h1",{"id":12},"_23-functional-programming",[14,15,17],"h2",{"id":16},"core-principles","Core Principles",[19,20,22],"code-wrapper",{"language":21},"javascript",[23,24,28],"pre",{"className":25,"code":26,"language":21,"meta":27,"style":27},"language-javascript shiki shiki-themes github-light github-dark","\u002F\u002F Pure functions — same input → same output, no side effects\nconst pure = (a, b) => a + b          \u002F\u002F ✅ pure\nconst impure = (a) => a + Math.random() \u002F\u002F ❌ impure (random)\n\n\u002F\u002F Immutability — don't mutate, create new\nconst add = (arr, val) => [...arr, val]    \u002F\u002F ✅ new array\nconst badAdd = (arr, val) => { arr.push(val); return arr }  \u002F\u002F ❌ mutates\n\n\u002F\u002F Composition — build from small functions\nconst pipe = (...fns) => x => fns.reduce((v, f) => f(v), x)\n","",[29,30,31,40,86,120,127,133,169,209,214,220],"code",{"__ignoreMap":27},[32,33,36],"span",{"class":34,"line":35},"line",1,[32,37,39],{"class":38},"sdCPZ","\u002F\u002F Pure functions — same input → same output, no side effects\n",[32,41,43,47,51,54,58,62,65,68,71,74,77,80,83],{"class":34,"line":42},2,[32,44,46],{"class":45},"svdQ7","const",[32,48,50],{"class":49},"sIsaT"," pure",[32,52,53],{"class":45}," =",[32,55,57],{"class":56},"ssxIu"," (",[32,59,61],{"class":60},"sCrzJ","a",[32,63,64],{"class":56},", ",[32,66,67],{"class":60},"b",[32,69,70],{"class":56},") ",[32,72,73],{"class":45},"=>",[32,75,76],{"class":56}," a ",[32,78,79],{"class":45},"+",[32,81,82],{"class":56}," b     