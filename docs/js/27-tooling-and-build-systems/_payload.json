],{"class":170},[32,321,322],{"class":70},"2",[32,324,245],{"class":170},[32,326,327,330,332,335],{"class":34,"line":94},[32,328,329],{"class":70},"  \"trailingComma\"",[32,331,199],{"class":170},[32,333,334],{"class":42},"\"es5\"",[32,336,245],{"class":170},[32,338,339,342,344],{"class":34,"line":107},[32,340,341],{"class":70},"  \"printWidth\"",[32,343,199],{"class":170},[32,345,346],{"class":70},"80\n",[32,348,349],{"class":34,"line":118},[32,350,277],{"class":170},[14,352,354],{"id":353},"vite","Vite",[19,356,357],{"language":21},[23,358,360],{"className":25,"code":359,"language":21,"meta":27,"style":27},"npm create vite@latest my-app -- --template vanilla\ncd my-app && npm install && npm run dev\n",[29,361,362,384],{"__ignoreMap":27},[32,363,364,366,369,372,375,378,381],{"class":34,"line":35},[32,365,39],{"class":38},[32,367,368],{"class":42}," create",[32,370,371],{"class":42}," vite@latest",[32,373,374],{"class":42}," my-app",[32,376,377],{"class":70}," --",[32,379,380],{"class":70}," --template",[32,382,383],{"class":42}," vanilla\n",[32,385,386,389,391,394,396,398,400,402,404],{"class":34,"line":50},[32,387,388],{"class":70},"cd",[32,390,374],{"class":42},[32,392,393],{"class":170}," && ",[32,395,39],{"class":38},[32,397,43],{"class":42},[32,399,393],{"class":170},[32,401,39],{"class":38},[32,403,134],{"class":42},[32,405,406],{"class":42}," dev\n",[14,408,410],{"id":409},"tips-tricks","💡 Tips & Tricks",[412,413,414,421,422,205,425,427,428,431,432,435,436,439],"p",{},[415,416,417,420],"strong",{},[29,418,419],{},"npm ci"," for reproducible installs in CI"," — Unlike ",[29,423,424],{},"npm install",[29,426,419],{}," deletes ",[29,429,430],{},"node_modules"," first and installs strictly from ",[29,433,434],{},"package-lock.json",", failing if the lockfile and ",[29,437,438],{},"package.json"," are out of sync — catches \"works on my machine\" dependency drift before it ships.",[412,441,442,447,448,451],{},[415,443,444,446],{},[29,445,146],{}," can run a specific version"," — ",[29,449,450],{},"npx create-vite@5.0.0"," pins the exact tool version for a one-off run without touching global state or your project's dependencies.",[412,453,454,447,457,460],{},[415,455,456],{},"ESLint auto-fix handles most formatting-adjacent issues",[29,458,459],{},"eslint . --fix"," resolves many rule violations automatically (unused imports, quote style, spacing) — run it before Prettier in a pre-commit hook to reduce manual cleanup.",[412,462,463,447,469,471,472,475,476,479],{},[415,464,465,468],{},[29,466,467],{},"npm audit fix"," vs manual review",[29,470,467],{}," only applies non-breaking patch\u002Fminor updates automatically; ",[29,473,474],{},"npm audit fix --force"," can bump major versions and break your app — always review the diff before using ",[29,477,478],{},"--force",".",[412,481,482,489,490,493,494,497],{},[415,483,484,485,488],{},"Vite's ",[29,486,487],{},"import.meta.env"," exposes build-time variables safely"," — Variables prefixed with ",[29,491,492],{},"VITE_"," in a ",[29,495,496],{},".env"," file are statically replaced at build time, keeping unprefixed secrets out of the client bundle by design.",[14,499,501],{"id":500},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[412,503,504,512,513,515,516,518],{},[415,505,506,508,509,511],{},[29,507,424],{}," can silently update ",[29,510,434],{}," in ways you didn't intend"," — Running plain ",[29,514,424],{}," after pulling a teammate's lockfile changes can resolve slightly different transitive dependency versions if your local npm version differs, causing lockfile churn in every PR — ",[29,517,419],{}," avoids this entirely for CI and clean installs.",[412,520,521,524,525,528,529,532,533,536],{},[415,522,523],{},"ESLint and Prettier can fight each other on formatting rules"," — If ESLint's ",[29,526,527],{},"indent"," or ",[29,530,531],{},"quotes"," rules are enabled alongside Prettier, the two tools can flip-flop the same line back and forth on save — always disable ESLint's stylistic rules (via ",[29,534,535],{},"eslint-config-prettier",") and let Prettier own formatting exclusively.",[412,538,539,542,543,546,547,550,551,554,555,558,559,561],{},[415,540,541],{},"Global vs local installs of the same package silently diverge"," — Running a globally installed CLI tool (",[29,544,545],{},"eslint"," from ",[29,548,549],{},"npm i -g eslint",") instead of the project's local version (",[29,552,553],{},"npx eslint"," or the ",[29,556,557],{},"node_modules\u002F.bin"," copy) can lint with a completely different ruleset\u002Fversion than what's declared in ",[29,560,438],{}," — teammates and CI then disagree on what \"passes.\"",[412,563,564,447,571,574,575,578],{},[415,565,566,567,570],{},"Semver caret (",[29,568,569],{},"^",") ranges allow unexpected minor bumps",[29,572,573],{},"\"lodash\": \"^4.17.21\""," permits any ",[29,576,577],{},"4.x.x"," update on a fresh install without a lockfile, meaning \"works today\" can silently break tomorrow if a minor release introduces a bug — lockfiles exist precisely to pin this down for reproducible builds.",[412,580,581,584,585,588,589,592,593,596],{},[415,582,583],{},"Vite dev server behavior differs from the production build"," — Code that works in ",[29,586,587],{},"vite dev"," (unbundled ESM, no tree-shaking, dev-only polyfills) can behave differently after ",[29,590,591],{},"vite build"," — always test against the built output (",[29,594,595],{},"vite preview",") before shipping, not just the dev server.",[14,598,600],{"id":599},"spot-the-bug","🧠 Spot the Bug",[412,602,603,604,606],{},"A teammate says \"it works on my machine\" but CI fails on ",[29,605,419],{},". What's the likely cause?",[19,608,609],{"language":21},[23,610,612],{"className":25,"code":611,"language":21,"meta":27,"style":27},"# Teammate's local workflow\nnpm install lodash\ngit add package.json\ngit commit -m \"add lodash\"\ngit push\n\n# CI workflow\ngit clone repo\nnpm ci\nnpm test\n",[29,613,614,619,628,639,652,659,665,670,680,687],{"__ignoreMap":27},[32,615,616],{"class":34,"line":35},[32,617,618],{"class":46},"# Teammate's local workflow\n",[32,620,621,623,625],{"class":34,"line":50},[32,622,39],{"class":38},[32,624,43],{"class":42},[32,626,627],{"class":42}," lodash\n",[32,629,630,633,636],{"class":34,"line":63},[32,631,632],{"class":38},"git",[32,634,635],{"class":42}," add",[32,637,638],{"class":42}," package.json\n",[32,640,641,643,646,649],{"class":34,"line":79},[32,642,632],{"class":38},[32,644,645],{"class":42}," commit",[32,647,648],{"class":70}," -m",[32,650,651],{"class":42}," \"add lodash\"\n",[32,653,654,656],{"class":34,"line":94},[32,655,632],{"class":38},[32,657,658],{"class":42}," push\n",[32,660,661],{"class":34,"line":107},[32,662,664],{"emptyLinePlaceholder":663},true,"\n",[32,666,667],{"class":34,"line":118},[32,668,669],{"class":46},"# CI workflow\n",[32,671,672,674,677],{"class":34,"line":129},[32,673,632],{"class":38},[32,675,676],{"class":42}," clone",[32,678,679],{"class":42}," repo\n",[32,681,682,684],{"class":34,"line":143},[32,683,39],{"class":38},[32,685,686],{"class":42}," ci\n",[32,688,690,692],{"class":34,"line":689},10,[32,691,39],{"class":38},[32,693,694],{"class":42}," test\n",[696,697,698,702,727],"details",{},[699,700,701],"summary",{},"Answer",[412,703,704,705,707,708,710,711,713,714,716,717,720,721,723,724,726],{},"The teammate committed the ",[29,706,438],{}," change but forgot to commit the updated ",[29,709,434],{}," (or it wasn't staged). ",[29,712,419],{}," requires the lockfile to exactly match ",[29,715,438],{}," — if ",[29,718,719],{},"lodash"," isn't present in the committed lockfile at all, ",[29,722,419],{}," fails immediately with an error rather than trying to resolve it, unlike ",[29,725,424],{},", which would happily update the lockfile and proceed.",[412,728,729,732,733,736,737,447,739,741],{},[415,730,731],{},"The lesson",": always ",[29,734,735],{},"git add package-lock.json"," alongside ",[29,738,438],{},[29,740,419],{},"'s strictness is a feature (reproducible builds), but only if the lockfile is actually committed and current.",[14,743,745],{"id":744},"key-takeaways","Key Takeaways",[747,748,749,759,762],"ul",{},[750,751,752,754,755,758],"li",{},[29,753,39],{}," manages dependencies and scripts; ",[29,756,757],{},"pnpm"," is faster with disk-efficient linking.",[750,760,761],{},"ESLint catches bugs; Prettier enforces formatting — use both.",[750,763,764],{},"Vite is the modern bundler — instant HMR, ESM-native, build with Rollup.",[766,767,768],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-de