:79},[32,322,323],{"class":70},"  \"tabWidth\"",[32,325,203],{"class":174},[32,327,328],{"class":70},"2",[32,330,249],{"class":174},[32,332,333,336,338,341],{"class":34,"line":94},[32,334,335],{"class":70},"  \"trailingComma\"",[32,337,203],{"class":174},[32,339,340],{"class":42},"\"es5\"",[32,342,249],{"class":174},[32,344,345,348,350],{"class":34,"line":107},[32,346,347],{"class":70},"  \"printWidth\"",[32,349,203],{"class":174},[32,351,352],{"class":70},"80\n",[32,354,355],{"class":34,"line":118},[32,356,281],{"class":174},[153,358,155],{},[14,360,362],{"id":361},"vite","Vite",[19,364,365],{"language":21},[23,366,368],{"className":25,"code":367,"language":21,"meta":27,"style":27},"npm create vite@latest my-app -- --template vanilla\ncd my-app && npm install && npm run dev\n",[29,369,370,392],{"__ignoreMap":27},[32,371,372,374,377,380,383,386,389],{"class":34,"line":35},[32,373,39],{"class":38},[32,375,376],{"class":42}," create",[32,378,379],{"class":42}," vite@latest",[32,381,382],{"class":42}," my-app",[32,384,385],{"class":70}," --",[32,387,388],{"class":70}," --template",[32,390,391],{"class":42}," vanilla\n",[32,393,394,397,399,402,404,406,408,410,412],{"class":34,"line":50},[32,395,396],{"class":70},"cd",[32,398,382],{"class":42},[32,400,401],{"class":174}," && ",[32,403,39],{"class":38},[32,405,43],{"class":42},[32,407,401],{"class":174},[32,409,39],{"class":38},[32,411,134],{"class":42},[32,413,414],{"class":42}," dev\n",[153,416,155],{},[14,418,420],{"id":419},"tips-tricks","💡 Tips & Tricks",[153,422,423,430,431,209,434,436,437,440,441,444,445,448],{},[424,425,426,429],"strong",{},[29,427,428],{},"npm ci"," for reproducible installs in CI"," — Unlike ",[29,432,433],{},"npm install",[29,435,428],{}," deletes ",[29,438,439],{},"node_modules"," first and installs strictly from ",[29,442,443],{},"package-lock.json",", failing if the lockfile and ",[29,446,447],{},"package.json"," are out of sync — catches \"works on my machine\" dependency drift before it ships.",[153,450,451,456,457,460],{},[424,452,453,455],{},[29,454,146],{}," can run a specific version"," — ",[29,458,459],{},"npx create-vite@5.0.0"," pins the exact tool version for a one-off run without touching global state or your project's dependencies.",[153,462,463,456,466,469],{},[424,464,465],{},"ESLint auto-fix handles most formatting-adjacent issues",[29,467,468],{},"eslint . --fix"," resolves many rule violations automatically (unused imports, quote style, spacing) — run it before Prettier in a pre-commit hook to reduce manual cleanup.",[153,471,472,456,478,480,481,484,485,488],{},[424,473,474,477],{},[29,475,476],{},"npm audit fix"," vs manual review",[29,479,476],{}," only applies non-breaking patch\u002Fminor updates automatically; ",[29,482,483],{},"npm audit fix --force"," can bump major versions and break your app — always review the diff before using ",[29,486,487],{},"--force",".",[153,490,491,498,499,502,503,506],{},[424,492,493,494,497],{},"Vite's ",[29,495,496],{},"import.meta.env"," exposes build-time variables safely"," — Variables prefixed with ",[29,500,501],{},"VITE_"," in a ",[29,504,505],{},".env"," file are statically replaced at build time, keeping unprefixed secrets out of the client bundle by design.",[14,508,510],{"id":509},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[153,512,513,521,522,524,525,527],{},[424,514,515,517,518,520],{},[29,516,433],{}," can silently update ",[29,519,443],{}," in ways you didn't intend"," — Running plain ",[29,523,433],{}," after pulling a teammate's lockfile changes can resolve slightly different transitive dependency versions if your local npm version differs, causing lockfile churn in every PR — ",[29,526,428],{}," avoids this entirely for CI and clean installs.",[153,529,530,533,534,537,538,541,542,545],{},[424,531,532],{},"ESLint and Prettier can fight each other on formatting rules"," — If ESLint's ",[29,535,536],{},"indent"," or ",[29,539,540],{},"quotes"," rules are enabled alongside Prettier, the two tools can flip-flop the same line back and forth on save — always disable ESLint's stylistic rules (via ",[29,543,544],{},"eslint-config-prettier",") and let Prettier own formatting exclusively.",[153,547,548,551,552,555,556,559,560,563,564,567,568,570],{},[424,549,550],{},"Global vs local installs of the same package silently diverge"," — Running a globally installed CLI tool (",[29,553,554],{},"eslint"," from ",[29,557,558],{},"npm i -g eslint",") instead of the project's local version (",[29,561,562],{},"npx eslint"," or the ",[29,565,566],{},"node_modules\u002F.bin"," copy) can lint with a completely different ruleset\u002Fversion than what's declared in ",[29,569,447],{}," — teammates and CI then disagree on what \"passes.\"",[153,572,573,456,580,583,584,587],{},[424,574,575,576,579],{},"Semver caret (",[29,577,578],{},"^",") ranges allow unexpected minor bumps",[29,581,582],{},"\"lodash\": \"^4.17.21\""," permits any ",[29,585,586],{},"4.x.x"," update on a fresh install without a lockfile, meaning \"works today\" can silently break tomorrow if a minor release introduces a bug — lockfiles exist precisely to pin this down for reproducible builds.",[153,589,590,593,594,597,598,601,602,605],{},[424,591,592],{},"Vite dev server behavior differs from the production build"," — Code that works in ",[29,595,596],{},"vite dev"," (unbundled ESM, no tree-shaking, dev-only polyfills) can behave differently after ",[29,599,600],{},"vite build"," — always test against the built output (",[29,603,604],{},"vite preview",") before shipping, not just the dev server.",[14,607,609],{"id":608},"spot-the-bug","🧠 Spot the Bug",[153,611,612,613,615],{},"A teammate says \"it works on my machine\" but CI fails on ",[29,614,428],{},". What's the likely cause?",[19,617,618],{"language":21},[23,619,621],{"className":25,"code":620,"language":21,"meta":27,"style":27},"# Teammate's local workflow\nnpm install lodash\ngit add package.json\ngit commit -m \"add lodash\"\ngit push\n\n# CI workflow\ngit clone repo\nnpm ci\nnpm test\n",[29,622,623,628,637,648,661,668,674,679,689,696],{"__ignoreMap":27},[32,624,625],{"class":34,"line":35},[32,626,627],{"class":46},"# Teammate's local workflow\n",[32,629,630,632,634],{"class":34,"line":50},[32,631,39],{"class":38},[32,633,43],{"class":42},[32,635,636],{"class":42}," lodash\n",[32,638,639,642,645],{"class":34,"line":63},[32,640,641],{"class":38},"git",[32,643,644],{"class":42}," add",[32,646,647],{"class":42}," package.json\n",[32,649,650,652,655,658],{"class":34,"line":79},[32,651,641],{"class":38},[32,653,654],{"class":42}," commit",[32,656,657],{"class":70}," -m",[32,659,660],{"class":42}," \"add lodash\"\n",[32,662,663,665],{"class":34,"line":94},[32,664,641],{"class":38},[32,666,667],{"class":42}," push\n",[32,669,670],{"class":34,"line":107},[32,671,673],{"emptyLinePlaceholder":672},true,"\n",[32,675,676],{"class":34,"line":118},[32,677,678],{"class":46},"# CI workflow\n",[32,680,681,683,686],{"class":34,"line":129},[32,682,641],{"class":38},[32,684,685],{"class":42}," clone",[32,687,688],{"class":42}," repo\n",[32,690,691,693],{"class":34,"line":143},[32,692,39],{"class":38},[32,694,695],{"class":42}," ci\n",[32,697,699,701],{"class":34,"line":698},10,[32,700,39],{"class":38},[32,702,703],{"class":42}," test\n",[705,706,707,711,736],"details",{},[708,709,710],"summary",{},"Answer",[153,712,713,714,716,717,719,720,722,723,725,726,729,730,732,733,735],{},"The teammate committed the ",[29,715,447],{}," change but forgot to commit the updated ",[29,718,443],{}," (or it wasn't staged). ",[29,721,428],{}," requires the lockfile to exactly match ",[29,724,447],{}," — if ",[29,727,728],{},"lodash"," isn't present in the committed lockfile at all, ",[29,731,428],{}," fails immediately with an error rather than trying to resolve it, unlike ",[29,734,433],{},", which would happily update the lockfile and proceed.",[153,737,738,741,742,745,746,456,748,750],{},[424,739,740],{},"The lesson",": always ",[29,743,744],{},"git add package-lock.json"," alongside ",[29,747,447],{},[29,749,428],{},"'s strictness is a feature (reproducible builds), but only if the lockfile is actually committed and current.",[14,752,754],{"id":753},"key-takeaways","Key Takeaways",[756,757,758,768,771],"ul",{},[759,760,761,763,764,767],"li",{},[29,762,39],{}," manages dependencies and scripts; ",[29,765,766],{},"pnpm"," is faster with disk-efficient linking.",[759,769,770],{},"ESLint catches bugs; Prettier enforces formatting — use both.",[759,772,773],{},"Vite is the modern bundler — instant HMR, ESM-native, build with Rollup.",[775,776,777],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-gi