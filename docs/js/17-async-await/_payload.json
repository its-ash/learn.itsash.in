":56},[32,565,566],{"class":52},"all",[32,568,569],{"class":56},"([",[32,571,572],{"class":52},"fetchA",[32,574,575],{"class":56},"(), ",[32,577,578],{"class":52},"fetchB",[32,580,575],{"class":56},[32,582,583],{"class":52},"fetchC",[32,585,586],{"class":56},"()])\n",[32,588,589,591,593],{"class":34,"line":204},[32,590,124],{"class":45},[32,592,502],{"class":56},[32,594,595],{"class":38},"\u002F\u002F total: 2s\n",[32,597,598],{"class":34,"line":209},[32,599,133],{"class":56},[32,601,602],{"class":34,"line":214},[32,603,140],{"emptyLinePlaceholder":139},[32,605,606],{"class":34,"line":220},[32,607,608],{"class":38},"\u002F\u002F ✅ Sequential when dependent\n",[32,610,612,614,616,619],{"class":34,"line":611},16,[32,613,46],{"class":45},[32,615,49],{"class":45},[32,617,618],{"class":52}," dependent",[32,620,272],{"class":56},[32,622,624,626,628,630,632,634],{"class":34,"line":623},17,[32,625,70],{"class":45},[32,627,105],{"class":73},[32,629,77],{"class":45},[32,631,80],{"class":45},[32,633,53],{"class":52},[32,635,636],{"class":56},"(id)\n",[32,638,640,642,645,647,649,652,655],{"class":34,"line":639},18,[32,641,70],{"class":45},[32,643,644],{"class":73}," orders",[32,646,77],{"class":45},[32,648,80],{"class":45},[32,650,651],{"class":52}," fetchOrders",[32,653,654],{"class":56},"(user.id)  ",[32,656,657],{"class":38},"\u002F\u002F needs user.id\n",[32,659,661,663],{"class":34,"line":660},19,[32,662,124],{"class":45},[32,664,665],{"class":56}," orders\n",[32,667,669],{"class":34,"line":668},20,[32,670,133],{"class":56},[14,672,674],{"id":673},"tips-tricks","💡 Tips & Tricks",[676,677,678,682,683,686,687,690],"p",{},[679,680,681],"strong",{},"Start independent operations before awaiting"," — Instead of ",[29,684,685],{},"await a; await b",", do ",[29,688,689],{},"const p1 = a; const p2 = b; const [r1, r2] = await Promise.all([p1, p2])",". This runs them in parallel.",[676,692,693,700,701,704,705,708],{},[679,694,695,696,699],{},"Use ",[29,697,698],{},"await"," in loops carefully"," — ",[29,702,703],{},"for (const item of items) { await process(item) }"," runs sequentially. Use ",[29,706,707],{},"Promise.all(items.map(process))"," for parallelism.",[676,710,711,717,718,720,721,723],{},[679,712,713,714,716],{},"Top-level ",[29,715,698],{}," in modules"," — Modern Node\u002Fbrowsers allow ",[29,719,698],{}," outside ",[29,722,46],{}," at module level. No need to wrap in async IIFE anymore.",[676,725,726,729],{},[679,727,728],{},"Error context is better than promises"," — Stack traces in async\u002Fawait show the exact line where you awaited. Promise chains hide the source. Use async\u002Fawait in production for debuggability.",[676,731,732,735,736,738,739,742,743,746,747,749],{},[679,733,734],{},"Async functions always return Promises"," — Even if you don't ",[29,737,698],{}," anything, ",[29,740,741],{},"async function f() { return 1 }"," returns ",[29,744,745],{},"Promise\u003C1>",", not ",[29,748,228],{},". Remember this when mixing with callback code.",[14,751,753],{"id":752},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[676,755,756,700,759,762,763,766],{},[679,757,758],{},"Sequential awaits are slow",[29,760,761],{},"await a(); await b(); await c()"," takes 6 seconds if each takes 2 seconds. Parallelize with ",[29,764,765],{},"await Promise.all([a(), b(), c()])"," for 2 seconds total.",[676,768,769,700,772,775,776,779,780,333],{},[679,770,771],{},"Forgot to await a promise",[29,773,774],{},"const result = fetch(url)"," doesn't fetch; it returns a pending Promise. You get a promise in ",[29,777,778],{},"result",", not data. Use ",[29,781,782],{},"const result = await fetch(url)",[676,784,785,788,789,792],{},[679,786,787],{},"try\u002Fcatch doesn't catch all errors"," — Only catches errors from awaits or thrown in the try block. If an async task starts but doesn't await, errors are unhandled. Example: ",[29,790,791],{},"try { setTimeout(() => throw new Error()) }"," won't catch.",[676,794,795,700,798,742,801,804,805,808],{},[679,796,797],{},"Returning Promises from async functions",[29,799,800],{},"async function f() { return Promise.resolve(5) }",[29,802,803],{},"Promise\u003CPromise\u003C5>>",", which auto-unwraps to ",[29,806,807],{},"Promise\u003C5>",". It works but looks weird.",[676,810,811,700,814,817],{},[679,812,813],{},"Async IIFE is clunky",[29,815,816],{},"(async () => { ... })()"," was needed pre-ES2022. Modern code uses top-level await in modules. Avoid async IIFE if possible.",[676,819,820,700,823,826,827,829,830,333],{},[679,821,822],{},"await in map doesn't parallelize",[29,824,825],{},"items.map(async item => await process(item))"," looks like it runs in parallel but it doesn't if you then ",[29,828,698],{}," the map result. Await the individual promises later or use ",[29,831,832],{},"Promise.all",[14,834,836],{"id":835},"spot-the-bug","🧠 Spot the Bug",[676,838,839],{},"What does this log?",[23,841,843],{"className":25,"code":842,"language":21,"meta":27,"style":27},"async function test() {\n  const a = await Promise.resolve(1)\n  const b = Promise.resolve(2)  \u002F\u002F forgot await\n  const c = await Promise.resolve(3)\n  \n  return [a, b, c]\n}\n\ntest().then(([a, b, c]) => {\n  console.log(typeof a, typeof b, typeof c)\n})\n",[29,844,845,856,879,904,927,932,939,943,947,978,1003],{"__ignoreMap":27},[32,846,847,849,851,854],{"class":34,"line":35},[32,848,46],{"class":45},[32,850,49],{"class":45},[32,852,853],{"class":52}," test",[32,855,272],{"class":56},[32,857,858,860,862,864,866,868,870,873,875,877],{"class":34,"line":42},[32,859,70],{"class":45},[32,861,446],{"class":73},[32,863,77],{"class":45},[32,865,80],{"class":45},[32,867,561],{"class":73},[32,869,333],{"class":56},[32,871,872],{"class":52},"resolve",[32,874,57],{"class":56},[32,876,228],{"class":73},[32,878,97],{"class":56},[32,880,881,883,885,887,889,891,893,895,898,901],{"class":34,"line":67},[32,882,70],{"class":45},[32,884,466],{"class":73},[32,886,77],{"class":45},[32,888,561],{"class":73},[32,890,33