2,566,567],{"class":73}," Promise",[32,569,337],{"class":56},[32,571,572],{"class":52},"all",[32,574,575],{"class":56},"([",[32,577,578],{"class":52},"fetchA",[32,580,581],{"class":56},"(), ",[32,583,584],{"class":52},"fetchB",[32,586,581],{"class":56},[32,588,589],{"class":52},"fetchC",[32,591,592],{"class":56},"()])\n",[32,594,595,597,599],{"class":34,"line":204},[32,596,124],{"class":45},[32,598,508],{"class":56},[32,600,601],{"class":38},"\u002F\u002F total: 2s\n",[32,603,604],{"class":34,"line":209},[32,605,133],{"class":56},[32,607,608],{"class":34,"line":214},[32,609,140],{"emptyLinePlaceholder":139},[32,611,612],{"class":34,"line":220},[32,613,614],{"class":38},"\u002F\u002F ✅ Sequential when dependent\n",[32,616,618,620,622,625],{"class":34,"line":617},16,[32,619,46],{"class":45},[32,621,49],{"class":45},[32,623,624],{"class":52}," dependent",[32,626,276],{"class":56},[32,628,630,632,634,636,638,640],{"class":34,"line":629},17,[32,631,70],{"class":45},[32,633,105],{"class":73},[32,635,77],{"class":45},[32,637,80],{"class":45},[32,639,53],{"class":52},[32,641,642],{"class":56},"(id)\n",[32,644,646,648,651,653,655,658,661],{"class":34,"line":645},18,[32,647,70],{"class":45},[32,649,650],{"class":73}," orders",[32,652,77],{"class":45},[32,654,80],{"class":45},[32,656,657],{"class":52}," fetchOrders",[32,659,660],{"class":56},"(user.id)  ",[32,662,663],{"class":38},"\u002F\u002F needs user.id\n",[32,665,667,669],{"class":34,"line":666},19,[32,668,124],{"class":45},[32,670,671],{"class":56}," orders\n",[32,673,675],{"class":34,"line":674},20,[32,676,133],{"class":56},[251,678,253],{},[14,680,682],{"id":681},"tips-tricks","💡 Tips & Tricks",[251,684,685,689,690,693,694,697],{},[686,687,688],"strong",{},"Start independent operations before awaiting"," — Instead of ",[29,691,692],{},"await a; await b",", do ",[29,695,696],{},"const p1 = a; const p2 = b; const [r1, r2] = await Promise.all([p1, p2])",". This runs them in parallel.",[251,699,700,707,708,711,712,715],{},[686,701,702,703,706],{},"Use ",[29,704,705],{},"await"," in loops carefully"," — ",[29,709,710],{},"for (const item of items) { await process(item) }"," runs sequentially. Use ",[29,713,714],{},"Promise.all(items.map(process))"," for parallelism.",[251,717,718,724,725,727,728,730],{},[686,719,720,721,723],{},"Top-level ",[29,722,705],{}," in modules"," — Modern Node\u002Fbrowsers allow ",[29,726,705],{}," outside ",[29,729,46],{}," at module level. No need to wrap in async IIFE anymore.",[251,732,733,736],{},[686,734,735],{},"Error context is better than promises"," — Stack traces in async\u002Fawait show the exact line where you awaited. Promise chains hide the source. Use async\u002Fawait in production for debuggability.",[251,738,739,742,743,745,746,749,750,753,754,756],{},[686,740,741],{},"Async functions always return Promises"," — Even if you don't ",[29,744,705],{}," anything, ",[29,747,748],{},"async function f() { return 1 }"," returns ",[29,751,752],{},"Promise\u003C1>",", not ",[29,755,228],{},". Remember this when mixing with callback code.",[14,758,760],{"id":759},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[251,762,763,707,766,769,770,773],{},[686,764,765],{},"Sequential awaits are slow",[29,767,768],{},"await a(); await b(); await c()"," takes 6 seconds if each takes 2 seconds. Parallelize with ",[29,771,772],{},"await Promise.all([a(), b(), c()])"," for 2 seconds total.",[251,775,776,707,779,782,783,786,787,337],{},[686,777,778],{},"Forgot to await a promise",[29,780,781],{},"const result = fetch(url)"," doesn't fetch; it returns a pending Promise. You get a promise in ",[29,784,785],{},"result",", not data. Use ",[29,788,789],{},"const result = await fetch(url)",[251,791,792,795,796,799],{},[686,793,794],{},"try\u002Fcatch doesn't catch all errors"," — Only catches errors from awaits or thrown in the try block. If an async task starts but doesn't await, errors are unhandled. Example: ",[29,797,798],{},"try { setTimeout(() => throw new Error()) }"," won't catch.",[251,801,802,707,805,749,808,811,812,815],{},[686,803,804],{},"Returning Promises from async functions",[29,806,807],{},"async function f() { return Promise.resolve(5) }",[29,809,810],{},"Promise\u003CPromise\u003C5>>",", which auto-unwraps to ",[29,813,814],{},"Promise\u003C5>",". It works but looks weird.",[251,817,818,707,821,824],{},[686,819,820],{},"Async IIFE is clunky",[29,822,823],{},"(async () => { ... })()"," was needed pre-ES2022. Modern code uses top-level await in modules. Avoid async IIFE if possible.",[251,826,827,707,830,833,834,836,837,337],{},[686,828,829],{},"await in map doesn't parallelize",[29,831,832],{},"items.map(async item => await process(item))"," looks like it runs in parallel but it doesn't if you then ",[29,835,705],{}," the map result. Await the individual promises later or use ",[29,838,839],{},"Promise.all",[14,841,843],{"id":842},"spot-the-bug","🧠 Spot the Bug",[251,845,846],{},"What does this log?",[19,848,849],{"language":21},[23,850,852],{"className":25,"code":851,"language":21,"meta":27,"style":27},"async function test() {\n  const a = await Promise.resolve(1)\n  const b = Promise.resolve(2)  \u002F\u002F forgot await\n  const c = await Promise.resolve(3)\n  \n  return [a, b, c]\n}\n\ntest().then(([a, b, c]) => {\n  console.log(typeof a, typeof b, typeof c)\n})\n",[29,853,854,865,888,913,936,941,948,952,956,987,1012],{"__ignoreMap":27},[32,855,856,858,860,863],{"class":34,"line":35},[32,857,46],{"class":45},[32,859,49],{"class":45},[32,861,862],{"class":52}," test",[32,864,276],{"class":56},[32,866,867,869,871,873,875,877,879,882,884,886],{"class":34,"line":42},[32,868,70],{"class":45},[32,870,452],{"class":73},[32,872,77],{"class":45},[32,874,80],{"class":45},[32,876,567],{"class":73},[32,878,337],{"class":56},[32,880,881],{"class":52},"resolve",[32,883,57],{"class":56},[32,885,228],{"class":73},[32,887,97],{"class":56},[32,889,890,892,894,896,898,900,902,904,907,910],{"class":34,"line":67},[32,891,70],{"c