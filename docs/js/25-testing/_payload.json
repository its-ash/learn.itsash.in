7,369],{"class":62,"line":368},22,[60,370,246],{"class":70},[372,373,374],"p",{},"::",[14,376,378],{"id":377},"mocking","Mocking",[46,380,381],{"language":48},[51,382,384],{"className":53,"code":383,"language":48,"meta":55,"style":55},"import { vi } from 'vitest'\n\n\u002F\u002F Mock a module\nvi.mock('.\u002Fapi.js', () => ({\n  fetchUser: vi.fn(() => Promise.resolve({ id: 1, name: 'Alice' }))\n}))\n\n\u002F\u002F Spy on a method\nconst spy = vi.spyOn(console, 'log')\nsomeFunction()\nexpect(spy).toHaveBeenCalledWith('hello')\nspy.mockRestore()\n",[57,385,386,397,401,407,427,462,467,471,476,501,509,527],{"__ignoreMap":55},[60,387,388,390,393,395],{"class":62,"line":63},[60,389,67],{"class":66},[60,391,392],{"class":70}," { vi } ",[60,394,74],{"class":66},[60,396,78],{"class":77},[60,398,399],{"class":62,"line":81},[60,400,98],{"emptyLinePlaceholder":97},[60,402,403],{"class":62,"line":94},[60,404,406],{"class":405},"sdCPZ","\u002F\u002F Mock a module\n",[60,408,409,412,415,417,420,422,424],{"class":62,"line":101},[60,410,411],{"class":70},"vi.",[60,413,414],{"class":104},"mock",[60,416,108],{"class":70},[60,418,419],{"class":77},"'.\u002Fapi.js'",[60,421,114],{"class":70},[60,423,117],{"class":66},[60,425,426],{"class":70}," ({\n",[60,428,429,432,435,438,440,443,446,449,452,454,457,459],{"class":62,"line":123},[60,430,431],{"class":70},"  fetchUser: vi.",[60,433,434],{"class":104},"fn",[60,436,437],{"class":70},"(() ",[60,439,117],{"class":66},[60,441,442],{"class":153}," Promise",[60,444,445],{"class":70},".",[60,447,448],{"class":104},"resolve",[60,450,451],{"class":70},"({ id: ",[60,453,154],{"class":153},[60,455,456],{"class":70},", name: ",[60,458,298],{"class":77},[60,460,461],{"class":70}," }))\n",[60,463,464],{"class":62,"line":140},[60,465,466],{"class":70},"}))\n",[60,468,469],{"class":62,"line":177},[60,470,98],{"emptyLinePlaceholder":97},[60,472,473],{"class":62,"line":183},[60,474,475],{"class":405},"\u002F\u002F Spy on a method\n",[60,477,478,481,484,487,490,493,496,499],{"class":62,"line":188},[60,479,480],{"class":66},"const",[60,482,483],{"class":153}," spy",[60,485,486],{"class":66}," =",[60,488,489],{"class":70}," vi.",[60,491,492],{"class":104},"spyOn",[60,494,495],{"class":70},"(console, ",[60,497,498],{"class":77},"'log'",[60,500,174],{"class":70},[60,502,503,506],{"class":62,"line":204},[60,504,505],{"class":104},"someFunction",[60,507,508],{"class":70},"()\n",[60,510,511,514,517,520,522,525],{"class":62,"line":238},[60,512,513],{"class":104},"expect",[60,515,516],{"class":70},"(spy).",[60,518,519],{"class":104},"toHaveBeenCalledWith",[60,521,108],{"class":70},[60,523,524],{"class":77},"'hello'",[60,526,174],{"class":70},[60,528,529,532,535],{"class":62,"line":243},[60,530,531],{"class":70},"spy.",[60,533,534],{"class":104},"mockRestore",[60,536,508],{"class":70},[372,538,374],{},[14,540,542],{"id":541},"tdd-cycle","TDD Cycle",[544,545,546,552,558],"ol",{},[22,547,548,551],{},[25,549,550],{},"Red"," — write a failing test",[22,553,554,557],{},[25,555,556],{},"Green"," — write minimal code to pass",[22,559,560,563],{},[25,561,562],{},"Refactor"," — improve the code while tests stay green",[14,565,567],{"id":566},"tips-tricks","💡 Tips & Tricks",[372,569,570,576,577,580,581,584,585,588],{},[25,571,572,575],{},[57,573,574],{},"vi.useFakeTimers()"," makes timer-based tests instant"," — Testing a ",[57,578,579],{},"debounce"," or ",[57,582,583],{},"setTimeout","-based function no longer requires real waiting: ",[57,586,587],{},"vi.useFakeTimers(); fn(); vi.advanceTimersByTime(300)"," fast-forwards virtual time synchronously.",[372,590,591,601,602,605],{},[25,592,593,596,597,600],{},[57,594,595],{},"test.each"," \u002F ",[57,598,599],{},"it.each"," eliminate copy-pasted test cases"," — ",[57,603,604],{},"it.each([[1, 2, 3], [-1, -2, -3]])('sums %i and %i', (a, b, expected) => expect(sum(a, b)).toBe(expected))"," turns a table of inputs into separate named test cases without duplicating the assertion logic.",[372,607,608,601,611,614],{},[25,609,610],{},"Snapshot testing catches unintended output drift",[57,612,613],{},"expect(renderedHtml).toMatchSnapshot()"," stores the first output and fails future runs if it changes unexpectedly — useful for complex objects or markup, but review snapshot diffs carefully rather than blindly updating them.",[372,616,617,626,627,630,631,634],{},[25,618,619,622,623],{},[57,620,621],{},"vi.spyOn"," restores automatically with ",[57,624,625],{},"restoreMocks: true"," — Setting that option in ",[57,628,629],{},"vitest.config.js"," avoids the easy-to-forget ",[57,632,633],{},"spy.mockRestore()"," at the end of every test.",[372,636,637,601,647,650,651,653],{},[25,638,639,640,643,644],{},"Run only the failing test with ",[57,641,642],{},".only",", skip the rest with ",[57,645,646],{},".skip",[57,648,649],{},"it.only('this one', ...)"," narrows a run to a single case while debugging — just remember to remove ",[57,652,642],{}," before committing, since CI will silently skip everything else.",[14,655,657],{"id":656},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[372,659,660,601,667,670,671,580,673,676,677,580,680,682],{},[25,661,662,663,666],{},"Forgetting ",[57,664,665],{},"await"," on an async assertion passes silently",[57,668,669],{},"it('fetches user', () => { expect(fetchUser()).resolves.toEqual(user) })"," without ",[57,672,665],{},[57,674,675],{},"return"," lets the test finish and report \"passed\" before the promise ever settles — the assertion never actually runs. Always ",[57,678,679],{},"await expect(...).resolves...",[57,681,675],{}," the expectation.",[372,684,685,601,691,694],{},[25,686,687,688],{},"Mocked modules leak between test files without ",[57,689,690],{},"vi.resetModules()",[57,692,693],{},"vi.mock('.\u002Fapi.js', ...)"," at the top of a file affects the module registry; if another test file expects the real implementation and modules aren't reset, it can silently receive the mock instead, depending on run order and isolation settings.",[372,696,697,601,706,709,710,712,713,716,717,720,721,723,724,726],{},[25,698,699,701,702,705],{},[57,700,166],{}," vs ",[57,703,704],{},"toEqual"," trips up object comparisons",[57,707,708],{},"expect({ a: 1 }).toBe({ a: 1 })"," fails because ",[57,711,166],{}," uses ",[57,714,715],{},"Object.is"," (reference equality) — two separately created objects are never ",[57,718,719],{},"===",". Use ",[57,722,704],{}," for deep value comparison, ",[57,725,166],{}," only for primitives or reference identity checks.",[372,728,729,601,736,739,740,742],{},[25,730,731,732,735],{},"A spy on ",[57,733,734],{},"console.log"," can mask real errors in test output",[57,737,738],{},"vi.spyOn(console, 'log')"," silences the console for the rest of the test unless you also call ",[57,741,633],{}," — an uncaught error logged by other code inside the same test run becomes invisible.",[372,744,745,748,749,751],{},[25,746,747],{},"Flaky tests from real timers racing with assertions"," — A test that calls a debounced function and asserts immediately (without fake timers or an explicit wait) passes locally on a fast machine but fails intermittently in CI, because the assertion runs before the real ",[57,750,583],{}," fires.",[14,753,755],{"id":754},"spot-the-bug","🧠 Spot the Bug",[372,757,758],{},"What's wrong with this test, and does it actually catch a broken implementation?",[46,760,761],{"language":48},[51,762,764],{"className":53,"code":763,"language":48,"meta":55,"style":55},"import { it, expect, vi } from 'vitest'\nimport { fetchUserName } from '.\u002Fuser.js'\n\nit('fetches the user name', () => {\n  vi.mock('.\u002Fapi.js', () => ({\n    getUser: vi.fn(() => Promise.resolve({ name: 'Alice' }))\n  }))\n\n  expect(fetchUserName(1)).resolves.toBe('Alice')\n})\n",[57,765,766,777,789,793,809,826,850,855,859,884],{"__ignoreMap":55},[60,767,768,770,773,775],{"class":62,"line":63},[60,769,67],{"class":66},[60,771,772],{"class":70}," { it, expect, vi } ",[60,774,74],{"class":66},[60,776,78],{"class":77},[60,778,779,781,784,786],{"class":62,"line":81},[60,780,67],{"class":66},[60,782,783],{"class":70}," { fetchUserName } ",[60,785,74],{"class":66},[60,787,788],{"class":77}," '.\u002Fuser.js'\n",[60,790,791],{"class":62,"line":94},[60,792,98],{"emptyLinePlaceholder":97},[60,794,795,798,800,803,805,807],{"class":62,"line":101},[60,796,797],{"class":104},"it",[60,799,108],{"class":70},[60,801,802],{"class":77},"'fetches the user name'",[60,804,114],{"class":70},[60,806,117],{"class":66},[60,808,120],{"class":70},[60,810,811,814,816,818,820,822,824],{"class":62,"line":123},[60,812,813],{"class":70},"  vi.",[60,815,414],{"class":104},[60,817,108],{"class":70},[60,819,419],{"class":77},[60,821,114],{"class":70},[60,823,117],{"class":66},[60,825,426],{"class":70},[60,827,828,831,833,835,837,839,841,843,846,848],{"class":62,"line":140},[60,829,830],{"class":70},"    getUser: vi.",[60,832,434],{"class":104},[60,834,437],{"class":70},[60,836,117],{"class":66},[60,838,442],{"class":153},[60,840,445],{"class":70},[60,842,448],{"class":104},[60,844,845],{"class":70},"({ name: ",[60,847,298],{"class":77},[60,849,461],{"class":70},[60,851,852],{"class":62,"line":177},[60,853,854],{"class":70},"  }))\n",[60,856,857],{"class":62,"line":183},[60,858,98],{"emptyLinePlaceholder":97},[60,860,861,864,866,869,871,873,876,878,880,882],{"class":62,"line":188},[60,862,863],{"class":104},"  expect",[60,865,108],{"class":70},[60,867,868],{"class":104},"fetchUserName",[60,870,108],{"class":70},[60,872,154],{"class":153},[60,874,875],{"class":70},")).resolves.",[60,877,166],{"class":104},[60,879,108],{"class":70},[60,881,298],{"class":77},[60,883,174],{"class":70},[60,885,886],{"class":62,"line":204},[60,887,246],{"class":70},[889,890,891,895,912],"details",{},[892,893,894],"summary",{},"Answer",[372,896,897,898,900,901,904,905,908,909,911],{},"The test passes even if ",[57,899,868],{}," is completely broken (e.g. returns ",[57,902,903],{},"undefined"," or throws). ",[57,906,907],{},"expect(promise).resolves.toBe(...)"," itself returns a promise, but the ",[57,910,797],{}," callback never returns or awaits it — Vitest considers the test \"done\" the instant the synchronous body finishes, before the assertion has a chance to run or fail.",[372,913,914,917,918,580,920,922,923,926,927,930,931,933],{},[25,915,916],{},"The lesson",": always ",[57,919,675],{},[57,921,665],{}," promise-based assertions (",[57,924,925],{},"return expect(fetchUserName(1)).resolves.toBe('Alice')"," or mark the test ",[57,928,929],{},"async"," and ",[57,932,665],{}," it) — otherwise the assertion is scheduled but never checked before the test is marked green.",[14,935,937],{"id":936},"key-takeaways","Key Takeaways",[19,939,940,943,946,949],{},[22,941,942],{},"Unit tests cover individual functions; E2E tests cover user flows.",[22,944,945],{},"Mock external dependencies (APIs, DB) — test your logic, not their internals.",[22,947,948],{},"TDD: write the test first, watch it fail, implement, watch it pass, refactor.",[22,950,951],{},"Run tests on every commit — CI automation prevents regressions.",[953,954,955],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(