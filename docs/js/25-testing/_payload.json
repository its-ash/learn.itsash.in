"class":62,"line":368},22,[60,370,246],{"class":70},[14,372,374],{"id":373},"mocking","Mocking",[46,376,377],{"language":48},[51,378,380],{"className":53,"code":379,"language":48,"meta":55,"style":55},"import { vi } from 'vitest'\n\n\u002F\u002F Mock a module\nvi.mock('.\u002Fapi.js', () => ({\n  fetchUser: vi.fn(() => Promise.resolve({ id: 1, name: 'Alice' }))\n}))\n\n\u002F\u002F Spy on a method\nconst spy = vi.spyOn(console, 'log')\nsomeFunction()\nexpect(spy).toHaveBeenCalledWith('hello')\nspy.mockRestore()\n",[57,381,382,393,397,403,423,458,463,467,472,497,505,523],{"__ignoreMap":55},[60,383,384,386,389,391],{"class":62,"line":63},[60,385,67],{"class":66},[60,387,388],{"class":70}," { vi } ",[60,390,74],{"class":66},[60,392,78],{"class":77},[60,394,395],{"class":62,"line":81},[60,396,98],{"emptyLinePlaceholder":97},[60,398,399],{"class":62,"line":94},[60,400,402],{"class":401},"sdCPZ","\u002F\u002F Mock a module\n",[60,404,405,408,411,413,416,418,420],{"class":62,"line":101},[60,406,407],{"class":70},"vi.",[60,409,410],{"class":104},"mock",[60,412,108],{"class":70},[60,414,415],{"class":77},"'.\u002Fapi.js'",[60,417,114],{"class":70},[60,419,117],{"class":66},[60,421,422],{"class":70}," ({\n",[60,424,425,428,431,434,436,439,442,445,448,450,453,455],{"class":62,"line":123},[60,426,427],{"class":70},"  fetchUser: vi.",[60,429,430],{"class":104},"fn",[60,432,433],{"class":70},"(() ",[60,435,117],{"class":66},[60,437,438],{"class":153}," Promise",[60,440,441],{"class":70},".",[60,443,444],{"class":104},"resolve",[60,446,447],{"class":70},"({ id: ",[60,449,154],{"class":153},[60,451,452],{"class":70},", name: ",[60,454,298],{"class":77},[60,456,457],{"class":70}," }))\n",[60,459,460],{"class":62,"line":140},[60,461,462],{"class":70},"}))\n",[60,464,465],{"class":62,"line":177},[60,466,98],{"emptyLinePlaceholder":97},[60,468,469],{"class":62,"line":183},[60,470,471],{"class":401},"\u002F\u002F Spy on a method\n",[60,473,474,477,480,483,486,489,492,495],{"class":62,"line":188},[60,475,476],{"class":66},"const",[60,478,479],{"class":153}," spy",[60,481,482],{"class":66}," =",[60,484,485],{"class":70}," vi.",[60,487,488],{"class":104},"spyOn",[60,490,491],{"class":70},"(console, ",[60,493,494],{"class":77},"'log'",[60,496,174],{"class":70},[60,498,499,502],{"class":62,"line":204},[60,500,501],{"class":104},"someFunction",[60,503,504],{"class":70},"()\n",[60,506,507,510,513,516,518,521],{"class":62,"line":238},[60,508,509],{"class":104},"expect",[60,511,512],{"class":70},"(spy).",[60,514,515],{"class":104},"toHaveBeenCalledWith",[60,517,108],{"class":70},[60,519,520],{"class":77},"'hello'",[60,522,174],{"class":70},[60,524,525,528,531],{"class":62,"line":243},[60,526,527],{"class":70},"spy.",[60,529,530],{"class":104},"mockRestore",[60,532,504],{"class":70},[14,534,536],{"id":535},"tdd-cycle","TDD Cycle",[538,539,540,546,552],"ol",{},[22,541,542,545],{},[25,543,544],{},"Red"," — write a failing test",[22,547,548,551],{},[25,549,550],{},"Green"," — write minimal code to pass",[22,553,554,557],{},[25,555,556],{},"Refactor"," — improve the code while tests stay green",[14,559,561],{"id":560},"tips-tricks","💡 Tips & Tricks",[563,564,565,571,572,575,576,579,580,583],"p",{},[25,566,567,570],{},[57,568,569],{},"vi.useFakeTimers()"," makes timer-based tests instant"," — Testing a ",[57,573,574],{},"debounce"," or ",[57,577,578],{},"setTimeout","-based function no longer requires real waiting: ",[57,581,582],{},"vi.useFakeTimers(); fn(); vi.advanceTimersByTime(300)"," fast-forwards virtual time synchronously.",[563,585,586,596,597,600],{},[25,587,588,591,592,595],{},[57,589,590],{},"test.each"," \u002F ",[57,593,594],{},"it.each"," eliminate copy-pasted test cases"," — ",[57,598,599],{},"it.each([[1, 2, 3], [-1, -2, -3]])('sums %i and %i', (a, b, expected) => expect(sum(a, b)).toBe(expected))"," turns a table of inputs into separate named test cases without duplicating the assertion logic.",[563,602,603,596,606,609],{},[25,604,605],{},"Snapshot testing catches unintended output drift",[57,607,608],{},"expect(renderedHtml).toMatchSnapshot()"," stores the first output and fails future runs if it changes unexpectedly — useful for complex objects or markup, but review snapshot diffs carefully rather than blindly updating them.",[563,611,612,621,622,625,626,629],{},[25,613,614,617,618],{},[57,615,616],{},"vi.spyOn"," restores automatically with ",[57,619,620],{},"restoreMocks: true"," — Setting that option in ",[57,623,624],{},"vitest.config.js"," avoids the easy-to-forget ",[57,627,628],{},"spy.mockRestore()"," at the end of every test.",[563,631,632,596,642,645,646,648],{},[25,633,634,635,638,639],{},"Run only the failing test with ",[57,636,637],{},".only",", skip the rest with ",[57,640,641],{},".skip",[57,643,644],{},"it.only('this one', ...)"," narrows a run to a single case while debugging — just remember to remove ",[57,647,637],{}," before committing, since CI will silently skip everything else.",[14,650,652],{"id":651},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[563,654,655,596,662,665,666,575,668,671,672,575,675,677],{},[25,656,657,658,661],{},"Forgetting ",[57,659,660],{},"await"," on an async assertion passes silently",[57,663,664],{},"it('fetches user', () => { expect(fetchUser()).resolves.toEqual(user) })"," without ",[57,667,660],{},[57,669,670],{},"return"," lets the test finish and report \"passed\" before the promise ever settles — the assertion never actually runs. Always ",[57,673,674],{},"await expect(...).resolves...",[57,676,670],{}," the expectation.",[563,679,680,596,686,689],{},[25,681,682,683],{},"Mocked modules leak between test files without ",[57,684,685],{},"vi.resetModules()",[57,687,688],{},"vi.mock('.\u002Fapi.js', ...)"," at the top of a file affects the module registry; if another test file expects the real implementation and modules aren't reset, it can silently receive the mock instead, depending on run order and isolation settings.",[563,691,692,596,701,704,705,707,708,711,712,715,716,718,719,721],{},[25,693,694,696,697,700],{},[57,695,166],{}," vs ",[57,698,699],{},"toEqual"," trips up object comparisons",[57,702,703],{},"expect({ a: 1 }).toBe({ a: 1 })"," fails because ",[57,706,166],{}," uses ",[57,709,710],{},"Object.is"," (reference equality) — two separately created objects are never ",[57,713,714],{},"===",". Use ",[57,717,699],{}," for deep value comparison, ",[57,720,166],{}," only for primitives or reference identity checks.",[563,723,724,596,731,734,735,737],{},[25,725,726,727,730],{},"A spy on ",[57,728,729],{},"console.log"," can mask real errors in test output",[57,732,733],{},"vi.spyOn(console, 'log')"," silences the console for the rest of the test unless you also call ",[57,736,628],{}," — an uncaught error logged by other code inside the same test run becomes invisible.",[563,739,740,743,744,746],{},[25,741,742],{},"Flaky tests from real timers racing with assertions"," — A test that calls a debounced function and asserts immediately (without fake timers or an explicit wait) passes locally on a fast machine but fails intermittently in CI, because the assertion runs before the real ",[57,745,578],{}," fires.",[14,748,750],{"id":749},"spot-the-bug","🧠 Spot the Bug",[563,752,753],{},"What's wrong with this test, and does it actually catch a broken implementation?",[46,755,756],{"language":48},[51,757,759],{"className":53,"code":758,"language":48,"meta":55,"style":55},"import { it, expect, vi } from 'vitest'\nimport { fetchUserName } from '.\u002Fuser.js'\n\nit('fetches the user name', () => {\n  vi.mock('.\u002Fapi.js', () => ({\n    getUser: vi.fn(() => Promise.resolve({ name: 'Alice' }))\n  }))\n\n  expect(fetchUserName(1)).resolves.toBe('Alice')\n})\n",[57,760,761,772,784,788,804,821,845,850,854,879],{"__ignoreMap":55},[60,762,763,765,768,770],{"class":62,"line":63},[60,764,67],{"class":66},[60,766,767],{"class":70}," { it, expect, vi } ",[60,769,74],{"class":66},[60,771,78],{"class":77},[60,773,774,776,779,781],{"class":62,"line":81},[60,775,67],{"class":66},[60,777,778],{"class":70}," { fetchUserName } ",[60,780,74],{"class":66},[60,782,783],{"class":77}," '.\u002Fuser.js'\n",[60,785,786],{"class":62,"line":94},[60,787,98],{"emptyLinePlaceholder":97},[60,789,790,793,795,798,800,802],{"class":62,"line":101},[60,791,792],{"class":104},"it",[60,794,108],{"class":70},[60,796,797],{"class":77},"'fetches the user name'",[60,799,114],{"class":70},[60,801,117],{"class":66},[60,803,120],{"class":70},[60,805,806,809,811,813,815,817,819],{"class":62,"line":123},[60,807,808],{"class":70},"  vi.",[60,810,410],{"class":104},[60,812,108],{"class":70},[60,814,415],{"class":77},[60,816,114],{"class":70},[60,818,117],{"class":66},[60,820,422],{"class":70},[60,822,823,826,828,830,832,834,836,838,841,843],{"class":62,"line":140},[60,824,825],{"class":70},"    getUser: vi.",[60,827,430],{"class":104},[60,829,433],{"class":70},[60,831,117],{"class":66},[60,833,438],{"class":153},[60,835,441],{"class":70},[60,837,444],{"class":104},[60,839,840],{"class":70},"({ name: ",[60,842,298],{"class":77},[60,844,457],{"class":70},[60,846,847],{"class":62,"line":177},[60,848,849],{"class":70},"  }))\n",[60,851,852],{"class":62,"line":183},[60,853,98],{"emptyLinePlaceholder":97},[60,855,856,859,861,864,866,868,871,873,875,877],{"class":62,"line":188},[60,857,858],{"class":104},"  expect",[60,860,108],{"class":70},[60,862,863],{"class":104},"fetchUserName",[60,865,108],{"class":70},[60,867,154],{"class":153},[60,869,870],{"class":70},")).resolves.",[60,872,166],{"class":104},[60,874,108],{"class":70},[60,876,298],{"class":77},[60,878,174],{"class":70},[60,880,881],{"class":62,"line":204},[60,882,246],{"class":70},[884,885,886,890,907],"details",{},[887,888,889],"summary",{},"Answer",[563,891,892,893,895,896,899,900,903,904,906],{},"The test passes even if ",[57,894,863],{}," is completely broken (e.g. returns ",[57,897,898],{},"undefined"," or throws). ",[57,901,902],{},"expect(promise).resolves.toBe(...)"," itself returns a promise, but the ",[57,905,792],{}," callback never returns or awaits it — Vitest considers the test \"done\" the instant the synchronous body finishes, before the assertion has a chance to run or fail.",[563,908,909,912,913,575,915,917,918,921,922,925,926,928],{},[25,910,911],{},"The lesson",": always ",[57,914,670],{},[57,916,660],{}," promise-based assertions (",[57,919,920],{},"return expect(fetchUserName(1)).resolves.toBe('Alice')"," or mark the test ",[57,923,924],{},"async"," and ",[57,927,660],{}," it) — otherwise the assertion is scheduled but never checked before the test is marked green.",[14,930,932],{"id":931},"key-takeaways","Key Takeaways",[19,934,935,938,941,944],{},[22,936,937],{},"Unit tests cover individual functions; E2E tests cover user flows.",[22,939,940],{},"Mock external dependencies (APIs, DB) — test your logic, not their internals.",[22,942,943],{},"TDD: write the test first, watch it fail, implement, watch it pass, refactor.",[22,945,946],{},"Run tests on every commit — CI automation prevents regressions.",[948,949,950],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--