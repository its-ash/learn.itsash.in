orks\" but is fragile. Refactor to avoid.",[191,938,939,877,942,945,946,949],{},[868,940,941],{},"Default and named exports can't be mixed cleanly",[30,943,944],{},"export default x"," and ",[30,947,948],{},"export { y }"," from same module is confusing. Pick one style per file.",[191,951,952,955],{},[868,953,954],{},"Module-level side effects"," — Top-level code in modules runs when imported. If module runs expensive setup or mutates globals, every import triggers it. Be careful with side effects.",[191,957,958,961,962,965,966,969],{},[868,959,960],{},"import.meta is not available in CommonJS"," — If you need to detect module type, ",[30,963,964],{},"typeof import.meta"," is \"undefined\" in CJS. Use ",[30,967,968],{},"typeof require !== 'undefined'"," instead.",[191,971,972,877,975,978],{},[868,973,974],{},"Dynamic import strings can't be bundled",[30,976,977],{},"await import(userInput)"," can't be pre-analyzed by bundlers. Use dynamic import sparingly or with explicit strings.",[191,980,981,877,984,986,987,990,991,994],{},[868,982,983],{},"Re-exports don't re-execute",[30,985,880],{}," doesn't run ",[30,988,989],{},".\u002Fmodule","'s side effects twice. But ",[30,992,993],{},"import '.\u002Fmodule'; export * from '.\u002Fmodule'"," does run it once (implicitly imported).",[14,996,998],{"id":997},"spot-the-bug","🧠 Spot the Bug",[191,1000,1001],{},"What happens?",[19,1003,1004],{"language":21},[24,1005,1007],{"className":26,"code":1006,"language":21,"meta":28,"style":28},"\u002F\u002F moduleA.js\nimport { func } from '.\u002FmoduleB.js'\nconsole.log('A loaded')\nexport const a = func()\n\n\u002F\u002F moduleB.js\nimport { a } from '.\u002FmoduleA.js'\nconsole.log('B loaded')\nexport const func = () => 'result'\n\n\u002F\u002F main.js\nimport { a } from '.\u002FmoduleA.js'\nconsole.log(a)\n",[30,1008,1009,1014,1026,1041,1057,1061,1066,1078,1091,1110,1114,1119,1129],{"__ignoreMap":28},[33,1010,1011],{"class":35,"line":36},[33,1012,1013],{"class":39},"\u002F\u002F moduleA.js\n",[33,1015,1016,1018,1021,1023],{"class":35,"line":43},[33,1017,211],{"class":46},[33,1019,1020],{"class":75}," { func } ",[33,1022,217],{"class":46},[33,1024,1025],{"class":220}," '.\u002FmoduleB.js'\n",[33,1027,1028,1031,1034,1036,1039],{"class":35,"line":63},[33,1029,1030],{"class":75},"console.",[33,1032,1033],{"class":71},"log",[33,1035,76],{"class":75},[33,1037,1038],{"class":220},"'A loaded'",[33,1040,410],{"class":75},[33,1042,1043,1045,1047,1050,1052,1055],{"class":35,"line":98},[33,1044,47],{"class":46},[33,1046,50],{"class":46},[33,1048,1049],{"class":53}," a",[33,1051,57],{"class":46},[33,1053,1054],{"class":71}," func",[33,1056,424],{"class":75},[33,1058,1059],{"class":35,"line":126},[33,1060,130],{"emptyLinePlaceholder":129},[33,1062,1063],{"class":35,"line":133},[33,1064,1065],{"class":39},"\u002F\u002F moduleB.js\n",[33,1067,1068,1070,1073,1075],{"class":35,"line":139},[33,1069,211],{"class":46},[33,1071,1072],{"class":75}," { a } ",[33,1074,217],{"class":46},[33,1076,1077],{"class":220}," '.\u002FmoduleA.js'\n",[33,1079,1080,1082,1084,1086,1089],{"class":35,"line":156},[33,1081,1030],{"class":75},[33,1083,1033],{"class":71},[33,1085,76],{"class":75},[33,1087,1088],{"class":220},"'B loaded'",[33,1090,410],{"class":75},[33,1092,1093,1095,1097,1099,1101,1104,1107],{"class":35,"line":186},[33,1094,47],{"class":46},[33,1096,50],{"class":46},[33,1098,1054],{"class":71},[33,1100,57],{"class":46},[33,1102,1103],{"class":75}," () ",[33,1105,1106],{"class":46},"=>",[33,1108,1109],{"class":220}," 'result'\n",[33,1111,1112],{"class":35,"line":268},[33,1113,130],{"emptyLinePlaceholder":129},[33,1115,1116],{"class":35,"line":274},[33,1117,1118],{"class":39},"\u002F\u002F main.js\n",[33,1120,1121,1123,1125,1127],{"class":35,"line":292},[33,1122,211],{"class":46},[33,1124,1072],{"class":75},[33,1126,217],{"class":46},[33,1128,1077],{"class":220},[33,1130,1131,1133,1135],{"class":35,"line":304},[33,1132,1030],{"class":75},[33,1134,1033],{"class":71},[33,1136,1137],{"class":75},"(a)\n",[1139,1140,1141,1145,1148,1151,1180],"details",{},[1142,1143,1144],"summary",{},"Answer",[191,1146,1147],{},"Logs: \"B loaded\", \"A loaded\", undefined",[191,1149,1150],{},"Here's why:",[1152,1153,1154,1158,1161,1170],"ul",{},[1155,1156,1157],"li",{},"A imports B, which imports A",[1155,1159,1160],{},"B loads first (cyclic dependency)",[1155,1162,1163,1164,1166,1167,1169],{},"When B tries to import ",[30,1165,164],{}," from A, A isn't finished yet, so ",[30,1168,164],{}," is undefined",[1155,1171,1172,1173,1175,1176,1179],{},"B finishes, A finishes, but ",[30,1174,164],{}," was already set to ",[30,1177,1178],{},"func()"," when func wasn't defined",[191,1181,1182,1185],{},[868,1183,1184],{},"The lesson",": Circular dependencies cause partial initialization. Refactor to avoid them.",[14,1187,1189],{"id":1188},"key-takeaways","Key Takeaways",[1152,1191,1192,1201,1204,1211,1220],{},[1155,1193,1194,1195,1197,1198,1200],{},"ES modules use ",[30,1196,211],{},"\u002F",[30,1199,47],{}," — static, hoisted, supports tree-shaking.",[1155,1202,1203],{},"Named exports are preferred over default — better IDE support and refactoring.",[1155,1205,1206,1207,1210],{},"Dynamic ",[30,1208,1209],{},"import()"," returns a promise — use for lazy loading and code splitting.",[1155,1212,1213,1214,881,1217,1219],{},"Set ",[30,1215,1216],{},"\"type\": \"module\"",[30,1218,655],{}," to use ESM in Node.js.",[1155,1221,1222],{},"Circular dependencies work but are fragile — avoid them.",[1224,1225,1226],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .s