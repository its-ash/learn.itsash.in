"best-practices","Best Practices",[19,753,754],{"language":21},[24,755,757],{"className":26,"code":756,"language":21,"meta":28,"style":28},"\u002F\u002F ✅ Prefer named exports — better refactor support, tree-shaking\nexport function add(a, b) { return a + b }\n\n\u002F\u002F ✅ Group related exports in one module\n\u002F\u002F ✅ Use default export only for the \"main\" thing\nexport default class App {}\nexport const version = '1.0.0'\n\n\u002F\u002F ✅ Avoid circular dependencies — A imports B, B imports A\n\u002F\u002F ✅ Use dynamic import for code splitting and lazy loading\n",[30,758,759,764,791,795,800,805,819,833,837,842],{"__ignoreMap":28},[33,760,761],{"class":35,"line":36},[33,762,763],{"class":39},"\u002F\u002F ✅ Prefer named exports — better refactor support, tree-shaking\n",[33,765,766,768,770,773,775,777,779,781,783,785,787,789],{"class":35,"line":43},[33,767,47],{"class":46},[33,769,68],{"class":46},[33,771,772],{"class":71}," add",[33,774,76],{"class":75},[33,776,164],{"class":79},[33,778,167],{"class":75},[33,780,170],{"class":79},[33,782,83],{"class":75},[33,784,86],{"class":46},[33,786,177],{"class":75},[33,788,180],{"class":46},[33,790,183],{"class":75},[33,792,793],{"class":35,"line":63},[33,794,130],{"emptyLinePlaceholder":129},[33,796,797],{"class":35,"line":98},[33,798,799],{"class":39},"\u002F\u002F ✅ Group related exports in one module\n",[33,801,802],{"class":35,"line":126},[33,803,804],{"class":39},"\u002F\u002F ✅ Use default export only for the \"main\" thing\n",[33,806,807,809,811,813,816],{"class":35,"line":133},[33,808,47],{"class":46},[33,810,144],{"class":46},[33,812,147],{"class":46},[33,814,815],{"class":71}," App",[33,817,818],{"class":75}," {}\n",[33,820,821,823,825,828,830],{"class":35,"line":139},[33,822,47],{"class":46},[33,824,50],{"class":46},[33,826,827],{"class":53}," version",[33,829,57],{"class":46},[33,831,832],{"class":216}," '1.0.0'\n",[33,834,835],{"class":35,"line":156},[33,836,130],{"emptyLinePlaceholder":129},[33,838,839],{"class":35,"line":186},[33,840,841],{"class":39},"\u002F\u002F ✅ Avoid circular dependencies — A imports B, B imports A\n",[33,843,844],{"class":35,"line":264},[33,845,846],{"class":39},"\u002F\u002F ✅ Use dynamic import for code splitting and lazy loading\n",[14,848,850],{"id":849},"tips-tricks","💡 Tips & Tricks",[852,853,854,858],"p",{},[855,856,857],"strong",{},"Prefer named exports for tree-shaking"," — Bundlers can eliminate unused named exports. Default exports can't be tree-shaken (bundler doesn't know what's unused).",[852,860,861,864,865,868,869,871,872,412],{},[855,862,863],{},"Aggregate exports with index.js"," — ",[30,866,867],{},"export * from '.\u002Fmodule'"," in ",[30,870,548],{}," gives consumers a single import path. Cleaner than ",[30,873,874],{},"import from '.\u002Fmodule\u002Ffile.js'",[852,876,877,880,881,884],{},[855,878,879],{},"Dynamic import for route splitting"," — In SPA frameworks, lazy-load route modules: ",[30,882,883],{},"const module = await import('.\u002Fpages\u002FAbout.js')",". Reduces initial bundle size.",[852,886,887,864,890,893,894,897,898,412],{},[855,888,889],{},"Use \"imports\" in package.json",[30,891,892],{},"\"#internal\": \".\u002Fsrc\u002Finternal.js\""," lets consumers do ",[30,895,896],{},"import { x } from '#internal'",". Better than relative paths like ",[30,899,900],{},"..\u002F..\u002F..\u002Fsrc",[852,902,903,906,907,910,911,412],{},[855,904,905],{},"Check module.meta.url"," — In ESM, ",[30,908,909],{},"import.meta.url"," is the current module's URL. Useful for dynamic paths: ",[30,912,913],{},"const dir = new URL('.', import.meta.url).pathname",[14,915,917],{"id":916},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[852,919,920,923],{},[855,921,922],{},"Circular dependencies partially work"," — If A imports B and B imports A, one gets undefined values temporarily. It \"works\" but is fragile. Refactor to avoid.",[852,925,926,864,929,932,933,936],{},[855,927,928],{},"Default and named exports can't be mixed cleanly",[30,930,931],{},"export default x"," and ",[30,934,935],{},"export { y }"," from same module is confusing. Pick one style per file.",[852,938,939,942],{},[855,940,941],{},"Module-level side effects"," — Top-level code in modules runs when imported. If module runs expensive setup or mutates globals, every import triggers it. Be careful with side effects.",[852,944,945,948,949,952,953,956],{},[855,946,947],{},"import.meta is not available in CommonJS"," — If you need to detect module type, ",[30,950,951],{},"typeof import.meta"," is \"undefined\" in CJS. Use ",[30,954,955],{},"typeof require !== 'undefined'"," instead.",[852,958,959,864,962,965],{},[855,960,961],{},"Dynamic import strings can't be bundled",[30,963,964],{},"await import(userInput)"," can't be pre-analyzed by bundlers. Use dynamic import sparingly or with explicit strings.",[852,967,968,864,971,973,974,977,978,981],{},[855,969,970],{},"Re-exports don't re-execute",[30,972,867],{}," doesn't run ",[30,975,976],{},".\u002Fmodule","'s side effects twice. But ",[30,979,980],{},"import '.\u002Fmodule'; export * from '.\u002Fmodule'"," does run it once (implicitly imported).",[14,983,985],{"id":984},"spot-the-bug","🧠 Spot the Bug",[852,987,988],{},"What happens?",[24,990,992],{"className":26,"code":991,"language":21,"meta":28,"style":28},"\u002F\u002F moduleA.js\nimport { func } from '.\u002FmoduleB.js'\nconsole.log('A loaded')\nexport const a = func()\n\n\u002F\u002F moduleB.js\nimport { a } from '.\u002FmoduleA.js'\nconsole.log('B loaded')\nexport const func = () => 'result'\n\n\u002F\u002F main.js\nimport { a } from '.\u002FmoduleA.js'\nconsole.log(a)\n",[30,993,994,999,1011,1026,1042,1046,1051,1063,1076,1095,1099,1104,1114],{"__ignoreMap":28},[33,995,996],{"class":35,"line":36},[33,997,998],{"class":39},"\u002F\u002F moduleA.js\n",[33,1000,1001,1003,1006,1008],{"class":35,"line":43},[33,1002,207],{"class":46},[33,1004,1005],{"class":75}," { func } ",[33,1007,213],{"class":46},[33,1009,1010],{"class":216}," '.\u002FmoduleB.js'\n",[33,1012,1013,1016,1019,1021,1024],{"class":35,"line":63},[33,1014,1015],{"class":75},"console.",[33,1017,1018],{"class":71},"log",[33,1020,76],{"class":75},[33,1022,1023],{"class":216},"'A loaded'",[33,1025,404],{"class":75},[33,1027,1028,1030,1032,1035,1037,1040],{"class":35,"line":98},[33,1029,47],{"class":46},[33,1031,50],{"class":46},[33,1033,1034],{"class":53}," a",[33,1036,57],{"class":46},[33,1038,1039],{"class":71}," func",[33,1041,418],{"class":75},[33,1043,1044],{"class":35,"line":126},[33,1045,130],{"emptyLinePlaceholder":129},[33,1047,1048],{"class":35,"line":133},[33,1049,1050],{"class":39},"\u002F\u002F moduleB.js\n",[33,1052,1053,1055,1058,1060],{"class":35,"line":139},[33,1054,207],{"class":46},[33,1056,1057],{"class":75}," { a } ",[33,1059,213],{"class":46},[33,1061,1062],{"class":216}," '.\u002FmoduleA.js'\n",[33,1064,1065,1067,1069,1071,1074],{"class":35,"line":156},[33,1066,1015],{"class":75},[33,1068,1018],{"class":71},[33,1070,76],{"class":75},[33,1072,1073],{"class":216},"'B loaded'",[33,1075,404],{"class":75},[33,1077,1078,1080,1082,1084,1086,1089,1092],{"class":35,"line":186},[33,1079,47],{"class":46},[33,1081,50],{"class":46},[33,1083,1039],{"class":71},[33,1085,57],{"class":46},[33,1087,1088],{"class":75}," () ",[33,1090,1091],{"class":46},"=>",[33,1093,1094],{"class":216}," 'result'\n",[33,1096,1097],{"class":35,"line":264},[33,1098,130],{"emptyLinePlaceholder":129},[33,1100,1101],{"class":35,"line":270},[33,1102,1103],{"class":39},"\u002F\u002F main.js\n",[33,1105,1106,1108,1110,1112],{"class":35,"line":288},[33,1107,207],{"class":46},[33,1109,1057],{"class":75},[33,1111,213],{"class":46},[33,1113,1062],{"class":216},[33,1115,1116,1118,1120],{"class":35,"line":300},[33,1117,1015],{"class":75},[33,1119,1018],{"class":71},[33,1121,1122],{"class":75},"(a)\n",[1124,1125,1126,1130,1133,1136,1165],"details",{},[1127,1128,1129],"summary",{},"Answer",[852,1131,1132],{},"Logs: \"B loaded\", \"A loaded\", undefined",[852,1134,1135],{},"Here's why:",[1137,1138,1139,1143,1146,1155],"ul",{},[1140,1141,1142],"li",{},"A imports B, which imports A",[1140,1144,1145],{},"B loads first (cyclic dependency)",[1140,1147,1148,1149,1151,1152,1154],{},"When B tries to import ",[30,1150,164],{}," from A, A isn't finished yet, so ",[30,1153,164],{}," is undefined",[1140,1156,1157,1158,1160,1161,1164],{},"B finishes, A finishes, but ",[30,1159,164],{}," was already set to ",[30,1162,1163],{},"func()"," when func wasn't defined",[852,1166,1167,1170],{},[855,1168,1169],{},"The lesson",": Circular dependencies cause partial initialization. Refactor to avoid them.",[14,1172,1174],{"id":1173},"key-takeaways","Key Takeaways",[1137,1176,1177,1186,1189,1196,1205],{},[1140,1178,1179,1180,1182,1183,1185],{},"ES modules use ",[30,1181,207],{},"\u002F",[30,1184,47],{}," — static, hoisted, supports tree-shaking.",[1140,1187,1188],{},"Named exports are preferred over default — better IDE support and refactoring.",[1140,1190,1191,1192,1195],{},"Dynamic ",[30,1193,1194],{},"import()"," returns a promise — use for lazy loading and code splitting.",[1140,1197,1198,1199,868,1202,1204],{},"Set ",[30,1200,1201],{},"\"type\": \"module\"",[30,1203,645],{}," to use ESM in Node.js.",[1140,1206,1207],{},"Circular dependencies work but are fragile — avoid them.",[1209,1210,1211],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}html .default .