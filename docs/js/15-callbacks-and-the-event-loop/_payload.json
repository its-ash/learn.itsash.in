nt task, before any macrotask\n",[80,989,990,992,994,996],{"class":82,"line":104},[80,991,46],{"class":90},[80,993,116],{"class":86},[80,995,120],{"class":119},[80,997,530],{"class":86},[80,999,1000,1002,1004,1006,1009],{"class":82,"line":111},[80,1001,554],{"class":86},[80,1003,91],{"class":90},[80,1005,94],{"class":86},[80,1007,1008],{"class":97},"'runs as microtask'",[80,1010,101],{"class":86},[80,1012,1013],{"class":82,"line":142},[80,1014,564],{"class":86},[80,1016,1017],{"class":82,"line":147},[80,1018,108],{"emptyLinePlaceholder":107},[80,1020,1021],{"class":82,"line":181},[80,1022,1023],{"class":208},"\u002F\u002F vs setTimeout (macrotask)\n",[80,1025,1026,1028,1030,1032],{"class":82,"line":186},[80,1027,57],{"class":90},[80,1029,116],{"class":86},[80,1031,120],{"class":119},[80,1033,530],{"class":86},[80,1035,1036,1038,1040,1042,1045],{"class":82,"line":200},[80,1037,554],{"class":86},[80,1039,91],{"class":90},[80,1041,94],{"class":86},[80,1043,1044],{"class":97},"'runs as macrotask'",[80,1046,101],{"class":86},[80,1048,1049,1052,1054],{"class":82,"line":205},[80,1050,1051],{"class":86},"}, ",[80,1053,137],{"class":136},[80,1055,101],{"class":86},[80,1057,1058],{"class":82,"line":212},[80,1059,108],{"emptyLinePlaceholder":107},[80,1061,1062],{"class":82,"line":348},[80,1063,1064],{"class":208},"\u002F\u002F queueMicrotask runs first\n",[14,1066,1068],{"id":1067},"tips-tricks","💡 Tips & Tricks",[19,1070,1071,1074,1075,153],{},[29,1072,1073],{},"Microtasks run between macrotasks"," — If you queue a microtask from a macrotask, it runs before the next macrotask. Useful for batching DOM updates: ",[40,1076,1077],{},"queueMicrotask(() => render())",[19,1079,1080,1083,1084,1087],{},[29,1081,1082],{},"setTimeout(fn, 0) is not \"immediate\""," — It's \"after all microtasks.\" There's always a delay. Use ",[40,1085,1086],{},"Promise.resolve().then()"," if you need to defer without delay.",[19,1089,1090,1093,1094,1097,1098,1101],{},[29,1091,1092],{},"Inspect microtask vs macrotask timing"," — Put ",[40,1095,1096],{},"console.time","\u002F",[40,1099,1100],{},"console.timeEnd"," around code to see actual delays. Helps diagnose event loop issues.",[19,1103,1104,38,1107,1110,1111,1114,1115,1118],{},[29,1105,1106],{},"Promises in loops serialize",[40,1108,1109],{},"promises.map(p => p.then(...))"," is fine, but ",[40,1112,1113],{},"promises.forEach(p => await p)"," is slow (sequential). Use ",[40,1116,1117],{},"Promise.all()"," for parallelism.",[14,1120,1122],{"id":1121},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[19,1124,1125,38,1128,1131],{},[29,1126,1127],{},"setTimeout with small delays don't work",[40,1129,1130],{},"setTimeout(fn, 0)"," is clamped to 4ms minimum in browsers (1ms in some). Actual delay can be much longer if event loop is busy.",[19,1133,1134,1137,1138,153],{},[29,1135,1136],{},"Blocking the event loop hangs the browser"," — Long loops, crypto operations, or heavy parsing freeze the UI. Move work to Web Workers or break into chunks with ",[40,1139,57],{},[19,1141,1142,1145],{},[29,1143,1144],{},"Callbacks aren't truly concurrent"," — They're interleaved on a single thread. If callback A takes 10ms, callback B waits. This isn't \"parallel\" like threads; it's \"cooperative concurrency.\"",[19,1147,1148,1151,1152,1154,1155,1157],{},[29,1149,1150],{},"Promise and setTimeout interleaving is confusing"," — Microtasks queue differently than macrotasks. ",[40,1153,57],{}," -> run one -> check microtasks -> ",[40,1156,57],{}," -> ... . Hard to reason about without drawing diagrams.",[19,1159,1160,1163],{},[29,1161,1162],{},"Forgotten callbacks leak memory"," — If a callback captures huge data and is never called, the data is kept alive. Subscriptions without unsubscribe are a common leak source.",[19,1165,1166,38,1169,1172,1173,1176],{},[29,1167,1168],{},"Mixing Promise and callback styles is error-prone",[40,1170,1171],{},"asyncFn().then().catch()"," and ",[40,1174,1175],{},".catch((err) => callback(err))"," style can cause double-handling or missed errors. Use one style consistently.",[14,1178,1180],{"id":1179},"spot-the-bug","🧠 Spot the Bug",[19,1182,1183],{},"What's the output order?",[72,1185,1187],{"className":74,"code":1186,"language":70,"meta":76,"style":76},"console.log('1')\n\nsetTimeout(() => console.log('2'), 0)\n\nPromise.resolve()\n  .then(() => {\n    console.log('3')\n    return new Promise(resolve => {\n      resolve()\n      console.log('4')\n    })\n  })\n  .then(() => console.log('5'))\n\nqueueMicrotask(() => console.log('6'))\n\nconsole.log('7')\n",[40,1188,1189,1202,1206,1229,1233,1243,1255,1269,1288,1295,1309,1313,1317,1338,1342,1361,1365],{"__ignoreMap":76},[80,1190,1191,1193,1195,1197,1200],{"class":82,"line":83},[80,1192,87],{"class":86},[80,1194,91],{"class":90},[80,1196,94],{"class":86},[80,1198,1199],{"class":97},"'1'",[80,1201,101],{"class":86},[80,1203,1204],{"class":82,"line":104},[80,1205,108],{"emptyLinePlaceholder":107},[80,1207,1208,1210,1212,1214,1216,1218,1220,1223,1225,1227],{"class":82,"line":111},[80,1209,57],{"class":90},[80,1211,116],{"class":86},[80,1213,120],{"class":119},[80,1215,123],{"class":86},[80,1217,91],{"class":90},[80,1219,94],{"class":86},[80,1221,1222],{"class":97},"'2'",[80,1224,133],{"class":86},[80,1226,137],{"class":136},[80,1228,101],{"class":86},[80,1230,1231],{"class":82,"line":142},[80,1232,108],{"emptyLinePlaceholder":107},[80,1234,1235,1237,1239,1241],{"class":82,"line":147},[80,1236,150],{"class":136},[80,1238,153],{"class":86},[80,1240,156],{"class":90},[80,1242,281],{"class":86},[80,1244,1245,1247,1249,1251,1253],{"class":82,"line":181},[80,1246,286],{"class":86},[80,1248,162],{"class":90},[80,1250,116],{"class":86},[80,1252,120],{"class":119},[80,1254,530],{"class":86},[80,1256,1257,1260,1262,1264,1267],{"class":82,"line":186},[80,1258,1259],{"class":86},"    console.",[80,1261,91],{"class":90},[80,1263,94],{"class":86},[80,1265,1266],{"class":97},"'3'",[80,1268,101],{"class":86},[80,1270,1271,1274,1277,1280,1282,1284,1286],{"class":82,"line":200},[80,1272,1273],{"class":119},"    return",[80,1275,1276],{"class":119}," new",[80,1278,1279],{"class":136}," Promise",[80,1281,94],{"class":86},[80,1283,156],{"class":410},[80,1285,442],{"class":119},[80,1287,530],{"class":86},[80,1289,1290,1293],{"class":82,"line":205},[80,1291,1292],{"class":90},"      resolve",[80,1294,281],{"class":86},[80,1296,1297,1300,1302,1304,1307],{"class":82,"line":212},[80,1298,1299],{"class":86},"      console.",[80,1301,91],{"class":90},[80,1303,94],{"class":86},[80,1305,1306],{"class":97},"'4'",[80,1308,101],{"class":86},[80,1310,1311],{"class":82,"line":348},[80,1312,746],{"class":86},[80,1314,1315],{"class":82,"line":354},[80,1316,751],{"class":86},[80,1318,1319,1321,1323,1325,1327,1329,1331,1333,1336],{"class":82,"line":360},[80,1320,286],{"class":86},[80,1322,162],{"class":90},[80,1324,116],{"class":86},[80,1326,120],{"class":119},[80,1328,123],{"class":86},[80,1330,91],{"class":90},[80,1332,94],{"class":86},[80,1334,1335],{"class":97},"'5'",[80,1337,178],{"class":86},[80,1339,1340],{"class":82,"line":366},[80,1341,108],{"emptyLinePlaceholder":107},[80,1343,1344,1346,1348,1350,1352,1354,1356,1359],{"class":82,"line":372},[80,1345,46],{"class":90},[80,1347,116],{"class":86},[80,1349,120],{"class":119},[80,1351,123],{"class":86},[80,1353,91],{"class":90},[80,1355,94],{"class":86},[80,1357,1358],{"class":97},"'6'",[80,1360,178],{"class":86},[80,1362,1363],{"class":82,"line":378},[80,1364,108],{"emptyLinePlaceholder":107},[80,1366,1367,1369,1371,1373,1376],{"class":82,"line":949},[80,1368,87],{"class":86},[80,1370,91],{"class":90},[80,1372,94],{"class":86},[80,1374,1375],{"class":97},"'7'",[80,1377,101],{"class":86},[1379,1380,1381,1385,1392,1445],"details",{},[1382,1383,1384],"summary",{},"Answer",[19,1386,1387,1388,1391],{},"Logs: ",[40,1389,1390],{},"1 7 3 4 6 5 2",". Here's why:",[1393,1394,1395,1404,1420,1428,1437],"ul",{},[26,1396,1397,43,1400,1403],{},[40,1398,1399],{},"1",[40,1401,1402],{},"7"," — synchronous code runs first",[26,1405,1406,43,1409,1412,1413,1416,1417,1419],{},[40,1407,1408],{},"3",[40,1410,1411],{},"4"," — first promise ",[40,1414,1415],{},".then()"," runs (microtask), ",[40,1418,1411],{}," logs before resolve returns",[26,1421,1422,38,1425,1427],{},[40,1423,1424],{},"6",[40,1426,46],{}," is another microtask",[26,1429,1430,1433,1434,1436],{},[40,1431,1432],{},"5"," — second ",[40,1435,1415],{}," runs (chained microtask)",[26,1438,1439,38,1442,1444],{},[40,1440,1441],{},"2",[40,1443,57],{}," is a macrotask (runs last)",[19,1446,1447,1450,1451,1453],{},[29,1448,1449],{},"The lesson",": Microtasks run before macrotasks, even if queued later. Promise construction runs synchronously; the ",[40,1452,1415],{}," is microtask.",[14,1455,1457],{"id":1456},"key-takeaways","Key Takeaways",[1393,1459,1460,1463,1473,1476,1479],{},[26,1461,1462],{},"JS is single-threaded — async operations go to the event loop, not new threads.",[26,1464,1465,1468,1469,1472],{},[29,1466,1467],{},"Microtasks"," (Promises) run before ",[29,1470,1471],{},"macrotasks"," (setTimeout) — always.",[26,1474,1475],{},"The call stack must be empty before the event loop processes the task queue.",[26,1477,1478],{},"Callback hell is solved by Promises and async\u002Fawait — use them instead.",[26,1480,1481],{},"Error-first callback convention is standard in Node.js APIs.",[1483,1484,1485],"style",{},"html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default: