 bus = new EventEmitter()\nconst handler = (data) => console.log(data)\nbus.on('update', handler)\nbus.emit('update', { count: 1 })\nbus.off('update', handler)\n",[29,340,341,351,367,371,388,419,438,442,446,462,490,494,498,513,534,569,574,579,584,600,627,644,665],{"__ignoreMap":27},[32,342,343,346,349],{"class":34,"line":35},[32,344,345],{"class":51},"class",[32,347,348],{"class":58}," EventEmitter",[32,350,173],{"class":65},[32,352,353,356,358,361,364],{"class":34,"line":42},[32,354,355],{"class":69},"  #events",[32,357,62],{"class":51},[32,359,360],{"class":51}," new",[32,362,363],{"class":58}," Map",[32,365,366],{"class":65},"()\n",[32,368,369],{"class":34,"line":48},[32,370,277],{"emptyLinePlaceholder":276},[32,372,373,376,378,381,383,386],{"class":34,"line":94},[32,374,375],{"class":58},"  on",[32,377,154],{"class":65},[32,379,380],{"class":69},"event",[32,382,73],{"class":65},[32,384,385],{"class":69},"callback",[32,387,165],{"class":65},[32,389,390,393,395,398,400,403,406,409,411,413,416],{"class":34,"line":125},[32,391,392],{"class":51},"    if",[32,394,66],{"class":65},[32,396,397],{"class":51},"!",[32,399,202],{"class":201},[32,401,402],{"class":65},".#events.",[32,404,405],{"class":58},"has",[32,407,408],{"class":65},"(event)) ",[32,410,202],{"class":201},[32,412,402],{"class":65},[32,414,415],{"class":58},"set",[32,417,418],{"class":65},"(event, [])\n",[32,420,421,424,426,429,432,435],{"class":34,"line":216},[32,422,423],{"class":201},"    this",[32,425,402],{"class":65},[32,427,428],{"class":58},"get",[32,430,431],{"class":65},"(event).",[32,433,434],{"class":58},"push",[32,436,437],{"class":65},"(callback)\n",[32,439,440],{"class":34,"line":229},[32,441,264],{"class":65},[32,443,444],{"class":34,"line":255},[32,445,277],{"emptyLinePlaceholder":276},[32,447,448,451,453,455,457,460],{"class":34,"line":261},[32,449,450],{"class":58},"  emit",[32,452,154],{"class":65},[32,454,380],{"class":69},[32,456,73],{"class":65},[32,458,459],{"class":69},"data",[32,4