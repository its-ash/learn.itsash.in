ine":48},[32,697,52],{"class":51},[32,699,55],{"class":51},[32,701,702],{"class":197}," config",[32,704,62],{"class":51},[32,706,707],{"class":65}," Object.",[32,709,710],{"class":58},"freeze",[32,712,713],{"class":65},"({\n",[32,715,716,719,722],{"class":34,"line":94},[32,717,718],{"class":65},"  apiUrl: ",[32,720,721],{"class":193},"'https:\u002F\u002Fapi.example.com'",[32,723,724],{"class":65},",\n",[32,726,727,730],{"class":34,"line":125},[32,728,729],{"class":65},"  timeout: ",[32,731,732],{"class":197},"5000\n",[32,734,735],{"class":34,"line":212},[32,736,737],{"class":65},"})\n",[32,739,740],{"class":34,"line":225},[32,741,273],{"emptyLinePlaceholder":272},[32,743,744],{"class":34,"line":251},[32,745,746],{"class":38},"\u002F\u002F Class-based singleton\n",[32,748,749,751,754],{"class":34,"line":257},[32,750,339],{"class":51},[32,752,753],{"class":58}," Database",[32,755,169],{"class":65},[32,757,758,761,764,766],{"class":34,"line":263},[32,759,760],{"class":51},"  static",[32,762,763],{"class":69}," #instance",[32,765,62],{"class":51},[32,767,768],{"class":197}," null\n",[32,770,771,773,776,779],{"class":34,"line":269},[32,772,760],{"class":51},[32,774,775],{"class":51}," get",[32,777,778],{"class":58}," instance",[32,780,781],{"class":65},"() {\n",[32,783,784,786,788,790,793,796,798,800],{"class":34,"line":276},[32,785,386],{"class":51},[32,787,66],{"class":65},[32,789,391],{"class":51},[32,791,792],{"class":65},"Database.#instance) Database.#instance ",[32,794,795],{"class":51},"=",[32,797,354],{"class":51},[32,799,753],{"class":58},[32,801,360],{"class":65},[32,803,804,807],{"class":34,"line":302},[32,805,806],{"class":51},"    return",[32,808,809],{"class":65}," Database.#instance\n",[32,811,812],{"class":34,"line":509},[32,813,260],{"class":65},[32,815,816,819,821],{"class":34,"line":530},[32,817,818],{"class":69},"  #connected",[32,820,62],{"class":51},[32,822,248],{"class":197},[32,824,825,828,830,832,835,837,840],{"class":34,"line":565},[32,826,827],{"class":58},"  connect",[32,829,187],{"class":65},[32,831,198],{"class":197},[32,833,834],{"class":65},".#connected ",[32,836,795],{"class":51},[32,838,839],{"class":197}," true",[32,841,842],{"class":65}," }\n",[32,844,845],{"class":34,"line":570},[32,846,266],{"class":65},[14,848,850],{"id":849},"tips-tricks","💡 Tips & Tricks",[852,853,854,862,863,866,867,870,871,874,875,878,879,882],"p",{},[855,856,857,858,861],"strong",{},"Private fields (",[29,859,860],{},"#field",") enforce true encapsulation"," — Unlike ",[29,864,865],{},"_field"," naming conventions, ",[29,868,869],{},"#events"," in the ",[29,872,873],{},"EventEmitter"," example is genuinely inaccessible from outside the class — ",[29,876,877],{},"instance.#events"," throws a ",[29,880,881],{},"SyntaxError"," outside the class body, not just a lint warning.",[852,884,885,891,892,895,896,899,900,902],{},[855,886,887,888,890],{},"Factory functions sidestep ",[29,889,198],{},"-binding bugs entirely"," — Since ",[29,893,894],{},"createUser"," returns a plain object with methods closing over local variables (or using object shorthand), you never have to worry about ",[29,897,898],{},"new"," being forgotten or a method losing its ",[29,901,198],{}," when passed as a callback.",[852,904,905,908,909,912,913,916],{},[855,906,907],{},"Module pattern for true private state without classes"," — Wrapping variables in a function scope and exporting only what's needed (as in ",[29,910,911],{},"math.js",") gives you privacy for free — no ",[29,914,915],{},"#"," syntax needed, and it predates ES6 classes entirely.",[852,918,919,922,923,926,927,930],{},[855,920,921],{},"Lazy singleton initialization saves startup cost"," — The ",[29,924,925],{},"static get instance()"," pattern only constructs ",[29,928,929],{},"Database"," on first access, not at module load — useful when the singleton is expensive to create but not always needed.",[852,932,933,936,937,940],{},[855,934,935],{},"Observer pattern decouples emitters from listeners for testing"," — Because ",[29,938,939],{},"EventEmitter.emit"," doesn't know or care who's listening, you can test emitted events in isolation by attaching a throwaway listener and asserting on what it received.",[14,942,944],{"id":943},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[852,946,947,950,951,954],{},[855,948,949],{},"Singletons complicate testing"," — A module-level singleton (like the class-based ",[29,952,953],{},"Database.instance",") persists state across test files unless explicitly reset, causing tests to pass or fail depending on run order — a classic \"works alone, fails in the suite\" bug.",[852,956,957,964,965,968,969,972,973,975,976,979],{},[855,958,959,960,963],{},"Forgetting to ",[29,961,962],{},"off()"," an EventEmitter listener leaks memory"," — Each ",[29,966,967],{},"bus.on('update', handler)"," call keeps a reference to ",[29,970,971],{},"handler"," alive inside ",[29,974,869],{}," forever unless ",[29,977,978],{},"bus.off('update', handler)"," is called — in long-lived apps (SPAs), this silently accumulates listeners and can cause the same event to fire the same stale callback multiple times.",[852,981,982,987,988,991,992,994],{},[855,983,984,986],{},[29,985,962],{}," requires the exact same function reference, just like DOM events"," — ",[29,989,990],{},"bus.on('update', data => log(data)); bus.off('update', data => log(data))"," fails silently — the two arrow functions are different objects, so the filter in ",[29,993,666],{}," never matches and the original listener keeps firing.",[852,996,997,1003,1004,1007],{},[855,998,999,1002],{},[29,1000,1001],{},"Object.freeze"," on a config object doesn't stop new property additions from being silently ignored"," — In non-strict mode, ",[29,1005,1006],{},"frozenConfig.newProp = 'x'"," doesn't throw, it just does nothing — leading developers to think the assignment worked when it was silently dropped.",[852,1009,1010,1013,1014,1017,1018,1020,1021,1024],{},[855,1011,1012],{},"Factory-created objects don't share methods across instances"," — Each call to ",[29,1015,1016],{},"createUser()"," defines a ",[855,1019,898],{}," ",[29,1022,1023],{},"greet"," function on the returned object, unlike class instances which share methods via the prototype. This means factories use more memory per instance if you create thousands of objects — a real trade-off, not just a style choice.",[14,1026,1028],{"id":1027},"spot-the-bug","🧠 Spot the Bug",[852,1030,1031],{},"What does this log?",[19,1033,1034],{"language":21},[23,1035,1037],{"className":25,"code":1036,"language":21,"meta":27,"style":27},"class Counter {\n  static #instance = null\n  #count = 0\n\n  static get instance() {\n    if (!Counter.#instance) Counter.#instance = new Counter()\n    return Counter.#instance\n  }\n\n  increment() { this.#count++; return this.#count }\n}\n\nconst a = Counter.instance\nconst b = new Counter()\n\nconsole.log(a.increment())\nconsole.log(b.increment())\nconsole.log(a === b)\n",[29,1038,1039,1048,1058,1068,1072,1082,1101,1108,1112,1116,1141,1145,1149,1161,1176,1180,1196,1209],{"__ignoreMap":27},[32,1040,1041,1043,1046],{"class":34,"line":35},[32,1042,339],{"class":51},[32,1044,1045],{"class":58}," Counter",[32,1047,169],{"class":65},[32,1049,1050,1052,1054,1056],{"class":34,"line":42},[32,1051,760],{"class":51},[32,1053,763],{"class":69},[32,1055,62],{"class":51},[32,1057,768],{"class":197},[32,1059,1060,1063,1065],{"class":34,"line":48},[32,1061,1062],{"class":69},"  #count",[32,1064,62],{"class":51},[32,1066,1067],{"class":197}," 0\n",[32,1069,1070],{"class":34,"line":94},[32,1071,273],{"emptyLinePlaceholder":272},[32,1073,1074,1076,1078,1080],{"class":34,"line":125},[32,1075,760],{"class":51},[32,1077,775],{"class":51},[32,1079,778],{"class":58},[32,1081,781],{"class":65},[32,1083,1084,1086,1088,1090,1093,1095,1097,1099],{"class":34,"line":212},[32,1085,386],{"class":51},[32,1087,66],{"class":65},[32,1089,391],{"class":51},[32,1091,1092],{"class":65},"Counter.#instance) Counter.#instance ",[32,1094,795],{"class":51},[32,1096,354],{"class":51},[32,1098,1045],{"class":58},[32,1100,360],{"class":65},[32,1102,1103,1105],{"class":34,"line":225},[32,1104,806],{"class":51},[32,1106,1107],{"class":65}," Counter.#instance\n",[32,1109,1110],{"class":34,"line":251},[32,1111,260],{"class":65},[32,1113,1114],{"class":34,"line":257},[32,1115,273],{"emptyLinePlaceholder":272},[32,1117,1118,1121,1123,1125,1128,1131,1134,1136,1138],{"class":34,"line":263},[32,1119,1120],{"class":58},"  increment",[32,1122,187],{"class":65},[32,1124,198],{"class":197},[32,1126,1127],{"class":65},".#count",[32,1129,1130],{"class":51},"++",[32,1132,1133],{"class":65},"; ",[32,1135,190],{"class":51},[32,1137,520],{"class":197},[32,1139,1140],{"class":65},".#count }\n",[32,1142,1143],{"class":34,"line":269},[32,1144,266],{"class":65},[32,1146,1147],{"class":34,"line":276},[32,1148,273],{"emptyLinePlaceholder":272},[32,1150,1151,1153,1156,1158],{"class":34,"line":302},[32,1152,279],{"class":51},[32,1154,1155],{"class":197}," a",[32,1157,62],{"class":51},[32,1159,1160],{"class":65}," Counter.instance\n",[32,1162,1163,1165,1168,1170,1172,1174],{"class":34,"line":509},[32,1164,279],{"class":51},[32,1166,1167],{"class":197}," b",[32,1169,62],{"class":51},[32,1171,354],{"class":51},[32,1173,1045],{"class":58},[32,1175,360],{"class":65},[32,1177,1178],{"class":34,"line":530},[32,1179,273],{"emptyLinePlaceholder":272},[32,1181,1182,1185,1187,1190,1193],{"class":34,"line":565},[32,1183,1184],{"class":65},"console.",[32,1186,617],{"class":58},[32,1188,1189],{"class":65},"(a.",[32,1191,1192],{"class":58},"increment",[32,1194,1195],{"class":65},"())\n",[32,1197,1198,1200,1202,1205,1207],{"class":34,"line":570},[32,1199,1184],{"class":65},[32,1201,617],{"class":58},[32,1203,1204],{"class":65},"(b.",[32,1206,1192],{"class":58},[32,1208,1195],{"class":65},[32,1210,1211,1213,1215,1218,1221],{"class":34,"line":575},[32,1212,1184],{"class":65},[32,1214,617],{"class":58},[32,1216,1217],{"class":65},"(a ",[32,1219,1220],{"class":51},"===",[32,1222,1223],{"class":65}," b)\n",[1225,1226,1227,1231,1269],"details",{},[1228,1229,1230],"summary",{},"Answer",[852,1232,1233,1234,73,1236,1238,1239,1242,1243,1246,1247,1250,1251,1254,1255,1258,1259,1261,1262,1264,1265,1268],{},"Logs ",[29,1235,655],{},[29,1237,655],{},", and ",[29,1240,1241],{},"false",". The singleton pattern via ",[29,1244,1245],{},"Counter.instance"," only guarantees a single instance ",[855,1248,1249],{},"if every caller goes through the getter"," — nothing stops code from calling ",[29,1252,1253],{},"new Counter()"," directly, which happily creates a second, independent instance with its own ",[29,1256,1257],{},"#count",". ",[29,1260,70],{}," and ",[29,1263,76],{}," are different objects, so each ",[29,1266,1267],{},"increment()"," starts from its own zero.",[852,1270,1271,1274],{},[855,1272,1273],{},"The lesson",": a \"singleton\" enforced only by convention isn't enforced at all — if true single-instance guarantees matter, the constructor itself must throw when called a second time, or be made inaccessible (e.g. via a module-private class not exported directly).",[14,1276,1278],{"id":1277},"key-takeaways","Key Takeaways",[1280,1281,1282,1286,1295,1298],"ul",{},[1283,1284,1285],"li",{},"ES modules are singletons by nature — one instance per import.",[1283,1287,1288,1289,1291,1292,1294],{},"Factory functions are more flexible than ",[29,1290,898],{}," — no ",[29,1293,198],{}," binding issues.",[1283,1296,1297],{},"EventEmitter pattern is everywhere — DOM, Node.js streams, custom events.",[1283,1299,1300],{},"Freeze config objects to prevent accidental mutation.",[1302,1303,1304],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B3