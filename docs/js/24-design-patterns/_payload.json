.log(data)\nbus.on('update', handler)\nbus.emit('update', { count: 1 })\nbus.off('update', handler)\n",[29,334,335,345,361,365,382,413,432,436,440,456,484,488,492,507,528,563,568,573,578,594,621,638,659],{"__ignoreMap":27},[32,336,337,340,343],{"class":34,"line":35},[32,338,339],{"class":51},"class",[32,341,342],{"class":58}," EventEmitter",[32,344,169],{"class":65},[32,346,347,350,352,355,358],{"class":34,"line":42},[32,348,349],{"class":69},"  #events",[32,351,62],{"class":51},[32,353,354],{"class":51}," new",[32,356,357],{"class":58}," Map",[32,359,360],{"class":65},"()\n",[32,362,363],{"class":34,"line":48},[32,364,273],{"emptyLinePlaceholder":272},[32,366,367,370,372,375,377,380],{"class":34,"line":94},[32,368,369],{"class":58},"  on",[32,371,150],{"class":65},[32,373,374],{"class":69},"event",[32,376,73],{"class":65},[32,378,379],{"class":69},"callback",[32,381,161],{"class":65},[32,383,384,387,389,392,394,397,400,403,405,407,410],{"class":34,"line":125},[32,385,386],{"class":51},"    if",[32,388,66],{"class":65},[32,390,391],{"class":51},"!",[32,393,198],{"class":197},[32,395,396],{"class":65},".#events.",[32,398,399],{"class":58},"has",[32,401,402],{"class":65},"(event)) ",[32,404,198],{"class":197},[32,406,396],{"class":65},[32,408,409],{"class":58},"set",[32,411,412],{"class":65},"(event, [])\n",[32,414,415,418,420,423,426,429],{"class":34,"line":212},[32,416,417],{"class":197},"    this",[32,419,396],{"class":65},[32,421,422],{"class":58},"get",[32,424,425],{"class":65},"(event).",[32,427,428],{"class":58},"push",[32,430,431],{"class":65},"(callback)\n",[32,433,434],{"class":34,"line":225},[32,435,260],{"class":65},[32,437,438],{"class":34,"line":251},[32,439,273],{"emptyLinePlaceholder":272},[32,441,442,445,447,449,451,454],{"class":34,"line":257},[32,443,444],{"class":58},"  emit",[32,446,150],{"class":65},[32,448,374],{"class":69},[32,450,73],{"class":65},[32,452,453],{"class":69},"data",[32,455,161],{"class":65},[32,457,458,460,462,464,467,470,472,475