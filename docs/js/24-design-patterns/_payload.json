\u002F\u002F config.js\n",[32,703,704,706,708,711,713,716,719],{"class":34,"line":48},[32,705,52],{"class":51},[32,707,55],{"class":51},[32,709,710],{"class":201}," config",[32,712,62],{"class":51},[32,714,715],{"class":65}," Object.",[32,717,718],{"class":58},"freeze",[32,720,721],{"class":65},"({\n",[32,723,724,727,730],{"class":34,"line":94},[32,725,726],{"class":65},"  apiUrl: ",[32,728,729],{"class":197},"'https:\u002F\u002Fapi.example.com'",[32,731,732],{"class":65},",\n",[32,734,735,738],{"class":34,"line":125},[32,736,737],{"class":65},"  timeout: ",[32,739,740],{"class":201},"5000\n",[32,742,743],{"class":34,"line":216},[32,744,745],{"class":65},"})\n",[32,747,748],{"class":34,"line":229},[32,749,277],{"emptyLinePlaceholder":276},[32,751,752],{"class":34,"line":255},[32,753,754],{"class":38},"\u002F\u002F Class-based singleton\n",[32,756,757,759,762],{"class":34,"line":261},[32,758,345],{"class":51},[32,760,761],{"class":58}," Database",[32,763,173],{"class":65},[32,765,766,769,772,774],{"class":34,"line":267},[32,767,768],{"class":51},"  static",[32,770,771],{"class":69}," #instance",[32,773,62],{"class":51},[32,775,776],{"class":201}," null\n",[32,778,779,781,784,787],{"class":34,"line":273},[32,780,768],{"class":51},[32,782,783],{"class":51}," get",[32,785,786],{"class":58}," instance",[32,788,789],{"class":65},"() {\n",[32,791,792,794,796,798,801,804,806,808],{"class":34,"line":280},[32,793,392],{"class":51},[32,795,66],{"class":65},[32,797,397],{"class":51},[32,799,800],{"class":65},"Database.#instance) Database.#instance ",[32,802,803],{"class":51},"=",[32,805,360],{"class":51},[32,807,761],{"class":58},[32,809,366],{"class":65},[32,811,812,815],{"class":34,"line":306},[32,813,814],{"class":51},"    return",[32,816,817],{"class":65}," Database.#instance\n",[32,819,820],{"class":34,"line":515},[32,821,264],{"class":65},[32,823,824,827,829],{"class":34,"line":536},[32,825,826],{"class":69},"  #connected",[32,828,62],{"class":51},[32,830,252],{"class":201},[32,832,833,836,838,840,843,845,848],{"class":34,"line":571},[32,834,835],{"class":58},"  connect",[32,837,191],{"class":65},[32,839,202],{"class":201},[32,841,842],{"class":65},".#connected ",[32,844,803],{"class":51},[32,846,847],{"class":201}," true",[32,849,850],{"class":65}," }\n",[32,852,853],{"class":34,"line":576},[32,854,270],{"class":65},[130,856,132],{},[14,858,860],{"id":859},"tips-tricks","💡 Tips & Tricks",[130,862,863,871,872,875,876,879,880,883,884,887,888,891],{},[864,865,866,867,870],"strong",{},"Private fields (",[29,868,869],{},"#field",") enforce true encapsulation"," — Unlike ",[29,873,874],{},"_field"," naming conventions, ",[29,877,878],{},"#events"," in the ",[29,881,882],{},"EventEmitter"," example is genuinely inaccessible from outside the class — ",[29,885,886],{},"instance.#events"," throws a ",[29,889,890],{},"SyntaxError"," outside the class body, not just a lint warning.",[130,893,894,900,901,904,905,908,909,911],{},[864,895,896,897,899],{},"Factory functions sidestep ",[29,898,202],{},"-binding bugs entirely"," — Since ",[29,902,903],{},"createUser"," returns a plain object with methods closing over local variables (or using object shorthand), you never have to worry about ",[29,906,907],{},"new"," being forgotten or a method losing its ",[29,910,202],{}," when passed as a callback.",[130,913,914,917,918,921,922,925],{},[864,915,916],{},"Module pattern for true private state without classes"," — Wrapping variables in a function scope and exporting only what's needed (as in ",[29,919,920],{},"math.js",") gives you privacy for free — no ",[29,923,924],{},"#"," syntax needed, and it predates ES6 classes entirely.",[130,927,928,931,932,935,936,939],{},[864,929,930],{},"Lazy singleton initialization saves startup cost"," — The ",[29,933,934],{},"static get instance()"," pattern only constructs ",[29,937,938],{},"Database"," on first access, not at module load — useful when the singleton is expensive to create but not always needed.",[130,941,942,945,946,949],{},[864,943,944],{},"Observer pattern decouples emitters from listeners for testing"," — Because ",[29,947,948],{},"EventEmitter.emit"," doesn't know or care who's listening, you can test emitted events in isolation by attaching a throwaway listener and asserting on what it received.",[14,951,953],{"id":952},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[130,955,956,959,960,963],{},[864,957,958],{},"Singletons complicate testing"," — A module-level singleton (like the class-based ",[29,961,962],{},"Database.instance",") persists state across test files unless explicitly reset, causing tests to pass or fail depending on run order — a classic \"works alone, fails in the suite\" bug.",[130,965,966,973,974,977,978,981,982,984,985,988],{},[864,967,968,969,972],{},"Forgetting to ",[29,970,971],{},"off()"," an EventEmitter listener leaks memory"," — Each ",[29,975,976],{},"bus.on('update', handler)"," call keeps a reference to ",[29,979,980],{},"handler"," alive inside ",[29,983,878],{}," forever unless ",[29,986,987],{},"bus.off('update', handler)"," is called — in long-lived apps (SPAs), this silently accumulates listeners and can cause the same event to fire the same stale callback multiple times.",[130,990,991,996,997,1000,1001,1003],{},[864,992,993,995],{},[29,994,971],{}," requires the exact same function reference, just like DOM events"," — ",[29,998,999],{},"bus.on('update', data => log(data)); bus.off('update', data => log(data))"," fails silently — the two arrow functions are different objects, so the filter in ",[29,1002,672],{}," never matches and the original listener keeps firing.",[130,1005,1006,1012,1013,1016],{},[864,1007,1008,1011],{},[29,1009,1010],{},"Object.freeze"," on a config object doesn't stop new property additions from being silently ignored"," — In non-strict mode, ",[29,1014,1015],{},"frozenConfig.newProp = 'x'"," doesn't throw, it just does nothing — leading developers to think the assignment worked when it was silently dropped.",[130,1018,1019,1022,1023,1026,1027,1029,1030,1033],{},[864,1020,1021],{},"Factory-created objects don't share methods across instances"," — Each call to ",[29,1024,1025],{},"createUser()"," defines a ",[864,1028,907],{}," ",[29,1031,1032],{},"greet"," function on the returned object, unlike class instances which share methods via the prototype. This means factories use more memory per instance if you create thousands of objects — a real trade-off, not just a style choice.",[14,1035,1037],{"id":1036},"spot-the-bug","🧠 Spot the Bug",[130,1039,1040],{},"What does this log?",[19,1042,1043],{"language":21},[23,1044,1046],{"className":25,"code":1045,"language":21,"meta":27,"style":27},"class Counter {\n  static #instance = null\n  #count = 0\n\n  static get instance() {\n    if (!Counter.#instance) Counter.#instance = new Counter()\n    return Counter.#instance\n  }\n\n  increment() { this.#count++; return this.#count }\n}\n\nconst a = Counter.instance\nconst b = new Counter()\n\nconsole.log(a.increment())\nconsole.log(b.increment())\nconsole.log(a === b)\n",[29,1047,1048,1057,1067,1077,1081,1091,1110,1117,1121,1125,1150,1154,1158,1170,1185,1189,1205,1218],{"__ignoreMap":27},[32,1049,1050,1052,1055],{"class":34,"line":35},[32,1051,345],{"class":51},[32,1053,1054],{"class":58}," Counter",[32,1056,173],{"class":65},[32,1058,1059,1061,1063,1065],{"class":34,"line":42},[32,1060,768],{"class":51},[32,1062,771],{"class":69},[32,1064,62],{"class":51},[32,1066,776],{"class":201},[32,1068,1069,1072,1074],{"class":34,"line":48},[32,1070,1071],{"class":69},"  #count",[32,1073,62],{"class":51},[32,1075,1076],{"class":201}," 0\n",[32,1078,1079],{"class":34,"line":94},[32,1080,277],{"emptyLinePlaceholder":276},[32,1082,1083,1085,1087,1089],{"class":34,"line":125},[32,1084,768],{"class":51},[32,1086,783],{"class":51},[32,1088,786],{"class":58},[32,1090,789],{"class":65},[32,1092,1093,1095,1097,1099,1102,1104,1106,1108],{"class":34,"line":216},[32,1094,392],{"class":51},[32,1096,66],{"class":65},[32,1098,397],{"class":51},[32,1100,1101],{"class":65},"Counter.#instance) Counter.#instance ",[32,1103,803],{"class":51},[32,1105,360],{"class":51},[32,1107,1054],{"class":58},[32,1109,366],{"class":65},[32,1111,1112,1114],{"class":34,"line":229},[32,1113,814],{"class":51},[32,1115,1116],{"class":65}," Counter.#instance\n",[32,1118,1119],{"class":34,"line":255},[32,1120,264],{"class":65},[32,1122,1123],{"class":34,"line":261},[32,1124,277],{"emptyLinePlaceholder":276},[32,1126,1127,1130,1132,1134,1137,1140,1143,1145,1147],{"class":34,"line":267},[32,1128,1129],{"class":58},"  increment",[32,1131,191],{"class":65},[32,1133,202],{"class":201},[32,1135,1136],{"class":65},".#count",[32,1138,1139],{"class":51},"++",[32,1141,1142],{"class":65},"; ",[32,1144,194],{"class":51},[32,1146,526],{"class":201},[32,1148,1149],{"class":65},".#count }\n",[32,1151,1152],{"class":34,"line":273},[32,1153,270],{"class":65},[32,1155,1156],{"class":34,"line":280},[32,1157,277],{"emptyLinePlaceholder":276},[32,1159,1160,1162,1165,1167],{"class":34,"line":306},[32,1161,283],{"class":51},[32,1163,1164],{"class":201}," a",[32,1166,62],{"class":51},[32,1168,1169],{"class":65}," Counter.instance\n",[32,1171,1172,1174,1177,1179,1181,1183],{"class":34,"line":515},[32,1173,283],{"class":51},[32,1175,1176],{"class":201}," b",[32,1178,62],{"class":51},[32,1180,360],{"class":51},[32,1182,1054],{"class":58},[32,1184,366],{"class":65},[32,1186,1187],{"class":34,"line":536},[32,1188,277],{"emptyLinePlaceholder":276},[32,1190,1191,1194,1196,1199,1202],{"class":34,"line":571},[32,1192,1193],{"class":65},"console.",[32,1195,623],{"class":58},[32,1197,1198],{"class":65},"(a.",[32,1200,1201],{"class":58},"increment",[32,1203,1204],{"class":65},"())\n",[32,1206,1207,1209,1211,1214,1216],{"class":34,"line":576},[32,1208,1193],{"class":65},[32,1210,623],{"class":58},[32,1212,1213],{"class":65},"(b.",[32,1215,1201],{"class":58},[32,1217,1204],{"class":65},[32,1219,1220,1222,1224,1227,1230],{"class":34,"line":581},[32,1221,1193],{"class":65},[32,1223,623],{"class":58},[32,1225,1226],{"class":65},"(a ",[32,1228,1229],{"class":51},"===",[32,1231,1232],{"class":65}," b)\n",[1234,1235,1236,1240,1278],"details",{},[1237,1238,1239],"summary",{},"Answer",[130,1241,1242,1243,73,1245,1247,1248,1251,1252,1255,1256,1259,1260,1263,1264,1267,1268,1270,1271,1273,1274,1277],{},"Logs ",[29,1244,661],{},[29,1246,661],{},", and ",[29,1249,1250],{},"false",". The singleton pattern via ",[29,1253,1254],{},"Counter.instance"," only guarantees a single instance ",[864,1257,1258],{},"if every caller goes through the getter"," — nothing stops code from calling ",[29,1261,1262],{},"new Counter()"," directly, which happily creates a second, independent instance with its own ",[29,1265,1266],{},"#count",". ",[29,1269,70],{}," and ",[29,1272,76],{}," are different objects, so each ",[29,1275,1276],{},"increment()"," starts from its own zero.",[130,1279,1280,1283],{},[864,1281,1282],{},"The lesson",": a \"singleton\" enforced only by convention isn't enforced at all — if true single-instance guarantees matter, the constructor itself must throw when called a second time, or be made inaccessible (e.g. via a module-private class not exported directly).",[14,1285,1287],{"id":1286},"key-takeaways","Key Takeaways",[1289,1290,1291,1295,1304,1307],"ul",{},[1292,1293,1294],"li",{},"ES modules are singletons by nature — one instance per import.",[1292,1296,1297,1298,1300,1301,1303],{},"Factory functions are more flexible than ",[29,1299,907],{}," — no ",[29,1302,202],{}," binding issues.",[1292,1305,1306],{},"EventEmitter pattern is everywhere — DOM, Node.js streams, custom events.",[1292,1308,1309],{},"Freeze config objects to prevent accidental mutation.",[1311,1312,1313],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}