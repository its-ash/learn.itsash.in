es.status}`)\n    const data = await res.json()\n    return { city: data.location.name, temp: data.current.temp_c }\n  } catch (err) {\n    console.error('Weather fetch failed:', err)\n    return null\n  }\n}\n",[34,473,474,492,499,534,573,592,600,611,627,634,638],{"__ignoreMap":32},[37,475,476,479,482,485,487,490],{"class":39,"line":40},[37,477,478],{"class":50},"async",[37,480,481],{"class":50}," function",[37,483,484],{"class":54}," getWeather",[37,486,88],{"class":58},[37,488,489],{"class":65},"city",[37,491,94],{"class":58},[37,493,494,497],{"class":39,"line":47},[37,495,496],{"class":50},"  try",[37,498,59],{"class":58},[37,500,501,504,507,509,512,515,517,520,523,526,528,531],{"class":39,"line":62},[37,502,503],{"class":50},"    const",[37,505,506],{"class":100}," res",[37,508,69],{"class":50},[37,510,511],{"class":50}," await",[37,513,514],{"class":54}," fetch",[37,516,88],{"class":58},[37,518,519],{"class":362},"`https:\u002F\u002Fapi.weatherapi.com\u002Fv1\u002Fcurrent.json?key=${",[37,521,522],{"class":100},"API_KEY",[37,524,525],{"class":362},"}&q=${",[37,527,489],{"class":58},[37,529,530],{"class":362},"}`",[37,532,533],{"class":58},")\n",[37,535,536,539,542,544,547,550,553,556,558,561,564,566,569,571],{"class":39,"line":75},[37,537,538],{"class":50},"    if",[37,540,541],{"class":58}," (",[37,543,230],{"class":50},[37,545,546],{"class":58},"res.ok) ",[37,548,549],{"class":50},"throw",[37,551,552],{"class":50}," new",[37,554,555],{"class":54}," Error",[37,557,88],{"class":58},[37,559,560],{"class":362},"`HTTP ${",[37,562,563],{"class":58},"res",[37,565,139],{"class":362},[37,567,568],{"class":58},"status",[37,570,530],{"class":362},[37,572,533],{"class":58},[37,574,575,577,580,582,584,587,590],{"class":39,"line":82},[37,576,503],{"class":50},[37,578,579],{"class":100}," data",[37,581,69],{"class":50},[37,583,511],{"class":50},[37,585,586],{"class":58}," res.",[37,588,589],{"class":54},"json",[37,591,145],{"class":58},[37,593,594,597],{"class":39,"line":9