it res.json()\n    return { city: data.location.name, temp: data.current.temp_c }\n  } catch (err) {\n    console.error('Weather fetch failed:', err)\n    return null\n  }\n}\n",[34,469,470,488,495,530,569,588,596,607,623,630,634],{"__ignoreMap":32},[37,471,472,475,478,481,483,486],{"class":39,"line":40},[37,473,474],{"class":50},"async",[37,476,477],{"class":50}," function",[37,479,480],{"class":54}," getWeather",[37,482,88],{"class":58},[37,484,485],{"class":65},"city",[37,487,94],{"class":58},[37,489,490,493],{"class":39,"line":47},[37,491,492],{"class":50},"  try",[37,494,59],{"class":58},[37,496,497,500,503,505,508,511,513,516,519,522,524,527],{"class":39,"line":62},[37,498,499],{"class":50},"    const",[37,501,502],{"class":100}," res",[37,504,69],{"class":50},[37,506,507],{"class":50}," await",[37,509,510],{"class":54}," fetch",[37,512,88],{"class":58},[37,514,515],{"class":362},"`https:\u002F\u002Fapi.weatherapi.com\u002Fv1\u002Fcurrent.json?key=${",[37,517,518],{"class":100},"API_KEY",[37,520,521],{"class":362},"}&q=${",[37,523,485],{"class":58},[37,525,526],{"class":362},"}`",[37,528,529],{"class":58},")\n",[37,531,532,535,538,540,543,546,549,552,554,557,560,562,565,567],{"class":39,"line":75},[37,533,534],{"class":50},"    if",[37,536,537],{"class":58}," (",[37,539,230],{"class":50},[37,541,542],{"class":58},"res.ok) ",[37,544,545],{"class":50},"throw",[37,547,548],{"class":50}," new",[37,550,551],{"class":54}," Error",[37,553,88],{"class":58},[37,555,556],{"class":362},"`HTTP ${",[37,558,559],{"class":58},"res",[37,561,139],{"class":362},[37,563,564],{"class":58},"status",[37,566,526],{"class":362},[37,568,529],{"class":58},[37,570,571,573,576,578,580,583,586],{"class":39,"line":82},[37,572,499],{"class":50},[37,574,575],{"class":100}," data",[37,577,69],{"class":50},[37,579,507],{"class":50},[37,581,582],{"class":58}," res.",[37,584,585],{"class":54},"json",[37,587,145],{"class":58},[37,589,590,593],{"class":39,"line":97},[37,591,592],{"class":50},"    return",[37,594,595],{"class":58}," { city: data.location.name, temp: data.current.temp_c }\n",[37,597,598,601,604],{"class":39,"line":134},[37,599,600],{"class":58},"  } ",[37,602,603],{"class":50},"catch",[37,605,606],{"class":58}," (err) {\n",[37,608,609,612,615,617,620],{"class":39,"line":148},[37,610,611],{"class":58},"    console.",[37,613,614],{"class":54},"error",[37,616,88],{"class":58},[37,618,619],{"class":362},"'Weather fetch failed:'",[37,621,622],{"class":58},", err)\n",[37,624,625,627],{"class":39,"line":160},[37,626,592],{"class":50},[37,628,629],{"class":100}," null\n",[37,631,632],{"class":39,"line":166},[37,633,163],{"class":58},[37,635,636],{"class":39,"line":171},[37,637,446],{"class":58},[19,639,641],{"id":640},"_5-markdown-parser-string-manipulation-regex","5. Markdown Parser (string manipulation, regex)",[19,643,645],{"id":644},"_6-real-time-chat-websocket-events-closures","6. Real-time Chat (WebSocket, events, closures)",[14,647,649],{"id":648},"advanced","Advanced",[19,651,653],{"id":652},"_7-promise-library-implement-promise-from-scratch","7. Promise Library (implement Promise from scratch)",[19,655,657],{"id":656},"_8-mini-framework-virtual-dom-diffing-reactivity","8. Mini Framework (virtual DOM, diffing, reactivity)",[19,659,661],{"id":660},"_9-function-library-lodash-style-debounce-throttle-curry-memoize","9. Function Library (lodash-style: debounce, throttle, curry, memoize)",[19,663,665],{"id":664},"_10-type-checker-mini-typescript-parse-and-validate-types-at-runtime","10. Type Checker (mini TypeScript — parse and validate types at runtime)",[14,667,669],{"id":668},"tips-tricks","💡 Tips & Tricks",[671,672,673,677],"p",{},[674,675,676],"strong",{},"Build vertically, not horizontally"," — Get one feature fully working end-to-end (e.g. adding a todo, saving it, rendering it) before starting the next, rather than building all the UI first and wiring up logic later — you'll catch integration bugs immediately instead of at the end.",[671,679,680,683],{},[674,681,682],{},"Constrain yourself before reaching for a framework"," — Building the Todo app or Mini Framework in plain JavaScript first (no React\u002FVue) forces you to understand what the framework is actually doing under the hood — DOM diffing, event delegation, state-to-render syncing.",[671,685,686,689,690,366,693,366,696,699,700,703,704,706,707,710],{},[674,687,688],{},"Write the test cases before the implementation for the Function Library project"," — Since ",[34,691,692],{},"debounce",[34,694,695],{},"throttle",[34,697,698],{},"curry",", and ",[34,701,702],{},"memoize"," all have well-known edge cases (rapid calls, zero-arg functions, ",[34,705,116],{}," binding), writing ",[34,708,709],{},"it('debounces rapid calls', ...)"," first clarifies exactly what \"correct\" means before you write a line of implementation.",[671,712,713,716,717,720],{},[674,714,715],{},"Commit after every working milestone, not just at the end"," — Small, frequent commits (",[34,718,719],{},"git commit -m \"todo: add localStorage persistence\"",") let you bisect back to a working state if a later refactor breaks something, especially useful in the Advanced projects where a single bug (e.g. in the Promise Library) can be hard to isolate later.",[671,722,723,726,727,730],{},[674,724,725],{},"Read one production library's source before building your own version"," — Before attempting the Function Library or Mini Framework, skim the actual source of ",[34,728,729],{},"lodash.debounce"," or a small virtual-DOM implementation — you'll reuse fewer wrong assumptions and recognize the real edge cases (leading vs trailing calls, key-based reconciliation) instead of discovering them the hard way.",[14,732,734],{"id":733},"key-takeaways","Key Takeaways",[736,737,738,742,745,748],"ul",{},[739,740,741],"li",{},"Start small — Todo app covers DOM, events, storage, and state management.",[739,743,744],{},"Weather app teaches async\u002Fawait, fetch, and error handling.",[739,746,747],{},"Build a promise library to deeply understand async JavaScript.",[739,749,750],{},"Ship projects — deploy to GitHub Pages, Vercel, or Netlify.",[752,753,754],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}",{"title":32,"searchDepth":47,"depth":47,"links":756},[757,762,767,773,774],{"id":16,"depth":47,"text":17,"children":758