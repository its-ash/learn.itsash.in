,676],"strong",{},[18,674,675],{},"setTimeout(fn, 0)"," still waits for the current call stack to clear"," — It doesn't run \"immediately\" — it queues a macrotask that runs only after the current synchronous code and all pending microtasks (promises) finish. Use it to defer work until after the browser has a chance to paint or respond to input.",[262,679,680,686,687,689,690,692,693,695],{},[671,681,682,683],{},"Debug scheduled work with ",[18,684,685],{},"console.trace()"," — Dropping ",[18,688,685],{}," inside a ",[18,691,20],{},"\u002F",[18,694,24],{}," callback shows exactly which code path scheduled it — useful when a timer fires unexpectedly and you can't tell who set it up.",[262,697,698,704,705,407,707,710],{},[671,699,700,703],{},[18,701,702],{},"requestIdleCallback"," for genuinely low-priority work"," — Unlike ",[18,706,20],{},[18,708,709],{},"requestIdleCallback(fn)"," only runs when the browser is idle, making it ideal for analytics pings or prefetching that shouldn't compete with rendering.",[262,712,713,716,717,720,721,724],{},[671,714,715],{},"Named debounce\u002Fthrottle wrappers keep call sites readable"," — Store the debounced function once (",[18,718,719],{},"const debouncedSearch = debounce(searchAPI, 300)",") rather than creating a new one per render — otherwise you lose the shared ",[18,722,723],{},"timer"," closure and debouncing stops working entirely.",[262,726,727,730,731,734,735,738,739,692,741,743],{},[671,728,729],{},"Clear timers in cleanup functions, not just on success paths"," — In frameworks (React ",[18,732,733],{},"useEffect",", Vue ",[18,736,737],{},"onUnmounted","), always return\u002Fregister a cleanup that calls ",[18,740,98],{},[18,742,156],{}," — timers set in a component that unmounts before firing otherwise leak and can update state on a dead component.",[14,745,747],{"id":746},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[262,749,750,755,756,758],{},[671,751,752,754],{},[18,753,24],{}," doesn't wait for slow callbacks to finish"," — If the callback takes longer than the interval, calls can queue up and fire back-to-back the moment the main thread frees up, effectively removing the \"interval\" — recursive ",[18,757,20],{}," avoids this by scheduling the next call only after the current one completes.",[262,760,761,764,765,768],{},[671,762,763],{},"Minimum delay is clamped, especially when nested"," — Browsers clamp nested timeouts (a timeout set inside another timeout, 5+ levels deep) to a minimum of 4ms even if you request ",[18,766,767],{},"0",", and background\u002Finactive tabs can throttle timers to once per second or slower to save battery.",[262,770,771,780,781,784,785,788,789,791,792,794],{},[671,772,773,776,777,779],{},[18,774,775],{},"this"," inside a regular ",[18,778,196],{}," timer callback is not what you expect"," — ",[18,782,783],{},"setTimeout(function() { console.log(this) }, 100)"," logs the global object (or ",[18,786,787],{},"undefined"," in strict mode), not the object that scheduled it — because ",[18,790,20],{}," invokes the callback as a plain function call, not a method call. Arrow functions avoid this by inheriting ",[18,793,775],{}," lexically.",[262,796,797,804,805,808],{},[671,798,799,692,801,803],{},[18,800,98],{},[18,802,156],{}," on an already-fired or invalid ID is a silent no-op"," — There's no error, no warning — calling ",[18,806,807],{},"clearInterval(999999)"," on a nonexistent ID simply does nothing, which can mask bugs where you cleared the wrong variable.",[262,810,811,704,816,818,819,821],{},[671,812,813,815],{},[18,814,270],{}," pauses entirely in background tabs",[18,817,24],{},", which keeps ticking (throttled) in a hidden tab, ",[18,820,270],{}," callbacks stop firing completely until the tab regains focus — an animation loop built purely on rAF silently \"freezes\" and resumes later, which is usually desired but surprises anyone expecting continuous ticking.",[14,823,825],{"id":824},"spot-the-bug","🧠 Spot the Bug",[262,827,828],{},"What's the observed behavior, and why?",[26,830,831],{"language":28},[30,832,834],{"className":32,"code":833,"language":28,"meta":34,"style":34},"function poll() {\n  console.log('fetching...')\n  setInterval(() => {\n    slowNetworkCall()\n  }, 1000)\n}\npoll()\n\nfunction slowNetworkCall() {\n  const start = Date.now()\n  while (Date.now() - start \u003C 3000) {}\n  console.log('done at', Date.now())\n}\n",[18,835,836,845,859,870,877,885,889,896,900,909,927,954,973],{"__ignoreMap":34},[38,837,838,840,843],{"class":40,"line":41},[38,839,196],{"class":51},[38,841,842],{"class":62}," poll",[38,844,202],{"class":66},[38,846,847,850,852,854,857],{"class":40,"line":48},[38,848,849],{"class":66},"  console.",[38,851,76],{"class":62},[38,853,79],{"class":66},[38,855,856],{"class":82},"'fetching...'",[38,858,92],{"class":66},[38,860,861,864,866,868],{"class":40,"line":95},[38,862,863],{"class":62},"  setInterval",[38,865,67],{"class":66},[38,867,70],{"class":51},[38,869,215],{"class":66},[38,871,872,875],{"class":40,"line":107},[38,873,874],{"class":62},"    slowNetworkCall",[38,876,224],{"class":66},[38,878,879,881,883],{"class":40,"line":114},[38,880,242],{"class":66},[38,882,89],{"class":55},[38,884,92],{"class":66},[38,886,887],{"class":40,"line":120},[38,888,252],{"class":66},[38,890,891,894],{"class":40,"line":153},[38,892,893],{"class":62},"poll",[38,895,224],{"class":66},[38,897,898],{"class":40,"line":165},[38,899,111],{"emptyLinePlaceholder":110},[38,901,902,904,907],{"class":40,"line":170},[38,903,196],{"class":51},[38,905,906],{"class":62}," slowNetworkCall",[38,908,202],{"class":66},[38,910,911,914,917,919,922,925],{"class":40,"line":176},[38,912,913],{"class":51},"  const",[38,915,916],{"class":55}," start",[38,918,59],{"class":51},[38,920,921],{"class":66}," Date.",[38,923,924],{"class":62},"now",[38,926,224],{"class":66},[38,928,929,932,935,937,940,943,946,948,951],{"class":40,"line":182},[38,930,931],{"class":51},"  while",[38,933,934],{"class":66}," (Date.",[38,936,924],{"class":62},[38,938,939],{"class":66},"() ",[38,941,942],{"class":51},"-",[38,944,945],{"class":66}," start ",[38,947,322],{"class":51},[38,949,950],{"class":55}," 3000",[38,952,953],{"class":66},") {}\n",[38,955,956,958,960,962,965,968,970],{"class":40,"line":187},[38,957,849],{"class":66},[38,959,76],{"class":62},[38,961,79],{"class":66},[38,963,964],{"class":82},"'done at'",[38,966,967],{"class":66},", Date.",[38,969,924],{"class":62},[38,971,972],{"class":66},"())\n",[38,974,975],{"class":40,"line":193},[38,976,252],{"class":66},[978,979,980,984,994],"details",{},[981,982,983],"summary",{},"Answer",[262,985,986,987,990,991,993],{},"Even though the interval is set to 1000ms, ",[18,988,989],{},"slowNetworkCall"," blocks the single JS thread for 3000ms every time it runs. ",[18,992,24],{}," keeps trying to fire every second, but since JavaScript is single-threaded, those extra ticks can't run concurrently — they queue up and fire back-to-back as soon as the thread is free, producing a burst of calls instead of one call per second. The interval never actually achieves a steady 1-second cadence.",[262,995,996,999,1000,1002],{},[671,997,998],{},"The lesson",": use recursive ",[18,1001,20],{}," (schedule the next call only after the current one finishes) whenever the callback's duration might approach or exceed the interval — it self-corrects instead of piling up queued calls.",[14,1004,1006],{"id":1005},"key-takeaways","Key Takeaways",[1008,1009,1010,1019,1024],"ul",{},[1011,1012,1013,1015,1016,1018],"li",{},[18,1014,24],{}," drifts — use recursive ",[18,1017,20],{}," for precise timing.",[1011,1020,1021,1023],{},[18,1022,270],{}," for visual animations — synced with repaint, pauses on hidden tabs.",[1011,1025,1026],{},"Debounce: wait until activity stops (search, resize). Throttle: limit rate (scroll, mousemove).",[1028,1029,1030],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html