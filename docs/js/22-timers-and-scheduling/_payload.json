,{"class":51},[38,530,215],{"class":66},[38,532,533,536,539],{"class":40,"line":205},[38,534,535],{"class":51},"    if",[38,537,538],{"class":66}," (inThrottle) ",[38,540,541],{"class":51},"return\n",[38,543,544,547,549,551],{"class":40,"line":218},[38,545,546],{"class":62},"    fn",[38,548,79],{"class":66},[38,550,426],{"class":51},[38,552,553],{"class":66},"args)\n",[38,555,556,559,561],{"class":40,"line":227},[38,557,558],{"class":66},"    inThrottle ",[38,560,295],{"class":51},[38,562,563],{"class":55}," true\n",[38,565,566,569,571,573,575,577,580],{"class":40,"line":239},[38,567,568],{"class":62},"    setTimeout",[38,570,67],{"class":66},[38,572,70],{"class":51},[38,574,509],{"class":66},[38,576,295],{"class":51},[38,578,579],{"class":55}," false",[38,581,582],{"class":66},", limit)\n",[38,584,585],{"class":40,"line":249},[38,586,471],{"class":66},[38,588,589],{"class":40,"line":255},[38,590,252],{"class":66},[38,592,594],{"class":40,"line":593},20,[38,595,111],{"emptyLinePlaceholder":110},[38,597,599],{"class":40,"line":598},21,[38,600,601],{"class":44},"\u002F\u002F Usage\n",[38,603,605,608,611,613,616,618,621,624,627],{"class":40,"line":604},22,[38,606,607],{"class":66},"input.",[38,609,610],{"class":62},"addEventListener",[38,612,79],{"class":66},[38,614,615],{"class":82},"'input'",[38,617,401],{"class":66},[38,619,620],{"class":62},"debounce",[38,622,623],{"class":66},"(searchAPI, ",[38,625,626],{"class":55},"300",[38,628,629],{"class":66},"))\n",[38,631,633,636,638,640,643,645,648,651,654],{"class":40,"line":632},23,[38,634,635],{"class":66},"window.",[38,637,610],{"class":62},[38,639,79],{"class":66},[38,641,642],{"class":82},"'scroll'",[38,644,401],{"class":66},[38,646,647],{"class":62},"throttle",[38,649,650],{"class":66},"(updateUI, ",[38,652,653],{"class":55},"100",[38,655,629],{"class":66},[14,657,659],{"id":658},"tips-tricks","💡 Tips & Tricks",[661,662,663,670],"p",{},[664,665,666,669],"strong",{},[18,667,668],{},"setTimeout(fn, 0)"," still waits for the current call stack to clear"," — It doesn't run \"immediately\" — it queues a macrotask that runs only after the current synchronous code and all pending microtasks (promises) finish. Use it to defer work until after the browser has a chance to paint or respond to input.",[661,672,673,679,680,682,683,685,686,688],{},[664,674,675,676],{},"Debug scheduled work with ",[18,677,678],{},"console.trace()"," — Dropping ",[18,681,678],{}," inside a ",[18,684,20],{},"\u002F",[18,687,24],{}," callback shows exactly which code path scheduled it — useful when a timer fires unexpectedly and you can't tell who set it up.",[661,690,691,697,698,401,700,703],{},[664,692,693,696],{},[18,694,695],{},"requestIdleCallback"," for genuinely low-priority work"," — Unlike ",[18,699,20],{},[18,701,702],{},"requestIdleCallback(fn)"," only runs when the browser is idle, making it ideal for analytics pings or prefetching that shouldn't compete with rendering.",[661,705,706,709,710,713,714,717],{},[664,707,708],{},"Named debounce\u002Fthrottle wrappers keep call sites readable"," — Store the debounced function once (",[18,711,712],{},"const debouncedSearch = debounce(searchAPI, 300)",") rather than creating a new one per render — otherwise you lose the shared ",[18,715,716],{},"timer"," closure and debouncing stops working entirely.",[661,719,720,723,724,727,728,731,732,685,734,736],{},[664,721,722],{},"Clear timers in cleanup functions, not just on success paths"," — In frameworks (React ",[18,725,726],{},"useEffect",", Vue ",[18,729,730],{},"onUnmounted","), always return\u002Fregister a cleanup that calls ",[18,733,98],{},[18,735,156],{}," — timers set in a component that unmounts before firing otherwise leak and can update state on a dead component.",[14,738,740],{"id":739},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[661,742,743,748,749,751],{},[664,744,745,747],{},[18,746,24],{}," doesn't wait for slow callbacks to finish"," — If the callback takes longer than the interval, calls can queue up and fire back-to-back the moment the main thread frees up, effectively removing the \"interval\" — recursive ",[18,750,20],{}," avoids this by scheduling the next call only after the current one completes.",[661,753,754,757,758,761],{},[664,755,756],{},"Minimum delay is clamped, especially when nested"," — Browsers clamp nested timeouts (a timeout set inside another timeout, 5+ levels deep) to a minimum of 4ms even if you request ",[18,759,760],{},"0",", and background\u002Finactive tabs can throttle timers to once per second or slower to save battery.",[661,763,764,773,774,777,778,781,782,784,785,787],{},[664,765,766,769,770,772],{},[18,767,768],{},"this"," inside a regular ",[18,771,196],{}," timer callback is not what you expect"," — ",[18,775,776],{},"setTimeout(function() { console.log(this) }, 100)"," logs the global object (or ",[18,779,780],{},"undefined"," in strict mode), not the object that scheduled it — because ",[18,783,20],{}," invokes the callback as a plain function call, not a method call. Arrow functions avoid this by inheriting ",[18,786,768],{}," lexically.",[661,789,790,797,798,801],{},[664,791,792,685,794,796],{},[18,793,98],{},[18,795,156],{}," on an already-fired or invalid ID is a silent no-op"," — There's no error, no warning — calling ",[18,799,800],{},"clearInterval(999999)"," on a nonexistent ID simply does nothing, which can mask bugs where you cleared the wrong variable.",[661,803,804,697,809,811,812,814],{},[664,805,806,808],{},[18,807,266],{}," pauses entirely in background tabs",[18,810,24],{},", which keeps ticking (throttled) in a hidden tab, ",[18,813,266],{}," callbacks stop firing completely until the tab regains focus — an animation loop built purely on rAF silently \"freezes\" and resumes later, which is usually desired but surprises anyone expecting continuous ticking.",[14,816,818],{"id":817},"spot-the-bug","🧠 Spot the Bug",[661,820,821],{},"What's the observed behavior, and why?",[26,823,824],{"language":28},[30,825,827],{"className":32,"code":826,"language":28,"meta":34,"style":34},"function poll() {\n  console.log('fetching...')\n  setInterval(() => {\n    slowNetworkCall()\n  }, 1000)\n}\npoll()\n\nfunction slowNetworkCall() {\n  const start = Date.now()\n  while (Date.now() - start \u003C 3000) {}\n  console.log('done at', Date.now())\n}\n",[18,828,829,838,852,863,870,878,882,889,893,902,920,947,966],{"__ignoreMap":34},[38,830,831,833,836],{"class":40,"line":41},[38,832,196],{"class":51},[38,834,835],{"class":62}," poll",[38,837,202],{"class":66},[38,839,840,843,845,847,850],{"class":40,"line":48},[38,841,842],{"class":66},"  console.",[38,844,76],{"class":62},[38,846,79],{"class":66},[38,848,849],{"class":82},"'fetching...'",[38,851,92],{"class":66},[38,853,854,857,859,861],{"class":40,"line":95},[38,855,856],{"class":62},"  setInterval",[38,858,67],{"class":66},[38,860,70],{"class":51},[38,862,215],{"class":66},[38,864,865,868],{"class":40,"line":107},[38,866,867],{"class":62},"    slowNetworkCall",[38,869,224],{"class":66},[38,871,872,874,876],{"class":40,"line":114},[38,873,242],{"class":66},[38,875,89],{"class":55},[38,877,92],{"class":66},[38,879,880],{"class":40,"line":120},[38,881,252],{"class":66},[38,883,884,887],{"class":40,"line":153},[38,885,886],{"class":62},"poll",[38,888,224],{"class":66},[38,890,891],{"class":40,"line":165},[38,892,111],{"emptyLinePlaceholder":110},[38,894,895,897,900],{"class":40,"line":170},[38,896,196],{"class":51},[38,898,899],{"class":62}," slowNetworkCall",[38,901,202],{"class":66},[38,903,904,907,910,912,915,918],{"class":40,"line":176},[38,905,906],{"class":51},"  const",[38,908,909],{"class":55}," start",[38,911,59],{"class":51},[38,913,914],{"class":66}," Date.",[38,916,917],{"class":62},"now",[38,919,224],{"class":66},[38,921,922,925,928,930,933,936,939,941,944],{"class":40,"line":182},[38,923,924],{"class":51},"  while",[38,926,927],{"class":66}," (Date.",[38,929,917],{"class":62},[38,931,932],{"class":66},"() ",[38,934,935],{"class":51},"-",[38,937,938],{"class":66}," start ",[38,940,318],{"class":51},[38,942,943],{"class":55}," 3000",[38,945,946],{"class":66},") {}\n",[38,948,949,951,953,955,958,961,963],{"class":40,"line":187},[38,950,842],{"class":66},[38,952,76],{"class":62},[38,954,79],{"class":66},[38,956,957],{"class":82},"'done at'",[38,959,960],{"class":66},", Date.",[38,962,917],{"class":62},[38,964,965],{"class":66},"())\n",[38,967,968],{"class":40,"line":193},[38,969,252],{"class":66},[971,972,973,977,987],"details",{},[974,975,976],"summary",{},"Answer",[661,978,979,980,983,984,986],{},"Even though the interval is set to 1000ms, ",[18,981,982],{},"slowNetworkCall"," blocks the single JS thread for 3000ms every time it runs. ",[18,985,24],{}," keeps trying to fire every second, but since JavaScript is single-threaded, those extra ticks can't run concurrently — they queue up and fire back-to-back as soon as the thread is free, producing a burst of calls instead of one call per second. The interval never actually achieves a steady 1-second cadence.",[661,988,989,992,993,995],{},[664,990,991],{},"The lesson",": use recursive ",[18,994,20],{}," (schedule the next call only after the current one finishes) whenever the callback's duration might approach or exceed the interval — it self-corrects instead of piling up queued calls.",[14,997,999],{"id":998},"key-takeaways","Key Takeaways",[1001,1002,1003,1012,1017],"ul",{},[1004,1005,1006,1008,1009,1011],"li",{},[18,1007,24],{}," drifts — use recursive ",[18,1010,20],{}," for precise timing.",[1004,1013,1014,1016],{},[18,1015,266],{}," for visual animations — synced with repaint, pauses on hidden tabs.",[1004,1018,1019],{},"Debounce: wait until activity stops (search, resize). Throttle: limit rate (scroll, mousemove).",[1021,1022,1023],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--sh