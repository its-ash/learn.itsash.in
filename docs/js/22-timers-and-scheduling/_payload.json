],{"class":40,"line":107},[38,315,316],{"class":51},"  if",[38,318,319],{"class":66}," (pos ",[38,321,322],{"class":51},"\u003C",[38,324,325],{"class":55}," 500",[38,327,328],{"class":66},") ",[38,330,270],{"class":62},[38,332,333],{"class":66},"(animate)\n",[38,335,336],{"class":40,"line":114},[38,337,252],{"class":66},[38,339,340,342],{"class":40,"line":120},[38,341,270],{"class":62},[38,343,333],{"class":66},[38,345,346],{"class":40,"line":153},[38,347,111],{"emptyLinePlaceholder":110},[38,349,350],{"class":40,"line":165},[38,351,352],{"class":44},"\u002F\u002F Cancel\n",[38,354,355,357,359,361,364],{"class":40,"line":170},[38,356,52],{"class":51},[38,358,56],{"class":55},[38,360,59],{"class":51},[38,362,363],{"class":62}," requestAnimationFrame",[38,365,333],{"class":66},[38,367,368,371],{"class":40,"line":176},[38,369,370],{"class":62},"cancelAnimationFrame",[38,372,373],{"class":66},"(id)\n",[262,375,264],{},[14,377,379],{"id":378},"debounce-throttle","Debounce & Throttle",[26,381,382],{"language":28},[30,383,385],{"className":32,"code":384,"language":28,"meta":34,"style":34},"\u002F\u002F Debounce — delay until activity stops\nfunction debounce(fn, delay) {\n  let timer\n  return (...args) => {\n    clearTimeout(timer)\n    timer = setTimeout(() => fn(...args), delay)\n  }\n}\n\n\u002F\u002F Throttle — limit to once per interval\nfunction throttle(fn, limit) {\n  let inThrottle = false\n  return (...args) => {\n    if (inThrottle) return\n    fn(...args)\n    inThrottle = true\n    setTimeout(() => inThrottle = false, limit)\n  }\n}\n\n\u002F\u002F Usage\ninput.addEventListener('input', debounce(searchAPI, 300))\nwindow.addEventListener('scroll', throttle(updateUI, 100))\n",[18,386,387,392,414,422,442,450,473,478,482,486,491,509,521,537,548,560,570,589,593,597,602,608,636],{"__ignoreMap":34},[38,388,389],{"class":40,"line":41},[38,390,391],{"class":44},"\u002F\u002F Debounce — delay until activity stops\n",[38,393,394,396,399,401,405,408,411],{"class":40,"lin