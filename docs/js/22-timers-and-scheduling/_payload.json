[{"data":1,"prerenderedAt":1047},["ShallowReactive",2],{"page-\u002Fjs\u002F22-timers-and-scheduling":3},{"id":4,"title":5,"body":6,"description":34,"extension":1041,"meta":1042,"navigation":110,"path":1043,"seo":1044,"stem":1045,"__hash__":1046},"content\u002Fjs\u002F22-timers-and-scheduling.md","22 — Timers & Scheduling",{"type":7,"value":8,"toc":1031},"minimark",[9,13,25,261,265,271,374,376,380,662,664,668,678,696,711,725,744,748,759,769,795,809,822,826,829,977,1003,1007,1027],[10,11,5],"h1",{"id":12},"_22-timers-scheduling",[14,15,17,21,22],"h2",{"id":16},"settimeout-setinterval",[18,19,20],"code",{},"setTimeout"," \u002F ",[18,23,24],{},"setInterval",[26,27,29],"code-wrapper",{"language":28},"javascript",[30,31,35],"pre",{"className":32,"code":33,"language":28,"meta":34,"style":34},"language-javascript shiki shiki-themes github-light github-dark","\u002F\u002F setTimeout — run once after delay\nconst id = setTimeout(() => console.log('After 1s'), 1000)\nclearTimeout(id)  \u002F\u002F cancel\n\n\u002F\u002F setInterval — repeat every interval\nconst intervalId = setInterval(() => console.log('Tick'), 2000)\nclearInterval(intervalId)  \u002F\u002F stop\n\n\u002F\u002F ⚠️ setInterval drift — actual interval may be longer\n\u002F\u002F ⚠️ setInterval doesn't wait for previous call to finish\n\n\u002F\u002F ✅ Recursive setTimeout — self-correcting\nfunction scheduleNext() {\n  setTimeout(() => {\n    doWork()\n    scheduleNext()  \u002F\u002F schedule after work completes\n  }, 1000)\n}\nscheduleNext()\n","",[18,36,37,46,93,105,112,118,151,163,168,174,180,185,191,203,216,225,237,247,253],{"__ignoreMap":34},[38,39,42],"span",{"class":40,"line":41},"line",1,[38,43,45],{"class":44},"sdCPZ","\u002F\u002F setTimeout — run once after delay\n",[38,47,49,53,57,60,64,68,71,74,77,80,84,87,90],{"class":40,"line":48},2,[38,50,52],{"class":51},"svdQ7","const",[38,54,56],{"class":55},"snvgF"," id",[38,58,59],{"class":51}," =",[38,61,63],{"class":62},"sIsaT"," setTimeout",[38,65,6