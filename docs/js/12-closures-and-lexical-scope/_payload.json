73],{"class":55},[41,1521,1413],{"class":229},[41,1523,481],{"class":55},[41,1525,1526],{"class":43,"line":521},[41,1527,79],{"emptyLinePlaceholder":78},[41,1529,1530,1532,1534],{"class":43,"line":526},[41,1531,85],{"class":47},[41,1533,88],{"class":47},[41,1535,91],{"class":55},[41,1537,1538,1540,1542,1544,1547],{"class":43,"line":531},[41,1539,275],{"class":47},[41,1541,886],{"class":71},[41,1543,138],{"class":47},[41,1545,1546],{"class":55}," hugeData.",[41,1548,1549],{"class":71},"length\n",[41,1551,1552,1555,1557,1560],{"class":43,"line":536},[41,1553,1554],{"class":55},"    hugeData ",[41,1556,68],{"class":47},[41,1558,1559],{"class":71}," null",[41,1561,1562],{"class":155},"  \u002F\u002F release reference\n",[41,1564,1565,1567],{"class":43,"line":555},[41,1566,106],{"class":47},[41,1568,920],{"class":55},[41,1570,1571],{"class":43,"line":575},[41,1572,115],{"class":55},[41,1574,1575],{"class":43,"line":594},[41,1576,121],{"class":55},[19,1578,199],{},[14,1580,1582],{"id":1581},"tips-tricks","💡 Tips & Tricks",[19,1584,1585,1588,1589,1592,1593,1596],{},[23,1586,1587],{},"Closures for private fields"," — Before ES2022 ",[38,1590,1591],{},"#"," fields, closures were the way: ",[38,1594,1595],{},"function User() { let private = {}; this.getPrimary = () => private }",". Still valid for methods-only access.",[19,1598,1599,1602,1603,1606,1607,1610,1611,1614],{},[23,1600,1601],{},"Currying for partial application"," — ",[38,1604,1605],{},"const add = a => b => a + b"," lets you do ",[38,1608,1609],{},"add(5)(3)"," or ",[38,1612,1613],{},"const add5 = add(5); add5(3)",". Useful for functional pipelines.",[19,1616,1617,1620],{},[23,1618,1619],{},"Memoization for expensive functions"," — Cache results of pure functions. But watch your cache size; memoize only functions you'll call frequently with the same args.",[19,1622,1623,1602,1626,1629],{},[23,1624,1625],{},"Immediately Invoked Generators",[38,1627,1628],{},"(function* gen() { ... })()"," creates a IIFE that yields. Rare but powerful for lazy evaluation.",[14,1631,1633],{"id":1632},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[19,1635,1636,1602,1639,1642,1643,1646,1647,1650,1651,1653,1654,843],{},[23,1637,1638],{},"The loop variable closure trap",[38,1640,1641],{},"for (var i = 0; i \u003C 3; i++) { setTimeout(() => console.log(i), 0) }"," logs ",[38,1644,1645],{},"3, 3, 3",". ALL closures share the SAME ",[38,1648,1649],{},"i",". Use ",[38,1652,1228],{}," to fix: each iteration gets a new ",[38,1655,1649],{},[19,1657,1658,1661],{},[23,1659,1660],{},"Closures capture by reference, not value"," — A closure captures the variable, not its value at capture time. Modify the variable later, and the closure sees the new value. This confuses newcomers.",[19,1663,1664,1667,1668,1671,1672,1675],{},[23,1665,1666],{},"Memory leaks from closures"," — Large objects captured by closures never get garbage collected as long as the closure exists. ",[38,1669,1670],{},"const fn = (() => { const huge = new Array(1e9); return () => {} })()"," keeps ",[38,1673,1674],{},"huge"," in memory forever. Be careful.",[19,1677,1678,1602,1681,1684,1685,1688],{},[23,1679,1680],{},"Circular closures can leak",[38,1682,1683],{},"element.onclick = () => { doSomething(element); }"," — the closure captures ",[38,1686,1687],{},"element",", which has a reference to the closure. Breaks reference cycles by nulling the handler when done.",[19,1690,1691,1694,1695,1698,1699,1702,1703,1706],{},[23,1692,1693],{},"Closure scope chain is read-only from closure perspective"," — You CAN mutate objects in outer scope, but you CAN'T rebind outer variables from inside. ",[38,1696,1697],{},"let x; (() => { x = 5 })()"," mutates the binding (works). But ",[38,1700,1701],{},"let y; (() => { let y = 5 })()"," creates a new ",[38,1704,1705],{},"y"," inside.",[14,1708,1710],{"id":1709},"spot-the-bug","🧠 Spot the Bug",[19,1712,1713],{},"What does this log?",[28,1715,1716],{"language":30},[32,1717,1719],{"className":34,"code":1718,"language":30,"meta":36,"style":36},"const fns = []\nfor (var i = 0; i \u003C 3; i++) {\n  fns.push(() => i)\n}\n\nconsole.log(fns[0](), fns[1](), fns[2]())\n",[38,1720,1721,1733,1759,1774,1778,1782],{"__ignoreMap":36},[41,1722,1723,1725,1728,1730],{"class":43,"line":44},[41,1724,132],{"class":47},[41,1726,1727],{"class":71}," fns",[41,1729,138],{"class":47},[41,1731,1732],{"class":55}," []\n",[41,1734,1735,1737,1739,1741,1743,1745,1747,1749,1751,1753,1755,1757],{"class":43,"line":59},[41,1736,1149],{"class":47},[41,1738,636],{"class":55},[41,1740,1154],{"class":47},[41,1742,1157],{"class":55},[41,1744,68],{"class":47},[41,1746,1162],{"class":71},[41,1748,1165],{"class":55},[41,1750,958],{"class":47},[41,1752,1170],{"class":71},[41,1754,1173],{"class":55},[41,1756,1176],{"class":47},[41,1758,380],{"class":55},[41,1760,1761,1764,1767,1769,1771],{"class":43,"line":75},[41,1762,1763],{"class":55},"  fns.",[41,1765,1766],{"class":51},"push",[41,1768,1186],{"class":55},[41,1770,1077],{"class":47},[41,1772,1773],{"class":55}," i)\n",[41,1775,1776],{"class":43,"line":82},[41,1777,121],{"class":55},[41,1779,1780],{"class":43,"line":94},[41,1781,79],{"emptyLinePlaceholder":78},[41,1783,1784,1787,1789,1792,1794,1797,1800,1802,1804],{"class":43,"line":103},[41,1785,1786],{"class":55},"console.",[41,1788,296],{"class":51},[41,1790,1791],{"class":55},"(fns[",[41,1793,1199],{"class":71},[41,1795,1796],{"class":55},"](), fns[",[41,1798,1799],{"class":71},"1",[41,1801,1796],{"class":55},[41,1803,682],{"class":71},[41,1805,1806],{"class":55},"]())\n",[1808,1809,1810,1814,1821,1837,1849],"details",{},[1811,1812,1813],"summary",{},"Answer",[19,1815,1816,1817,1820],{},"Logs ",[38,1818,1819],{},"3 3 3",". Here's why:",[1822,1823,1824,1831],"ul",{},[1825,1826,1827,1828,1830],"li",{},"All three arrow functions capture the SAME ",[38,1829,1649],{}," variable (var is function-scoped)",[1825,1832,1833,1834,1836],{},"By the time any closure runs, the loop has finished and ",[38,1835,1649],{}," is 3",[19,1838,1839,1842,1843,1845,1846,1848],{},[23,1840,1841],{},"Fix",": Use ",[38,1844,1228],{}," instead of ",[38,1847,1154],{},". Each iteration gets a fresh binding.",[28,1850,1851],{"language":30},[32,1852,1854],{"className":34,"code":1853,"language":30,"meta":36,"style":36},"const fns = []\nfor (let i = 0; i \u003C 3; i++) {\n  fns.push(() => i)\n}\n\nconsole.log(fns[0](), fns[1](), fns[2]())  \u002F\u002F 0 1 2\n",[38,1855,1856,1866,1892,1904,1908,1912],{"__ignoreMap":36},[41,1857,1858,1860,1862,1864],{"class":43,"line":44},[41,1859,132],{"class":47},[41,1861,1727],{"class":71},[41,1863,138],{"class":47},[41,1865,1732],{"class":55},[41,1867,1868,1870,1872,1874,1876,1878,1880,1882,1884,1886,1888,1890],{"class":43,"line":59},[41,1869,1149],{"class":47},[41,1871,636],{"class":55},[41,1873,1228],{"class":47},[41,1875,1157],{"class":55},[41,1877,68],{"class":47},[41,1879,1162],{"class":71},[41,1881,1165],{"class":55},[41,1883,958],{"class":47},[41,1885,1170],{"class":71},[41,1887,1173],{"class":55},[41,1889,1176],{"class":47},[41,1891,380],{"class":55},[41,1893,1894,1896,1898,1900,1902],{"class":43,"line":75},[41,1895,1763],{"class":55},[41,1897,1766],{"class":51},[41,1899,1186],{"class":55},[41,1901,1077],{"class":47},[41,1903,1773],{"class":55},[41,1905,1906],{"class":43,"line":82},[41,1907,121],{"class":55},[41,1909,1910],{"class":43,"line":94},[41,1911,79],{"emptyLinePlaceholder":78},[41,1913,1914,1916,1918,1920,1922,1924,1926,1928,1930,1933],{"class":43,"line":103},[41,1915,1786],{"class":55},[41,1917,296],{"class":51},[41,1919,1791],{"class":55},[41,1921,1199],{"class":71},[41,1923,1796],{"class":55},[41,1925,1799],{"class":71},[41,1927,1796],{"class":55},[41,1929,682],{"class":71},[41,1931,1932],{"class":55},"]())  ",[41,1934,1935],{"class":155},"\u002F\u002F 0 1 2\n",[14,1937,1939],{"id":1938},"key-takeaways","Key Takeaways",[1822,1941,1942,1949,1952,1957,1960],{},[1825,1943,1944,1945,1948],{},"Closures capture variables from their ",[23,1946,1947],{},"lexical"," (surrounding) scope, not call-time scope.",[1825,1950,1951],{},"Use closures for: data privacy, currying, memoization, callbacks with state.",[1825,1953,1954,1956],{},[38,1955,1228],{}," in loops creates a new binding per iteration — fixes the classic closure-in-loop problem.",[1825,1958,1959],{},"Closures keep captured variables in memory — clean up references when no longer needed.",[1825,1961,1962],{},"Every function in JavaScript is technically a closure (it closes over the global scope).",[1964,1965,1966],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(-