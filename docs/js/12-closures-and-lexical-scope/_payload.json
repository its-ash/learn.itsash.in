5,1517,1519],{"class":43,"line":521},[41,1516,85],{"class":47},[41,1518,88],{"class":47},[41,1520,91],{"class":55},[41,1522,1523,1525,1527,1529,1532],{"class":43,"line":526},[41,1524,272],{"class":47},[41,1526,877],{"class":71},[41,1528,138],{"class":47},[41,1530,1531],{"class":55}," hugeData.",[41,1533,1534],{"class":71},"length\n",[41,1536,1537,1540,1542,1545],{"class":43,"line":531},[41,1538,1539],{"class":55},"    hugeData ",[41,1541,68],{"class":47},[41,1543,1544],{"class":71}," null",[41,1546,1547],{"class":155},"  \u002F\u002F release reference\n",[41,1549,1550,1552],{"class":43,"line":550},[41,1551,106],{"class":47},[41,1553,911],{"class":55},[41,1555,1556],{"class":43,"line":570},[41,1557,115],{"class":55},[41,1559,1560],{"class":43,"line":589},[41,1561,121],{"class":55},[14,1563,1565],{"id":1564},"tips-tricks","💡 Tips & Tricks",[19,1567,1568,1571,1572,1575,1576,1579],{},[23,1569,1570],{},"Closures for private fields"," — Before ES2022 ",[38,1573,1574],{},"#"," fields, closures were the way: ",[38,1577,1578],{},"function User() { let private = {}; this.getPrimary = () => private }",". Still valid for methods-only access.",[19,1581,1582,1585,1586,1589,1590,1593,1594,1597],{},[23,1583,1584],{},"Currying for partial application"," — ",[38,1587,1588],{},"const add = a => b => a + b"," lets you do ",[38,1591,1592],{},"add(5)(3)"," or ",[38,1595,1596],{},"const add5 = add(5); add5(3)",". Useful for functional pipelines.",[19,1599,1600,1603],{},[23,1601,1602],{},"Memoization for expensive functions"," — Cache results of pure functions. But watch your cache size; memoize only functions you'll call frequently with the same args.",[19,1605,1606,1585,1609,1612],{},[23,1607,1608],{},"Immediately Invoked Generators",[38,1610,1611],{},"(function* gen() { ... })()"," creates a IIFE that yields. Rare but powerful for lazy evaluation.",[14,1614,1616],{"id":1615},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[19,1618,1619,1585,1622,1625,1626,1629,1630,1633,1634,1636,1637,834],{},[23,1620,1621],{},"The loop variable closure trap",[38,1623,1624],{},"for (var i = 0; i \u003C 3; i++) { setTimeout(() => console.log(i), 0) }"," logs ",[38,1627,1628],{},"3, 3, 3",". ALL closures share the SAME ",[38,1631,1632],{},"i",". Use ",[38,1635,1215],{}," to fix: each iteration gets a new ",[38,1638,1632],{},[19,1640,1641,1644],{},[23,1642,1643],{},"Closures capture by reference, not value"," — A closure captures the variable, not its value at capture time. Modify the variable later, and the closure sees the new value. This confuses newcomers.",[19,1646,1647,1650,1651,1654,1655,1658],{},[23,1648,1649],{},"Memory leaks from closures"," — Large objects captured by closures never get garbage collected as long as the closure exists. ",[38,1652,1653],{},"const fn = (() => { const huge = new Array(1e9); return () => {} })()"," keeps ",[38,1656,1657],{},"huge"," in memory forever. Be careful.",[19,1660,1661,1585,1664,1667,1668,1671],{},[23,1662,1663],{},"Circular closures can leak",[38,1665,1666],{},"element.onclick = () => { doSomething(element); }"," — the closure captures ",[38,1669,1670],{},"element",", which has a reference to the closure. Breaks reference cycles by nulling the handler when done.",[19,1673,1674,1677,1678,1681,1682,1685,1686,1689],{},[23,1675,1676],{},"Closure scope chain is read-only from closure perspective"," — You CAN mutate objects in outer scope, but you CAN'T rebind outer variables from inside. ",[38,1679,1680],{},"let x; (() => { x = 5 })()"," mutates the binding (works). But ",[38,1683,1684],{},"let y; (() => { let y = 5 })()"," creates a new ",[38,1687,1688],{},"y"," inside.",[14,1691,1693],{"id":1692},"spot-the-bug","🧠 Spot the Bug",[19,1695,1696],{},"What does this log?",[28,1698,1699],{"language":30},[32,1700,1702],{"className":34,"code":1701,"language":30,"meta":36,"style":36},"const fns = []\nfor (var i = 0; i \u003C 3; i++) {\n  fns.push(() => i)\n}\n\nconsole.log(fns[0](), fns[1](), fns[2]())\n",[38,1703,1704,1716,1742,1757,1761,1765],{"__ignoreMap":36},[41,1705,1706,1708,1711,1713],{"class":43,"line":44},[41,1707,132],{"class":47},[41,1709,1710],{"class":71}," fns",[41,1712,138],{"class":47},[41,1714,1715],{"class":55}," []\n",[41,1717,1718,1720,1722,1724,1726,1728,1730,1732,1734,1736,1738,1740],{"class":43,"line":59},[41,1719,1136],{"class":47},[41,1721,629],{"class":55},[41,1723,1141],{"class":47},[41,1725,1144],{"class":55},[41,1727,68],{"class":47},[41,1729,1149],{"class":71},[41,1731,1152],{"class":55},[41,1733,949],{"class":47},[41,1735,1157],{"class":71},[41,1737,1160],{"class":55},[41,1739,1163],{"class":47},[41,1741,375],{"class":55},[41,1743,1744,1747,1750,1752,1754],{"class":43,"line":75},[41,1745,1746],{"class":55},"  fns.",[41,1748,1749],{"class":51},"push",[41,1751,1173],{"class":55},[41,1753,1066],{"class":47},[41,1755,1756],{"class":55}," i)\n",[41,1758,1759],{"class":43,"line":82},[41,1760,121],{"class":55},[41,1762,1763],{"class":43,"line":94},[41,1764,79],{"emptyLinePlaceholder":78},[41,1766,1767,1770,1772,1775,1777,1780,1783,1785,1787],{"class":43,"line":103},[41,1768,1769],{"class":55},"console.",[41,1771,293],{"class":51},[41,1773,1774],{"class":55},"(fns[",[41,1776,1186],{"class":71},[41,1778,1779],{"class":55},"](), fns[",[41,1781,1782],{"class":71},"1",[41,1784,1779],{"class":55},[41,1786,675],{"class":71},[41,1788,1789],{"class":55},"]())\n",[1791,1792,1793,1797,1804,1820,1832],"details",{},[1794,1795,1796],"summary",{},"Answer",[19,1798,1799,1800,1803],{},"Logs ",[38,1801,1802],{},"3 3 3",". Here's why:",[1805,1806,1807,1814],"ul",{},[1808,1809,1810,1811,1813],"li",{},"All three arrow functions capture the SAME ",[38,1812,1632],{}," variable (var is function-scoped)",[1808,1815,1816,1817,1819],{},"By the time any closure runs, the loop has finished and ",[38,1818,1632],{}," is 3",[19,1821,1822,1825,1826,1828,1829,1831],{},[23,1823,1824],{},"Fix",": Use ",[38,1827,1215],{}," instead of ",[38,1830,1141],{},". Each iteration gets a fresh binding.",[28,183