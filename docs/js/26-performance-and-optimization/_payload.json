ing"," — ",[29,797,798],{},"performance.mark('start'); doWork(); performance.mark('end'); performance.measure('work', 'start', 'end')"," integrates with DevTools' Performance panel timeline directly, so measurements show up visually alongside browser work.",[304,801,802,805,806,809,810,813],{},[775,803,804],{},"WeakMap\u002FWeakSet avoid leaks in caches keyed by objects"," — Using a ",[29,807,808],{},"Map"," to cache data keyed by DOM elements keeps those elements alive forever, even after removal from the page; a ",[29,811,812],{},"WeakMap"," lets them be garbage collected once no other reference exists.",[304,815,816,830,831,825,834,837,838,841],{},[775,817,818,821,822,825,826,829],{},[29,819,820],{},"will-change"," and ",[29,823,824],{},"transform","\u002F",[29,827,828],{},"opacity"," keep animations off the main thread"," — Animating ",[29,832,833],{},"left",[29,835,836],{},"top"," triggers layout on every frame; animating ",[29,839,840],{},"transform: translateX()"," can run on the compositor thread, staying smooth even when JS is busy.",[304,843,844,847],{},[775,845,846],{},"Heap snapshots diff to find real leaks"," — Take two heap snapshots in DevTools before and after a suspected leaking action (e.g. opening\u002Fclosing a modal 10 times), then use the \"Comparison\" view — objects with a growing count that should have been freed point directly at the leak.",[14,849,851],{"id":850},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[304,853,854,857,858,862],{},[775,855,856],{},"Throttle's last call can be dropped entirely"," — The simple throttle implementation shown only fires on the ",[859,860,861],"em",{},"leading"," edge of each window — if the user's last scroll event lands inside the \"ignore\" period, no trailing call ever fires, and the UI can end up visually stuck one update behind the actual scroll position.",[304,864,865,795,872,875,876,879],{},[775,866,867,868,871],{},"Debounce with ",[29,869,870],{},"delay: 0"," still defers to the next tick",[29,873,874],{},"debounce(fn, 0)"," doesn't run synchronously; it still goes through ",[29,877,878],{},"setTimeout",", so code relying on it running \"immediately\" within the same synchronous block will see stale state.",[304,881,882,885,886,889],{},[775,883,884],{},"Closures over loop variables can leak entire large arrays"," — A callback created inside a loop that references any variable from an enclosing scope keeps the ",[859,887,888],{},"entire"," scope alive, not just the variable it uses — so a huge unrelated array declared alongside a small counter can be kept alive by a single lingering event listener referencing that scope.",[304,891,892,898,899,902,903,906],{},[775,893,894,897],{},[29,895,896],{},"IntersectionObserver"," callbacks can fire after the element is removed"," — If an element is removed from the DOM between being observed and the callback firing, the entry's ",[29,900,901],{},"target"," still resolves, but code that assumes the element is visible\u002Fattached (e.g. reading ",[29,904,905],{},"getBoundingClientRect()"," results as current layout) can act on stale geometry.",[304,908,909,795,916,919,920,923,924,926],{},[775,910,911,912,915],{},"Detached DOM nodes aren't visible in ",[29,913,914],{},"document.body"," but still count as leaks",[29,917,918],{},"document.body.removeChild(el)"," removes ",[29,921,922],{},"el"," from the visible tree, but if any JS variable, closure, or event listener still references ",[29,925,922],{},", the entire subtree stays in memory — DevTools' Elements panel won't show it, only a heap snapshot will.",[14,928,930],{"id":929},"spot-the-bug","🧠 Spot the Bug",[304,932,933],{},"Why does the counter stop updating correctly under heavy scrolling?",[19,935,936],{"language":21},[23,937,939],{"className":25,"code":938,"language":21,"meta":27,"style":27},"function throttle(fn, ms) {\n  let last = 0\n  return (...args) => {\n    const now = Date.now()\n    if (now - last >= ms) {\n      last = now\n      fn(...args)\n    }\n  }\n}\n\nlet scrollPosition = 0\nconst updateUI = throttle(() => {\n  console.log('UI synced to', scrollPosition)\n}, 200)\n\nwindow.addEventListener('scroll', () => {\n  scrollPosition = window.scrollY\n  updateUI()\n})\n",[29,940,941,958,968,984,998,1012,1020,1030,1034,1038,1042,1046,1058,1074,1090,1100,1104,1123,1133,1140],{"__ignoreMap":27},[32,942,943,945,947,949,951,953,955],{"class":34,"line":35},[32,944,556],{"class":45},[32,946,175],{"class":49},[32,948,137],{"class":56},[32,950,61],{"class":60},[32,952,64],{"class":56},[32,954,67],{"class":60},[32,956,957],{"class":56},") {\n",[32,959,960,962,964,966],{"class":34,"line":42},[32,961,82],{"class":45},[32,963,199],{"class":56},[32,965,123],{"class":45},[32,967,205],{"class":204},[32,969,970,972,974,976,978,980,982],{"class":34,"line":79},[32,971,91],{"class":45},[32,973,57],{"class":56},[32,975,96],{"class":45},[32,977,99],{"class":60},[32,979,70],{"class":56},[32,981,73],{"class":45},[32,983,76],{"class":56},[32,985,986,988,990,992,994,996],{"class":34,"line":88},[32,987,228],{"class":45},[32,989,231],{"class":204},[32,991,53],{"class":45},[32,993,236],{"class":56},[32,995,239],{"class":49},[32,997,242],{"class":56},[32,999,1000,1002,1004,1006,1008,1010],{"class":34,"line":108},[32,1001,248],{"class":45},[32,1003,251],{"class":56},[32,1005,254],{"class":45},[32,1007,199],{"class":56},[32,1009,259],{"class":45},[32,1011,262],{"class":56},[32,1013,1014,1016,1018],{"class":34,"line":117},[32,1015,268],{"class":56},[32,1017,123],{"class":45},[32,1019,273],{"class":56},[32,1021,1022,1024,1026,1028],{"class":34,"line":145},[32,1023,279],{"class":49},[32,1025,137],{"class":56},[32,1027,96],{"class":45},[32,1029,286],{"class":56},[32,1031,1032],{"class":34,"line":151},[32,1033,292],{"class":56},[32,1035,1036],{"class":34,"line":157},[32,1037,148],{"class":56},[32,1039,1040],{"class":34,"line":164},[32,1041,154],{"class":56},[32,1043,1044],{"class":34,"line":170},[32,1045,161],{"emptyLinePlaceholder":160},[32,1047,1048,1051,1054,1056],{"class":34,"line":194},[32,1049,1050],{"class":45},"let",[32,1052,1053],{"class":56}," scrollPosition ",[32,1055,123],{"class":45},[32,1057,205],{"class":204},[32,1059,1060,1062,1064,1066,1068,1070,1072],{"class":34,"line":208},[32,1061,46],{"class":45},[32,1063,574],{"class":204},[32,1065,53],{"class":45},[32,1067,175],{"class":49},[32,1069,129],{"class":56},[32,1071,73],{"class":45},[32,1073,76],{"class":56},[32,1075,1076,1079,1082,1084,1087],{"class":34,"line":225},[32,1077,1078],{"class":56},"  console.",[32,1080,1081],{"class":49},"log",[32,1083,137],{"class":56},[32,1085,1086],{"class":335},"'UI synced to'",[32,1088,1089],{"class":56},", scrollPosition)\n",[32,1091,1092,1095,1098],{"class":34,"line":245},[32,1093,1094],{"class":56},"}, ",[32,1096,1097],{"class":204},"200",[32,1099,378],{"class":56},[32,1101,1102],{"class":34,"line":265},[32,1103,161],{"emptyLinePlaceholder":160},[32,1105,1106,1109,1111,1113,1116,1119,1121],{"class":34,"line":276},[32,1107,1108],{"class":56},"window.",[32,1110,330],{"class":49},[32,1112,137],{"class":56},[32,1114,1115],{"class":335},"'scroll'",[32,1117,1118],{"class":56},", () ",[32,1120,73],{"class":45},[32,1122,76],{"class":56},[32,1124,1125,1128,1130],{"class":34,"line":289},[32,1126,1127],{"class":56},"  scrollPosition ",[32,1129,123],{"class":45},[32,1131,1132],{"class":56}," window.scrollY\n",[32,1134,1135,1138],{"class":34,"line":295},[32,1136,1137],{"class":49},"  updateUI",[32,1139,242],{"class":56},[32,1141,1142],{"class":34,"line":300},[32,1143,391],{"class":56},[1145,1146,1147,1151,1169],"details",{},[1148,1149,1150],"summary",{},"Answer",[304,1152,1153,1154,1157,1158,1161,1162,1164,1165,1168],{},"While the user is actively scrolling, ",[29,1155,1156],{},"updateUI"," fires roughly every 200ms — reasonably in sync. But the moment scrolling ",[859,1159,1160],{},"stops",", no further scroll events fire, so ",[29,1163,1156],{}," never runs again — even though ",[29,1166,1167],{},"scrollPosition"," changed one last time on the final scroll event that landed inside the throttle window and got dropped. The UI is left displaying a stale position from up to 200ms before the user actually stopped.",[304,1170,1171,1174,1175,1177],{},[775,1172,1173],{},"The lesson",": leading-edge-only throttle can drop the final update in a burst — add a trailing call (",[29,1176,878],{}," to fire once more after the throttle window if a call was suppressed) whenever the last value in a burst matters, such as syncing UI to final scroll position.",[14,1179,1181],{"id":1180},"key-takeaways","Key Takeaways",[1183,1184,1185,1189,1196,1208],"ul",{},[1186,1187,1188],"li",{},"Debounce for bursty events (typing, resize); throttle for continuous events (scroll).",[1186,1190,1191,1192,1195],{},"Dynamic ",[29,1193,1194],{},"import()"," enables code splitting — load heavy code on demand.",[1186,1197,1198,1199,64,1201,64,1204,1207],{},"Always clean up: ",[29,1200,634],{},[29,1202,1203],{},"removeEventListener",[29,1205,1206],{},"observer.disconnect()",".",[1186,1209,1210],{},"Avoid closures that capture large unused data — null out references.",[1212,1213,1214],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text