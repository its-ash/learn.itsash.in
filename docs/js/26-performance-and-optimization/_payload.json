[{"data":1,"prerenderedAt":1230},["ShallowReactive",2],{"page-\u002Fjs\u002F26-performance-and-optimization":3},{"id":4,"title":5,"body":6,"description":27,"extension":1224,"meta":1225,"navigation":160,"path":1226,"seo":1227,"stem":1228,"__hash__":1229},"content\u002Fjs\u002F26-performance-and-optimization.md","26 — Performance & Optimization",{"type":7,"value":8,"toc":1215},"minimark",[9,13,18,303,307,311,534,536,540,766,768,772,779,800,814,842,848,852,863,880,890,907,927,931,934,1144,1178,1182,1211],[10,11,5],"h1",{"id":12},"_26-performance-optimization",[14,15,17],"h2",{"id":16},"debounce-and-throttle","Debounce and Throttle",[19,20,22],"code-wrapper",{"language":21},"javascript",[23,24,28],"pre",{"className":25,"code":26,"language":21,"meta":27,"style":27},"language-javascript shiki shiki-themes github-light github-dark","\u002F\u002F Debounce — search input, resize\nconst debounce = (fn, ms) => {\n  let timer\n  return (...args) => {\n    clearTimeout(timer)\n    timer = setTimeout(() => fn(...args), ms)\n  }\n}\n\n\u002F\u002F Throttle — scroll, mousemove\nconst throttle = (fn, ms) => {\n  let last = 0\n  return (...args) => {\n    const now = Date.now()\n    if (now - last >= ms) {\n      last = now\n      fn(...args)\n    }\n  }\n}\n","",[29,30,31,40,77,86,106,115,143,149,155,162,168,192,206,223,243,263,274,287,293,298],"code",{"__ignoreMap":27},[32,33,36],"span",{"class":34,"line":35},"line",1,[32,37,39],{"class":38},"sdCPZ","\u002F\u002F Debounce — search input, resize\n",[32,41,43,47,51,54,58,62,65,68,71,74],{"class":34,"line":42},2,[32,44,46],{"class":45},"svdQ7","const",[32,48,50],{"class":49},"sIsaT"," debounce",[32,52,53],{"class":45}," =",[32,55,57],{"class":56},"ssxIu"," (",[32,59,61],{"class":60},"sCrzJ","fn",[32,63,64],{"class":56},", ",[32,66,67],{"class":60},"ms",[32,69,70],{"class":56},") ",[32,72,73],{"class":45},"=>",[32,75,76],{"class":56}," {\n",[32,78,80,83],{"class":34,"line":79},3,[32,81,82],{"class":45},"  let",[32,84,85],{"class":56},"