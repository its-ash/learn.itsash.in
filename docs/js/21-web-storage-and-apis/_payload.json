[14,1023,1025],{"id":1024},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[299,1027,1028,970,1033,1036,1037,1040,1041,1044,1045,1048,1049,1052,1053,1056],{},[933,1029,1030,1032],{},[29,1031,947],{}," only stores strings — non-strings are coerced",[29,1034,1035],{},"localStorage.setItem('count', 5)"," stores ",[29,1038,1039],{},"\"5\"",", and ",[29,1042,1043],{},"localStorage.setItem('user', {name: 'A'})"," stores the literal string ",[29,1046,1047],{},"\"[object Object]\"",", not JSON. Forgetting ",[29,1050,1051],{},"JSON.stringify","\u002F",[29,1054,1055],{},"JSON.parse"," is one of the most common storage bugs.",[299,1058,1059,1065,1066,1070,1071,1073,1074,1076],{},[933,1060,1061,1062,1064],{},"The ",[29,1063,938],{}," event never fires in the tab that made the change"," — Only ",[1067,1068,1069],"em",{},"other"," tabs\u002Fwindows on the same origin receive the ",[29,1072,938],{}," event; the tab that called ",[29,1075,50],{}," gets nothing, which surprises developers expecting to self-listen for consistency.",[299,1078,1079,970,1085,1088,1089,1092],{},[933,1080,1081,1084],{},[29,1082,1083],{},"fetch()"," does not reject on HTTP error status",[29,1086,1087],{},"fetch('\u002Fapi\u002Fmissing')"," resolves successfully even for a 404 or 500 response; only network failures (DNS, CORS, offline) cause a rejection. Skipping the ",[29,1090,1091],{},"if (!res.ok) throw ..."," check means error pages get silently treated as success.",[299,1094,1095,1098,1099,1101,1102,1105,1106,1109,1110,1113],{},[933,1096,1097],{},"IndexedDB transactions auto-commit on the next microtask"," — Doing an ",[29,1100,902],{}," or other async work between two calls on the same transaction (e.g. ",[29,1103,1104],{},"await fetch(...)"," between two ",[29,1107,1108],{},".add()"," calls) causes the transaction to close early, throwing ",[29,1111,1112],{},"TransactionInactiveError"," — all IndexedDB work in a transaction must happen synchronously (or via other IndexedDB requests) without yielding to unrelated async code.",[299,1115,1116,1122,1123,1126,1127,1129,1130,1132],{},[933,1117,1118,1121],{},[29,1119,1120],{},"sessionStorage"," isn't shared even between tabs of the same page"," — Opening the same URL in a new tab (not via ",[29,1124,1125],{},"window.open"," from an existing tab) starts with empty ",[29,1128,1120],{},", unlike ",[29,1131,947],{}," which is shared across all tabs on the origin — a frequent point of confusion for \"why did my session data disappear.\"",[14,1134,1136],{"id":1135},"spot-the-bug","🧠 Spot the Bug",[299,1138,1139],{},"What does this log?",[19,1141,1142],{"language":21},[23,1143,1145],{"className":25,"code":1144,"language":21,"meta":27,"style":27},"localStorage.setItem('settings', { theme: 'dark', fontSize: 14 })\nconst loaded = localStorage.getItem('settings')\nconsole.log(loaded)\nconsole.log(loaded.theme)\n",[29,1146,1147,1171,1191,1201],{"__ignoreMap":27},[32,1148,1149,1151,1153,1155,1158,1161,1163,1166,1169],{"class":34,"line":35},[32,1150,46],{"class":45},[32,1152,50],{"class":49},[32,1154,53],{"class":45},[32,1156,1157],{"class":56},"'settings'",[32,1159,1160],{"class":45},", { theme: ",[32,1162,63],{"class":56},[32,1164,1165],{"class":45},", fontSize: ",[32,1167,1168],{"class":163},"14",[32,1170,433],{"class":45},[32,1172,1173,1175,1178,1180,1183,1185,1187,1189],{"class":34,"line":42},[32,1174,160],{"class":159},[32,1176,1177],{"class":163}," loaded",[32,1179,167],{"class":159},[32,1181,1182],{"class":45}," localStorage.",[32,1184,74],{"class":49},[32,1186,53],{"class":45},[32,1188,1157],{"class":56},[32,1190,66],{"class":45},[32,1192,1193,1196,1198],{"class":34,"line":69},[32,1194,1195],{"class":45},"console.",[32,1197,288],{"class":49},[32,1199,1200],{"class":45},"(loaded)\n",[32,1202,1203,1205,1207],{"class":34,"line":87},[32,1204,1195],{"class":45},[32,1206,288],{"class":49},[32,1208,1209],{"class":45},"(loaded.theme)\n",[1211,1212,1213,1217,1252],"details",{},[1214,1215,1216],"summary",{},"Answer",[299,1218,1219,1220,1223,1224,1227,1228,1230,1231,1234,1235,1237,1238,60,1241,1244,1245,1248,1249,1251],{},"Logs ",[29,1221,1222],{},"[object Object]"," then ",[29,1225,1226],{},"undefined",". ",[29,1229,50],{}," coerces its value with ",[29,1232,1233],{},"String()"," before storing, so the object becomes the literal string ",[29,1236,1047],{}," — all the actual data (",[29,1239,1240],{},"theme",[29,1242,1243],{},"fontSize",") is lost the moment it's written, not when it's read back. Accessing ",[29,1246,1247],{},".theme"," on that string returns ",[29,1250,1226],{}," because strings have no such property.",[299,1253,1254,1257,1258,1261,1262,1264,1265,1268,1269,970,1271,1273],{},[933,1255,1256],{},"The lesson",": always ",[29,1259,1260],{},"JSON.stringify()"," before ",[29,1263,50],{}," and ",[29,1266,1267],{},"JSON.parse()"," after ",[29,1270,74],{},[29,1272,947],{}," has no concept of objects, only strings.",[14,1275,1277],{"id":1276},"key-takeaways","Key Takeaways",[1279,1280,1281,1290,1302,1307],"ul",{},[1282,1283,1284,1286,1287,1289],"li",{},[29,1285,947],{}," persists; ",[29,1288,1120],{}," is per-tab — both store strings only.",[1282,1291,1292,1294,1295,1298,1299,202],{},[29,1293,585],{}," rejects on ",[933,1296,1297],{},"network errors",", not HTTP errors — always check ",[29,1300,1301],{},"res.ok",[1282,1303,999,1304,1306],{},[29,1305,955],{}," to cancel in-flight fetch requests.",[1282,1308,1309],{},"IndexedDB is for larger structured data — async, transactional, stores objects.",[1311,1312,1313],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-