,[923,1020,1021,963,1026,1029,1030,1033,1034,1037,1038,1041,1042,1045,1046,1049],{},[926,1022,1023,1025],{},[29,1024,940],{}," only stores strings — non-strings are coerced",[29,1027,1028],{},"localStorage.setItem('count', 5)"," stores ",[29,1031,1032],{},"\"5\"",", and ",[29,1035,1036],{},"localStorage.setItem('user', {name: 'A'})"," stores the literal string ",[29,1039,1040],{},"\"[object Object]\"",", not JSON. Forgetting ",[29,1043,1044],{},"JSON.stringify","\u002F",[29,1047,1048],{},"JSON.parse"," is one of the most common storage bugs.",[923,1051,1052,1058,1059,1063,1064,1066,1067,1069],{},[926,1053,1054,1055,1057],{},"The ",[29,1056,931],{}," event never fires in the tab that made the change"," — Only ",[1060,1061,1062],"em",{},"other"," tabs\u002Fwindows on the same origin receive the ",[29,1065,931],{}," event; the tab that called ",[29,1068,50],{}," gets nothing, which surprises developers expecting to self-listen for consistency.",[923,1071,1072,963,1078,1081,1082,1085],{},[926,1073,1074,1077],{},[29,1075,1076],{},"fetch()"," does not reject on HTTP error status",[29,1079,1080],{},"fetch('\u002Fapi\u002Fmissing')"," resolves successfully even for a 404 or 500 response; only network failures (DNS, CORS, offline) cause a rejection. Skipping the ",[29,1083,1084],{},"if (!res.ok) throw ..."," check means error pages get silently treated as success.",[923,1087,1088,1091,1092,1094,1095,1098,1099,1102,1103,1106],{},[926,1089,1090],{},"IndexedDB transactions auto-commit on the next microtask"," — Doing an ",[29,1093,896],{}," or other async work between two calls on the same transaction (e.g. ",[29,1096,1097],{},"await fetch(...)"," between two ",[29,1100,1101],{},".add()"," calls) causes the transaction to close early, throwing ",[29,1104,1105],{},"TransactionInactiveError"," — all IndexedDB work in a transaction must happen synchronously (or via other IndexedDB requests) without yielding to unrelated async code.",[923,1108,1109,1115,1116,1119,1120,1122,1123,1125],{},[926,1110,1111,1114],{},[29,1112,1113],{},"sessionStorage"," isn't shared even between tabs of the same page"," — Opening the same URL in a new tab (not via ",[29,1117,1118],{},"window.open"," from an existing tab) starts with empty ",[29,1121,1113],{},", unlike ",[29,1124,940],{}," which is shared across all tabs on the origin — a frequent point of confusion for \"why did my session data disappear.\"",[14,1127,1129],{"id":1128},"spot-the-bug","🧠 Spot the Bug",[923,1131,1132],{},"What does this log?",[19,1134,1135],{"language":21},[23,1136,1138],{"className":25,"code":1137,"language":21,"meta":27,"style":27},"localStorage.setItem('settings', { theme: 'dark', fontSize: 14 })\nconst loaded = localStorage.getItem('settings')\nconsole.log(loaded)\nconsole.log(loaded.theme)\n",[29,1139,1140,1164,1184,1194],{"__ignoreMap":27},[32,1141,1142,1144,1146,1148,1151,1154,1156,1159,1162],{"class":34,"line":35},[32,1143,46],{"class":45},[32,1145,50],{"class":49},[32,1147,53],{"class":45},[32,1149,1150],{"class":56},"'settings'",[32,1152,1153],{"class":45},", { theme: ",[32,1155,63],{"class":56},[32,1157,1158],{"class":45},", fontSize: ",[32,1160,1161],{"class":163},"14",[32,1163,429],{"class":45},[32,1165,1166,1168,1171,1173,1176,1178,1180,1182],{"class":34,"line":42},[32,1167,160],{"class":159},[32,1169,1170],{"class":163}," loaded",[32,1172,167],{"class":159},[32,1174,1175],{"class":45}," localStorage.",[32,1177,74],{"class":49},[32,1179,53],{"class":45},[32,1181,1150],{"class":56},[32,1183,66],{"class":45},[32,1185,1186,1189,1191],{"class":34,"line":69},[32,1187,1188],{"class":45},"console.",[32,1190,288],{"class":49},[32,1192,1193],{"class":45},"(loaded)\n",[32,1195,1196,1198,1200],{"class":34,"line":87},[32,1197,1188],{"class":45},[32,1199,288],{"class":49},[32,1201,1202],{"class":45},"(loaded.theme)\n",[1204,1205,1206,1210,1245],"details",{},[1207,1208,1209],"summary",{},"Answer",[923,1211,1212,1213,1216,1217,1220,1221,1223,1224,1227,1228,1230,1231,60,1234,1237,1238,1241,1242,1244],{},"Logs ",[29,1214,1215],{},"[object Object]"," then ",[29,1218,1219],{},"undefined",". ",[29,1222,50],{}," coerces its value with ",[29,1225,1226],{},"String()"," before storing, so the object becomes the literal string ",[29,1229,1040],{}," — all the actual data (",[29,1232,1233],{},"theme",[29,1235,1236],{},"fontSize",") is lost the moment it's written, not when it's read back. Accessing ",[29,1239,1240],{},".theme"," on that string returns ",[29,1243,1219],{}," because strings have no such property.",[923,1246,1247,1250,1251,1254,1255,1257,1258,1261,1262,963,1264,1266],{},[926,1248,1249],{},"The lesson",": always ",[29,1252,1253],{},"JSON.stringify()"," before ",[29,1256,50],{}," and ",[29,1259,1260],{},"JSON.parse()"," after ",[29,1263,74],{},[29,1265,940],{}," has no concept of objects, only strings.",[14,1268,1270],{"id":1269},"key-takeaways","Key Takeaways",[1272,1273,1274,1283,1295,1300],"ul",{},[1275,1276,1277,1279,1280,1282],"li",{},[29,1278,940],{}," persists; ",[29,1281,1113],{}," is per-tab — both store strings only.",[1275,1284,1285,1287,1288,1291,1292,202],{},[29,1286,581],{}," rejects on ",[926,1289,1290],{},"network errors",", not HTTP errors — always check ",[29,1293,1294],{},"res.ok",[1275,1296,992,1297,1299],{},[29,1298,948],{}," to cancel in-flight fetch requests.",[1275,1301,1302],{},"IndexedDB is for larger structured data — async, transactional, stores objects.",[1304,1305,1306],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .snvgF, htm