)  \u002F\u002F \"Bob\" (new binding wins over bind)\nconsole.log(obj1.name)      \u002F\u002F \"Alice\" (bind was ignored)\n",[15,833,834,839,843,859,875,879,892,903,907,911,916,933,944,956,960,965,985,997],{"__ignoreMap":38},[42,835,836],{"class":44,"line":45},[42,837,838],{"class":100},"\u002F\u002F Precedence: new > bind > call\u002Fapply > implicit > default\n",[42,840,841],{"class":44,"line":60},[42,842,88],{"emptyLinePlaceholder":87},[42,844,845,847,850,852,854,857],{"class":44,"line":78},[42,846,117],{"class":48},[42,848,849],{"class":72}," obj1",[42,851,123],{"class":48},[42,853,371],{"class":56},[42,855,856],{"class":134},"'Obj1'",[42,858,376],{"class":56},[42,860,861,863,866,868,870,873],{"class":44,"line":84},[42,862,117],{"class":48},[42,864,865],{"class":72}," obj2",[42,867,123],{"class":48},[42,869,371],{"class":56},[42,871,872],{"class":134},"'Obj2'",[42,874,376],{"class":56},[42,876,877],{"class":44,"line":91},[42,878,88],{"emptyLinePlaceholder":87},[42,880,881,883,886,888,890],{"class":44,"line":170},[42,882,49],{"class":48},[42,884,885],{"class":52}," Foo",[42,887,69],{"class":56},[42,889,343],{"class":313},[42,891,322],{"class":56},[42,893,894,896,898,900],{"class":44,"line":175},[42,895,519],{"class":72},[42,897,522],{"class":56},[42,899,525],{"class":48},[42,901,902],{"class":56}," name\n",[42,904,905],{"class":44,"line":180},[42,906,81],{"class":56},[42,908,909],{"class":44,"line":194},[42,910,88],{"emptyLinePlaceholder":87},[42,912,913],{"class":44,"line":199},[42,914,915],{"class":100},"\u002F\u002F bind creates a new function that ignores later call\u002Fapply targets\n",[42,917,918,920,923,925,928,930],{"class":44,"line":205},[42,919,117],{"class":48},[42,921,922],{"class":72}," BoundFoo",[42,924,123],{"class":48},[42,926,927],{"class":56}," Foo.",[42,929,294],{"class":52},[42,931,932],{"class":56},"(obj1)\n",[42,934,935,938,940,942],{"class":44,"line":218},[42,936,937],{"class":52},"BoundFoo",[42,939,69],{"class":56},[42,941,135],{"class":134},[42,943,75],{"class":56},[42,945,946,949,951,954],{"class":44,"line":228},[42,947,948],{"class":56},"console.",[42,950,66],{"class":52},[42,952,953],{"class":56},"(obj1.name)  ",[42,955,191],{"class":100},[42,957,958],{"class":44,"line":233},[42,959,88],{"emptyLinePlaceholder":87},[42,961,962],{"class":44,"line":239},[42,963,964],{"class":100},"\u002F\u002F But new overrides bind!\n",[42,966,967,969,972,974,976,978,980,983],{"class":44,"line":257},[42,968,117],{"class":48},[42,970,971],{"class":72}," instance",[42,973,123],{"class":48},[42,975,551],{"class":48},[42,977,922],{"class":52},[42,979,69],{"class":56},[42,981,982],{"class":134},"'Bob'",[42,984,75],{"class":56},[42,986,987,989,991,994],{"class":44,"line":707},[42,988,948],{"class":56},[42,990,66],{"class":52},[42,992,993],{"class":56},"(instance.name)  ",[42,995,996],{"class":100},"\u002F\u002F \"Bob\" (new binding wins over bind)\n",[42,998,999,1001,1003,1006],{"class":44,"line":719},[42,1000,948],{"class":56},[42,1002,66],{"class":52},[42,1004,1005],{"class":56},"(obj1.name)      ",[42,1007,1008],{"class":100},"\u002F\u002F \"Alice\" (bind was ignored)\n",[20,1010,1012],{"id":1011},"tips-tricks","💡 Tips & Tricks",[1014,1015,1016,1020,1021,1024],"p",{},[1017,1018,1019],"strong",{},"Bind in constructor"," — Store bound handlers early: ",[15,1022,1023],{},"this.onClick = this.onClick.bind(this)"," in constructor to avoid re-binding every render in React.",[1014,1026,1027,1033,1034,1037,1038,1041],{},[1017,1028,1029,1030,1032],{},"Use ",[15,1031,287],{}," to borrow methods"," — ",[15,1035,1036],{},"Array.prototype.slice.call(arrayLike)"," borrows Array's method. Less common now (use ",[15,1039,1040],{},"Array.from()"," instead), but useful for debugging.",[1014,1043,1044,1033,1049,1052],{},[1017,1045,1046,1047],{},"Partial application with ",[15,1048,294],{},[15,1050,1051],{},"const add5 = add.bind(null, 5)"," creates a function with first arg pre-filled. Less common than closures, but valid pattern.",[1014,1054,1055,1061,1062,1065,1066,1069],{},[1017,1056,1057,1058,1060],{},"Check ",[15,1059,17],{}," in production"," — Use ",[15,1063,1064],{},"console.log(this)"," in methods during debugging. In strict mode it's ",[15,1067,1068],{},"undefined"," if not bound. In non-strict, it's the global object.",[20,1071,1073],{"id":1072},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1014,1075,1076,1033,1082,1085,1086,340],{},[1017,1077,1078,1079,1081],{},"Methods lose ",[15,1080,17],{}," when extracted",[15,1083,1084],{},"const greet = obj.greet; greet()"," loses the context. The function doesn't \"know\" it was a method. Bind at call site: ",[15,1087,1088],{},"setTimeout(obj.greet.bind(obj), 0)",[1014,1090,1091,1033,1096,1099,1100,1102],{},[1017,1092,1093,1094],{},"Arrow functions in object literals don't get ",[15,1095,17],{},[15,1097,1098],{},"{ method: () => this.value }"," has ",[15,1101,17],{}," from outer scope, not the object. Always use regular functions for methods.",[1014,1104,1105,1033,1110,1113,1114,1116,1117,1119],{},[1017,1106,1107,1109],{},[15,1108,493],{}," with bound functions is confusing",[15,1111,1112],{},"const Foo = Bar.bind(ctx); new Foo()"," creates a new instance, but ",[15,1115,17],{}," inside is the new instance, NOT the bound context. ",[15,1118,493],{}," always wins.",[1014,1121,1122,1130,1131,1134,1135,1138],{},[1017,1123,1124,1126,1127,1129],{},[15,1125,287],{},"\u002F",[15,1128,291],{}," in constructors"," — Rarely useful. ",[15,1132,1133],{},"Child.call(this, args)"," in a child constructor calls parent code but doesn't set up the prototype chain. Use ",[15,1136,1137],{},"super"," in classes instead.",[1014,1140,1141,1033,1144,1147,1148,1151],{},[1017,1142,1143],{},"Implicit binding is fragile",[15,1145,1146],{},"obj.method()"," works until someone does ",[15,1149,1150],{},"const m = obj.method; m()",". Real code often has this pattern. Always use arrow functions in callbacks or bind explicitly.",[20,1153,1155],{"id":1154},"spot-the-bug","🧠 Spot the Bug",[1014,1157,1158],{},"What does this log?",[30,1160,1161],{"language":32},[34,1162,1164],{"className":36,"code":1163,"language":32,"meta":38,"style":38},"const obj = {\n  name: 'Alice',\n  greet() { console.log(this.name) },\n  delayedGreet() {\n    setTimeout(this.greet, 1000)  \u002F\u002F BUG: this is lost\n  }\n}\n\nobj.delayedGreet()\n",[15,1165,1166,1176,1184,1200,1207,1226,1230,1234,1238],{"__ignoreMap":38},[42,1167,1168,1170,1172,1174],{"class":44,"line":45},[42,1169,117],{"class":48},[42,1171,120],{"class":72},[42,1173,123],{"class":48},[42,1175,126],{"class":56},[42,1177,1178,1180,1182],{"class":44,"line":60},[42,1179,131],{"class":56},[42,1181,135],{"class":134},[42,1183,138],{"class":56},[42,1185,1186,1188,1191,1193,1195,1197],{"class":44,"line":78},[42,1187,143],{"class":52},[42,1189,1190],{"class":56},"() { console.",[42,1192,66],{"class":52},[42,1194,69],{"class":56},[42,1196,17],{"class":72},[42,1198,1199],{"class":56},".name) },\n",[42,1201,1202,1205],{"class":44,"line":84},[42,1203,1204],{"class":52},"  delayedGreet",[42,1206,57],{"class":56},[42,1208,1209,1212,1214,1216,1219,1221,1223],{"class":44,"line":91},[42,1210,1211],{"class":52},"    setTimeout",[42,1213,69],{"class":56},[42,1215,17],{"class":72},[42,1217,1218],{"class":56},".greet, ",[42,1220,752],{"class":72},[42,1222,251],{"class":56},[42,1224,1225],{"class":100},"\u002F\u002F BUG: this is lost\n",[42,1227,1228],{"class":44,"line":170},[42,1229,167],{"class":56},[42,1231,1232],{"class":44,"line":175},[42,1233,81],{"class":56},[42,1235,1236],{"class":44,"line":180},[42,1237,88],{"emptyLinePlaceholder":87},[42,1239,1240,1242,1245],{"class":44,"line":194},[42,1241,183],{"class":56},[42,1243,1244],{"class":52},"delayedGreet",[42,1246,1247],{"class":56},"()\n",[1249,1250,1251,1255,1261,1286],"details",{},[1252,1253,1254],"summary",{},"Answer",[1014,1256,1257,1258,1260],{},"Logs ",[15,1259,1068],{}," (or the window.name in non-strict mode). Here's why:",[1262,1263,1264,1271],"ul",{},[1265,1266,1267,1270],"li",{},[15,1268,1269],{},"setTimeout(this.greet, 1000)"," passes the function without context",[1265,1272,1273,1274,1276,1277,1279,1280,1282,1283],{},"When ",[15,1275,242],{}," calls it, ",[15,1278,17],{}," is ",[15,1281,1068],{}," (strict mode) or ",[15,1284,1285],{},"window",[1014,1287,1288,1291,1292,1295,1296,340],{},[1017,1289,1290],{},"Fix",": Use ",[15,1293,1294],{},"setTimeout(() => this.greet(), 1000)"," or ",[15,1297,1298],{},"setTimeout(this.greet.bind(this), 1000)",[20,1300,1302],{"id":1301},"key-takeaways","Key Takeaways",[1262,1304,1305,1314,1326,1332,1344],{},[1265,1306,1307,1309,1310,1313],{},[15,1308,17],{}," is determined by ",[1017,1311,1312],{},"how the function is called",", not where it's defined.",[1265,1315,1316,1317,1126,1319,1126,1321,1323,1324,340],{},"Four rules: default, implicit (method), explicit (",[15,1318,287],{},[15,1320,291],{},[15,1322,294],{},"), ",[15,1325,493],{},[1265,1327,1328,1329,1331],{},"Arrow functions inherit ",[15,1330,17],{}," lexically — use for callbacks, NOT object methods.",[1265,1333,1334,1336,1337,1033,1339,1126,1341,1343],{},[15,1335,294],{}," permanently fixes ",[15,1338,17],{},[15,1340,287],{},[15,1342,291],{}," are one-time.",[1265,1345,1346,1347,1349,1350,1349,1352,1126,1354,1356],{},"Binding precedence: ",[15,1348,493],{}," > ",[15,1351,294],{},[15,1353,287],{},[15,1355,291],{}," > implicit > default.",[1358,1359,1360],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html .default .shiki span {color: var(--sh