" creates a function with first arg pre-filled. Less common than closures, but valid pattern.",[488,1063,1064,1070,1071,1074,1075,1078],{},[1026,1065,1066,1067,1069],{},"Check ",[15,1068,17],{}," in production"," — Use ",[15,1072,1073],{},"console.log(this)"," in methods during debugging. In strict mode it's ",[15,1076,1077],{},"undefined"," if not bound. In non-strict, it's the global object.",[20,1080,1082],{"id":1081},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[488,1084,1085,1042,1091,1094,1095,340],{},[1026,1086,1087,1088,1090],{},"Methods lose ",[15,1089,17],{}," when extracted",[15,1092,1093],{},"const greet = obj.greet; greet()"," loses the context. The function doesn't \"know\" it was a method. Bind at call site: ",[15,1096,1097],{},"setTimeout(obj.greet.bind(obj), 0)",[488,1099,1100,1042,1105,1108,1109,1111],{},[1026,1101,1102,1103],{},"Arrow functions in object literals don't get ",[15,1104,17],{},[15,1106,1107],{},"{ method: () => this.value }"," has ",[15,1110,17],{}," from outer scope, not the object. Always use regular functions for methods.",[488,1113,1114,1042,1119,1122,1123,1125,1126,1128],{},[1026,1115,1116,1118],{},[15,1117,497],{}," with bound functions is confusing",[15,1120,1121],{},"const Foo = Bar.bind(ctx); new Foo()"," creates a new instance, but ",[15,1124,17],{}," inside is the new instance, NOT the bound context. ",[15,1127,497],{}," always wins.",[488,1130,1131,1139,1140,1143,1144,1147],{},[1026,1132,1133,1135,1136,1138],{},[15,1134,287],{},"\u002F",[15,1137,291],{}," in constructors"," — Rarely useful. ",[15,1141,1142],{},"Child.call(this, args)"," in a child constructor calls parent code but doesn't set up the prototype chain. Use ",[15,1145,1146],{},"super"," in classes instead.",[488,1149,1150,1042,1153,1156,1157,1160],{},[1026,1151,1152],{},"Implicit binding is fragile",[15,1154,1155],{},"obj.method()"," works until someone does ",[15,1158,1159],{},"const m = obj.method; m()",". Real code often has this pattern. Always use arrow functions in callbacks or bind explicitly.",[20,1162,1164],{"id":1163},"spot-the-bug","🧠 Spot the Bug",[488,1166,1167],{},"What does this log?",[30,1169,1170],{"language":32},[34,1171,1173],{"className":36,"code":1172,"language":32,"meta":38,"style":38},"const obj = {\n  name: 'Alice',\n  greet() { console.log(this.name) },\n  delayedGreet() {\n    setTimeout(this.greet, 1000)  \u002F\u002F BUG: this is lost\n  }\n}\n\nobj.delayedGreet()\n",[15,1174,1175,1185,1193,1209,1216,1235,1239,1243,1247],{"__ignoreMap":38},[42,1176,1177,1179,1181,1183],{"class":44,"line":45},[42,1178,117],{"class":48},[42,1180,120],{"class":72},[42,1182,123],{"class":48},[42,1184,126],{"class":56},[42,1186,1187,1189,1191],{"class":44,"line":60},[42,1188,131],{"class":56},[42,1190,135],{"class":134},[42,1192,138],{"class":56},[42,1194,1195,1197,1200,1202,1204,1206],{"class":44,"line":78},[42,1196,143],{"class":52},[42,1198,1199],{"class":56},"() { console.",[42,1201,66],{"class":52},[42,1203,69],{"class":56},[42,1205,17],{"class":72},[42,1207,1208],{"class":56},".name) },\n",[42,1210,1211,1214],{"class":44,"line":84},[42,1212,1213],{"class":52},"  delayedGreet",[42,1215,57],{"class":56},[42,1217,1218,1221,1223,1225,1228,1230,1232],{"class":44,"line":91},[42,1219,1220],{"class":52},"    setTimeout",[42,1222,69],{"class":56},[42,1224,17],{"class":72},[42,1226,1227],{"class":56},".greet, ",[42,1229,758],{"class":72},[42,1231,251],{"class":56},[42,1233,1234],{"class":100},"\u002F\u002F BUG: this is lost\n",[42,1236,1237],{"class":44,"line":170},[42,1238,167],{"class":56},[42,1240,1241],{"class":44,"line":175},[42,1242,81],{"class":56},[42,1244,1245],{"class":44,"line":180},[42,1246,88],{"emptyLinePlaceholder":87},[42,1248,1249,1251,1254],{"class":44,"line":194},[42,1250,183],{"class":56},[42,1252,1253],{"class":52},"delayedGreet",[42,1255,1256],{"class":56},"()\n",[1258,1259,1260,1264,1270,1295],"details",{},[1261,1262,1263],"summary",{},"Answer",[488,1265,1266,1267,1269],{},"Logs ",[15,1268,1