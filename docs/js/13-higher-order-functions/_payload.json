)     \u002F\u002F 6\nadd(1)(2, 3)     \u002F\u002F 6\nadd(1, 2, 3)     \u002F\u002F 6\n\n\u002F\u002F Practical: reusable partial functions\nconst log = curry((level, message) => console.log(`[${level}] ${message}`))\nconst error = log('ERROR')\nconst info = log('INFO')\nerror('Database failed')  \u002F\u002F \"[ERROR] Database failed\"\ninfo('Server started')    \u002F\u002F \"[INFO] Server started\"\n",[29,580,581,586,603,622,643,661,666,696,701,705,709,749,772,792,813,834,839,845,895,914,933,949],{"__ignoreMap":27},[32,582,583],{"class":34,"line":35},[32,584,585],{"class":38},"\u002F\u002F Currying — transform(a, b, c) → transform(a)(b)(c)\n",[32,587,588,590,593,595,598,600],{"class":34,"line":42},[32,589,256],{"class":78},[32,591,592],{"class":67}," curry",[32,594,262],{"class":78},[32,596,597],{"class":74}," fn",[32,599,79],{"class":78},[32,601,602],{"class":45}," {\n",[32,604,605,607,610,613,615,617,620],{"class":34,"line":97},[32,606,229],{"class":78},[32,608,609],{"class":78}," function",[32,611,612],{"class":67}," curried",[32,614,71],{"class":45},[32,616,360],{"class":78},[32,618,619],{"class":74},"args",[32,621,223],{"class":45},[32,623,624,627,630,633,636,639,641],{"class":34,"line":137},[32,625,626],{"class":78},"    if",[32,628,629],{"class":45}," (args.",[32,631,632],{"class":49},"length",[32,634,635],{"class":78}," >=",[32,637,638],{"class":45}," fn.",[32,640,632],{"class":49},[32,642,223],{"class":45},[32,644,645,648,650,653,655,658],{"class":34,"line":191},[32,646,647],{"class":78},"      return",[32,649,638],{"class":45},[32,651,652],{"class":67},"apply",[32,654,71],{"class":45},[32,656,657],{"class":49},"this",[32,659,660],{"class":45},", args)\n",[32,662,663],{"class":34,"line":198},[32,664,665],{"class":45},"    }\n",[32,667,668,671,673,675,678,680,682,684,686,688,691,693],{"class":34,"line":204},[32,669,670],{"class":78},"    return",[32,672,357],{"class":45},[32,674,360],{"class":78},[32,676,677],{"class":74},"more",[32,679,168],{"class":45}