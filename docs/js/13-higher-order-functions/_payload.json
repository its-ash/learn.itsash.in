, 2, 3)     \u002F\u002F 6\n\n\u002F\u002F Practical: reusable partial functions\nconst log = curry((level, message) => console.log(`[${level}] ${message}`))\nconst error = log('ERROR')\nconst info = log('INFO')\nerror('Database failed')  \u002F\u002F \"[ERROR] Database failed\"\ninfo('Server started')    \u002F\u002F \"[INFO] Server started\"\n",[29,574,575,580,597,616,637,655,660,690,695,699,703,743,766,786,807,828,833,839,889,908,927,943],{"__ignoreMap":27},[32,576,577],{"class":34,"line":35},[32,578,579],{"class":38},"\u002F\u002F Currying — transform(a, b, c) → transform(a)(b)(c)\n",[32,581,582,584,587,589,592,594],{"class":34,"line":42},[32,583,256],{"class":78},[32,585,586],{"class":67}," curry",[32,588,262],{"class":78},[32,590,591],{"class":74}," fn",[32,593,79],{"class":78},[32,595,596],{"class":45}," {\n",[32,598,599,601,604,607,609,611,614],{"class":34,"line":97},[32,600,229],{"class":78},[32,602,603],{"class":78}," function",[32,605,606],{"class":67}," curried",[32,608,71],{"class":45},[32,610,356],{"class":78},[32,612,613],{"class":74},"args",[32,615,223],{"class":45},[32,617,618,621,624,627,630,633,635],{"class":34,"line":137},[32,619,620],{"class":78},"    if",[32,622,623],{"class":45}," (args.",[32,625,626],{"class":49},"length",[32,628,629],{"class":78}," >=",[32,631,632],{"class":45}," fn.",[32,634,626],{"class":49},[32,636,223],{"class":45},[32,638,639,642,644,647,649,652],{"class":34,"line":191},[32,640,641],{"class":78},"      return",[32,643,632],{"class":45},[32,645,646],{"class":67},"apply",[32,648,71],{"class":45},[32,650,651],{"class":49},"this",[32,653,654],{"class":45},", args)\n",[32,656,657],{"class":34,"line":198},[32,658,659],{"class":45},"    }\n",[32,661,662,665,667,669,672,674,676,678,680,682,685,687],{"class":34,"line":204},[32,663,664],{"class":78},"    return",[32,666,353],{"class":45},[32,668,356],{"class":78},[32,670,671],{"class":74},"more",[32,673,168],{"class":45},[32,675,171],{"class":78},[32,677,606],{"class":67},[32,679