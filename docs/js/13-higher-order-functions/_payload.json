:516},"'Server started'",[32,961,962],{"class":45},")    ",[32,964,965],{"class":38},"\u002F\u002F \"[INFO] Server started\"\n",[327,967,329],{},[14,969,971],{"id":970},"partial-application","Partial Application",[19,973,974],{"language":21},[23,975,977],{"className":25,"code":976,"language":21,"meta":27,"style":27},"\u002F\u002F Partial application — fix some args, leave others open\nconst partial = (fn, ...args) => (...rest) => fn(...args, ...rest)\n\nconst multiply = (a, b, c) => a * b * c\nconst double = partial(multiply, 2)\ndouble(3, 4)  \u002F\u002F 24\n\nconst timesSix = partial(multiply, 2, 3)\ntimesSix(4)  \u002F\u002F 24\n\n\u002F\u002F Difference from currying:\n\u002F\u002F Curry: f(a)(b)(c) — one arg at a time\n\u002F\u002F Partial: f(a, b)(c) — some args, then rest\n",[29,978,979,984,1032,1036,1072,1089,1108,1112,1133,1146,1150,1155,1160],{"__ignoreMap":27},[32,980,981],{"class":34,"line":35},[32,982,983],{"class":38},"\u002F\u002F Partial application — fix some args, leave others open\n",[32,985,986,988,991,993,995,998,1000,1002,1004,1006,1008,1010,1012,1015,1017,1019,1021,1023,1025,1027,1029],{"class":34,"line":42},[32,987,256],{"class":78},[32,989,990],{"class":67}," partial",[32,992,262],{"class":78},[32,994,357],{"class":45},[32,996,997],{"class":74},"fn",[32,999,53],{"class":45},[32,1001,360],{"class":78},[32,1003,619],{"class":74},[32,1005,168],{"class":45},[32,1007,171],{"class":78},[32,1009,357],{"class":45},[32,1011,360],{"class":78},[32,1013,1014],{"class":74},"rest",[32,1016,168],{"class":45},[32,1018,171],{"class":78},[32,1020,597],{"class":67},[32,1022,71],{"class":45},[32,1024,360],{"class":78},[32,1026,690],{"class":45},[32,1028,360],{"class":78},[32,1030,1031],{"class":45},"rest)\n",[32,1033,1034],{"class":34,"line":97},[32,1035,195],{"emptyLinePlaceholder":194},[32,1037,1038,1040,1043,1045,1047,1049,1051,1053,1055,1057,1059,1061,1063,1065,1067,1069],{"class":34,"line":137},[32,1039,256],{"class":78},[32,1041,1042],{"class":67}," multiply",[32,1044,262],{"class":78},[32,1046,357],{"class":45},[32,1048,160],{"class":74},[32,1050,53],{"class":45},[32,1052,165],{"class":74},[32,1054,53],{"class":45},[32,1056,732],{"class":74},[32,1058,168],{"class":45},[32,1060,171],{"class":78},[32,1062,174],{"class":45},[32,1064,85],{"class":78},[32,1066,743],{"class":45},[32,1068,85],{"class":78},[32,1070,1071],{"class":45}," c\n",[32,1073,1074,1076,1078,1080,1082,1085,1087],{"class":34,"line":191},[32,1075,256],{"class":78},[32,1077,281],{"class":49},[32,1079,262],{"class":78},[32,1081,990],{"class":67},[32,1083,1084],{"class":45},"(multiply, ",[32,1086,56],{"class":49},[32,1088,534],{"class":45},[32,1090,1091,1094,1096,1098,1100,1103,1105],{"class":34,"line":198},[32,1092,1093],{"class":67},"double",[32,1095,71],{"class":45},[32,1097,61],{"class":49},[32,1099,53],{"class":45},[32,1101,1102],{"class":49},"4",[32,1104,322],{"class":45},[32,1106,1107],{"class":38},"\u002F\u002F 24\n",[32,1109,1110],{"class":34,"line":204},[32,1111,195],{"emptyLinePlaceholder":194},[32,1113,1114,1116,1119,1121,1123,1125,1127,1129,1131],{"class":34,"line":226},[32,1115,256],{"class":78},[32,1117,1118],{"class":49}," timesSix",[32,1120,262],{"class":78},[32,1122,990],{"class":67},[32,1124,1084],{"class":45},[32,1126,56],{"class":49},[32,1128,53],{"class":45},[32,1130,61],{"class":49},[32,1132,534],{"class":45},[32,1134,1135,1138,1140,1142,1144],{"class":34,"line":247},[32,1136,1137],{"class":67},"timesSix",[32,1139,71],{"class":45},[32,1141,1102],{"class":49},[32,1143,322],{"class":45},[32,1145,1107],{"class":38},[32,1147,1148],{"class":34,"line":253},[32,1149,195],{"emptyLinePlaceholder":194},[32,1151,1152],{"class":34,"line":276},[32,1153,1154],{"class":38},"\u002F\u002F Difference from currying:\n",[32,1156,1157],{"class":34,"line":297},[32,1158,1159],{"class":38},"\u002F\u002F Curry: f(a)(b)(c) — one arg at a time\n",[32,1161,1162],{"class":34,"line":312},[32,1163,1164],{"class":38},"\u002F\u002F Partial: f(a, b)(c) — some args, then rest\n",[327,1166,329],{},[14,1168,1170],{"id":1169},"tips-tricks","💡 Tips & Tricks",[327,1172,1173,1177,1178,1181,1182,1185],{},[1174,1175,1176],"strong",{},"Built-in composition"," — Many libraries ship ",[29,1179,1180],{},"pipe"," and ",[29,1183,1184],{},"compose",". Use them instead of rolling your own — lodash, Ramda, etc. have battle-tested versions.",[327,1187,1188,1191,1192,1195],{},[1174,1189,1190],{},"Currying with automatic detection"," — ",[29,1193,1194],{},"const curry = fn => fn.length \u003C= 1 ? fn : x => y => fn(x, y)"," detects function arity and handles it automatically.",[327,1197,1198,1191,1201,1204],{},[1174,1199,1200],{},"Function.prototype.bind is partial application",[29,1202,1203],{},"fn.bind(context, arg1, arg2)"," is a built-in way to partially apply arguments. Forget about writing partial helpers.",[327,1206,1207,1191,1210,53,1213,53,1216,1219],{},[1174,1208,1209],{},"Array methods are higher-order",[29,1211,1212],{},".map()",[29,1214,1215],{},".filter()",[29,1217,1218],{},".reduce()"," are all higher-order. They accept function arguments. Master these before complex composition.",[14,1221,1223],{"id":1222},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[327,1225,1226,1191,1229,1232,1233,1236],{},[1174,1227,1228],{},"Composition order matters",[29,1230,1231],{},"compose(f, g)"," means \"do g, then f\" (right-to-left, math-style). ",[29,1234,1235],{},"pipe(f, g)"," means \"do f, then g\" (left-to-right, shell-style). Easy to flip and create bugs.",[327,1238,1239,1191,1242,1245,1246,1249],{},[1174,1240,1241],{},"Currying breaks function length",[29,1243,1244],{},"const f = curry((a,b,c) => ...); f.length"," is 1 (the first partial), not 3. Use ",[29,1247,1248],{},".bind()"," if you need the original arity.",[327,1251,1252,1191,1255,1258,1259,1262],{},[1174,1253,1254],{},"Currying + default params = confusion",[29,1256,1257],{},"const f = curry((a, b = 2) => a + b)"," has arity 1 (b has default). You'd need to call ",[29,1260,1261],{},"f(1)(undefined)"," to use defaults. Avoid mixing these.",[327,1264,1265,1191,1268,1271],{},[1174,1266,1267],{},"Partial application is order-dependent",[29,1269,1270],{},"partial(fn, a, b)"," fixes args left-to-right. If your function expects args right-to-left, partial won't help. Curry is more flexible.",[327,1273,1274,1191,1277,1280,1281,1283,1284,1287,1288,1290,1291,1294],{},[1174,1275,1276],{},"Context loss in composed functions",[29,1278,1279],{},"compose(obj.method, otherFn)"," loses ",[29,1282,657],{}," from ",[29,1285,1286],{},"obj.method",". You need to ",[29,1289,1248],{}," methods before composing: ",[29,1292,1293],{},"compose(obj.method.bind(obj), otherFn)",".",[14,1296,1298],{"id":1297},"spot-the-bug","🧠 Spot the Bug",[327,1300,1301],{},"What does this log?",[19,1303,1304],{"language":21},[23,1305,1307],{"className":25,"code":1306,"language":21,"meta":27,"style":27},"const compose = (...fns) => x => fns.reduceRight((v, f) => f(v), x)\n\nconst add10 = x => x + 10\nconst times2 = x => x * 2\n\nconst composed = compose(add10, times2)\n\nconsole.log(composed(5))\n",[29,1308,1309,1351,1355,1375,1394,1398,1412,1416],{"__ignoreMap":27},[32,1310,1311,1313,1315,1317,1319,1321,1323,1325,1327,1329,1331,1333,1335,1337,1339,1341,1343,1345,1347,1349],{"class":34,"line":35},[32,1312,256],{"class":78},[32,1314,210],{"class":67},[32,1316,262],{"class":78},[32,1318,357],{"class":45},[32,1320,360],{"class":78},[32,1322,363],{"class":74},[32,1324,168],{"class":45},[32,1326,171],{"class":78},[32,1328,232],{"class":74},[32,1330,79],{"class":78},[32,1332,374],{"class":45},[32,1334,430],{"class":67},[32,1336,157],{"class":45},[32,1338,381],{"class":74},[32,1340,53],{"class":45},[32,1342,215],{"class":74},[32,1344,168],{"class":45},[32,1346,171],{"class":78},[32,1348,237],{"class":67},[32,1350,394],{"class":45},[32,1352,1353],{"class":34,"line":42},[32,1354,195],{"emptyLinePlaceholder":194},[32,1356,1357,1359,1362,1364,1366,1368,1370,1372],{"class":34,"line":97},[32,1358,256],{"class":78},[32,1360,1361],{"class":67}," add10",[32,1363,262],{"class":78},[32,1365,232],{"class":74},[32,1367,79],{"class":78},[32,1369,82],{"class":45},[32,1371,177],{"class":78},[32,1373,1374],{"class":49}," 10\n",[32,1376,1377,1379,1382,1384,1386,1388,1390,1392],{"class":34,"line":137},[32,1378,256],{"class":78},[32,1380,1381],{"class":67}," times2",[32,1383,262],{"class":78},[32,1385,232],{"class":74},[32,1387,79],{"class":78},[32,1389,82],{"class":45},[32,1391,85],{"class":78},[32,1393,294],{"class":49},[32,1395,1396],{"class":34,"line":191},[32,1397,195],{"emptyLinePlaceholder":194},[32,1399,1400,1402,1405,1407,1409],{"class":34,"line":198},[32,1401,256],{"class":78},[32,1403,1404],{"class":49}," composed",[32,1406,262],{"class":78},[32,1408,210],{"class":67},[32,1410,1411],{"class":45},"(add10, times2)\n",[32,1413,1414],{"class":34,"line":204},[32,1415,195],{"emptyLinePlaceholder":194},[32,1417,1418,1421,1423,1425,1428,1430,1433],{"class":34,"line":226},[32,1419,1420],{"class":45},"console.",[32,1422,876],{"class":67},[32,1424,71],{"class":45},[32,1426,1427],{"class":67},"composed",[32,1429,71],{"class":45},[32,1431,1432],{"class":49},"5",[32,1434,894],{"class":45},[1436,1437,1438,1442,1449,1479,1486],"details",{},[1439,1440,1441],"summary",{},"Answer",[327,1443,1444,1445,1448],{},"Logs ",[29,1446,1447],{},"20",". Here's why:",[1450,1451,1452,1465],"ul",{},[1453,1454,1455,1457,1458,1461,1462],"li",{},[29,1456,1184],{}," does right-to-left: ",[29,1459,1460],{},"times2",", then ",[29,1463,1464],{},"add10",[1453,1466,1467,1470,1471,1474,1475,1478],{},[29,1468,1469],{},"composed(5)"," → ",[29,1472,1473],{},"times2(5)"," = 10 → ",[29,1476,1477],{},"add10(10)"," = 20",[327,1480,1481,1482,1485],{},"If you wanted 40, you'd need ",[29,1483,1484],{},"compose(times2, add10)"," (right-to-left order in the compose call is the opposite of execution order).",[327,1487,1488,1491,1492,1494],{},[1174,1489,1490],{},"The lesson",": Compose is confusing. Many prefer ",[29,1493,1180],{}," (left-to-right) for readability.",[14,1496,1498],{"id":1497},"key-takeaways","Key Takeaways",[1450,1500,1501,1504,1512,1515],{},[1453,1502,1503],{},"Higher-order functions take or return functions — the backbone of functional programming in JS.",[1453,1505,1506,1508,1509,1511],{},[29,1507,1180],{}," executes left-to-right, ",[29,1510,1184],{}," right-to-left — choose one and be consistent.",[1453,1513,1514],{},"Currying transforms multi-arg functions into single-arg chains — useful for reusable partials.",[1453,1516,1517],{},"Partial application fixes some args, leaving the rest for later — simpler than full currying.",[1519,1520,1521],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-