32,958,959],{"class":38},"\u002F\u002F \"[INFO] Server started\"\n",[14,961,963],{"id":962},"partial-application","Partial Application",[19,965,966],{"language":21},[23,967,969],{"className":25,"code":968,"language":21,"meta":27,"style":27},"\u002F\u002F Partial application — fix some args, leave others open\nconst partial = (fn, ...args) => (...rest) => fn(...args, ...rest)\n\nconst multiply = (a, b, c) => a * b * c\nconst double = partial(multiply, 2)\ndouble(3, 4)  \u002F\u002F 24\n\nconst timesSix = partial(multiply, 2, 3)\ntimesSix(4)  \u002F\u002F 24\n\n\u002F\u002F Difference from currying:\n\u002F\u002F Curry: f(a)(b)(c) — one arg at a time\n\u002F\u002F Partial: f(a, b)(c) — some args, then rest\n",[29,970,971,976,1024,1028,1064,1081,1100,1104,1125,1138,1142,1147,1152],{"__ignoreMap":27},[32,972,973],{"class":34,"line":35},[32,974,975],{"class":38},"\u002F\u002F Partial application — fix some args, leave others open\n",[32,977,978,980,983,985,987,990,992,994,996,998,1000,1002,1004,1007,1009,1011,1013,1015,1017,1019,1021],{"class":34,"line":42},[32,979,256],{"class":78},[32,981,982],{"class":67}," partial",[32,984,262],{"class":78},[32,986,353],{"class":45},[32,988,989],{"class":74},"fn",[32,991,53],{"class":45},[32,993,356],{"class":78},[32,995,613],{"class":74},[32,997,168],{"class":45},[32,999,171],{"class":78},[32,1001,353],{"class":45},[32,1003,356],{"class":78},[32,1005,1006],{"class":74},"rest",[32,1008,168],{"class":45},[32,1010,171],{"class":78},[32,1012,591],{"class":67},[32,1014,71],{"class":45},[32,1016,356],{"class":78},[32,1018,684],{"class":45},[32,1020,356],{"class":78},[32,1022,1023],{"class":45},"rest)\n",[32,1025,1026],{"class":34,"line":97},[32,1027,195],{"emptyLinePlaceholder":194},[32,1029,1030,1032,1035,1037,1039,1041,1043,1045,1047,1049,1051,1053,1055,1057,1059,1061],{"class":34,"line":137},[32,1031,256],{"class":78},[32,1033,1034],{"class":67}," multiply",[32,1036,262],{"class":78},[32,1038,353],{"class":45},[32,1040,160],{"class":74},[32,1042,53],{"class":45},[32,1044,165],{"class":74},[32,1046,53],{"class":45},[32,1048,726],{"class":74},[32,1050,168],{"class":45},[32,1052,171],{"class":78},[32,1054,174],{"class":45},[32,1056,85],{"class":78},[32,1058,737],{"class":45},[32,1060,85],{"class":78},[32,1062,1063],{"class":45}," c\n",[32,1065,1066,1068,1070,1072,1074,1077,1079],{"class":34,"line":191},[32,1067,256],{"class":78},[32,1069,281],{"class":49},[32,1071,262],{"class":78},[32,1073,982],{"class":67},[32,1075,1076],{"class":45},"(multiply, ",[32,1078,56],{"class":49},[32,1080,530],{"class":45},[32,1082,1083,1086,1088,1090,1092,1095,1097],{"class":34,"line":198},[32,1084,1085],{"class":67},"double",[32,1087,71],{"class":45},[32,1089,61],{"class":49},[32,1091,53],{"class":45},[32,1093,1094],{"class":49},"4",[32,1096,322],{"class":45},[32,1098,1099],{"class":38},"\u002F\u002F 24\n",[32,1101,1102],{"class":34,"line":204},[32,1103,195],{"emptyLinePlaceholder":194},[32,1105,1106,1108,1111,1113,1115,1117,1119,1121,1123],{"class":34,"line":226},[32,1107,256],{"class":78},[32,1109,1110],{"class":49}," timesSix",[32,1112,262],{"class":78},[32,1114,982],{"class":67},[32,1116,1076],{"class":45},[32,1118,56],{"class":49},[32,1120,53],{"class":45},[32,1122,61],{"class":49},[32,1124,530],{"class":45},[32,1126,1127,1130,1132,1134,1136],{"class":34,"line":247},[32,1128,1129],{"class":67},"timesSix",[32,1131,71],{"class":45},[32,1133,1094],{"class":49},[32,1135,322],{"class":45},[32,1137,1099],{"class":38},[32,1139,1140],{"class":34,"line":253},[32,1141,195],{"emptyLinePlaceholder":194},[32,1143,1144],{"class":34,"line":276},[32,1145,1146],{"class":38},"\u002F\u002F Difference from currying:\n",[32,1148,1149],{"class":34,"line":297},[32,1150,1151],{"class":38},"\u002F\u002F Curry: f(a)(b)(c) — one arg at a time\n",[32,1153,1154],{"class":34,"line":312},[32,1155,1156],{"class":38},"\u002F\u002F Partial: f(a, b)(c) — some args, then rest\n",[14,1158,1160],{"id":1159},"tips-tricks","💡 Tips & Tricks",[1162,1163,1164,1168,1169,1172,1173,1176],"p",{},[1165,1166,1167],"strong",{},"Built-in composition"," — Many libraries ship ",[29,1170,1171],{},"pipe"," and ",[29,1174,1175],{},"compose",". Use them instead of rolling your own — lodash, Ramda, etc. have battle-tested versions.",[1162,1178,1179,1182,1183,1186],{},[1165,1180,1181],{},"Currying with automatic detection"," — ",[29,1184,1185],{},"const curry = fn => fn.length \u003C= 1 ? fn : x => y => fn(x, y)"," detects function arity and handles it automatically.",[1162,1188,1189,1182,1192,1195],{},[1165,1190,1191],{},"Function.prototype.bind is partial application",[29,1193,1194],{},"fn.bind(context, arg1, arg2)"," is a built-in way to partially apply arguments. Forget about writing partial helpers.",[1162,1197,1198,1182,1201,53,1204,53,1207,1210],{},[1165,1199,1200],{},"Array methods are higher-order",[29,1202,1203],{},".map()",[29,1205,1206],{},".filter()",[29,1208,1209],{},".reduce()"," are all higher-order. They accept function arguments. Master these before complex composition.",[14,1212,1214],{"id":1213},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1162,1216,1217,1182,1220,1223,1224,1227],{},[1165,1218,1219],{},"Composition order matters",[29,1221,1222],{},"compose(f, g)"," means \"do g, then f\" (right-to-left, math-style). ",[29,1225,1226],{},"pipe(f, g)"," means \"do f, then g\" (left-to-right, shell-style). Easy to flip and create bugs.",[1162,1229,1230,1182,1233,1236,1237,1240],{},[1165,1231,1232],{},"Currying breaks function length",[29,1234,1235],{},"const f = curry((a,b,c) => ...); f.length"," is 1 (the first partial), not 3. Use ",[29,1238,1239],{},".bind()"," if you need the original arity.",[1162,1242,1243,1182,1246,1249,1250,1253],{},[1165,1244,1245],{},"Currying + default params = confusion",[29,1247,1248],{},"const f = curry((a, b = 2) => a + b)"," has arity 1 (b has default). You'd need to call ",[29,1251,1252],{},"f(1)(undefined)"," to use defaults. Avoid mixing these.",[1162,1255,1256,1182,1259,1262],{},[1165,1257,1258],{},"Partial application is order-dependent",[29,1260,1261],{},"partial(fn, a, b)"," fixes args left-to-right. If your function expects args right-to-left, partial won't help. Curry is more flexible.",[1162,1264,1265,1182,1268,1271,1272,1274,1275,1278,1279,1281,1282,1285],{},[1165,1266,1267],{},"Context loss in composed functions",[29,1269,1270],{},"compose(obj.method, otherFn)"," loses ",[29,1273,651],{}," from ",[29,1276,1277],{},"obj.method",". You need to ",[29,1280,1239],{}," methods before composing: ",[29,1283,1284],{},"compose(obj.method.bind(obj), otherFn)",".",[14,1287,1289],{"id":1288},"spot-the-bug","🧠 Spot the Bug",[1162,1291,1292],{},"What does this log?",[19,1294,1295],{"language":21},[23,1296,1298],{"className":25,"code":1297,"language":21,"meta":27,"style":27},"const compose = (...fns) => x => fns.reduceRight((v, f) => f(v), x)\n\nconst add10 = x => x + 10\nconst times2 = x => x * 2\n\nconst composed = compose(add10, times2)\n\nconsole.log(composed(5))\n",[29,1299,1300,1342,1346,1366,1385,1389,1403,1407],{"__ignoreMap":27},[32,1301,1302,1304,1306,1308,1310,1312,1314,1316,1318,1320,1322,1324,1326,1328,1330,1332,1334,1336,1338,1340],{"class":34,"line":35},[32,1303,256],{"class":78},[32,1305,210],{"class":67},[32,1307,262],{"class":78},[32,1309,353],{"class":45},[32,1311,356],{"class":78},[32,1313,359],{"class":74},[32,1315,168],{"class":45},[32,1317,171],{"class":78},[32,1319,232],{"class":74},[32,1321,79],{"class":78},[32,1323,370],{"class":45},[32,1325,426],{"class":67},[32,1327,157],{"class":45},[32,1329,377],{"class":74},[32,1331,53],{"class":45},[32,1333,215],{"class":74},[32,1335,168],{"class":45},[32,1337,171],{"class":78},[32,1339,237],{"class":67},[32,1341,390],{"class":45},[32,1343,1344],{"class":34,"line":42},[32,1345,195],{"emptyLinePlaceholder":194},[32,1347,1348,1350,1353,1355,1357,1359,1361,1363],{"class":34,"line":97},[32,1349,256],{"class":78},[32,1351,1352],{"class":67}," add10",[32,1354,262],{"class":78},[32,1356,232],{"class":74},[32,1358,79],{"class":78},[32,1360,82],{"class":45},[32,1362,177],{"class":78},[32,1364,1365],{"class":49}," 10\n",[32,1367,1368,1370,1373,1375,1377,1379,1381,1383],{"class":34,"line":137},[32,1369,256],{"class":78},[32,1371,1372],{"class":67}," times2",[32,1374,262],{"class":78},[32,1376,232],{"class":74},[32,1378,79],{"class":78},[32,1380,82],{"class":45},[32,1382,85],{"class":78},[32,1384,294],{"class":49},[32,1386,1387],{"class":34,"line":191},[32,1388,195],{"emptyLinePlaceholder":194},[32,1390,1391,1393,1396,1398,1400],{"class":34,"line":198},[32,1392,256],{"class":78},[32,1394,1395],{"class":49}," composed",[32,1397,262],{"class":78},[32,1399,210],{"class":67},[32,1401,1402],{"class":45},"(add10, times2)\n",[32,1404,1405],{"class":34,"line":204},[32,1406,195],{"emptyLinePlaceholder":194},[32,1408,1409,1412,1414,1416,1419,1421,1424],{"class":34,"line":226},[32,1410,1411],{"class":45},"console.",[32,1413,870],{"class":67},[32,1415,71],{"class":45},[32,1417,1418],{"class":67},"composed",[32,1420,71],{"class":45},[32,1422,1423],{"class":49},"5",[32,1425,888],{"class":45},[1427,1428,1429,1433,1440,1470,1477],"details",{},[1430,1431,1432],"summary",{},"Answer",[1162,1434,1435,1436,1439],{},"Logs ",[29,1437,1438],{},"20",". Here's why:",[1441,1442,1443,1456],"ul",{},[1444,1445,1446,1448,1449,1452,1453],"li",{},[29,1447,1175],{}," does right-to-left: ",[29,1450,1451],{},"times2",", then ",[29,1454,1455],{},"add10",[1444,1457,1458,1461,1462,1465,1466,1469],{},[29,1459,1460],{},"composed(5)"," → ",[29,1463,1464],{},"times2(5)"," = 10 → ",[29,1467,1468],{},"add10(10)"," = 20",[1162,1471,1472,1473,1476],{},"If you wanted 40, you'd need ",[29,1474,1475],{},"compose(times2, add10)"," (right-to-left order in the compose call is the opposite of execution order).",[1162,1478,1479,1482,1483,1485],{},[1165,1480,1481],{},"The lesson",": Compose is confusing. Many prefer ",[29,1484,1171],{}," (left-to-right) for readability.",[14,1487,1489],{"id":1488},"key-takeaways","Key Takeaways",[1441,1491,1492,1495,1503,1506],{},[1444,1493,1494],{},"Higher-order functions take or return functions — the backbone of functional programming in JS.",[1444,1496,1497,1499,1500,1502],{},[29,1498,1171],{}," executes left-to-right, ",[29,1501,1175],{}," right-to-left — choose one and be consistent.",[1444,1504,1505],{},"Currying transforms multi-arg functions into single-arg chains — useful for reusable partials.",[1444,1507,1508],{},"Partial application fixes some args, leaving the rest for later — simpler than full currying.",[1510,1511,1512],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: