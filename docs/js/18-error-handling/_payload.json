 debugging.",[165,1108,1109,1093,1112,1115],{},[1090,1110,1111],{},"Stack property is lazy",[18,1113,1114],{},"new Error().stack"," is computed on first access, not construction. If you capture errors but never log them, you save performance.",[165,1117,1118,1121,1122,1125],{},[1090,1119,1120],{},"Rethrow modified errors"," — Catch, add context, rethrow: ",[18,1123,1124],{},"catch (e) { throw new Error(\\","Loading ${file} failed: ${e.message}`) }`.",[165,1127,1128,1131,1132,1135],{},[1090,1129,1130],{},"Use error types for API contracts"," — If your library throws ",[18,1133,1134],{},"ValidationError",", callers can reliably catch it across versions.",[14,1137,1139],{"id":1138},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[165,1141,1142,1145,1146,1149],{},[1090,1143,1144],{},"Errors in finally run after catch"," — If both throw, the finally error replaces the original: ",[18,1147,1148],{},"try { throw 1 } catch (e) { } finally { throw 2 }"," throws 2, not 1.",[165,1151,1152,1155,1156,1159,1160,1163],{},[1090,1153,1154],{},"Unhandled rejections crash Node.js"," — Forget ",[18,1157,1158],{},".catch()"," on a promise and Node v15+ crashes. Use ",[18,1161,1162],{},"--unhandled-rejections=warn"," to demote to warnings.",[165,1165,1166,1169,1170,1172],{},[1090,1167,1168],{},"Custom errors lose instanceof in transpiled code"," — Babel can break ",[18,1171,496],{}," for subclassed Errors. Test in your target runtime.",[165,1174,1175,1093,1178,1181,1182,1185,1186,1189],{},[1090,1176,1177],{},"toString() on Error is hidden",[18,1179,1180],{},"throw \"my error\""," is caught as a string, but ",[18,1183,1184],{},"e.toString()"," is ",[18,1187,1188],{},"\"my error\"",", not an Error object. Always throw Error objects.",[165,1191,1192,1195],{},[1090,1193,1194],{},"Error.stack format differs"," — Chrome, Node, Firefox, Safari all have slightly different stack formats. Don't parse it; only log it or send to monitoring services.",[14,1197,1199],{"id":1198},"spot-the-bug","🧠 Spot the Bug",[165,1201,1202],{},"What gets logged?",[29,1204,1205],{"language":31},[33,1206,1208],{"className":35,"code":1207,"language":31,"meta":37,"style":37},"try {\n  try {\n    throw new Error('Inner')\n  } catch (e) {\n    console.log(e.message)\n    throw new Error('Caught')\n  }\n} catch (e) {\n  console.log(e.message)\n}\n\ntry {\n  throw new Error('Test')\n} finally {\n  throw new Error('Finally')\n}\n",[18,1209,1210,1216,1222,1237,1246,1256,1271,1275,1283,1291,1295,1299,1305,1321,1329,1344],{"__ignoreMap":37},[41,1211,1212,1214],{"class":43,"line":44},[41,1213,20],{"class":47},[41,1215,51],{"class":50},[41,1217,1218,1220],{"class":43,"line":54},[41,1219,703],{"class":47},[41,1221,51],{"class":50},[41,1223,1224,1226,1228,1230,1232,1235],{"class":43,"line":80},[41,1225,578],{"class":47},[41,1227,387],{"class":47},[41,1229,192],{"class":73},[41,1231,202],{"class":50},[41,1233,1234],{"class":237},"'Inner'",[41,1236,307],{"class":50},[41,1238,1239,1241,1243],{"class":43,"line":91},[41,1240,539],{"class":50},[41,1242,24],{"class":47},[41,1244,1245],{"class":50}," (e) {\n",[41,1247,1248,1250,1253],{"class":43,"line":98},[41,1249,506],{"class":50},[41,1251,1252],{"class":73},"log",[41,1254,1255],{"class":50},"(e.message)\n",[41,1257,1258,1260,1262,1264,1266,1269],{"class":43,"line":113},[41,1259,578],{"class":47},[41,1261,387],{"class":47},[41,1263,192],{"class":73},[41,1265,202],{"class":50},[41,1267,1268],{"class":237},"'Caught'",[41,1270,307],{"class":50},[41,1272,1273],{"class":43,"line":126},[41,1274,255],{"class":50},[41,1276,1277,1279,1281],{"class":43,"line":139},[41,1278,83],{"class":50},[41,1280,24],{"class":47},[41,1282,1245],{"class":50},[41,1284,1285,1287,1289],{"class":43,"line":148},[41,1286,101],{"class":50},[41,1288,1252],{"class":73},[41,1290,1255],{"class":50},[41,1292,1293],{"class":43,"line":160},[41,1294,163],{"class":50},[41,1296,1297],{"class":43,"line":292},[41,1298,265],{"emptyLinePlaceholder":264},[41,1300,1301,1303],{"class":43,"line":3