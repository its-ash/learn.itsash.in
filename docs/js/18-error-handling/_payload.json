class":50},[14,592,594],{"id":593},"async-error-handling","Async Error Handling",[29,596,597],{"language":31},[33,598,600],{"className":35,"code":599,"language":31,"meta":37,"style":37},"\u002F\u002F Promise.catch\nfetch('\u002Fapi\u002Fdata')\n  .then(res => res.json())\n  .catch(err => console.error('Network error:', err))\n\n\u002F\u002F async\u002Fawait with try\u002Fcatch\nasync function fetchData() {\n  try {\n    const res = await fetch('\u002Fapi\u002Fdata')\n    return await res.json()\n  } catch (err) {\n    if (err instanceof TypeError) {\n      console.error('Network failure')\n    } else {\n      console.error('Other error:', err)\n    }\n    return null  \u002F\u002F graceful fallback\n  }\n}\n\n\u002F\u002F .catch on promise chain — catches any rejection above it\nfetchData()\n  .then(process)\n  .catch(err => console.error('Any error in chain:', err))\n",[18,601,602,607,619,644,670,674,679,693,700,722,736,745,760,774,783,797,802,812,816,820,824,829,836,845],{"__ignoreMap":37},[41,603,604],{"class":43,"line":44},[41,605,606],{"class":94},"\u002F\u002F Promise.catch\n",[41,608,609,612,614,617],{"class":43,"line":54},[41,610,611],{"class":73},"fetch",[41,613,198],{"class":50},[41,615,616],{"class":233},"'\u002Fapi\u002Fdata'",[41,618,303],{"class":50},[41,620,621,624,627,629,632,635,638,641],{"class":43,"line":80},[41,622,623],{"class":50},"  .",[41,625,626],{"class":73},"then",[41,628,198],{"class":50},[41,630,631],{"class":201},"res",[41,633,634],{"class":47}," =>",[41,636,637],{"class":50}," res.",[41,639,640],{"class":73},"json",[41,642,643],{"class":50},"())\n",[41,645,646,648,650,652,655,657,660,662,664,667],{"class":43,"line":91},[41,647,623],{"class":50},[41,649,24],{"class":73},[41,651,198],{"class":50},[41,653,654],{"class":201},"err",[41,656,634],{"class":47},[41,658,659],{"class":50}," console.",[41,661,104],{"class":73},[41,663,198],{"class":50},[41,665,666],{"class":233},"'Network error:'",[41,668,669],{"class":50},", err))\n",[41,671,672]