94},"\u002F\u002F ❌\n",[41,993,994,996,998,1000,1002,1004,1007,1009,1012],{"class":43,"line":288},[41,995,20],{"class":47},[41,997,971],{"class":50},[41,999,974],{"class":73},[41,1001,977],{"class":50},[41,1003,24],{"class":47},[41,1005,1006],{"class":50}," (e) { console.",[41,1008,104],{"class":73},[41,1010,1011],{"class":50},"(e) }  ",[41,1013,1014],{"class":94},"\u002F\u002F ✅\n",[41,1016,1017],{"class":43,"line":306},[41,1018,261],{"emptyLinePlaceholder":260},[41,1020,1021],{"class":43,"line":318},[41,1022,1023],{"class":94},"\u002F\u002F ✅ Use finally for cleanup\n",[41,1025,1026,1028],{"class":43,"line":331},[41,1027,20],{"class":47},[41,1029,51],{"class":50},[41,1031,1032,1034,1037,1039,1042],{"class":43,"line":336},[41,1033,57],{"class":47},[41,1035,1036],{"class":60}," conn",[41,1038,64],{"class":47},[41,1040,1041],{"class":73}," openConnection",[41,1043,735],{"class":50},[41,1045,1046],{"class":43,"line":341},[41,1047,1048],{"class":94},"  \u002F\u002F ... work\n",[41,1050,1051,1053,1055],{"class":43,"line":346},[41,1052,83],{"class":50},[41,1054,27],{"class":47},[41,1056,51],{"class":50},[41,1058,1059,1062,1065,1067],{"class":43,"line":362},[41,1060,1061],{"class":50},"  conn.",[41,1063,1064],{"class":73},"close",[41,1066,154],{"class":50},[41,1068,157],{"class":94},[41,1070,1071],{"class":43,"line":400},[41,1072,163],{"class":50},[14,1074,1076],{"id":1075},"tips-tricks","💡 Tips & Tricks",[1078,1079,1080,1084,1085,1088],"p",{},[1081,1082,1083],"strong",{},"Use custom error classes for domain errors"," — ",[18,1086,1087],{},"class DuplicateUserError extends Error {}"," is cleaner than generic errors with message strings. Callers can catch by type.",[1078,1090,1091,1084,1094,1097],{},[1081,1092,1093],{},"Error.cause for chaining",[18,1095,1096],{},"throw new Error('Database failed', { cause: originalError })"," (ES2022). Preserves the original error in stack for debugging.",[1078,1099,1100,1084,1103,1106],{},[1081,1101,1102],{},"Stack property is lazy",[18,1104,1105],{},"new Error().stack"," is computed on first access, not construction. If you capture errors but never log them, you save performance.",[1078,1108,1109,1112,1113,1116],{},[1081,1110,1111],{},"Rethrow modified errors"," — Catch, add context, rethrow: ",[18,1114,1115],{},"catch (e) { throw new Error(\\","Loading ${file} failed: ${e.message}`) }`.",[1078,1118,1119,1122,1123,1126],{},[1081,1120,1121],{},"Use error types for API contracts"," — If your library throws ",[18,1124,1125],{},"ValidationError",", callers can reliably catch it across versions.",[14,1128,1130],{"id":1129},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1078,1132,1133,1136,1137,1140],{},[1081,1134,1135],{},"Errors in finally run after catch"," — If both throw, the finally error replaces the original: ",[18,1138,1139],{},"try { throw 1 } catch (e) { } finally { throw 2 }"," throws 2, not 1.",[1078,1142,1143,1146,1147,1150,1151,1154],{},[1081,1144,1145],{},"Unhandled rejections crash Node.js"," — Forget ",[18,1148,1149],{},".catch()"," on a promise and Node v15+ crashes. Use ",[18,1152,1153],{},"--unhandled-rejections=warn"," to demote to warnings.",[1078,1156,1157,1160,1161,1163],{},[1081,1158,1159],{},"Custom errors lose instanceof in transpiled code"," — Babel can break ",[18,1162,492],{}," for subclassed Errors. Test in your target runtime.",[1078,1165,1166,1084,1169,1172,1173,1176,1177,1180],{},[1081,1167,1168],{},"toString() on Error is hidden",[18,1170,1171],{},"throw \"my error\""," is caught as a string, but ",[18,1174,1175],{},"e.toString()"," is ",[18,1178,1179],{},"\"my error\"",", not an Error object. Always throw Error objects.",[1078,1182,1183,1186],{},[1081,1184,1185],{},"Error.stack format differs"," — Chrome, Node, Firefox, Safari all have slightly different stack formats. Don't parse it; only log it or send to monitoring services.",[14,1188,1190],{"id":1189},"spot-the-bug","🧠 Spot the Bug",[1078,1192,1193],{},"What gets logged?",[33,1195,1197],{"className":35,"code":1196,"language":31,"meta":37,"style":37},"try {\n  try {\n    throw new Error('Inner')\n  } catch (e) {\n    console.log(e.message)\n    throw new Error('Caught')\n  }\n} catch (e) {\n  console.log(e.message)\n}\n\ntry {\n  throw new Error('Test')\n} finally {\n  throw new Error('Finally')\n}\n",[18,1198,1199,1205,1211,1226,1235,1245,1260,1264,1272,1280,1284,1288,1294,1310,1318,1333],{"__ignoreMap":37},[41,1200,1201,1203],{"class":43,"line":44},[41,1202,20],{"class":47},[41,1204,51],{"class":50},[41,1206,1207,1209],{"class":43,"line":54},[41,1208,697],{"class":47},[41,1210,51],{"class":50},[41,1212,1213,1215,1217,1219,1221,1224],{"class":43,"line":80},[41,1214,574],{"class":47},[41,1216,383],{"class":47},[41,1218,188],{"class":73},[41,1220,198],{"class":50},[41,1222,1223],{"class":233},"'Inner'",[41,1225,303],{"class":50},[41,1227,1228,1230,1232],{"class":43,"line":91},[41,1229,535],{"class":50},[41,1231,24],{"class":47},[41,1233,1234],{"class":50}," (e) {\n",[41,1236,1237,1239,1242],{"class":43,"line":98},[41,1238,502],{"class":50},[41,1240,1241],{"class":73},"log",[41,1243,1244],{"class":50},"(e.message)\n",[41,1246,1247,1249,1251,1253,1255,1258],{"class":43,"line":113},[41,1248,574],{"class":47},[41,1250,383],{"class":47},[41,1252,188],{"class":73},[41,1254,198],{"class":50},[41,1256,1257],{"class":233},"'Caught'",[41,1259,303],{"class":50},[41,1261,1262],{"class":43,"line":126},[41,1263,251],{"class":50},[41,1265,1266,1268,1270],{"class":43,"line":139},[41,1267,83],{"class":50},[41,1269,24],{"class":47},[41,1271,1234],{"class":50},[41,1273,1274,1276,1278],{"class":43,"line":148},[41,1275,101],{"class":50},[41,1277,1241],{"class":73},[41,1279,1244],{"class":50},[41,1281,1282],{"class":43,"line":160},[41,1283,163],{"class":50},[41,1285,1286],{"class":43,"line":288},[41,1287,261],{"emptyLinePlaceholder":260},[41,1289,1290,1292],{"class":43,"line":306},[41,1291,20],{"class":47},[41,1293,51],{"class":50},[41,1295,1296,1299,1301,1303,1305,1308],{"class":43,"line":318},[41,1297,1298],{"class":47},"  throw",[41,1300,383],{"class":47},[41,1302,188],{"class":73},[41,1304,198],{"class":50},[41,1306,1307],{"class":233},"'Test'",[41,1309,303],{"class":50},[41,1311,1312,1314,1316],{"class":43,"line":331},[41,1313,83],{"class":50},[41,1315,27],{"class":47},[41,1317,51],{"class":50},[41,1319,1320,1322,1324,1326,1328,1331],{"class":43,"line":336},[41,1321,1298],{"class":47},[41,1323,383],{"class":47},[41,1325,188],{"class":73},[41,1327,198],{"class":50},[41,1329,1330],{"class":233},"'Finally'",[41,1332,303],{"class":50},[41,1334,1335],{"class":43,"line":341},[41,1336,163],{"class":50},[1338,1339,1340,1344,1347],"details",{},[1341,1342,1343],"summary",{},"Answer",[1078,1345,1346],{},"First logs \"Inner\" then \"Caught\". Second throws \"Finally\" (the finally error replaces the original).",[1078,1348,1349,1352],{},[1081,1350,1351],{},"The lesson",": Re-thrown errors replace the original. Errors in finally override the result entirely.",[14,1354,1356],{"id":1355},"key-takeaways","Key Takeaways",[1358,1359,1360,1376,1382,1388,1391],"ul",{},[1361,1362,1363,1366,1367,205,1370,205,1372,1375],"li",{},[18,1364,1365],{},"Error"," has ",[18,1368,1369],{},"name",[18,1371,208],{},[18,1373,1374],{},"stack"," — subclass for custom error types.",[1361,1377,1378,1379,1381],{},"Use ",[18,1380,492],{}," to catch specific error types — re-throw unknowns.",[1361,1383,1384,1385,1387],{},"Throw ",[18,1386,1365],{}," objects, not strings — preserves stack traces.",[1361,1389,1390],{},"Never swallow errors silently — at minimum log them.",[1361,1392,1378,1393,1395],{},[18,1394,27],{}," for resource cleanup — runs regardless of success\u002Ffailure.",[1397,1398,1399],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-g