1,702],{"class":53}," CustomEvent",[32,704,57],{"class":49},[32,706,707],{"class":60},"'userLogin'",[32,709,710],{"class":49},", {\n",[32,712,713,716,719,722,725],{"class":34,"line":74},[32,714,715],{"class":49},"  detail: { userId: ",[32,717,718],{"class":42},"123",[32,720,721],{"class":49},", name: ",[32,723,724],{"class":60},"'Alice'",[32,726,727],{"class":49}," },\n",[32,729,730,733],{"class":34,"line":81},[32,731,732],{"class":49},"  bubbles: ",[32,734,735],{"class":42},"true\n",[32,737,738],{"class":34,"line":111},[32,739,142],{"class":49},[32,741,742,745,748],{"class":34,"line":126},[32,743,744],{"class":49},"document.",[32,746,747],{"class":53},"dispatchEvent",[32,749,750],{"class":49},"(event)\n",[32,752,753],{"class":34,"line":139},[32,754,71],{"emptyLinePlaceholder":70},[32,756,757],{"class":34,"line":145},[32,758,759],{"class":77},"\u002F\u002F Listen\n",[32,761,762,764,766,768,770,772,774,776,778],{"class":34,"line":150},[32,763,744],{"class":49},[32,765,87],{"class":53},[32,767,57],{"class":49},[32,769,707],{"class":60},[32,771,95],{"class":49},[32,773,314],{"class":98},[32,775,102],{"class":49},[32,777,105],{"class":38},[32,779,108],{"class":49},[32,781,782,784,786,788,791],{"class":34,"line":156},[32,783,114],{"class":49},[32,785,117],{"class":53},[32,787,57],{"class":49},[32,789,790],{"class":60},"'User logged in:'",[32,792,793],{"class":49},", e.detail.name)\n",[32,795,796],{"class":34,"line":179},[32,797,142],{"class":49},[14,799,801],{"id":800},"tips-tricks","💡 Tips & Tricks",[803,804,805,812,813,816,817,819],"p",{},[806,807,808,811],"strong",{},[29,809,810],{},"{ once: true }"," replaces manual removeEventListener"," — ",[29,814,815],{},"el.addEventListener('click', handler, { once: true })"," auto-detaches after firing once — no need to save a reference just to call ",[29,818,237],{}," inside the handler.",[803,821,822,828,829,832],{},[806,823,824,827],{},[29,825,826],{},"{ passive: true }"," speeds up scroll\u002Ftouch listeners"," — Telling the browser upfront that you won't call ",[29,830,831],{},"preventDefault()"," lets it start scrolling immediately instead of waiting for your handler to finish — a real, measurable win on touch devices.",[803,834,835,838,839,842,843,845,846,849],{},[806,836,837],{},"AbortController cancels multiple listeners at once"," — Pass the same ",[29,840,841],{},"{ signal }"," to several ",[29,844,87],{}," calls, then call ",[29,847,848],{},"controller.abort()"," once to remove all of them — cleaner than tracking each handler reference for cleanup.",[803,851,852,858,859,862],{},[806,853,854,855],{},"Debug listeners with ",[29,856,857],{},"getEventListeners()"," — In Chrome DevTools console, ",[29,860,861],{},"getEventListeners(el)"," lists every listener attached to an element, grouped by event type — invaluable when you don't know what's already wired up.",[803,864,865,812,868,871],{},[806,866,867],{},"Dispatch synthetic events for testing",[29,869,870],{},"el.dispatchEvent(new MouseEvent('click', { bubbles: true }))"," triggers real listener logic in tests without simulating actual user input.",[14,873,875],{"id":874},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[803,877,878,812,883,886,887,890],{},[806,879,880,882],{},[29,881,237],{}," needs the exact same function reference",[29,884,885],{},"button.addEventListener('click', () => foo())"," followed by ",[29,888,889],{},"button.removeEventListener('click', () => foo())"," does nothing — the second arrow function is a different object in memory, even though it looks identical.",[803,892,893,902,903,905],{},[806,894,895,898,899,901],{},[29,896,897],{},"stopPropagation()"," does not stop ",[29,900,831],{},", and vice versa"," — They control unrelated things: propagation (whether the event continues to bubble\u002Fcapture) and default browser behavior (like following a link or submitting a form). Stopping one doesn't stop the other; a common bug is calling only ",[29,904,897],{}," and being surprised a form still submits.",[803,907,908,913,914,917,918,920],{},[806,909,910,911],{},"Passive listeners silently ignore ",[29,912,831],{}," — Calling ",[29,915,916],{},"e.preventDefault()"," inside a listener registered with ",[29,919,826],{}," does nothing and, in most browsers, logs a console warning instead of throwing — scrolling continues even though your code \"cancelled\" it.",[803,922,923,929,930,933],{},[806,924,925,926,928],{},"Event delegation breaks with ",[29,927,897],{}," on children"," — If a child element calls ",[29,931,932],{},"e.stopPropagation()",", a delegated listener on an ancestor never fires, because the event never bubbles that far — a subtle bug when combining delegation with third-party widgets that stop propagation internally.",[803,935,936,812,942,945,946,948,949,952,953,956,957,959,960,963],{},[806,937,938,941],{},[29,939,940],{},"this"," inside an arrow-function listener is not the element",[29,943,944],{},"button.addEventListener('click', () => console.log(this))"," logs the enclosing scope's ",[29,947,940],{}," (often ",[29,950,951],{},"undefined"," or the module), not the button — unlike a regular ",[29,954,955],{},"function"," listener, where ",[29,958,940],{}," is ",[29,961,962],{},"event.currentTarget",".",[14,965,967],{"id":966},"spot-the-bug","🧠 Spot the Bug",[803,969,970],{},"What gets logged when the button is clicked?",[19,972,973],{"language":21},[23,974,976],{"className":25,"code":975,"language":21,"meta":27,"style":27},"const outer = document.querySelector('#outer')\nconst inner = document.querySelector('#inner')\n\nouter.addEventListener('click', () => console.log('outer handler'))\n\ninner.addEventListener('click', (e) => {\n  console.log('inner handler')\n  e.stopPropagation()\n})\n\ninner.addEventListener('click', (e) => {\n  e.preventDefault()\n  console.log('inner handler 2 — did preventDefault stop this from running?')\n})\n",[29,977,978,998,1018,1022,1051,1055,1076,1089,1097,1101,1105,1125,1134,1147],{"__ignoreMap":27},[32,979,980,982,985