29,834,835],{},"{ passive: true }"," speeds up scroll\u002Ftouch listeners"," — Telling the browser upfront that you won't call ",[29,839,840],{},"preventDefault()"," lets it start scrolling immediately instead of waiting for your handler to finish — a real, measurable win on touch devices.",[249,843,844,847,848,851,852,854,855,858],{},[815,845,846],{},"AbortController cancels multiple listeners at once"," — Pass the same ",[29,849,850],{},"{ signal }"," to several ",[29,853,87],{}," calls, then call ",[29,856,857],{},"controller.abort()"," once to remove all of them — cleaner than tracking each handler reference for cleanup.",[249,860,861,867,868,871],{},[815,862,863,864],{},"Debug listeners with ",[29,865,866],{},"getEventListeners()"," — In Chrome DevTools console, ",[29,869,870],{},"getEventListeners(el)"," lists every listener attached to an element, grouped by event type — invaluable when you don't know what's already wired up.",[249,873,874,821,877,880],{},[815,875,876],{},"Dispatch synthetic events for testing",[29,878,879],{},"el.dispatchEvent(new MouseEvent('click', { bubbles: true }))"," triggers real listener logic in tests without simulating actual user input.",[14,882,884],{"id":883},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[249,886,887,821,892,895,896,899],{},[815,888,889,891],{},[29,890,237],{}," needs the exact same function reference",[29,893,894],{},"button.addEventListener('click', () => foo())"," followed by ",[29,897,898],{},"button.removeEventListener('click', () => foo())"," does nothing — the second arrow function is a different object in memory, even though it looks identical.",[249,901,902,911,912,914],{},[815,903,904,907,908,910],{},[29,905,906],{},"stopPropagation()"," does not stop ",[29,909,840],{},", and vice versa"," — They control unrelated things: propagation (whether the event continues to bubble\u002Fcapture) and default browser behavior (like following a link or submitting a form). Stopping one doesn't stop the other; a common bug is calling only ",[29,913,906],{}," and being surprised a form still submits.",[249,916,917,922,923,926,927,929],{},[815,918,919,920],{},"Passive listeners silently ignore ",[29,921,840],{}," — Calling ",[29,924,925],{},"e.preventDefault()"," inside a listener registered with ",[29,928,835],{}," does nothing and, in most browsers, logs a console warning instead of throwing — scrolling continues even though your code \"cancelled\" it.",[249,931,932,938,939,942],{},[815,933,934,935,937],{},"Event delegation breaks with ",[29,936,906],{}," on children"," — If a child element calls ",[29,940,941],{},"e.stopPropagation()",", a delegated listener on an ancestor never fires, because the event never bubbles that far — a subtle bug when combining delegation with third-party widgets that stop propagation internally.",[249,944,945,821,951,954,955,957,958,961,962,965,966,968,969,972],{},[815,946,947,950],{},[29,948,949],{},"this"," inside an arrow-function listener is not the element",[29,952,953],{},"button.addEventListener('click', () => console.log(this))"," logs the enclosing scope's ",[29,956,949],{}," (often ",[29,959,960],{},"undefined"," or the module), not the button — unlike a regular ",[29,963,964],{},"function"," listener, where ",[29,967,949],{}," is ",[29,970,971],{},"event.currentTarget",".",[14,974,976],{"id":975},"spot-the-bug","🧠 Spot the Bug",[249,978,979],{},"What gets logged when the button is clicked?",[19,981,982],{"language":21},[23,983,985],{"className":25,"code":984,"language":21,"meta":27,"style":27},"const outer = document.querySelector('#outer')\nconst inner = document.querySelector('#inner')\n\nouter.addEventListener('click', () => console.log('outer handler'))\n\ninner.addEventListener('click', (e) => {\n  console.log('inner handler')\n  e.stopPropagation()\n})\n\ninner.addEventListener('click', (e) => {\n  e.preventDefault()\n  console.log('inner handler 2 — did preventDefault stop this from running?')\n})\n",[29,986,987,1007,1027,1031