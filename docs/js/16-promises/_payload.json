), 5000))])"," adds timeout.",[19,1047,1048,1051,1052,1055],{},[29,1049,1050],{},"Promise chains are hard to debug"," — Stack traces break at each ",[40,1053,1054],{},".then()",". Use async\u002Fawait for better error stacks in production.",[14,1057,1059],{"id":1058},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[19,1061,1062,1070,1071,1073],{},[29,1063,1064,1066,1067,1069],{},[40,1065,1054],{}," without ",[40,1068,1003],{}," swallows errors"," — If a promise rejects and there's no ",[40,1072,1003],{},", the error is silently lost (until Node 15+, which warns about unhandled rejections).",[19,1075,1076,1082,1083,1086,1087,1089,1090,1093,1094,1096,1097,1099],{},[29,1077,1078,1079,1081],{},"Returning values from ",[40,1080,1054],{}," matters"," — Forgetting ",[40,1084,1085],{},"return"," in a ",[40,1088,1054],{}," handler returns ",[40,1091,1092],{},"undefined",". The next ",[40,1095,1054],{}," gets ",[40,1098,1092],{},", not the value you computed. This is a classic gotcha.",[19,1101,1102,1108],{},[29,1103,1104,1107],{},[40,1105,1106],{},"Promise.all([])"," resolves immediately"," — Empty array resolves to empty array instantly. Not a bug, but can be surprising in edge cases.",[19,1110,1111,1118,1119,1121,1122,1124],{},[29,1112,1113,1114,1117],{},"Rejections in ",[40,1115,1116],{},".finally()"," override original result"," — If ",[40,1120,1116],{}," throws or rejects, it replaces the original rejection\u002Fvalue. Use ",[40,1123,273],{}," only for cleanup that doesn't throw.",[19,1126,1127,1041,1132,1135,1136,1138],{},[29,1128,1129,1131],{},[40,1130,1031],{}," executor runs synchronously",[40,1133,1134],{},"new Promise((resolve, reject) => { console.log(1); resolve(2); })"," logs 1 immediately, not when you call ",[40,1137,1054],{},". This confuses beginners.",[19,1140,1141,1041,1144,1147],{},[29,1142,1143],{},"Promise chains don't await nested promises",[40,1145,1146],{},"Promise.resolve(Promise.resolve(5)).then(x => console.log(x))"," logs 5, not a Promise. Promises auto-unwrap. But mixing is confusing.",[14,1149,1151],{"id":1150},"spot-the-bug","🧠 Spot the Bug",[19,1153,1154],{},"What does this log?",[54,1156,1157],{"language":56},[58,1158,1160],{"className":60,"code":1159,"language":56,"meta":62,"style":62},"Promise.resolve(1)\n  .then(x => x + 1)\n  .then(x => { x + 2 })  \u002F\u002F BUG: no return\n  .then(x => console.log(x))\n\nPromise.resolve(1)\n  .then(x => x + 1)\n  .then(x => x + 2)\n  .then(x => console.log(x))\n",[40,1161,1162,1177,1198,1223,1242,1246,1260,1280,1300],{"__ignoreMap":62},[66,1163,1164,1166,1168,1170,1172,1175],{"class":68,"line":69},[66,1165,467],{"class":76},[66,1167,367],{"class":89},[66,1169,94],{"class":138},[66,1171,142],{"class":89},[66,1173,1174],{"class":76},"1",[66,1176,319],{"class":89},[66,1178,1179,1181,1183,1185,1187,1189,1191,1193,1196],{"class":68,"line":112},[66,1180,220],{"class":89},[66,1182,223],{"class":138},[66,1184,142],{"class":89},[66,1186,489],{"class":93},[66,1188,231],{"class":72},[66,1190,494],{"class":89},[66,1192,497],{"class":72},[66,1194,1195],{"class":76}," 1",[66,1197,319],{"class":89},[66,1199,1200,1202,1204,1206,1208,1210,1213,1215,1217,1220],{"class":68,"line":126},[66,1201,220],{"class":89},[66,1203,223],{"class":138},[66,1205,142],{"class":89},[66,1207,489],{"class":93},[66,1209,231],{"class":72},[66,1211,1212],{"class":89}," { x ",[66,1214,497],{"class":72},[66,1216,526],{"class":76},[66,1218,1219],{"class":89}," })  ",[66,1221,1222],{"class":152},"\u002F\u002F BUG: no return\n",[66,1224,1225,1227,1229,1231,1233,1235,1237,1239],{"class":68,"line":135},[66,1226,220],{"class":89},[66,1228,223],{"class":138},[66,1230,142],{"class":89},[66,1232,489],{"class":93},[66,1234,231],{"class":72},[66,1236,234],{"class":89},[66,1238,237],{"class":138},[66,1240,1241],{"class":89},"(x))\n",[66,1243,1244],{"class":68,"line":156},[66,1245,208],{"emptyLinePlaceholder":207},[66,1247,1248,1250,1252,1254,1256,1258],{"class":68,"line":167},[66,1249,467],{"class":76},[66,1251,3