[29,941,942],{},"User"," interface instead of hand-writing a new one that can drift out of sync.",[875,945,946,952,953,956],{},[878,947,948,951],{},[29,949,950],{},"\u002F\u002F @ts-expect-error"," documents intentional type errors"," — Unlike ",[29,954,955],{},"\u002F\u002F @ts-ignore",", it fails the build if the next line stops being an error (e.g. after a dependency fixes its types) — self-cleaning technical debt markers.",[14,958,960],{"id":959},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[875,962,963,884,969,972,973,975,976,978],{},[878,964,965,968],{},[29,966,967],{},"any"," disables checking for everything it touches, including downstream",[29,970,971],{},"function process(data: any) { return data.name.toUpperCase() }"," compiles fine even if ",[29,974,306],{}," is a number at runtime — ",[29,977,967],{}," isn't just \"unknown type,\" it's \"please stop type-checking this value and anything derived from it,\" which can silently swallow real bugs.",[875,980,981,884,984,987,988,991,992,995,996,999],{},[878,982,983],{},"Structural typing means unrelated types can satisfy an interface by accident",[29,985,986],{},"interface Point { x: number; y: number }"," is satisfied by any object with those two properties, even a ",[29,989,990],{},"{ x: 1, y: 2, z: 3 }"," from a completely different domain — TypeScript checks shape, not name or intent, which is powerful but can let a ",[29,993,994],{},"Vector3"," slip in where a ",[29,997,998],{},"Point"," was expected.",[875,1001,1002,884,1013,1016,1017,1020,1021,1023,1024,1027],{},[878,1003,1004,1005,1008,1009,1012],{},"Optional properties (",[29,1006,1007],{},"email?",") and ",[29,1010,1011],{},"undefined","-typed properties are not the same",[29,1014,1015],{},"interface User { email?: string }"," allows omitting the key entirely, while ",[29,1018,1019],{},"{ email: string | undefined }"," requires the key to be present (even if its value is ",[29,1022,1011],{},") — ",[29,1025,1026],{},"'email' in user"," behaves differently between the two.",[875,1029,1030,884,1033,1036,1037,1039,1040,1042,1043,1045,1046,1048,1049,1052],{},[878,1031,1032],{},"Type narrowing can be invalidated by later mutation",[29,1034,1035],{},"if (typeof value === 'string') { setTimeout(() => value.toUpperCase(), 100) }"," — TypeScript narrows ",[29,1038,445],{}," to ",[29,1041,153],{}," inside the ",[29,1044,748],{},", but if ",[29,1047,445],{}," is a ",[29,1050,1051],{},"let"," captured by a closure and reassigned before the timeout fires, the narrowing was only ever a compile-time guarantee for that instant, not a runtime one.",[875,1054,1055,1063,1064,1067],{},[878,1056,1057,1059,1060,1062],{},[29,1058,194],{}," declarations merge; ",[29,1061,278],{}," aliases don't"," — Declaring ",[29,1065,1066],{},"interface User { id: number }"," twice in the same scope silently merges both into one combined interface — useful for augmenting library types, but a genuine bug source if it happens by accident (e.g. a typo'd re-declaration you expected to be an error).",[14,1069,1071],{"id":1070},"spot-the-bug","🧠 Spot the Bug",[875,1073,1074],{},"Does this compile, and does it behave the way it looks like it should?",[19,1076,1077],{"language":21},[23,1078,1080],{"className":25,"code":1079,"language":21,"meta":27,"style":27},"interface Shape { area(): number }\ninterface Circle { area(): number; radius: number }\n\nfunction describe(shape: Shape) {\n  console.log('Area:', shape.area())\n}\n\nconst notReallyACircle = { area: () => 10, radius: 'wide' }\ndescribe(notReallyACircle)\n\nconst circle: Circle = { area: () => 10, radius: 5 }\ndescribe(circle)\n",[29,1081,1082,1102,1130,1134,1152,1173,1177,1181,1210,1218,1222,1252],{"__ignoreMap":27},[32,1083,1084,1086,1089,1091,1094,1096,1098,1100],{"class":34,"line":35},[32,1085,194],{"class":45},[32,1087,1088],{"class":197}," Shape",[32,1090,343],{"class":114},[32,1092,1093],{"class":197},"area",[32,1095,784],{"class":114},[32,1097,53],{"class":45},[32,1099,76],{"class":49},[