233,1235,1237,1239,1241,1243,1245,1247,1250],{"class":34,"line":216},[32,1225,46],{"class":45},[32,1227,1228],{"class":49}," circle",[32,1230,53],{"class":45},[32,1232,1108],{"class":197},[32,1234,59],{"class":45},[32,1236,343],{"class":114},[32,1238,1093],{"class":197},[32,1240,1196],{"class":114},[32,1242,316],{"class":45},[32,1244,1201],{"class":49},[32,1246,1204],{"class":114},[32,1248,1249],{"class":49},"5",[32,1251,387],{"class":114},[32,1253,1254,1256],{"class":34,"line":227},[32,1255,1214],{"class":197},[32,1257,1258],{"class":114},"(circle)\n",[1260,1261,1262,1266,1303],"details",{},[1263,1264,1265],"summary",{},"Answer",[875,1267,1268,1269,1048,1272,1274,1275,1277,1278,1281,1282,1285,1286,884,1289,1291,1292,1295,1296,1299,1300,1302],{},"Both calls compile and run without error, even though ",[29,1270,1271],{},"notReallyACircle.radius",[29,1273,153],{},", not a ",[29,1276,158],{},", and the object was never declared as implementing ",[29,1279,1280],{},"Circle"," or ",[29,1283,1284],{},"Shape",". TypeScript uses ",[878,1287,1288],{},"structural typing",[29,1290,1214],{}," only requires an ",[29,1293,1294],{},"area(): number"," method, and ",[29,1297,1298],{},"notReallyACircle"," happens to have one, so it satisfies ",[29,1301,1284],{}," regardless of its other mismatched properties or lack of explicit type annotation.",[875,1304,1305,1308],{},[878,1306,1307],{},"The lesson",": TypeScript checks \"does this shape fit,\" not \"was this declared as that type\" — objects can accidentally satisfy an interface they were never intended to implement, so don't rely on a parameter type alone to guarantee semantic correctness.",[14,1310,1312],{"id":1311},"key-takeaways","Key Takeaways",[1314,1315,1316,1320,1328,1331],"ul",{},[1317,1318,1319],"li",{},"TypeScript adds static types to JavaScript — catches errors at compile time.",[1317,1321,925,1322,1324,1325,1327],{},[29,1323,194],{}," for object shapes, ",[29,1326,278],{}," for unions\u002Fintersections\u002Faliases.",[