tionally update just these two fields\" directly from an existing ",[29,948,949],{},"User"," interface instead of hand-writing a new one that can drift out of sync.",[416,952,953,959,960,963],{},[885,954,955,958],{},[29,956,957],{},"\u002F\u002F @ts-expect-error"," documents intentional type errors"," — Unlike ",[29,961,962],{},"\u002F\u002F @ts-ignore",", it fails the build if the next line stops being an error (e.g. after a dependency fixes its types) — self-cleaning technical debt markers.",[14,965,967],{"id":966},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[416,969,970,891,976,979,980,982,983,985],{},[885,971,972,975],{},[29,973,974],{},"any"," disables checking for everything it touches, including downstream",[29,977,978],{},"function process(data: any) { return data.name.toUpperCase() }"," compiles fine even if ",[29,981,306],{}," is a number at runtime — ",[29,984,974],{}," isn't just \"unknown type,\" it's \"please stop type-checking this value and anything derived from it,\" which can silently swallow real bugs.",[416,987,988,891,991,994,995,998,999,1002,1003,1006],{},[885,989,990],{},"Structural typing means unrelated types can satisfy an interface by accident",[29,992,993],{},"interface Point { x: number; y: number }"," is satisfied by any object with those two properties, even a ",[29,996,997],{},"{ x: 1, y: 2, z: 3 }"," from a completely different domain — TypeScript checks shape, not name or intent, which is powerful but can let a ",[29,1000,1001],{},"Vector3"," slip in where a ",[29,1004,1005],{},"Point"," was expected.",[416,1008,1009,891,1020,1023,1024,1027,1028,1030,1031,1034],{},[885,1010,1011,1012,1015,1016,1019],{},"Optional properties (",[29,1013,1014],{},"email?",") and ",[29,1017,1018],{},"undefined","-typed properties are not the same",[29,1021,1022],{},"interface User { email?: string }"," allows omitting the key entirely, while ",[29,1025,1026],{},"{ email: string | undefined }"," requires the key to be present (even if its value is ",[29,1029,1018],{},") — ",[29,1032,1033],{},"'email' in user"," behaves differently between the two.",[416,1036,1037,891,1040,1043,1044,1046,1047,1049,1050,1052,1053,1055,1056,1059],{},[885,1038,1039],{},"Type narrowing can be invalidated by later mutation",[29,1041,1042],{},"if (typeof value === 'string') { setTimeout(() => value.toUpperCase(), 100) }"," — TypeScript narrows ",[29,1045,449],{}," to ",[29,1048,153],{}," inside the ",[29,1051,754],{},", but if ",[29,1054,449],{}," is a ",[29,1057,1058],{},"let"," captured by a closure and reassigned before the timeout fires, the narrowing was only ever a compile-time guarantee for that instant, not a runtime one.",[416,1061,1062,1070,1071,1074],{},[885,1063,1064,1066,1067,1069],{},[29,1065,194],{}," declarations merge; ",[29,1068,278],{}," aliases don't"," — Declaring ",[29,1072,1073],{},"interface User { id: number }"," twice in the same scope silently merges both into one combined interface — useful for augmenting library types, but a genuine bug source if it happens by accident (e.g. a typo'd re-declaration you expected to be an error).",[14,1076,1078],{"id":1077},"spot-the-bug","🧠 Spot the Bug",[416,1080,1081],{},"Does this compile, and does it behave the way it looks like it should?",[19,1083,1084],{"language":21},[23,1085,1087],{"className":25,"code":1086,"language":21,"meta":27,"style":27},"interface Shape { area(): number }\ninterface Circle { area(): number; radius: number }\n\nfunction describe(shape: Shape) {\n  console.log('Area:', shape.area())\n}\n\nconst notReallyACircle = { area: () => 10, radius: 'wide' }\ndescribe(notReallyACircle)\n\nconst circle: Circle = { area: () => 10, radius: 5 }\ndescribe(circle)\n",[29,1088,1089,1109,1137,1141,1159,1180,1184,1188,1217,1225,1229,1259],{"__ignoreMap":27},[32,1090,1091,1093,1096,1098,1101,1103,1105,1107],{"class":34,"line":35},[32,1092,194],{"class":45},[32,1094,1095],{"class":197}," Shape",[32,1097,343],{"class":114},[32,1099,1100],{"class":197},"area",[32,11