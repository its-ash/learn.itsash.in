ling",[102,512,513,523],{},[105,514,515],{},[108,516,517,519,521],{},[111,518,113],{},[111,520,116],{},[111,522,119],{},[121,524,525,546,560,586],{},[108,526,527,530,536],{},[126,528,529],{},"17",[126,531,532],{},[132,533,535],{"href":534},"\u002Fvue\u002F17-typescript-with-vue","TypeScript with Vue",[126,537,538,539,69,542,545],{},"Typing ",[66,540,541],{},"defineProps",[66,543,544],{},"defineEmits",", typed composables, generic components.",[108,547,548,551,557],{},[126,549,550],{},"18",[126,552,553],{},[132,554,556],{"href":555},"\u002Fvue\u002F18-testing","Testing",[126,558,559],{},"Vitest + Vue Test Utils, mocking composables, testing Pinia stores.",[108,561,562,565,571],{},[126,563,564],{},"19",[126,566,567],{},[132,568,570],{"href":569},"\u002Fvue\u002F19-performance-optimization","Performance Optimization",[126,572,573,69,576,160,579,69,582,585],{},[66,574,575],{},"v-once",[66,577,578],{},"v-memo",[66,580,581],{},"shallowRef",[66,583,584],{},"shallowReactive",", lazy loading, virtual scrolling.",[108,587,588,591,597],{},[126,589,590],{},"20",[126,592,593],{},[132,594,596],{"href":595},"\u002Fvue\u002F20-ssr-and-nuxt-basics","SSR & Nuxt Basics",[126,598,599],{},"What SSR solves, hydration, a Nuxt primer, universal vs client-only code.",[97,601,603],{"id":602},"part-vi-production-engineering","Part VI — Production Engineering",[102,605,606,616],{},[105,607,608],{},[108,609,610,612,614],{},[111,611,113],{},[111,613,116],{},[111,615,119],{},[121,617,618,632,650,664],{},[108,619,620,623,629],{},[126,621,622],{},"21",[126,624,625],{},[132,626,628],{"href":627},"\u002Fvue\u002F21-build-tooling-and-vite","Build Tooling & Vite",[126,630,631],{},"Vite config, env variables, code splitting, build optimization.",[108,633,634,637,643],{},[126,635,636],{},"22",[126,638,639],{},[132,640,642],{"href":641},"\u002Fvue\u002F22-security","Security",[126,644,645,646,649],{},"XSS via ",[66,647,648],{},"v-html",", CSP, sanitizing user content, dependency security.",[108,651,652,655,661],{},[126,653,654],{},"23",[126,656,657],{},[132,658,660],{"href":659},"\u002Fvue\u002F23-design-patterns","Design Patterns",[126,662,663],{},"Composable best practices, container\u002Fpresentational split, renderless components revisited.",[108,665,666,669,675],{},[126,667,668],{},"24",[126,670,671],{},[132,672,674],{"href":673},"\u002Fvue\u002F24-exercises-and-projects","Exercises & Projects",[126,676,677],{},"Capstone project ideas, beginner to advanced.",[19,679,681],{"id":680},"learning-path-suggestions","Learning Path Suggestions",[97,683,685],{"id":684},"if-youre-new-to-frontend-development","If you're new to frontend development",[24,687,688,691,694,697,700],{},[27,689,690],{},"Read 01–05 slowly — don't rush reactivity, it's the concept everything else builds on.",[27,692,693],{},"Build a tiny todo app after chapter 09, using only what you've learned so far.",[27,695,696],{},"Read 10–12, then add persistence and routing to your todo app.",[27,698,699],{},"Skim 13–16, then return to them once you hit a wall that needs a scoped slot or a Teleport.",[27,701,702],{},"Finish with 17–24 at a relaxed pace.",[97,704,706],{"id":705},"if-youre-coming-from-react","If you're coming from React",[15,708,709,710,712,713,716],{},"Vue's reactivity model (chapter 03) replaces React's re-render-on-state-change model — there's no dependency array to forget, but there is a destructuring trap that plays a similar role to \"stale closure\" bugs. Read 03–04 closely. ",[66,711,179],{}," (chapter 02, 09) and slots (chapter 13) do the job of controlled inputs and ",[66,714,715],{},"children","\u002Frender props, respectively, with different ergonomics. Skim 01–02, focus on 03, 06, 07, 13, 16, then read the rest in order.",[97,718,720],{"id":719},"if-youre-coming-from-vue-2-the-options-api","If you're coming from Vue 2 \u002F the Options API",[15,722,723,724,727,728,731],{},"Read 01 for the Vue 2 vs Vue 3 differences table, then jump straight to 03 and 07 — reactivity internals changed (",[66,725,726],{},"Object.defineProperty"," → ",[66,729,730],{},"Proxy",") and the Composition API is the new default organizing principle. Every chapter that introduces a concept shows the Options API equivalent alongside the Composition API version, so you can map what you already know. Pay close attention to chapter 08 (lifecycle hook renaming) and chapter 17 (TypeScript support is dramatically better in Vue 3).",[97,733,735],{"id":734},"if-youre-building-with-nuxt","If you're building with Nuxt",[15,737,738,739,742],{},"This documentation site is itself built with Nuxt Content, so treat chapter 20 as required reading, not optional. Read 01–12 in order first — Nuxt is Vue underneath, and skipping the fundamentals to jump straight to Nuxt conventions leads to cargo-culting ",[66,740,741],{},"useFetch"," without understanding what problem it solves. Then read 20 closely, followed by 11 (Nuxt's file-based routing builds on Vue Router concepts) and 21 (Nuxt's build is Vite underneath).",[19,744,746],{"id":745},"companion-resources","Companion Resources",[57,748,749,758,766,774,782,790,798],{},[27,750,751,757],{},[132,752,756],{"href":753,"rel":754},"https:\u002F\u002Fvuejs.org\u002F",[755],"nofollow","Vue.js Official Docs"," — the best-maintained framework docs on the web; has an interactive tutorial and playground.",[27,759,760,765],{},[132,761,764],{"href":762,"rel":763},"https:\u002F\u002Fvueschool.io\u002F",[755],"Vue School"," — structured video courses from core team members and community experts.",[27,767,768,773],{},[132,769,772],{"href":770,"rel":771},"https:\u002F\u002Fpinia.vuejs.org\u002F",[755],"Pinia Docs"," — official state management library docs.",[27,775,776,781],{},[132,777,780],{"href":778,"rel":779},"https:\u002F\u002Frouter.vuejs.org\u002F",[755],"Vue Router Docs"," — official routing library docs.",[27,783,784,789],{},[132,785,788],{"href":786,"rel":787},"https:\u002F\u002Fvitejs.dev\u002F",[755],"Vite Docs"," — the build tool powering modern Vue projects.",[27,791,792,797],{},[132,793,796],{"href":794,"rel":795},"https:\u002F\u002Fnuxt.com\u002F",[755],"Nuxt Docs"," — the full-stack Vue framework referenced in chapter 20.",[27,799,800,805],{},[132,801,804],{"href":802,"rel":803},"https:\u002F\u002Fwww.vuemastery.com\u002F",[755],"Vue Mastery"," — another strong video course platform.",[19,807,809],{"id":808},"tooling-to-install","Tooling to Install",[811,812,814],"code-wrapper",{"language":813},"bash",[815,816,820],"pre",{"className":817,"code":818,"language":813,"meta":819,"style":819},"language-bash shiki shiki-themes github-light github-dark","node --version              # v18.18+ or v20+ recommended\n\nnpm create vue@latest       # official scaffolding tool (create-vue)\n# ✔ Add TypeScript? › Yes\n# ✔ Add Vue Router? › Yes\n# ✔ Add Pinia? › Yes\n# ✔ Add Vitest? › Yes\n\ncd my-vue-app\nnpm install\nnpm run dev\n\n# Vue DevTools — install the browser extension:\n#   Chrome\u002FEdge\u002FFirefox: search \"Vue.js devtools\" in your browser's extension store\n# Or use the standalone app (works with any browser, and with Vite via a plugin):\nnpm install -D vite-plugin-vue-devtools\n","",[66,821,822,839,846,862,868,874,880,886,891,900,908,919,924,930,936,942],{"__ignoreMap":819},[823,824,827,831,835],"span",{"class":825,"line":826},"line",1,[823,828,830],{"class":829},"sIsaT","node",[823,832,834],{"class":833},"snvgF"," --version",[823,836,838],{"class":837},"sdCPZ","              # v18.18+ or v20+ recommended\n",[823,840,842],{"class":825,"line":841},2,[823,843,845],{"emptyLinePlaceholder":844},true,"\n",[823,847,849,852,856,859],{"class":825,"line":848},3,[823,850,851],{"class":829},"npm",[823,853,855],{"class":854},"sJ6F3"," create",[823,857,858],{"class":854}," vue@latest",[823,860,861],{"class":837},"       # official scaffolding tool (create-vue)\n",[823,863,865],{"class":825,"line":864},4,[823,866,867],{"class":837},"# ✔ Add TypeScript? › Yes\n",[823,869,871],{"class":825,"line":870},5,[823,8