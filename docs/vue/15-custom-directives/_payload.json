6,2054,134],{"class":52},[46,2056,57],{"class":56},[46,2058,64],{"class":52},[46,2060,2061],{"class":48,"line":131},[46,2062,145],{"emptyLinePlaceholder":144},[46,2064,2065,2067,2069],{"class":48,"line":141},[46,2066,53],{"class":52},[46,2068,153],{"class":56},[46,2070,64],{"class":52},[46,2072,2073,2075,2077,2080,2082,2085,2088,2090],{"class":48,"line":148},[46,2074,161],{"class":52},[46,2076,553],{"class":56},[46,2078,2079],{"class":60}," v-highlight",[46,2081,173],{"class":52},[46,2083,2084],{"class":176},"\"color\"",[46,2086,2087],{"class":52},">Status\u003C\u002F",[46,2089,553],{"class":56},[46,2091,64],{"class":52},[46,2093,2094,2096,2098,2100,2102,2105,2108,2110],{"class":48,"line":158},[46,2095,161],{"class":52},[46,2097,965],{"class":56},[46,2099,968],{"class":60},[46,2101,173],{"class":52},[46,2103,2104],{"class":176},"\"color = 'lightgreen'\"",[46,2106,2107],{"class":52},">Change color\u003C\u002F",[46,2109,965],{"class":56},[46,2111,64],{"class":52},[46,2113,2114,2116,2118],{"class":48,"line":183},[46,2115,134],{"class":52},[46,2117,153],{"class":56},[46,2119,64],{"class":52},[2121,2122,2123,2127,2155,2230],"details",{},[2124,2125,2126],"summary",{},"Answer",[19,2128,2129,2130,2132,2133,2135,2136,2138,2139,2142,2143,2146,2147,2150,2151,2154],{},"The directive only defines a ",[43,2131,364],{}," hook — it never defines ",[43,2134,384],{},". ",[43,2137,364],{}," fires exactly once, when the element is first inserted into the DOM; nothing in this directive re-runs when ",[43,2140,2141],{},"color.value"," changes afterward, so the ",[43,2144,2145],{},"\u003Cdiv>","'s background is set correctly on first render and then simply never touched again, no matter how many times ",[43,2148,2149],{},"color"," changes. This mirrors the ",[43,2152,2153],{},"onMounted","-fires-once trap from chapter 08's Spot the Bug — same underlying principle, directive-hook flavored.",[32,2156,2157],{"language":195,"filename":410},[37,2158,2160],{"className":199,"code":2159,"language":195,"meta":41,"style":41},"export const vHighlight = {\n  mounted(el, binding) {\n    el.style.backgroundColor = binding.value\n  },\n  updated(el, binding) {\n    el.style.backgroundColor = binding.value\n  }\n}\n",[43,2161,2162,2174,2188,2196,2200,2214,2222,2226],{"__ignoreMap":41},[46,2163,2164,2166,2168,2170,2172],{"class":48,"line":49},[46,2165,420],{"class":83},[46,2167,423],{"class":83},[46,2169,426],{"class":87},[46,2171,91],{"class":83},[46,2173,94],{"class":52},[46,2175,2176,2178,2180,2182,2184,2186],{"class":48,"line":67},[46,2177,100],{"class":60},[46,2179,262],{"class":52},[46,2181,107],{"class":106},[46,2183,441],{"class":52},[46,2185,444],{"class":106},[46,2187,447],{"class":52},[46,2189,2190,2192,2194],{"class":48,"line":74},[46,2191,452],{"class":52},[46,2193,173],{"class":83},[46,2195,1156],{"class":52},[46,2197,2198],{"class":48,"line":80},[46,2199,468],{"class":52},[46,2201,2202,2204,2206,2208,2210,2212],{"class":48,"line":97},[46,2203,473],{"class":60},[46,2205,262],{"class":52},[46,2207,107],{"class":106},[46,2209,441],{"class":52},[46,2211,444],{"class":106},[46,2213,447],{"class":52},[46,2215,2216,2218,2220],{"class":48,"line":125},[46,2217,452],{"class":52},[46,2219,173],{"class":83},[46,2221,1156],{"class":52},[46,2223,2224],{"class":48,"line":131},[46,2225,505],{"class":52},[46,2227,2228],{"class":48,"line":141},[46,2229,128],{"class":52},[19,2231,2232,2235,2236,2239,2240,2242,2243,2245],{},[23,2233,2234],{},"The lesson",": any directive effect that should track a ",[1069,2237,2238],{},"changing"," bound value needs an explicit ",[43,2241,384],{}," hook — ",[43,2244,364],{}," alone only captures the value's state at the moment the element first entered the DOM, exactly once, ever.",[14,2247,2249],{"id":2248},"key-takeaways","Key Takeaways",[987,2251,2252,2255,2268,2280,2292,2295],{},[1005,2253,2254],{},"Reach for a custom directive specifically when logic needs direct, imperative DOM access with no natural component\u002Fprop shape — composables cover most other reuse needs.",[1005,2256,2257,2258,441,2260,441,2262,2264,2265,2267],{},"Directive hooks (",[43,2259,364],{},[43,2261,384],{},[43,2263,404],{},", etc.) mirror a component's own lifecycle, with ",[43,2266,444],{}," (value, arg, modifiers, oldValue) as the payload.",[1005,2269,2270,2271,2273,2274,2276,2277,2279],{},"A directive that adds an event listener or external DOM node in ",[43,2272,364],{}," must remove\u002Fclean it up in ",[43,2275,404],{}," — save the exact reference on ",[43,2278,107],{}," itself so cleanup can target it precisely.",[1005,2281,2282,2283,2286,2287,1518,2289,2291],{},"The function shorthand (",[43,2284,2285],{},"(el, binding) => {...}",") covers directives where ",[43,2288,364],{},[43,2290,384],{}," share identical logic.",[1005,2293,2294],{},"Directives applied to components only affect the component's single root element, and behave ambiguously (with a dev warning) on multi-root fragment components.",[1005,2296,2297,2299,2300,2302,2303,2305],{},[43,2298,384],{}," fires on every re-render of the host component, not only when the directive's own bound value changes — compare ",[43,2301,1914],{}," to ",[43,2304,1805],{}," when that distinction matters.",[1584,2307,2308],{},"html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sk71V, html code.shiki .sk71V{--shiki-default:#22863A;--shiki-github-dark:#85E89D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}html pre.shiki code .sJ6F3, html cod