"className":29,"code":215,"language":25,"meta":31,"style":31},"local function risky()\n  if math.random() > 0.5 then\n    error(\"Random failure!\")\n  end\n  return \"success\"\nend\n\n-- Using pcall\nfor i = 1, 3 do\n  local ok, result = pcall(risky)\n  if ok then\n    print(\"Attempt \" .. i .. \": \" .. result)\n  else\n    print(\"Attempt \" .. i .. \": Error - \" .. result)\n  end\nend\n",[33,217,218,231,251,263,268,275,280,284,289,311,326,336,361,366,387,392],{"__ignoreMap":31},[36,219,220,222,225,229],{"class":38,"line":39},[36,221,81],{"class":80},[36,223,224],{"class":80}," function",[36,226,228],{"class":227},"sIsaT"," risky",[36,230,98],{"class":53},[36,232,233,236,239,242,245,248],{"class":38,"line":46},[36,234,235],{"class":80},"  if",[36,237,238],{"class":49}," math.random",[36,240,241],{"class":53},"() ",[36,243,244],{"class":80},">",[36,246,247],{"class":49}," 0.5",[36,249,250],{"class":80}," then\n",[36,252,253,256,258,261],{"class":38,"line":64},[36,254,255],{"class":49},"    error",[36,257,54],{"class":53},[36,259,260],{"class":57},"\"Random failure!\"",[36,262,61],{"class":53},[36,264,265],{"class":38,"line":71},[36,266,267],{"class":80},"  end\n",[36,269,270,272],{"class":38,"line":77},[36,271,104],{"class":80},[36,273,274],{"class":57}," \"success\"\n",[36,276,277],{"class":38,"line":101},[36,278,279],{"class":80},"end\n",[36,281,282],{"class":38,"line":116},[36,283,68],{"emptyLinePlaceholder":67},[36,285,286],{"class":38,"line":124},[36,287,288],{"class":42},"-- Using pcall\n",[36,290,291,294,297,299,302,305,308],{"class":38,"line":136},[36,292,293],{"class":80},"for",[36,295,296],{"class":53}," i ",[36,298,87],{"class":80},[36,300,301],{"class":49}," 1",[36,303,304],{"class":53},", ",[36,306,307],{"class":49},"3",[36,309,310],{"class":80}," do\n",[36,312,313,316,319,321,323],{"class":38,"line":141},[36,314,315],{"class":80},"  local",[36,317,318],{"class":53}," ok, result ",[36,320,87],{"class":80},[36,322,90],{"class":49},[36,324,325],{"cla