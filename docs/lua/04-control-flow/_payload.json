 i = 1, #t do v = t[i] end",".",[19,975,976,979],{},[956,977,978],{},"Use repeat-until for input validation loops",": Familiar pattern (like do-while).",[28,981,982],{"language":30},[32,983,985],{"className":34,"code":984,"language":30,"meta":36,"style":36},"local choice\nrepeat\n  io.write(\"Enter 1-3: \")\n  choice = tonumber(io.read())\nuntil choice and choice >= 1 and choice \u003C= 3\n",[23,986,987,992,996,1001,1006],{"__ignoreMap":36},[40,988,989],{"class":42,"line":43},[40,990,991],{},"local choice\n",[40,993,994],{"class":42,"line":49},[40,995,358],{},[40,997,998],{"class":42,"line":55},[40,999,1000],{},"  io.write(\"Enter 1-3: \")\n",[40,1002,1003],{"class":42,"line":61},[40,1004,1005],{},"  choice = tonumber(io.read())\n",[40,1007,1008],{"class":42,"line":67},[40,1009,1010],{},"until choice and choice >= 1 and choice \u003C= 3\n",[19,1012,1013,1016],{},[956,1014,1015],{},"Tail calls enable deep recursion",": Lua optimizes tail calls, so you can recurse deeply without stack overflow (if the call is truly tail).",[14,1018,1020],{"id":1019},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[19,1022,1023,1029,1030,1033],{},[956,1024,1025,1028],{},[23,1026,1027],{},"for"," loop variables are local to the loop",": You can't access ",[23,1031,1032],{},"i"," after the loop ends (unless you explicitly declared it before).",[28,1035,1036],{"language":30},[32,1037,1039],{"className":34,"code":1038,"language":30,"meta":36,"style":36},"for i = 1, 5 do\n  print(i)\nend\nprint(i)            -- nil (not 6)\n",[23,1040,1041,1045,1049,1053],{"__ignoreMap":36},[40,1042,1043],{"class":42,"line":43},[40,1044,210],{},[40,1046,1047],{"class":42,"line":49},[40,1048,180],{},[40,1050,1051],{"class":42,"line":55},[40,1052,82],{},[40,1054,1055],{"class":42,"line":61},[40,1056,1057],{},"print(i)            -- nil (not 6)\n",[19,1059,1060,1069,1070,1072,1073,1075],{},[956,1061,1062,1065,1066],{},[23,1063,1064],{},"ipairs"," stops at first ",[23,1067,1068],{},"nil",": If your table has a ",[23,1071,1068],{}," value in the middle, ",[23,1074,1064],{}," stops iterating the array part.",[28,1077,1078],{"language":30},[32,1079,1081],{"className":34,"code":1080,"language":30,"meta":36,"style":36},"local t = {1, 2, nil, 4, 5}\nfor i, v in ipairs(t) do\n  print(i, v)       -- prints: 1 1, 2 2 (stops at nil)\nend\n",[23,1082,1083,1088,1093,1098],{"__ignoreMap":36},[40,1084,1085],{"class":42,"line":43},[40,1086,1087],{},"local t = {1, 2, nil, 4, 5}\n",[40,1089,1090],{"class":42,"line":49},[40,1091,1092],{},"for i, v in ipairs(t) do\n",[40,1094,1095],{"class":42,"line":55},[40,1096,1097],{},"  print(i, v)       -- prints: 1 1, 2 2 (stops at nil)\n",[40,1099,1100],{"class":42,"line":61},[40,1101,82],{},[19,1103,1104,1109,1110,1112],{},[956,1105,1106,1108],{},[23,1107,267],{}," order is undefined",": Don't rely on insertion order; use ",[23,1111,271],{}," for arrays.",[19,1114,1115,1125],{},[956,1116,1117,1120,1121,1124],{},[23,1118,1119],{},"~="," for not-equal (not ",[23,1122,1123],{},"!=",")",": Different from most languages.",[19,1127,1128,1133],{},[956,1129,1130,1132],{},[23,1131,380],{}," only exits one level",": If nested loops, break exits the inner loop, not all loops. Use a flag or refactor.",[28,1135,1136],{"language":30},[32,1137,1139],{"className":34,"code":1138,"language":30,"meta":36,"style":36},"local found = false\nfor i = 1, 5 do\n  for j = 1, 5 do\n    if i == 3 and j == 3 then\n      found = true\n      break\n    end\n  end\n  if found then break end  -- break outer loop\nend\n",[23,1140,1141,1146,1150,1155,1160,1165,1170,1175,1179,1184],{"__ignoreMap":36},[40,1142,1143],{"class":42,"line":43},[40,1144,1145],{},"local found = false\n",[40,1147,1148],{"class":42,"line":49},[40,1149,210],{},[40,1151,1152],{"class":42,"line":55},[40,1153,1154],{},"  for j = 1, 5 do\n",[40,1156,1157],{"class":42,"line":61},[40,1158,1159],{},"    if i == 3 and j == 3 then\n",[40,1161,1162],{"class":42,"line":67},[40,1163,1164],{},"      found = true\n",[40,1166,1167],{"class":42,"line":73},[40,1168,1169],{},"      break\n",[40,1171,1172],{"class":42,"line":79},[40,1173,1174],{},"    end\n",[40,1176,1177],{"class":42,"line":85},[40,1178,416],{},[40,1180,1181],{"class":42,"line":92},[40,1182,1183],{},"  if found then break end  -- break outer loop\n",[40,1185,1186],{"class":42,"line":98},[40,1187,82],{},[14,1189,1191],{"id":1190},"spot-the-bug","🧠 Spot the Bug",[19,1193,1194],{},"What does this print?",[28,1196,1197],{"language":30},[32,1198,1200],{"className":34,"code":1199,"language":30,"meta":36,"style":36},"local x = 10\nif x > 5 and x \u003C 15 then\n  x = x * 2\n  if x > 25 then\n    x = 0\n  end\nend\nprint(x)\n",[23,1201,1202,1207,1212,1217,1222,1227,1231,1235],{"__ignoreMap":36},[40,1203,1204],{"class":42,"line":43},[40,1205,1206],{},"local x = 10\n",[40,1208,1209],{"class":42,"line":49},[40,1210,1211],{},"if x > 5 and x \u003C 15 then\n",[40,1213,1214],{"class":42,"line":55},[40,1215,1216],{},"  x = x * 2\n",[40,1218,1219],{"class":42,"line":61},[40,1220,1221],{},"  if x > 25 then\n",[40,1223,1224],{"class":42,"line":67},[40,1225,1226],{},"    x = 0\n",[40,1228,1229],{"class":42,"line":73},[40,1230,416],{},[40,1232,1233],{"class":42,"line":79},[40,1234,82],{},[40,1236,1237],{"class":42,"line":85},[40,1238,1239],{},"print(x)\n",[1241,1242,1243,1247,1253,1256,1290],"details",{},[1244,1245,1246],"summary",{},"Answer",[19,1248,1249,1250,973],{},"Prints ",[23,1251,1252],{},"20",[19,1254,1255],{},"Here's why:",[1257,1258,1259,1274,1279,1285],"ul",{},[1260,1261,1262,1265,1266,1269,1270,1273],"li",{},[23,1263,1264],{},"x = 10",", so ",[23,1267,1268],{},"x > 5"," (true) and ",[23,1271,1272],{},"x \u003C 15"," (true), entering the first if",[1260,1275,1276],{},[23,1277,1278],{},"x = 10 * 2 = 20",[1260,1280,1281,1284],{},[23,1282,1283],{},"x > 25"," is false (20 is not > 25), so the second if doesn't execute",[1260,1286,1287,1288],{},"Print ",[23,1289,1252],{},[19,1291,1292,1295,1296,973],{},[956,1293,1294],{},"The lesson","