 i = 1, #t do v = t[i] end",".",[19,975,976,979],{},[956,977,978],{},"Use repeat-until for input validation loops",": Familiar pattern (like do-while).",[32,981,983],{"className":34,"code":982,"language":30,"meta":36,"style":36},"local choice\nrepeat\n  io.write(\"Enter 1-3: \")\n  choice = tonumber(io.read())\nuntil choice and choice >= 1 and choice \u003C= 3\n",[23,984,985,990,994,999,1004],{"__ignoreMap":36},[40,986,987],{"class":42,"line":43},[40,988,989],{},"local choice\n",[40,991,992],{"class":42,"line":49},[40,993,358],{},[40,995,996],{"class":42,"line":55},[40,997,998],{},"  io.write(\"Enter 1-3: \")\n",[40,1000,1001],{"class":42,"line":61},[40,1002,1003],{},"  choice = tonumber(io.read())\n",[40,1005,1006],{"class":42,"line":67},[40,1007,1008],{},"until choice and choice >= 1 and choice \u003C= 3\n",[19,1010,1011,1014],{},[956,1012,1013],{},"Tail calls enable deep recursion",": Lua optimizes tail calls, so you can recurse deeply without stack overflow (if the call is truly tail).",[14,1016,1018],{"id":1017},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[19,1020,1021,1027,1028,1031],{},[956,1022,1023,1026],{},[23,1024,1025],{},"for"," loop variables are local to the loop",": You can't access ",[23,1029,1030],{},"i"," after the loop ends (unless you explicitly declared it before).",[32,1033,1035],{"className":34,"code":1034,"language":30,"meta":36,"style":36},"for i = 1, 5 do\n  print(i)\nend\nprint(i)            -- nil (not 6)\n",[23,1036,1037,1041,1045,1049],{"__ignoreMap":36},[40,1038,1039],{"class":42,"line":43},[40,1040,210],{},[40,1042,1043],{"class":42,"line":49},[40,1044,180],{},[40,1046,1047],{"class":42,"line":55},[40,1048,82],{},[40,1050,1051],{"class":42,"line":61},[40,1052,1053],{},"print(i)            -- nil (not 6)\n",[19,1055,1056,1065,1066,1068,1069,1071],{},[956,1057,1058,1061,1062],{},[23,1059,1060],{},"ipairs"," stops at first ",[23,1063,1064],{},"nil",": If your table has a ",[23,1067,1064],{}," value in the middle, ",[23,1070,1060],{}," stops iterating the array part.",[32,1073,1075],{"className":34,"code":1074,"language":30,"meta":36,"style":36},"local t = {1, 2, nil, 4, 5}\nfor i, v in ipairs(t) do\n  print(i, v)       -- prints: 1 1, 2 2 (stops at nil)\nend\n",[23,1076,1077,1082,1087,1092],{"__ignoreMap":36},[40,1078,1079],{"class":42,"line":43},[40,1080,1081],{},"local t = {1, 2, nil, 4, 5}\n",[40,1083,1084],{"class":42,"line":49},[40,1085,1086],{},"for i, v in ipairs(t) do\n",[40,1088,1089],{"class":42,"line":55},[40,1090,1091],{},"  print(i, v)       -- prints: 1 1, 2 2 (stops at nil)\n",[40,1093,1094],{"class":42,"line":61},[40,1095,82],{},[19,1097,1098,1103,1104,1106],{},[956,1099,1100,1102],{},[23,1101,267],{}," order is undefined",": Don't rely on insertion order; use ",[23,1105,271],{}," for arrays.",[19,1108,1109,1119],{},[956,1110,1111,1114,1115,1118],{},[23,1112,1113],{},"~="," for not-equal (not ",[23,1116,1117],{},"!=",")",": Different from most languages.",[19,1121,1122,1127],{},[956,1123,1124,1126],{},[23,1125,380],{}," only exits one level",": If nested loops, break exits the inner loop, not all loops. Use a flag or refactor.",[32,1129,1131],{"className":34,"code":1130,"language":30,"meta":36,"style":36},"local found = false\nfor i = 1, 5 do\n  for j = 1, 5 do\n    if i == 3 and j == 3 then\n      found = true\n      break\n    end\n  end\n  if found then break end  -- break outer loop\nend\n",[23,1132,1133,1138,1142,1147,1152,1157,1162,1167,1171,1176],{"__ignoreMap":36},[40,1134,1135],{"class":42,"line":43},[40,1136,1137],{},"local found = false\n",[40,1139,1140],{"class":42,"line":49},[40,1141,210],{},[40,1143,1144],{"class":42,"line":55},[40,1145,1146],{},"  for j = 1, 5 do\n",[40,1148,1149],{"class":42,"line":61},[40,1150,1151],{},"    if i == 3 and j == 3 then\n",[40,1153,1154],{"class":42,"line":67},[40,1155,1156],{},"      found = true\n",[40,1158,1159],{"class":42,"line":73},[40,1160,1161],{},"      break\n",[40,1163,1164],{"class":42,"line":79},[40,1165,1166],{},"    end\n",[40,1168,1169],{"class":42,"line":85},[40,1170,416],{},[40,1172,1173],{"class":42,"line":92},[40,1174,1175],{},"  if found then break end  -- break outer loop\n",[40,1177,1178],{"class":42,"line":98},[40,1179,82],{},[14,1181,1183],{"id":1182},"spot-the-bug","🧠 Spot the Bug",[19,1185,1186],{},"What does this print?",[32,1188,1190],{"className":34,"code":1189,"language":30,"meta":36,"style":36},"local x = 10\nif x > 5 and x \u003C 15 then\n  x = x * 2\n  if x > 25 then\n    x = 0\n  end\nend\nprint(x)\n",[23,1191,1192,1197,1202,1207,1212,1217,1221,1225],{"__ignoreMap":36},[40,1193,1194],{"class":42,"line":43},[40,1195,1196],{},"local x = 10\n",[40,1198,1199],{"class":42,"line":49},[40,1200,1201],{},"if x > 5 and x \u003C 15 then\n",[40,1203,1204],{"class":42,"line":55},[40,1205,1206],{},"  x = x * 2\n",[40,1208,1209],{"class":42,"line":61},[40,1210,1211],{},"  if x > 25 then\n",[40,1213,1214],{"class":42,"line":67},[40,1215,1216],{},"    x = 0\n",[40,1218,1219],{"class":42,"line":73},[40,1220,416],{},[40,1222,1223],{"class":42,"line":79},[40,1224,82],{},[40,1226,1227],{"class":42,"line":85},[40,1228,1229],{},"print(x)\n",[1231,1232,1233,1237,1243,1246,1280],"details",{},[1234,1235,1236],"summary",{},"Answer",[19,1238,1239,1240,973],{},"Prints ",[23,1241,1242],{},"20",[19,1244,1245],{},"Here's why:",[1247,1248,1249,1264,1269,1275],"ul",{},[1250,1251,1252,1255,1256,1259,1260,1263],"li",{},[23,1253,1254],{},"x = 10",", so ",[23,1257,1258],{},"x > 5"," (true) and ",[23,1261,1262],{},"x \u003C 15"," (true), entering the first if",[1250,1265,1266],{},[23,1267,1268],{},"x = 10 * 2 = 20",[1250,1270,1271,1274],{},[23,1272,1273],{},"x > 25"," is false (20 is not > 25), so the second if doesn't execute",[1250,1276,1277,1278],{},"Print ",[23,1279,1242],{},[19,1281,1282,1285,1286,973],{},[956,1283,1284],{},"The lesson",": Conditions are evaluated in order. The second if sees the updated ",[23,1287,1288],{},"x",[14,1290,1292],{"id":1291},"key-takeaways","Key Takeaways",[124