83,1585],{"className":29,"code":1584,"language":25,"meta":31,"style":31},"local t = setmetatable({x = 1}, {\n  __index = function() return \"default\" end\n})\nprint(t.x)              -- 1 (not \"default\")\nprint(t.y)              -- \"default\"\n",[33,1586,1587,1592,1596,1600,1605],{"__ignoreMap":31},[36,1588,1589],{"class":38,"line":39},[36,1590,1591],{},"local t = setmetatable({x = 1}, {\n",[36,1593,1594],{"class":38,"line":45},[36,1595,759],{},[36,1597,1598],{"class":38,"line":51},[36,1599,764],{},[36,1601,1602],{"class":38,"line":57},[36,1603,1604],{},"print(t.x)              -- 1 (not \"default\")\n",[36,1606,1607],{"class":38,"line":63},[36,1608,1609],{},"print(t.y)              -- \"default\"\n",[19,1611,1612,1617],{},[1416,1613,1614,1616],{},[33,1615,269],{}," called only if key doesn't exist",": To intercept all assignments, use a proxy table approach.",[19,1619,1620,1623,1624,1626],{},[1416,1621,1622],{},"Circular metamethods can cause infinite recursion",": If ",[33,1625,256],{}," references the table itself, you can get infinite loops.",[19,1628,1629,1632],{},[1416,1630,1631],{},"Metatables are per-table, not per-class",": Each instance needs its own metatable (or share one carefully).",[19,1634,1635,1640,1641,1644],{},[1416,1636,1637,1639],{},[33,1638,320],{}," must return an iterator function",": If you return wrong signature, ",[33,1642,1643],{},"pairs()"," fails silently.",[14,1646,1648],{"id":1647},"spot-the-bug","🧠 Spot the Bug",[19,1650,1651],{},"What does this print?",[23,1653,1654],{"language":25},[27,1655,1657],{"className":29,"code":1656,"language":25,"meta":31,"style":31},"local t = {}\nsetmetatable(t, {\n  __index = function(self, key)\n    return \"default\"\n  end,\n  __newindex = function(self, key, value)\n    rawset(self, key, value)\n  end\n})\n\nt.x = 42\nprint(t.x)\nprint(t.y)\n",[33,1658,1659,1664,1669,1673,1678,1682,1686,1691,1695,1699,1703,1708,1713],{"__ignoreMap":31},[36,1660,1661],{"class":38,"line":39},[36,1662,1663],{},"loc