ction() return \"default\" end\n})\nprint(t.x)              -- 1 (not \"default\")\nprint(t.y)              -- \"default\"\n",[33,1578,1579,1584,1588,1592,1597],{"__ignoreMap":31},[36,1580,1581],{"class":38,"line":39},[36,1582,1583],{},"local t = setmetatable({x = 1}, {\n",[36,1585,1586],{"class":38,"line":45},[36,1587,759],{},[36,1589,1590],{"class":38,"line":51},[36,1591,764],{},[36,1593,1594],{"class":38,"line":57},[36,1595,1596],{},"print(t.x)              -- 1 (not \"default\")\n",[36,1598,1599],{"class":38,"line":63},[36,1600,1601],{},"print(t.y)              -- \"default\"\n",[19,1603,1604,1609],{},[1416,1605,1606,1608],{},[33,1607,269],{}," called only if key doesn't exist",": To intercept all assignments, use a proxy table approach.",[19,1611,1612,1615,1616,1618],{},[1416,1613,1614],{},"Circular metamethods can cause infinite recursion",": If ",[33,1617,256],{}," references the table itself, you can get infinite loops.",[19,1620,1621,1624],{},[1416,1622,1623],{},"Metatables are per-table, not per-class",": Each instance needs its own metatable (or share one carefully).",[19,1626,1627,1632,1633,1636],{},[1416,1628,1629,1631],{},[33,1630,320],{}," must return an iterator function",": If you return wrong signature, ",[33,1634,1635],{},"pairs()"," fails silently.",[14,1638,1640],{"id":1639},"spot-the-bug","🧠 Spot the Bug",[19,1642,1643],{},"What does this print?",[27,1645,1647],{"className":29,"code":1646,"language":25,"meta":31,"style":31},"local t = {}\nsetmetatable(t, {\n  __index = function(self, key)\n    return \"default\"\n  end,\n  __newindex = function(self, key, value)\n    rawset(self, key, value)\n  end\n})\n\nt.x = 42\nprint(t.x)\nprint(t.y)\n",[33,1648,1649,1654,1659,1663,1668,1672,1676,1681,1685,1689,1693,1698,1703],{"__ignoreMap":31},[36,1650,1651],{"class":38,"line":39},[36,1652,1653],{},"local t = {}\n",[36,1655,1656],{"class":38,"line":45},[36,1657,1658],{},"setmetatable(t, {\n",[36,1660,1661],{"class":38,"line":51},[36,1662,1435],{},[36,1664