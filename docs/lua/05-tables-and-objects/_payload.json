6},"sorting","Sorting",[28,1169,1170],{"language":30},[32,1171,1173],{"className":34,"code":1172,"language":30,"meta":36,"style":36},"local nums = {3, 1, 4, 1, 5, 9}\n\n-- Default sort (ascending)\ntable.sort(nums)\nprint(table.concat(nums, \", \"))    -- \"1, 1, 3, 4, 5, 9\"\n\n-- Custom comparator\nlocal words = {\"apple\", \"Zebra\", \"banana\"}\ntable.sort(words, function(a, b)\n  return a:lower() \u003C b:lower()  -- case-insensitive\nend)\n\n-- Descending\nlocal desc = {3, 1, 4}\ntable.sort(desc, function(a, b) return a > b end)\n",[38,1174,1175,1180,1184,1189,1194,1199,1203,1208,1213,1218,1223,1228,1232,1237,1242],{"__ignoreMap":36},[41,1176,1177],{"class":43,"line":44},[41,1178,1179],{},"local nums = {3, 1, 4, 1, 5, 9}\n",[41,1181,1182],{"class":43,"line":50},[41,1183,60],{"emptyLinePlaceholder":59},[41,1185,1186],{"class":43,"line":56},[41,1187,1188],{},"-- Default sort (ascending)\n",[41,1190,1191],{"class":43,"line":63},[41,1192,1193],{},"table.sort(nums)\n",[41,1195,1196],{"class":43,"line":69},[41,1197,1198],{},"print(table.concat(nums, \", \"))    -- \"1, 1, 3, 4, 5, 9\"\n",[41,1200,1201],{"class":43,"line":75},[41,1202,60],{"emptyLinePlaceholder":59},[41,1204,1205],{"class":43,"line":81},[41,1206,1207],{},"-- Custom comparator\n",[41,1209,1210],{"class":43,"line":86},[41,1211,1212],{},"local words = {\"apple\", \"Zebra\", \"banana\"}\n",[41,1214,1215],{"class":43,"line":92},[41,1216,1217],{},"table.sort(words, function(a, b)\n",[41,1219,1220],{"class":43,"line":98},[41,1221,1222],{},"  return a:lower() \u003C b:lower()  -- case-insensitive\n",[41,1224,1225],{"class":43,"line":104},[41,1226,1227],{},"end)\n",[41,1229,1230],{"class":43,"line":110},[41,1231,60],{"emptyLinePlaceholder":59},[41,1233,1234],{"class":43,"line":116},[41,1235,1236],{},"-- Descending\n",[41,1238,1239],{"class":43,"line":122},[41,1240,1241],{},"local desc = {3, 1, 4}\n",[41,1243,1244],{"class":43,"line":128},[41,1245,1246],{},"table.sort(desc, function(a, b) return a > b end)\n",[659,1248,1250],{"id":1249},"edge-case-sorting-tables-with-mixed-keys","Edge case: sorting tables with mixed keys",[28,1252,1253],{"language":30},[32,1254,1256],{"className":34,"code":1255,"language":30,"meta":36,"style":36},"-- table.sort only sorts array part, not hash part\nlocal t = {2, 1, name = \"Alice\", 3, id = 42}\ntable.sort(t)\n-- Array part: {1, 2, 3}, hash part: {name = \"Alice\", id = 42}\n",[38,1257,1258,1263,1268,1273],{"__ignoreMap":36},[41,1259,1260],{"class":43,"line":44},[41,1261,1262],{},"-- table.sort only sorts array part, not hash part\n",[41,1264,1265],{"class":43,"line":50},[41,1266,1267],{},"local t = {2, 1, name = \"Alice\", 3, id = 42}\n",[41,1269,1270],{"class":43,"line":56},[41,1271,1272],{},"table.sort(t)\n",[41,1274,1275],{"class":43,"line":63},[41,1276,1277],{},"-- Array part: {1, 2, 3}, hash part: {name = \"Alice\", id = 42}\n",[14,1279,1281],{"id":1280},"table-library-functions","Table Library Functions",[28,1283,1284],{"language":30},[32,1285,1287],{"className":34,"code":1286,"language":30,"meta":36,"style":36},"-- Combine multiple tables\nlocal t1 = {1, 2}\nlocal t2 = {3, 4}\nlocal combined = {table.unpack(t1), table.unpack(t2)}  -- {1, 2, 3, 4}\n\n-- Check size (array part)\nlocal size = #t\n\n-- Iterate with index tracking\nlocal function forEach(t, fn)\n  for i, v in ipairs(t) do\n    fn(i, v)\n  end\nend\n\n-- Move elements\nlocal src = {1, 2, 3, 4, 5}\nlocal dest = {}\ntable.move(src, 2, 4, 1, dest)  -- move src[2:4] to dest[1:3]\n-- dest = {2, 3, 4}\n",[38,1288,1289,1294,1299,1304,1309,1313,1318,1323,1327,1332,1337,1342,1347,1351,1355,1359,1364,1369,1374,1379],{"__ignoreMap":36},[41,1290,1291],{"class":43,"line":44},[41,1292,1293],{},"-- Combine multiple tables\n",[41,1295,1296],{"class":43,"line":50},[41,1297,1298],{},"local t1 = {1, 2}\n",[41,1300,1301],{"class":43,"line":56},[41,1302,1303],{},"local t2 = {3, 4}\n",[41,1305,1306],{"class":43,"line":63},[41,1307,1308],{},"local combined = {table.unpack(t1), table.unpack(t