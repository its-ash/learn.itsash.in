[{"data":1,"prerenderedAt":2143},["ShallowReactive",2],{"page-\u002Flua\u002F05-tables-and-objects":3},{"id":4,"title":5,"body":6,"description":36,"extension":2137,"meta":2138,"navigation":59,"path":2139,"seo":2140,"stem":2141,"__hash__":2142},"content\u002Flua\u002F05-tables-and-objects.md","05 — Tables & Objects",{"type":7,"value":8,"toc":2113},"minimark",[9,13,18,27,184,188,298,302,414,418,525,529,658,666,739,743,746,856,864,935,939,942,1090,1094,1097,1164,1168,1247,1251,1278,1282,1384,1388,1394,1408,1418,1435,1454,1474,1478,1487,1501,1510,1534,1546,1558,1571,1575,1578,1603,1954,1957,1959,1986,2042,2046,2109],[10,11,5],"h1",{"id":12},"_05-tables-objects",[14,15,17],"h2",{"id":16},"tables-fundamentals","Tables Fundamentals",[19,20,21,22,26],"p",{},"Tables are Lua's ",[23,24,25],"strong",{},"only data structure"," — arrays, dictionaries, objects, and classes all use tables.",[28,29,31],"code-wrapper",{"language":30},"lua",[32,33,37],"pre",{"className":34,"code":35,"language":30,"meta":36,"style":36},"language-lua shiki shiki-themes github-light github-dark","-- Empty table\nlocal t = {}\n\n-- Array-like (1-indexed)\nlocal arr = {10, 20, 30}\narr[1]              -- 10\n\n-- Object-like (key-value)\nlocal person = {\n  name = \"Alice\",\n  age = 30,\n  greet = function(self)\n    return \"Hello, \" .. self.name\n  end\n}\nperson.name         -- \"Alice\"\n\n-- Mixed (array + key-value)\nlocal mixed = {\n  \"first\",\n  \"second\",\n  count = 2,\n  id = 123\n}\n","",[38,39,40,48,54,61,67,73,79,84,90,96,102,108,114,120,126,132,138,143,149,155,161,167,173,179],"code",{"__ignoreMap":36},[41,42,45],"span",{"class":43,"line":44},"line",1,[41,46,47],{},"-- Empty table\n",[41,49,51],{"class":43,"line":50},2,[41,52,53],{},"local t = {}\n",[41,55,57],{"class":43,"line":56},3,[41,58,60],{"emptyLinePlaceholder":59},true,"\n",[41,62,64],{"class":43,"line":63},4,[41,65,66],{},"-- Array-like (1-indexed)\n",[41,68,70],{"class":43,"line":69},5,[41,71,72],{},"local arr = {10, 20, 30}\n",[41,74,76],{"class":43,"line":75},6,[41,77,78],{},"arr[1]              -- 10\n",[41,80,82],{"class":43,"line":81},7,[41,83,60],{"emptyLinePlaceholder":59},[41,85,87],{"class":43,"line":86},8,[41,88,89],{},"-- Object-like (key-value)\n",[41,91,93],{"class":43,"line":92},9,[41,94,95],{},"local person = {\n",[41,97,99],{"class":43,"line":98},10,[41,100,101],{},"  name = \"Alice\",\n",[41,103,105],{"class":43,"line":104},11,[41,106,107],{},"  age = 30,\n",[41,109,111],{"class":43,"line":110},12,[41,112,113],{},"  greet = function(self)\n",[41,115,117],{"class":43,"line":116},13,[41,118,119],{},"    return \"Hello, \" .. self.name\n",[41,121,123],{"class":43,"line":122},14,[41,124,125],{},"  end\n",[41,127,129],{"class":43,"line":128},15,[41,130,131],{},"}\n",[41,133,135],{"class":43,"line":134},16,[41,136,137],{},"person.name         -- \"Alice\"\n",[41,139,141],{"class":43,"line":140},17,[41,142,60],{"emptyLinePlaceholder":59},[41,144,146],{"class":43,"line":145},18,[41,147,148],{},"-- Mixed (array + key-value)\n",[41,150,152],{"class":43,"line":151},19,[41,153,154],{},"local mixed = {\n",[41,156,158],{"class":43,"line":157},20,[41,159,160],{},"  \"first\",\n",[41,162,164],{"class":43,"line":163},21,[41,165,166],{},"  \"second\",\n",[41,168,170],{"class":43,"line":169},22,[41,171,172],{},"  count = 2,\n",[41,174,176],{"class":43,"line":175},23,[41,177,178],{},"  id = 123\n",[41,180,182],{"class":43,"line":181},24,[41,183,131],{},[14,185,187],{"id":186},"array-operations","Array Operations",[28,189,190],{"language":30},[32,191,193],{"className":34,"code":192,"language":30,"meta":36,"style":36},"local arr = {10, 20, 30}\n\n-- Access (1-indexed)\narr[1]              -- 10\narr[-1]             -- nil (no negative indices)\narr[0]              -- nil (Lua is 1-indexed)\n\n-- Modify\narr[2] = 99         -- {10, 99, 30}\narr[4] = 40         -- {10, 99, 30, 40}\n\n-- Insert \u002F remove\ntable.insert(arr, 25)        -- append: {10, 99, 30, 40, 25}\ntable.insert(arr, 2, 15)     -- insert at index 2: {10, 15, 99, 30, 40, 25}\ntable.remove(arr, 2)         -- remove index 2: {10, 99, 30, 40, 25}\n\n-- Length\n#arr                -- 5 (size of array part)\n\n-- Concatenation\ntable.concat(arr, \", \")   -- \"10, 99, 30, 40, 25\"\ntable.concat(arr, \", \", 2, 4)  -- \"99, 30, 40\" (from index 2 to 4)\n",[38,194,195,199,203,208,212,217,222,226,231,236,241,245,250,255,260,265,269,274,279,283,288,293],{"__ignoreMap":36},[41,196,197],{"class":43,"line":44},[41,198,72],{},[41,200,201],{"class":43,"line":50},[41,202,60],{"emptyLinePlaceholder":59},[41,204,205],{"class":43,"line":56},[41,206,207],{},"-- Access (1-indexed)\n",[41,209,210],{"class":43,"line":63},[41,211,78],{},[41,213,214],{"class":43,"line":69},[41,215,216],{},"arr[-1]             -- nil (no negative indices)\n",[41,218,219],{"class":43,"line":75},[41,220,221],{},"arr[0]              -- nil (Lua is 1-indexed)\n",[41,223,224],{"class":43,"line":81},[41,225,60],{"emptyLinePlaceholder":59},[41,227,228],{"class":43,"line":86},[41,229,230],{},"-- Modify\n",[41,232,233],{"class":43,"line":92},[41,234,235],{},"arr[2] = 99         -- {10, 99, 30}\n",[41,237,238],{"class":43,"line":98},[41,239,240],{},"arr[4] = 40         -- {10, 99, 30, 40}\n",[41,242,243],{"class":43,"line":104},[41,244,60],{"emptyLinePlaceholder":59},[41,246,247],{"class":43,"line":110},[41,248,249],{},"-- Insert \u002F remove\n",[41,251,252],{"class":43,"line":116},[41,253,254],{},"table.insert(arr, 25)        -- append: {10, 99, 30, 40, 25}\n",[41,256,257],{"class":43,"line":122},[41,258,259],{},"table.insert(arr, 2, 15)     -- insert at index 2: {10, 15, 99, 30, 40, 25}\n",[41,261,262],{"class":43,"line":128},[41,263,264],{},"table.remove(arr, 2)         -- remove index 2: {10, 99, 30, 40, 25}\n",[41,266,267],{"class":43,"line":134},[41,268,60],{"emptyLinePlaceholder":59},[41,270,271],{"class":43,"line":140},[41,272,273],{},"-- Length\n",[41,275,276],{"class":43,"line":145},[41,277,278],{},"#arr                -- 5 (size of array part)\n",[41,280,281],{"class":43,"line":151},[41,282,60],{"emptyLinePlaceholder":59},[41,284,285],{"class":43,"line":157},[41,286,287],{},"-- Concatenation\n",[41,289,290],{"class":43,"line":163},[41,291,292],{},"table.concat(arr, \", \")   -- \"10, 99, 30, 40, 25\"\n",[41,294,295],{"class":43,"line":169},[41,296,297],{},"table.concat(arr, \", \", 2, 4)  -- \"99, 30, 40\" (from index 2 to 4)\n",[14,299,301],{"id":300},"dictionary-operations","Dictionary Operations",[28,303,304],{"language":30},[32,305,307],{"className":34,"code":306,"language":30,"meta":36,"style":36},"local config = {\n  api_url = \"https:\u002F\u002Fapi.example.com\",\n  timeout = 5000,\n  retries = 3\n}\n\n-- Access\nconfig.api_url              -- \"https:\u002F\u002Fapi.example.com\"\nconfig[\"api_url\"]           -- same\nconfig[\"timeout\"]           -- 5000\n\n-- Iterate all keys\nfor key, value in pairs(config) do\n  print(key, value)\nend\n\n-- Check existence\nif config.retries then print(\"retries set\") end\nif config.undefined == nil then print(\"undefined\") end\n\n-- Remove\nconfig.timeout = nil        -- removes key\n",[38,308,309,314,319,324,329,333,337,342,347,352,357,361,366,371,376,381,385,390,395,400,404,409],{"__ignoreMap":36},[41,310,311],{"class":43,"line":44},[41,312,313],{},"local config = {\n",[41,315,316],{"class":43,"line":50},[41,317,318],{},"  api_url = \"https:\u002F\u002Fapi.example.com\",\n",[41,320,321],{"class":43,"line":56},[41,322,323],{},"  timeout = 5000,\n",[41,325,326],{"class":43,"line":63},[41,327,328],{},"  retries = 3\n",[41,330,331],{"class":43,"line":69},[41,332,131],{},[41,334,335],{"class":43,"line":75},[41,336,60],{"emptyLinePlaceholder":59},[41,338,339],{"class":43,"line":81},[41,340,341],{},"-- Access\n",[41,343,344],{"class":43,"line":86},[41,345,346],{},"config.api_url              -- \"https:\u002F\u002Fapi.example.com\"\n",[41,348,349],{"class":43,"line":92},[41,350,351],{},"config[\"api_url\"]           -- same\n",[41,353,354],{"class":43,"line":98},[41,355,356],{},"config[\"timeout\"]           -- 5000\n",[41,358,359],{"class":43,"line":104},[41,360,60],{"emptyLinePlaceholder":59},[41,362,363],{"class":43,"line":110},[41,364,365],{},"-- Iterate all keys\n",[41,367,368],{"class":43,"line":116},[41,369,370],{},"for key, value in pairs(config) do\n",[41,372,373],{"class":43,"line":122},[41,374,375],{},"  print(key, value)\n",[41,377,378],{"class":43,"line":128},[41,379,380],{},"end\n",[41,382,383],{"class":43,"line":134},[41,384,60],{"emptyLinePlaceholder":59},[41,386,387],{"class":43,"line":140},[41,388,389],{},"-- Check existence\n",[41,391,392],{"class":43,"line":145},[41,393,394],{},"if config.retries then print(\"retries set\") end\n",[41,396,397],{"class":43,"line":151},[41,398,399],{},"if config.undefined == nil then print(\"undefined\") end\n",[41,401,402],{"class":43,"line":157},[41,403,60],{"emptyLinePlaceholder":59},[41,405,406],{"class":43,"line":163},[41,407,408],{},"-- Remove\n",[41,410,411],{"class":43,"line":169},[41,412,413],{},"config.timeout = nil        -- removes key\n",[14,415,417],{"id":416},"table-constructor-syntax","Table Constructor Syntax",[28,419,420],{"language":30},[32,421,423],{"className":34,"code":422,"language":30,"meta":36,"style":36},"-- Positional keys (array part)\nlocal arr = {1, 2, 3}\n-- Equivalent to:\nlocal arr = {[1] = 1, [2] = 2, [3] = 3}\n\n-- Named keys (hash part)\nlocal obj = {name = \"Alice\", age = 30}\n-- Equivalent to:\nlocal obj = {[\"name\"] = \"Alice\", [\"age\"] = 30}\n\n-- Mixed\nlocal mixed = {100, 200, name = \"Alice\"}\n-- Array part: [1]=100, [2]=200\n-- Hash part: name=\"Alice\"\n\n-- Computed keys\nlocal key = \"color\"\nlocal t = {[key] = \"red\"}  -- t.color = \"red\"\n\n-- Expressions as keys\nlocal t = {[\"hello\" .. \" \" .. \"world\"] = 42}\n",[38,424,425,430,435,440,445,449,454,459,463,468,472,477,482,487,492,496,501,506,511,515,520],{"__ignoreMap":36},[41,426,427],{"class":43,"line":44},[41,428,429],{},"-- Positional keys (array part)\n",[41,431,432],{"class":43,"line":50},[41,433,434],{},"local arr = {1, 2, 3}\n",[41,436,437],{"class":43,"line":56},[41,438,439],{},"-- Equivalent to:\n",[41,441,442],{"class":43,"line":63},[41,443,444],{},"local arr = {[1] = 1, [2] = 2, [3] = 3}\n",[41,446,447],{"class":43,"line":69},[41,448,60],{"emptyLinePlaceholder":59},[41,450,451],{"class":43,"line":75},[41,452,453],{},"-- Named keys (hash part)\n",[41,455,456],{"class":43,"line":81},[41,457,458],{},"local obj = {name = \"Alice\", age = 30}\n",[41,460,461],{"class":43,"line":86},[41,462,439],{},[41,464,465],{"class":43,"line":92},[41,466,467],{},"local obj = {[\"name\"] = \"Alice\", [\"age\"] = 30}\n",[41,469,470],{"class":43,"line":98},[41,471,60],{"emptyLinePlaceholder":59},[41,473,474],{"class":43,"line":104},[41,475,476],{},"-- Mixed\n",[41,478,479],{"class":43,"line":110},[41,480,481],{},"local mixed = {100, 200, name = \"Alice\"}\n",[41,483,484],{"class":43,"line":116},[41,485,486],{},"-- Array part: [1]=100, [2]=200\n",[41,488,489],{"class":43,"line":122},[41,490,491],{},"-- Hash part: name=\"Alice\"\n",[41,493,494],{"class":43,"line":128},[41,495,60],{"emptyLinePlaceholder":59},[41,497,498],{"class":43,"line":134},[41,499,500],{},"-- Computed keys\n",[41,502,503],{"class":43,"line":140},[41,504,505],{},"local key = \"color\"\n",[41,507,508],{"class":43,"line":145},[41,509,510],{},"local t = {[key] = \"red\"}  -- t.color = \"red\"\n",[41,512,513],{"class":43,"line":151},[41,514,60],{"emptyLinePlaceholder":59},[41,516,517],{"class":43,"line":157},[41,518,519],{},"-- Expressions as keys\n",[41,521,522],{"class":43,"line":163},[41,523,524],{},"local t = {[\"hello\" .. \" \" .. \"world\"] = 42}\n",[14,526,528],{"id":527},"iteration-patterns","Iteration Patterns",[28,530,531],{"language":30},[32,532,534],{"className":34,"code":533,"language":30,"meta":36,"style":36},"local data = {1, 2, 3, name = \"Alice\", id = 42}\n\n-- ipairs: array part only, in order\nfor i, v in ipairs(data) do\n  print(i, v)               -- 1 1, 2 2, 3 3\nend\n\n-- pairs: all keys, unordered\nfor k, v in pairs(data) do\n  print(k, v)               -- prints all keys (order undefined)\nend\n\n-- Manual iteration (old style, avoid)\nfor i = 1, #data do\n  print(data[i])\nend\n\n-- Iterate keys only\nfor k in pairs(data) do\n  print(k)\nend\n\n-- Iterate values only\nfor _, v in pairs(data) do\n  print(v)\nend\n",[38,535,536,541,545,550,555,560,564,568,573,578,583,587,591,596,601,606,610,614,619,624,629,633,637,642,647,653],{"__ignoreMap":36},[41,537,538],{"class":43,"line":44},[41,539,540],{},"local data = {1, 2, 3, name = \"Alice\", id = 42}\n",[41,542,543],{"class":43,"line":50},[41,544,60],{"emptyLinePlaceholder":59},[41,546,547],{"class":43,"line":56},[41,548,549],{},"-- ipairs: array part only, in order\n",[41,551,552],{"class":43,"line":63},[41,553,554],{},"for i, v in ipairs(data) do\n",[41,556,557],{"class":43,"line":69},[41,558,559],{},"  print(i, v)               -- 1 1, 2 2, 3 3\n",[41,561,562],{"class":43,"line":75},[41,563,380],{},[41,565,566],{"class":43,"line":81},[41,567,60],{"emptyLinePlaceholder":59},[41,569,570],{"class":43,"line":86},[41,571,572],{},"-- pairs: all keys, unordered\n",[41,574,575],{"class":43,"line":92},[41,576,577],{},"for k, v in pairs(data) do\n",[41,579,580],{"class":43,"line":98},[41,581,582],{},"  print(k, v)               -- prints all keys (order undefined)\n",[41,584,585],{"class":43,"line":104},[41,586,380],{},[41,588,589],{"class":43,"line":110},[41,590,60],{"emptyLinePlaceholder":59},[41,592,593],{"class":43,"line":116},[41,594,595],{},"-- Manual iteration (old style, avoid)\n",[41,597,598],{"class":43,"line":122},[41,599,600],{},"for i = 1, #data do\n",[41,602,603],{"class":43,"line":128},[41,604,605],{},"  print(data[i])\n",[41,607,608],{"class":43,"line":134},[41,609,380],{},[41,611,612],{"class":43,"line":140},[41,613,60],{"emptyLinePlaceholder":59},[41,615,616],{"class":43,"line":145},[41,617,618],{},"-- Iterate keys only\n",[41,620,621],{"class":43,"line":151},[41,622,623],{},"for k in pairs(data) do\n",[41,625,626],{"class":43,"line":157},[41,627,628],{},"  print(k)\n",[41,630,631],{"class":43,"line":163},[41,632,380],{},[41,634,635],{"class":43,"line":169},[41,636,60],{"emptyLinePlaceholder":59},[41,638,639],{"class":43,"line":175},[41,640,641],{},"-- Iterate values only\n",[41,643,644],{"class":43,"line":181},[41,645,646],{},"for _, v in pairs(data) do\n",[41,648,650],{"class":43,"line":649},25,[41,651,652],{},"  print(v)\n",[41,654,656],{"class":43,"line":655},26,[41,657,380],{},[659,660,662,663],"h3",{"id":661},"edge-case-sparse-arrays-and","Edge case: sparse arrays and ",[38,664,665],{},"#",[28,667,668],{"language":30},[32,669,671],{"className":34,"code":670,"language":30,"meta":36,"style":36},"local sparse = {1, 2, nil, 4, 5}\n#sparse             -- 2 (stops at first nil in array part!)\n\n-- ipairs also stops at nil\nfor i, v in ipairs(sparse) do\n  print(i, v)       -- 1 1, 2 2 (stops at nil)\nend\n\n-- To work with sparse arrays, use pairs or explicit length\nlocal function count(t)\n  local n = 0\n  for _ in pairs(t) do n = n + 1 end\n  return n\nend\n",[38,672,673,678,683,687,692,697,702,706,710,715,720,725,730,735],{"__ignoreMap":36},[41,674,675],{"class":43,"line":44},[41,676,677],{},"local sparse = {1, 2, nil, 4, 5}\n",[41,679,680],{"class":43,"line":50},[41,681,682],{},"#sparse             -- 2 (stops at first nil in array part!)\n",[41,684,685],{"class":43,"line":56},[41,686,60],{"emptyLinePlaceholder":59},[41,688,689],{"class":43,"line":63},[41,690,691],{},"-- ipairs also stops at nil\n",[41,693,694],{"class":43,"line":69},[41,695,696],{},"for i, v in ipairs(sparse) do\n",[41,698,699],{"class":43,"line":75},[41,700,701],{},"  print(i, v)       -- 1 1, 2 2 (stops at nil)\n",[41,703,704],{"class":43,"line":81},[41,705,380],{},[41,707,708],{"class":43,"line":86},[41,709,60],{"emptyLinePlaceholder":59},[41,711,712],{"class":43,"line":92},[41,713,714],{},"-- To work with sparse arrays, use pairs or explicit length\n",[41,716,717],{"class":43,"line":98},[41,718,719],{},"local function count(t)\n",[41,721,722],{"class":43,"line":104},[41,723,724],{},"  local n = 0\n",[41,726,727],{"class":43,"line":110},[41,728,729],{},"  for _ in pairs(t) do n = n + 1 end\n",[41,731,732],{"class":43,"line":116},[41,733,734],{},"  return n\n",[41,736,737],{"class":43,"line":122},[41,738,380],{},[14,740,742],{"id":741},"object-like-tables-methods","Object-Like Tables (Methods)",[19,744,745],{},"Use tables with functions to simulate objects:",[28,747,748],{"language":30},[32,749,751],{"className":34,"code":750,"language":30,"meta":36,"style":36},"local Dog = {}\n\nfunction Dog:new(name, breed)\n  local dog = {\n    name = name,\n    breed = breed\n  }\n  setmetatable(dog, {__index = Dog})\n  return dog\nend\n\nfunction Dog:bark()\n  return self.name .. \" says woof!\"\nend\n\nfunction Dog:describe()\n  return self.name .. \" is a \" .. self.breed\nend\n\nlocal myDog = Dog:new(\"Buddy\", \"Golden Retriever\")\nprint(myDog:bark())           -- \"Buddy says woof!\"\nprint(myDog:describe())       -- \"Buddy is a Golden Retriever\"\n",[38,752,753,758,762,767,772,777,782,787,792,797,801,805,810,815,819,823,828,833,837,841,846,851],{"__ignoreMap":36},[41,754,755],{"class":43,"line":44},[41,756,757],{},"local Dog = {}\n",[41,759,760],{"class":43,"line":50},[41,761,60],{"emptyLinePlaceholder":59},[41,763,764],{"class":43,"line":56},[41,765,766],{},"function Dog:new(name, breed)\n",[41,768,769],{"class":43,"line":63},[41,770,771],{},"  local dog = {\n",[41,773,774],{"class":43,"line":69},[41,775,776],{},"    name = name,\n",[41,778,779],{"class":43,"line":75},[41,780,781],{},"    breed = breed\n",[41,783,784],{"class":43,"line":81},[41,785,786],{},"  }\n",[41,788,789],{"class":43,"line":86},[41,790,791],{},"  setmetatable(dog, {__index = Dog})\n",[41,793,794],{"class":43,"line":92},[41,795,796],{},"  return dog\n",[41,798,799],{"class":43,"line":98},[41,800,380],{},