1428,1431,1432,1434],{},[23,1421,1422,1423,1426],{},"Use ",[38,1424,1425],{},"table.pack()"," to capture varargs",": Better than manual ",[38,1429,1430],{},"{...}"," for preserving ",[38,1433,1401],{}," values.",[32,1436,1438],{"className":34,"code":1437,"language":30,"meta":36,"style":36},"local function capture(...)\n  return table.pack(...)  -- includes .n (count) even with trailing nils\nend\n",[38,1439,1440,1445,1450],{"__ignoreMap":36},[41,1441,1442],{"class":43,"line":44},[41,1443,1444],{},"local function capture(...)\n",[41,1446,1447],{"class":43,"line":50},[41,1448,1449],{},"  return table.pack(...)  -- includes .n (count) even with trailing nils\n",[41,1451,1452],{"class":43,"line":56},[41,1453,380],{},[19,1455,1456,1459,1460,1463,1464,1463,1467,1463,1470,1473],{},[23,1457,1458],{},"Metamethods for custom behavior",": ",[38,1461,1462],{},"__add",", ",[38,1465,1466],{},"__tostring",[38,1468,1469],{},"__index",[38,1471,1472],{},"__newindex"," customize operator and property behavior.",[14,1475,1477],{"id":1476},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[19,1479,1480,1459,1483,1486],{},[23,1481,1482],{},"Tables are references, not values",[38,1484,1485],{},"local t2 = t1"," doesn't copy; both point to the same table. Mutating one affects the other.",[19,1488,1489,1494,1495,1497,1498,1500],{},[23,1490,1491,1493],{},[38,1492,665],{}," on sparse arrays is unreliable",": If array has gaps, ",[38,1496,665],{}," returns the index before the first gap. Use ",[38,1499,1406],{}," and count manually if needed.",[19,1502,1503,1506,1507,1509],{},[23,1504,1505],{},"Modifying table during iteration",": Behavior is undefined if you add\u002Fremove keys during a ",[38,1508,1406],{}," loop. Always iterate a copy if you need to modify.",[32,1511,1513],{"className":34,"code":1512,"language":30,"meta":36,"style":36},"local t = {1, 2, 3}\nfor k, v in pairs(t) do\n  t[k+10] = v  -- undefined behavior (may or may not add new keys)\nend\n",[38,1514,1515,1520,1525,1530],{"__ignoreMap":36},[41,1516,1517],{"class":43,"line":44},[41,1518,1519],{},"local t = {1, 2, 3}\n",[41,1521,1522],{"class":43,"line":50},[41,1523,1524],{},"for k, v in pairs(t) do\n",[41,1526,1527],{"class":43,"line":56},[41,1528,1529],{},"  t[k+10] = v  -- undefined behavior (may or may not add new keys)\n",[41,1531,1532],{"class":43,"line":63},[41,1533,380],{},[19,1535,1536,1459,1539,1542,1543,1545],{},[23,1537,1538],{},"nil removes keys completely",[38,1540,1541],{},"t[key] = nil"," doesn't set value to nil; it removes the key. To store nil, use ",[38,1544,1425],{}," or other patterns.",[19,1547,1548,1459,1551,1554,1555,1557],{},[23,1549,1550],{},"No array bounds checking",[38,1552,1553],{},"t[1000]"," on a small table returns ",[38,1556,1401],{},", not an error. Easy to typo and get silent bugs.",[19,1559,1560,1459,1563,1566,1567,1570],{},[23,1561,1562],{},"Comparing tables compares identity, not content",[38,1564,1565],{},"{a=1} == {a=1}"," is false (different tables). Use ",[38,1568,1569],{},"table.concat()"," to compare by serialization.",[14,1572,1574],{"id":1573},"spot-the-bug","🧠 Spot the Bug",[19,1576,1577],{},"What does this print?",[32,1579,1581],{"className":34,"code":1580,"language":30,"meta":36,"style":36},"local t = {10, 20, 30, name = \"Alice\"}\nt[4] = nil\ntable.insert(t, 40)\nprint(#t, table.concat(t, \", \"))\n",[38,1582,1583,1588,1593,1598],{"__ignoreMap":36},[41,1584,1585],{"class":43,"line":44},[41,1586,1587],{},"local t = {10, 20, 30, name = \"Alice\"}\n",[41,1589,1590],{"class":43,"line":50},[41,1591,1592],{},"t[4] = nil\n",[41,1594,1595],{"class":43,"line":56},[41,1596,1597],{},"table.insert(t, 40)\n",[41,1599,1600],{"class":43,"line":63},[41,1601,1602],{},"print(#t, table.concat(t, \", \"))\n",[1604,1605,1606,1610,1621,1624,1662,1665,1703,1706,1748,1757,1781,1787,1800,1806,1812,1815,1838,1841,1876,1879,1906,1909,1912,1925,1931,1951],"details",{},[1607,1608,1609],"summary",{},"Answer",[19,1611,1612,1613,1616,1617,1620],{},"Prints ",[38,1614,1615],{},"3\t10, 20, 30"," (not ",[38,1618,1619],{},"4\t10, 20, 30, 40",").",[19,1622,1623],{},"Here's why:",[1625,1626,1627,1638,1651],"ul",{},[1628,1629,1630,1633,1634,1637],"li",{},[38,1631,1632],{},"t[4] = nil"," removes the key ",[38,1635,1636],{},"4"," from the array part",[1628,1639,1640,1643,1644,1647,1648],{},[38,1641,1642],{},"table.insert(t, 40)"," inserts at position ",[38,1645,1646],{},"#t + 1 = 3 + 1 = 4",", so ",[38,1649,1650],{},"t[4] = 40",[1628,1652,1653,1654,1657,1658,1661],{},"But after the assignment, ",[38,1655,1656],{},"#t"," is still ",[38,1659,1660],{},"3"," because it finds the first nil gap",[19,1663,1664],{},"Actually, this behavior is subtle. Let me reconsider:",[1625,1666,1667,1676,1687,1698],{},[1628,1668,1669,1670,1463,1673],{},"Initial: ",[38,1671,1672],{},"t = {10, 20, 30, name=\"Alice\"}",[38,1674,1675],{},"#t = 3",[1628,1677,1678,1679,1681,1682,1463,1685],{},"After ",[38,1680,1632],{},": array part is ",[38,1683,1684],{},"{10, 20, 30}",[38,1686,1675],{},[1628,1688,1689,1691,1692,1463,1695],{},[38,1690,1642],{}," at position 4: ",[38,1693,1694],{},"t = {10, 20, 30, 40}",[38,1696,1697],{},"#t = 4",[1628,1699,1700,1701],{},"So it should print ",[38,1702,1619],{},[19,1704,1705],{},"Wait, let me re-check the initial state:",[1625,1707,1708,1722,1729,1740],{},[1628,1709,1710,1681,1713,1715,1716,1647,1719,1721],{},[38,1711,1712],{},"{10, 20, 30, name = \"Alice\"}",[38,1714,1684],{},", hash part is ",[38,1717,1718],{},"{name=\"Alice\"}",[38,1720,1675],{}," initially",[1628,1723,1724,1726,1727],{},[38,1725,1632],{}," has no effect (4 doesn't exist), ",[38,1728,1675],{},[1628,1730,1731,1643,1733,1736,1737],{},[38,1732,1642],{},[38,1734,1735],{},"#t + 1 = 4",", resulting in ",[38,1738,1739],{},"{10, 20, 30, 40}",[1628,1741,1742,1743,1745,1746],{},"Final: ",[38,1744,1697],{},", output should be ",[38,1747,1619],{},[19,1749,1750,1751,1647,1754,1756],{},"Actually, the initial assignment doesn't create ",[38,1752,1753],{},"t[4]",[38,1755,1632],{}," is just removing a non-existent key. Let me trace more carefully:",[19,1758,1759,1760,1763,1764,1766,1767,1769,1770,1773,1774,1776,1777,1780],{},"Initial state after line 1: ",[38,1761,1762],{},"t[1]=10, t[2]=20, t[3]=30, t[\"name\"]=\"Alice\"",", array length = 3\nLine 2 ",[38,1765,1632],{},": Since 4 doesn't exist, this does nothing. Array still has 3 elements.\nLine 3 ",[38,1768,1642],{},": Inserts at position 4 (length+1). Result: ",[38,1771,1772],{},"t[1]=10, t[2]=20, t[3]=30, t[4]=40","\nOutput: ",[38,1775,1636],{}," (from #t) and ",[38,1778,1779],{},"10, 20, 30, 40"," (from concat)",[19,1782,1783,1784,1786],{},"So the answer should be ",[38,1785,1619],{},".",[19,1788,1789,1790,1792,1793,1796,1797,1799],{},"Hmm, but what if the user's code actually assigned something to t",[41,1791,1636],{}," first? Let me look again - no, the code starts with just ",[38,1794,1795],{},"{10, 20, 30, name=\"Alice\"}",", so there's no t",[41,1798,1636],{}," initially.",[19,1801,1802,1803,1805],{},"Actually, I need to think about this differently. What if this is a trick about how ",[38,1804,665],{}," works?",[19,1807,1808,1809,1811],{},"Let me retrace: the user wants to demonstrate the gotcha about ",[38,1810,665],{}," and nil in arrays.",[19,1813,1814],{},"If we did:",[32,1816,1818],{"className":34,"code":1817,"language":30,"meta":36,"style":36},"local t = {10, 20, 30, 40, name = \"Alice\"}  -- note: 4 elements\nt[4] = nil\ntable.insert(t, 50)\nprint(#t, table.concat(t, \", \"))\n",[38,1819,1820,1825,1829,1834],{"__ignoreMap":36},[41,1821,1822],{"class":43,"line":44},[41,1823,1824],{},"local t = {10, 20, 30, 40, name = \"Alice\"}  -- note: 4 elements\n",[41,1826,1827],{"class":43,"line":50},[41,1828,1592],{},[41,1830,1831],{"class":43,"line":56},[41,1832,1833],{},"table.insert(t, 50)\n",[41,1835,1836],{"class":43,"line":63},[41,1837,1602],{},[19,1839,1840],{},"Then:",[1625,1842,1843,1849,1858,1866],{},[1628,1844,1669,1845,1463,1847],{},[38,1846,1739],{},[38,1848,1697],{},[1628,