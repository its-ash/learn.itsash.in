m\u002Fprecision\u002Finteger), ",[22,495,496],{},"os"," (time\u002Fdate\u002Fenv), ",[22,499,110],{}," (sort\u002Fmove\u002Fpack), ",[22,502,503],{},"debug"," (introspection\u002Fhooks), ",[22,506,507],{},"package"," (searchers\u002Fpreload).",[116,510,511,514,520],{},[134,512,513],{},"13",[134,515,516],{},[140,517,519],{"href":518},"\u002Flua\u002F13-performance","Performance & LuaJIT",[134,521,522,523,526,527,530,531,534],{},"Global vs local cost, table rehash avoidance, ",[22,524,525],{},"table.concat"," vs ",[22,528,529],{},"..",", closure allocation, ",[22,532,533],{},"collectgarbage"," profiling, LuaJIT FFI.",[105,536,538],{"id":537},"part-vi-engineering-capstone","Part VI — Engineering & Capstone",[110,540,541,551],{},[113,542,543],{},[116,544,545,547,549],{},[119,546,121],{},[119,548,124],{},[119,550,127],{},[129,552,553,577,594],{},[116,554,555,558,564],{},[134,556,557],{},"14",[134,559,560],{},[140,561,563],{"href":562},"\u002Flua\u002F14-testing","Testing & Mocking",[134,565,566,567,570,571,225,574,361],{},"Assertion library, parametric\u002Ftable-based tests, ",[22,568,569],{},"package.preload"," mocking, dependency injection, coverage with ",[22,572,573],{},"debug.sethook",[22,575,576],{},"busted",[116,578,579,582,588],{},[134,580,581],{},"15",[134,583,584],{},[140,585,587],{"href":586},"\u002Flua\u002F15-best-practices","Best Practices & Patterns",[134,589,590,591,593],{},"Strict mode, module design, error architecture, RAII via ",[22,592,429],{},", config layering, logging, anti-patterns catalog.",[116,595,596,599,605],{},[134,597,598],{},"16",[134,600,601],{},[140,602,604],{"href":603},"\u002Flua\u002F16-exercises-and-projects","Capstone Projects",[134,606,607],{},"JSON parser, coroutine pipeline, ORM query builder, plugin sandbox system, LRU cache, binary search, type checker, mini-REPL.",[27,609,611],{"id":610},"learning-path-suggestions","Learning Path Suggestions",[105,613,615],{"id":614},"if-youre-coming-from-pythonruby","If you're coming from 