,[22,81,82],{},"luarocks"," for package management (",[22,85,86],{},"brew install luarocks",").",[35,89,90,93,94,87],{},[22,91,92],{},"luacheck"," for linting (",[22,95,96],{},"luarocks install luacheck",[35,98,99],{},"Comfort with at least one other dynamic language (Python, JS, Ruby).",[27,101,103],{"id":102},"curriculum","Curriculum",[105,106,108],"h3",{"id":107},"part-i-foundations-execution-model","Part I — Foundations & Execution Model",[110,111,112,128],"table",{},[113,114,115],"thead",{},[116,117,118,122,125],"tr",{},[119,120,121],"th",{},"#",[119,123,124],{},"Topic",[119,126,127],{},"Why It Matters",[129,130,131,162,180,201],"tbody",{},[116,132,133,137,144],{},[134,135,136],"td",{},"01",[134,138,139],{},[140,141,143],"a",{"href":142},"\u002Flua\u002F01-getting-started","Runtime Architecture & Execution",[134,145,146,147,150,151,150,154,157,158,161],{},"Chunk compilation, ",[22,148,149],{},"load","\u002F",[22,152,153],{},"loadfile",[22,155,156],{},"require"," pipeline, ",[22,159,160],{},"_G"," registry, sandboxing, hot-reload.",[116,163,164,167,173],{},[134,165,166],{},"02",[134,168,169],{},[140,170,172],{"href":171},"\u002Flua\u002F02-variables-and-data-types","Types, Scoping & Memory",[134,174,175,176,179],{},"8-type system, integer\u002Ffloat duality, ",[22,177,178],{},"_ENV"," mechanics, upvalue cells, table reference semantics, weak tables.",[116,181,182,185,191],{},[134,183,184],{},"03",[134,186,187],{},[140,188,190],{"href":189},"\u002Flua\u002F03-functions","Functions, Closures & TCO",[134,192,193,194,150,197,200],{},"First-class functions, MRV truncation rules, varargs with ",[22,195,196],{},"select",[22,198,199],{},"pack",", proper tail calls, state machines.",[116,202,203,206,212],{},[134,204,205],{},"04",[134,207,208],{},[140,209,211],{"href":210},"\u002Flua\u002F04-control-flow","Control Flow & Iterators",[134,213,214,217,218,221,222,225,226,229],{},[22,215,216],{},"if"," as statement, numeric\u002Fgeneric ",[22,219,220],{},"for"," with the iter