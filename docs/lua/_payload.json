[{"data":1,"prerenderedAt":1261},["ShallowReactive",2],{"page-\u002Flua":3},{"id":4,"title":5,"body":6,"description":1254,"extension":1255,"meta":1256,"navigation":724,"path":1257,"seo":1258,"stem":1259,"__hash__":1260},"content\u002Flua\u002Findex.md","Learn Lua — From Scratch to Advanced",{"type":7,"value":8,"toc":1230},"minimark",[9,14,18,21,26,64,68,88,92,97,177,181,223,227,276,280,329,333,337,351,355,358,378,382,385,417,421,428,445,449,452,456,619,623,674,678,868,872,875,1051,1058,1144,1148,1180,1184,1216,1220,1223,1226],[10,11,13],"h1",{"id":12},"learn-lua-from-scratch-to-advanced","📖 Learn Lua — From Scratch to Advanced",[15,16,17],"p",{},"A comprehensive, edge-case-covering Lua curriculum. Each document is self-contained and covers its concept deeply enough that a careful reader can go from beginner to advanced Lua developer.",[15,19,20],{},"Lua is a lightweight, embeddable scripting language used in game engines (Roblox, Garry's Mod), configuration (Neovim, Awesome), streaming apps, and embedded systems. This course teaches idiomatic Lua with emphasis on practical patterns and surprising behaviors.",[22,23,25],"h2",{"id":24},"how-to-use-this-course","How to Use This Course",[27,28,29,37,43,54],"ol",{},[30,31,32,36],"li",{},[33,34,35],"strong",{},"Read sequentially"," for a structured path (01 → 10).",[30,38,39,42],{},[33,40,41],{},"Jump to a chapter"," as a reference when you hit a concept in the wild.",[30,44,45,48,49,53],{},[33,46,47],{},"Run the examples"," in each chapter using ",[50,51,52],"code",{},"lua script.lua"," or the interactive prompt.",[30,55,56,59,60,63],{},[33,57,58],{},"Experiment",": Lua's REPL is perfect for learning. Type ",[50,61,62],{},"lua"," to start.",[22,65,67],{"id":66},"prerequisites","Prerequisites",[69,70,71,82,85],"ul",{},[30,72,73,74,77,78,81],{},"A computer with Lua installed (macOS: ",[50,75,76],{},"brew install lua",", Linux: ",[50,79,80],{},"apt install lua5.4",", Windows: download from lua.org).",[30,83,84],{},"A text editor (VS Code, Vim, etc.).",[30,86,87],{},"Curiosity about how lightweight languages work.",[22,89,91],{"id":90},"curriculum","Curriculum",[93,94,96],"h3",{"id":95},"part-i-foundations","Part I — Foundations",[98,99,100,116],"table",{},[101,102,103],"thead",{},[104,105,106,110,113],"tr",{},[107,108,109],"th",{},"#",[107,111,112],{},"Topic",[107,114,115],{},"Why It Matters",[117,118,119,135,149,163],"tbody",{},[104,120,121,125,132],{},[122,123,124],"td",{},"01",[122,126,127],{},[128,129,131],"a",{"href":130},"\u002Flua\u002F01-getting-started","Getting Started",[122,133,134],{},"Installation, REPL, first program, standard library overview.",[104,136,137,140,146],{},[122,138,139],{},"02",[122,141,142],{},[128,143,145],{"href":144},"\u002Flua\u002F02-variables-and-data-types","Variables & Data Types",[122,147,148],{},"Scoping, falsy values, 1-indexed strings, tables as only composite type.",[104,150,151,154,160],{},[122,152,153],{},"03",[122,155,156],{},[128,157,159],{"href":158},"\u002Flua\u002F03-functions","Functions",[122,161,162],{},"Declarations, closures, varargs, tail call optimization.",[104,164,165,168,174],{},[122,166,167],{},"04",[122,169,170],{},[128,171,173],{"href":172},"\u002Flua\u002F04-control-flow","Control Flow",[122,175,176],{},"If\u002Felse, loops (no block scope!), pattern matching idioms.",[93,178,180],{"id":179},"part-ii-tables-objects","Part II — Tables & Objects",[98,182,183,193],{},[101,184,185],{},[104,186,187,189,191],{},[107,188,109],{},[107,190,112],{},[107,192,115],{},[117,194,195,209],{},[104,196,197,200,206],{},[122,198,199],{},"05",[122,201,202],{},[128,203,205],{"href":204},"\u002Flua\u002F05-tables-and-objects","Tables & Objects",[122,207,208],{},"Array operations, dictionaries, object patterns, copying semantics.",[104,210,211,214,220],{},[122,212,213],{},"06",[122,215,216],{},[128,217,219],{"href":218},"\u002Flua\u002F06-string-manipulation","String Manipulation",[122,221,222],{},"Methods, patterns (regex-like), formatting, byte operations.",[93,224,226],{"id":225},"part-iii-advanced-features","Part III — Advanced Features",[98,228,229,239],{},[101,230,231],{},[104,232,233,235,237],{},[107,234,109],{},[107,236,112],{},[107,238,115],{},[117,240,241,259],{},[104,242,243,246,252],{},[122,244,245],{},"07",[122,247,248],{},[128,249,251],{"href":250},"\u002Flua\u002F07-metatables-and-metamethods","Metatables & Metamethods",[122,253,254,255,258],{},"Operator overloading, custom behavior, OOP patterns via ",[50,256,257],{},"__index",".",[104,260,261,264,270],{},[122,262,263],{},"08",[122,265,266],{},[128,267,269],{"href":268},"\u002Flua\u002F08-modules-and-packages","Modules & Packages",[122,271,272,275],{},[50,273,274],{},"require()",", module patterns, circular dependencies, organization.",[93,277,279],{"id":278},"part-iv-robustness","Part IV — Robustness",[98,281,282,292],{},[101,283,284],{},[104,285,286,288,290],{},[107,287,109],{},[107,289,112],{},[107,291,115],{},[117,293,294,315],{},[104,295,296,299,305],{},[122,297,298],{},"09",[122,300,301],{},[128,302,304],{"href":303},"\u002Flua\u002F09-error-handling","Error Handling",[122,306,307,310,311,314],{},[50,308,309],{},"pcall()","\u002F",[50,312,313],{},"xpcall()",", assertions, debugging, cleanup patterns.",[104,316,317,320,326],{},[122,318,319],{},"10",[122,321,322],{},[128,323,325],{"href":324},"\u002Flua\u002F10-io-and-files","I\u002FO & Files",[122,327,328],{},"File operations, binary data, paths, JSON workflows.",[22,330,332],{"id":331},"learning-path-suggestions","Learning Path Suggestions",[93,334,336],{"id":335},"if-youre-new-to-programming","If you're new to programming",[27,338,339,342,345,348],{},[30,340,341],{},"Read 01–04 in order (fundamentals are different from mainstream languages).",[30,343,344],{},"Read 05 (Tables) carefully — this is the heart of Lua.",[30,346,347],{},"Read 09 (Error Handling) before writing production code.",[30,349,350],{},"Experiment in the REPL as you go.",[93,352,354],{"id":353},"if-youre-coming-from-pythonruby","If you're coming from Python\u002FRuby",[15,356,357],{},"You already know dynamic languages. Focus on:",[69,359,360,365,370,375],{},[30,361,362,364],{},[33,363,139],{}," (no block scope is the biggest surprise)",[30,366,367,369],{},[33,368,199],{}," (tables are different from dicts\u002Fhashes)",[30,371,372,374],{},[33,373,245],{}," (metatables are unique to Lua)",[30,376,377],{},"Skip straightforward parts like functions.",[93,379,381],{"id":380},"if-youre-coming-from-javascript","If you're coming from JavaScript",[15,383,384],{},"You know closures and dynamic types. Be aware:",[69,386,387,393,405,411],{},[30,388,389,392],{},[33,390,391],{},"1-indexed arrays"," (not 0-indexed)",[30,394,395,401,402],{},[33,396,397,398],{},"No ",[50,399,400],{},"null"," — Lua uses ",[50,403,404],{},"nil",[30,406,407,410],{},[33,408,409],{},"No built-in regex"," — Lua patterns are simpler",[30,412,413,416],{},[33,414,415],{},"Metatables"," for operator overloading (like JS's Proxy but older)",[93,418,420],{"id":419},"if-youre-embedding-lua-in-cgame-engine","If you're embedding Lua in C\u002FGame Engine",[15,422,423,424,427],{},"Read all chapters, then learn the ",[33,425,426],{},"Lua C API"," (separate topic). Focus on:",[69,429,430,433,436,439,442],{},[30,431,432],{},"01 (how Lua runs)",[30,434,435],{},"02 (types map to C types)",[30,437,438],{},"05 (tables are key to passing data)",[30,440,441],{},"07 (metatables for custom types)",[30,443,444],{},"08 (modules for organization)",[93,446,448],{"id":447},"if-youre-a-senior-engineer","If you're a senior engineer",[15,450,451],{},"Skim 01–04. Read 05 (Tables — the data model), 07 (Metatables — the extension mechanism), 08 (Modules), and 09 (Error Handling) closely. Use 10 (I\u002FO) as a reference.",[22,453,455],{"id":454},"key-differences-from-other-languages","Key Differences from Other Languages",[98,457,458,474],{},[101,459,460],{},[104,461,462,465,468,471],{},[107,463,464],{},"Concept",[107,466,467],{},"Lua",[107,469,4