},[59,947,949],{"className":162,"code":948,"language":146,"meta":63,"style":63},"local function divide(a, b)\n  assert(b ~= 0, \"divisor must not be zero\")\n  return a \u002F b\nend\n\nlocal result = divide(10, 0)  -- error: divisor must not be zero\n",[65,950,951,956,961,966,970,974],{"__ignoreMap":63},[68,952,953],{"class":70,"line":71},[68,954,955],{},"local function divide(a, b)\n",[68,957,958],{"class":70,"line":78},[68,959,960],{},"  assert(b ~= 0, \"divisor must not be zero\")\n",[68,962,963],{"class":70,"line":92},[68,964,965],{},"  return a \u002F b\n",[68,967,968],{"class":70,"line":99},[68,969,364],{},[68,971,972],{"class":70,"line":105},[68,973,96],{"emptyLinePlaceholder":95},[68,975,976],{"class":70,"line":119},[68,977,978],{},"local result = divide(10, 0)  -- error: divisor must not be zero\n",[19,980,981,982,985],{},"For catching errors, use ",[65,983,984],{},"pcall()"," (protected call):",[55,987,988],{"language":146},[59,989,991],{"className":162,"code":990,"language":146,"meta":63,"style":63},"local success, result = pcall(function()\n  return divide(10, 0)\nend)\n\nif not success then\n  print(\"Error:\", result)\nelse\n  print(\"Result:\", result)\nend\n",[65,992,993,998,1003,1008,1012,1017,1022,1027,1032],{"__ignoreMap":63},[68,994,995],{"class":70,"line":71},[68,996,997],{},"local success, result = pcall(function()\n",[68,999,1000],{"class":70,"line":78},[68,1001,1002],{},"  return divide(10, 0)\n",[68,1004,1005],{"class":70,"line":92},[68,1006,1007],{},"end)\n",[68,1009,1010],{"class":70,"line":99},[68,1011,96],{"emptyLinePlaceholder":95},[68,1013,1014],{"class":70,"line":105},[68,1015,1016],{},"if not success then\n",[68,1018,1019],{"class":70,"line":119},[68,1020,1021],{},"  print(\"Error:\", result)\n",[68,1023,1024],{"class":70,"line":124},[68,1025,1026],{},"else\n",[68,1028,1029],{"class":70,"line":130},[68,1030,1031],{},"  print(\"Result:\", result)\n",[68,1033,1034],{"class":70,"line":299},[68,1035,364],{},[14,1037,1039],{"id":1038},"tips-tricks","💡 Tips & Tricks",[19,1041,1042,1048],{},[23,1043,908,1044,1047],{},[65,1045,1046],{},"luacheck"," for linting",": Catches typos (undeclared globals), unused variables, and unreachable code. Saves hours of debugging.",[59,1050,1052],{"className":61,"code":1051,"language":57,"meta":63,"style":63},"luacheck script.lua\n",[65,1053,1054],{"__ignoreMap":63},[68,1055,1056,1058],{"class":70,"line":71},[68,1057,1046],{"class":81},[68,1059,1060],{"class":85}," script.lua\n",[19,1062,1063,1066,1067,1070],{},[23,1064,1065],{},"Local functions are faster",": ",[65,1068,1069],{},"local function f() end"," is faster and cleaner than assigning to a global.",[19,1072,1073,1076,1077,1080,1081,1084],{},[23,1074,1075],{},"Use descriptive names despite Lua's simplicity",": Lua doesn't have built-in namespacing. Write functions like ",[65,1078,1079],{},"player_update()",", not ",[65,1082,1083],{},"update()",", to avoid collisions.",[19,1086,1087,1090],{},[23,1088,1089],{},"Tables are your data structure",": Every complex data structure (stack, queue, class, closure) uses tables. Learn to manipulate them well.",[14,1092,1094],{"id":1093},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[19,1096,1097,1100,1101,1104,1105,1108,1109,1111],{},[23,1098,1099],{},"Globals leak by default",": Every assignment without ",[65,1102,1103],{},"local"," pollutes the global namespace. Use ",[65,1106,1107],{},"strict.lua"," or a linter to enforce ",[65,1110,1103],{},".",[59,1113,1115],{"className":162,"code":1114,"language":146,"meta":63,"style":63},"x = 5              -- GLOBAL (oops, typo from 'local x = 5')\nlocal y = 10       -- local (safe)\n",[65,1116,1117,1122],{"__ignoreMap":63},[68,1118,1119],{"class":70,"line":71},[68,1120,1121],{},"x = 5              -- GLOBAL (oops, typo from 'local x = 5')\n",[68,1123,1124],{"class":70,"line":78},[68,1125,1126],{},"local y = 10       -- local (safe)\n",[19,1128,1129,1132,1133,617,1136,617,1139,1142],{},[23,1130,1131],{},"No block scope (only funct