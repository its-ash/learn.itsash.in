ite data structure"," (arrays, objects, dicts, sets all use tables).",[110,892,893],{"language":112},[114,894,896],{"className":116,"code":895,"language":112,"meta":118,"style":118},"-- Array-like (1-indexed)\nlocal arr = {10, 20, 30}\narr[1]              -- 10\narr[2] = 99\n#arr                -- 3\n\n-- Object-like (key-value pairs)\nlocal person = {\n  name = \"Alice\",\n  age = 30,\n  [\"email\"] = \"alice@example.com\"\n}\nperson.name         -- \"Alice\"\nperson[\"age\"]       -- 30\n\n-- Mixed\nlocal mixed = {\n  1, 2, 3,          -- arr[1]=1, arr[2]=2, arr[3]=3\n  name = \"Alice\",   -- mixed.name = \"Alice\"\n  x = 10\n}\n",[19,897,898,903,907,912,917,922,926,931,936,941,946,951,956,961,966,970,975,980,985,990,995],{"__ignoreMap":118},[122,899,900],{"class":124,"line":125},[122,901,902],{},"-- Array-like (1-indexed)\n",[122,904,905],{"class":124,"line":131},[122,906,841],{},[122,908,909],{"class":124,"line":137},[122,910,911],{},"arr[1]              -- 10\n",[122,913,914],{"class":124,"line":143},[122,915,916],{},"arr[2] = 99\n",[122,918,919],{"class":124,"line":149},[122,920,921],{},"#arr                -- 3\n",[122,923,924],{"class":124,"line":155},[122,925,209],{"emptyLinePlaceholder":208},[122,927,928],{"class":124,"line":212},[122,929,930],{},"-- Object-like (key-value pairs)\n",[122,932,933],{"class":124,"line":218},[122,934,935],{},"local person = {\n",[122,937,938],{"class":124,"line":283},[122,939,940],{},"  name = \"Alice\",\n",[122,942,943],{"class":124,"line":288},[122,944,945],{},"  age = 30,\n",[122,947,948],{"class":124,"line":293},[122,949,950],{},"  [\"email\"] = \"alice@example.com\"\n",[122,952,953],{"class":124,"line":299},[122,954,955],{},"}\n",[122,957,958],{"class":124,"line":304},[122,959,960],{},"person.name         -- \"Alice\"\n",[122,962,963],{"class":124,"line":310},[122,964,965],{},"person[\"age\"]       -- 30\n",[122,967,968],{"class":124,"line":315},[122,969,209],{"emptyLinePlaceholder":208},[122,971,972],{"class":124,"line":