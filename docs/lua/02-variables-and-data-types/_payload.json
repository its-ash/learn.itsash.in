al to current block\nfunction test()\n  z = 30            -- global (assignments always are)\n  local w = 40      -- local to function\nend\n","",[19,120,121,129,135,141,147,153],{"__ignoreMap":118},[122,123,126],"span",{"class":124,"line":125},"line",1,[122,127,128],{},"x = 10              -- global\n",[122,130,132],{"class":124,"line":131},2,[122,133,134],{},"local y = 20        -- local to current block\n",[122,136,138],{"class":124,"line":137},3,[122,139,140],{},"function test()\n",[122,142,144],{"class":124,"line":143},4,[122,145,146],{},"  z = 30            -- global (assignments always are)\n",[122,148,150],{"class":124,"line":149},5,[122,151,152],{},"  local w = 40      -- local to function\n",[122,154,156],{"class":124,"line":155},6,[122,157,158],{},"end\n",[160,161,163,164,166],"h3",{"id":162},"best-practice-use-local-everywhere","Best practice: use ",[19,165,21],{}," everywhere",[24,168,169,170,172],{},"Global variables are slow (table lookups) and pollute the namespace. Prefer ",[19,171,21],{}," for performance and safety.",[110,174,175],{"language":112},[114,176,178],{"className":116,"code":177,"language":112,"meta":118,"style":118},"local name = \"Alice\"      -- fast, contained\nlocal function greet()    -- creates local function\n  print(\"Hi \" .. name)\nend\ngreet()\n\n-- Don't do this:\nGLOBAL_NAME = \"Alice\"     -- slower, accidental pollution\n",[19,179,180,185,190,195,199,204,210,216],{"__ignoreMap":118},[122,181,182],{"class":124,"line":125},[122,183,184],{},"local name = \"Alice\"      -- fast, contained\n",[122,186,187],{"class":124,"line":131},[122,188,189],{},"local function greet()    -- creates local function\n",[122,191,192],{"class":124,"line":137},[122,193,194],{},"  print(\"Hi \" .. name)\n",[122,196,197],{"class":124,"line":143},[122,198,158],{},[122,200,201],{"class":124,"line":149},[122,202,203],{},"greet()\n",[122,205,206],{"class":124,"line":155},[122,207,209],{"emptyLinePlaceholder":208},true,"\n",[122,211,213],{"class":124,"line":212},7,[122,214,215],{},"-- Don't do this:\n",[122,217,219],{"class":124,"line":218},8,[122,220,221],{},"GLOBAL_NAME = \"Alice\"     -- slower, accidental pollution\n",[160,223,225,227],{"id":224},"local-has-no-block-scope-only-function-scope",[19,226,21],{}," has no block scope (only function scope)",[24,229,230,231,233],{},"Unlike JavaScript, Lua's ",[19,232,21],{}," is function-scoped, not block-scoped.",[110,235,236],{"language":112},[114,237,239],{"className":116,"code":238,"language":112,"meta":118,"style":118},"local function test()\n  local x = 5\n  if true then\n    local y = 10        -- local to this block (but not really)\n    x = 100             -- mutates outer local\n  end\n  print(x)              -- 100\n  print(y)              -- nil (y is scoped, but...)\nend\n\n-- Actually:\nlocal function test()\n  local x, y\n  if true then\n    x = 100\n    y = 10\n  end\n  print(x)              -- 100\n  print(y)              -- 10 (still visible!)\nend\n",[19,240,241,246,251,256,261,266,271,276,281,286,291,297,302,308,313,319,325,330,335,341],{"__ignoreMap":118},[122,242,243],{"class":124,"line":125},[122,244,245],{},"local function test()\n",[122,247,248],{"class":124,"line":131},[122,249,250],{},"  local x = 5\n",[122,252,253],{"class":124,"line":137},[122,254,255],{},"  if true then\n",[122,257,258],{"class":124,"line":143},[122,259,260],{},"    local y = 10        -- local to this block (but not really)\n",[122,262,263],{"class":124,"line":149},[122,264,265],{},"    x = 100             -- mutates outer local\n",[122,267,268],{"class":124,"line":155},[122,269,270],{},"  end\n",[122,272,273],{"class":124,"line":212},[122,274,275],{},"  print(x)              -- 100\n",[122,277,278],{"class":124,"line":218},[122,279,280],{},"  print(y)              -- nil (y is scoped, but...)\n",[122,282,284],{"class":124,"line":283},9,[122,285,158],{},[122,287,289],{"class":124,"line":288},10,[122,290,209],{"emptyLinePlaceholder":208},[122,292,294],{"class":124,"line":