lassName":116,"code":1226,"language":112,"meta":118,"style":118},"local x = nil       -- explicitly nothing\nlocal y             -- implicitly nil (no initialization)\n\nif x == nil then print(\"x is nil\") end\n\n-- Removing from tables\nlocal t = {a=1, b=2}\nt.a = nil           -- removes key 'a' from table\n#t                  -- 0 (no array part)\n",[19,1228,1229,1234,1239,1243,1248,1252,1257,1262,1267],{"__ignoreMap":118},[122,1230,1231],{"class":124,"line":125},[122,1232,1233],{},"local x = nil       -- explicitly nothing\n",[122,1235,1236],{"class":124,"line":131},[122,1237,1238],{},"local y             -- implicitly nil (no initialization)\n",[122,1240,1241],{"class":124,"line":137},[122,1242,209],{"emptyLinePlaceholder":208},[122,1244,1245],{"class":124,"line":143},[122,1246,1247],{},"if x == nil then print(\"x is nil\") end\n",[122,1249,1250],{"class":124,"line":149},[122,1251,209],{"emptyLinePlaceholder":208},[122,1253,1254],{"class":124,"line":155},[122,1255,1256],{},"-- Removing from tables\n",[122,1258,1259],{"class":124,"line":212},[122,1260,1261],{},"local t = {a=1, b=2}\n",[122,1263,1264],{"class":124,"line":218},[122,1265,1266],{},"t.a = nil           -- removes key 'a' from table\n",[122,1268,1269],{"class":124,"line":283},[122,1270,1271],{},"#t                  -- 0 (no array part)\n",[14,1273,1275],{"id":1274},"type-checking","Type Checking",[110,1277,1278],{"language":112},[114,1279,1281],{"className":116,"code":1280,"language":112,"meta":118,"style":118},"type(5)             -- \"number\"\ntype(\"hello\")       -- \"string\"\ntype(true)          -- \"boolean\"\ntype(nil)           -- \"nil\"\ntype({})            -- \"table\"\ntype(function() end) -- \"function\"\n\n-- Checking specific types\nif type(x) == \"number\" then ... end\n",[19,1282,1283,1288,1293,1298,1303,1308,1313,1317,1322],{"__ignoreMap":118},[122,1284,1285],{"class":124,"line":125},[122,1286,1287],{},"type(5)             -- \"number\"\n",[122,1289,1290],{"class":124,"line":131},[122,1291,1292],{},"type(\"hello\")       -- \"string\"\n",[122,1294,1295],{"class":124,"line":137},[122,1296,1297],{},"type(true)          -- \"boolean\"\n",[122,1299,1300],{"class":124,"line":143},[122,1301,1302],{},"type(nil)           -- \"nil\"\n",[122,1304,1305],{"class":124,"line":149},[122,1306,1307],{},"type({})            -- \"table\"\n",[122,1309,1310],{"class":124,"line":155},[122,1311,1312],{},"type(function() end) -- \"function\"\n",[122,1314,1315],{"class":124,"line":212},[122,1316,209],{"emptyLinePlaceholder":208},[122,1318,1319],{"class":124,"line":218},[122,1320,1321],{},"-- Checking specific types\n",[122,1323,1324],{"class":124,"line":283},[122,1325,1326],{},"if type(x) == \"number\" then ... end\n",[14,1328,1330],{"id":1329},"type-coercion","Type Coercion",[24,1332,1333],{},"Lua is more conservative than JavaScript but still coerces in string operations.",[110,1335,1336],{"language":112},[114,1337,1339],{"className":116,"code":1338,"language":112,"meta":118,"style":118},"-- String coercion in concatenation\n\"value: \" .. 42     -- \"value: 42\" (number → string)\n\"5\" .. 3            -- \"53\"\n\n-- Arithmetic forces coercion (errors if can't convert)\ntonumber(\"5\") + 3   -- 8\n\"5\" + 3             -- ERROR: attempt to perform arithmetic on a string\n",[19,1340,1341,1346,1351,1356,1360,1365,1370],{"__ignoreMap":118},[122,1342,1343],{"class":124,"line":125},[122,1344,1345],{},"-- String coercion in concatenation\n",[122,1347,1348],{"class":124,"line":131},[122,1349,1350],{},"\"value: \" .. 42     -- \"value: 42\" (number → string)\n",[122,1352,1353],{"class":124,"line":137},[122,1354,1355],{},"\"5\" .. 3            -- \"53\"\n",[122,1357,1358],{"class":124,"line":143},[122,1359,209],{"emptyLinePlaceholder":208},[122,1361,1362],{"class":124,"line":149},[122,1363,1364],{},"-- Arithmetic forces coercion (errors if can't convert)\n",[122,1366,1367],{"class":124,"line":155},[122,1368,1369],{},"tonumber(\"5\") + 3   -- 8\n",[122,1371,1372],{"class":124,"line":212},[122,1373,1374],{},"\"5\" + 3             -- ERROR: attempt to perform arithmetic on a string\n",[14,1376,1378],{"id":1377},"tips-tricks","💡 Tips & Tricks",[24,1380,1381,1384,1385,1388,1389,1392,1393,1396,1397,1400],{},[28,1382,1383],{},"Print debugging",": Lua's ",[19,1386,1387],{},"print()"," auto-converts to string, so ",[19,1390,1391],{},"print({a=1})"," gives ",[19,1394,1395],{},"table: 0x...",". For better output, use ",[19,1398,1399],{},"print(vim.inspect(t))"," (in Neovim) or write a debug function:",[110,1402,1403],{"language":112},[114,1404,1406],{"className":116,"code":1405,"language":112,"meta":118,"style":118},"local function dump(t)\n  for k, v in pairs(t) do print(k, v) end\nend\n",[19,1407,1408,1413,1418],{"__ignoreMap":118},[122,1409,1410],{"class":124,"line":125},[122,1411,1412],{},"local function dump(t)\n",[122,1414,1415],{"class":124,"line":131},[122,1416,1417],{},"  for k, v in pairs(t) do print(k, v) end\n",[122,1419,1420],{"class":124,"line":137},[122,1421,158],{},[24,1423,1424,1427,1428,1431,1432,1435,1436,1439],{},[28,1425,1426],{},"Table iteration patterns",": ",[19,1429,1430],{},"ipairs"," iterates array part in order (1-indexed); ",[19,1433,1434],{},"pairs"," is unordered but hits all keys. For predicability in production, collect keys first: ",[19,1437,1438],{},"local keys = {}; for k in pairs(t) do table.insert(keys, k) end; table.sort(keys)",".",[24,1441,1442,1448,1449,1452,1453,1456,1457,1459],{},[28,1443,1444,1445],{},"Ternary-like without ",[19,1446,1447],{},"if",": Use ",[19,1450,1451],{},"condition and value_if_true or value_if_false",", but be careful if the \"true\" value is falsy. Safer: ",[19,1454,1455],{},"condition and {value_if_true} or value_if_false"," (wrap in table), or just use ",[19,1458,1447],{}," (it's an expression).",[24,1461,1462,1465],{},[28,1463,1464],{},"Local functions should come first",": Order matters in Lua. Define helper functions before calling them, unless they're inside another function.",[14,1467,1469],{"id":1468},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[24,1471,1472,1475,1476,1479],{},[28,1473,1474],{},"1-indexing everywhere",": Arrays, string indexing, ",[19,1477,1478],{},"string.sub()"," all use 1-based indexing. Very different from C\u002FPython\u002FJavaScript. Write a helper if you're translating from other languages.",[24,1481,1482,1427,1485,1488,1489,1492,1493,1439],{},[28,1483,1484],{},"Empty string and zero are truthy",[19,1486,1487],{},"if \"\" then"," is true! This breaks port from other languages. Always use explicit checks: ",[19,1490,1491],{},"if x ~= nil then"," or ",[19,1494,1495],{},"if x ~= false then",[24,1497,1498,1427,1505,1508,1509,1512],{},[28,1499,1500,1501,1504],{},"Concatenation coercion only in ",[19,1502,1503],{},".."," operator",[19,1506,1507],{},"\"5\" + 3"," is an error; only ",[19,1510,1511],{},"\"5\" .. 3"," coerces. You can't accidentally add strings.",[24,1514,1515,1448,1522,1525,1526,1529,1530,1533],{},[28,1516,1517,1518,1521],{},"Tables don't have ",[19,1519,1520],{},".length"," property",[19,1523,1524],{},"#t",", not ",[19,1527,1528],{},"t.length",". If you add non-integer keys to a table, ",[19,1531,1532],{},"#"," returns the length of the array part (undefined behavior if there are gaps).",[24,1535,1536,1427,1541,1544,1545,1548,1549,1551],{},[28,1537,1538,1540],{},[19,1539,379],{}," in tables has special meaning",[19,1542,1543],{},"local t = {a=1, b=nil, c=3}"," — key ",[19,1546,1547],{},"b"," is removed. To store ",[19,1550,379],{},", use explicit construction or be careful with unpack\u002Fpairs.",[24,1553,1554,1557,1558,1561],{},[28,1555,1556],{},"Modifying table during iteration",": If you add\u002Fremove keys during a ",[19,1559,1560],{},"pairs()"," loop, behavior is undefined. Always iterate over a copy if you need to modify.",[24,1563,1564,1567,1568,1570,1571,1574,1575,1578],{},[28,1565,1566],{},"Global variable pollution",": Every assignment without ",[19,1569,21],{}," goes to ",[19,1572,1573],{},"_G"," (the global table). Typos create globals instead of erroring. Use a linter or ",[19,1576,1577],{},"luacheck"," to catch this.",[24,1580,1581,1584,1585,1588,1589,1592],{},[28,1582,1583],{},"No true privacy",": Tables don't have truly private fields. Use naming conventions (leading ",[19,1586,1587],{},"_",") or closures; Lua 5.4 has ",[19,1590,1591],{},"\u003Cclose>"," but full privacy requires design patterns.",[14,1594,1596],{"id":1595},"spot-the-bug","🧠 Spot the Bug",[24,1598,1599],{},"What does this log?",[110,1601,1602],{"language":112},[114,1603,1605],{"className":116,"code":1604,"language":112,"meta":118,"style":118},"local x = {}\nx[1] = \"a\"\nx[2] = \"b\"\nx[3] = nil\nx[4] = \"c\"\nprint(#x)\n",[19,1606,1607,1612,1617,1622,1627,1632],{"__ignoreMap":118},[122,1608,1609],{"class":124,"line":125},[122,1610,1611],{},"local x = {}\n",[122,1613,1614],{"class":124,"line":131},[122,1615,1616],{},"x[1] = \"a\"\n",[122,1618,1619],{"class":124,"line":137},[122,1620,1621],{},"x[2] = \"b\"\n",[122,1623,1624],{"class":124,"line":143},[122,1625,1626],{},"x[3] = nil\n",[122,1628,1629],{"class":124,"line":149},[122,1630,1631],{},"x[4] = \"c\"\n",[122,1633,1634],{"class":124,"line":155},[122,1635,1636],{},"print(#x)\n",[1638,1639,1640,1644,1651,1680],"details",{},[1641,1642,1643],"summary",{},"Answer",[24,1645,1646,1647,1650],{},"Logs ",[19,1648,1649],{},"2"," (or possibly undefined behavior, depending on Lua version).",[24,1652,1653,1654,1656,1657,1660,1661,408,1664,1667,1668,1671,1672,1675,1676,1679],{},"Here's why: ",[19,1655,1532],{}," returns the length of the array part, which is the largest index ",[19,1658,1659],{},"i"," such that ",[19,1662,1663],{},"t[i] ~= nil",[19,1665,1666],{},"t[i+1] == nil",". Since ",[19,1669,1670],{},"x[3] = nil",", the array part \"ends\" at index 2. The ",[19,1673,1674],{},"x[4] = \"c\""," is in the hash part, not the array part, so ",[19,1677,1678],{},"#x"," ignores it.",[24,1681,1682,1685,1686,1688],{},[28,1683,1684],{},"The lesson",": Avoid ",[19,1687,379],{}," values in the middle of array-like tables. Either remove the key entirely or use a sparse array (with gaps understood as missing).",[14,1690,1692],{"id":1691},"key-takeaways","Key Takeaways",[1694,1695,1696,1703,1719,1722,1725,1731,1741],"ul",{},[1697,1698,1699,1700,1702],"li",{},"Use ",[19,1701,21],{}," everywhere — globals are slow and pollute namespace.",[1697,1704,1147,1705,408,1707,1709,1710,399,1713,1715,1716,1718],{},[19,1706,379],{},[19,1708,402],{}," are falsy; ",[19,1711,1712],{},"0",[19,1714,450],{},", and ",[19,1717,471],{}," are truthy.",[1697,1720,1721],{},"Tables are the only composite type — they're arrays, objects, and dicts.",[1697,1723,1724],{},"All strings and arrays are 1-indexed (not 0-indexed).",[1697,1726,1727,1730],{},[19,1728,1729],{},"#table"," returns the array length, not total keys.",[1697,1732,1733,1734,1736,1737,1740],{},"Type coercion happens in ",[19,1735,1503],{}," concatenation but not in ",[19,1738,1739],{},"+"," arithmetic.",[1697,1742,1743,1744,1746],{},"Table assignment without ",[19,1745,21],{}," creates globals; use a linter to catch typos.",[1748,1749,1750],"style",{},"html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}",{"title":118,"searchDepth":131,"depth":131,"links":1752},[1753,1760,1763,1766,1769,1773,1774,1775,1776,1777,1778,1779,1780],{"id":16,"depth":131,"text":1754,"children":1755},"Declaration: local, global, and function scope",[1756,1758],{"id":162,"depth":137,"text":1757},"Best practice: use local everywhere",{"id":224,"depth":137,"text":1759},"local has no block scope (only function scope)",{"id":348,"depth":131,"text":349,"children":1761},[1762],{"id":514,"depth":137,"text":515},{"id":569,"depth":131,"text":570,"children":1764},[1765],{"id":671,"depth":137,"text":672},{"id":711,"depth":131,"text":712,"children":1767},[1768],{"id":828,"depth":137,"text":829},{"id":882,"depth":131,"text":883,"children":1770},[1771,1772],{"id":1001,"depth":137,"text":1002},{"id":1075,"depth":137,"text":1076},{"id":393,"depth":131,"text":1144},{"id":379,"depth":131,"text":379},{"id":1274,"depth":131,"text":1275},{"id":1329,"depth":131,"text":1330},{"id":1377,"depth":131,"text":1378},{"id":1468,"depth":131,"text":1469},{"id":1595,"depth":131,"text":1596},{"id":1691,"depth":131,"text":1692},"md",{},"\u002Flua\u002F02-variables-and-data-types",{"title":5,"description":118},"lua\u002F02-variables-and-data-types","4zWFLpgGW-yxsUVsNJfNOQJMWTxwRL8w_gNTtQsY0Sg",1786799681017]