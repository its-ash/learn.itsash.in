,482,483],{},"function() end",[63,485,429],{},[42,487,488,493,496],{},[63,489,490],{},[19,491,492],{},"userdata",[63,494,495],{},"C object",[63,497,429],{},[42,499,500,505,510],{},[63,501,502],{},[19,503,504],{},"thread",[63,506,507],{},[19,508,509],{},"coroutine.create(fn)",[63,511,429],{},[160,513,515],{"id":514},"falsy-vs-truthy","Falsy vs Truthy",[110,517,518],{"language":112},[114,519,521],{"className":116,"code":520,"language":112,"meta":118,"style":118},"if nil then print(\"no\") end         -- false\nif false then print(\"no\") end       -- false\nif 0 then print(\"yes\") end          -- true (0 is NOT falsy!)\nif \"\" then print(\"yes\") end         -- true (empty string is truthy!)\nif {} then print(\"yes\") end         -- true (empty table is truthy!)\n\n-- Only nil and false are falsy\nif not nil then print(\"nil is falsy\") end      -- true\nif not false then print(\"false is falsy\") end  -- true\n",[19,522,523,528,533,538,543,548,552,557,562],{"__ignoreMap":118},[122,524,525],{"class":124,"line":125},[122,526,527],{},"if nil then print(\"no\") end         -- false\n",[122,529,530],{"class":124,"line":131},[122,531,532],{},"if false then print(\"no\") end       -- false\n",[122,534,535],{"class":124,"line":137},[122,536,537],{},"if 0 then print(\"yes\") end          -- true (0 is NOT falsy!)\n",[122,539,540],{"class":124,"line":143},[122,541,542],{},"if \"\" then print(\"yes\") end         -- true (empty string is truthy!)\n",[122,544,545],{"class":124,"line":149},[122,546,547],{},"if {} then print(\"yes\") end         -- true (empty table is truthy!)\n",[122,549,550],{"class":124,"line":155},[122,551,209],{"emptyLinePlaceholder":208},[122,553,554],{"class":124,"line":212},[122,555,556],{},"-- Only nil and false are falsy\n",[122,558,559],{"class":124,"line":218},[122,560,561],{},"if not nil then print(\"nil is falsy\") end      -- true\n",[122,563,564],{"class":124,"line":283},[122,565,566],{},"if not false then print(\"false is falsy\") end  -- true\n",[14,568,570],{"id":569},"numbers","Numbers",[24,572,573],{},"Lua (5.3+) unifies integers and floats; older versions had only floats.",[110,575,576],{"language":112},[114,577,579],{"className":116,"code":578,"language":112,"meta":118,"style":118},"local x = 42        -- integer\nlocal y = 3.14      -- float\nlocal z = 1e3       -- scientific: 1000\nlocal w = 0x1F      -- hexadecimal: 31\n\n-- Arithmetic\n10 + 5              -- 15\n10 - 5              -- 5\n10 * 5              -- 50\n10 \u002F 5              -- 2.0 (always returns float in Lua 5.3+)\n10 \u002F\u002F 5             -- 2 (floor division, Lua 5.3+)\n10 % 3              -- 1 (modulo)\n2 ^ 10              -- 1024 (exponentiation)\n\n-- String to number coercion (sometimes)\ntonumber(\"42\")      -- 42\ntonumber(\"3.14\")    -- 3.14\ntonumber(\"abc\")     -- nil\n",[19,580,581,586,591,596,601,605,610,615,620,625,630,635,640,645,649,654,659,664],{"__ignoreMap":118},[122,582,583],{"class":124,"line":125},[122,584,585],{},"local x = 42        -- integer\n",[122,587,588],{"class":124,"line":131},[122,589,590],{},"local y = 3.14      -- float\n",[122,592,593],{"class":124,"line":137},[122,594,595],{},"local z = 1e3       -- scientific: 1000\n",[122,597,598],{"class":124,"line":143},[122,599,600],{},"local w = 0x1F      -- hexadecimal: 31\n",[122,602,603],{"class":124,"line":149},[122,604,209],{"emptyLinePlaceholder":208},[122,606,607],{"class":124,"line":155},[122,608,609],{},"-- Arithmetic\n",[122,611,612],{"class":124,"line":212},[122,613,614],{},"10 + 5              -- 15\n",[122,616,617],{"class":124,"line":218},[122,618,619],{},"10 - 5              -- 5\n",[122,621,622],{"class":124,"line":283},[122,623,624],{},"10 * 5              -- 50\n",[122,626,627],{"class":124,"line":288},[122,628,629],{},"10 \u002F 5              -- 2.0 (always returns float in Lua 5.3+)\n",[122,631,632],{"class":124,"line":293},[122,633,634],{},"10 \u002F\u002F 5             -- 2 (floor division, Lua 5.3+)\n",[122,636,637],{"class":124,"line":299},[122,638,639],{},"10 % 3              -- 1 (modulo)\n",[122,641,642],{"class":124,"line":304},[122,643,644],{},"2 ^ 10              -- 1024 (exponentiation)\n",[122,646,647],{"class":124,"line":310},[122,648,209],{"emptyLinePlaceholder":208},[122,650,651],{"class":124,"line":315},[122,652,653],{},"-- String to number coercion (sometimes)\n",[122,655,656],{"class":124,"line":321},[122,657,658],{},"tonumber(\"42\")      -- 42\n",[122,660,661],{"class":124,"line":327},[122,662,663],{},"tonumber(\"3.14\")    -- 3.14\n",[122,665,666],{"class":124,"line":332},[122,667,668],{},"tonumber(\"abc\")     -- nil\n",[160,670,672],{"id":671},"edge-case-integer-vs-float-division","Edge case: integer vs float division",[110,674,675],{"language":112},[114,676,678],{"className":116,"code":677,"language":112,"meta":118,"style":118},"10 \u002F 4              -- 2.5 (float division)\n10 \u002F\u002F 4             -- 2 (floor division, Lua 5.3+)\n10 % 4              -- 2 (modulo: 10 - (10\u002F\u002F4)*4)\n\n-- Floating-point precision\n0.1 + 0.2 == 0.3    -- false (same as JavaScript)\n",[19,679,680,685,690,695,699,704],{"__ignoreMap":118},[122,681,682],{"class":124,"line":125},[122,683,684],{},"10 \u002F 4              -- 2.5 (float division)\n",[122,686,687],{"class":124,"line":131},[122,688,689],{},"10 \u002F\u002F 4             -- 2 (floor division, Lua 5.3+)\n",[122,691,692],{"class":124,"line":137},[122,693,694],{},"10 % 4              -- 2 (modulo: 10 - (10\u002F\u002F4)*4)\n",[122,696,697],{"class":124,"line":143},[122,698,209],{"emptyLinePlaceholder":208},[122,700,701],{"class":124,"line":149},[122,702,703],{},"-- Floating-point precision\n",[122,705,706],{"class":124,"line":155},[122,707,708],{},"0.1 + 0.2 == 0.3    -- false (same as JavaScript)\n",[14,710,712],{"id":711},"strings","Strings",[24,714,715],{},"Strings are immutable sequences of bytes. In Lua 5.3+, strings can contain embedded nulls.",[110,717,718],{"language":112},[114,719,721],{"className":116,"code":720,"language":112,"meta":118,"style":118},"local s = \"hello\"\nlocal t = 'world'\nlocal u = [[\n  multi-line\n  string literal\n]]\n\n-- Length\n#\"hello\"            -- 5\n#\"\"                 -- 0\n\n-- Concatenation (note: .. operator)\n\"hello\" .. \" \" .. \"world\"     -- \"hello world\"\n\"value: \" .. 42               -- \"value: 42\" (auto-coerces)\n\n-- Indexing (1-based, not 0-based!)\ns[1]                -- \"h\"\ns:sub(1, 5)         -- \"hello\" (substring)\ns:sub(-1)           -- \"o\" (last char)\ns:upper()           -- \"HELLO\"\ns:lower()           -- \"hello\"\n",[19,722,723,728,733,738,743,748,753,757,762,767,772,776,781,786,791,795,800,805,810,815,820],{"__ignoreMap":118},[122,724,725],{"class":124,"line":125},[122,726,727],{},"local s = \"hello\"\n",[122,729,730],{"class":124,"line":131},[122,731,732],{},"local t = 'world'\n",[122,734,735],{"class":124,"line":137},[122,736,737],{},"local u = [[\n",[122,739,740],{"class":124,"line":143},[122,741,742],{},"  multi-line\n",[122,744,745],{"class":124,"line":149},[122,746,747],{},"  string literal\n",[122,749,750],{"class":124,"line":155},[122,751,752],{},"]]\n",[122,754,755],{"class":124,"line":212},[122,756,209],{"emptyLinePlaceholder":208},[122,758,759],{"class":124,"line":218},[122,760,761],{},"-- Length\n",[122,763,764],{"class":124,"line":283},[122,765,766],{},"#\"hello\"            -- 5\n",[122,768,769],{"class":124,"line":288},[122,770,771],{},"#\"\"                 -- 0\n",[122,773,774],{"class":124,"line":293},[122,775,209],{"emptyLinePlaceholder":208},[122,777,778],{"class":124,"line":299},[122,779,780],{},"-- Concatenation (note: .. operator)\n",[122,782,783],{"class":124,"line":304},[122,784,785],{},"\"hello\" .. \" \" .. \"world\"     -- \"hello world\"\n",[122,787,788],{"class":124,"line":310},[122,789,790],{},"\"value: \" .. 42               -- \"value: 42\" (auto-coerces)\n",[122,792,793],{"class":124,"line":315},[122,794,209],{"emptyLinePlaceholder":208},[122,796,797],{"cl