osable — pick the plugins for your needs. Many tools (Vite, Tailwind) use PostCSS under the hood.",[18,1025,1027],{"id":1026},"build-tools","Build Tools",[619,1029,1031],{"id":1030},"vite","Vite",[14,1033,1034],{},"Vite is the modern build tool — it uses native ES modules in dev (instant startup) and bundles for production (Rollup):",[31,1036,1037,1095,1098,1101],{"language":930},[35,1038,1040],{"className":933,"code":1039,"language":930,"meta":39,"style":39},"\u002F\u002F vite.config.js\nexport default {\n    css: {\n        preprocessorOptions: {\n            scss: { additionalData: `@use \"variables\" as *;` },  \u002F\u002F auto-import\n        },\n    },\n};\n",[26,1041,1042,1047,1057,1062,1067,1081,1086,1091],{"__ignoreMap":39},[43,1043,1044],{"class":45,"line":46},[43,1045,1046],{"class":49},"\u002F\u002F vite.config.js\n",[43,1048,1049,1052,1055],{"class":45,"line":53},[43,1050,1051],{"class":82},"export",[43,1053,1054],{"class":82}," default",[43,1056,108],{"class":60},[43,1058,1059],{"class":45,"line":71},[43,1060,1061],{"class":60},"    css: {\n",[43,1063,1064],{"class":45,"line":88},[43,1065,1066],{"class":60},"        preprocessorOptions: {\n",[43,1068,1069,1072,1075,1078],{"class":45,"line":95},[43,1070,1071],{"class":60},"            scss: { additionalData: ",[43,1073,1074],{"class":694},"`@use \"variables\" as *;`",[43,1076,1077],{"class":60}," },  ",[43,1079,1080],{"class":49},"\u002F\u002F auto-import\n",[43,1082,1083],{"class":45,"line":101},[43,1084,1085],{"class":60},"        },\n",[43,1087,1088],{"class":45,"line":111},[43,1089,1090],{"class":60},"    },\n",[43,1092,1093],{"class":45,"line":123},[43,1094,1020],{"class":60},[14,1096,1097],{},"Vite supports CSS, SCSS, Less, PostCSS out of the box — just install the preprocessor and import the file.",[619,1099,1100],{"id":1100},"webpack",[31,1102,1103,1208,1227,1231,1234,1238,1241],{"language":930},[35,1104,1106],{"className":933,"code":1105,"language":930,"meta":39,"style":39},"\u002F\u002F webpa