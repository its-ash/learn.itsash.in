33;\n    }\n}\n","",[26,41,42,51,69,86,93,99,109,121,134,139,151,166,178,184,189,199,211,216,222,227,233,244,257,270,282,287,292,300,310,326,331,336,342,360,388,393,398,427,432,438,460,499,504,509,515,530,547,560,572,584,596,608,613],{"__ignoreMap":39},[43,44,47],"span",{"class":45,"line":46},"line",1,[43,48,50],{"class":49},"sdCPZ","\u002F\u002F Variables\n",[43,52,54,58,62,66],{"class":45,"line":53},2,[43,55,57],{"class":56},"sCrzJ","$primary",[43,59,61],{"class":60},"ssxIu",": ",[43,63,65],{"class":64},"snvgF","#3498db",[43,67,68],{"class":60},";\n",[43,70,72,75,77,80,84],{"class":45,"line":71},3,[43,73,74],{"class":56},"$spacing",[43,76,61],{"class":60},[43,78,79],{"class":64},"1",[43,81,83],{"class":82},"svdQ7","rem",[43,85,68],{"class":60},[43,87,89],{"class":45,"line":88},4,[43,90,92],{"emptyLinePlaceholder":91},true,"\n",[43,94,96],{"class":45,"line":95},5,[43,97,98],{"class":49},"\u002F\u002F Nesting\n",[43,100,102,106],{"class":45,"line":101},6,[43,103,105],{"class":104},"sIsaT",".card",[43,107,108],{"class":60}," {\n",[43,110,112,115,117,119],{"class":45,"line":111},7,[43,113,114],{"class":64},"    padding",[43,116,61],{"class":60},[43,118,74],{"class":56},[43,120,68],{"class":60},[43,122,124,127,129,132],{"class":45,"line":123},8,[43,125,126],{"class":64},"    background",[43,128,61],{"class":60},[43,130,131],{"class":64},"white",[43,133,68],{"class":60},[43,135,137],{"class":45,"line":136},9,[43,138,92],{"emptyLinePlaceholder":91},[43,140,142,146,149],{"class":45,"line":141},10,[43,143,145],{"class":144},"sk71V","    &",[43,147,148],{"class":104},"__title",[43,150,108],{"class":60},[43,152,154,157,159,162,164],{"class":45,"line":153},11,[43,155,156],{"class":64},"        font-size",[43,158,61],{"class":60},[43,160,161],{"class":64},"1.5",[43,163,83],{"class":82},[43,165,68],{"class":60},[43,167,169,172,174,176],{"class":45,"line":168},12,[43,170,171],{"class":64},"        color",[43,173,61],{"class":60},[43,175,57],{"class":56},[43,177,68],{"class":60},