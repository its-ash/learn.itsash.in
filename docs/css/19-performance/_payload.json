class":145},"    contain-intrinsic-size",[101,868,149],{"class":107},[101,870,871],{"class":145},"0",[101,873,874],{"class":145}," 50",[101,876,877],{"class":237},"px",[101,879,880],{"class":107},";  ",[101,882,883],{"class":132},"\u002F* placeholder size *\u002F\n",[101,885,886],{"class":103,"line":136},[101,887,888],{"class":107},"}\n",[14,890,891,893,894,897],{},[26,892,832],{}," skips rendering (layout, paint) for off-screen elements — huge performance win for long lists\u002Ffeeds. ",[26,895,896],{},"contain-intrinsic-size"," gives a placeholder size so the scrollbar is accurate. Browser support: Chrome 85+, Safari 18+, Firefox 125+.",[18,899,901],{"id":900},"contain",[26,902,900],{},[89,904,905],{"language":306},[93,906,908],{"className":309,"code":907,"language":306,"meta":97,"style":97},".card {\n    contain: layout paint style;   \u002F* isolate this subtree *\u002F\n}\n",[26,909,910,917,932],{"__ignoreMap":97},[101,911,912,915],{"class":103,"line":104},[101,913,914],{"class":161},".card",[101,916,465],{"class":107},[101,918,919,922,925,927,929],{"class":103,"line":118},[101,920,921],{"class":145},"    contain",[101,923,924],{"class":107},": layout paint ",[101,926,124],{"class":145},[101,928,490],{"class":107},[101,930,931],{"class":132},"\u002F* isolate this subtree *\u002F\n",[101,933,934],{"class":103,"line":129},[101,935,888],{"class":107},[14,937,938,940,941,415,944,415,947,415,949,415,952,955,956,959,960,962],{},[26,939,900],{}," tells the browser the element's internals don't affect the rest of the page — optimization. Values: ",[26,942,943],{},"layout",[26,945,946],{},"paint",[26,948,124],{},[26,950,951],{},"size",[26,953,954],{},"strict"," (all), ",[26,957,958],{},"content"," (all except ",[26,961,951],{},"). Use on isolated components (cards, widgets).",[18,964,966],{"id":965},"font-performance","Font Performance",[45,968,969,995,1003,1012],{},[48,970,971,976,977],{},[51,972,973],{},[26,974,975],{},"font-display: swap"," — show fallback text immediately, swap when the font loads (avoids invisible text):\n",[89,978,979,985,988],{"language":306},[93,980,981],{"className":309,"code":97,"language":306,"meta":97,"style":97},[26,982,983],{"__ignoreMap":97},[101,984],{"class":103,"line":104},[14,986,987],{},"@font-face {\nfont-family: \"MyFont\";\nsrc: url(\"myfont.woff2\") format(\"woff2\");\nfont-display: swap;\n}",[93,989,993],{"className":990,"code":97,"language":992},[991],"language-text","text",[26,994,97],{"__ignoreMap":97},[48,996,997,67,1000,231],{},[51,998,999],{},"Preload critical fonts",[26,1001,1002],{},"\u003Clink rel=\"preload\" href=\"font.woff2\" as=\"font\" type=\"font\u002Fwoff2\" crossorigin>",[48,1004,1005,1011],{},[51,1006,1007,1008],{},"Use ",[26,1009,1010],{},"woff2"," — best compression.",[48,1013,1014,1017],{},[51,1015,1016],{},"Subset fonts"," — include only the characters you need (especially for icon fonts).",[18,1019,1021,1023],{"id":1020},"will-change-recap",[26,1022,758],{}," (recap)",[14,1025,1007,1026,1028,1029,1032],{},[26,1027,758],{}," as a hint ",[35,1030,1031],{},"before"," an animation, remove it after. Don't leave it on permanently (wastes memory).",[18,1034,1036],{"id":1035},"measuring","Measuring",[45,1038,1039,1045,1051,1057],{},[48,1040,1041,1044],{},[51,1042,1043],{},"Chrome DevTools → Performance"," — record and see layout\u002Fpaint\u002Fcomposite times.",[48,1046,1047,1050],{},[51,1048,1049],{},"Chrome DevTools → Rendering"," — \"Paint flashing\" highlights repainted areas; \"Layout Shift Regions\" shows CLS.",[48,1052,1053,1056],{},[51,1054,1055],{},"Lighthouse"," — audits CSS performance (unused CSS, render-blocking).",[48,1058,1059,1062],{},[51,1060,1061],{},"Coverage tab"," — shows what % of each CSS file is used on the current page.",[18,1064,1066],{"id":1065},"tips-tricks","💡 Tips & Tricks",[45,1068,1069,1102,1113,1121,1132],{},[48,1070,1071,1074,1075,363,1077,1079,1080,606,1082,606,1084,606,1086,1088,1089,1092,1093,415,1095,1092,1098,606,1100,231],{},[51,1072,1073],{},"Idiom",": animate ",[26,1076,666],{},[26,1078,669],{}," (not ",[26,1081,593],{},[26,1083,596],{},[26,1085,605],{},[26,1087,609],{},") — they're compositor-only (GPU), no layout\u002Fpaint, 60fps. ",[26,1090,1091],{},"transform: translateX()"," instead of ",[26,1094,609],{},[26,1096,1097],{},"transform: scale()",[26,1099,593],{},[26,1101,596],{},[48,1103,1104,1106,1107,1109,1110,1112],{},[51,1105,1073],{},": use ",[26,1108,832],{}," + ",[26,1111,896],{}," for long lists — it skips rendering off-screen items, a massive performance win for feeds\u002Ftables. The browser only layouts\u002Fpaints visible items.",[48,1114,1115,1106,1117,1120],{},[51,1116,1073],{},[26,1118,1119],{},"contain: layout paint"," on isolated components — it tells the browser the component's internals don't affect the rest of the page, enabling optimizations. Use on cards, widgets, third-party embeds.",[48,1122,1123,1106,1125,1127,1128,1131],{},[51,1124,1073],{},[26,1126,975],{}," on web fonts — it shows fallback text immediately and swaps when the font loads, avoiding invisible text (FOIT). Pair with ",[26,1129,1130],{},"\u003Clink rel=\"preload\">"," for the critical font.",[48,1133,1134,1136,1137,1139,1140,1143],{},[51,1135,1073],{},": inline critical CSS and preload the rest — put above-the-fold CSS in a ",[26,1138,57],{}," tag, load the full stylesheet via ",[26,1141,1142],{},"\u003Clink rel=\"preload\" as=\"style\" onload=\"this.rel='stylesheet'\">",". This removes the render-blocking CSS for the first paint.",[18,1145,1147],{"id":1146},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[45,1149,1150,1162,1173,1183,1192,1206,1220,1238,1250,1262],{},[48,1151,1152,1155,1156,1158,1159,1161],{},[51,1153,1154],{},"Layout thrashing",": alternating ",[26,1157,414],{}," reads and ",[26,1160,425],{}," writes in a loop forces a reflow each iteration. Batch reads (all first) then writes.",[48,1163,1164,1169,1170,1172],{},[51,1165,1166,1168],{},[26,1167,758],{}," on too many elements wastes memory",": each ",[26,1171,758],{}," element gets a GPU layer (RAM). Use only for elements about to animate, remove after.",[48,1174,1175,1182],{},[51,1176,1177,1179,1180],{},[26,1178,832],{}," needs ",[26,1181,896],{},": without it, off-screen elements have 0 height, making the scrollbar inaccurate (jumps as you scroll). The intrinsic size is a placeholder estimate.",[48,1184,1185,1188,1189,1191],{},[51,1186,1187],{},"Render-blocking CSS is intentional",": CSS in ",[26,1190,28],{}," blocks rendering to avoid FOUC. Don't make all CSS async — only non-critical CSS. Inline the critical CSS.",[48,1193,1194,149,1200,363,1202,1205],{},[51,1195,1196,1197,1199],{},"Universal selectors (",[26,1198,776],{},") are slow",[26,1201,362],{},[26,1203,1204],{},"* + * { ... }"," (lobotomized owl) match every element. Use sparingly; modern browsers handle them OK, but they're not free.",[48,1207,1208,149,1211,376,1213,1215,1216,1219],{},[51,1209,1210],{},"Deep descendant selectors",[26,1212,375],{},[26,1214,379],{},". BEM's flat ",[26,1217,1218],{},".block__element"," avoids this.",[48,1221,1222,149,1228,1231,1232,1234,1235,1237],{},[51,1223,1224,1227],{},[26,1225,1226],{},"@import"," is render-blocking and serial",[26,1229,1230],{},"@import url(\"other.css\")"," blocks rendering and loads serially (CSS importing CSS importing CSS). Use ",[26,1233,32],{}," (parallel) or bundle. Avoid ",[26,1236,1226],{}," in production.",[48,1239,1240,1169,1243,606,1245,606,1247,1249],{},[51,1241,1242],{},"GPU layers cost memory",[26,1244,758],{},[26,1246,666],{},[26,1248,754],{}," element gets a layer. 1000 layers = significant RAM. Use on animating elements only.",[48,1251,1252,1257,1258,1261],{},[51,1253,1254,1256],{},[26,1255,975],{}," causes FOUT",": the fallback font shows, then swaps — a flash of unstyled (fallback) text. Acceptable for most sites; ",[26,1259,1260],{},"optional"," avoids the swap but might not load the font.",[48,1263,1264,1267],{},[51,1265,1266],{},"Unused CSS",": large frameworks (Bootstrap) ship CSS you don't use. Purge (PurgeCSS, Tailwind's purge) or tree-shake to reduce file size. Check the Coverage tab in DevTools.",[18,1269,1271],{"id":1270},"spot-the-bug","🧠 Spot the Bug",[14,1273,1274],{},"A developer animates a sidebar's width on toggle, but the animation is janky (stuttering) on mobile:",[89,1276,1277],{"language":306},[93,1278,1280],{"className":309,"code":1279,"language":306,"meta":97,"style":97},".sidebar {\n    width: 250px;\n    transition: width 0.3s ease;\n}\n.sidebar.collapsed {\n    width: 0;\n}\n",[26,1281,1282,1289,1304,1323,1327,1334,1344],{"__ignoreMap":97},[101,1283,1284,1287],{"class":103,"line":104},[101,1285,1286],{"class":161},".sidebar",[101,1288,465],{"class":107},[101,1290,1291,1294,1296,1299,1301],{"class":103,"line":118},[101,1292,1293],{"class":145},"    width",[101,1295,149],{"class":107},[101,1297,1298],{"class":145},"250",[101,1300,877],{"class":237},[101,1302,1303],{"class":107},";\n",[101,1305,1306,1309,1312,1315,1318,1321],{"class":103,"line":129},[101,1307,1308],{"class":145},"    transition",[101,1310,1311],{"class":107},": width ",[101,1313,1314],{"class":145},"0.3",[101,1316,1317],{"class":237},"s",[101,1319,1320],{"class":145}," ease",[101,1322,1303],{"class":107},[101,1324,1325],{"class":103,"line":136},[101,1326,888],{"class":107},[101,1328,1329,1332],{"class":103,"line":158},[101,1330,1331],{"class":161},".sidebar.collapsed",[101,1333,465],{"class":107},[101,1335,1336,1338,1340,1342],{"class":103,"line":168},[101,1337,1293],{"class":145},[101,1339,149],{"class":107},[101,1341,871],{"class":145},[101,1343,1303],{"class":107},[101,1345,1346],{"class":103,"line":176},[101,1347,888],{"class":107},[14,1349,1350],{},"What's wrong and how to fix it?",[1352,1353,1354,1358,1370,1376,1467,1480,1497,1602,1611],"details",{},[1355,1356,1357],"summary",{},"Answer",[14,1359,1360,1361,1363,1364,1366,1367,1369],{},"Animating ",[26,1362,593],{}," triggers ",[51,1365,943],{}," on every frame — the browser recomputes the width of ",[26,1368,1286],{}," and the layout of everything that depends on it (the main content next to it, descendants). On mobile (slower CPUs), this drops frames — janky.",[14,1371,1372,1373,1375],{},"The fix — use ",[26,1374,666],{}," (compositor-only, GPU, no layout):",[93,1377,1379],{"className":309,"code":1378,"language":306,"meta":97,"style":97},".sidebar {\n    width: 250px;\n    transition: transform 0.3s ease;\n    transform: translateX(0);\n}\n.sidebar.collapsed {\n    transform: translateX(-100%);   \u002F* slide out, no layout *\u002F\n}\n",[26,1380,1381,1387,1399,1414,1431,1435,1441,1463],{"__ignoreMap":97},[101,1382,1383,1385],{"class":103,"line":104},[101,1384,1286],{"class":161},[101,1386,465],{"class":107},[101,1388,1389,1391,1393,1395,1397],{"class":103,"line":118},[101,1390,1293],{"class":145},[101,1392,149],{"class":107},[101,1394,1298],{"class":145},[101,1396,877],{"class":237},[101,1398,1303],{"class":107},[101,1400,1401,1403,1406,1408,1410,1412],{"class":103,"line":129},[101,1402,1308],{"class":145},[101,1404,1405],{"class":107},": transform ",[101,1407,1314],{"class":145},[101,1409,1317],{"class":237},[101,1411,1320],{"class":145},[101,1413,1303],{"class":107},[101,1415,1416,1419,1421,1424,1426,1428],{"class":103,"line":136},[101,1417,1418],{"class":145},"    transform",[101,1420,149],{"class":107},[101,1422,1423],{"class":145},"translateX",[101,1425,455],{"class":107},[101,1427,871],{"class":145},[101,1429,1430],{"class":107},");\n",[101,1432,1433],{"class":103,"line":158},[101,1434,888],{"class":107},[101,1436,1437,1439],{"class":103,"line":168},[101,1438,1331],{"class":161},[101,1440,465],{"class":107},[101,1442,1443,1445,1447,1449,1451,1454,1457,1460],{"class":103,"line":176},[101,1444,1418],{"class":145},[101,1446,149],{"class":107},[101,1448,1423],{"class":145},[101,1450,455],{"class":107},[101,1452,1453],{"class":145},"-100",[101,1455,1456],{"class":237},"%",[101,1458,1459],{"class":107},");   ",[101,1461,1462],{"class":132},"\u002F* slide out, no layout *\u002F\n",[101,1464,1465],{"class":103,"line":186},[101,1466,888],{"class":107},[14,1468,1469,1470,1473,1474,1476,1477,1479],{},"::\n",[26,1471,1472],{},"transform: translateX(-100%)"," moves the sidebar visually without changing its layout size — no layout, no paint (compositor-only), 60fps. The main content's layout is unchanged (you may need to also animate the main content's ",[26,1475,666],{}," or use ",[26,1478,599],{}," carefully).",[14,1481,1482,1483,1486,1487,1490,1491,1494,1495,430],{},"Or for a collapsible width that affects the main content, use the ",[26,1484,1485],{},"grid-template-columns"," trick (animate ",[26,1488,1489],{},"1fr"," → ",[26,1492,1493],{},"0fr","), which is smoother than ",[26,1496,593],{},[93,1498,1500],{"className":309,"code":1499,"language":306,"meta":97,"style":97},".layout {\n    display: grid;\n    grid-template-columns: 250px 1fr;\n    transition: grid-template-columns 0.3s ease;\n}\n.layout.collapsed {\n    grid-template-columns: 0fr 1fr;\n}\n.sidebar { overflow: hidden; }\n",[26,1501,1502,1509,1521,1540,1555,1559,1566,1582,1586],{"__ignoreMap":97},[101,1503,1504,1507],{"class":103,"line":104},[101,1505,1506],{"class":161},".layout",[101,1508,465],{"class":107},[101,1510,1511,1514,1516,1519],{"class":103,"line":118},[101,1512,1513],{"class":145},"    display",[101,1515,149],{"class":107},[101,1517,1518],{"class":145},"grid",[101,1520,1303],{"class":107},[101,1522,1523,1526,1528,1530,1532,1535,1538],{"class":103,"line":129},[101,1524,1525],{"class":145},"    grid-template-columns",[101,1527,149],{"class":107},[101,1529,1298],{"class":145},[101,1531,877],{"class":237},[101,1533,1534],{"class":145}," 1",[101,1536,1537],{"class":237},"fr",[101,1539,1303],{"class":107},[101,1541,1542,1544,1547,1549,1551,1553],{"class":103,"line":136},[101,1543,1308],{"class":145},[101,1545,1546],{"class":107},": grid-template-columns ",[101,1548,1314],{"class":145},[101,1550,1317],{"class":237},[101,1552,1320],{"class":145},[101,1554,1303],{"class":107},[101,1556,1557],{"class":103,"line":158},[101,1558,888],{"class":107},[101,1560,1561,1564],{"class":103,"line":168},[101,1562,1563],{"class":161},".layout.collapsed",[101,1565,465],{"class":107},[101,1567,1568,1570,1572,1574,1576,1578,1580],{"class":103,"line":176},[101,1569,1525],{"class":145},[101,1571,149],{"class":107},[101,1573,871],{"class":145},[101,1575,1537],{"class":237},[101,1577,1534],{"class":145},[101,1579,1537],{"class":237},[101,1581,1303],{"class":107},[101,1583,1584],{"class":103,"line":186},[101,1585,888],{"class":107},[101,1587,1588,1590,1592,1595,1597,1600],{"class":103,"line":245},[101,1589,1286],{"class":161},[101,1591,142],{"class":107},[101,1593,1594],{"class":145},"overflow",[101,1596,149],{"class":107},[101,1598,1599],{"class":145},"hidden",[101,1601,155],{"class":107},[14,1603,1469,1604,1490,1607,1610],{},[26,1605,1606],{},"grid-template-columns: 250px 1fr",[26,1608,1609],{},"0fr 1fr"," is interpolable and transitions, resizing the sidebar and main content smoothly. Browser support: Chrome 107+, Safari 16+, Firefox 66+.",[14,1612,1613,1616,1617,1619,1620,415,1622,415,1624,1626,1627,1629,1630,1633],{},[51,1614,1615],{},"The lesson",": animating ",[26,1618,593],{}," (or ",[26,1621,596],{},[26,1623,599],{},[26,1625,605],{},") triggers layout each frame — expensive, janky. Use ",[26,1628,666],{}," (compositor-only) or ",[26,1631,1632],{},"grid-template-columns: Xfr → Yfr"," (interpolable, smooth) for collapsible panels.",[18,1635,1636],{"id":1355},"Summary",[14,1638,1639,1640,1642,1643,606,1645,1647,1648,1109,1650,1652,1653,1655,1656,1658,1659,1661,1662,1664],{},"You can now optimize CSS load (inline critical CSS, preload, minify, avoid ",[26,1641,1226],{},"), understand selector matching (right-to-left, prefer flat BEM selectors), avoid layout thrashing, animate performant properties (",[26,1644,666],{},[26,1646,669],{},"), use ",[26,1649,832],{},[26,1651,900],{}," for rendering optimization, manage GPU layers (",[26,1654,758],{},"), and optimize fonts (",[26,1657,975],{},", preload, ",[26,1660,1010],{},") — with the width-animation trap avoided via ",[26,1663,666],{},". Next: browser compatibility and prefixes.",[124,1666,1667],{},"html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sk71V, html code.shiki .sk71V{--shiki-default:#22863A;--shiki-github-dark:#85E89D}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-d