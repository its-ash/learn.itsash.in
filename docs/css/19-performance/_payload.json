ark","\u002F* Right-to-left: find every \u003Ca>, check if it's in .nav *\u002F\n.nav a { ... }\n\n\u002F* Right-to-left: find every .title, check if it's in .card and .card:hover *\u002F\n.card:hover .title { ... }\n",[26,312,313,318,328,334,339],{"__ignoreMap":97},[101,314,315],{"class":103,"line":104},[101,316,317],{"class":132},"\u002F* Right-to-left: find every \u003Ca>, check if it's in .nav *\u002F\n",[101,319,320,323,326],{"class":103,"line":118},[101,321,322],{"class":161},".nav",[101,324,325],{"class":111}," a",[101,327,165],{"class":107},[101,329,330],{"class":103,"line":129},[101,331,333],{"emptyLinePlaceholder":332},true,"\n",[101,335,336],{"class":103,"line":136},[101,337,338],{"class":132},"\u002F* Right-to-left: find every .title, check if it's in .card and .card:hover *\u002F\n",[101,340,341,344,347],{"class":103,"line":158},[101,342,343],{"class":161},".card:hover",[101,345,346],{"class":161}," .title",[101,348,165],{"class":107},[40,350,352],{"id":351},"selector-performance-tips","Selector performance tips",[45,354,355,368,380,393],{},[48,356,357,149,360,363,364,367],{},[51,358,359],{},"Avoid universal selectors as keys",[26,361,362],{},"* { ... }"," and ",[26,365,366],{},"[class] { ... }"," match every element.",[48,369,370,149,373,376,377,231],{},[51,371,372],{},"Avoid deep descendant combinators",[26,374,375],{},".a .b .c .d .e"," checks 4 ancestors for every ",[26,378,379],{},".e",[48,381,382,149,385,388,389,392],{},[51,383,384],{},"Prefer classes over tag selectors",[26,386,387],{},".btn"," is faster than ",[26,390,391],{},"button"," (fewer matches).",[48,394,395,149,398,401],{},[51,396,397],{},"BEM's flat selectors are optimal",[26,399,400],{},".card__title"," (0,1,0) is a single class — no ancestor checking.",[14,403,404],{},"In practice, selector performance rarely matters (modern browsers are fast). Focus on reducing layout\u002Fpaint\u002Fcompositing costs instead.",[18,406,408],{"id":407},"layout-thrashing","Layout Thrashing",[14,410,411,412,415,416,415,419,422,423,426,427,430],{},"Reading layout properties (",[26,413,414],{},"offsetWidth",", ",[26,417,418],{},"getBoundingClientRect",[26,420,421],{},"getComputedStyle",") forces the browser to flush pending style changes (synchronous reflow). Writing layout properties (setting ",[26,424,425],{},"style.width",") schedules a layout. Alternating reads and writes in a loop (\"layout thrashing\") forces a reflow ",[35,428,429],{},"each iteration",":",[89,432,434],{"language":433},"javascript",[93,435,438],{"className":436,"code":437,"language":433,"meta":97,"style":97},"language-javascript shiki shiki-themes github-light github-dark","\u002F\u002F ❌ layout thrashing\nitems.forEach(item => {\n    item.style.width = item.offsetWidth + 10 + 'px';   \u002F\u002F read (reflow), write (schedule)\n});\n\n\u002F\u002F ✓ batch reads and writes\nconst widths = items.map(item => item.offsetWidth);   \u002F\u002F all reads first\nitems.forEach((item, i) => {\n    item.style.width = widths[i] + 10 + 'px';          \u002F\u002F all writes\n});\n",[26,439,440,445,466,494,499,503,508,537,561,584],{"__ignoreMap":97},[101,441,442],{"class":103,"line":104},[101,443,444],{"class":132},"\u002F\u002F ❌ layout thrashing\n",[101,446,447,450,453,456,460,463],{"class":103,"line":118},[101,448,449],{"class":107},"items.",[101,451,452],{"class":161},"forEach",[101,454,455],{"class":107},"(",[101,457,459],{"class":458},"sCrzJ","item",[101,461,462],{"class":237}," =>",[101,464,465],{"class":107}," {\n",[101,467,468,471,473,476,479,482,485,488,491],{"class":103,"line":129},[101,469,470],{"class":107},"    item.style.width ",[101,472,197],{"class":237},[101,474,475],{"class":107}," item.offsetWidth ",[101,477,478],{"class":237},"+",[101,480,481],{"class":145}," 10",[101,483,484],{"class":237}," +",[101,486,487],{"class":200}," 'px'",[101,489,490],{"class":107},";   ",[101,492,493],{"class":132},"\u002F\u002F read (reflow), write (schedule)\n",[101,495,496],{"class":103,"line":136},[10