[{"data":1,"prerenderedAt":1696},["ShallowReactive",2],{"page-\u002Fcss\u002F19-performance":3},{"id":4,"title":5,"body":6,"description":16,"extension":1690,"meta":1691,"navigation":332,"path":1692,"seo":1693,"stem":1694,"__hash__":1695},"content\u002Fcss\u002F19-performance.md","19 — CSS Performance",{"type":7,"value":8,"toc":1668},"minimark",[9,13,17,22,39,44,84,88,286,293,297,304,349,353,402,405,409,431,588,611,615,734,742,746,760,827,833,889,898,903,936,963,967,1018,1024,1033,1037,1063,1067,1144,1148,1268,1272,1275,1348,1351,1634,1637,1665],[10,11,5],"h1",{"id":12},"_19-css-performance",[14,15,16],"p",{},"CSS performance affects load (parse, render-blocking) and runtime (paint, layout, compositing). Optimizing CSS improves First Contentful Paint (FCP), interaction speed, and scroll smoothness.",[18,19,21],"h2",{"id":20},"render-blocking-css","Render-Blocking CSS",[14,23,24,25,29,30,33,34,38],{},"CSS in ",[26,27,28],"code",{},"\u003Chead>"," (via ",[26,31,32],{},"\u003Clink>",") is render-blocking — the browser waits for the CSS to load and parse before rendering. This is ",[35,36,37],"em",{},"good"," (avoids FOUC — flash of unstyled content), but it means CSS blocks the first paint.",[40,41,43],"h3",{"id":42},"optimization","Optimization",[45,46,47,62,72,78],"ul",{},[48,49,50,54,55,58,59,61],"li",{},[51,52,53],"strong",{},"Inline critical CSS"," — put the above-the-fold CSS in a ",[26,56,57],{},"\u003Cstyle>"," tag in ",[26,60,28],{},", load the rest asynchronously.",[48,63,64,67,68,71],{},[51,65,66],{},"Preload key CSS"," — ",[26,69,70],{},"\u003Clink rel=\"preload\" href=\"styles.css\" as=\"style\" onload=\"this.rel='stylesheet'\">"," loads without blocking, then applies when ready.",[48,73,74,77],{},[51,75,76],{},"Minify CSS"," — remove whitespace\u002Fcomments for smaller files.",[48,79,80,83],{},[51,81,82],{},"HTTP\u002F2 multiplexing"," — split CSS into a few files (by page\u002Fsection) for better caching; HTTP\u002F2 handles parallel downloads. (HTTP\u002F1.1: fewer files to avoid connection limits.)",[40,85,87],{"id":86},"critical-css-inlining","Critical CSS inlining",[89,90,92],"code-wrapper",{"language":91},"html",[93,94,98],"pre",{"className":95,"code":96,"language":91,"meta":97,"style":97},"language-html shiki shiki-themes github-light github-dark","\u003Chead>\n    \u003Cstyle>\n        \u002F* Critical above-the-fold CSS *\u002F\n        body { font-family: sans-serif; }\n        .header { ... }\n        .hero { ... }\n    \u003C\u002Fstyle>\n    \u003Clink rel=\"preload\" href=\"full.css\" as=\"style\" onload=\"this.rel='stylesheet'\">\n    \u003Cnoscript>\u003Clink rel=\"stylesheet\" href=\"full.css\">\u003C\u002Fnoscript>\n\u003C\u002Fhead>\n","",[26,99,100,116,127,134,156,166,174,184,243,276],{"__ignoreMap":97},[101,102,105,109,113],"span",{"class":103,"line":104},"line",1,[101,106,108],{"class":107},"ssxIu","\u003C",[101,110,112],{"class":111},"sk71V","head",[101,114,115],{"class":107},">\n",[101,117,119,122,125],{"class":103,"line":118},2,[101,120,121],{"class":107},"    \u003C",[101,123,124],{"class":111},"style",[101,126,115],{"class":107},[101,128,130],{"class":103,"line":129},3,[101,131,133],{"class":132},"sdCPZ","        \u002F* Critical above-the-fold CSS *\u002F\n",[101,135,137,140,143,147,150,153],{"class":103,"line":136},4,[101,138,139],{"class":111},"        body",[101,141,142],{"class":107}," { ",[101,144,146],{"class":145},"snvgF","font-family",[101,148,149],{"class":107},": ",[101,151,152],{"class":145},"sans-serif",[101,154,155],{"class":107},"; }\n",[101,157,159,163],{"class":103,"line":158},5,[101,160,162],{"class":161},"sIsaT","        .header",[101,164,165],{"class":107}," { ... }\n",[101,167,169,172],{"class":103,"line":168},6,[101,170,171],{"class":161},"        .hero",[101,173,165],{"class":107},[101,175,177,180,182],{"class":103,"line":176},7,[101,178,179],{"class":107},"    \u003C\u002F",[101,181,124],{"class":111},[101,183,115],{"class":107},[101,185,187,189,192,195,198,202,205,