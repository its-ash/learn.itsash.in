05],{},"float: none"," (default).",[108,109,111],"h3",{"id":110},"clearing-floats","Clearing floats",[14,113,114],{},"Floated elements don't contribute to their parent's height (they're out of flow), so the parent collapses:",[31,116,117],{"language":33},[35,118,120],{"className":37,"code":119,"language":33,"meta":39,"style":39},"\u002F* The clearfix hack (legacy) *\u002F\n.clearfix::after {\n    content: \"\";\n    display: table;\n    clear: both;\n}\n\n\u002F* Modern: flow-root *\u002F\n.parent { display: flow-root; }   \u002F* contains floats, no hack needed *\u002F\n",[18,121,122,128,138,153,166,179,185,192,198],{"__ignoreMap":39},[43,123,124],{"class":45,"line":46},[43,125,127],{"class":126},"sdCPZ","\u002F* The clearfix hack (legacy) *\u002F\n",[43,129,131,135],{"class":45,"line":130},2,[43,132,134],{"class":133},"sIsaT",".clearfix::after",[43,136,137],{"class":53}," {\n",[43,139,141,144,146,150],{"class":45,"line":140},3,[43,142,143],{"class":57},"    content",[43,145,61],{"class":53},[43,147,149],{"class":148},"sJ6F3","\"\"",[43,151,152],{"class":53},";\n",[43,154,156,159,161,164],{"class":45,"line":155},4,[43,157,158],{"class":57},"    display",[43,160,61],{"class":53},[43,162,163],{"class":57},"table",[43,165,152],{"class":53},[43,167,169,172,174,177],{"class":45,"line":168},5,[43,170,171],{"class":57},"    clear",[43,173,61],{"class":53},[43,175,176],{"class":57},"both",[43,178,152],{"class":53},[43,180,182],{"class":45,"line":181},6,[43,183,184],{"class":53},"}\n",[43,186,188],{"class":45,"line":187},7,[43,189,191],{"emptyLinePlaceholder":190},true,"\n",[43,193,195],{"class":45,"line":194},8,[43,196,197],{"class":126},"\u002F* Modern: flow-root *\u002F\n",[43,199,201,204,206,209,211,214,217],{"class":45,"line":200},9,[43,202,203],{"class":133},".parent",[43,205,54],{"class":53},[43,207,208],{"class":57},"display",[43,210,61],{"class":53},[43,212,213],{"class":57},"flow-root",[43,215,216],{"class":53},"; }   ",[43,218,219],{"class":126},"\u002F* contains