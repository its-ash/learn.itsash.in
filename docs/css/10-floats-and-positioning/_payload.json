,683,685,686,98,688,98,690,692,693,695],{},[18,684,403],{}," creates a stacking context without needing ",[18,687,260],{},[18,689,20],{},[18,691,379],{}," — useful for isolating a component's stacking (its children's ",[18,694,20],{}," don't leak out).",[23,697,699],{"id":698},"tips-tricks","💡 Tips & Tricks",[342,701,702,711,743,753,769],{},[345,703,704,707,708,710],{},[334,705,706],{},"Idiom",": use ",[18,709,224],{}," to contain floats (the modern clearfix) — it establishes a block formatting context, so the parent's height includes floated children, no hack needed. Reserve floats for their original purpose: wrapping text around an image.",[345,712,713,715,716,718,719,380,721,380,724,727,728,380,731,734,735,439,737,739,740,742],{},[334,714,706],{},": avoid ",[18,717,20],{}," wars — use low, documented values (",[18,720,610],{},[18,722,723],{},"20",[18,725,726],{},"30",") or a design-token scale (",[18,729,730],{},"--z-modal",[18,732,733],{},"--z-dropdown","), and understand stacking contexts. A ",[18,736,438],{},[18,738,442],{}," parent can't beat a ",[18,741,446],{}," sibling of the parent.",[345,744,745,707,747,749,750,752],{},[334,746,706],{},[18,748,403],{}," to create a stacking context without positioning — it traps a component's ",[18,751,20],{}," within itself, preventing leaks. Useful for components that shouldn't interact with the page's stacking order.",[345,754,755,707,757,759,760,762,763,765,766,768],{},[334,756,706],{},[18,758,389],{}," for non-rectangular clipping (circles, polygons, SVG paths) — it's animatable and far more flexible than ",[18,761,506],{},". ",[18,764,506],{}," is for rectangular clipping; ",[18,767,389],{}," is for shapes.",[345,770,771,774,775,777,778,380,780,380,782,380,784,786,787,789,790,792],{},[334,772,773],{},"Debug",": when ",[18,776,438],{}," isn't appearing above something, check the ancestor chain for stacking-context creators (",[18,779,379],{},[18,781,374],{},[18,783,363],{},[18,785,383],{},") — the ancestor's stacking context traps the child's ",[18,788,20],{},". The fix is the ancestor's ",[18,791,20],{}," or removing the creator.",[23,794,796],{"id":795},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[342,798,799,808,819,837,850,864,875,883,901,919],{},[345,800,801,804,805,807],{},[334,802,803],{},"Floats don't contribute to parent height",": a parent of floated children collapses (height 0). Use ",[18,806,224],{}," or the clearfix hack.",[345,809,810,815,816,818],{},[334,811,812],{},[18,813,814],{},"clear: both"," is the old way to push an element below floats — ",[18,817,224],{}," on the parent is the modern way.",[345,820,821,826,827,829,830,439,832,834,835,742],{},[334,822,823,824],{},"Stacking context traps ",[18,825,20],{},": a child's ",[18,828,20],{}," is relative to its stacking context. ",[18,831,438],{},[18,833,442],{}," parent is below a ",[18,836,446],{},[345,838,839,844,845,847,848,325],{},[334,840,841,843],{},[18,842,363],{}," always creates a stacking context",": regardless of ",[18,846,20],{},". So fixed elements trap their children's ",[18,849,20],{},[345,851,852,61,857,860,861,863],{},[334,853,854,856],{},[18,855,374],{}," creates a stacking context",[18,858,859],{},"opacity: 0.99"," on a parent traps children's ",[18,862,20],{}," — a surprise when you fade in a parent and the children's z-order changes.",[345,865,866,870,871,874],{},[334,867,868,856],{},[18,869,379],{},": the same surprise. Adding ",[18,872,873],{},"transform: translateZ(0)"," (a common \"GPU acceleration\" hack) changes the stacking order.",[345,876,877,882],{},[334,878,879,881],{},[18,880,389],{}," doesn't affect layout",": the element's box is unchanged; only the visible area is clipped. The element still takes its normal space.",[345,884,885,826,890,893,894,896,897,900],{},[334,886,887,889],{},[18,888,506],{}," clips shadows and transforms",[18,891,892],{},"box-shadow"," extending outside an ",[18,895,506],{}," parent is clipped. Use ",[18,898,899],{},"overflow: clip"," (no scroll container) or restructure.",[345,902,903,61,908,911,912,914,915,918],{},[334,904,905,907],{},[18,906,20],{}," only works on positioned elements",[18,909,910],{},"z-index: 10"," on a ",[18,913,324],{}," element does nothing. Set ",[18,916,917],{},"position: relative"," (or others).",[345,920,921,61,926,929],{},[334,922,923,924],{},"Negative ",[18,925,20],{},[18,927,928],{},"z-index: -1"," puts the element behind its parent's background (if the parent doesn't create a stacking context). Useful for decorative elements behind content.",[23,931,933],{"id":932},"spot-the-bug","🧠 Spot the Bug",[14,935,936,937,939,940,943],{},"A modal with ",[18,938,438],{}," is appearing behind a dropdown with ",[18,941,942],{},"z-index: 100",":",[31,945,946],{"language":33},[35,947,949],{"className":37,"code":948,"language":33,"meta":39,"style":39},".app { transform: translateZ(0); }   \u002F* \"GPU acceleration\" *\u002F\n.modal { position: fixed; z-index: 9999; }   \u002F* inside .app in the DOM *\u002F\n.dropdown { position: fixed; z-index: 100; } \u002F* outside .app *\u002F\n",[18,950,951,975,1001],{"__ignoreMap":39},[43,952,953,956,958,960,962,965,967,969,972],{"class":45,"line":46},[43,954,955],{"class":133},".app",[43,957,54],{"class":53},[43,959,379],{"class":57},[43,961,61],{"class":53},[43,963,964],{"class":57},"translateZ",[43,966,535],{"class":53},[43,968,75],{"class":57},[43,970,971],{"class":53},"); }   ",[43,973,974],{"class":126},"\u002F* \"GPU acceleration\" *\u002F\n",[43,976,977,979,981,983,985,987,989,991,993,996,998],{"class":45,"line":130},[43,978,255],{"class":133},[43,980,54],{"class":53},[43,982,260],{"class":57},[43,984,61],{"class":53},[43,986,265],{"class":57},[43,988,67],{"class":53},[43,990,20],{"class":57},[43,992,61],{"class":53},[43,994,995],{"class":57},"9999",[43,997,216],{"class":53},[43,999,1000],{"class":126},"\u002F* inside .app in the DOM *\u002F\n",[43,1002,1003,1006,1008,1010,1012,1014,1016,1018,1020,1022,1025],{"class":45,"line":140},[43,1004,1005],{"class":133},".dropdown",[43,1007,54],{"class":53},[43,1009,260],{"class":57},[43,1011,61],{"class":53},[43,1013,265],{"class":57},[43,1015,67],{"class":53},[43,1017,20],{"class":57},[43,1019,61],{"class":53},[43,1021,571],{"class":57},[43,1023,1024],{"class":53},"; } ",[43,1026,1027],{"class":126},"\u002F* outside .app *\u002F\n",[14,1029,1030],{},"What's happening?",[1032,1033,1034,1038,1063,1090,1101,1230],"details",{},[1035,1036,1037],"summary",{},"Answer",[14,1039,1040,1042,1043,1045,1046,1048,1049,1051,1052,1059,1060,1062],{},[18,1041,955],{}," has ",[18,1044,873],{},", which creates a stacking context. The modal is inside ",[18,1047,955],{}," in the DOM, so its ",[18,1050,438],{}," is ",[1053,1054,1055,1056,1058],"em",{},"relative to ",[18,1057,955],{},"'s stacking context",". The dropdown is outside ",[18,1061,955],{},", at the root level.",[14,1064,1065,1066,1068,1069,1071,1072,1075,1076,1078,1079,1081,1082,1084,1085,1087,1088,325],{},"The root-level stacking context compares: ",[18,1067,955],{}," (with its transform-created context, no explicit ",[18,1070,20],{}," → ",[18,1073,1074],{},"z-index: auto",", treated as 0 for comparison) vs ",[18,1077,1005],{}," (",[18,1080,942],{},"). The dropdown (100) beats ",[18,1083,955],{}," (0), so the dropdown is in front of ",[18,1086,955],{}," and all its descendants — including the modal, regardless of the modal's ",[18,1089,438],{},[14,1091,1092,1093,1095,1096,1098,1099,943],{},"The fix — give ",[18,1094,955],{}," a ",[18,1097,20],{}," higher than the dropdown, or move the modal outside ",[18,1100,955],{},[35,1102,1104],{"className":37,"code":1103,"language":33,"meta":39,"style":39},"\u002F* Option 1: raise .app's z-index above the dropdown *\u002F\n.app { transform: translateZ(0); position: relative; z-index: 1000; }\n\u002F* Now .app (1000) > .dropdown (100), and the modal (9999 within .app) is in front. *\u002F\n\n\u002F* Option 2: move the modal outside .app in the DOM *\u002F\n\u003Cbody>\n    \u003Cdiv clas