0.01ms !important;\n    }\n}\n",[36,1098,1099,1107,1114,1132,1145,1160,1165],{"__ignoreMap":34},[39,1100,1101,1104],{"class":41,"line":42},[39,1102,1103],{"class":84},"@media",[39,1105,1106],{"class":49}," (prefers-reduced-motion: reduce) {\n",[39,1108,1109,1112],{"class":41,"line":53},[39,1110,1111],{"class":174},"    *",[39,1113,50],{"class":49},[39,1115,1116,1119,1121,1124,1127,1130],{"class":41,"line":69},[39,1117,1118],{"class":56},"        animation-duration",[39,1120,60],{"class":49},[39,1122,1123],{"class":56},"0.01",[39,1125,1126],{"class":84},"ms",[39,1128,1129],{"class":84}," !important",[39,1131,66],{"class":49},[39,1133,1134,1137,1139,1141,1143],{"class":41,"line":103},[39,1135,1136],{"class":56},"        animation-iteration-count",[39,1138,60],{"class":49},[39,1140,530],{"class":56},[39,1142,1129],{"class":84},[39,1144,66],{"class":49},[39,1146,1147,1150,1152,1154,1156,1158],{"class":41,"line":109},[39,1148,1149],{"class":56},"        transition-duration",[39,1151,60],{"class":49},[39,1153,1123],{"class":56},[39,1155,1126],{"class":84},[39,1157,1129],{"class":84},[39,1159,66],{"class":49},[39,1161,1162],{"class":41,"line":117},[39,1163,1164],{"class":49},"    }\n",[39,1166,1167],{"class":41,"line":129},[39,1168,106],{"class":49},[14,1170,1171],{},"Respect the user's OS preference for reduced motion. Disable or shorten animations.",[18,1173,1175],{"id":1174},"tips-tricks","💡 Tips & Tricks",[221,1177,1178,1209,1218,1232,1243],{},[224,1179,1180,1183,1184,925,1186,1188,1189,372,1191,372,1193,372,1195,1197,1198,1201,1202,332,1204,1201,1207,354],{},[386,1181,1182],{},"Idiom",": animate ",[36,1185,331],{},[36,1187,335],{}," for 60fps — they're compositor-only (GPU), no layout\u002Fpaint. Avoid ",[36,1190,359],{},[36,1192,362],{},[36,1194,371],{},[36,1196,375],{}," (trigger layout). Use ",[36,1199,1200],{},"transform: scaleY()"," instead of ",[36,1203,362],{},[36,1205,1206],{},"transform: translateX()",[36,1208,375],{},[224,1210,1211,1213,1214,1217],{},[386,1212,1182],{},": use ",[36,1215,1216],{},"cubic-bezier(0.34, 1.56, 0.64, 1)"," for an overshoot\u002Fbounce — the y-value >1 causes the animation to go past the target and settle. This gives a playful, spring-like feel.",[224,1219,1220,1213,1222,1225,1226,1228,1229,1231],{},[386,1221,1182],{},[36,1223,1224],{},"animation-fill-mode: forwards"," (or ",[36,1227,885],{},") to retain the end state — without it, the element snaps back to its pre-animation state after the animation ends. ",[36,1230,885],{}," also applies the start state during the delay.",[224,1233,1234,1213,1236,1238,1239,1242],{},[386,1235,1182],{},[36,1237,1089],{}," to disable animations for sensitive users — ",[36,1240,1241],{},"@media (prefers-reduced-motion: reduce) { * { animation: none; transition: none; } }"," respects the OS preference. Accessibility for vestibular disorders.",[224,1244,1245,1213,1247,1249,1250,1253],{},[386,1246,1182],{},[36,1248,1057],{}," sparingly as a hint before animating — ",[36,1251,1252],{},"will-change: transform"," tells the browser to GPU-optimize. But don't leave it on permanently (wastes memory) or add it to many elements. Add it before the animation, remove after.",[18,1255,1257],{"id":1256},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[221,1259,1260,1278,1303,1326,1341,1353,1365,1376,1395,1407],{},[224,1261,1262,1268,1269,1273,1274,1277],{},[386,1263,1264,1267],{},[36,1265,1266],{},"transition: all"," is a footgun",": it animates ",[1270,1271,1272],"em",{},"every"," property change, including unexpected ones (like ",[36,1275,1276],{},"background-image"," on hover, which doesn't transition smoothly). List specific properties.",[224,1279,1280,60,1288,1291,1292,1295,1296,1298,1299,1302],{},[386,1281,1282,1284,1285],{},[36,1283,158],{}," doesn't work on ",[36,1286,1287],{},"display",[36,1289,1290],{},"display: none"," → ",[36,1293,1294],{},"block"," can't transition (it's not interpolable). Use ",[36,1297,335],{}," + ",[36,1300,1301],{},"visibility",", or animate a transform.",[224,1304,1305,60,1312,1291,1315,1318,1319,1322,1323,1325],{},[386,1306,1307,1284,1309],{},[36,1308,158],{},[36,1310,1311],{},"height: auto",[36,1313,1314],{},"height: 0",[36,1316,1317],{},"auto"," can't interpolate (auto isn't a length). Use ",[36,1320,1321],{},"max-height"," (a large value), ",[36,1324,1200],{},", or measure with JS and set a fixed height.",[224,1327,1328,1336,1337,1340],{},[386,1329,1330,1331,372,1333,1335],{},"Animating ",[36,1332,359],{},[36,1334,362],{}," triggers layout",": every frame, the browser recomputes the layout of the element and its descendants — expensive, can drop frames. Use ",[36,1338,1339],{},"transform: scale()"," instead.",[224,1342,1343,1349,1350,1352],{},[386,1344,1345,1348],{},[36,1346,1347],{},"animation-fill-mode: none"," (default) snaps back",": after the animation, the element returns to its pre-animation state. Use ",[36,1351,879],{}," to keep the end state.",[224,1354,1355,60,1361,1364],{},[386,1356,1357,1358,1360],{},"Negative ",[36,1359,835],{}," starts mid-animation",[36,1362,1363],{},"animation-delay: -1s"," with a 2s animation starts it at the 1-second mark (already halfway). Useful for staggered animations that should appear already in progress.",[224,1366,1367,1372,1373,1375],{},[386,1368,1369,1371],{},[36,1370,1057],{}," on too many elements wastes memory",": each ",[36,1374,1057],{}," element gets a GPU layer. Use it only for elements about to animate, and remove it after.",[224,1377,1378,1390,1391,1394],{},[386,1379,1380,1382,1383,372,1386,1389],{},[36,1381,539],{}," with no ",[36,1384,1385],{},"from",[36,1387,1388],{},"0%"," uses the element's current state",": if you only specify ",[36,1392,1393],{},"to { ... }",", the animation starts from the element's computed style. Useful for \"animate to this state\" without duplicating the start.",[224,1396,1397,60,1403,1406],{},[386,1398,1399,1402],{},[36,1400,1401],{},"steps()"," for sprite animation",[36,1404,1405],{},"steps(8)"," with a sprite sheet background animates frame-by-frame — the classic CSS sprite animation technique.",[224,1408,1409,1414],{},[386,1410,1411,1413],{},[36,1412,158],{}," only animates the next change",": if a property changes and then changes back before the transition completes, the transition reverses from the current (mid-transition) state. This is usually desired.",[18,1416,1418],{"id":1417},"spot-the-bug","🧠 Spot the Bug",[14,1420,1421],{},"A developer makes a dropdown that expands on click, but the animation is janky (stuttering):",[26,1423,1424],{"language":28},[30,1425,1427],{"className":32,"code":1426,"language":28,"meta":34,"style":34},".menu { height: 0; overflow: hidden; transition: height 0.3s ease; }\n.menu.open { height: 200px; }\n",[36,1428,1429,1465],{"__ignoreMap":34},[39,1430,1431,1433,1435,1437,1439,1441,1443,1446,1448,1451,1453,1455,1457,1459,1461,1463],{"class":41,"line":42},[39,1432,425],{"class":45},[39,1434,428],{"class":49},[39,1436,362],{"class":56},[39,1438,60],{"class":49},[39,1440,501],{"class":56},[39,1442,489],{"class":49},[39,1444,1445],{"class":56},"overflow",[39,1447,60],{"class":49},[39,1449,1450],{"class":56},"hidden",[39,1452,489],{"class":49},[39,1454,158],{"class":56},[39,1456,433],{"class":49},[39,1458,436],{"class":56},[39,1460,85],{"class":84},[39,1462,88],{"class":56},[39,1464,441],{"class":49},[39,1466,1467,1469,1471,1473,1475,1477,1479],{"class":41,"line":53},[39,1468,446],{"class":45},[39,1470,428],{"class":49},[39,1472,362],{"class":56},[39,1474,60],{"class":49},[39,1476,455],{"class":56},[39,1478,458],{"class":84},[39,1480,441],{"class":49},[14,1482,1483],{},"What's wrong and how to fix it?",[1485,1486,1487,1491,1494,1528,1534,1606,1616,1705,1716],"details",{},[1488,1489,1490],"summary",{},"Answer",[14,1492,1493],{},"Two issues:",[1495,1496,1497,1508],"ol",{},[224,1498,1499,1504,1505,1507],{},[386,1500,1501,1503],{},[36,1502,362],{}," triggers layout on every frame"," — the browser recomputes the layout of ",[36,1506,425],{}," and its descendants each frame, which is expensive and can drop frames (janky).",[224,1509,1510,1521,1522,1524,1525,1527],{},[386,1511,1512,1291,1514,1517,1518,1520],{},[36,1513,1314],{},[36,1515,1516],{},"200px"," works, but ",[36,1519,1311],{}," (content-based) doesn't transition"," — if the developer later changes to ",[36,1523,1311],{}," (to fit content), the transition breaks (",[36,1526,1317],{}," isn't interpolable).",[14,1529,1530,1531,1533],{},"The fix — use ",[36,1532,1200],{}," (compositor-only, GPU-accelerated, no layout):",[30,1535,1537],{"className":32,"code":1536,"language":28,"meta":34,"style":34},".menu {\n    transform: scaleY(0);\n    transform-origin: top;\n    transition: transform 0.3s ease;\n}\n.menu.open { transform: scaleY(1); }\n",[36,1538,1539,1545,1559,1570,1584,1588],{"__ignoreMap":34},[39,1540,1541,1543],{"class":41,"line":42},[39,1542,425],{"class":45},[39,1544,50],{"class":49},[39,1546,1547,1549,1551,1553,1555,1557],{"class":41,"line":53},[39,1548,132],{"class":56},[39,1550,60],{"class":49},[39,1552,496],{"class":56},[39,1554,140],{"class":49},[39,1556,501],{"class":56},[39,1558,146],{"class":49},[39,1560,1561,1564,1566,1568],{"class":41,"line":69},[39,1562,1563],{"class":56},"    transform-origin",[39,1565,60],{"class":49},[39,1567,371],{"class":56},[39,1569,66],{"class":49},[39,1571,1572,1574,1576,1578,1580,1582],{"class":41,"line":103},[39,1573,72],{"class":56},[39,1575,482],{"class":49},[39,1577,436],{"class":56},[39,1579,85],{"class":84},[39,1581,88],{"class":56},[39,1583,66],{"class":49},[39,1585,1586],{"class":41,"line":109},[39,1587,106],{"class":49},[39,1589,1590,1592,1594,1596,1598,1600,1602,1604],{"class":41,"line":117},[39,1591,446],{"class":45},[39,1593,428],{"class":49},[39,1595,331],{"class":56},[39,1597,60],{"class":49},[39,1599,496],{"class":56},[39,1601,140],{"class":49},[39,1603,530],{"class":56},[39,1605,533],{"class":49},[14,1607,1608,1609,1291,1612,1615],{},"::\nOr use ",[36,1610,1611],{},"grid-template-rows: 0fr",[36,161