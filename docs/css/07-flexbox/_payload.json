:42},".card",[36,1145,399],{"class":46},[36,1147,60],{"class":53},[36,1149,57],{"class":46},[36,1151,560],{"class":53},[36,1153,1154],{"class":53}," 1",[36,1156,1157],{"class":53}," 300",[36,1159,721],{"class":563},[36,1161,408],{"class":46},[36,1163,1164],{"class":66},"\u002F* grow\u002Fshrink, base 300px *\u002F\n",[18,1166,1168],{"id":1167},"tips-tricks","💡 Tips & Tricks",[759,1170,1171,1192,1213,1245,1260],{},[762,1172,1173,1176,1177,1180,1181,1184,1185,1184,1188,1191],{},[799,1174,1175],{},"Idiom",": use ",[33,1178,1179],{},"display: flex; justify-content: center; align-items: center;"," for centering — it's the one-line-each-way centering solution (horizontal + vertical), replacing the old ",[33,1182,1183],{},"margin: auto","\u002F",[33,1186,1187],{},"position: absolute",[33,1189,1190],{},"transform"," hacks. Set a height on the container for vertical centering to have space.",[762,1193,1194,1176,1196,1198,1199,1202,1203,1206,1207,1209,1210,1212],{},[799,1195,1175],{},[33,1197,525],{}," for spacing flex\u002Fgrid items — ",[33,1200,1201],{},"gap: 1rem"," is cleaner than ",[33,1204,1205],{},"margin"," on each item + ",[33,1208,628],{}," to avoid trailing margin. ",[33,1211,525],{}," handles wrapping correctly (no trailing gap on wrapped lines) and works in flex, grid, and multi-column.",[762,1214,1215,1217,1218,1220,1221,1223,1224,1223,1226,1228,1229,1184,1231,1184,1234,1237,1238,1241,1242,1244],{},[799,1216,1175],{},": use the ",[33,1219,60],{}," shorthand (",[33,1222,766],{},", ",[33,1225,794],{},[33,1227,785],{},") over individual ",[33,1230,810],{},[33,1232,1233],{},"flex-shrink",[33,1235,1236],{},"flex-basis"," — it's clearer, covers the common cases, and avoids the ",[33,1239,1240],{},"flex-basis: auto"," default surprise. ",[33,1243,766],{}," (grow equally, basis 0) is the standard for equal-width items.",[762,1246,1247,1176,1249,1252,1253,1255,1256,1259],{},[799,1248,1175],{},[33,1250,1251],{},"flex: 0 0 \u003Csize>"," for fixed-width items and ",[33,1254,766],{}," for the fluid content — ",[33,1257,1258],{},"sidebar { flex: 0 0 250px } content { flex: 1 }"," gives a fixed sidebar and a fluid content area, the classic app layout.",[762,1261,1262,1264],{},[799,1263,1175],{},": use Flexbox for one-dimensional layouts (a row or a column) and Grid for two-dimensional (rows and columns) — flexbox is for \"a row of items\" or \"a column of items\"; grid is for \"a 2D grid of items.\" Many layouts combine both (a grid of cards, each card a flexbox).",[18,1266,1268],{"id":1267},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[759,1270,1271,1295,1320,1336,1350,1367,1381,1390,1403,1421],{},[762,1272,1273,57,1281,1283,1284,1286,1287,1289,1290,1292,1293,865],{},[799,1274,1275,1277,1278],{},[33,1276,766],{}," vs ",[33,1279,1280],{},"flex: 1 1 auto",[33,1282,766],{}," is ",[33,1285,770],{}," (basis 0 — items share space equally regardless of content); ",[33,1288,1280],{}," (or ",[33,1291,776],{},") uses content size as the basis (items grow from their content size). For equal-width, use ",[33,1294,766],{},[762,1296,1297,1308,1309,1312,1313,1315,1316,1319],{},[799,1298,1299,1301,1302,1184,1305],{},[33,1300,1240],{}," uses ",[33,1303,1304],{},"width",[33,1306,1307],{},"height",": if you set ",[33,1310,1311],{},"width: 200px"," and ",[33,1314,1240],{},", the basis is 200px. If ",[33,1317,1318],{},"flex-basis: 0%",", the width is ignored (basis is 0).",[762,1321,1322,1328,1329,1289,1332,1335],{},[799,1323,1324,1327],{},[33,1325,1326],{},"min-width: auto"," (default) prevents shrinking below content size",": flex items won't shrink below their content's minimum width by default, which can cause overflow. Set ",[33,1330,1331],{},"min-width: 0",[33,1333,1334],{},"overflow: hidden",") to allow shrinking.",[762,1337,1338,57,1343,1346,1347,1349],{},[799,1339,1340,1342],{},[33,1341,868],{}," is visual only — DOM order unchanged",[33,1344,1345],{},"order: -1"," moves an item first visually, but tab order and screen reader order follow the DOM. Don't use ",[33,1348,868],{}," for meaningful reordering.",[762,1351,1352,1358,1359,1362,1363,1366],{},[799,1353,1354,1357],{},[33,1355,1356],{},"align-items: stretch"," (default) can distort items",": items stretch to fill the cross axis. For images, this can distort them — set ",[33,1360,1361],{},"align-items: flex-start"," or ",[33,1364,1365],{},"align-self: start"," on the image.",[762,1368,1369,1377,1378,1380],{},[799,1370,1371,1372,1184,1375],{},"Flexbox and ",[33,1373,1374],{},"min-height",[33,1376,1307],{},": a flex container with ",[33,1379,1356],{}," (default) stretches items to the container's cross-axis size. If the container has no explicit height, it's the content's height — items may not stretch as expected.",[762,1382,1383,1386,1387,1389],{},[799,1384,1385],{},"Nested flex containers",": a flex item can itself be a flex container — ",[33,1388,95],{}," on an item makes its children flex items. This is how you build complex layouts (a flex row of flex columns).",[762,1391,1392,57,1397,1399,1400,1402],{},[799,1393,1394,1396],{},[33,1395,525],{}," and older Safari",[33,1398,525],{}," in flexbox shipped in Safari 14.1 (2021). For older browsers, use margins. Modern projects can assume ",[33,1401,525],{}," support.",[762,1404,1405,1411,1412,1415,1416,1362,1419,865],{},[799,1406,1407,1410],{},[33,1408,1409],{},"flex-wrap: nowrap"," (default) can overflow",": items shrink to fit, but if they have ",[33,1413,1414],{},"min-width"," or content that can't shrink, they overflow. Use ",[33,1417,1418],{},"flex-wrap: wrap",[33,1420,1331],{},[762,1422,1423,1428,1429,1432,1433,1435,1436,1438],{},[799,1424,1425,1427],{},[33,1426,172],{}," has no effect if items fill the container",": if ",[33,1430,1431],{},"flex-grow: 1"," items fill the space, there's no free space for ",[33,1434,172],{}," to distribute. ",[33,1437,172],{}," only matters when items are smaller than the container.",[18,1440,1442],{"id":1441},"spot-the-bug","🧠 Spot the Bug",[14,1444,1445,1446,1448],{},"A developer has a flex row of three items, each ",[33,1447,766],{},", but one item has long content and doesn't shrink — the row overflows:",[23,1450,1451],{"language":25},[27,1452,1454],{"className":29,"code":1453,"language":25,"meta":31,"style":31},".row { display: flex; }\n.item { flex: 1; }\n",[33,1455,1456,1471],{"__ignoreMap":31},[36,1457,1458,1461,1463,1465,1467,1469],{"class":38,"line":39},[36,1459,1460],{"class":42},".row",[36,1462,399],{"class":46},[36,1464,827],{"class":53},[36,1466,57],{"class":46},[36,1468,60],{"class":53},[36,1470,451],{"class":46},[36,1472,1473,1475,1477,1479,1481,1483],{"class":38,"line":50},[36,1474,396],{"class":42},[36,1476,399],{"class":46},[36,1478,60],{"class":53},[36,1480,57],{"class":46},[36,1482,560],{"class":53},[36,1484,451],{"class":46},[14,1486,1487],{},"What's wrong, and how do you fix it?",[1489,1490,1491,1495,1503,1511,1555,1558,1595,1606],"details",{},[1492,1493,1494],"summary",{},"Answer",[14,1496,1497,1498,1500,1501,865],{},"Flex items have ",[33,1499,1326],{}," by default, which means they won't shrink below their content's minimum size. An item with long, unbreakable content (a long word, a URL) can't shrink below that content's width, so it overflows the container even with ",[33,1502,766],{},[14,1504,1505,1506,1289,1508,1510],{},"The fix — set ",[33,1507,1331],{},[33,1509,1334],{},") on the flex items to allow shrinking below content size:",[27,1512,1514],{"className":29,"code":1513,"language":25,"meta":31,"style":31},".row { display: flex; }\n.item { flex: 1; min-width: 0; }   \u002F* allow shrinking below content *\u002F\n",[33,1515,1516,1530],{"__ignoreMap":31},[36,1517,1518,1520,1522,1524,1526,1528],{"class":38,"line":39},[36,1519,1460],{"class":42},[36,1521,399],{"class":46},[36,1523,827],{"class":53},[36,1525,57],{"class":46},[36,1527,60],{"class":53},[36,1529,451],{"class":46},[36,1531,1532,1534,1536,1538,1540,1542,1544,1546,1548,1550,1552],{"class":38,"line":50},[36,1533,396],{"class":42},[36,1535,399],{"class":46},[36,1537,60],{"class":53},[36,1539,57],{"class":46},[36,1541,560],{"class":53},[36,1543,245],{"class":46},[36,1545,1414],{"class":53},[36,1547,57],{"class":46},[36,1549,1062],{"class":53},[36,1551,408],{"class":46},[36,1553,1554],{"class":66},"\u002F* allow shrinking below content *\u002F\n",[14,1556,1557],{},"::\nOr, for text content, allow word-breaking:",[27,1559,1561],{"className":29,"code":1560,"language":25,"meta":31,"style":31},".item { flex: 1; min-width: 0; overflow-wrap: break-word; }\n",[33,1562,1563],{"__ignoreMap":31},[36,1564,1565,1567,1569,1571,1573,1575,1577,1579,1581,1583,1585,1588,1590,1593],{"class":38,"line":39},[36,1566,396],{"class":42},[36,1568,399],{"class":46},[36,1570,60],{"class":53},[36,1572,57],{"class":46},[36,1574,560],{"class":53},[36,1576,245],{"class":46},[36,1578,1414],{"class":53},[36,1580,57],{"class":46},[36,1582,1062],{"class":53},[36,1584,245],{"class":46},[36,1586,1587],{"class":53},"overflow-wrap",[36,1589,57],{"class":46},[36,1591,1592],{"class":53},"break-word",[36,1594,451],{"class":46},[14,1596,1597,1598,1600,1601,1603,1604,865],{},"::\n",[33,1599,1331],{}," overrides the default ",[33,1602,684],{},", letting the item shrink as flex intends. This is one of the most common flexbox bugs — \"my flex items won't shrink\" is almost always ",[33,1605,1326],{},[14,1607,1608,1611,1612,1614,1615,1617],{},[799,1609,1610],{},"The lesson",": flex items have ",[33,1613,1326],{}," by default (won't shrink below content). Set ",[33,1616,1331],{}," to allow shrinking, especially for items with long text content.",[18,1619,1620],{"id":1492},"Summary",[14,1622,1623,1624,1184,1626,1184,1628,1630,1631,1633,1634,1312,1636,1277,1638,1640],{},"You can now build flex layouts (direction, justify\u002Falign, wrap, gap), size items with ",[33,1625,766],{},[33,1627,794],{},[33,1629,785],{},", reorder with ",[33,1632,868],{}," (visual only), and build common patterns (centering, navbars, sidebar+content, card grids) — while avoiding the ",[33,1635,1326],{},[33,1637,766],{},[33,1639,776],{}," traps. Next: CSS Grid — two-dimensional layout.",[1642,1643,1644],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}",{"title":31,"searchDepth":50,"depth":50,"links":1646},[1647,1650,1660,1661,1662,1668,1669,1675,1676,1677,1678],{"id":20,"depth":50,"text":21,"children":1648},[1649],{"id":100,"depth":70,"text":100},{"id":165,"depth":50,"text":166,"children":1651},[1652,1654,1656,1658],{"id":169,"depth":70,"text":1653},"justify-content — alignment along the main axis",{"id":2