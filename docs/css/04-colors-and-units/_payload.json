],"span",{"class":34,"line":35},"line",1,[32,37,39],{"class":38},"sdCPZ","\u002F* Hex *\u002F\n",[32,41,43,47,51],{"class":34,"line":42},2,[32,44,46],{"class":45},"ssxIu","color: ",[32,48,50],{"class":49},"sMKGj","#ff0000;",[32,52,53],{"class":38},"        \u002F* red *\u002F\n",[32,55,57,59,62],{"class":34,"line":56},3,[32,58,46],{"class":45},[32,60,61],{"class":49},"#f00;",[32,63,64],{"class":38},"           \u002F* abbreviated *\u002F\n",[32,66,68,70,73],{"class":34,"line":67},4,[32,69,46],{"class":45},[32,71,72],{"class":49},"#ff0000ff;",[32,74,75],{"class":38},"      \u002F* 8-digit hex with alpha (ff = opaque) *\u002F\n",[32,77,79],{"class":34,"line":78},5,[32,80,82],{"emptyLinePlaceholder":81},true,"\n",[32,84,86],{"class":34,"line":85},6,[32,87,88],{"class":38},"\u002F* RGB \u002F RGBA *\u002F\n",[32,90,92],{"class":34,"line":91},7,[32,93,94],{"class":45},"color: rgb(255, 0, 0);\n",[32,96,98,101,105,108],{"class":34,"line":97},8,[32,99,100],{"class":45},"color: rgba(255, 0, 0, 0",[32,102,104],{"class":103},"sIsaT",".5",[32,106,107],{"class":45},");          ",[32,109,110],{"class":38},"\u002F* 50% opacity *\u002F\n",[32,112,114,117],{"class":34,"line":113},9,[32,115,116],{"class":45},"color: rgb(255 0 0 \u002F 50%);            ",[32,118,119],{"class":38},"\u002F* modern syntax (space-separated, \u002F for alpha) *\u002F\n",[32,121,123],{"class":34,"line":122},10,[32,124,82],{"emptyLinePlaceholder":81},[32,126,128],{"class":34,"line":127},11,[32,129,130],{"class":38},"\u002F* HSL \u002F HSLA — hue (0-360), saturation%, lightness% *\u002F\n",[32,132,134,137],{"class":34,"line":133},12,[32,135,136],{"class":45},"color: hsl(0, 100%, 50%);             ",[32,138,139],{"class":38},"\u002F* red *\u002F\n",[32,141,143,146],{"class":34,"line":142},13,[32,144,145],{"class":45},"color: hsl(120, 100%, 25%);           ",[32,147,148],{"class":38},"\u002F* dark green *\u002F\n",[32,150,152,155],{"class":34,"line":151},14,[32,153,154],{"class":45},"color: hsl(0 100% 50% \u002F 50%);         ",[32,156,157],{"class":38},"\u002F* modern syntax with alpha *\u002F\n",[32,159,161],{"class":34,"line":160},15,[32,162,82],{"emptyLinePlaceholder":81},[32,164,166],{"class":34,"line":165},16,[32,167,168],{"class":38},"\u002F* Named colors *\u002F\n",[32,170,172],{"class":34,"line":171},17,[32,173,174],{"class":45},"color: red; color: transparent; color: currentColor; color: inherit;\n",[32,176,178],{"class":34,"line":177},18,[32,179,82],{"emptyLinePlaceholder":81},[32,181,183],{"class":34,"line":182},19,[32,184,185],{"class":38},"\u002F* LCH \u002F OKLCH — perceptually uniform (modern, 2023+) *\u002F\n",[32,187,189,192,195,198,201,204],{"class":34,"line":188},20,[32,190,191],{"class":45},"color: oklch(0",[32,193,194],{"class":103},".6",[32,196,197],{"class":45}," 0",[32,199,200],{"class":103},".2",[32,202,203],{"class":45}," 25);             ",[32,205,206],{"class":38},"\u002F* lightness, chroma, hue — perceptually uniform *\u002F\n",[32,208,210,213,217,220],{"class":34,"line":209},21,[32,211,212],{"class":45},"color: color(",[32,214,216],{"class":215},"sk71V","display-p3",[32,218,219],{"class":45}," 1 0 0);       ",[32,221,222],{"class":38},"\u002F* wide-gamut color space *\u002F\n",[224,225,227],"h3",{"id":226},"which-to-use","Which to use?",[229,230,231,239,245,257],"ul",{},[232,233,234,238],"li",{},[235,236,237],"strong",{},"Hex"," — most common, concise. Use for opaque colors.",[232,240,241,244],{},[235,242,243],{},"HSL\u002FOKLCH"," — best for generating color variations (lighten\u002Fdarken by adjusting lightness). OKLCH is perceptually uniform (50% lightness looks the same across hues).",[232,246,247,252,253,256],{},[235,248,249],{},[29,250,251],{},"currentColor"," — the element's current ",[29,254,255],{},"color"," value, useful for SVG\u002Ficons that should match text color.",[232,258,259,264,265,268],{},[235,260,261],{},[29,262,263],{},"transparent"," — ",[29,266,267],{},"rgba(0,0,0,0)"," — fully transparent.",[224,270,272,273],{"id":271},"opacity-vs-rgba","Opacity vs ",[29,274,275],{},"rgba",[229,277,278,289],{},[232,279,280,283,284,288],{},[29,281,282],{},"opacity: 0.5"," — makes the ",[285,286,287],"em",{},"entire element"," (and children) 50% transparent.",[232,290,291,294,295,297],{},[29,292,293],{},"rgba(..., 0.5)"," — makes only the ",[285,296,255],{}," 50% transparent (children are fully opaque).",[299,300,301,302,304,305,308],"p",{},"Use ",[29,303,275],{},"\u002FHSL-alpha for semi-transparent backgrounds\u002Fborders; ",[29,306,307],{},"opacity"," only when you want the whole element (including text) transparent.",[14,310,312],{"id":311},"units","Units",[224,314,316],{"id":315},"absolute","Absolute",[229,318,319],{},[232,320,321,324],{},[29,322,323],{},"px"," — pixels (CSS pixels, not device pixels; 1px ≈ 1\u002F96 inch). The most common absolute unit.",[224,326,328],{"id":327},"relative-to-font-size","Relative to font size",[229,330,331,351],{},[232,332,333,335,336,339,340,343,344,347,348,350],{},[29,334,285],{}," — relative to the ",[285,337,338],{},"parent's"," font-size. ",[29,341,342],{},"1.5em"," = 1.5 × parent's font-size. Compounds in nested elements (a ",[29,345,346],{},"1.2em"," inside a ",[29,349,346],{}," is 1.44×).",[232,352,353,335,356,359,360,363,364,367,368],{},[29,354,355],{},"rem",[285,357,358],{},"root"," (",[29,361,362],{},"html",") font-size. ",[29,365,366],{},"1.5rem"," = 1.5 × root font-size. Doesn't compound — consistent across the page. ",[235,369,370,371,373],{},"Prefer ",[29,372,355],{}," for font-sizes and spacing.",[224,375,377],{"id":376},"relative-to-viewport","Relative to viewport",[229,379,380,398,415,428,437],{},[232,381,382,385,386,389,390,393,394,397],{},[29,383,384],{},"vw"," — 1% of the viewport width. ",[29,387,388],{},"100vw"," = full viewport width (note: includes the scrollbar on some browsers, causing overflow — use ",[29,391,392],{},"dvw"," or ",[29,395,396],{},"100%",").",[232,399,400,403,404,407,408,410,411,414],{},[29,401,402],{},"vh"," — 1% of the viewport height. ",[29,405,406],{},"100vh"," = full viewport height (on mobile, ",[29,409,406],{}," includes the browser chrome — use ",[29,412,413],{},"dvh"," for the dynamic viewport).",[232,416,417,419,420,422,423,419,425,427],{},[29,418,392],{},"\u002F",[29,421,413],{}," — dynamic viewport units (adjust when the mobile browser chrome shows\u002Fhides). Modern replacement for ",[29,424,384],{},[29,426,402],{}," on mobile.",[232,429,430,419,433,436],{},[29,431,432],{},"svw",[29,434,435],{},"svh"," — small viewport (smallest possible, when all browser chrome is shown).",[232,438,439,419,442,445],{},[29,440,441],{},"lvw",[29,443,444],{},"lvh"," — large viewport (largest possible, when all chrome is hidden).",[224,447,449],{"id":448},"relative-to-parent","Relative to parent",[229,451,452,466,476],{},[232,453,454,457,458,461,462,465],{},[29,455,456],{},"%"," — relative to the parent's dimension (",[29,459,460],{},"width: 50%"," is half the parent's width). For ",[29,463,464],{},"height",", the parent needs a defined height.",[232,467,468,471,472,475],{},[29,469,470],{},"ch"," — the width of the \"0\" character in the current font. Useful for max-width of text (",[29,473,474],{},"max-width: 60ch"," — about 60 characters per line).",[232,477,478,481],{},[29,479,480],{},"ex"," — the x-height of the font (rare).",[224,483,485],{"id":484},"viewport-percentage-vs-container-queries","Viewport-percentage vs container queries",[299,487,488,489,492,493,496],{},"For container-relative sizing, use container query units (",[29,490,491],{},"cqw",", ",[29,494,495],{},"cqh",") — see chapter 09.",[14,498,500],{"id":499},"calc",[29,501,502],{},"calc()",[19,504,505],{"language":21},[23,506,508],{"className":25,"code":507,"language":21,"meta":27,"style":27},"width: calc(100% - 200px);          \u002F* mix units *\u002F\nfont-size: calc(1rem + 0.5vw);      \u002F* responsive font *\u002F\npadding: calc(1rem * 2);\nwidth: calc(min(100%, 600px));      \u002F* nested (or use min() directly) *\u002F\n",[29,509,510,518,541,552],{"__ignoreMap":27},[32,511,512,515],{"class":34,"line":35},[32,513,514],{"class":45},"width: calc(100% - 200px);          ",[32,516,517],{"class":38},"\u002F* mix units *\u002F\n",[32,519,520,523,526,530,532,535,538],{"class":34,"line":42},[32,521,522],{"class":215},"font-size",[32,524,525],{"class":45},": calc(1rem ",[32,527,529],{"class":528},"svdQ7","+",[32,531,197],{"class":45},[32,533,534],{"class":103},".5vw",[32,536,537],{"class":45},");      ",[32,539,540],{"class":38},"\u002F* responsive font *\u002F\n",[32,542,543,546,549],{"class":34,"line":56},[32,544,545],{"class":45},"padding: calc(1rem ",[32,547,548],{"class":215},"*",[32,550,551],{"class":45}," 2);\n",[32,553,554,557],{"class":34,"line":67},[32,555,556],{"class":45},"width: calc(min(100%, 600px));      ",[32,558,559],{"class":38},"\u002F* nested (or use min() directly) *\u002F\n",[299,561,562,564,565,419,567,570,571,419,573,575],{},[29,563,502],{}," lets you combine units in arithmetic. Always spaces around ",[29,566,529],{},[29,568,569],{},"-"," (required); ",[29,572,548],{},[29,574,419],{}," don't need spaces but can have them.",[14,577,579,492,582,492,585],{"id":578},"min-max-clamp",[29,580,581],{},"min()",[29,583,584],{},"max()",[29,586,587],{},"clamp()",[19,589,590],{"language":21},[23,591,593],{"className":25,"code":592,"language":21,"meta":27,"style":27},"\u002F* min — the smaller of the values *\u002F\nwidth: min(100%, 600px);            \u002F* never wider than 600px or the container *\u002F\n\n\u002F* max — the larger *\u002F\nfont-size: max(1rem, 2vw);          \u002F* never smaller than 1rem *\u002F\n\n\u002F* clamp(min, preferred, max) *\u002F\nfont-size: clamp(1rem, 2vw + 1rem, 3rem);  \u002F* fluid between 1rem and 3rem *\u002F\n",[29,594,595,600,608,612,617,627,631,636],{"__ignoreMap":27},[32,596,597],{"class":34,"line":35},[32,598,599],{"class":38},"\u002F* min — the smaller of the values *\u002F\n",[32,601,602,605],{"class":34,"line":42},[32,603,604],{"class":45},"width: min(100%, 600px);            ",[32,606,607],{"class":38},"\u002F* never wider than 600px or the container *\u002F\n",[32,609,610],{"class":34,"line":56},[32,611,82],{"emptyLinePlaceholder":81},[32,613,614],{"class":34,"line":67},[32,615,616],{"class":38},"\u002F* max — the larger *\u002F\n",[32,618,619,621,624],{"class":34,"line":78},[32,620,522],{"class":215},[32,622,623],{"class":45},": max(1rem, 2vw);          ",[32,625,626],{"class":38},"\u002F* never smaller than 1rem *\u002F\n",[32,628,629],{"class":34,"line":85},[32,630,82],{"emptyLinePlaceholder":81},[32,632,633],{"class":34,"line":91},[32,634,635],{"class":38},"\u002F* clamp(min, preferred, max) *\u002F\n",[32,637,638,640,643,645,648],{"class":34,"line":97},[32,639,522],{"class":215},[32,641,642],{"class":45},": clamp(1rem, 2vw ",[32,644,529],{"class":528},[32,646,647],{"class":45}," 1rem, 3rem);  ",[32,649,650],{"class":38},"\u002F* fluid between 1rem and 3rem *\u002F\n",[299,652,653,655],{},[29,654,587],{}," is the modern responsive pattern — a fluid value with min\u002Fmax bounds, no media queries needed.",[14,657,659],{"id":658},"recommended-defaults","Recommended Defaults",[229,661,662,668,677,689,701],{},[232,663,664,665,667],{},"Font-sizes: ",[29,666,355],{}," (consistent, doesn't compound).",[232,669,670,671,673,674,676],{},"Spacing (padding\u002Fmargin): ",[29,672,355],{}," (scales with user's font-size preference) or ",[29,675,285],{}," (relative to the element's font-size, for component-internal spacing).",[232,678,679,680,682,683,685,686,688],{},"Widths: ",[29,681,456],{}," (relative to parent), ",[29,684,470],{}," (for text containers), ",[29,687,323],{}," (for fixed UI elements).",[232,690,691,692,694,695,697,698,700],{},"Viewport-relative: ",[29,693,413],{}," for mobile full-height (not ",[29,696,402],{},"), ",[29,699,587],{}," for fluid responsive values.",[232,702,703,704,706,707,709],{},"Avoid ",[29,705,323],{}," for font-sizes — ",[29,708,355],{}," respects the user's browser font-size setting (accessibility).",[14,711,713],{"id":712},"tips-tricks","💡 Tips & Tricks",[229,715,716,734,745,770,783],{},[232,717,718,721,722,724,725,727,728,730,731,733],{},[235,719,720],{},"Idiom",": use ",[29,723,355],{}," for font-sizes and spacing — ",[29,726,355],{}," is relative to the root font-size, so it's consistent (doesn't compound like ",[29,729,285],{},") and respects the user's browser font-size setting (accessibility). Use ",[29,732,285],{}," only for component-internal spacing where you want it to scale with the element's font-size.",[232,735,736,721,738,740,741,744],{},[235,737,720],{},[29,739,587],{}," for fluid responsive values — ",[29,742,743],{},"font-size: clamp(1rem, 0.5rem + 2vw, 3rem)"," gives a font that scales with the viewport but never below 1rem or above 3rem, without media queries. The same pattern works for padding, widths, etc.",[232,746,747,721,749,419,751,753,754,419,756,758,759,761,762,765,766,769],{},[235,748,720],{},[29,750,413],{},[29,752,392],{}," (dynamic viewport units) instead of ",[29,755,402],{},[29,757,384],{}," on mobile — ",[29,760,406],{}," includes the browser chrome on mobile (causing overflow when the address bar shows), while ",[29,763,764],{},"100dvh"," adjusts dynamically. Use ",[29,767,768],{},"100svh"," for the smallest viewport (when all chrome is shown).",[232,771,772,721,774,776,777,779,780,782],{},[235,773,720],{},[29,775,470],{}," for text container max-widths — ",[29,778,474],{}," gives about 60 characters per line, a comfortable reading width regardless of font. This is better than a fixed ",[29,781,323],{}," max-width, which doesn't adapt to font size.",[232,784,785,721,787,790,791,794],{},[235,786,720],{},[29,788,789],{},"oklch()"," for perceptually uniform color manipulation — ",[29,792,793],{},"oklch(0.6 0.2 25)"," (lightness, chroma, hue) makes 50% lightness look the same across hues, unlike HSL where 50% lightness varies in perceived brightness. Generate tints\u002Fshades by adjusting lightness consistently.",[14,796,798],{"id":797},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[229,800,801,817,831,845,863,880,898,915,932,945],{},[232,802,803,808,809,347,811,813,814,816],{},[235,804,805,807],{},[29,806,285],{}," compounds",": ",[29,810,346],{},[29,812,346],{}," is 1.44× the root. Use ",[29,815,355],{}," for font-sizes to avoid this.",[232,818,819,824,825,827,828,830],{},[235,820,821,823],{},[29,822,388],{}," includes the scrollbar"," (on desktop): causing horizontal overflow. Use ",[29,826,396],{}," (of a full-width parent) or ",[29,829,392],{},".",[232,832,833,838,839,841,842,844],{},[235,834,835,837],{},[29,836,406],{}," on mobile includes browser chrome",": the address bar\u002Ftoolbar overlaps. Use ",[29,840,764],{}," (dynamic) or ",[29,843,768],{}," (smallest).",[232,846,847,808,852,855,856,859,860,862],{},[235,848,849,851],{},[29,850,456],{}," height needs a parent with a defined height",[29,853,854],{},"height: 100%"," of an ",[29,857,858],{},"auto","-height parent is 0. Set the parent's height, or use ",[29,861,406],{},"\u002Fflexbox.",[232,864,865,808,870,873,874,876,877,879],{},[235,866,867,869],{},[29,868,323],{}," for font-sizes ignores user's browser font-size setting",[29,871,872],{},"16px"," is always 16px regardless of the user's preference. ",[29,875,355],{}," (or ",[29,878,285],{},") respects the setting (accessibility).",[232,881,882,887,888,891,892,894,895,897],{},[235,883,884,886],{},[29,885,307],{}," affects the whole element including children",": a ",[29,889,890],{},"div"," with ",[29,893,282],{}," makes its text 50% transparent too. Use ",[29,896,275],{},"\u002FHSL-alpha for semi-transparent backgrounds.",[232,899,900,808,903,906,907,910,911,914],{},[235,901,902],{},"Hex alpha is the last 2 digits",[29,904,905],{},"#ff0000ff"," is opaque red; ",[29,908,909],{},"#ff000080"," is 50% red. The ",[29,912,913],{},"80"," is hex for 128\u002F255 ≈ 50%.",[232,916,917,808,920,923,924,927,928,931],{},[235,918,919],{},"HSL lightness isn't perceptually uniform",[29,921,922],{},"hsl(60, 100%, 50%)"," (yellow) looks brighter than ",[29,925,926],{},"hsl(240, 100%, 50%)"," (blue) at the same \"lightness.\" Use ",[29,929,930],{},"oklch"," for perceptual uniformity.",[232,933,934,941,942,944],{},[235,935,936,938,939],{},[29,937,251],{}," is the computed ",[29,940,255],{},": useful for SVG fill matching text, but it changes with the element's ",[29,943,255],{}," — not a fixed reference.",[232,946,947,808,956,959,960,963,964,419,966,968],{},[235,948,949,951,952,419,954],{},[29,950,502],{}," requires spaces around ",[29,953,529],{},[29,955,569],{},[29,957,958],{},"calc(100%-20px)"," is invalid (parsed as a percentage with a negative number, not subtraction). ",[29,961,962],{},"calc(100% - 20px)"," works. ",[29,965,548],{},[29,967,419],{}," don't require spaces.",[14,970,972],{"id":971},"spot-the-bug","🧠 Spot the Bug",[299,974,975],{},"A developer sets a full-height hero section, but on mobile it's taller than the screen and the bottom is cut off:",[19,977,978],{"language":21},[23,979,981],{"className":25,"code":980,"language":21,"meta":27,"style":27},".hero { height: 100vh; }\n",[29,982,983],{"__ignoreMap":27},[32,984,985,988,991,994,996,999,1001],{"class":34,"line":35},[32,986,987],{"class":103},".hero",[32,989,990],{"class":45}," { ",[32,992,464],{"class":993},"snvgF",[32,995,808],{"class":45},[32,997,998],{"class":993},"100",[32,1000,402],{"class":528},[32,1002,1003],{"class":45},"; }\n",[299,1005,1006],{},"What's wrong?",[1008,1009,1010,1014,1026,1035,1086,1101],"details",{},[1011,1012,1013],"summary",{},"Answer",[299,1015,1016,1018,1019,1022,1023,1025],{},[29,1017,406],{}," on mobile browsers is the \"large viewport\" height — it includes the space the browser chrome (address bar, toolbar) ",[285,1020,1021],{},"could"," occupy. When the address bar is visible (the common case), ",[29,1024,406],{}," is taller than the visible area, so the hero's bottom is behind the address bar \u002F cut off.",[299,1027,1028,1029,1031,1032,1034],{},"The fix — use ",[29,1030,413],{}," (dynamic viewport height) or ",[29,1033,435],{}," (small viewport height):",[23,1036,1038],{"className":25,"code":1037,"language":21,"meta":27,"style":27},".hero { height: 100dvh; }   \u002F* adjusts when the address bar shows\u002Fhides *\u002F\n\u002F* or *\u002F\n.hero { min-height: 100svh; }  \u002F* always fits the smallest viewport *\u002F\n",[29,1039,1040,1060,1065],{"__ignoreMap":27},[32,1041,1042,1044,1046,1048,1050,1052,1054,1057],{"class":34,"line":35},[32,1043,987],{"class":103},[32,1045,990],{"class":45},[32,1047,464],{"class":993},[32,1049,808],{"class":45},[32,1051,998],{"class":993},[32,1053,413],{"class":528},[32,1055,1056],{"class":45},"; }   ",[32,1058,1059],{"class":38},"\u002F* adjusts when the address bar shows\u002Fhides *\u002F\n",[32,1061,1062],{"class":34,"line":42},[32,1063,1064],{"class":38},"\u002F* or *\u002F\n",[32,1066,1067,1069,1071,1074,1076,1078,1080,1083],{"class":34,"line":56},[32,1068,987],{"class":103},[32,1070,990],{"class":45},[32,1072,1073],{"class":993},"min-height",[32,1075,808],{"class":45},[32,1077,998],{"class":993},[32,1079,435],{"class":528},[32,1081,1082],{"class":45},"; }  ",[32,1084,1085],{"class":38},"\u002F* always fits the smallest viewport *\u002F\n",[299,1087,1088,1089,1091,1092,1094,1095,1097,1098,1100],{},"::\n",[29,1090,413],{}," adjusts dynamically as the browser chrome shows\u002Fhides (the hero resizes). ",[29,1093,435],{}," is the smallest viewport (all chrome shown) — stable but leaves space when the chrome hides. ",[29,1096,444],{}," is the largest (all chrome hidden) — equivalent to the old ",[29,1099,402],{}," behavior.",[299,1102,1103,808,1106,1108,1109,841,1111,1113],{},[235,1104,1105],{},"The lesson",[29,1107,406],{}," on mobile is the large viewport (includes potential chrome space), causing overflow when the address bar is visible. Use ",[29,1110,764],{},[29,1112,768],{}," (smallest) for mobile full-height 