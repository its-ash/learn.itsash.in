721,723],{"id":722},"gradient-tips","Gradient Tips",[369,725,726,738,744],{},[372,727,728,729,732,733,349,735,737],{},"Gradients are images (",[33,730,731],{},"background-image","), so they layer with other backgrounds and respect ",[33,734,365],{},[33,736,354],{},".",[372,739,740,741,737],{},"Use hard stops for stripes: ",[33,742,743],{},"linear-gradient(red 0%, red 50%, blue 50%, blue 100%)",[372,745,746,747,750,751,754,755,758],{},"Gradient angles: ",[33,748,749],{},"0deg"," = to top, ",[33,752,753],{},"90deg"," = to right, ",[33,756,757],{},"180deg"," = to bottom.",[18,760,762],{"id":761},"tips-tricks","💡 Tips & Tricks",[369,764,765,779,795,800,808],{},[372,766,767,771,772,775,776,778],{},[768,769,770],"strong",{},"Idiom",": use ",[33,773,774],{},"background-size: cover"," for full-bleed images (hero sections, card thumbnails) — it scales to cover the box, cropping overflow, maintaining aspect ratio. Use ",[33,777,165],{}," when the whole image must be visible (logos).",[372,780,781,771,783,786,787,790,791,794],{},[768,782,770],{},[33,784,785],{},"background-clip: text"," + ",[33,788,789],{},"color: transparent"," for gradient text — the gradient shows through the text shape. Keep the ",[33,792,793],{},"-webkit-"," prefix for Safari compatibility.",[372,796,797,799],{},[768,798,770],{},": use multiple backgrounds (comma-separated) for layered effects — a gradient over an image, a noise texture over a color. First listed is on top.",[372,801,802,771,804,807],{},[768,803,770],{},[33,805,806],{},"background-position: right 10px bottom 20px"," for offset-from-edges positioning — clearer than computing percentages, and it pins to a specific corner with an offset.",[372,809,810,812,813,816],{},[768,811,770],{},": use hard stops (",[33,814,815],{},"red 50%, blue 50%",") for striped gradients — the abrupt transition creates a stripe pattern, useful for progress bars, warning patterns, or decorative stripes.",[18,818,820],{"id":819},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[369,822,823,834,854,863,875,886,913,919,933],{},[372,824,825,830,831,833],{},[768,826,827,829],{},[33,828,361],{}," is the bottom layer",": in multiple backgrounds, only one ",[33,832,361],{}," (the last fallback). Set it on the shorthand's first layer or as a separate property.",[372,835,836,57,841,844,845,847,848,850,851,853],{},[768,837,838,840],{},[33,839,365],{}," in the shorthand",[33,842,843],{},"background: url(x) center \u002F cover;"," — the ",[33,846,349],{}," separates position from size. Forgetting the ",[33,849,349],{}," makes ",[33,852,160],{}," a second position value (invalid).",[372,855,856,862],{},[768,857,858,861],{},[33,859,860],{},"background-attachment: fixed"," is janky on mobile",": it causes repaints on scroll, and some mobile browsers don't support it well. Use sparingly or avoid.",[372,864,865,870,871,874],{},[768,866,867,868],{},"Gradient text needs ",[33,869,789],{},": without it, the text color covers the gradient. And ",[33,872,873],{},"-webkit-background-clip: text"," for Safari.",[372,876,877,771,883,885],{},[768,878,879,882],{},[33,880,881],{},"background-clip: border-box"," (default) shows the background under a transparent\u002Fdashed border",[33,884,201],{}," to clip at the padding edge if you don't want the background under the border.",[372,887,888,57,896,899,900,904,905,908,909,912],{},[768,889,890,893,894],{},[33,891,892],{},"background-origin"," vs ",[33,895,487],{},[33,897,898],{},"origin"," is where the background ",[901,902,903],"em",{},"starts"," (for positioning\u002Fsizing); ",[33,906,907],{},"clip"," is where it's ",[901,910,911],{},"clipped",". They can differ.",[372,914,915,918],{},[768,916,917],{},"Gradients are resolution-independent",": they scale without pixelation, unlike raster images. Use gradients for UI effects (buttons, stripes) instead of images.",[372,920,921,926,927,929,930,932],{},[768,922,923,925],{},[33,924,87],{}," angle: 0deg is to top",": not to right. ",[33,928,753],{}," is to right, ",[33,931,757],{}," to bottom. Mnemonic: 0deg points up, increasing clockwise.",[372,934,935,57,940,943],{},[768,936,937,939],{},[33,938,676],{}," for pie charts",[33,941,942],{},"conic-gradient(red 0 30%, blue 30% 70%, green 70% 100%)"," — segments by percentage. Useful for simple pie\u002Fdonut charts without SVG.",[18,945,947],{"id":946},"spot-the-bug","🧠 Spot the Bug",[14,949,950,951,953],{},"A developer sets a background image with ",[33,952,774],{},", but the image isn't covering the box — it's tiny and tiled:",[23,955,956],{"language":25},[27,957,959],{"className":29,"code":958,"language":25,"meta":31,"style":31},".box {\n    background: url(\"bg.png\");\n    background-size: cover;\n}\n",[33,960,961,967,981,991],{"__ignoreMap":31},[36,962,963,965],{"class":38,"line":39},[36,964,43],{"class":42},[36,966,47],{"class":46},[36,968,969,971,973,975,977,979],{"class":38,"line":50},[36,970,246],{"class":53},[36,972,57],{"class":46},[36,974,74],{"class":53},[36,976,77],{"class":46},[36,978,81],{"class":80},[36,980,110],{"class":46},[36,982,983,985,987,989],{"class":38,"line":66},[36,984,155],{"class":53},[36,986,57],{"class":46},[36,988,160],{"class":53},[36,990,63],{"class":46},[36,992,993],{"class":38,"line":113},[36,994,278],{"class":46},[14,996,997],{},"What's wrong?",[999,1000,1001,1005,1033,1046,1068,1115,1133,1141,1226],"details",{},[1002,1003,1004],"summary",{},"Answer",[14,1006,1007,1008,1011,1012,1015,1016,1018,1019,1022,1023,1025,1026,1029,1030,1032],{},"The shorthand ",[33,1009,1010],{},"background: url(\"bg.png\")"," resets ",[901,1013,1014],{},"all"," background properties to their defaults — including ",[33,1017,365],{}," (to ",[33,1020,1021],{},"auto","). Then ",[33,1024,774],{}," is set ",[901,1027,1028],{},"after"," the shorthand, so it should work... actually, it does work (the later ",[33,1031,774],{}," applies).",[14,1034,1035,1036,1038,1039,1042,1043,1045],{},"The real bug: the shorthand ",[33,1037,1010],{}," also sets ",[33,1040,1041],{},"background-repeat: repeat"," (the default). The image tiles. And ",[33,1044,774],{}," scales it to cover, so it shouldn't tile... unless the image fails to load (404), in which case there's no image to cover, and nothing shows.",[14,1047,1048,1049,1058,1059,1061,1062,1064,1065,1067],{},"Actually, the most likely real bug: ",[768,1050,1051,1052,1054,1055,1057],{},"the shorthand comes first, then ",[33,1053,774],{}," — but the shorthand already reset everything, and ",[33,1056,160],{}," applies."," If it's \"tiny and tiled,\" the issue is that ",[33,1060,365],{}," is being overridden or the shorthand is ",[901,1063,1028],{}," ",[33,1066,365],{},":",[27,1069,1071],{"className":29,"code":1070,"language":25,"meta":31,"style":31},".box {\n    background-size: cover;        \u002F* set first *\u002F\n    background: url(\"bg.png\");     \u002F* ❌ shorthand resets size to auto! *\u002F\n}\n",[33,1072,1073,1079,1093,1111],{"__ignoreMap":31},[36,1074,1075,1077],{"class":38,"line":39},[36,1076,43],{"class":42},[36,1078,47],{"class":46},[36,1080,1081,1083,1085,1087,1090],{"class":38,"line":50},[36,1082,155],{"class":53},[36,1084,57],{"class":46},[36,1086,160],{"class":53},[36,1088,1089],{"class":46},";        ",[36,1091,1092],{"class":239},"\u002F* set first *\u002F\n",[36,1094,1095,1097,1099,1101,1103,1105,1108],{"class":38,"line":66},[36,1096,246],{"class":53},[36,1098,57],{"class":46},[36,1100,74],{"class":53},[36,1102,77],{"class":46},[36,1104,81],{"class":80},[36,1106,1107],{"class":46},");     ",[36,1109,1110],{"class":239},"\u002F* ❌ shorthand resets size to auto! *\u002F\n",[36,1112,1113],{"class":38,"line":113},[36,1114,278],{"class":46},[14,1116,1117,1118,1064,1121,1123,1124,1126,1127,1129,1130,1132],{},"::\nHere the shorthand ",[901,1119,1120],{},"resets",[33,1122,365],{}," to ",[33,1125,1021],{}," (overriding the earlier ",[33,1128,160],{},"), so the image is at its natural size (tiny) and tiles (default ",[33,1131,126],{},").",[14,1134,1135,1136,1064,1138,1140],{},"The fix — put ",[33,1137,365],{},[901,1139,1028],{}," the shorthand, or include it in the shorthand:",[27,1142,1144],{"className":29,"code":1143,"language":25,"meta":31,"style":31},"\u002F* Option 1: size after shorthand *\u002F\n.box { background: url(\"bg.png\") no-repeat center; background-size: cover; }\n\n\u002F* Option 2: in the shorthand (with \u002F) *\u002F\n.box { background: url(\"bg.png\") no-repeat center \u002F cover; }\n",[33,1145,1146,1151,1187,1193,1198],{"__ignoreMap":31},[36,1147,1148],{"class":38,"line":39},[36,1149,1150],{"class":239},"\u002F* Option 1: size after shorthand *\u002F\n",[36,1152,1153,1155,1158,1161,1163,1165,1167,1169,1171,1173,1175,1178,1180,1182,1184],{"class":38,"line":50},[36,1154,43],{"class":42},[36,1156,1157],{"class":46}," { ",[36,1159,1160],{"class":53},"background",[36,1162,57],{"class":46},[36,1164,74],{"class":53},[36,1166,77],{"class":46},[36,1168,81],{"class":80},[36,1170,260],{"class":46},[36,1172,121],{"class":53},[36,1174,265],{"class":53},[36,1176,1177],{"class":46},"; ",[36,1179,365],{"class":53},[36,1181,57],{"class":46},[36,1183,160],{"class":53},[36,1185,1186],{"class":46},"; }\n",[36,1188,1189],{"class":38,"line":66},[36,1190,1192],{"emptyLinePlaceholder":1191},true,"\n",[36,1194,1195],{"class":38,"line":113},[36,1196,1197],{"class":239},"\u002F* Option 2: in the shorthand (with \u002F) *\u002F\n",[36,1199,1200,1202,1204,1206,1208,1210,1212,1214,1216,1218,1220,1222,1224],{"class":38,"line":131},[36,1201,43],{"class":42},[36,1203,1157],{"class":46},[36,1205,1160],{"class":53},[36,1207,57],{"class":46},[36,1209,74],{"class":53},[36,1211,77],{"class":46},[36,1213,81],{"class":80},[36,1215,260],{"class":46},[36,1217,121],{"class":53},[36,1219,265],{"class":53},[36,1221,268],{"class":46},[36,1223,160],{"class":53},[36,1225,1186],{"class":46},[14,1227,1228,1229,1232,1233,1235,1236,1238,1239,1241,1242,1132],{},"::\n",[768,1230,1231],{},"The lesson",": the ",[33,1234,1160],{}," shorthand resets ",[901,1237,1014],{}," background properties to defaults. Setting ",[33,1240,365],{}," before the shorthand is overridden. Set it after, or include it in the shorthand (",[33,1243,1244],{},"position \u002F size",[18,1246,1247],{"id":1002},"Summary",[14,1249,1250,1251,1253],{},"You can now use background-color\u002Fimage\u002Frepeat\u002Fposition\u002Fsize\u002Fattachment\u002Fclip, multiple backgrounds, gradients (linear\u002Fradial\u002Fconic\u002Frepeating), and ",[33,1252,785],{}," for gradient text — while avoiding the shorthand-resets-everything trap. Next: borders, shadows, and outlines.",[1255,1256,1257],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-git