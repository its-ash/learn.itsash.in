1],{"class":89},[83,569,132],{"class":104},[83,571,108],{"class":89},[83,573,574,576,578,580,582,585,588,590],{"class":85,"line":137},[83,575,114],{"class":89},[83,577,94],{"class":93},[83,579,98],{"class":97},[83,581,101],{"class":89},[83,583,584],{"class":104},"\"media__body\"",[83,586,587],{"class":89},">...\u003C\u002F",[83,589,94],{"class":93},[83,591,108],{"class":89},[83,593,594,596,598],{"class":85,"line":159},[83,595,205],{"class":89},[83,597,94],{"class":93},[83,599,108],{"class":89},[14,601,602,603,606,607,610],{},"Combine a structure class (",[33,604,605],{},"media",") with a skin class (",[33,608,609],{},"skin-card",") — the media layout works regardless of the visual skin.",[18,612,614],{"id":613},"smacss-scalable-and-modular-architecture","SMACSS (Scalable and Modular Architecture)",[14,616,617],{},"Categorizes CSS into five types:",[359,619,620,634,649,660,675],{},[29,621,622,625,626,49,629,49,632,59],{},[275,623,624],{},"Base"," — element selectors (",[33,627,628],{},"body",[33,630,631],{},"a",[33,633,10],{},[29,635,636,639,640,49,643,49,646,59],{},[275,637,638],{},"Layout"," — structural (",[33,641,642],{},"#header",[33,644,645],{},".l-grid",[33,647,648],{},".container",[29,650,651,654,655,49,657,59],{},[275,652,653],{},"Module"," — components (",[33,656,223],{},[33,658,659],{},".nav",[29,661,662,665,666,49,669,49,672,59],{},[275,663,664],{},"State"," — states (",[33,667,668],{},".is-active",[33,670,671],{},".is-hidden",[33,673,674],{},".is-collapsed",[29,676,677,680,681,59],{},[275,678,679],{},"Theme"," — theme overrides (",[33,682,683],{},".theme-dark",[14,685,686,687,49,690,49,693,49,696,49,699,702,703,706,707,710,711,714],{},"Organizes files by category (",[33,688,689],{},"base.css",[33,691,692],{},"layout.css",[33,694,695],{},"modules\u002F",[33,697,698],{},"states.css",[33,700,701],{},"theme.css","). The naming convention prefixes classes by category (",[33,704,705],{},".l-"," for layout, ",[33,708,709],{},".is-"," for state, ",[33,712,713],{},".has-"," for state).",[18,716,718],{"id":717},"itcss-inverted-triangle","ITCSS (Inverted Triangle)",[14,720,721],{},"Organizes CSS by specificity, from broad to narrow:",[359,723,724,736,742,752,762,772,782],{},[29,725,726,729,730,49,733,59],{},[275,727,728],{},"Settings"," — variables (",[33,731,732],{},"--color",[33,734,735],{},"--font",[29,737,738,741],{},[275,739,740],{},"Tools"," — mixins, functions.",[29,743,744,747,748,751],{},[275,745,746],{},"Generic"," — resets, ",[33,749,750],{},"box-sizing",".",[29,753,754,757,758,49,760,59],{},[275,755,756],{},"Elements"," — bare element selectors (",[33,759,628],{},[33,761,631],{},[29,763,764,767,768,49,770,59],{},[275,765,766],{},"Objects"," — layout patterns (",[33,769,390],{},[33,771,648],{},[29,773,774,777,778,49,780,59],{},[275,775,776],{},"Components"," — UI components (",[33,779,223],{},[33,781,659],{},[29,783,784,787,788,49,791,59],{},[275,785,786],{},"Utilities"," — single-purpose (",[33,789,790],{},".text-center",[33,792,793],{},".mt-4",[14,795,796,797,59],{},"Each layer is more specific and explicit than the one above. Import in order — later layers can override earlier. Maps well to cascade layers (",[33,798,799],{},"@layer",[18,801,803],{"id":802},"atomic-utility-first-css","Atomic \u002F Utility-First CSS",[14,805,806,807,49,809,49,811,814],{},"Atomic CSS uses single-purpose utility classes (",[33,808,793],{},[33,810,790],{},[33,812,813],{},".flex","). Tailwind CSS is the popular implementation:",[71,816,817,850,854,868,872,887,891,902,906,912],{"language":73},[75,818,820],{"className":77,"code":819,"language":73,"meta":79,"style":79},"\u003Cbutton class=\"bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded\">\n    Button\n\u003C\u002Fbutton>\n",[33,821,822,837,842],{"__ignoreMap":79},[83,823,824,826,828,830,832,835],{"class":85,"line":86},[83,825,90],{"class":89},[83,827,185],{"class":93},[83,829,98],{"class":97},[83,831,101],{"class":89},[83,833,834],{"class":104},"\"bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded\"",[83,836,108],{"class":89},[83,838,839],{"class":85,"line":111},[83,840,841],{"class":89},"    Button\n",[83,843,844,846,848],{"class":85,"line":137},[83,845,205],{"class":89},[83,847,185],{"class":93},[83,849,108],{"class":89},[142,851,853],{"id":852},"pros","Pros",[26,855,856,859,862,865],{},[29,857,858],{},"No naming — compose utilities directly in HTML.",[29,860,861],{},"Small file size (with purging) — only used utilities ship.",[29,863,864],{},"Consistent spacing\u002Fcolors (design system enforced).",[29,866,867],{},"No context switching (HTML to CSS).",[142,869,871],{"id":870},"cons","Cons",[26,873,874,877,880],{},[29,875,876],{},"HTML is verbose (long class lists).",[29,878,879],{},"Learning the utility names.",[29,881,882,883,886],{},"Hard to extract components without ",[33,884,885],{},"@apply"," or a component framework.",[142,888,890],{"id":889},"when-to-use","When to use",[26,892,893,896,899],{},[29,894,895],{},"Projects with a design system and component framework (React\u002FVue) — utilities compose well in JSX.",[29,897,898],{},"Teams that prefer in-HTML styling.",[29,900,901],{},"Avoid for simple sites or if the verbose HTML bothers you.",[18,903,905],{"id":904},"cascade-layers-for-architecture","Cascade Layers for Architecture",[14,907,908,909,911],{},"Modern CSS ",[33,910,799],{}," formalizes the ITCSS-like ordering:",[71,913,914,1071,1085,1089,1149,1159,1163,1240,1244,1384,1388,1391],{"language":212},[75,915,917],{"className":215,"code":916,"language":212,"meta":79,"style":79},"@layer reset, base, layout, components, utilities;\n\n@layer reset { * { box-sizing: border-box; margin: 0; } }\n@layer base { body { font-family: sans-serif; } }\n@layer layout { .container { max-width: 1200px; margin: 0 auto; } }\n@layer components { .card { ... } .btn { ... } }\n@layer utilities { .text-center { text-align: center; } .mt-4 { margin-top: 1rem; } }\n",[33,918,919,926,930,962,983,1017,1034],{"__ignoreMap":79},[83,920,921,923],{"class":85,"line":86},[83,922,799],{"class":424},[83,924,925],{"class":89}," reset, base, layout, components, utilities;\n",[83,927,928],{"class":85,"line":111},[83,929,448],{"emptyLinePlaceholder":447},[83,931,932,934,937,940,942,944,946,949,951,954,956,959],{"class":85,"line":137},[83,933,799],{"class":424},[83,935,936],{"class":89}," reset { ",[83,938,939],{"class":93},"*",[83,941,393],{"class":89},[83,943,750],{"class":396},[83,945,400],{"class":89},[83,947,948],{"class":396},"border-box",[83,950,471],{"class":89},[83,952,953],{"class":396},"margin",[83,955,400],{"class":89},[83,957,958],{"class":396},"0",[83,960,961],{"class":89},"; } }\n",[83,963,964,966,969,971,973,976,978,981],{"class":85,"line":159},[83,965,799],{"class":424},[83,967,968],{"class":89}," base { ",[83,970,628],{"class":93},[83,972,393],{"class":89},[83,974,975],{"class":396},"font-family",[83,977,400],{"class":89},[83,979,980],{"class":396},"sans-serif",[83,982,961],{"class":89},[83,984,985,987,990,992,994,997,999,1002,1004,1006,1008,1010,1012,1015],{"class":85,"line":180},[83,986,799],{"class":424},[83,988,989],{"class":89}," layout { ",[83,991,648],{"class":97},[83,993,393],{"class":89},[83,995,996],{"class":396},"max-width",[83,998,400],{"class":89},[83,1000,1001],{"class":396},"1200",[83,1003,482],{"class":424},[83,1005,471],{"class":89},[83,1007,953],{"class":396},[83,1009,400],{"class":89},[83,1011,958],{"class":396},[83,1013,1014],{"class":396}," auto",[83,1016,961],{"class":89},[83,1018,1019,1021,1024,1026,1029,1031],{"class":85,"line":202},[83,1020,799],{"class":424},[83,1022,1023],{"class":89}," components { ",[83,1025,223],{"class":97},[83,1027,1028],{"class":89}," { ... } ",[83,1030,48],{"class":97},[83,1032,1033],{"class":89}," { ... } }\n",[83,1035,1036,1038,1041,1043,1045,1048,1050,1053,1056,1058,1060,1063,1065,1067,1069],{"class":85,"line":264},[83,1037,799],{"class":424},[83,1039,1040],{"class":89}," utilities { ",[83,1042,790],{"class":97},[83,1044,393],{"class":89},[83,1046,1047],{"class":396},"text-align",[83,1049,400],{"class":89},[83,1051,1052],{"class":396},"center",[83,1054,1055],{"class":89},"; } ",[83,1057,793],{"class":97},[83,1059,393],{"class":89},[83,1061,1062],{"class":396},"margin-top",[83,1064,400],{"class":89},[83,1066,421],{"class":396},[83,1068,425],{"class":424},[83,1070,961],{"class":89},[14,1072,1073,1074,1077,1078,1077,1081,1084],{},"The layer order sets precedence — ",[33,1075,1076],{},"utilities"," beats ",[33,1079,1080],{},"components",[33,1082,1083],{},"layout",", regardless of specificity. This makes the architecture explicit and reliable.",[18,1086,1088],{"id":1087},"choosing-a-methodology","Choosing a Methodology",[1090,1091,1092,1105],"table",{},[1093,1094,1095],"thead",{},[1096,1097,1098,1102],"tr",{},[1099,1100,1101],"th",{},"Methodology",[1099,1103,1104],{},"Best for",[1106,1107,1108,1117,1125,1133,1141],"tbody",{},[1096,1109,1110,1114],{},[1111,1112,1113],"td",{},"BEM",[1111,1115,1116],{},"Most projects — clear, simple, no tooling",[1096,1118,1119,1122],{},[1111,1120,1121],{},"OOCSS",[1111,1123,1124],{},"Reusable structure\u002Fskin separation",[1096,1126,1127,1130],{},[1111,1128,1129],{},"SMACSS",[1111,1131,1132],{},"Categorization guidance",[1096,1134,1135,1138],{},[1111,1136,1137],{},"ITCSS",[1111,1139,1140],{},"Large-scale, enterprise",[1096,1142,1143,1146],{},[1111,1144,1145],{},"Atomic\u002FTailwind",[1111,1147,1148],{},"Component-heavy apps (React\u002FVue)",[14,1150,1151,1152,1158],{},"For most projects, ",[275,1153,1154,1155,1157],{},"BEM + a layer structure (ITCSS-style or ",[33,1156,799],{},")"," is a solid default. Use Tailwind if the team prefers utility-first.",[18,1160,1162],{"id":1161},"tips-tricks","💡 Tips & Tricks",[26,1164,1165,1181,1193,1204,1230],{},[29,1166,1167,1170,1171,49,1174,49,1177,1180],{},[275,1168,1169],{},"Idiom",": use BEM (",[33,1172,1173],{},".block",[33,1175,1176],{},".block__element",[33,1178,1179],{},".block--modifier",") for most projects — flat specificity (all 0,1,0), clear ownership, no specificity wars. The double underscore (element) and double hyphen (modifier) are instantly recognizable.",[29,1182,1183,1185,1186,1188,1189,1192],{},[275,1184,1169],{},": use ",[33,1187,799],{}," to formalize architecture — ",[33,1190,1191],{},"@layer reset, base, layout, components, utilities;"," makes the precedence explicit: utilities beat components regardless of specificity. This is the modern ITCSS, native and reliable.",[29,1194,1195,1197,1198,1200,1201,1203],{},[275,1196,1169],{},": separate structure from skin (OOCSS) — a ",[33,1199,390],{}," layout class combined with a ",[33,1202,458],{}," visual class lets the same layout work with any skin, and the same skin apply to any layout. Compose, don't couple.",[29,1205,1206,1208,1209,49,1211,49,1213,1216,1217,49,1220,1223,1224,1226,1227,1229],{},[275,1207,1169],{},": use state classes (",[33,1210,668],{},[33,1212,671],{},[33,1214,1215],{},".is-loading",") for JS-driven state — a clear contract: JS toggles state classes, CSS styles them. Don't use visual classes (",[33,1218,1219],{},"active",[33,1221,1222],{},"hidden",") for state — reserve ",[33,1225,709],{},"\u002F",[33,1228,713],{}," for state.",[29,1231,1232,1234,1235,49,1237,1239],{},[275,1233,1169],{},": use utility classes sparingly with BEM — a few utilities (",[33,1236,793],{},[33,1238,790],{},") for one-off tweaks, but components in BEM. Pure utility-first (Tailwind) is a valid choice for component-heavy apps, but mixing BEM components with a few utilities is a pragmatic middle ground.",[18,1241,1243],{"id":1242},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[26,1245,1246,1260,1277,1298,1310,1331,1341,1347,1359,1370],{},[29,1247,1248,400,1251,1253,1254,1256,1257,59],{},[275,1249,1250],{},"BEM element names shouldn't nest",[33,1252,330],{}," is wrong — it creates a chain. Use ",[33,1255,334],{}," (flat) or split into a sub-block (",[33,1258,1259],{},".card .text-block__text",[29,1261,1262,400,1270,1272,1273,1276],{},[275,1263,1264,1265,1269],{},"BEM modifiers are used ",[1266,1267,1268],"em",{},"with"," the base",[33,1271,320],{},", not ",[33,1274,1275],{},"class=\"card--featured\""," alone (the modifier only sets the differences).",[29,1278,1279,400,1282,1285,1286,1288,1289,1292,1293,1295,1296,751],{},[275,1280,1281],{},"Specificity still matters in BEM",[33,1283,1284],{},".card .card__title"," (0,2,0) beats ",[33,1287,245],{}," (0,1,0). BEM's rule is ",[1266,1290,1291],{},"don't nest"," — use ",[33,1294,245],{}," alone, not ",[33,1297,1284],{},[29,1299,1300,1305,1306,1309],{},[275,1301,1302,1304],{},[33,1303,799],{}," changes the cascade",": unlayered styles beat layered styles. If your utilities are in ",[33,1307,1308],{},"@layer utilities"," and your override is unlayered, the override wins. This is usually desired (overrides), but can surprise.",[29,1311,1312,1319,1320,1322,1323,1326,1327,1330],{},[275,1313,1314,1315,1318],{},"State classes (",[33,1316,1317],{},"is-active",") shouldn't have visual styles directly",": separate state from presentation — ",[33,1321,668],{}," is a state, the component styles it (",[33,1324,1325],{},".tab.is-active { ... }","). Don't make ",[33,1328,1329],{},".is-active { display: block; }"," a global visual rule.",[29,1332,1333,1336,1337,1340],{},[275,1334,1335],{},"Atomic CSS file size without purging",": Tailwind generates thousands of utilities. Without purging unused ones (via ",[33,1338,1339],{},"content"," config), the CSS file is huge. Always configure purging.",[29,1342,1343,1346],{},[275,1344,1345],{},"Mixing methodologies is confusing",": pick one (BEM, or Tailwind, or OOCSS) and be consistent. Mixing BEM with Tailwind in the same project leads to inconsistency.",[29,1348,1349,400,1352,1355,1356,1358],{},[275,1350,1351],{},"Deeply nested selectors are a smell",[33,1353,1354],{},".card .body .title .text"," — in BEM, this should be ",[33,1357,334],{}," (flat). Nesting indicates you're not using the methodology correctly.",[29,1360,1361,400,1366,1369],{},[275,1362,1363,1365],{},[33,1364,885],{}," in Tailwind",[33,1367,1368],{},"@apply mt-4;"," in a CSS file mixes utility-first with traditional CSS. Use sparingly — it couples your CSS to Tailwind's specific utilities, reducing portability.",[29,1371,1372,1377,1378,1380,1381,1383],{},[275,1373,1374,1375],{},"IE doesn't support ",[33,1376,799],{},": for legacy browser support, use ITCSS file ordering (import order sets precedence) instead of ",[33,1379,799],{},". ",[33,1382,799],{}," is modern browsers only.",[18,1385,1387],{"id":1386},"spot-the-bug","🧠 Spot the Bug",[14,1389,1390],{},"A developer uses BEM but finds their modifier doesn't apply:",[71,1392,1393],{"language":73},[75,1394,1396],{"className":77,"code":1395,"language":73,"meta":79,"style":79},"\u003Cbutton class=\"btn--disabled\">Click\u003C\u002Fbutton>\n",[33,1397,1398],{"__ignoreMap":79},[83,1399,1400,1402,1404,1406,1408,1411,1413,1415],{"class":85,"line":86},[83,1401,90],{"class":89},[83,1403,185],{"class":93},[83,1405,98],{"class":97},[83,1407,101],{"class":89},[83,1409,1410],{"class":104},"\"btn--disabled\"",[83,1412,195],{"class":89},[83,1414,185],{"class":93},[83,1416,108],{"class":89},[71,1418,1419],{"language":212},[75,1420,1422],{"className":215,"code":1421,"language":212,"meta":79,"style":79},".btn { padding: 0.5rem 1rem; background: blue; color: white; }\n.btn--disabled { background: gray; }\n",[33,1423,1424,1463],{"__ignoreMap":79},[83,1425,1426,1428,1430,1432,1434,1437,1439,1442,1444,1446,1448,1450,1453,1455,1457,1459,1461],{"class":85,"line":86},[83,1427,48],{"class":97},[83,1429,393],{"class":89},[83,1431,487],{"class":396},[83,1433,400],{"class":89},[83,1435,1436],{"class":396},"0.5",[83,1438,425],{"class":424},[83,1440,1441],{"class":396}," 1",[83,1443,425],{"class":424},[83,1445,471],{"class":89},[83,1447,463],{"class":396},[83,1449,400],{"class":89},[83,1451,1452],{"class":396},"blue",[83,1454,471],{"class":89},[83,1456,521],{"class":396},[83,1458,400],{"class":89},[83,1460,468],{"class":396},[83,1462,406],{"class":89},[83,1464,1465,1468,1470,1472,1474,1477],{"class":85,"line":111},[83,1466,1467],{"class":97},".btn--disabled",[83,1469,393],{"class":89},[83,1471,463],{"class":396},[83,1473,400],{"class":89},[83,1475,1476],{"class":396},"gray",[83,1478,406],{"class":89},[14,1480,1481],{},"What's wrong?",[1483,1484,1485,1489,1515,1529,1532,1556,1565],"details",{},[1486,1487,1488],"summary",{},"Answer",[14,1490,1491,1492,1495,1496,1499,1500,1502,1503,1506,1507,1510,1511,1514],{},"The button only has ",[33,1493,1494],{},"class=\"btn--disabled\""," — it's missing the base ",[33,1497,1498],{},"btn"," class. In BEM, a modifier is used ",[1266,1501,1268],{}," the base: ",[33,1504,1505],{},"class=\"btn btn--disabled\"",". The modifier only sets the ",[1266,1508,1509],{},"differences"," (here, ",[33,1512,1513],{},"background: gray","); it doesn't include the base styles (padding, color, the original background).",[14,1516,1517,1518,1521,1522,1524,1525,1528],{},"With only ",[33,1519,1520],{},"btn--disabled",", the button gets ",[33,1523,1513],{}," but no padding, no ",[33,1526,1527],{},"color: white",", no base styling — it looks broken.",[14,1530,1531],{},"The fix — include both classes:",[75,1533,1535],{"className":77,"code":1534,"language":73,"meta":79,"style":79},"\u003Cbutton class=\"btn btn--disabled\">Click\u003C\u002Fbutton>\n",[33,1536,1537],{"__ignoreMap":79},[83,1538,1539,1541,1543,1545,1547,1550,1552,1554],{"class":85,"line":86},[83,1540,90],{"class":89},[83,1542,185],{"class":93},[83,1544,98],{"class":97},[83,1546,101],{"class":89},[83,1548,1549],{"class":104},"\"btn btn--disabled\"",[83,1551,195],{"class":89},[83,1553,185],{"class":93},[83,1555,108],{"class":89},[14,1557,1558,1559,1561,1562,1564],{},"Now ",[33,1560,48],{}," provides the base (padding, blue background, white text), and ",[33,1563,1467],{}," overrides the background to gray.",[14,1566,1567,1570,1571,751],{},[275,1568,1569],{},"The lesson",": BEM modifiers are always used with their base block\u002Felement. A modifier alone doesn't carry the base styles — it only sets the differences. Always include the base class: ",[33,1572,1505],{},[18,1574,1575],{"id":1486},"Summary",[14,1577,1578,1579,49,1581,49,1583,1585,1586,1588],{},"You know BEM (",[33,1580,1173],{},[33,1582,1176],{},[33,1584,1179],{},"), OOCSS (structure\u002Fskin separation), SMACSS (base\u002Flayout\u002Fmodule\u002Fstate\u002Ftheme), ITCSS (inverted triangle by specificity), Atomic\u002FTailwind (utility-first), and how ",[33,1587,799],{}," formalizes architecture — with the modifier-needs-base trap avoided. Next: CSS performance.",[1590,1591,1592],"style",{},"html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sk71V, html code.shiki .sk71V{--shiki-default:#22863A;--shiki-github-dark:#85E89D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}",{"title":79,"searchDepth":111,"depth":111,"links":1594},[1595,1596,1597],{"id":20,"depth":111,"text":21},{"id":65,"depth":111,"text":66},{"id":1486,"depth":111,"text":1575},"md",{},"\u002Fcss\u002F18-architecture-and-methodology",{"title":5,"description":16},"css\u002F18-architecture-and-methodology","Y4cZIltu74-vq4cQpe0rW9qizcQZKipwEeYRSYp2VG0",1786908609487]