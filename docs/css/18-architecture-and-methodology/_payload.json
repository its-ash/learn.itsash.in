,348],{},[29,343,344],{},"Flat specificity (all single-class selectors, 0,1,0).",[29,346,347],{},"Clear ownership (every class knows its block).",[29,349,350],{},"No specificity wars.",[18,352,354],{"id":353},"oocss-object-oriented-css","OOCSS (Object-Oriented CSS)",[14,356,357],{},"Two principles:",[359,360,361,367],"ol",{},[29,362,363,366],{},[275,364,365],{},"Separate structure from skin"," — layout (structure) separate from visual (skin).",[29,368,369,372],{},[275,370,371],{},"Separate container from content"," — components shouldn't be location-specific.",[71,374,375,529],{"language":212},[75,376,378],{"className":215,"code":377,"language":212,"meta":79,"style":79},"\u002F* Structure *\u002F\n.media { display: flex; }\n.media__img { margin-inline-end: 1rem; }\n.media__body { flex: 1; }\n\n\u002F* Skin *\u002F\n.skin-card { background: white; border-radius: 8px; padding: 1rem; box-shadow: ...; }\n.skin-dark { background: #333; color: #eee; }\n",[33,379,380,386,407,428,443,449,454,502],{"__ignoreMap":79},[83,381,382],{"class":85,"line":86},[83,383,385],{"class":384},"sdCPZ","\u002F* Structure *\u002F\n",[83,387,388,391,394,398,401,404],{"class":85,"line":111},[83,389,390],{"class":97},".media",[83,392,393],{"class":89}," { ",[83,395,397],{"class":396},"snvgF","display",[83,399,400],{"class":89},": ",[83,402,403],{"class":396},"flex",[83,405,406],{"class":89},"; }\n",[83,408,409,412,414,417,419,422,426],{"class":85,"line":137},[83,410,411],{"class":97},".media__img",[83,413,393],{"class":89},[83,415,416],{"class":396},"margin-inline-end",[83,418,400],{"class":89},[83,420,421],{"class":396},"1",[83,423,425],{"class":424},"svdQ7","rem",[83,427,406],{"class":89},[83,429,430,433,435,437,439,441],{"class":85,"line":159},[83,431,432],{"class":97},".media__body",[83,434,393],{"class":89},[83,436,403],{"class":396},[83,438,400],{"class":89},[83,440,421],{"class":396},[83,442,406],{"class":89},[83,444,445],{"class":85,"line":180},[83,446,448],{"emptyLinePlaceholder":447},t