,959,960,963],{},[33,953,954],{},"srcset"," + ",[33,957,958],{},"sizes"," let the browser pick the right image size — no CSS needed. ",[33,961,962],{},"picture"," for art direction (different images at different sizes):",[23,965,966,1036,1046],{"language":25},[27,967,969],{"className":29,"code":968,"language":25,"meta":31,"style":31},"\u003Cpicture>\n    \u003Csource media=\"(min-width: 800px)\" srcset=\"wide.jpg\">\n    \u003Cimg src=\"narrow.jpg\" alt=\"...\">\n\u003C\u002Fpicture>\n",[33,970,971,979,1005,1027],{"__ignoreMap":31},[36,972,973,975,977],{"class":38,"line":39},[36,974,43],{"class":42},[36,976,962],{"class":46},[36,978,69],{"class":42},[36,980,981,984,987,990,992,995,998,1000,1003],{"class":38,"line":98},[36,982,983],{"class":42},"    \u003C",[36,985,986],{"class":46},"source",[36,988,989],{"class":50}," media",[36,991,54],{"class":42},[36,993,994],{"class":57},"\"(min-width: 800px)\"",[36,996,997],{"class":50}," srcset",[36,999,54],{"class":42},[36,1001,1002],{"class":57},"\"wide.jpg\"",[36,1004,69],{"class":42},[36,1006,1007,1009,1011,1013,1015,1018,1021,1023,1025],{"class":38,"line":124},[36,1008,983],{"class":42},[36,1010,909],{"class":46},[36,1012,912],{"class":50},[36,1014,54],{"class":42},[36,1016,1017],{"class":57},"\"narrow.jpg\"",[36,1019,1020],{"class":50}," alt",[36,1022,54],{"class":42},[36,1024,947],{"class":57},[36,1026,69],{"class":42},[36,1028,1029,1032,1034],{"class":38,"line":146},[36,1030,1031],{"class":42},"\u003C\u002F",[36,1033,962],{"class":46},[36,1035,69],{"class":42},[410,1037,1039,1042,1043],{"id":1038},"object-fit-and-aspect-ratio",[33,1040,1041],{},"object-fit"," and ",[33,1044,1045],{},"aspect-ratio",[23,1047,1048,1128,1149,1153,1228,1232,1375,1379,1382],{"language":83},[27,1049,1051],{"className":86,"code":1050,"language":83,"meta":31,"style":31},"img {\n    width: 100%;\n    aspect-ratio: 16\u002F9;     \u002F* maintain aspect ratio *\u002F\n    object-fit: cover;      \u002F* fill, cropping if needed *\u002F\n    object-position: center;\n}\n",[33,1052,1053,1059,1075,1096,1112,1124],{"__ignoreMap":31},[36,1054,1055,1057],{"class":38,"line":39},[36,1056,909],{"class":46},[36,1058,386],{"class":42},[36,1060,1061,1064,1066,1069,1072],{"class":38,"line":98},[36,1062,1063],{"class":108},"    width",[36,1065,112],{"class":42},[36,1067,1068],{"class":108},"100",[36,1070,1071],{"class":101},"%",[36,1073,1074],{"class":42},";\n",[36,1076,1077,1080,1082,1085,1087,1090,1093],{"class":38,"line":124},[36,1078,1079],{"class":108},"    aspect-ratio",[36,1081,112],{"class":42},[36,1083,1084],{"class":108},"16",[36,1086,695],{"class":42},[36,1088,1089],{"class":108},"9",[36,1091,1092],{"class":42},";     ",[36,1094,1095],{"class":94},"\u002F* maintain aspect ratio *\u002F\n",[36,1097,1098,1101,1103,1106,1109],{"class":38,"line":146},[36,1099,1100],{"class":108},"    object-fit",[36,1102,112],{"class":42},[36,1104,1105],{"class":108},"cover",[36,1107,1108],{"class":42},";      ",[36,1110,1111],{"class":94},"\u002F* fill, cropping if needed *\u002F\n",[36,1113,1114,1117,1119,1122],{"class":38,"line":152},[36,1115,1116],{"class":108},"    object-position",[36,1118,112],{"class":42},[36,1120,1121],{"class":108},"center",[36,1123,1074],{"class":42},[36,1125,1126],{"class":38,"line":159},[36,1127,149],{"class":42},[14,1129,1130,1133,1134,1137,1138,1141,1142,1145,1146,1148],{},[33,1131,1132],{},"object-fit: cover"," fills the box, cropping overflow (like ",[33,1135,1136],{},"background-size: cover"," for ",[33,1139,1140],{},"\u003Cimg>","). ",[33,1143,1144],{},"contain"," fits entirely (letterboxing). ",[33,1147,1045],{}," maintains a ratio without padding hacks.",[18,1150,1152],{"id":1151},"tips-tricks","💡 Tips & Tricks",[1154,1155,1156,1170,1188,1199,1212],"ul",{},[1157,1158,1159,1163,1164,1166,1167,1169],"li",{},[1160,1161,1162],"strong",{},"Idiom",": use mobile-first (",[33,1165,109],{}," media queries) — write mobile styles as the base, then add styles for larger screens. Mobile is the default; larger screens get more. This is progressive enhancement and is preferred over desktop-first (",[33,1168,133],{},").",[1157,1171,1172,1174,1175,692,1177,695,1179,692,1181,1183,1184,1187],{},[1160,1173,1162],{},": use fluid CSS (",[33,1176,691],{},[33,1178,666],{},[33,1180,698],{},[33,1182,683],{},") before media queries — many responsive needs are handled without breakpoints. Reach for media queries when the layout ",[431,1185,1186],{},"fundamentally changes"," (sidebar appears\u002Fdisappears, columns reflow), not for minor adjustments.",[1157,1189,1190,1192,1193,955,1195,1198],{},[1160,1191,1162],{},": use container queries for component-level responsiveness — a card that appears in a sidebar and a main area should adapt to its container, not the viewport. ",[33,1194,802],{},[33,1196,1197],{},"@container (min-width: ...)"," makes components reusable across contexts.",[1157,1200,1201,1203,1204,1207,1208,1211],{},[1160,1202,1162],{},": use ",[33,1205,1206],{},"prefers-reduced-motion"," to respect user preferences — ",[33,1209,1210],{},"@media (prefers-reduced-motion: reduce) { * { animation: none; transition: none; } }"," disables animations for users who set the OS preference. Accessibility for motion sensitivity.",[1157,1213,1214,1203,1216,695,1218,1220,1221,1224,1225,1227],{},[1160,1215,1162],{},[33,1217,954],{},[33,1219,958],{}," for responsive images — the browser picks the right image size based on the viewport and device pixel ratio, no CSS needed. Use ",[33,1222,1223],{},"\u003Cpicture>"," for art direction (different images at different sizes), ",[33,1226,1132],{}," for cropping within a fixed aspect ratio.",[18,1229,1231],{"id":1230},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1154,1233,1234,1250,1261,1276,1293,1308,1314,1331,1346,1359],{},[1157,1235,1236,1242,1243,1246,1247,76],{},[1160,1237,1238,1241],{},[33,1239,1240],{},"100vw"," includes the scrollbar"," (on desktop): causing horizontal overflow. Use ",[33,1244,1245],{},"100%"," or ",[33,1248,1249],{},"dvw",[1157,1251,1252,112,1255,1257,1258,1260],{},[1160,1253,1254],{},"Mobile-first vs desktop-first",[33,1256,109],{}," (mobile-first) accumulates styles for larger screens; ",[33,1259,133],{}," (desktop-first) overrides for smaller. Mixing them is confusing — pick one (mobile-first preferred).",[1157,1262,1263,1268,1269,1272,1273,1275],{},[1160,1264,1265,1267],{},[33,1266,102],{}," doesn't add specificity",": a media query doesn't increase the specificity of the rules inside it. A ",[33,1270,1271],{},".btn"," inside and outside ",[33,1274,102],{}," have the same specificity — source order (the media query must come after the base) decides.",[1157,1277,1278,112,1283,1285,1286,1288,1289,1292],{},[1160,1279,1280,1281],{},"Container queries need ",[33,1282,730],{},[33,1284,758],{}," queries only work on descendants of an element with ",[33,1287,802],{}," (or ",[33,1290,1291],{},"size","). Forgetting it means the query never matches.",[1157,1294,1295,112,1301,1304,1305,1307],{},[1160,1296,1297,1300],{},[33,1298,1299],{},"container-type: size"," disables the element's own sizing",[33,1302,1303],{},"inline-size"," (horizontal queries) is usually what you want; ",[33,1306,1291],{}," (both dimensions) makes the element's size independent of its content (needs an explicit height).",[1157,1309,1310,1313],{},[1160,1311,1312],{},"Breakpoints should be content-based, not device-based",": \"if the layout breaks at 720px, use 720px\" — not \"use 768px because that's the iPad width.\" Device sizes change; content breakpoints are stable.",[1157,1315,1316,112,1324,1327,1328,1330],{},[1160,1317,1318,1320,1321],{},[33,1319,1045],{}," with ",[33,1322,1323],{},"height: auto",[33,1325,1326],{},"img { width: 100%; aspect-ratio: 16\u002F9; }"," sets the height from the ratio. But if the image has intrinsic dimensions, the browser may use them — ",[33,1329,1132],{}," clips to the ratio.",[1157,1332,1333,112,1342,1345],{},[1160,1334,1335,1337,1338,1341],{},[33,1336,954],{}," widths (",[33,1339,1340],{},"w"," units) must match the actual image dimensions",[33,1343,1344],{},"srcset=\"img.jpg 800w\""," means the image is 800px wide. Mismatch causes the browser to pick the wrong size.",[1157,1347,1348,1354,1355,1358],{},[1160,1349,1350,1353],{},[33,1351,1352],{},"prefers-color-scheme"," applies system-wide",": the user's OS dark mode setting. For a manual toggle, use a ",[33,1356,1357],{},"data-theme"," attribute and CSS variables (chapter 15).",[1157,1360,1361,1367,1368,1371,1372,1374],{},[1160,1362,1363,1366],{},[33,1364,1365],{},"@media (hover: hover)"," for hover styles on touch devices",": touch devices don't have hover; ",[33,1369,1370],{},":hover"," styles can \"stick\" after a tap. Wrap hover effects in ",[33,1373,1365],{}," to avoid this.",[18,1376,1378],{"id":1377},"spot-the-bug","🧠 Spot the Bug",[14,1380,1381],{},"A developer adds a media query for tablets, but the tablet styles don't apply:",[23,1383,1384],{"language":83},[27,1385,1387],{"className":86,"code":1386,"language":83,"meta":31,"style":31},".container { padding: 2rem; max-width: 1200px; }\n\n@media (max-width: 768px) {\n    .container { padding: 1rem; }\n}\n",[33,1388,1389,1415,1419,1435,1451],{"__ignoreMap":31},[36,1390,1391,1393,1395,1397,1399,1401,1403,1405,1407,1409,1411,1413],{"class":38,"line":39},[36,1392,458],{"class":50},[36,1394,130],{"class":42},[36,1396,463],{"class":108},[36,1398,112],{"class":42},[36,1400,511],{"class":108},[36,1402,471],{"class":101},[36,1404,241],{"class":42},[36,1406,133],{"class":108},[36,1408,112],{"class":42},[36,1410,568],{"class":108},[36,1412,118],{"class":101},[36,1414,143],{"class":42},[36,1416,1417],{"class":38,"line":98},[36,1418,156],{"emptyLinePlaceholder":155},[36,1420,1421,1423,1425,1427,1429,1431,1433],{"class":38,"line":124},[36,1422,102],{"class":101},[36,1424,105],{"class":42},[36,1426,133],{"class":108},[36,1428,112],{"class":42},[36,1430,115],{"class":108},[36,1432,118],{"class":101},[36,1434,121],{"class":42},[36,1436,1437,1439,1441,1443,1445,1447,1449],{"class":38,"line":146},[36,1438,127],{"class":50},[36,1440,130],{"class":42},[36,1442,463],{"class":108},[36,1444,112],{"class":42},[36,1446,468],{"class":108},[36,1448,471],{"class":101},[36,1450,143],{"class":42},[36,1452,1453],{"class":38,"line":152},[36,1454,149],{"class":42},[14,1456,1457],{},"The tablet (768px wide) shows desktop padding. Why?",[1459,1460,1461,1465,1468,1497,1508,1521,1527,1607,1613],"details",{},[1462,1463,1464],"summary",{},"Answer",[14,1466,1467],{},"Two possible issues:",[1469,1470,1471,1491],"ol",{},[1157,1472,1473,1479,1480,1482,1483,1486,1487,1490],{},[1160,1474,1475,1478],{},[33,1476,1477],{},"max-width: 768px"," doesn't include exactly 768px on some engines"," — but actually, ",[33,1481,1477],{}," ",[431,1484,1485],{},"does"," include 768px (it's ",[33,1488,1489],{},"\u003C=","). So this isn't the bug.",[1157,1492,1493,1496],{},[1160,1494,1495],{},"The real issue: viewport width vs CSS pixels"," — the tablet's viewport might be reported as a different width due to device pixel ratio or the viewport meta tag. But more likely, the developer is testing on a device\u002Fbrowser where the viewport isn't exactly 768px.",[14,1498,1499,1500,1503,1504,1507],{},"Actually, the most likely bug is that the ",[1160,1501,1502],{},"base rule and the media query have the same specificity",", and the base rule comes ",[431,1505,1506],{},"after"," the media query in some build, or the media query's rule isn't being applied because... no, the media query is after the base, so it should win at 768px.",[14,1509,1510,1511,1517,1518,1520],{},"The actual classic bug: ",[1160,1512,1513,1514,1516],{},"the developer is desktop-first (",[33,1515,133],{},") but testing on a viewport wider than 768px",". At 769px+, ",[33,1519,1477],{}," doesn't match, so the base (desktop) padding applies. The tablet needs to be ≤768px for the media query to apply. If the tablet reports a viewport of 800px (CSS pixels), the media query doesn't fire.",[14,1522,1523,1524,1526],{},"The deeper fix — use mobile-first (",[33,1525,109],{},"), so the base is mobile and larger screens override:",[27,1528,1530],{"className":86,"code":1529,"language":83,"meta":31,"style":31},"\u002F* Base: mobile *\u002F\n.container { padding: 1rem; }\n\n\u002F* Desktop+ *\u002F\n@media (min-width: 769px) {\n    .container { padding: 2rem; max-width: 1200px; }\n}\n",[33,1531,1532,1536,1552,1556,1560,1577,1603],{"__ignoreMap":31},[36,1533,1534],{"class":38,"line":39},[36,1535,453],{"class":94},[36,1537,1538,1540,1542,1544,1546,1548,1550],{"class":38,"line":98},[36,1539,458],{"class":50},[36,1541,130],{"class":42},[36,1543,463],{"class":108},[36,1545,112],{"class":42},[36,1547,468],{"class":108},[36,1549,471],{"class":101},[36,1551,143],{"class":42},[36,1553,1554],{"class":38,"line":124},[36,1555,156],{"emptyLinePlaceholder":155},[36,1557,1558],{"class":38,"line":146},[36,1559,528],{"class":94},[36,1561,1562,1564,1566,1568,1570,1573,1575],{"class":38,"line":152},[36,1563,102],{"class":101},[36,1565,105],{"class":42},[36,1567,109],{"class":108},[36,1569,112],{"class":42},[36,1571,1572],{"class":108},"769",[36,1574,118],{"class":101},[36,1576,121],{"class":42},[36,1578,1579,1581,1583,1585,1587,1589,1591,1593,1595,1597,1599,1601],{"class":38,"line":159},[36,1580,127],{"class":50},[36,1582,130],{"class":42},[36,1584,463],{"class":108},[36,1586,112],{"class":42},[36,1588,511],{"class":108},[36,1590,471],{"class":101},[36,1592,241],{"class":42},[36,1594,133],{"class":108},[36,1596,112],{"class":42},[36,1598,568],{"class":108},[36,1600,118],{"class":101},[36,1602,143],{"class":42},[36,1604,1605],{"class":38,"line":165},[36,1606,149],{"class":42},[14,1608,1609,1610,1612],{},"This avoids the \"does 768px match ",[33,1611,1477],{},"?\" confusion and is the preferred pattern.",[14,1614,1615,1618,1619,1621,1622,76],{},[1160,1616,1617],{},"The lesson",": check the actual viewport width in DevTools (device toolbar), and prefer mobile-first (",[33,1620,109],{},") to avoid boundary confusion. A tablet reporting 800px CSS width won't match ",[33,1623,1477],{},[18,1625,1626],{"id":1462},"Summary",[14,1628,1629,1630,692,1632,692,1634,1636,1637,1639,1640,695,1642,695,1644,1646,1647,955,1649,1651,1652,695,1654,695,1656,695,1658,695,1660,1662],{},"You can now use the viewport meta tag, media queries (width, ",[33,1631,1352],{},[33,1633,1206],{},[33,1635,328],{},", print), mobile-first (",[33,1638,109],{},"), fluid CSS (",[33,1641,834],{},[33,1643,666],{},[33,1645,683],{},"), container queries (",[33,1648,730],{},[33,1650,758],{},"), and responsive images (",[33,1653,954],{},[33,1655,958],{},[33,1657,962],{},[33,1659,1041],{},[33,1661,1045],{},"). Next: floats and positioning deep dive.",[1664,1665,1666],"style",{},"html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sk71V, html code.shiki .sk71V{--shiki-default:#22863A;--shiki-github-dark:#85E89D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-b