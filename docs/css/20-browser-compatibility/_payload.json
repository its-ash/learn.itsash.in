4,411],{"emptyLinePlaceholder":410},[99,876,877,879],{"class":101,"line":175},[99,878,823],{"class":129},[99,880,881],{"class":109}," base {\n",[99,883,884,886,888,890,892,894,896,899,901,904,907,909,912],{"class":101,"line":193},[99,885,843],{"class":105},[99,887,846],{"class":109},[99,889,426],{"class":116},[99,891,120],{"class":109},[99,893,431],{"class":116},[99,895,855],{"class":109},[99,897,898],{"class":116},"grid-template-rows",[99,900,120],{"class":109},[99,902,903],{"class":116},"auto",[99,905,906],{"class":116}," 1",[99,908,467],{"class":129},[99,910,911],{"class":116}," auto",[99,913,866],{"class":109},[99,915,916],{"class":101,"line":211},[99,917,214],{"class":109},[14,919,805,920,922,923,926,927,929,930,926,933,935],{},[50,921,431],{}," is unsupported, the ",[50,924,925],{},"fallback"," layer's ",[50,928,531],{}," applies (the ",[50,931,932],{},"base",[50,934,431],{}," is ignored). Layer order ensures the enhanced version wins when supported.",[18,937,939],{"id":938},"internet-explorer-and-old-browsers","Internet Explorer and Old Browsers",[14,941,942],{},"IE 11 is mostly dead (Microsoft dropped support 2022), but some legacy contexts still need it. Strategies:",[236,944,945,951,957],{},[239,946,947,950],{},[224,948,949],{},"Don't support IE"," — most modern sites drop it. Use modern CSS freely.",[239,952,953,956],{},[224,954,955],{},"Provide a functional fallback"," — basic layout with floats\u002Fflexbox, no grid\u002Fcustom properties.",[239,958,959,963,964,966,967,969],{},[224,960,678,961],{},[50,962,346],{}," — detect grid\u002Fcustom-properties support; IE doesn't support ",[50,965,346],{}," either, so IE gets the fallback (outside ",[50,968,346],{},").",[18,971,973],{"id":972},"polyfills-and-shirks","Polyfills and Shirks",[14,975,976],{},"Some CSS features can be polyfilled in JS:",[236,978,979,989,1003],{},[239,980,981,984,985,988],{},[224,982,983],{},"CSS variables"," — ",[50,986,987],{},"ie11-custom-properties"," polyfill.",[239,990,991,984,996,396,999,1002],{},[224,992,993],{},[50,994,995],{},":has()",[50,997,998],{},"qawolf",[50,1000,1001],{},"css-has-polyfill",".",[239,1004,1005,984,1008,1002],{},[224,1006,1007],{},"Container queries",[50,1009,1010],{},"cqfill",[14,1012,1013,1014,1016],{},"But JS polyfills have overhead. Prefer ",[50,1015,346],{}," + fallbacks over polyfills when possible.",[18,1018,1020],{"id":1019},"can-i-use","Can I Use",[14,1022,1023,1030],{},[1024,1025,1029],"a",{"href":1026,"rel":1027},"https:\u002F\u002Fcaniuse.com",[1028],"nofollow","caniuse.com"," is the reference for CSS feature support across browsers. Check it before using a newer feature. Filter by your target browsers.",[18,1032,1034],{"id":1033},"browser-testing","Browser Testing",[236,1036,1037,1043,1055,1061],{},[239,1038,1039,1042],{},[224,1040,1041],{},"BrowserStack \u002F LambdaTest"," — test across browsers\u002FOSs (paid).",[239,1044,1045,1048,1049,779,1052,1002],{},[224,1046,1047],{},"Chrome DevTools → Emulate"," — emulate mobile devices, ",[50,1050,1051],{},"prefers-color-scheme",[50,1053,1054],{},"prefers-reduced-motion",[239,1056,1057,1060],{},[224,1058,1059],{},"Firefox Developer Edition"," — different rendering engine (Gecko), good for cross-engine testing.",[239,1062,1063,1066],{},[224,1064,1065],{},"Safari"," — WebKit (different from Chrome's Blink). Test Safari for WebKit-specific behavior (it's often the laggard).",[18,1068,1070],{"id":1069},"tips-tricks","💡 Tips & Tricks",[236,1072,1073,1086,1103,1118,1127],{},[239,1074,1075,1078,1079,1081,1082,1085],{},[224,1076,1077],{},"Idiom",": use Autoprefixer (not hand-written prefixes) — configure ",[50,1080,276],{}," (e.g., ",[50,1083,1084],{},"last 2 versions, > 1%, not dead",") and let Autoprefixer add\u002Fremove prefixes based on your target. Hand-writing prefixes is error-prone and leaves obsolete ones.",[239,1087,1088,1090,1091,1093,1094,1097,1098,1100,1101,969],{},[224,1089,1077],{},": use ",[50,1092,346],{}," for progressive enhancement — provide a fallback for all browsers, then ",[50,1095,1096],{},"@supports (display: grid) { \u002F* enhanced *\u002F }",". This is better than UA sniffing (fragile) and works even when ",[50,1099,346],{}," itself is unsupported (IE gets the fallback outside ",[50,1102,346],{},[239,1104,1105,1107,1108,1110,1111,1114,1115,1117],{},[224,1106,1077],{},": put fallbacks ",[694,1109,696],{}," new properties — ",[50,1112,1113],{},"width: 300px; display: grid;",". If ",[50,1116,808],{}," is unsupported, the browser ignores it and uses the earlier value. The cascade's \"last supported value wins\" handles fallbacks naturally.",[239,1119,1120,1122,1123,1126],{},[224,1121,1077],{},": check ",[1024,1124,1029],{"href":1026,"rel":1125},[1028]," before using a newer feature — it shows support across browsers with version numbers and known issues. Filter by your target browsers.",[239,1128,1129,1131,1132,1134],{},[224,1130,1077],{},": test in Safari (WebKit) for cross-engine correctness — Chrome (Blink) and Safari (WebKit) differ. Safari is often the laggard for newer CSS (container queries, ",[50,1133,995],{}," came later). Test both.",[18,1136,1138],{"id":1137},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[236,1140,1141,1154,1176,1188,1199,1207,1227,1240,1252,1267],{},[239,1142,1143,1146,1147,396,1149,1151,1152,1002],{},[224,1144,1145],{},"Prefixes are mostly obsolete",": most CSS properties work unprefixed in all modern browsers. Don't add ",[50,1148,52],{},[50,1150,62],{}," to everything — it clutters and some prefixed versions have bugs. Use Autoprefixer with a current ",[50,1153,276],{},[239,1155,1156,1161,1162,1164,1165,1168,1169,1171,1172,1175],{},[224,1157,1158,1160],{},[50,1159,346],{}," itself isn't supported in IE",": IE 11 doesn't support ",[50,1163,346],{},". So IE gets the CSS ",[694,1166,1167],{},"outside"," ",[50,1170,346],{}," (the fallback), and the ",[50,1173,1174],{},"@supports (display: grid)"," block is ignored — which is usually what you want.",[239,1177,1178,120,1181,1183,1184,1187],{},[224,1179,1180],{},"Prefixed and unprefixed can differ",[50,1182,243],{}," and ",[50,1185,1186],{},"background-clip: text"," can have slightly different behavior in older WebKit. Test both.",[239,1189,1190,1195,1196,1198],{},[224,1191,1192,1194],{},[50,1193,52],{}," for Safari only",": some features (backdrop-filter, background-clip: text, mask) need ",[50,1197,52],{}," in Safari even today. Autoprefixer handles these; if hand-writing, include both.",[239,1200,1201,120,1204,1206],{},[224,1202,1203],{},"Safari is often the laggard",[50,1205,995],{}," shipped in Safari 15.4 (Chrome 105), container queries in Safari 16 (Chrome 105), subgrid in Safari 16 (Chrome 117). Check Safari support specifically.",[239,1208,1209,1214,1215,1218,1219,1222,1223,1226],{},[224,1210,1211],{},[50,1212,1213],{},"@supports not (...)",": the ",[50,1216,1217],{},"not"," keyword negates. ",[50,1220,1221],{},"@supports not (display: grid)"," matches browsers ",[694,1224,1225],{},"without"," grid support (IE). Useful for IE-only fallbacks.",[239,1228,1229,120,1232,1235,1236,1239],{},[224,1230,1231],{},"Feature detection isn't bug detection",[50,1233,1234],{},"@supports (property: value)"," checks if the browser ",[694,1237,1238],{},"claims"," to support it, not if it works correctly. Some browsers have partial\u002Fbuggy support (e.g., gap in flexbox was in Chrome but buggy for a while).",[239,1241,1242,1248,1249,1251],{},[224,1243,1244,1245,1247],{},"Forking by ",[50,1246,346],{}," can bloat CSS",": too many ",[50,1250,346],{}," branches make the CSS large. Use for major enhancements (grid vs flex), not for every property.",[239,1253,1254,120,1259,1262,1263,1266],{},[224,1255,1256,1258],{},[50,1257,276],{}," affects Autoprefixer",[50,1260,1261],{},"last 2 versions"," adds few prefixes (modern browsers); ",[50,1264,1265],{},"> 1%"," adds more for popular older browsers. Choose your target realistically.",[239,1268,1269,120,1275,1277,1278,1280,1281,1283],{},[224,1270,1271,1274],{},[50,1272,1273],{},"@import"," for fallbacks is slow",[50,1276,1273],{}," is render-blocking. Don't use ",[50,1279,1273],{}," for browser-specific CSS — use ",[50,1282,346],{}," or conditional classes.",[18,1285,1287],{"id":1286},"spot-the-bug","🧠 Spot the Bug",[14,1289,1290,1291,1294],{},"A developer uses ",[50,1292,1293],{},"backdrop-filter"," for a glassmorphism effect, but it doesn't work in Safari:",[87,1296,1297],{"language":89},[91,1298,1300],{"className":93,"code":1299,"language":89,"meta":95,"style":95},".glass {\n    background: rgba(255, 255, 255, 0.2);\n    backdrop-filter: blur(10px);\n}\n",[50,1301,1302,1309,1339,1358],{"__ignoreMap":95},[99,1303,1304,1307],{"class":101,"line":102},[99,1305,1306],{"class":105},".glass",[99,1308,110],{"class":109},[99,1310,1311,1313,1315,1318,1320,1323,1325,1327,1329,1331,1333,1336],{"class":101,"line":113},[99,1312,376],{"class":116},[99,1314,120],{"class":109},[99,1316,1317],{"class":116},"rgba",[99,1319,384],{"class":109},[99,1321,1322],{"class":116},"255",[99,1324,779],{"class":109},[99,1326,1322],{"class":116},[99,1328,779],{"class":109},[99,1330,1322],{"class":116},[99,1332,779],{"class":109},[99,1334,1335],{"class":116},"0.2",[99,1337,1338],{"class":109},");\n",[99,1340,1341,1344,1346,1349,1351,1354,1356],{"class":101,"line":139},[99,1342,1343],{"class":116},"    backdrop-filter",[99,1345,120],{"class":109},[99,1347,1348],{"class":116},"blur",[99,1350,384],{"class":109},[99,1352,1353],{"class":116},"10",[99,1355,728],{"class":129},[99,1357,1338],{"class":109},[99,1359,1360],{"class":101,"line":157},[99,1361,214],{"class":109},[14,1363,1364],{},"What's missing?",[1366,1367,1368,1372,1381,1463,1472,1481],"details",{},[1369,1370,1371],"summary",{},"Answer",[14,1373,1374,1375,1377,1378,1380],{},"Safari (older versions, and some current contexts) requires the ",[50,1376,52],{}," prefix for ",[50,1379,1293],{},":",[91,1382,1384],{"className":93,"code":1383,"language":89,"meta":95,"style":95},".glass {\n    background: rgba(255, 255, 255, 0.2);\n    -webkit-backdrop-filter: blur(10px);  \u002F* Safari *\u002F\n    backdrop-filter: blur(10px);          \u002F* standard *\u002F\n}\n",[50,1385,1386,1392,1418,1439,1459],{"__ignoreMap":95},[99,1387,1388,1390],{"class":101,"line":102},[99,1389,1306],{"class":105},[99,1391,110],{"class":109},[99,1393,1394,1396,1398,1400,1402,1404,1406,1408,1410,1412,1414,1416],{"class":101,"line":113},[99,1395,376],{"class":116},[99,1397,120],{"class":109},[99,1399,1317],{"class":116},[99,1401,384],{"class":109},[99,1403,1322],{"class":116},[99,1405,779],{"class":109},[99,1407,1322],{"class":116},[99,1409,779],{"class":109},[99,1411,1322],{"class":116},[99,1413,779],{"class":109},[99,1415,1335],{"class":116},[99,1417,1338],{"class":109},[99,1419,1420,1423,1425,1427,1429,1431,1433,1436],{"class":101,"line":139},[99,1421,1422],{"class":116},"    -webkit-backdrop-filter",[99,1424,120],{"class":109},[99,1426,1348],{"class":116},[99,1428,384],{"class":109},[99,1430,1353],{"class":116},[99,1432,728],{"class":129},[99,1434,1435],{"class":109},");  ",[99,1437,1438],{"class":291},"\u002F* Safari *\u002F\n",[99,1440,1441,1443,1445,1447,1449,1451,1453,1456],{"class":101,"line":157},[99,1442,1343],{"class":116},[99,1444,120],{"class":109},[99,1446,1348],{"class":116},[99,1448,384],{"class":109},[99,1450,1353],{"class":116},[99,1452,728],{"class":129},[99,1454,1455],{"class":109},");          ",[99,1457,1458],{"class":291},"\u002F* standard *\u002F\n",[99,1460,1461],{"class":101,"line":175},[99,1462,214],{"class":109},[14,1464,1465,1466,1468,1469,1471],{},"Without ",[50,1467,249],{},", Safari ignores the unprefixed ",[50,1470,1293],{}," (in versions that need the prefix), and the glass effect doesn't appear — the card is just a translucent panel with no blur.",[14,1473,1474,1475,1477,1478,1480],{},"The fix — include the ",[50,1476,52],{}," prefix (before the unprefixed, so the standard wins when supported). Or use Autoprefixer with a ",[50,1479,276],{}," that includes Safari, which adds the prefix automatically.",[14,1482,1483,1486,1487,1489],{},[224,1484,1485],{},"The lesson",": some CSS features (backdrop-filter, background-clip: text, mask) still need ",[50,1488,52],{}," in Safari. Include both prefixed and unprefixed (prefixed first), or use Autoprefixer to add them automatically based on your browser targets.",[18,1491,1492],{"id":1369},"Summary",[14,1494,1495,1496,1498,1499,1501,1502,1504],{},"You can now handle vendor prefixes (Autoprefixer with ",[50,1497,276],{},", not hand-written), use ",[50,1500,346],{}," for progressive enhancement (fallback + enhanced), provide property fallbacks (fallback before new property), test cross-browser (Safari\u002FWebKit especially), and consult caniuse.com — with the Safari ",[50,1503,249],{}," trap avoided. Next: CSS preprocessors and build tools.",[1506,1507,1508],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}",{"title":95,"searchDepth":113,"depth":113,"links":1510},[1511,1516],{"id":20,"depth":113,"text":21,"children":1512},[1513,1514,1515],{"id":218,"depth":139,"text":219},{"id":230,"depth":139,"text":231},{"id":266,"depth":139,"text":267},{"id":1369,"depth":113,"text":1492},"md",{},"\u002Fcss\u002F20-browser-compatibility",{"title":5,"description":16},"css\u002F20-browser-compatibility","FHl-AGo0cgEf-zdWlujLIbzTTVg_g3WFlU74dK4fuGc",1786908609516]