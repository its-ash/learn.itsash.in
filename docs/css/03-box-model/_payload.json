[{"data":1,"prerenderedAt":1210},["ShallowReactive",2],{"page-\u002Fcss\u002F03-box-model":3},{"id":4,"title":5,"body":6,"description":16,"extension":1204,"meta":1205,"navigation":236,"path":1206,"seo":1207,"stem":1208,"__hash__":1209},"content\u002Fcss\u002F03-box-model.md","03 — The Box Model",{"type":7,"value":8,"toc":1199},"minimark",[9,13,17,22,1033,1036,1180,1183,1195],[10,11,5],"h1",{"id":12},"_03-the-box-model",[14,15,16],"p",{},"Every HTML element is a rectangular box with four layers: content, padding, border, margin. Understanding the box model is essential — it's the foundation of layout.",[18,19,21],"h2",{"id":20},"the-layers","The Layers",[23,24,26,36,84,89,109],"code-wrapper",{"language":25},"text",[27,28,33],"pre",{"className":29,"code":31,"language":25,"meta":32},[30],"language-text","┌─────────────────────────────────┐\n│           margin                │\n│  ┌───────────────────────────┐  │\n│  │         border            │  │\n│  │  ┌─────────────────────┐  │  │\n│  │  │      padding        │  │  │\n│  │  │  ┌───────────────┐  │  │  │\n│  │  │  │    content    │  │  │  │\n│  │  │  └───────────────┘  │  │  │\n│  │  └─────────────────────┘  │  │\n│  └───────────────────────────┘  │\n└─────────────────────────────────┘\n","",[34,35,31],"code",{"__ignoreMap":32},[37,38,39,55,65,74],"ul",{},[40,41,42,46,47,50,51,54],"li",{},[43,44,45],"strong",{},"Content"," — the element's content (text, image, child elements). ",[34,48,49],{},"width","\u002F",[34,52,53],{},"height"," set this (by default).",[40,56,57,60,61,64],{},[43,58,59],{},"Padding"," — space inside the border. ",[34,62,63],{},"padding"," adds to the element's size.",[40,66,67,70,71,64],{},[43,68,69],{},"Border"," — the border line. ",[34,72,73],{},"border",[40,75,76,79,80,83],{},[43,77,78],{},"Margin"," — space outside the border, between this element and others. ",[34,81,82],{},"margin"," doesn't add to the element's size but affects layout.",[18,85,87],{"id":86},"box-sizing",[34,88,86],{},[14,90,91,92,95,96,50,98,100,101,105,106,108],{},"The default is ",[34,93,94],{},"box-sizing: content-box"," — ",[34,97,49],{},[34,99,53],{}," set only the content area. Padding and border are ",[102,103,104],"em",{},"added"," on top, making the actual element larger than ",[34,107,49],{},":",[23,110,111,117,126],{"language":25},[27,112,115],{"className":113,"code":114,"language":25,"meta":32},[30],"content-box: width: 100px + padding: 10px + border: 2px = 124px actual width\n",[34,116,114],{"__ignoreMap":32},[14,118,119,120,108],{},"This is counterintuitive and a common source of layout bugs. ",[43,121,122,123],{},"Use ",[34,124,125],{},"border-box",[23,127,129,159,171],{"language":128},"css",[27,130,133],{"className":131,"code":132,"language":128,"meta":32,"style":32},"language-css shiki shiki-themes github-light github-dark","* { box-sizing: border-box; }\n",[34,134,135],{"__ignoreMap":32},[136,137,140,144,148,151,154,156],"span",{"class":138,"line":139},"line",1,[136,141,143],{"class":142},"sk71V","*",[136,145,147],{"class":146},"ssxIu"," { ",[136,149,86],{"class":150},"snvgF",[136,152,153],{"class":146},": ",[136,155,125],{"class":150},[136,157,158],{"class":146},"; }\n",[14,160,161,162,164,165,167,168,170],{},"With ",[34,163,125],{},", ",[34,166,49],{}," includes padding and border — the element is exactly ",[34,169,49],{}," wide:",[23,172,173,179,184,188],{"language":25},[27,174,177],{"className":175,"code":176,"language":25,"meta":32},[30],"border-box: width: 100px (includes padding + border) = 100px actual width\n",[34,178,176],{"__ignoreMap":32},[14,180,181,183],{},[34,182,125],{}," is the modern default — include this reset at the top of every stylesheet.",[18,185,187],{"id":186},"margin-and-padding-shorthands","Margin and Padding Shorthands",[23,189,190,312,322,326,333],{"language":128},[27,191,193],{"className":131,"code":192,"language":128,"meta":32,"style":32},"margin: 10px;                     \u002F* all four sides *\u002F\nmargin: 10px 20px;                \u002F* top\u002Fbottom  left\u002Fright *\u002F\nmargin: 10px 20px 30px;           \u002F* top  left\u002Fright  bottom *\u002F\nmargin: 10px 20px 30px 40px;     \u002F* top  right  bottom  left (clockwise from top) *\u002F\n\nmargin-top: 10px;                 \u002F* individual sides *\u002F\nmargin-right: 20px;\nmargin-bottom: 30px;\nmargin-left: 40px;\n\n\u002F* Logical properties (writing-mode aware) *\u002F\nmargin-block: 10px;               \u002F* top\u002Fbottom in horizontal writing mode *\u002F\nmargin-inline: 20px;              \u002F* left\u002Fright in horizontal writing mode *\u002F\n",[34,194,195,204,213,222,231,238,250,259,268,277,282,288,300],{"__ignoreMap":32},[136,196,197,200],{"class":138,"line":139},[136,198,199],{"class":146},"margin: 10px;                     ",[136,201,203],{"class":202},"sdCPZ","\u002F* all four sides *\u002F\n",[136,205,207,210],{"class":138,"line":206},2,[136,208,209],{"class":146},"margin: 10px 20px;                ",[136,211,212],{"class":202},"\u002F* top\u002Fbottom  left\u002Fright *\u002F\n",[136,214,216,219],{"class":138,"line":215},3,[136,217,218],{"class":146},"margin: 10px 20px 30px;           ",[136,220,221],{"class":202},"\u002F* top  left\u002Fright  bottom *\u002F\n",[136,223,225,228],{"class":138,"line":224},4,[136,226,227],{"class":146},"margin: 10px 20px 30px 40px;     ",[136,229,230],{"class":202},"\u002F* top  right  bottom  left (clockwise from top) *\u002F\n",[136,232,234],{"class":138,"line":233},5,[136,235,237],{"emptyLinePlaceholder":236},true,"\n",[136,239,241,244,247],{"class":138,"line":240},6,[136,242,243],{"class":142},"margin-top",[136,245,246],{"class":146},": 10px;                 ",[136,248,249],{"class":202},"\u002F* individual sides *\u002F\n",[136,251,253,256],{"class":138,"line":252},7,[136,254,255],{"class":142},"margin-right",[136,257,258],{"class":146},": 20px;\n",[136,260,262,265],{"class":138,"line":261},8,[136,263,264],{"class":142},"margin-bottom",[136,266,267],{"class":146},": 30px;\n",[136,269,271,274],{"class":138,"line":270},9,[136,272,273],{"class":142},"margin-left",[136,275,276],{"class":146},": 40px;\n",[136,278,280],{"class":138,"line":279},10,[136,281,237],{"emptyLinePlaceholder":236},[136,283,285],{"class":138,"line":284},11,[136,286,287],{"class":202},"\u002F* Logical properties (writing-mode aware) *\u002F\n",[136,289,291,294,297],{"class":138,"line":290},12,[136,292,293],{"class":142},"margin-block",[136,295,296],{"class":146},": 10px;               ",[136,298,299],{"class":202},"\u002F* top\u002Fbottom in horizontal writing mode *\u002F\n",[136,301,303,306,309],{"class":138,"line":302},13,[136,304,305],{"class":142},"margin-inline",[136,307,308],{"class":146},": 20px;              ",[136,310,311],{"class":202},"\u002F* left\u002Fright in horizontal writing mode *\u002F\n",[14,313,314,315,317,318,321],{},"The same pattern applies to ",[34,316,63],{},". The 4-value order is ",[43,319,320],{},"TRBL"," (Top, Right, Bottom, Left) — clockwise from top. Mnemonic: \"T-RouBLe.\"",[18,323,325],{"id":324},"margin-collapsing","Margin Collapsing",[14,327,328,329,332],{},"Vertical margins between block elements ",[43,330,331],{},"collapse"," — the larger margin wins, they don't add:",[23,334,335,341,344,355,358,376,379,383,389],{"language":25},[27,336,339],{"className":337,"code":338,"language":25,"meta":32},[30],"\u003Cp style=\"margin-bottom: 30px\">A\u003C\u002Fp>\n\u003Cp style=\"margin-top: 20px\">B\u003C\u002Fp>\n\u002F* Gap between A and B: 30px (the larger), NOT 50px *\u002F\n",[34,340,338],{"__ignoreMap":32},[14,342,343],{},"Margin collapsing rules:",[37,345,346,349,352],{},[40,347,348],{},"Adjacent siblings' vertical margins collapse.",[40,350,351],{},"Parent and first\u002Flast child margins collapse (if no padding\u002Fborder separates them).",[40,353,354],{},"Empty blocks' top and bottom margins collapse (if no padding\u002Fborder\u002Fheight).",[14,356,357],{},"Margins don't collapse:",[37,359,360,363,366,373],{},[40,361,362],{},"Horizontally (left\u002Fright margins don't collapse).",[40,364,365],{},"In flex\u002Fgrid containers (flex\u002Fgrid items don't collapse).",[40,367,368,369,372],{},"With padding\u002Fborder between them (a parent with ",[34,370,371],{},"padding-top: 1px"," prevents parent-child collapse).",[40,374,375],{},"Floating or absolutely positioned elements.",[14,377,378],{},"Margin collapsing is a frequent source of \"why is the gap smaller than I expected?\" Debug with DevTools' box model visualization.",[18,380,382],{"id":381},"negative-margins","Negative Margins",[14,384,385,388],{},[34,386,387],{},"margin: -10px"," pulls the element (or neighbors) closer — it can overlap:",[23,390,391,421,424,437],{"language":128},[27,392,394],{"className":131,"code":393,"language":128,"meta":32,"style":32},".pull-up { margin-top: -20px; }   \u002F* moves the element up, overlapping the previous *\u002F\n",[34,395,396],{"__ignoreMap":32},[136,397,398,402,404,406,408,411,415,418],{"class":138,"line":139},[136,399,401],{"class":400},"sIsaT",".pull-up",[136,403,147],{"class":146},[136,405,243],{"class":150},[136,407,153],{"class":146},[136,409,410],{"class":150},"-20",[136,412,414],{"class":413},"svdQ7","px",[136,416,417],{"class":146},"; }   ",[136,419,420],{"class":202},"\u002F* moves the element up, overlapping the previous *\u002F\n",[14,422,423],{},"Negative margins are a hack for specific effects (overlapping, stretching). Use carefully — they can cause overlap and layout confusion.",[18,425,427,164,429,164,431,164,434],{"id":426},"width-height-min-max",[34,428,49],{},[34,430,53],{},[34,432,433],{},"min-",[34,435,436],{},"max-",[23,438,439,529,539],{"language":128},[27,440,442],{"className":131,"code":441,"language":128,"meta":32,"style":32},".box {\n    width: 300px;          \u002F* content width (border-box: total width) *\u002F\n    height: 200px;\n    min-width: 200px;      \u002F* won't shrink below this *\u002F\n    max-width: 500px;      \u002F* won't grow above this *\u002F\n    \u002F* min\u002Fmax are useful for responsive: width: 100%; max-width: 600px *\u002F\n}\n",[34,443,444,452,470,485,502,519,524],{"__ignoreMap":32},[136,445,446,449],{"class":138,"line":139},[136,447,448],{"class":400},".box",[136,450,451],{"class":146}," {\n",[136,453,454,457,459,462,464,467],{"class":138,"line":206},[136,455,456],{"class":150},"    width",[136,458,153],{"class":146},[136,460,461],{"class":150},"300",[136,463,414],{"class":413},[136,465,466],{"class":146},";          ",[136,468,469],{"class":202},"\u002F* content width (border-box: total width) *\u002F\n",[136,471,472,475,477,480,482],{"class":138,"line":215},[136,473,474],{"class":150},"    height",[136,476,153],{"class":146},[136,478,479],{"class":150},"200",[136,481,414],{"class":413},[136,483,484],{"class":146},";\n",[136,486,487,490,492,494,496,499],{"class":138,"line":224},[136,488,489],{"class":150},"    min-width",[136,491,153],{"class":146},[136,493,479],{"class":150},[136,495,414],{"class":413},[136,497,498],{"class":146},";      ",[136,500,501],{"class":202},"\u002F* won't shrink below this *\u002F\n",[136,503,504,507,509,512,514,516],{"class":138,"line":233},[136,505,506],{"class":150},"    max-width",[136,508,153],{"class":146},[136,510,511],{"class":150},"500",[136,513,414],{"class":413},[136,515,498],{"class":146},[136,517,518],{"class":202},"\u002F* won't grow above this *\u002F\n",[136,520,521],{"class":138,"line":240},[136,522,523],{"class":202},"    \u002F* min\u002Fmax are useful for responsive: width: 100%; max-width: 600px *\u002F\n",[136,525,526],{"class":138,"line":252},[136,527,528],{"class":146},"}\n",[14,530,531,534,535,538],{},[34,532,533],{},"max-width"," with ",[34,536,537],{},"width: 100%"," is the responsive pattern — fill the container, but cap at a max:",[23,540,541,589,594,597],{"language":128},[27,542,544],{"className":131,"code":543,"language":128,"meta":32,"style":32},".container { width: 100%; max-width: 1200px; margin: 0 auto; }\n",[34,545,546],{"__ignoreMap":32},[136,547,548,551,553,555,557,560,563,566,568,570,573,575,577,579,581,584,587],{"class":138,"line":139},[136,549,550],{"class":400},".container",[136,552,147],{"class":146},[136,554,49],{"class":150},[136,556,153],{"class":146},[136,558,559],{"class":150},"100",[136,561,562],{"class":413},"%",[136,564,565],{"class":146},"; ",[136,567,533],{"class":150},[136,569,153],{"class":146},[136,571,572],{"class":150},"1200",[136,574,414],{"class":413},[136,576,565],{"class":146},[136,578,82],{"class":150},[136,580,153],{"class":146},[136,582,583],{"class":150},"0",[136,585,586],{"class":150}," auto",[136,588,158],{"class":146},[18,590,592],{"id":591},"overflow",[34,593,591],{},[14,595,596],{},"What happens when content exceeds the element's size:",[23,598,599,703,709,713,788,792,962,966,969],{"language":128},[27,600,602],{"className":131,"code":601,"language":128,"meta":32,"style":32},".box {\n    overflow: hidden;     \u002F* clip the overflow *\u002F\n    overflow: auto;       \u002F* scroll if needed *\u002F\n    overflow: scroll;     \u002F* always show scrollbars *\u002F\n    overflow: visible;    \u002F* let it overflow (default) *\u002F\n    overflow-x: hidden;   \u002F* horizontal *\u002F\n    overflow-y: auto;     \u002F* vertical (can differ) *\u002F\n}\n",[34,603,604,610,626,641,655,670,685,699],{"__ignoreMap":32},[136,605,606,608],{"class":138,"line":139},[136,607,448],{"class":400},[136,609,451],{"class":146},[136,611,612,615,617,620,623],{"class":138,"line":206},[136,613,614],{"class":150},"    overflow",[136,616,153],{"class":146},[136,618,619],{"class":150},"hidden",[136,621,622],{"class":146},";     ",[136,624,625],{"class":202},"\u002F* clip the overflow *\u002F\n",[136,627,628,630,632,635,638],{"class":138,"line":215},[136,629,614],{"class":150},[136,631,153],{"class":146},[136,633,634],{"class":150},"auto",[136,636,637],{"class":146},";       ",[136,639,640],{"class":202},"\u002F* scroll if needed *\u002F\n",[136,642,643,645,647,650,652],{"class":138,"line":224},[136,644,614],{"class":150},[136,646,153],{"class":146},[136,648,649],{"class":150},"scroll",[136,651,622],{"class":146},[136,653,654],{"class":202},"\u002F* always show scrollbars *\u002F\n",[136,656,657,659,661,664,667],{"class":138,"line":233},[136,658,614],{"class":150},[136,660,153],{"class":146},[136,662,663],{"class":150},"visible",[136,665,666],{"class":146},";    ",[136,668,669],{"class":202},"\u002F* let it overflow (default) *\u002F\n",[136,671,672,675,677,679,682],{"class":138,"line":240},[136,673,674],{"class":150},"    overflow-x",[136,676,153],{"class":146},[136,678,619],{"class":150},[136,680,681],{"class":146},";   ",[136,683,684],{"class":202},"\u002F* horizontal *\u002F\n",[136,686,687,690,692,694,696],{"class":138,"line":252},[136,688,689],{"class":150},"    overflow-y",[136,691,153],{"class":146},[136,693,634],{"class":150},[136,695,622],{"class":146},[136,697,698],{"class":202},"\u002F* vertical (can differ) *\u002F\n",[136,700,701],{"class":138,"line":261},[136,702,528],{"class":146},[14,704,705,708],{},[34,706,707],{},"overflow: hidden"," also clips shadows, transforms, and child elements outside the box — and it establishes a new formatting context (clears floats, contains margins).",[18,710,712],{"id":711},"tips-tricks","💡 Tips & Tricks",[37,714,715,738,752,757,774],{},[40,716,717,720,721,724,725,727,728,730,731,733,734,737],{},[43,718,719],{},"Idiom",": always ",[34,722,723],{},"* { box-sizing: border-box; }"," at the top of your stylesheet — ",[34,726,125],{}," makes ",[34,729,49],{}," include padding and border (the element is exactly ",[34,732,49],{}," wide), which is intuitive. The default ",[34,735,736],{},"content-box"," adds padding\u002Fborder on top, making elements larger than declared — a source of layout bugs.",[40,739,740,742,743,534,745,747,748,751],{},[43,741,719],{},": use ",[34,744,533],{},[34,746,537],{}," for responsive containers — ",[34,749,750],{},"width: 100%; max-width: 1200px; margin: 0 auto;"," fills the viewport on small screens but caps at 1200px on large screens, centered. This is the universal \"centered, max-width container\" pattern.",[40,753,754,756],{},[43,755,719],{},": remember margin collapsing — vertical margins between adjacent block elements collapse (the larger wins, they don't add). This causes \"the gap is smaller than I expected.\" Flex\u002Fgrid containers don't collapse margins; add padding\u002Fborder to prevent parent-child collapse.",[40,758,759,761,762,164,764,164,766,769,770,773],{},[43,760,719],{},": use logical properties (",[34,763,305],{},[34,765,293],{},[34,767,768],{},"padding-inline",") for writing-mode-aware layouts — they adapt to vertical writing modes (CJK) automatically. ",[34,771,772],{},"margin-inline: auto"," centers in the inline direction regardless of writing mode.",[40,775,776,742,778,780,781,783,784,787],{},[43,777,719],{},[34,779,707],{}," to clip overflowing content and to establish a \"block formatting context\" — this clears floats (a parent with ",[34,782,707],{}," contains floated children) and contains child margins (prevents parent-child margin collapse). Modern alternatives: ",[34,785,786],{},"display: flow-root"," (clears floats without clipping).",[18,789,791],{"id":790},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[37,793,794,813,819,842,860,869,888,901,926,948],{},[40,795,796,153,803,806,807,809,810,812],{},[43,797,798,800,801],{},[34,799,736],{}," (default) adds padding\u002Fborder on top of ",[34,802,49],{},[34,804,805],{},"width: 100px; padding: 10px;"," = 120px actual. Use ",[34,808,125],{}," to make ",[34,811,49],{}," the total.",[40,814,815,818],{},[43,816,817],{},"Margin collapsing",": vertical margins between siblings\u002Fparent-child collapse (larger wins, don't add). Doesn't happen horizontally, in flex\u002Fgrid, or with padding\u002Fborder between them.",[40,820,821,153,826,829,830,833,834,837,838,841],{},[43,822,823,825],{},[34,824,53],{}," with percentages needs a parent with a defined height",[34,827,828],{},"height: 100%"," on a child of a ",[34,831,832],{},"height: auto"," parent is 0 (or auto). Set the parent's height (or use ",[34,835,836],{},"min-height",", flex, or ",[34,839,840],{},"100vh",").",[40,843,844,849,850,852,853,856,857,859],{},[43,845,846,848],{},[34,847,537],{}," + padding\u002Fborder overflows the parent"," (with ",[34,851,736],{},"): ",[34,854,855],{},"width: 100%; padding: 10px;"," = 100% + 20px > parent. ",[34,858,125],{}," fixes this (the standard reason to use it).",[40,861,862,153,865,868],{},[43,863,864],{},"Negative margins overlap",[34,866,867],{},"margin-top: -20px"," pulls the element up, potentially overlapping the previous. Useful for specific effects but can cause confusion.",[40,870,871,876,877,880,881,883,884,887],{},[43,872,873,875],{},[34,874,707],{}," clips shadows and transforms",": a child with ",[34,878,879],{},"box-shadow"," extending outside a ",[34,882,707],{}," parent is clipped. Use ",[34,885,886],{},"overflow: clip"," (doesn't establish a scroll container) or restructure.",[40,889,890,896,897,900],{},[43,891,892,895],{},[34,893,894],{},"overflow: auto"," shows scrollbars only when needed",": but the scrollbar takes space, causing layout shift. Use ",[34,898,899],{},"scrollbar-gutter: stable"," to reserve space.",[40,902,903,153,911,914,915,918,919,922,923,925],{},[43,904,905,50,908,910],{},[34,906,907],{},"min-width",[34,909,533],{}," interact",[34,912,913],{},"min-width: 200px; max-width: 500px; width: 100%"," — the element is between 200 and 500px, depending on the container. ",[34,916,917],{},"min"," beats ",[34,920,921],{},"max"," if the container is smaller than ",[34,924,917],{}," (overflow).",[40,927,928,153,933,936,937,939,940,943,944,947],{},[43,929,930,931],{},"Padding percentages are relative to the ",[102,932,49],{},[34,934,935],{},"padding-top: 50%"," is 50% of the parent's ",[102,938,49],{},", not height. This is the classic \"intrinsic aspect ratio\" hack (",[34,941,942],{},"padding-top: 56.25%"," for 16:9) before ",[34,945,946],{},"aspect-ratio",".",[40,949,950,153,953,955,956,958,959,961],{},[43,951,952],{},"Margins don't affect the element's size, but affect layout",[34,954,82],{}," is outside the border; ",[34,957,63],{}," is inside. ",[34,960,49],{}," (border-box) includes padding but not margin.",[18,963,965],{"id":964},"spot-the-bug","🧠 Spot the Bug",[14,967,968],{},"A developer sets up a 100%-width input with padding, and it overflows the container:",[23,970,971],{"language":128},[27,972,974],{"className":131,"code":973,"language":128,"meta":32,"style":32},"input {\n    width: 100%;\n    padding: 10px;\n    border: 1px solid gray;\n}\n",[34,975,976,983,995,1009,1029],{"__ignoreMap":32},[136,977,978,981],{"class":138,"line":139},[136,979,980],{"class":142},"input",[136,982,451],{"class":146},[136,984,985,987,989,991,993],{"class":138,"line":206},[136,986,456],{"class":150},[136,988,153],{"class":146},[136,990,559],{"class":150},[136,992,562],{"class":413},[136,994,484],{"class":146},[136,996,997,1000,1002,1005,1007],{"class":138,"line":215},[136,998,999],{"class":150},"    padding",[136,1001,153],{"class":146},[136,1003,1004],{"class":150},"10",[136,1006,414],{"class":413},[136,1008,484],{"class":146},[136,1010,1011,1014,1016,1019,1021,1024,1027],{"class":138,"line":224},[136,1012,1013],{"class":150},"    border",[136,1015,153],{"class":146},[136,1017,1018],{"class":150},"1",[136,1020,414],{"class":413},[136,1022,1023],{"class":150}," solid",[136,1025,1026],{"class":150}," gray",[136,1028,484],{"class":146},[136,1030,1031],{"class":138,"line":233},[136,1032,528],{"class":146},[14,1034,1035],{},"The input is wider than its container. Why?",[1037,1038,1039,1043,1070,1076,1149,1159],"details",{},[1040,1041,1042],"summary",{},"Answer",[14,1044,1045,1046,164,1048,1050,1051,1054,1055,1058,1059,1062,1063,1065,1066,1069],{},"With the default ",[34,1047,94],{},[34,1049,537],{}," sets the ",[102,1052,1053],{},"content"," width to 100% of the parent. Then ",[34,1056,1057],{},"padding: 10px"," (20px total left+right) and ",[34,1060,1061],{},"border: 1px"," (2px total) are ",[102,1064,104],{}," on top, making the input ",[34,1067,1068],{},"100% + 22px"," wide — overflowing the container.",[14,1071,1072,1073,108],{},"The fix — ",[34,1074,1075],{},"box-sizing: border-box",[27,1077,1079],{"className":131,"code":1078,"language":128,"meta":32,"style":32},"* { box-sizing: border-box; }\n\ninput {\n    width: 100%;\n    padding: 10px;\n    border: 1px solid gray;\n}\n",[34,1080,1081,1095,1099,1105,1117,1129,1145],{"__ignoreMap":32},[136,1082,1083,1085,1087,1089,1091,1093],{"class":138,"line":139},[136,1084,143],{"class":142},[136,1086,147],{"class":146},[136,1088,86],{"class":150},[136,1090,153],{"class":146},[136,1092,125],{"class":150},[136,1094,158],{"class":146},[136,1096,1097],{"class":138,"line":206},[136,1098,237],{"emptyLinePlaceholder":236},[136,1100,1101,1103],{"class":138,"line":215},[136,1102,980],{"class":142},[136,1104,451],{"class":146},[136,1106,1107,1109,1111,1113,1115],{"class":138,"line":224},[136,1108,456],{"class":150},[136,1110,153],{"class":146},[136,1112,559],{"class":150},[136,1114,562],{"class":413},[136,1116,484],{"class":146},[136,1118,1119,1121,1123,1125,1127],{"class":138,"line":233},[136,1120,999],{"class":150},[136,1122,153],{"class":146},[136,1124,1004],{"class":150},[136,1126,414],{"class":413},[136,1128,484],{"class":146},[136,1130,1131,1133,1135,1137,1139,1141,1143],{"class":138,"line":240},[136,1132,1013],{"class":150},[136,1134,153],{"class":146},[136,1136,1018],{"class":150},[136,1138,414],{"class":413},[136,1140,1023],{"class":150},[136,1142,1026],{"class":150},[136,1144,484],{"class":146},[136,1146,1147],{"class":138,"line":252},[136,1148,528],{"class":146},[14,1150,161,1151,164,1153,1155,1156,1158],{},[34,1152,125],{},[34,1154,537],{}," includes padding and border — the input is exactly 100% wide, fitting the container. This is why ",[34,1157,723],{}," is a universal reset.",[14,1160,1161,153,1164,800,1166,1168,1169,1171,1172,1174,1175,1177,1178,947],{},[43,1162,1163],{},"The lesson",[34,1165,736],{},[34,1167,49],{},", causing ",[34,1170,537],{}," + padding to overflow. ",[34,1173,125],{}," includes padding\u002Fborder in ",[34,1176,49],{},", preventing overflow. Always use ",[34,1179,125],{},[18,1181,1182],{"id":1040},"Summary",[14,1184,1185,1186,1188,1189,164,1192,1194],{},"You understand the box model (content\u002Fpadding\u002Fborder\u002Fmargin), ",[34,1187,1075],{}," (always use it), margin collapsing (vertical, not horizontal\u002Fflex\u002Fgrid), ",[34,1190,1191],{},"min\u002Fmax-width",[34,1193,591],{},", and logical properties. Next: colors and units.",[1196,1197,1198],"style",{},"html pre.shiki code .sk71V, html code.shiki .sk71V{--shiki-default:#22863A;--shiki-github-dark:#85E89D}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--