[{"data":1,"prerenderedAt":1504},["ShallowReactive",2],{"page-\u002Fcss\u002F01-introduction-and-setup":3},{"id":4,"title":5,"body":6,"description":160,"extension":1498,"meta":1499,"navigation":413,"path":1500,"seo":1501,"stem":1502,"__hash__":1503},"content\u002Fcss\u002F01-introduction-and-setup.md","01 — Introduction & Setup",{"type":7,"value":8,"toc":1475},"minimark",[9,13,18,22,62,66,136,139,143,146,151,205,267,270,277,320,327,334,362,365,369,514,544,548,559,563,654,658,689,693,873,1031,1035,1038,1074,1077,1081,1154,1158,1294,1298,1301,1339,1342,1436,1440,1466,1469,1472],[10,11,5],"h1",{"id":12},"_01-introduction-setup",[14,15,17],"h2",{"id":16},"what-is-css","What Is CSS?",[19,20,21],"p",{},"CSS (Cascading Style Sheets) is the language for styling web pages — it controls how HTML elements look (colors, layout, fonts, animations). Key characteristics:",[23,24,25,33,39,45,51],"ul",{},[26,27,28,32],"li",{},[29,30,31],"strong",{},"Declarative"," — you describe how elements should look, the browser figures out how to render it.",[26,34,35,38],{},[29,36,37],{},"Cascading"," — multiple rules can apply to the same element; the cascade resolves conflicts (specificity, source order, importance).",[26,40,41,44],{},[29,42,43],{},"Progressive"," — CSS degrades gracefully; unsupported properties are ignored, not errors.",[26,46,47,50],{},[29,48,49],{},"Style-free markup"," — HTML describes structure, CSS describes presentation (separation of concerns).",[26,52,53,56,57,61],{},[29,54,55],{},"Huge and evolving"," — CSS has hundreds of properties and is actively extended (container queries, ",[58,59,60],"code",{},":has()",", subgrid, cascade layers).",[14,63,65],{"id":64},"a-brief-history","A Brief History",[67,68,69,82],"table",{},[70,71,72],"thead",{},[73,74,75,79],"tr",{},[76,77,78],"th",{},"Year",[76,80,81],{},"Milestone",[83,84,85,94,102,110,118],"tbody",{},[73,86,87,91],{},[88,89,90],"td",{},"1996",[88,92,93],{},"CSS1 — basic styling (fonts, colors, margins).",[73,95,96,99],{},[88,97,98],{},"1998",[88,100,101],{},"CSS2 — positioning, media types, z-index.",[73,103,104,107],{},[88,105,106],{},"2001–2011",[88,108,109],{},"CSS3 — modular spec (selectors, backgrounds, transforms, transitions, animations, media queries, flexbox).",[73,111,112,115],{},[88,113,114],{},"2017",[88,116,117],{},"CSS Grid ships in all major browsers.",[73,119,120,123],{},[88,121,122],{},"2017–2024",[88,124,125,126,129,130,129,133,135],{},"CSS4-ish era — custom properties, ",[58,127,128],{},"gap",", ",[58,131,132],{},"aspect-ratio",[58,134,60],{},", container queries, cascade layers, nesting, view transitions.",[19,137,138],{},"CSS is no longer versioned (CSS3+); it's a collection of independent modules, each at its own maturity level. \"CSS4\" isn't a real spec — it's shorthand for \"modern CSS.\"",[14,140,142],{"id":141},"adding-css-to-html","Adding CSS to HTML",[19,144,145],{},"Three ways, in order of preference:",[147,148,150],"h3",{"id":149},"external-stylesheet-recommended","External stylesheet (recommended)",[152,153,155],"code-wrapper",{"language":154},"html",[156,157,161],"pre",{"className":158,"code":159,"language":154,"meta":160,"style":160},"language-html shiki shiki-themes github-light github-dark","\u003C!-- index.html -->\n\u003Clink rel=\"stylesheet\" href=\"styles.css\">\n","",[58,162,163,172],{"__ignoreMap":160},[164,165,168],"span",{"class":166,"line":167},"line",1,[164,169,171],{"class":170},"sdCPZ","\u003C!-- index.html -->\n",[164,173,175,179,183,187,190,194,197,199,202],{"class":166,"line":174},2,[164,176,178],{"class":177},"ssxIu","\u003C",[164,180,182],{"class":181},"sk71V","link",[164,184,186],{"class":185},"sIsaT"," rel",[164,188,189],{"class":177},"=",[164,191,193],{"class":192},"sJ6F3","\"stylesheet\"",[164,195,196],{"class":185}," href",[164,198,189],{"class":177},[164,200,201],{"class":192},"\"styles.css\"",[164,203,204],{"class":177},">\n",[152,206,208],{"language":207},"css",[156,209,212],{"className":210,"code":211,"language":2