164,983,984,986,988,991],{"class":166,"line":478},[164,985,960],{"class":232},[164,987,236],{"class":177},[164,989,990],{"class":232},"#0066cc",[164,992,247],{"class":177},[164,994,995,998,1000,1002,1004,1007,1010],{"class":166,"line":494},[164,996,997],{"class":232},"    border-bottom",[164,999,236],{"class":177},[164,1001,931],{"class":232},[164,1003,466],{"class":451},[164,1005,1006],{"class":232}," solid",[164,1008,1009],{"class":232}," #0066cc",[164,1011,247],{"class":177},[164,1013,1014,1017,1019,1022,1024],{"class":166,"line":866},[164,1015,1016],{"class":232},"    padding-bottom",[164,1018,236],{"class":177},[164,1020,1021],{"class":232},"0.5",[164,1023,934],{"class":451},[164,1025,247],{"class":177},[164,1027,1029],{"class":166,"line":1028},14,[164,1030,266],{"class":177},[14,1032,1034],{"id":1033},"the-cascade-preview","The Cascade (preview)",[19,1036,1037],{},"When multiple rules apply to the same element, the browser resolves conflicts by:",[1039,1040,1041,1051,1068],"ol",{},[26,1042,1043,1046,1047,1050],{},[29,1044,1045],{},"Importance"," — ",[58,1048,1049],{},"!important"," wins (avoid).",[26,1052,1053,1056,1057,1060,1061,1060,1064,1067],{},[29,1054,1055],{},"Specificity"," — more specific selectors win (e.g., ",[58,1058,1059],{},"#id"," > ",[58,1062,1063],{},".class",[58,1065,1066],{},"element",").",[26,1069,1070,1073],{},[29,1071,1072],{},"Source order"," — later rules win (at equal specificity).",[19,1075,1076],{},"Chapter 02 covers this in depth. For now, know that CSS \"cascades\" — the name is literal.",[14,1078,1080],{"id":1079},"tips-tricks","💡 Tips & Tricks",[23,1082,1083,1103,1108,1130,1143],{},[26,1084,1085,1088,1089,1092,1093,1095,1096,1098,1099,1102],{},[29,1086,1087],{},"Idiom",": use external stylesheets (",[58,1090,1091],{},"\u003Clink rel=\"stylesheet\" href=\"styles.css\">",") for production — they're cached across pages, keep HTML clean, and separate structure from presentation. Reserve inline ",[58,1094,275],{}," for critical CSS inlined in ",[58,1097,325],{}," (performance), and inline ",[58,1100,1101],{},"style=\"...\""," for genuinely one-off dynamic styles (set via JS).",[26,1104,1105,1107],{},[29,1106,1087],{},": use DevTools as your CSS REPL — edit properties live in the Styles pane, see the result instantly, then copy the final values to your file. Iterating in the browser is far faster than save-and-reload cycles.",[26,1109,1110,1112,1113,675,1115,679,1117,1119,1120,1123,1124,1123,1126,1129],{},[29,1111,1087],{},": use the Computed tab to debug unit calculations — if ",[58,1114,674],{},[58,1116,678],{},[58,1118,678],{},", revealing the actual computed value. Essential for debugging ",[58,1121,1122],{},"em","\u002F",[58,1125,934],{},[58,1127,1128],{},"%"," chains.",[26,1131,1132,1134,1135,1138,1139,1142],{},[29,1133,1087],{},": use ",[58,1136,1137],{},"system-ui, -apple-system, sans-serif"," as a font stack — it uses the OS's native UI font (San Francisco on macOS, Segoe on Windows, Roboto on Android), giving a native feel without web font downloads. Add a web font (via ",[58,1140,1141],{},"@font-face",") only when you need a specific brand font.",[26,1144,1145,1147,1148,1150,1151,1153],{},[29,1146,1087],{},": avoid ",[58,1149,1049],{}," — it overrides the cascade in a way that's hard to debug and override further. Instead, increase specificity (a more specific selector) or reorder your rules. Reserve ",[58,1152,1049],{}," for overriding third-party styles you can't otherwise control.",[14,1155,1157],{"id":1156},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[23,1159,1160,1175,1188,1205,1220,1247,1260,1282],{},[26,1161,1162,1046,1168,1171,1172,1174],{},[29,1163,1164,1165,1167],{},"Inline styles have the highest specificity (besides ",[58,1166,1049],{},")",[58,1169,1170],{},"style=\"color: red\""," overrides any stylesheet rule (without ",[58,1173,1049],{},"). This makes inline styles hard to override and is why they're discouraged except for dynamic JS-set styles.",[26,1176,1177,1046,1180,1183,1184,1187],{},[29,1178,1179],{},"Whitespace in CSS is mostly insignificant",[58,1181,1182],{},"a{color:red}"," and ",[58,1185,1186],{},"a { color: red; }"," are equivalent. But format for readability (use a formatter: Prettier).",[26,1189,1190,236,1193,1196,1197,1200,1201,1204],{},[29,1191,1192],{},"Missing semicolons",[58,1194,1195],{},"a { color: red font-size: 14px }"," — the ",[58,1198,1199],{},"font-size: 14px"," is treated as part of the ",[58,1202,1203],{},"color"," value (invalid), and both are dropped. Always use semicolons (the last one is optional but recommended).",[26,1206,1207,236,1210,129,1213,129,1216,1219],{},[29,1208,1209],{},"Vendor prefixes",[58,1211,1212],{},"-webkit-",[58,1214,1215],{},"-moz-",[58,1217,1218],{},"-ms-"," prefixes were needed for experimental features. Modern CSS needs few prefixes (use Autoprefixer if supporting old browsers). Don't hand-prefix — use a build tool.",[26,1221,1222,1225,1226,1183,1229,1232,1233,1183,1236,1238,1239,1242,1243,1246],{},[29,1223,1224],{},"CSS is case-insensitive for selectors and properties"," (in HTML): ",[58,1227,1228],{},"DIV",[58,1230,1231],{},"div"," match the same elements, ",[58,1234,1235],{},"Color",[58,1237,1203],{}," are the same property. But class names are case-sensitive in HTML (",[58,1240,1241],{},".Foo"," ≠ ",[58,1244,1245],{},".foo","). Be consistent (lowercase).",[26,1248,1249,236,1252,1255,1256,1259],{},[29,1250,1251],{},"Comments can't nest",[58,1253,1254],{},"\u002F* \u002F* *\u002F *\u002F"," — the first ",[58,1257,1258],{},"*\u002F"," closes the comment; the rest is invalid. There's no nested comment syntax.",[26,1261,1262,236,1267,1270,1271,1274,1275,1277,1278,1281],{},[29,1263,1264,1266],{},[58,1265,542],{}," must come first",[58,1268,1269],{},"@import url('x.css');"," must precede all other rules (except ",[58,1272,1273],{},"@charset","). Putting it later silently fails (it's ignored). Avoid ",[58,1276,542],{}," in production (it's render-blocking and serial) — use ",[58,1279,1280],{},"\u003Clink>"," tags or bundle.",[26,1283,1284,236,1287,1290,1291,1293],{},[29,1285,1286],{},"Unsupported properties are ignored",[58,1288,1289],{},"aspect-ratio: 16\u002F9;"," in an old browser is ignored (not an error) — the element falls back to its default. Use ",[58,1292,497],{}," for feature detection.",[14,1295,1297],{"id":1296},"spot-the-bug","🧠 Spot the Bug",[19,1299,1300],{},"A developer's CSS isn't applying, and they can't figure out why:",[152,1302,1303],{"language":207},[156,1304,1306],{"className":210,"code":1305,"language":207,"meta":160,"style":160},"p {\n    color: blue\n    font-size: 18px;\n}\n",[58,1307,1308,1314,1323,1335],{"__ignoreMap":160},[164,1309,1310,1312],{"class":166,"line":167},[164,1311,19],{"class":181},[164,1313,226],{"class":177},[164,1315,1316,1318,1320],{"class":166,"line":174},[164,1317,960],{"class":232},[164,1319,236],{"class":177},[164,1321,1322],{"class":232},"blue\n",[164,1324,1325,1328,1331,1333],{"class":166,"line":229},[164,1326,1327],{"class":177},"    font-size: ",[164,1329,1330],{"class":232},"18",[164,1332,466],{"class":451},[164,1334,247],{"class":177},[164,1336,1337],{"class":166,"line":250},[164,1338,266],{"class":177},[19,1340,1341],{},"What's wrong?",[1343,1344,1345,1349,1377,1380,1419,1430],"details",{},[1346,1347,1348],"summary",{},"Answer",[19,1350,1351,1352,1355,1356,1359,1360,1363,1364,1366,1367,1369,1370,1373,1374,1376],{},"The ",[58,1353,1354],{},"color: blue"," declaration is missing a semicolon. CSS parses ",[58,1357,1358],{},"color: blue font-size: 18px;"," as a single declaration with the value ",[58,1361,1362],{},"blue font-size: 18px"," — which is invalid for ",[58,1365,1203],{},". The whole declaration is dropped, so ",[58,1368,1203],{}," isn't set (and ",[58,1371,1372],{},"font-size"," is lost too, since it was absorbed into the invalid ",[58,1375,1203],{}," value).",[19,1378,1379],{},"The fix — add the semicolon:",[156,1381,1383],{"className":210,"code":1382,"language":207,"meta":160,"style":160},"p {\n    color: blue;\n    font-size: 18px;\n}\n",[58,1384,1385,1391,1402,1415],{"__ignoreMap":160},[164,1386,1387,1389],{"class":166,"line":167},[164,1388,19],{"class":181},[164,1390,226],{"class":177},[164,1392,1393,1395,1397,1400],{"class":166,"line":174},[164,1394,960],{"class":232},[164,1396,236],{"class":177},[164,1398,1399],{"class":232},"blue",[164,1401,247],{"class":177},[164,1403,1404,1407,1409,1411,1413],{"class":166,"line":229},[164,1405,1406],{"class":232},"    font-size",[164,1408,236],{"class":177},[164,1410,1330],{"class":232},[164,1412,466],{"class":451},[164,1414,247],{"class":177},[164,1416,1417],{"class":166,"line":250},[164,1418,266],{"class":177},[19,1420,1421,1422,1425,1426,1429],{},"::\nThe last declaration's semicolon is technically optional (the ",[58,1423,1424],{},"}"," closes it), but every other declaration must end with ",[58,1427,1428],{},";",". Always use semicolons (a formatter like Prettier enforces this).",[19,1431,1432,1435],{},[29,1433,1434],{},"The lesson",": a missing semicolon causes the next declaration to be absorbed into the current value, often invalidating both. Use a formatter to catch this.",[14,1437,1439],{"id":1438},"recommended-environment","Recommended Environment",[23,1441,1442,1448,1454,1460],{},[26,1443,1444,1447],{},[29,1445,1446],{},"VS Code + Live Server"," for hot reload.",[26,1449,1450,1453],{},[29,1451,1452],{},"Chrome or Firefox DevTools"," for inspection and live editing.",[26,1455,1456,1459],{},[29,1457,1458],{},"Prettier"," for formatting (consistent, no arguments).",[26,1461,1462,1465],{},[29,1463,1464],{},"Autoprefixer"," (via PostCSS or a bundler) if supporting older browsers.",[14,1467,1468],{"id":1346},"Summary",[19,1470,1471],{},"You now have CSS set up, understand how to add it to HTML (external preferred), the basic syntax (rules, declarations, at-rules), and how to use DevTools as a live CSS REPL. Next: selectors and specificity — how the cascade resolves conflicts.",[290,1473,1474],{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sk71V, html code.shiki .sk71V{--shiki-default:#22863A;--shiki-github-dark:#85E89D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}",{"title":160,"searchDepth":174,"depth":174,"links":1476},[1477,1478,1479,1486,1487,1491,1492,1493,1494,1495,1496,1497],{"id":16,"depth":174,"text":17},{"id":64,"depth":174,"text":65},{"id":141,"depth":174,"text":142,"children":1480},[1481,1482,1484],{"id":149,"depth":229,"text":150},{"id":272,"depth":229,"text":1483},"\u003Cstyle> element (per-page)",{"id":329,"depth":229,"text":1485},"Inline style attribute (avoid)",{"id":367,"depth":174,"text":368},{"id":546,"depth":174,"text":547,"children":1488},[1489,1490],{"id":561,"depth":229,"text":562},{"id":656,"depth":229,"text":657},{"id":691,"depth":174,"text":692},{"id":1033,"depth":174,"text":1034},{"id":1079,"depth":174,"text":1080},{"id":1156,"depth":174,"text":1157},{"id":1296,"depth":174,"text":1297},{"id":1438,"depth":174,"text":1439},{"id":1346,"depth":174,"text":1468},"md",{},"\u002Fcss\u002F01-introduction-and-setup",{"title":5,"description":160},"css\u002F01-introduction-and-setup","S0KDnS2KiYfttmxhm8LLa4af8jPJne9rCNxSJdoJDgI",1787401237794]