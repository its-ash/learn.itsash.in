s":177},[19,321,322,323,326],{},"Use for page-specific styles or critical CSS inlined in ",[58,324,325],{},"\u003Chead>"," for performance (avoiding a render-blocking request).",[147,328,330,331,333],{"id":329},"inline-style-attribute-avoid","Inline ",[58,332,290],{}," attribute (avoid)",[152,335,336],{"language":154},[156,337,339],{"className":158,"code":338,"language":154,"meta":160,"style":160},"\u003Cp style=\"color: red; font-weight: bold;\">Warning\u003C\u002Fp>\n",[58,340,341],{"__ignoreMap":160},[164,342,343,345,347,350,352,355,358,360],{"class":166,"line":167},[164,344,178],{"class":177},[164,346,19],{"class":181},[164,348,349],{"class":185}," style",[164,351,189],{"class":177},[164,353,354],{"class":192},"\"color: red; font-weight: bold;\"",[164,356,357],{"class":177},">Warning\u003C\u002F",[164,359,19],{"class":181},[164,361,204],{"class":177},[19,363,364],{},"Inline styles have the highest specificity (hard to override), can't be cached, and mix structure with presentation. Avoid except for genuinely one-off, dynamic styles (set via JavaScript).",[14,366,368],{"id":367},"syntax","Syntax",[152,370,371],{"language":207},[156,372,374],{"className":210,"code":373,"language":207,"meta":160,"style":160},"\u002F* A rule *\u002F\nselector {\n    property: value;      \u002F* a declaration *\u002F\n    property: value;\n}\n\n\u002F* Comments are \u002F* like this *\u002F and can span lines *\u002F\n\n\u002F* At-rules *\u002F\n@media (min-width: 768px) { \u002F* ... *\u002F }\n@keyframes fade { \u002F* ... *\u002F }\n@supports (display: grid) { \u002F* ... *\u002F }\n",[58,375,376,381,386,397,404,408,415,435,440,446,476,492],{"__ignoreMap":160},[164,377,378],{"class":166,"line":167},[164,379,380],{"class":170},"\u002F* A rule *\u002F\n",[164,382,383],{"class":166,"line":174},[164,384,385],{"class":177},"selector {\n",[164,387,388,391,394],{"class":166,"line":229},[164,389,390],{"class":232},"    property",[164,392,393],{"class":177},": value;      ",[164,395,396],