[{"data":1,"prerenderedAt":1247},["ShallowReactive",2],{"page-\u002Fcss\u002F02-selectors-and-specificity":3},{"id":4,"title":5,"body":6,"description":16,"extension":1241,"meta":1242,"navigation":72,"path":1243,"seo":1244,"stem":1245,"__hash__":1246},"content\u002Fcss\u002F02-selectors-and-specificity.md","02 — Selectors & Specificity",{"type":7,"value":8,"toc":1227},"minimark",[9,13,17,22,337,341,471,475,482,512,522,533,537,557,561,568,602,605,636,697,726,730,736,814,817,821,896,900,1034,1038,1041,1088,1091,1206,1209,1224],[10,11,5],"h1",{"id":12},"_02-selectors-specificity",[14,15,16],"p",{},"Selectors target HTML elements for styling. Specificity and the cascade determine which rule wins when multiple apply.",[18,19,21],"h2",{"id":20},"selector-types","Selector Types",[23,24,26],"code-wrapper",{"language":25},"css",[27,28,32],"pre",{"className":29,"code":30,"language":25,"meta":31,"style":31},"language-css shiki shiki-themes github-light github-dark","\u002F* Type (element) *\u002F\np { color: black; }\n\n\u002F* Class *\u002F\n.highlight { background: yellow; }\n\n\u002F* ID *\u002F\n#header { background: white; }\n\n\u002F* Universal *\u002F\n* { box-sizing: border-box; }\n\n\u002F* Attribute *\u002F\n[type=\"text\"] { border: 1px solid gray; }\na[href^=\"https\"] { color: green; }   \u002F* starts with https *\u002F\na[href$=\".pdf\"] { color: red; }       \u002F* ends with .pdf *\u002F\na[href*=\"example\"] { font-weight: bold; }  \u002F* contains *\u002F\n\n\u002F* Grouping *\u002F\nh1, h2, h3 { font-family: sans-serif; }\n","",[33,34,35,44,67,74,80,99,104,110,127,132,138,156,161,167,206,238,268,299,304,310],"code",{"__ignoreMap":31},[36,37,40],"span",{"class":38,"line":39},"line",1,[36,41,43],{"class":42},"sdCPZ","\u002F* Type (element) *\u002F\n",[36,45,47,50,54,58,61,64],{"class":38,"line":46},2,[36,48,14],{"class":49},"sk71V",[36,51,53],{"class":52},"ssxIu"," { ",[36,55,57],{"class":56},"snvgF","color",[36,59,60],{"class":52},": ",[36,62,63],{"class":56}