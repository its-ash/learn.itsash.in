 { margin: 1em 0; }\n\n\u002F* Child (direct only) *\u002F\nul > li { list-style: none; }\n\n\u002F* Adjacent sibling (immediately after) *\u002F\nh1 + p { font-size: 1.2em; }\n\n\u002F* General sibling (any following sibling) *\u002F\nh1 ~ p { color: gray; }\n",[33,347,348,353,378,382,387,410,414,419,442,446,451],{"__ignoreMap":31},[36,349,350],{"class":38,"line":39},[36,351,352],{"class":42},"\u002F* Descendant (any depth) *\u002F\n",[36,354,355,358,361,363,366,368,370,373,376],{"class":38,"line":46},[36,356,357],{"class":49},"article",[36,359,360],{"class":49}," p",[36,362,53],{"class":52},[36,364,365],{"class":56},"margin",[36,367,60],{"class":52},[36,369,194],{"class":56},[36,371,372],{"class":178},"em",[36,374,375],{"class":56}," 0",[36,377,66],{"class":52},[36,379,380],{"class":38,"line":69},[36,381,73],{"emptyLinePlaceholder":72},[36,383,384],{"class":38,"line":76},[36,385,386],{"class":42},"\u002F* Child (direct only) *\u002F\n",[36,388,389,392,395,398,400,403,405,408],{"class":38,"line":82},[36,390,391],{"class":49},"ul",[36,393,394],{"class":178}," >",[36,396,397],{"class":49}," li",[36,399,53],{"class":52},[36,401,402],{"class":56},"list-style",[36,404,60],{"class":52},[36,406,407],{"class":56},"none",[36,409,66],{"class":52},[36,411,412],{"class":38,"line":101},[36,413,73],{"emptyLinePlaceholder":72},[36,415,416],{"class":38,"line":106},[36,417,418],{"class":42},"\u002F* Adjacent sibling (immediately after) *\u002F\n",[36,420,421,423,426,428,430,433,435,438,440],{"class":38,"line":112},[36,422,10],{"class":49},[36,424,425],{"class":178}," +",[36,427,360],{"class":49},[36,429,53],{"class":52},[36,431,432],{"class":56},"font-size",[36,434,60],{"class":52},[36,436,437],{"class":56},"1.2",[36,439,372],{"class":178},[36,441,66],{"class":52},[36,443,444],{"class":38,"line":129},[36,445,73],{"emptyLinePlaceholder":72},[36,447,448],{"class":38,"line":134},[36,449,450],{"class":42},"\u002F* General sibling (any following sibling) *\u002F\n",[36,452,453,455,458,460,462,464,466,469],{"class":38,"line":140},[36,454,10],{"class":49},[36,456,457],{"class":178}," ~",[36,459,360],{"class":49},[36,461,53],{"class":52},[36,463,57],{"class":56},[36,465,60],{"class":52},[36,467,468],{"class":56},"gray",[36,470,66],{"class":52},[18,472,474],{"id":473},"specificity","Specificity",[14,476,477,478,481],{},"Specificity is a 4-part value ",[33,479,480],{},"(a, b, c, d)",":",[391,483,484,494,500,506],{},[485,486,487,489,490,493],"li",{},[33,488,211],{}," — ",[33,491,492],{},"style"," attribute (inline) — 1 if present, else 0.",[485,495,496,499],{},[33,497,498],{},"b"," — number of ID selectors.",[485,501,502,505],{},[33,503,504],{},"c"," — number of class selectors, attribute selectors, and pseudo-classes.",[485,507,508,511],{},[33,509,510],{},"d"," — number of type selectors and pseudo-elements.",[23,513,515],{"language":514},"text",[27,516,520],{"className":517,"code":519,"language":514,"meta":31},[518],"language-text","*                 → (0,0,0,0)\np                 → (0,0,0,1)\n.highlight        → (0,0,1,0)\np.highlight       → (0,0,1,1)\n#header           → (0,1,0,0)\n#header .title    → (0,1,1,0)\ndiv#header .title → (0,1,1,1)\nstyle=\"...\"       → (1,0,0,0)\n!important        → overrides specificity (but two !important compete by specificity)\n",[33,521,519],{"__ignoreMap":31},[14,523,524,525,528,529,532],{},"Compare left-to-right: ",[33,526,527],{},"(0,1,0,0)"," beats ",[33,530,531],{},"(0,0,99,99)"," — one ID beats any number of classes.",[324,534,536],{"id":535},"the-specificity-trap","The specificity trap",[14,538,539,540,543,544,547,548,551,552,556],{},"High-specificity selectors are hard to override. If you style with ",[33,541,542],{},"#header .title",", overriding it requires ",[33,545,546],{},"#header .title.highlight"," or ",[33,549,550],{},"!important"," — a spiral. ",[553,554,555],"strong",{},"Prefer class-based selectors"," for most styling; reserve IDs for rare, truly-unique elements.",[18,558,560],{"id":559},"the-cascade","The Cascade",[14,562,563,564,567],{},"When multiple rules apply to an element with equal specificity, ",[553,565,566],{},"source order"," wins — later rules override earlier. The full cascade order:",[569,570,571,579,584,590],"ol",{},[485,572,573,489,576,578],{},[553,574,575],{},"Origin & importance",[33,577,550],{}," > normal; author (your CSS) > user > user-agent (browser default).",[485,580,581,583],{},[553,582,474],{}," — higher specificity wins.",[485,585,586,589],{},[553,587,588],{},"Source order"," — later wins (at equal specificity).",[485,591,592,595,596,317,598,601],{},[553,593,594],{},"Inheritance"," — if no rule applies, the property inherits from the parent (for inheritable properties like ",[33,597,57],{},[33,599,600],{},"font",").",[18,603,594],{"id":604},"inheritance",[14,606,607,608,317,610,317,613,317,616,317,619,621,622,317,624,317,626,317,629,317,632,635],{},"Some properties inherit (",[33,609,57],{},[33,611,612],{},"font-*",[33,614,615],{},"line-height",[33,617,618],{},"text-align",[33,620,402],{},"); others don't (",[33,623,189],{},[33,625,365],{},[33,627,628],{},"padding",[33,630,631],{},"width",[33,633,634],{},"height","). Set on a parent, inheritable properties apply to all descendants unless overridden.",[23,637,638],{"language":25},[27,639,641],{"className":29,"code":640,"language":25,"meta":31,"style":31},"body { font-family: sans-serif; color: #333; }   \u002F* inherits to all text *\u002F\ndiv { border: 1px solid black; }                  \u002F* doesn't inherit *\u002F\n",[33,642,643,671],{"__ignoreMap":31},[36,644,645,648,650,652,654,656,659,661,663,666,668],{"class":38,"line":39},[36,646,647],{"class":49},"body",[36,649,53],{"class":52},[36,651,329],{"class":56},[36,653,60],{"class":52},[36,655,334],{"class":56},[36,657,658],{"class":52},"; ",[36,660,57],{"class":56},[36,662,60],{"class":52},[36,664,665],{"class":56},"#333",[36,667,234],{"class":52},[36,669,670],{"class":42},"\u002F* inherits to all text *\u002F\n",[36,672,673,676,678,680,682,684,686,688,691,694],{"class":38,"line":46},[36,674,675],{"class":49},"div",[36,677,53],{"class":52},[36,679,189],{"class":56},[36,681,60],{"class":52},[36,683,194],{"class":56},[36,685,197],{"class":178},[36,687,200],{"class":56},[36,689,690],{"class":56}," black",[36,692,693],{"class":52},"; }                  ",[36,695,696],{"class":42},"\u002F* doesn't inherit *\u002F\n",[391,698,699,708,714,720],{},[485,700,701,704,705,601],{},[33,702,703],{},"inherit"," — explicitly inherit (",[33,706,707],{},"border: inherit;",[485,709,710,713],{},[33,711,712],{},"initial"," — reset to the property's initial value.",[485,715,716,719],{},[33,717,718],{},"unset"," — inherit if inheritable, else initial.",[485,721,722,725],{},[33,723,724],{},"revert"," — reset to the browser default (not the spec initial).",[18,727,729],{"id":728},"cascade-layers-modern","Cascade Layers (modern)",[14,731,732,735],{},[33,733,734],{},"@layer"," controls specificity between groups of rules — useful for taming third-party CSS:",[23,737,738],{"language":25},[27,739,741],{"className":29,"code":740,"language":25,"meta":31,"style":31},"@layer reset, base, components, utilities;\n\n@layer reset {\n    * { margin: 0; padding: 0; }\n}\n@layer components {\n    .card { \u002F* ... *\u002F }\n}\n",[33,742,743,750,754,761,785,790,797,810],{"__ignoreMap":31},[36,744,745,747],{"class":38,"line":39},[36,746,734],{"class":178},[36,748,749],{"class":52}," reset, base, components, utilities;\n",[36,751,752],{"class":38,"line":46},[36,753,73],{"emptyLinePlaceholder":72},[36,755,756,758],{"class":38,"line":69},[36,757,734],{"class":178},[36,759,760],{"class":52}," reset {\n",[36,762,763,766,768,770,772,775,777,779,781,783],{"class":38,"line":76},[36,764,765],{"class":49},"    *",[36,767,53],{"class":52},[36,769,365],{"class":56},[36,771,60],{"class":52},[36,773,774],{"class":56},"0",[36,776,658],{"class":52},[36,778,628],{"class":56},[36,780,60],{"class":52},[36,782,774],{"class":56},[36,784,66],{"class":52},[36,786,787],{"class":38,"line":82},[36,788,789],{"class":52},"}\n",[36,791,792,794],{"class":38,"line":101},[36,793,734],{"class":178},[36,795,796],{"class":52}," components {\n",[36,798,799,802,804,807],{"class":38,"line":106},[36,800,801],{"class":85},"    .card",[36,803,53],{"class":52},[36,805,806],{"class":42},"\u002F* ... *\u002F",[36,808,809],{"class":52}," }\n",[36,811,812],{"class":38,"line":112},[36,813,789],{"class":52},[14,815,816],{},"Rules in later layers win over earlier layers (regardless of specificity within a layer). Unlayered rules have higher priority than layered rules. This is a modern way to manage specificity at scale (2023+ browser support).",[18,818,820],{"id":819},"tips-tricks","💡 Tips & Tricks",[391,822,823,839,858,875,890],{},[485,824,825,828,829,317,832,835,836,838],{},[553,826,827],{},"Idiom",": prefer class selectors (",[33,830,831],{},".card",[33,833,834],{},".title",") over ID selectors (",[33,837,115],{},") — classes are reusable, lower-specificity (easier to override), and not constrained to one element. Reserve IDs for genuinely unique elements (and JavaScript hooks).",[485,840,841,843,844,847,848,317,851,854,855,857],{},[553,842,827],{},": keep specificity low and flat — prefer single-class selectors (",[33,845,846],{},".btn",") over chained (",[33,849,850],{},".card .btn",[33,852,853],{},"#header .btn","). Low specificity is easy to override; high specificity starts an arms race toward ",[33,856,550],{},".",[485,859,860,862,863,866,867,870,871,874],{},[553,861,827],{},": use BEM (",[33,864,865],{},".block__element--modifier",") or similar naming to keep specificity flat — ",[33,868,869],{},".card__title--large"," is a single class (specificity 0,0,1,0), not ",[33,872,873],{},".card .title.large"," (0,0,2,1). Flat specificity avoids override battles.",[485,876,877,879,880,882,883,886,887,889],{},[553,878,827],{},": use ",[33,881,734],{}," to manage third-party CSS — ",[33,884,885],{},"@layer reset, base, third-party, components, utilities;"," puts third-party styles in a layer that your component layer overrides, regardless of their specificity. No more ",[33,888,550],{}," wars with frameworks.",[485,891,892,895],{},[553,893,894],{},"Debug",": when a style isn't applying, check the Styles pane in DevTools — it shows all matching rules (struck-through if overridden) and the computed value. The specificity of each rule is visible; the winner is at the top. This reveals whether the issue is specificity, a typo, or a missing rule.",[18,897,899],{"id":898},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[391,901,902,918,932,938,954,977,989,1008,1028],{},[485,903,904,60,907,910,911,914,915,917],{},[553,905,906],{},"IDs beat any number of classes",[33,908,909],{},"#x"," (0,1,0,0) beats ",[33,912,913],{},".a.b.c.d.e"," (0,0,5,0). Don't try to override an ID selector with classes — use an ID or ",[33,916,550],{}," (or restructure).",[485,919,920,925,926,928,929,931],{},[553,921,922,924],{},[33,923,550],{}," is a trap",": once you use it, overriding it requires higher specificity + ",[33,927,550],{},". It cascades into more ",[33,930,550],{},". Reserve for genuine overrides (third-party styles you can't edit).",[485,933,934,937],{},[553,935,936],{},"Specificity isn't decimal",": (0,0,10,0) doesn't \"roll over\" to (0,1,0,0) — 10 classes still lose to 1 ID. Compare each column independently.",[485,939,940,60,943,946,947,950,951,953],{},[553,941,942],{},"Inline styles beat stylesheet rules",[33,944,945],{},"style=\"color: red\""," (1,0,0,0) beats ",[33,948,949],{},"#id"," (0,1,0,0). Only ",[33,952,550],{}," in a stylesheet overrides inline.",[485,955,956,60,959,961,962,964,965,967,968,970,971,973,974,976],{},[553,957,958],{},"Inherited properties vs non-inherited",[33,960,57],{}," inherits; ",[33,963,189],{}," doesn't. Setting ",[33,966,189],{}," on ",[33,969,647],{}," doesn't give all elements a border. Use ",[33,972,703],{},"\u002F",[33,975,718],{}," explicitly if needed.",[485,978,979,60,985,988],{},[553,980,981,982,984],{},"Universal selector ",[33,983,143],{}," has zero specificity",[33,986,987],{},"* { box-sizing: border-box; }"," is (0,0,0,0) — it doesn't override anything but also isn't overridden by anything specific. Safe for resets.",[485,990,991,60,997,1000,1001,1004,1005,1007],{},[553,992,993,996],{},[33,994,995],{},":not()"," has the specificity of its argument",[33,998,999],{},":not(.x)"," has specificity (0,0,1,0) (the class inside), not (0,0,1,0) for the ",[33,1002,1003],{},":not"," itself plus the argument. Modern ",[33,1006,995],{}," (with a selector list) takes the highest.",[485,1009,1010,60,1020,1023,1024,1027],{},[553,1011,1012,1013,317,1016,1019],{},"Pseudo-elements (",[33,1014,1015],{},"::before",[33,1017,1018],{},"::after",") add specificity like a type",[33,1021,1022],{},"p::before"," is (0,0,0,2). Pseudo-classes (",[33,1025,1026],{},":hover",") add like a class: (0,0,1,0).",[485,1029,1030,1033],{},[553,1031,1032],{},"Cascade layers change the specificity comparison",": a rule in a later layer wins over an earlier layer regardless of specificity. Unlayered rules beat layered rules. This is a deliberate escape hatch from the specificity hierarchy.",[18,1035,1037],{"id":1036},"spot-the-bug","🧠 Spot the Bug",[14,1039,1040],{},"A developer styles a button, then a later rule doesn't override it:",[23,1042,1043],{"language":25},[27,1044,1046],{"className":29,"code":1045,"language":25,"meta":31,"style":31},"#sidebar .btn { background: blue; }       \u002F* (0,1,1,0) *\u002F\n.btn { background: green; }               \u002F* (0,0,1,0) — loses *\u002F\n",[33,1047,1048,1070],{"__ignoreMap":31},[36,1049,1050,1053,1056,1058,1060,1062,1065,1067],{"class":38,"line":39},[36,1051,1052],{"class":85},"#sidebar",[36,1054,1055],{"class":85}," .btn",[36,1057,53],{"class":52},[36,1059,91],{"class":56},[36,1061,60],{"class":52},[36,1063,1064],{"class":56},"blue",[36,1066,264],{"class":52},[36,1068,1069],{"class":42},"\u002F* (0,1,1,0) *\u002F\n",[36,1071,1072,1074,1076,1078,1080,1082,1085],{"class":38,"line":46},[36,1073,846],{"class":85},[36,1075,53],{"class":52},[36,1077,91],{"class":56},[36,1079,60],{"class":52},[36,1081,231],{"class":56},[36,1083,1084],{"class":52},"; }               ",[36,1086,1087],{"class":42},"\u002F* (0,0,1,0) — loses *\u002F\n",[14,1089,1090],{},"The button stays blue. Why?",[1092,1093,1094,1098,1117,1120,1186,1200],"details",{},[1095,1096,1097],"summary",{},"Answer",[14,1099,1100,1103,1104,1106,1107,1109,1110,1112,1113,1116],{},[33,1101,1102],{},"#sidebar .btn"," has specificity (0,1,1,0) — one ID (",[33,1105,1052],{},") plus one class (",[33,1108,846],{},"). ",[33,1111,846],{}," has specificity (0,0,1,0) — one class. The ID-based selector wins, so the button stays blue, even though ",[33,1114,1115],{},".btn { background: green }"," comes later in the source.",[14,1118,1119],{},"Specificity beats source order. To override, the green rule needs specificity ≥ (0,1,1,0):",[27,1121,1123],{"className":29,"code":1122,"language":25,"meta":31,"style":31},"#sidebar .btn { background: blue; }\n#sidebar .btn.green { background: green; }  \u002F* (0,1,2,0) — wins *\u002F\n\u002F* or *\u002F\n#sidebar .btn { background: green; }         \u002F* same specificity, later in source — wins *\u002F\n",[33,1124,1125,1141,1161,1166],{"__ignoreMap":31},[36,1126,1127,1129,1131,1133,1135,1137,1139],{"class":38,"line":39},[36,1128,1052],{"class":85},[36,1130,1055],{"class":85},[36,1132,53],{"class":52},[36,1134,91],{"class":56},[36,1136,60],{"class":52},[36,1138,1064],{"class":56},[36,1140,66],{"class":52},[36,1142,1143,1145,1148,1150,1152,1154,1156,1158],{"class":38,"line":46},[36,1144,1052],{"class":85},[36,1146,1147],{"class":85}," .btn.green",[36,1149,53],{"class":52},[36,1151,91],{"class":56},[36,1153,60],{"class":52},[36,1155,231],{"class":56},[36,1157,295],{"class":52},[36,1159,1160],{"class":42},"\u002F* (0,1,2,0) — wins *\u002F\n",[36,1162,1163],{"class":38,"line":69},[36,1164,1165],{"class":42},"\u002F* or *\u002F\n",[36,1167,1168,1170,1172,1174,1176,1178,1180,1183],{"class":38,"line":76},[36,1169,1052],{"class":85},[36,1171,1055],{"class":85},[36,1173,53],{"class":52},[36,1175,91],{"class":56},[36,1177,60],{"class":52},[36,1179,231],{"class":56},[36,1181,1182],{"class":52},"; }         ",[36,1184,1185],{"class":42},"\u002F* same specificity, later in source — wins *\u002F\n",[14,1187,1188,1189,1191,1192,1195,1196,1199],{},"::\nThe deeper fix: avoid ID selectors for styling. If ",[33,1190,1052],{}," were ",[33,1193,1194],{},".sidebar"," (a class), the specificity would be (0,0,2,0) vs (0,0,1,0), and adding a class (",[33,1197,1198],{},".btn.green",") would override cleanly. IDs in selectors create override battles.",[14,1201,1202,1205],{},[553,1203,1204],{},"The lesson",": an ID in a selector gives it specificity that classes can't override. Use class-based selectors for styling to keep specificity flat and overridable.",[18,1207,1208],{"id":1095},"Summary",[14,1210,1211,1212,973,1214,973,1216,973,1218,1220,1221,1223],{},"You can now use type\u002Fclass\u002FID\u002Fattribute selectors, combinators (descendant\u002Fchild\u002Fsibling), understand specificity (the 4-part value) and the cascade (importance → specificity → source order → inheritance), use ",[33,1213,703],{},[33,1215,712],{},[33,1217,718],{},[33,1219,724],{},", and manage specificity with ",[33,1222,734],{}," — while preferring low-specificity class selectors over IDs. Next: the box model.",[492,1225,1226],{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sk71V, html code.shiki .sk71V{--shiki-default:#22863A;--shiki-github-dark:#85E89D}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}",{"title":31,"searchDepth":46,"depth":46,"links":1228},[1229,1230,1231,1234,1235,1236,1237,1238,1239,1240],{"id":20,"depth":46,"text":21},{"id":339,"depth":46,"text":340},{"id":473,"depth":46,"text":474,"children":1232},[1233],{"id":535,"depth":69,"text":536},{"id":559,"depth":46,"text":560},{"id":604,"depth":46,"text":594},{"id":728,"depth":46,"text":729},{"id":819,"depth":46,"text":820},{"id":898,"depth":46,"text":899},{"id":1036,"depth":46,"text":1037},{"id":1095,"depth":46,"text":1208},"md",{},"\u002Fcss\u002F02-selectors-and-specificity",{"title":5,"description":16},"css\u002F02-selectors-and-specificity","BZ35jCopg1UxjFKALGWserAG0eOI0o6IgQJQTBzkZUw",1787401237795]