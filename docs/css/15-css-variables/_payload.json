1009],{},"✅",[982,1011,1012],{},"❌ (compile-time)",[964,1014,1015,1018,1020],{},[982,1016,1017],{},"JS access",[982,1019,1009],{},[982,1021,1022],{},"❌",[964,1024,1025,1028,1030],{},[982,1026,1027],{},"Conditional value",[982,1029,1009],{},[982,1031,1022],{},[964,1033,1034,1037,1040],{},[982,1035,1036],{},"Browser support",[982,1038,1039],{},"✅ (all modern)",[982,1041,1042],{},"✅ (compiled to CSS)",[14,1044,1045],{},"CSS variables are runtime, cascading, and JS-accessible — use them for theming and dynamic values. Preprocessor variables are compile-time constants — use for build-time math and mixins.",[18,1047,1049],{"id":1048},"tips-tricks","💡 Tips & Tricks",[207,1051,1052,1070,1092,1105,1117],{},[210,1053,1054,1057,1058,190,1061,190,1064,1066,1067,1069],{},[241,1055,1056],{},"Idiom",": use CSS variables for design tokens (",[33,1059,1060],{},"--color-primary",[33,1062,1063],{},"--spacing-md",[33,1065,170],{},") — define on ",[33,1068,43],{},", use everywhere. Change one value, the whole UI updates. This is the modern theming foundation.",[210,1071,1072,1074,1075,1077,1078,1081,1082,1085,1086,1088,1089,1091],{},[241,1073,1056],{},": use ",[33,1076,619],{}," attribute + CSS variables for manual theme toggles — ",[33,1079,1080],{},"[data-theme=\"dark\"] { --bg: #222; }"," and ",[33,1083,1084],{},"document.documentElement.setAttribute('data-theme', 'dark')"," switches themes instantly, no reload. Persist in ",[33,1087,721],{},", respect ",[33,1090,725],{}," on first load.",[210,1093,1094,1096,1097,1100,1101,1104],{},[241,1095,1056],{},": use CSS variables for JS↔CSS bridges — JS sets ",[33,1098,1099],{},"el.style.setProperty('--x', '100px')",", CSS uses ",[33,1102,1103],{},"transform: translateX(var(--x))",". This drives dynamic styling (drag, slider, scroll) without recomputing styles or inline transforms.",[210,1106,1107,1109,1110,1112,1113,1116],{},[241,1108,1056],{},": redefine variables in ",[33,1111,484],{}," blocks for responsive tokens — ",[33,1114,1115],{},"@media (min-width: 768px) { :root { --spacing: 2rem; } }"," makes the token responsive without touching each use site.",[210,1118,1119,1074,1121,1123,1124,1126],{},[241,1120,1056],{},[33,1122,226],{}," for robustness — the fallback applies if the variable is ",[346,1125,416],{},". Useful for components that should work even if the consumer didn't define the variable.",[18,1128,1130],{"id":1129},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[207,1132,1133,1161,1177,1189,1204,1224,1250,1285,1300,1316],{},[210,1134,1135,57,1142,1144,1145,409,1148,1150,1151,1154,1155,877,1157,1160],{},[241,1136,1137,1138,1141],{},"Invalid variable values make the ",[346,1139,1140],{},"property"," invalid, not the fallback",[33,1143,396],{}," (no unit) and ",[33,1146,1147],{},"padding: var(--gap)",[33,1149,921],{}," is invalid → set to ",[33,1152,1153],{},"initial"," (0), not the fallback. The fallback only applies if the variable is ",[346,1156,416],{},[33,1158,1159],{},"var(--undefined, 10px)",").",[210,1162,1163,57,1166,1081,1169,1172,1173,1176],{},[241,1164,1165],{},"Variables can't be used in property names or selectors",[33,1167,1168],{},"var(--prop): red",[33,1170,1171],{},".var(--cls)"," don't work. Variables are for ",[346,1174,1175],{},"values"," only.",[210,1178,1179,57,1182,1185,1186,1188],{},[241,1180,1181],{},"Variables can't be used in media query conditions",[33,1183,1184],{},"@media (min-width: var(--break))"," is invalid. You can redefine variables ",[346,1187,944],{}," media queries, but not use them in the condition.",[210,1190,1191,1194,1195,1197,1198,1200,1201,1203],{},[241,1192,1193],{},"Variables inherit",": a variable on ",[33,1196,43],{}," is global, but a variable on ",[33,1199,277],{}," only affects ",[33,1202,277],{}," and descendants. Unexpected inheritance can surprise — check the element's computed variables in DevTools.",[210,1205,1206,57,1212,1215,1216,1219,1220,1223],{},[241,1207,1208,1211],{},[33,1209,1210],{},"var()"," in shorthand can be tricky",[33,1213,1214],{},"margin: var(--gap)"," works, but ",[33,1217,1218],{},"margin: var(--gap) var(--gap2)"," — if either is invalid, the whole ",[33,1221,1222],{},"margin"," is invalid.",[210,1225,1226,57,1229,1232,1233,1236,1237,1232,1240,1243,1244,1246,1247,1160],{},[241,1227,1228],{},"URLs in variables need quoting carefully",[33,1230,1231],{},"--img: url(\"x.png\")"," then ",[33,1234,1235],{},"background: var(--img)"," works. But ",[33,1238,1239],{},"--url: \"x.png\"",[33,1241,1242],{},"background: url(var(--url))"," doesn't (can't use ",[33,1245,1210],{}," inside ",[33,1248,1249],{},"url()",[210,1251,1252,57,1258,1261,1262,1265,1266,1269,1270,1273,1274,1277,1278,1281,1282,1160],{},[241,1253,1254,1255],{},"Variables and ",[33,1256,1257],{},"calc()",[33,1259,1260],{},"calc(var(--gap) * 2)"," works if ",[33,1263,1264],{},"--gap"," has a unit (",[33,1267,1268],{},"10px","). ",[33,1271,1272],{},"calc(var(--n) * 2)"," with ",[33,1275,1276],{},"--n: 10"," (unitless) gives ",[33,1279,1280],{},"20"," (unitless, usable in ",[33,1283,1284],{},"calc",[210,1286,1287,57,1293,401,1296,1299],{},[241,1288,1289,1292],{},[33,1290,1291],{},"!important"," on variables",[33,1294,1295],{},"--primary: blue !important",[346,1297,1298],{},"variable"," important (harder to override). Rarely needed; avoid.",[210,1301,1302,1308,1309,1311,1312,1315],{},[241,1303,1304,1305,1307],{},"Initial value is ",[33,1306,416],{}," (guaranteed-invalid)",": a variable not defined anywhere is ",[33,1310,416],{},", so ",[33,1313,1314],{},"var(--undefined)"," makes the property invalid (or uses the fallback if provided).",[210,1317,1318,57,1321,1081,1324,1326,1327,1160],{},[241,1319,1320],{},"CSS variables are case-sensitive",[33,1322,1323],{},"--Color",[33,1325,264],{}," are different. Stick to a convention (kebab-case: ",[33,1328,1329],{},"--primary-color",[18,1331,1333],{"id":1332},"spot-the-bug","🧠 Spot the Bug",[14,1335,1336,1337,1339],{},"A developer sets a spacing variable without a unit, then uses it in ",[33,1338,921],{}," — the padding doesn't apply:",[23,1341,1342],{"language":25},[27,1343,1345],{"className":29,"code":1344,"language":25,"meta":31,"style":31},":root { --gap: 10; }\n.box { padding: var(--gap); }\n",[33,1346,1347,1362],{"__ignoreMap":31},[36,1348,1349,1351,1353,1355,1357,1360],{"class":38,"line":39},[36,1350,43],{"class":42},[36,1352,261],{"class":46},[36,1354,1264],{"class":53},[36,1356,57],{"class":46},[36,1358,1359],{"class":60},"10",[36,1361,272],{"class":46},[36,1363,1364,1367,1369,1371,1373,1375,1377,1379],{"class":38,"line":50},[36,1365,1366],{"class":42},".box",[36,1368,261],{"class":46},[36,1370,921],{"class":60},[36,1372,57],{"class":46},[36,1374,129],{"class":60},[36,1376,132],{"class":46},[36,1378,1264],{"class":53},[36,1380,577],{"class":46},[14,1382,1383],{},"What's wrong?",[1385,1386,1387,1391,1430,1436,1478,1484,1538],"details",{},[1388,1389,1390],"summary",{},"Answer",[14,1392,1393,1395,1396,1398,1399,1402,1403,1405,1406,1408,1409,190,1411,1414,1415,1417,1418,1420,1421,1423,1424,1426,1427,1429],{},[33,1394,396],{}," is a unitless value. ",[33,1397,1147],{}," becomes ",[33,1400,1401],{},"padding: 10",", which is an ",[346,1404,420],{}," value for ",[33,1407,921],{}," (lengths need a unit: ",[33,1410,1268],{},[33,1412,1413],{},"10rem",", etc.). When ",[33,1416,1210],{}," resolves to an invalid value, the ",[346,1419,404],{}," is invalid, and ",[33,1422,921],{}," is set to its ",[33,1425,1153],{}," value (0) — not a fallback (no fallback was provided, and even if one was, it only applies if the variable is ",[346,1428,416],{},", not if its value is invalid).",[14,1431,1432,1433,1435],{},"The fix — give ",[33,1434,1264],{}," a unit:",[27,1437,1439],{"className":29,"code":1438,"language":25,"meta":31,"style":31},":root { --gap: 10px; }\n.box { padding: var(--gap); }   \u002F* 10px *\u002F\n",[33,1440,1441,1457],{"__ignoreMap":31},[36,1442,1443,1445,1447,1449,1451,1453,1455],{"class":38,"line":39},[36,1444,43],{"class":42},[36,1446,261],{"class":46},[36,1448,1264],{"class":53},[36,1450,57],{"class":46},[36,1452,1359],{"class":60},[36,1454,95],{"class":78},[36,1456,272],{"class":46},[36,1458,1459,1461,1463,1465,1467,1469,1471,1473,1475],{"class":38,"line":50},[36,1460,1366],{"class":42},[36,1462,261],{"class":46},[36,1464,921],{"class":60},[36,1466,57],{"class":46},[36,1468,129],{"class":60},[36,1470,132],{"class":46},[36,1472,1264],{"class":53},[36,1474,315],{"class":46},[36,1476,1477],{"class":199},"\u002F* 10px *\u002F\n",[14,1479,1480,1481,1483],{},"Or use ",[33,1482,1257],{}," to add the unit (less clean):",[27,1485,1487],{"className":29,"code":1486,"language":25,"meta":31,"style":31},":root { --gap: 10; }\n.box { padding: calc(var(--gap) * 1px); }   \u002F* 10px *\u002F\n",[33,1488,1489,1503],{"__ignoreMap":31},[36,1490,1491,1493,1495,1497,1499,1501],{"class":38,"line":39},[36,1492,43],{"class":42},[36,1494,261],{"class":46},[36,1496,1264],{"class":53},[36,1498,57],{"class":46},[36,1500,1359],{"class":60},[36,1502,272],{"class":46},[36,1504,1505,1507,1509,1511,1513,1515,1517,1519,1521,1523,1526,1529,1532,1534,1536],{"class":38,"line":50},[36,1506,1366],{"class":42},[36,1508,261],{"class":46},[36,1510,921],{"class":60},[36,1512,57],{"class":46},[36,1514,1284],{"class":60},[36,1516,132],{"class":46},[36,1518,129],{"class":60},[36,1520,132],{"class":46},[36,1522,1264],{"class":53},[36,1524,1525],{"class":46},") ",[36,1527,1528],{"class":78},"*",[36,1530,1531],{"class":60}," 1",[36,1533,95],{"class":78},[36,1535,315],{"class":46},[36,1537,1477],{"class":199},[14,1539,1540,1543,1544,1546,1547,1549,1550,1552,1553,1549,1556,216],{},[241,1541,1542],{},"The lesson",": CSS variables are substituted as raw values — ",[33,1545,396],{}," puts ",[33,1548,1359],{}," in ",[33,1551,1401],{},", which is invalid (no unit). The property becomes invalid (→ initial), not a fallback. Always include units in variable values, or multiply by ",[33,1554,1555],{},"1px",[33,1557,1257],{},[18,1559,1560],{"id":1388},"Summary",[14,1562,1563,1564,190,1567,1569,1570,1572,1573,1575,1576,1578,1579,1581],{},"You can now define and use CSS variables (",[33,1565,1566],{},"--name",[33,1568,226],{},"), leverage inheritance\u002Fcascade, build light\u002Fdark themes (",[33,1571,725],{}," + ",[33,1574,619],{},"), drive dynamic styling from JS (",[33,1577,789],{},"), redefine tokens in ",[33,1580,484],{},", and choose CSS variables over preprocessor variables for runtime\u002Fcascading needs — while avoiding the invalid-value trap. Next: writing modes and logical properties.",[1583,1584,1585],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(