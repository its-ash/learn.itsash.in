a pseudo-element's opacity for shadow transitions — ",[18,1026,28],{}," animation repaints each frame; opacity is compositor-only (GPU, 60fps).",[34,1029,1031],{"id":1030},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[982,1033,1034,1050,1066,1079,1098],{},[985,1035,1036,72,1042,1045,1046,1049],{},[988,1037,1038,1041],{},[18,1039,1040],{},"border-style: none"," (default) means no border",[18,1043,1044],{},"border-width: 2px"," alone does nothing. Always set a style (",[18,1047,1048],{},"solid"," etc.).",[985,1051,1052,1061,1062,1065],{},[988,1053,1054,1056,1057,1060],{},[18,1055,28],{}," is clipped by ",[18,1058,1059],{},"overflow: hidden"," ancestors",": a child's shadow extending outside is cut. Use ",[18,1063,1064],{},"overflow: clip"," (no scroll container) or restructure.",[985,1067,1068,1075,1076,1078],{},[988,1069,1070,1072,1073],{},[18,1071,24],{}," doesn't follow ",[18,1074,654],{}," in most browsers: the outline is rectangular even on a rounded box. Use ",[18,1077,28],{}," as a focus indicator if you need rounded focus rings.",[985,1080,1081,1093,1094,1097],{},[988,1082,1083,1086,1087,1089,1090],{},[18,1084,1085],{},"text-shadow"," has no ",[18,1088,645],{}," or ",[18,1091,1092],{},"spread",": only ",[18,1095,1096],{},"offset-x offset-y blur color",". Multiple shadows (comma) create 3D\u002Fglow effects.",[985,1099,1100,1105,1106,1089,1109,1111],{},[988,1101,1102,1104],{},[18,1103,1014],{}," on a non-square = ellipse",": for a circle, the element must be square (",[18,1107,1108],{},"width === height",[18,1110,1018],{},").",[34,1113,1115],{"id":1114},"spot-the-bug","🧠 Spot the Bug",[39,1117,1118],{"language":41},[43,1119,1121],{"className":45,"code":1120,"language":41,"meta":47,"style":47},"button { outline: none; }\nbutton:focus { box-shadow: 0 0 0 2px blue; }\n",[18,1122,1123,1137],{"__ignoreMap":47},[51,1124,1125,1127,1129,1131,1133,1135],{"class":53,"line":54},[51,1126,788],{"class":787},[51,1128,224],{"class":61},[51,1130,24],{"class":68},[51,1132,7