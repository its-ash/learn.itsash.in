elapses, even if the ",[17,1341,19],{}," took another case. In hot loops, use ",[17,1344,345],{},[17,1346,349],{},".",[1200,1349,1350,1355,1356,1347],{},[705,1351,1352,1354],{},[17,1353,156],{}," makes the select non-blocking",": if you want to block (wait for a case), omit ",[17,1357,156],{},[1200,1359,1360,1307,1363,1366],{},[705,1361,1362],{},"A nil channel case is never ready",[17,1364,1365],{},"select { case x := \u003C-nilch: ... }"," — that case never fires. Useful for disabling cases (set the channel to nil to turn it off), a footgun if unintended.",[1200,1368,1369,1374,1375,1377],{},[705,1370,1371,1372],{},"Sending to a closed channel panics inside ",[17,1373,19],{},": same rule as outside — ",[17,1376,19],{}," doesn't protect against sends on closed channels.",[1200,1379,1380,1307,1394,1397,1398,1400,1401,1403,1404,1406,1407,1410,1411,1413],{},[705,1381,1382,1240,1385,1388,1389,1391,1392],{},[17,1383,1384],{},"for-select",[17,1386,1387],{},"break"," only breaks the ",[17,1390,19],{},", not the ",[17,1393,832],{},[17,1395,1396],{},"for { select { case ...: break } }"," — the ",[17,1399,1387],{}," exits the ",[17,1402,19],{},", then the ",[17,1405,832],{}," continues. Use ",[17,1408,1409],{},"return"," or a labeled ",[17,1412,1387],{}," to exit the loop.",[1200,1415,1416,1419],{},[705,1417,1418],{},"Starvation",": if one case is always ready, another may never be picked (random selection helps, but isn't fair). For fairness, use separate goroutines or explicit scheduling.",[22,1421,1423],{"id":1422},"spot-the-bug","🧠 Spot the Bug",[14,1425,1426,1427,1429],{},"A developer writes a worker that should exit when ",[17,1428,476],{}," is closed, but it never does:",[27,1431,1432],{"language":29},[31,1433,1435],{"className":33,"code":1434,"language":29,"meta":35,"style":35},"func worker(input \u003C-chan int, done \u003C-chan struct{}) {\n    for v := range input {\n        select {\n        case \u003C-done:\n            return   \u002F\u002F intends to exit\n        default:\n            process(v)\n        }\n    }\n}\n",[17,1436,1437,1461,1475,1481,1489,1496,1503,1509,1513,1517],{"__ignoreMap":35},[39,1438,1439,1441,1443,1445,1447,1449,1451,1453,1455,1457,1459],{"class":41,"line":42},[39,1440,467],{"class":45},[39,1442,470],{"class":76},[39,1444,80],{"class":48},[39,1446,1094],{"class":475},[39,1448,479],{"class":45},[39,1450,733],{"class":45},[39,1452,736],{"class":48},[39,1454,476],{"class":475},[39,1456,479],{"class":45},[39,1458,482],{"class":45},[39,1460,485],{"class":48},[39,1462,1463,1465,1467,1469,1472],{"class":41,"line":52},[39,1464,490],{"class":45},[39,1466,58],{"class":48},[39,1468,61],{"class":45},[39,1470,1471],{"class":45}," range",[39,1473,1474],{"class":48}," input {\n",[39,1476,1477,1479],{"class":41,"line":70},[39,1478,497],{"class":45},[39,1480,49],{"class":48},[39,1482,1483,1485,1487],{"class":41,"line":90},[39,1484,504],{"class":45},[39,1486,64],{"class":45},[39,1488,509],{"class":48},[39,1490,1491,1493],{"class":41,"line":108},[39,1492,514],{"class":45},[39,1494,1495],{"class":397},"   \u002F\u002F intends to exit\n",[39,1497,1498,1501],{"class":41,"line":123},[39,1499,1500],{"class":45},"        default",[39,1502,105],{"class":48},[39,1504,1505,1507],{"class":41,"line":139},[39,1506,535],{"class":76},[39,1508,426],{"class":48},[39,1510,1511],{"class":41,"line":153},[39,1512,542],{"class":48},[39,1514,1515],{"class":41,"line":161},[39,1516,547],{"class":48},[39,1518,1519],{"class":41,"line":175},[39,1520,178],{"class":48},[14,1522,1523],{},"What's wrong?",[1525,1526,1527,1531,1559,1579,1588,1692,1715],"details",{},[1528,1529,1530],"summary",{},"Answer",[14,1532,1533,1534,1536,1537,1539,1540,1542,1543,1545,1546,1549,1550,1552,1553,1555,1556,1558],{},"The ",[17,1535,156],{}," case makes the ",[17,1538,19],{}," non-blocking — if ",[17,1541,1212],{}," isn't ready (not closed yet), ",[17,1544,156],{}," runs immediately and ",[17,1547,1548],{},"process(v)"," is called. The ",[17,1551,19],{}," never blocks on ",[17,1554,1212],{},", so it only checks ",[17,1557,476],{}," when there's an input to process, and even then, only as a non-blocking check.",[14,1560,1561,1562,1565,1566,1568,1569,1571,1572,1575,1576,1578],{},"The bigger issue: the ",[17,1563,1564],{},"for v := range input"," loop only checks ",[17,1567,476],{}," after receiving a value. If ",[17,1570,1094],{}," never produces (or is slow), the worker is stuck in ",[17,1573,1574],{},"range input",", never checking ",[17,1577,476],{}," — it can't be cancelled while waiting for input.",[14,1580,1581,1582,1584,1585,1587],{},"The fix — put both cases in the same ",[17,1583,19],{}," without ",[17,1586,156],{},", so the goroutine blocks on whichever is ready:",[31,1589,1591],{"className":33,"code":1590,"language":29,"meta":35,"style":35},"func worker(input \u003C-chan int, done \u003C-chan struct{}) {\n    for {\n        select {\n        case v, ok := \u003C-input:\n            if !ok {\n                return   \u002F\u002F input closed\n            }\n            process(v)\n        case \u003C-done:\n            return   \u002F\u002F cancellation — fires even if input has nothing\n        }\n    }\n}\n",[17,1592,1593,1617,1623,1629,1641,1649,1655,1659,1665,1673,1680,1684,1688],{"__ignoreMap":35},[39,1594,1595,1597,1599,1601,1603,1605,1607,1609,1611,1613,1615],{"class":41,"line":42},[39,1596,467],{"class":45},[39,1598,470],{"class":76},[39,1600,80],{"class":48},[39,1602,1094],{"class":475},[39,1604,479],{"class":45},[39,1606,733],{"class":45},[39,1608,736],{"class":48},[39,1610,476],{"class":475},[39,1612,479],{"class":45},[39,1614,482],{"class":45},[39,1616,485],{"class":48},[39,1618,1619,1621],{"class":41,"line":52},[39,1620,490],{"class":45},[39,1622,49],{"class":48},[39,1624,1625,1627],{"class":41,"line":70},[39,1626,497],{"class":45},[39,1628,49],{"class":48},[39,1630,1631,1633,1635,1637,1639],{"class":41,"line":90},[39,1632,504],{"class":45},[39,1634,1128],{"class":48},[39,1636,61],{"class":45},[39,1638,64],{"class":45},[39,1640,530],{"class":48},[39,1642,1643,1645,1647],{"class":41,"line":108},[39,1644,1139],{"class":45},[39,1646,1142],{"class":45},[39,1648,1145],{"class":48},[39,1650,1651,1653],{"class":41,"line":123},[39,1652,1150],{"class":45},[39,1654,1153],{"class":397},[39,1656,1657],{"class":41,"line":139},[39,1658,1018],{"class":48},[39,1660,1661,1663],{"class":41,"line":153},[39,1662,535],{"class":76},[39,1664,426],{"class":48},[39,1666,1667,1669,1671],{"class":41,"line":161},[39,1668,504],{"class":45},[39,1670,64],{"class":45},[39,1672,509],{"class":48},[39,1674,1675,1677],{"class":41,"line":175},[39,1676,514],{"class":45},[39,1678,1679],{"class":397},"   \u002F\u002F cancellation — fires even if input has nothing\n",[39,1681,1682],{"class":41,"line":181},[39,1683,542],{"class":48},[39,1685,1686],{"class":41,"line":187},[39,1687,547],{"class":48},[39,1689,1690],{"class":41,"line":193},[39,1691,178],{"class":48},[14,1693,1694,1695,1697,1698,1700,1701,1703,1704,1706,1707,1709,1710,1712,1713,1347],{},"::\nNow the ",[17,1696,19],{}," blocks on either ",[17,1699,1094],{}," or ",[17,1702,476],{}," — whichever becomes ready first. If ",[17,1705,476],{}," is closed while the worker is waiting for input, the ",[17,1708,1212],{}," case fires and the worker exits. The ",[17,1711,156],{}," was wrong — it prevented blocking on ",[17,1714,476],{},[14,1716,1717,1307,1720,1722,1723,1725,1726,1728,1729,1347],{},[705,1718,1719],{},"The lesson",[17,1721,156],{}," makes ",[17,1724,19],{}," non-blocking, which prevents waiting on ",[17,1727,476],{},". For cancellation that works even when the main work is idle, block on both (input and done) without ",[17,1730,156],{},[22,1732,1733],{"id":1528},"Summary",[14,1735,1736,1737,1739,1740,1213,1742,1744,1745,1747,1748,1213,1750,1752,1753,1755,1756,1758,1759,1762],{},"You can now use ",[17,1738,19],{}," to multiplex channel operations, add timeouts (",[17,1741,1227],{},[17,1743,370],{},"), non-blocking send\u002Freceive (",[17,1746,156],{},"), cancellation (",[17,1749,476],{},[17,1751,1269],{},"), and build the standard ",[17,1754,1384],{}," loop and fan-in. You understand random selection, nil-channel disabling, and the ",[17,1757,156],{},"-prevents-cancellation trap. Next: the ",[17,1760,1761],{},"sync"," package for lower-level concurrency primitives.",[1764,1765,1766],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sMKGj, html code.shiki .sMKGj{--shiki-default:#B31D28;--shiki-default-font-style:italic;--shiki-github-dark:#FDAEB7;--shiki-github-dark-font-style:italic}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-g