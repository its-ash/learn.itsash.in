id":454},"donecancellation-pattern","Done\u002FCancellation Pattern",[27,457,458],{"language":29},[31,459,461],{"className":33,"code":460,"language":29,"meta":35,"style":35},"func worker(done \u003C-chan struct{}) {\n    for {\n        select {\n        case \u003C-done:\n            return   \u002F\u002F cancellation signal\n        case v := \u003C-input:\n            process(v)\n        }\n    }\n}\n``\n::\n\n`\u003C-done` (a `chan struct{}` that's closed to signal) lets the goroutine check for cancellation at each `select`. The `context` package (chapter 20) generalizes this.\n\n## Non-Blocking Send\u002FReceive with `default`\n\n::code-wrapper{language=\"go\"}\n```go\n\u002F\u002F Non-blocking receive\nselect {\ncase v := \u003C-ch:\n    fmt.Println(\"got\", v)\ndefault:\n    fmt.Println(\"no value ready\")\n}\n\n\u002F\u002F Non-blocking send\nselect {\ncase ch \u003C- v:\n    fmt.Println(\"sent\")\ndefault:\n    fmt.Println(\"channel full, dropped\")\n}\n``\n",[17,462,463,486,493,500,510,518,531,538,543,548,552,556,560,564,583,587,592,596,600,604,609,613,617,622,627,632,636,640,645,650,656,662,667,673,678],{"__ignoreMap":35},[39,464,465,468,471,473,477,480,483],{"class":41,"line":42},[39,466,467],{"class":45},"func",[39,469,470],{"class":76}," worker",[39,472,80],{"class":48},[39,474,476],{"class":475},"sCrzJ","done",[39,478,479],{"class":45}," \u003C-chan",[39,481,482],{"class":45}," struct",[39,484,485],{"class":48},"{}) {\n",[39,487,488,491],{"class":41,"line":52},[39,489,490],{"class":45},"    for",[39,492,49],{"class":48},[39,494,495,498],{"class":41,"line":70},[39,496,497],{"class":45},"        select",[39,499,49],{"class":48},[39,501,502,505,507],{"class":41,"line":90},[39,503,504],{"class":45},"        case",[39,506,64],{"class":45},[39,508,509],{"class":48},"done:\n",[39,511,512,515],{"class":41,"line":108},[39,513,514],{"class":45},"            return",[39,516,517],{"class":397},"   \u002F\u002F cancellation signal\n",[39,519,520,522,524,526,528],{"