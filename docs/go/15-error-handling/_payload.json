hecked.",[1279,1287,1288,1289,1292],{},"It forces you to ",[18,1290,1291],{},"decide"," at each point (handle, wrap, return, or ignore).",[1279,1294,1295],{},"It avoids the hidden control flow of exceptions (which jump over code).",[14,1297,1298,1299,1256,1302,1305],{},"Embrace the verbosity — it's a feature, not a bug. Linters (",[28,1300,1301],{},"errcheck",[28,1303,1304],{},"golangci-lint",") flag ignored errors.",[23,1307,1309],{"id":1308},"tips-tricks","💡 Tips & Tricks",[1276,1311,1312,1325,1348,1359,1387],{},[1279,1313,1314,1317,1318,1321,1322,1324],{},[18,1315,1316],{},"Idiom",": always wrap errors with context at each layer — ",[28,1319,1320],{},"fmt.Errorf(\"doing X: %w\", err)"," — so the final error reads like a stack trace (",[28,1323,571],{},"). The context should describe what the caller was trying to do, not the low-level failure.",[1279,1326,1327,1329,1330,1332,1333,1256,1336,1339,1340,1343,1344,1347],{},[18,1328,1316],{},": use ",[28,1331,578],{}," for sentinel errors (",[28,1334,1335],{},"io.EOF",[28,1337,1338],{},"sql.ErrNoRows",", your own ",[28,1341,1342],{},"ErrNotFound",") — it walks the wrap chain, so a wrapped sentinel is still detected. Don't use ",[28,1345,1346],{},"=="," directly (it misses wrapped errors).",[1279,1349,1350,1329,1352,1354,1355,1358],{},[18,1351,1316],{},[28,1353,763],{}," to extract typed errors with fields — ",[28,1356,1357],{},"var perr *fs.PathError; if errors.As(err, &perr) { ... perr.Path ... }",". This lets callers handle specific error types with structured information, not just messages.",[1279,1360,1361,1329,1363,1365,1366,1368,1369,1372,1373,1375,1376,430,1378,1380,1381,1383,1384,1386],{},[18,1362,1316],{},[28,1364,333],{}," (not ",[28,1367,363],{},") in ",[28,1370,1371],{},"fmt.Errorf"," to wrap — ",[28,1374,333],{}," preserves the original error for ",[28,1377,578],{},[28,1379,799],{},"; ",[28,1382,363],{}," formats it into the message but loses the wrap chain. Use ",[28,1385,363],{}," only when you deliberately want to hide the original (rare).",[1279,1388,1389,1391,1392,1394,1395,1398,1399,1256,1401,1403],{},[18,1390,1316],{},": reserve ",[28,1393,1033],{}," for genuine bugs (violated invariants, \"this should never happen\") — not for normal error handling. The ",[28,1396,1397],{},"MustX"," convention (",[28,1400,1255],{},[28,1402,1259],{},") panics on error for package-level init where failure is a programmer mistake, not a runtime condition.",[23,1405,1407],{"id":1406},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1276,1409,1410,1436,1454,1476,1506,1532,1543,1553,1569],{},[1279,1411,1412,330,1422,1424,1425,430,1427,1429,1430,1432,1433,1435],{},[18,1413,1414,1416,1417,1419,1420],{},[28,1415,333],{}," vs ",[28,1418,363],{}," in ",[28,1421,1371],{},[28,1423,333],{}," wraps (preserves for ",[28,1426,578],{},[28,1428,799],{},"); ",[28,1431,363],{}," formats into the message (original lost). Use ",[28,1434,333],{}," almost always.",[1279,1437,1438,1446,1447,1450,1451,1453],{},[18,1439,1440,1441,1443,1444],{},"Multiple ",[28,1442,333],{}," in one ",[28,1445,1371],{}," (Go 1.20+): ",[28,1448,1449],{},"fmt.Errorf(\"%w %w\", err1, err2)"," wraps both — ",[28,1452,578],{}," checks both. Rare but supported.",[1279,1455,1456,330,1462,1465,1466,1469,1470,1472,1473,572],{},[18,1457,1458,1459,1461],{},"Sentinel error comparison with ",[28,1460,1346],{}," misses wraps",[28,1463,1464],{},"err == ErrNotFound"," is false if ",[28,1467,1468],{},"err"," wraps ",[28,1471,1342],{},". Use ",[28,1474,1475],{},"errors.Is(err, ErrNotFound)",[1279,1477,1478,330,1483,1486,1487,1490,1491,1494,1495,1498,1499,1502,1503,1505],{},[18,1479,1480,1482],{},[28,1481,763],{}," target must be a pointer to a pointer\u002Fnon-pointer",[28,1484,1485],{},"var perr *PathError; errors.As(err, &perr)"," — the target is ",[28,1488,1489],{},"**PathError",". Passing ",[28,1492,1493],{},"&perr"," where ",[28,1496,1497],{},"perr"," is ",[28,1500,1501],{},"*PathError"," is correct; passing ",[28,1504,1497],{}," directly is wrong.",[1279,1507,1508,330,1515,1518,1519,1521,1522,1525,1526,1528,1529,1531],{},[18,1509,1510,1511,1514],{},"Returning ",[28,1512,1513],{},"nil"," as an interface wraps a nil concrete (the nil-interface trap)",[28,1516,1517],{},"func f() error { var p *MyError = nil; return p }"," — the returned ",[28,1520,30],{}," is non-nil (it has type ",[28,1523,1524],{},"*MyError","), and ",[28,1527,264],{}," is true. Return ",[28,1530,1513],{}," directly.",[1279,1533,1534,1539,1540,1542],{},[18,1535,1536,1538],{},[28,1537,1033],{}," in a goroutine crashes the program",": a panic in a goroutine that isn't recovered terminates the whole program (not just the goroutine). Always ",[28,1541,1037],{}," in goroutines that might panic, or ensure panics can't happen.",[1279,1544,1545,1550,1551,572],{},[18,1546,1547,1549],{},[28,1548,1037],{}," only works in the deferred function of the panicking goroutine",": you can't recover from another goroutine's panic. Each goroutine must have its own ",[28,1552,1037],{},[1279,1554,1555,330,1558,1561,1562,1565,1566,1568],{},[18,1556,1557],{},"Ignoring an error is a bug",[28,1559,1560],{},"_ = f()"," or ",[28,1563,1564],{},"f()"," (discarding the error) hides failures. ",[28,1567,1301],{}," flags these. At minimum, log the error.",[1279,1570,1571,1580,1581,1584,1585,1588],{},[18,1572,1573,1576,1577],{},[28,1574,1575],{},"log.Fatal"," calls ",[28,1578,1579],{},"os.Exit",": it doesn't run deferred functions and exits immediately. Don't use it in library code or anywhere with cleanup ",[28,1582,1583],{},"defer","s. Use it only in ",[28,1586,1587],{},"main"," for \"truly fatal\" startup errors.",[23,1590,1592],{"id":1591},"spot-the-bug","🧠 Spot the Bug",[14,1594,1595,1596,1598],{},"A function returns a custom error, but the caller's ",[28,1597,763],{}," check fails:",[33,1600,1601,1972,1997,2010,2014],{"language":35},[37,1602,1604],{"className":39,"code":1603,"language":35,"meta":41,"style":41},"type MyError struct{ Code int }\nfunc (e *MyError) Error() string { return fmt.Sprintf(\"code %d\", e.Code) }\n\nfunc f() error {\n    return &MyError{Code: 42}\n}\n\nfunc main() {\n    err := f()\n    var e *MyError\n    if errors.As(err, e) {   \u002F\u002F ❌ wrong — should be &e\n        fmt.Println(e.Code)\n    }\n}\n``\n::\n\nWhat's wrong?\n\n\u003Cdetails>\n\u003Csummary>Answer\u003C\u002Fsummary>\n\n`errors.As(err, target)` expects `target` to be a **pointer to the target type's pointer** — i.e., `**MyError`. `var e *MyError; errors.As(err, e)` passes `e` (a `*MyError`, nil), not `&e` (a `**MyError`). The signature is `errors.As(err error, target any) bool`, and `target` must be a non-nil pointer to either a type implementing error or to any interface type. Passing `e` (a nil `*MyError`) doesn't give `errors.As` a place to write the result.\n\nThe fix — pass `&e`:\n\n```go\nerr := f()\nvar e *MyError\nif errors.As(err, &e) {   \u002F\u002F ✅ &e is **MyError\n    fmt.Println(e.Code)   \u002F\u002F 42\n}\n",[28,1605,1606,1625,1674,1678,1691,1708,1712,1716,1726,1738,1751,1765,1775,1779,1783,1787,1791,1795,1805,1809,1814,1819,1823,1931,1935,1940,1944,1948,1953,1958,1963,1968],{"__ignoreMap":41},[45,1607,1608,1610,1613,1616,1619,1622],{"class":47,"line":48},[45,1609,52],{"class":51},[45,1611,1612],{"class":68}," MyError",[45,1614,1615],{"class":51}," struct",[45,1617,1618],{"class":61},"{ Code ",[45,1620,1621],{"class":51},"int",[45,1623,1624],{"class":61}," }\n",[45,1626,1627,1629,1632,1635,1637,1640,1642,1645,1647,1650,1653,1656,1659,1662,1664,1667,1669,1671],{"class":47,"line":65},[45,1628,1058],{"class":51},[45,1630,1631],{"class":61}," (",[45,1633,1634],{"class":1066},"e ",[45,1636,782],{"class":51},[45,1638,1639],{"class":68},"MyError",[45,1641,1073],{"class":61},[45,1643,1644],{"class":68},"Error",[45,1646,72],{"class":61},[45,1648,1649],{"class":51},"string",[45,1651,1652],{"class":61}," { ",[45,1654,1655],{"class":51},"return",[45,1657,1658],{"class":61}," fmt.",[45,1660,1661],{"class":68},"Sprintf",[45,1663,295],{"class":61},[45,1665,1666],{"class":87},"\"code ",[45,1668,322],{"class":321},[45,1670,336],{"class":87},[45,1672,1673],{"class":61},", e.Code) }\n",[45,1675,1676],{"class":47,"line":78},[45,1677,101],{"emptyLinePlaceholder":100},[45,1679,1680,1682,1685,1687,1689],{"class":47,"line":84},[45,1681,1058],{"class":51},[45,1683,1684],{"class":68}," f",[45,1686,72],{"class":61},[45,1688,30],{"class":51},[45,1690,62],{"class":61},[45,1692,1693,1695,1698,1700,1703,1706],{"class":47,"line":91},[45,1694,1138],{"class":51},[45,1696,1697],{"class":51}," &",[45,1699,1639],{"class":68},[45,1701,1702],{"class":61},"{Code: ",[45,1704,1705],{"class":321},"42",[45,1707,81],{"class":61},[45,1709,1710],{"class":47,"line":97},[45,1711,81],{"class":61},[45,1713,1714],{"class":47,"line":104},[45,1715,101],{"emptyLinePlaceholder":100},[45,1717,1718,1720,1723],{"class":47,"line":141},[45,1719,1058],{"class":51},[45,1721,1722],{"class":68}," main",[45,1724,1725],{"class":61},"() {\n",[45,1727,1728,1731,1733,1735],{"class":47,"line":146},[45,1729,1730],{"class":61},"    err ",[45,1732,1093],{"class":51},[45,1734,1684],{"class":68},[45,1736,1737],{"class":61},"()\n",[45,1739,1740,1743,1746,1748],{"class":47,"line":152},[45,1741,1742],{"class":51},"    var",[45,1744,1745],{"class":61}," e ",[45,1747,782],{"class":51},[45,1749,1750],{"class":68},"MyError\n",[45,1752,1753,1755,1757,1759,1762],{"class":47,"line":157},[45,1754,1107],{"class":51},[45,1756,594],{"class":61},[45,1758,799],{"class":68},[45,1760,1761],{"class":61},"(err, e) {   ",[45,1763,1764],{"class":304},"\u002F\u002F ❌ wrong — should be &e\n",[45,1766,1767,1770,1772],{"class":47,"line":177},[45,1768,1769],{"class":61},"        fmt.",[45,1771,816],{"class":68},[45,1773,1774],{"class":61},"(e.Code)\n",[45,1776,1777],{"class":47,"line":183},[45,1778,204],{"class":61},[45,1780,1781],{"class":47,"line":189},[45,1782,81],{"class":61},[45,1784,1785],{"class":47,"line":195},[45,1786,88],{"class":87},[45,1788,1789],{"class":47,"line":201},[45,1790,94],{"class":61},[45,1792,1793],{"class":47,"line":207},[45,1794,101],{"emptyLinePlaceholder":100},[45,1796,1797,1800,1802],{"class":47,"line":213},[45,1798,1799],{"class":61},"What",[45,1801,461],{"class":87},[45,1803,1804],{"class":464},"s wrong?\n",[45,1806,1807],{"class":47,"line":218},[45,1808,101],{"emptyLinePlaceholder":100},[45,1810,1811],{"class":47,"line":223},[45,1812,1813],{"class":464},"\u003Cdetails>\n",[45,1815,1816],{"class":47,"line":229},[45,1817,1818],{"class":464},"\u003Csummary>Answer\u003C\u002Fsummary>\n",[45,1820,1821],{"class":47,"line":235},[45,1822,101],{"emptyLinePlaceholder":100},[45,1824,1825,1828,1830,1833,1835,1838,1841,1843,1846,1849,1852,1855,1858,1860,1862,1865,1868,1870,1872,1875,1878,1881,1884,1887,1889,1891,1894,1896,1899,1901,1904,1907,1909,1912,1914,1916,1918,1920,1923,1926,1928],{"class":47,"line":241},[45,1826,1827],{"class":464},"`errors.As(err, target)` expects `target` to be a **pointer to the target type",[45,1829,461],{"class":87},[45,1831,1832],{"class":61},"s pointer",[45,1834,662],{"class":51},[45,1836,1837],{"class":61}," — i.e., ",[45,1839,1840],{"class":87},"`**MyError`",[45,1842,269],{"class":61},[45,1844,1845],{"class":87},"`var e *MyError; errors.As(err, e)`",[45,1847,1848],{"class":61}," passes ",[45,1850,1851],{"class":87},"`e`",[45,1853,1854],{"class":61}," (a ",[45,1856,1857],{"class":87},"`*MyError`",[45,1859,1256],{"class":61},[45,1861,1513],{"class":321},[45,1863,1864],{"class":61},"), not ",[45,1866,1867],{"class":87},"`&e`",[45,1869,1854],{"class":61},[45,1871,1840],{"class":87},[45,1873,1874],{"class":61},"). The signature is ",[45,1876,1877],{"class":87},"`errors.As(err error, target any) bool`",[45,1879,1880],{"class":61},", and ",[45,1882,1883],{"class":87},"`target`",[45,1885,1886],{"class":61}," must be a non",[45,1888,163],{"class":51},[45,1890,1513],{"class":321},[45,1892,1893],{"class":61}," pointer to either a ",[45,1895,52],{"class":51},[45,1897,1898],{"class":61}," implementing ",[45,1900,30],{"class":51},[45,1902,1903],{"class":61}," or to ",[45,1905,1906],{"class":68},"any",[45,1908,58],{"class":51},[45,1910,1911],{"class":51}," type",[45,1913,1490],{"class":61},[45,1915,1851],{"class":87},[45,1917,1854],{"class":61},[45,1919,1513],{"class":321},[45,1921,1922],{"class":87}," `*MyError`",[45,1924,1925],{"class":61},") doesn",[45,1927,461],{"class":87},[45,1929,1930],{"class":464},"t give `errors.As` a place to write the result.\n",[45,1932,1933],{"class":47,"line":246},[45,1934,101],{"emptyLinePlaceholder":100},[45,1936,1937],{"class":47,"line":252},[45,1938,1939],{"class":464},"The fix — pass `&e`:\n",[45,1941,1942],{"class":47,"line":541},[45,1943,101],{"emptyLinePlaceholder":100},[45,1945,1946],{"class":47,"line":546},[45,1947,180],{"class":464},[45,1949,1950],{"class":47,"line":552},[45,1951,1952],{"class":464},"err := f()\n",[45,1954,1955],{"class":47,"line":558},[45,1956,1957],{"class":464},"var e *MyError\n",[45,1959,1960],{"class":47,"line":563},[45,1961,1962],{"class":464},"if errors.As(err, &e) {   \u002F\u002F ✅ &e is **MyError\n",[45,1964,1965],{"class":47,"line":999},[45,1966,1967],{"class":464},"    fmt.Println(e.Code)   \u002F\u002F 42\n",[45,1969,1970],{"class":47,"line":1005},[45,1971,81],{"class":464},[14,1973,94,1974,1976,1977,1979,1980,1983,1984,1987,1988,1991,1992,1256,1994,1996],{},[28,1975,763],{}," walks the error chain, finds the ",[28,1978,1524],{},", and assigns it to ",[28,1981,1982],{},"e"," (via the ",[28,1985,1986],{},"**MyError"," pointer ",[28,1989,1990],{},"&e","). Without ",[28,1993,805],{},[28,1995,763],{}," has no address to write to and either panics or returns false (depending on the Go version — modern Go panics with \"errors.As target must be a non-nil pointer\").",[14,1998,1999,330,2002,2005,2006,2009],{},[18,2000,2001],{},"The lesson",[28,2003,2004],{},"errors.As(err, &target)"," — always pass the address of the target variable, not the variable itself. ",[28,2007,2008],{},"target"," must be a pointer to the error type you want to extract.",[23,2011,2013],{"id":2012},"summary","Summary",[14,2015,2016,2017,2020,2021,2023,2024,2026,2027,430,2029,2031],{},"You can now return errors, wrap them with ",[28,2018,2019],{},"fmt.Errorf(\"...: %w\", err)",", match sentinels with ",[28,2022,578],{},", extract typed errors with ",[28,2025,763],{},", define custom error types, and use ",[28,2028,1033],{},[28,2030,1037],{}," only for genuine bugs. You understand why Go's verbose error handling is a feature and the nil-interface-error trap. Next: goroutines — Go's concurrency primitive.",[2033,2034,2035],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sMKGj, html code.shiki .sMKGj{--shiki-default:#B31D28;--shiki-default-font-style:italic;--shiki-github-dark:#FDAEB7;--shiki-github-dark-font-style:italic}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}",{"title":41,"searchDepth":65,"depth":65,"links":2037},[2038,2040,2041,2043,2045,2047,2049,2050,2051,2052],{"id":25,"depth":65,"text":2039},"The error Interface",{"id":276,"depth":65,"text":277},{"id":575,"depth":65,"text":2042},"errors.Is — Sentinel Error Matching",{"id":760,"depth":65,"text":2044},"errors.As — Typed Error Extraction",{"id":1030,"depth":65,"text":2046},"panic and recover",{"id":1263,"depth":65,"text":2048},"The if err != nil Repetition",{"id":1308,"depth":65,"text":1309},{"id":1406,"depth":65,"text":1407},{"id":1591,"depth":65,"text":1592},{"id":2012,"depth":65,"text":2013},"Go has no exceptions. Errors are values — returned from functions, checked by callers. This is deliberate: explicit error handling makes control flow visible and avoids the hidden jumps of try\u002Fcatch.","md",{},"\u002Fgo\u002F15-error-handling",{"title":5,"description":2053},"go\u002F15-error-handling","4OzD_EneTOucgJVxUjq_zD6wJOjCbXoXs8nfNpOBtHg",1787401091119]