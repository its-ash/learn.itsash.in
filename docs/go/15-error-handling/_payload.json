tionError) Error() string {\n    return fmt.Sprintf(\"validation error: %s: %s\", e.Field, e.Message)\n}\n\nfunc validate(u User) error {\n    if u.Email == \"\" {\n        return &ValidationError{Field: \"email\", Message: \"required\"}\n    }\n    return nil\n}\n\nerr := validate(u)\nvar ve *ValidationError\nif errors.As(err, &ve) {\n    fmt.Println(ve.Field)   \u002F\u002F \"email\"\n}\n``\n",[28,771,772,791,809,828,832,836,840,844,878,882,887,891,905,909,914,919,924,928,932,937,952,956,960,965,970,975,979,984,988,992,997,1003,1009,1015,1020],{"__ignoreMap":41},[45,773,774,777,780,783,786,788],{"class":47,"line":48},[45,775,776],{"class":51},"var",[45,778,779],{"class":61}," pathErr ",[45,781,782],{"class":51},"*",[45,784,785],{"class":68},"fs",[45,787,572],{"class":61},[45,789,790],{"class":68},"PathError\n",[45,792,793,795,797,800,803,806],{"class":47,"line":65},[45,794,591],{"class":51},[45,796,594],{"class":61},[45,798,799],{"class":68},"As",[45,801,802],{"class":61},"(err, ",[45,804,805],{"class":51},"&",[45,807,808],{"class":61},"pathErr) {\n",[45,810,811,814,817,819,822,825],{"class":47,"line":78},[45,812,813],{"class":61},"    fmt.",[45,815,816],{"class":68},"Println",[45,818,295],{"class":61},[45,820,821],{"class":87},"\"path error:\"",[45,823,824],{"class":61},", pathErr.Path)   ",[45,826,827],{"class":304},"\u002F\u002F access typed fields\n",[45,829,830],{"class":47,"line":84},[45,831,81],{"class":61},[45,833,834],{"class":47,"line":91},[45,835,88],{"class":87},[45,837,838],{"class":47,"line":97},[45,839,94],{"class":61},[45,841,842],{"class":47,"line":104},[45,843,101],{"emptyLinePlaceholder":100},[45,845,846,849,852,854,857,859,862,864,867,870,873,875],{"class":47,"line":141},[45,847,848],{"class":87},"`errors.As`",[45,850,851],{"class":61}," walks the wrap chain and, ",[45,853,591],{"class":51},[45,855,856],{"class":61}," it finds an ",[45,858,30],{"class":51},[45,860,861],{"class":61}," of the target ",[45,863,52],{"class":51},[45,865,866],{"class