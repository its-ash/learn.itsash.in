[{"data":1,"prerenderedAt":2060},["ShallowReactive",2],{"page-\u002Fgo\u002F15-error-handling":3},{"id":4,"title":5,"body":6,"description":2053,"extension":2054,"meta":2055,"navigation":100,"path":2056,"seo":2057,"stem":2058,"__hash__":2059},"content\u002Fgo\u002F15-error-handling.md","15 — Error Handling",{"type":7,"value":8,"toc":2036},"minimark",[9,13,22,32,255,274,278,566,573,580,758,765,1025,1028,1038,1047,1237,1261,1268,1275,1296,1306,1310,1404,1408,1589,1593,1599,2032],[10,11,5],"h1",{"id":12},"_15-error-handling",[14,15,16,17,21],"p",{},"Go has no exceptions. Errors are ",[18,19,20],"strong",{},"values"," — returned from functions, checked by callers. This is deliberate: explicit error handling makes control flow visible and avoids the hidden jumps of try\u002Fcatch.",[23,24,26,27,31],"h2",{"id":25},"the-error-interface","The ",[28,29,30],"code",{},"error"," Interface",[33,34,36],"code-wrapper",{"language":35},"go",[37,38,42],"pre",{"className":39,"code":40,"language":35,"meta":41,"style":41},"language-go shiki shiki-themes github-light github-dark","type error interface {\n    Error() string\n}\n``\n::\n\nAny type with an `Error() string` method is an error. The standard `errors` package and `fmt.Errorf` create errors.\n\n## Returning Errors\n\n::code-wrapper{language=\"go\"}\n```go\nfunc divide(a, b int) (int, error) {\n    if b == 0 {\n        return 0, errors.New(\"division by zero\")\n    }\n    return a \u002F b, nil\n}\n\nq, err := divide(10, 0)\nif err != nil {\n    log.Fatal(err)   \u002F\u002F or handle gracefully\n}\nfmt.Println(q)\n``\n","",[28,43,44,63,76,82,89,95,102,139,144,150,155,175,181,187,193,199,205,211,216,221,227,233,239,244,250],{"__ignoreMap":41},[45,46,49,53,56,59],"span",{"class":47,"line":48},"line",1,[45,50,52],{"class":51},"svdQ7","type",[45,54,55],{"class":51}," error",[45,57,58],{"class":51}," interface",[45,60,62],{"class":61},"ssxIu"," {\n",[45,64,66,70,73],{"class":47,"line":65},2,[45,67,69],{"class":68},"sIsaT","    Error",[45,71,72],{"class":61},"() ",[45,74,75],{"class":51},"string\n",[45,77,79],{"class":47,"line":78},3,[45,80,81],{"class":61},"}\n",[45,83,85],{"class":47,"line":84},4,[45,86,88],{"class":87},"sJ6F3","``\n",[45,90,92],{"class":47,"line":91},5,[45,93,94],{"class":61},"::\n",[45,96,98],{"class":47,"line":97},6,[45,99,101],{"emptyLinePlaceholder":100},true,"\n",[45,103,105,108,110,113,116,119,121,124,127,130,133,136],{"class":47,"line":104},7,[45,106,107],{"class":61},"Any ",[45,109,52],{"class":51},[45,111,112],{"class":61}," with an ",[45,114,115],{"class":87},"`Error() string`",[45,117,118],{"class":61}," method is an ",[45,120,30],{"class":51},[45,122,123],{"class":61},". The standard ",[45,125,126],{"class":87},"`errors`",[45,128,129],{"class":51}," package",[45,131,132],{"class":68}," and",[45,134,135],{"class":87}," `fmt.Errorf`",[45,137,138],{"class":61}," create errors.\n",[45,140,142],{"class":47,"line":141},8,[45,143,101],{"emptyLinePlaceholder":100},[45,145,147],{"class":47,"line":146},9,[45,148,149],{"class":61},"## Returning Errors\n",[45,151,153],{"class":47,"line":152},10,[45,154,101],{"emptyLinePlaceholder":100},[45,156,158,161,164,167,170,173],{"class":47,"line":157},11,[45,159,160],{"class":61},"::code",[45,162,163],{"class":51},"-",[45,165,166],{"class":61},"wrapper{language",[45,168,169],{"class":51},"=",[45,171,172],{"class":87},"\"go\"",[45,174,81],{"class":61},[45,176,178],{"class":47,"line":177},12,[45,179,180],{"class":87},"```go\n",[45,182,184],{"class":47,"line":183},13,[45,185,186],{"class":87},"func divide(a, b int) (int, error) {\n",[45,188,190],{"class":47,"line":189},14,[45,191,192],{"class":87},"    if b == 0 {\n",[45,194,196],{"class":47,"line":195},15,[45,197,198],{"class":87},"        return 0, errors.New(\"division by zero\")\n",[45,200,202],{"class":47,"line":201},16,[45,203,204],{"class":87},"    }\n",[45,206,208],{"class":47,"line":207},17,[45,209,210],{"class":87},"    return a \u002F b, nil\n",[45,212,214],{"class":47,"line":213},18,[45,215,81],{"class":87},[45,217,219],{"class":47,"line":218},19,[45,220,101],{"emptyLinePlaceholder":100},[45,222,224],{"class":47,"line":223},20,[45,225,226],{"class":87},"q, err := divide(10, 0)\n",[45,228,230],{"class":47,"line":229},21,[45,231,232],{"class":87},"if err != nil {\n",[45,234,236],{"class":47,"line":235},22,[45,237,238],{"class":87},"    log.Fatal(err)   \u002F\u002F or handle gracefully\n",[45,240,242],{"class":47,"line":241},23,[45,243,81],{"class":87},[45,245,247],{"class":47,"line":246},24,[45,248,249],{"class":87},"fmt.Println(q)\n",[45,251,253],{"class":47,"line":252},25,[45,254,88],{"class":87},[14,256,257,258,261,262,265,266,269,270,273],{},"The convention: functions that can fail return ",[28,259,260],{},"(result, error)",". The caller checks ",[28,263,264],{},"err != nil"," before using ",[28,267,268],{},"result",". ",[18,271,272],{},"Always check the error"," — ignoring it is a bug.",[23,275,277],{"id":276},"creating-errors","Creating Errors",[33,279,280],{"language":35},[37,281,283],{"className":39,"code":282,"language":35,"meta":41,"style":41},"errors.New(\"division by zero\")                    \u002F\u002F simple message\nfmt.Errorf(\"divide %d by %d: %w\", a, b, err)      \u002F\u002F formatted, wrapping %w\nfmt.Errorf(\"divide %d by %d: %v\", a, b, err)      \u002F\u002F formatted, %v (no wrapping)\n``\n::\n\n- `errors.New` — a simple error with a message.\n- `fmt.Errorf` with `%w` — wraps an existing error (preserving it for `errors.Is`\u002F`As`).\n- `fmt.Errorf` with `%v` — formats the error into the message but doesn't wrap (the original error is lost for unwrapping).\n\n## Error Wrapping (Go 1.13+)\n\nWrapping adds context while preserving the original error for inspection:\n\n::code-wrapper{language=\"go\"}\n```go\nfunc readConfig(path string) ([]byte, error) {\n    data, err := os.ReadFile(path)\n    if err != nil {\n        return nil, fmt.Errorf(\"read config %s: %w\", path, err)\n    }\n    return data, nil\n}\n\ndata, err := readConfig(\"config.yaml\")\nif err != nil {\n    \u002F\u002F err is \"read config config.yaml: open config.yaml: no such file or directory\"\n    \u002F\u002F and the original *fs.PathError is preserved for errors.Is\u002FAs\n}\n``\n",[28,284,285,306,343,371,375,379,383,398,437,466,470,475,479,484,488,493,497,502,507,512,517,521,526,530,534,539,544,550,556,561],{"__ignoreMap":41},[45,286,287,290,293,296,299,302],{"class":47,"line":48},[45,288,289],{"class":61},"errors.",[45,291,292],{"class":68},"New",[45,294,295],{"class":61},"(",[45,297,298],{"class":87},"\"division by zero\"",[45,300,301],{"class":61},")                    ",[45,303,305],{"class":304},"sdCPZ","\u002F\u002F simple message\n",[45,307,308,311,314,316,319,323,326,328,331,334,337,340],{"class":47,"line":65},[45,309,310],{"class":61},"fmt.",[45,312,313],{"class":68},"Errorf",[45,315,295],{"class":61},[45,317,318],{"class":87},"\"divide ",[45,320,322],{"class":321},"snvgF","%d",[45,324,325],{"class":87}," by ",[45,327,322],{"class":321},[45,329,330],{"class":87},": ",[45,332,333],{"class":321},"%w",[45,335,336],{"class":87},"\"",[45,338,339],{"class":61},", a, b, err)      ",[45,341,342],{"class":304},"\u002F\u002F formatted, wrapping %w\n",[45,344,345,347,349,351,353,355,357,359,361,364,366,368],{"class":47,"line":78},[45,346,310],{"class":61},[45,348,313],{"class":68},[45,350,295],{"class":61},[45,352,318],{"class":87},[45,354,322],{"class":321},[45,356,325],{"class":87},[45,358,322],{"class":321},[45,360,330],{"class":87},[45,362,363],{"class":321},"%v",[45,365,336],{"class":87},[45,367,339],{"class":61},[45,369,370],{"class":304},"\u002F\u002F formatted, %v (no wrapping)\n",[45,372,373],{"class":47,"line":84},[45,374,88],{"class":87},[45,376,377],{"class":47,"line":91},[45,378,94],{"class":61},[45,380,381],{"class":47,"line":97},[45,382,101],{"emptyLinePlaceholder":100},[45,384,385,387,390,393,395],{"class":47,"line":104},[45,386,163],{"class":51},[45,388,389],{"class":87}," `errors.New`",[45,391,392],{"class":61}," — a simple ",[45,394,30],{"class":51},[45,396,397],{"class":61}," with a message.\n",[45,399,400,402,404,407,410,412,414,417,419,422,425,428,431,434],{"class":47,"line":141},[45,401,163],{"class":51},[45,403,135],{"class":87},[45,405,406],{"class":61}," with ",[45,408,409],{"class":87},"`",[45,411,333],{"class":321},[45,413,409],{"class":87},[45,415,416],{"class":61}," — wraps an existing ",[45,418,30],{"class":51},[45,420,421],{"class":61}," (preserving it ",[45,423,424],{"class":51},"for",[45,426,427],{"class":87}," `errors.Is`",[45,429,430],{"class":51},"\u002F",[45,432,433],{"class":87},"`As`",[45,435,436],{"class":61},").\n",[45,438,439,441,443,445,447,449,451,454,456,459,462],{"class":47,"line":146},[45,440,163],{"class":51},[45,442,135],{"class":87},[45,444,406],{"class":61},[45,446,409],{"class":87},[45,448,363],{"class":321},[45,450,409],{"class":87},[45,452,453],{"class":61}," — formats the ",[45,455,30],{"class":51},[45,457,458],{"class":61}," into the message but doesn",[45,460,461],{"class":87},"'",[45,463,465],{"class":464},"sMKGj","t wrap (the original error is lost for unwrapping).\n",[45,467,468],{"class":47,"line":152},[45,469,101],{"emptyLinePlaceholder":100},[45,471,472],{"class":47,"line":157},[45,473,474],{"class":464},"## Error Wrapping (Go 1.13+)\n",[45,476,477],{"class":47,"line":177},[45,478,101],{"emptyLinePlaceholder":100},[45,480,481],{"class":47,"line":183},[45,482,483],{"class":464},"Wrapping adds context while preserving the original error for inspection:\n",[45,485,486],{"class":47,"line":189},[45,487,101],{"emptyLinePlaceholder":100},[45,489,490],{"class":47,"line":195},[45,491,492],{"class":464},"::code-wrapper{language=\"go\"}\n",[45,494,495],{"class":47,"line":201},[45,496,180],{"class":464},[45,498,499],{"class":47,"line":207},[45,500,501],{"class":464},"func readConfig(path string) ([]byte, error) {\n",[45,503,504],{"class":47,"line":213},[45,505,506],{"class":464},"    data, err := os.ReadFile(path)\n",[45,508,509],{"class":47,"line":218},[45,510,511],{"class":464},"    if err != nil {\n",[45,513,514],{"class":47,"line":223},[45,515,516],{"class":464},"        return nil, fmt.Errorf(\"read config %s: %w\", path, err)\n",[45,518,519],{"class":47,"line":229},[45,520,204],{"class":464},[45,522,523],{"class":47,"line":235},[45,524,525],{"class":464},"    return data, nil\n",[45,527,528],{"class":47,"line":241},[45,529,81],{"class":464},[45,531,532],{"class":47,"line":246},[45,533,101],{"emptyLinePlaceholder":100},[45,535,536],{"class":47,"line":252},[45,537,538],{"class":464},"data, err := readConfig(\"config.yaml\")\n",[45,540,542],{"class":47,"line":541},26,[45,543,232],{"class":464},[45,545,547],{"class":47,"line":546},27,[45,548,549],{"class":464},"    \u002F\u002F err is \"read config config.yaml: open config.yaml: no such file or directory\"\n",[45,551,553],{"class":47,"line":552},28,[45,554,555],{"class":464},"    \u002F\u002F and the original *fs.PathError is preserved for errors.Is\u002FAs\n",[45,557,559],{"class":47,"line":558},29,[45,560,81],{"class":464},[45,562,564],{"class":47,"line":563},30,[45,565,88],{"class":464},[14,567,568,569,572],{},"The convention: wrap with context at each layer, so the final error reads like a stack trace: ",[28,570,571],{},"read config: open config.yaml: no such file or directory",".",[23,574,576,579],{"id":575},"errorsis-sentinel-error-matching",[28,577,578],{},"errors.Is"," — Sentinel Error Matching",[33,581,582],{"language":35},[37,583,585],{"className":39,"code":584,"language":35,"meta":41,"style":41},"if errors.Is(err, os.ErrNotExist) {\n    \u002F\u002F err is or wraps os.ErrNotExist\n}\n``\n::\n\n`errors.Is` walks the wrap chain and checks if any error in the chain matches the target (using `==` or an `Is()` method). Use it for **sentinel errors** (predeclared error values):\n\n::code-wrapper{language=\"go\"}\n```go\nvar ErrNotFound = errors.New(\"not found\")\n\nfunc getUser(id int) (*User, error) {\n    \u002F\u002F ...\n    return nil, ErrNotFound\n}\n\nu, err := getUser(42)\nif errors.Is(err, ErrNotFound) {\n    \u002F\u002F handle \"not found\" specifically\n} else if err != nil {\n    \u002F\u002F handle other errors\n}\n``\n",[28,586,587,601,606,610,614,618,622,671,675,689,693,698,702,707,712,717,721,725,730,735,740,745,750,754],{"__ignoreMap":41},[45,588,589,592,595,598],{"class":47,"line":48},[45,590,591],{"class":51},"if",[45,593,594],{"class":61}," errors.",[45,596,597],{"class":68},"Is",[45,599,600],{"class":61},"(err, os.ErrNotExist) {\n",[45,602,603],{"class":47,"line":65},[45,604,605],{"class":304},"    \u002F\u002F err is or wraps os.ErrNotExist\n",[45,607,608],{"class":47,"line":78},[45,609,81],{"class":61},[45,611,612],{"class":47,"line":84},[45,613,88],{"class":87},[45,615,616],{"class":47,"line":91},[45,617,94],{"class":61},[45,619,620],{"class":47,"line":97},[45,621,101],{"emptyLinePlaceholder":100},[45,623,624,627,630,632,635,637,640,643,646,649,652,654,657,660,663,666,668],{"class":47,"line":104},[45,625,626],{"class":87},"`errors.Is`",[45,628,629],{"class":61}," walks the wrap chain and checks ",[45,631,591],{"class":51},[45,633,634],{"class":68}," any",[45,636,55],{"class":51},[45,638,639],{"class":61}," in the chain matches the target (using ",[45,641,642],{"class":87},"`==`",[45,644,645],{"class":61}," or an ",[45,647,648],{"class":87},"`Is()`",[45,650,651],{"class":61}," method). Use it ",[45,653,424],{"class":51},[45,655,656],{"class":51}," **",[45,658,659],{"class":61},"sentinel errors",[45,661,662],{"class":51},"**",[45,664,665],{"class":61}," (predeclared ",[45,667,30],{"class":51},[45,669,670],{"class":61}," values):\n",[45,672,673],{"class":47,"line":141},[45,674,101],{"emptyLinePlaceholder":100},[45,676,677,679,681,683,685,687],{"class":47,"line":146},[45,678,160],{"class":61},[45,680,163],{"class":51},[45,682,166],{"class":61},[45,684,169],{"class":51},[45,686,172],{"class":87},[45,688,81],{"class":61},[45,690,691],{"class":47,"line":15