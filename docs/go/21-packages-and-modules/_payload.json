uired?",[97,692,549],{"class":103},[97,694,696,698,700,702,705,707,710,713],{"class":99,"line":695},16,[97,697,537],{"class":103},[97,699,570],{"class":114},[97,701,89],{"class":118},[97,703,704],{"class":114}," mod graph`",[97,706,543],{"class":103},[97,708,709],{"class":118}," Dependency",[97,711,712],{"class":114}," graph.",[97,714,549],{"class":103},[97,716,718,720,722,724,727,729,732,735,738],{"class":99,"line":717},17,[97,719,537],{"class":103},[97,721,570],{"class":114},[97,723,89],{"class":118},[97,725,726],{"class":114}," mod edit`",[97,728,543],{"class":103},[97,730,731],{"class":118}," Edit",[97,733,734],{"class":114}," go.mod",[97,736,737],{"class":114}," programmatically.",[97,739,549],{"class":103},[97,741,743],{"class":99,"line":742},18,[97,744,315],{"emptyLinePlaceholder":314},[97,746,748],{"class":99,"line":747},19,[97,749,750],{"class":125},"## Workspaces (`go work`, Go 1.18+)\n",[97,752,754],{"class":99,"line":753},20,[97,755,315],{"emptyLinePlaceholder":314},[97,757,759,762,765,768,771,774,777,780,783,786,789,792,795],{"class":99,"line":758},21,[97,760,761],{"class":118},"For",[97,763,764],{"class":114}," multi-module",[97,766,767],{"class":114}," development",[97,769,770],{"class":107}," (e.g., ",[97,772,773],{"class":114},"a",[97,775,776],{"class":114}," library",[97,778,779],{"class":114}," and",[97,781,782],{"class":114}," an",[97,784,785],{"class":114}," app",[97,787,788],{"class":114}," that",[97,790,791],{"class":114}," uses",[97,793,794],{"class":114}," it",[97,796,797],{"class":107},"):\n",[97,799,801],{"class":99,"line":800},22,[97,802,315],{"emptyLinePlaceholder":314},[97,804,806,808,811,814],{"class":99,"line":805},23,[97,807,221],{"class":364},[97,809,810],{"class":114},":code-wrapper{language=",[97,812,813],{"class":118},"\"bash\"",[97,815,816],{"class":118},"}\n",[97,818,820,823],{"class":99,"line":819},24,[97,821,822],{"class":114},"```",[97,824,825],{"class":118},"bash\n",[97,827,829,831],{"class":99,"line":828},25,[97,830,89],{"class":118},[97,832,833],{"class":114}," work init .\u002Fmyapp .\u002Fmylib\n",[97,835,837],{"class":99,"line":836},26,[97,838,839],{"class":125},"# Creates go.work:\n",[97,841,843],{"class":99,"line":842},27,[97,844,845],{"class":125},"# go 1.22\n",[97,847,849],{"class":99,"line":848},28,[97,850,851],{"class":125},"# use (\n",[97,853,855],{"class":99,"line":854},29,[97,856,857],{"class":125},"#   .\u002Fmyapp\n",[97,859,861],{"class":99,"line":860},30,[97,862,863],{"class":125},"#   .\u002Fmylib\n",[97,865,867],{"class":99,"line":866},31,[97,868,869],{"class":125},"# )\n",[97,871,873],{"class":99,"line":872},32,[97,874,315],{"emptyLinePlaceholder":314},[97,876,878,880],{"class":99,"line":877},33,[97,879,89],{"class":118},[97,881,882],{"class":114}," work use .\u002Fanother\n",[14,884,885],{},"::",[14,887,888,889,892,893,896,897,900,901,903,904,907,908,911],{},"In a workspace, ",[27,890,891],{},"go build","\u002F",[27,894,895],{},"go test"," resolve modules to local directories (not the published versions). This replaces ",[27,898,899],{},"replace"," directives in ",[27,902,220],{}," for local development. ",[27,905,906],{},"go.work"," is ",[18,909,910],{},"not committed"," (it's developer-specific).",[32,913,915],{"id":914},"vendoring","Vendoring",[47,917,918],{"language":224},[51,919,921],{"className":227,"code":920,"language":224,"meta":56,"style":56},"go mod vendor   # copy deps into .\u002Fvendor\u002F\ngo build -mod=vendor   # use vendored deps\n",[27,922,923,935],{"__ignoreMap":56},[97,924,925,927,929,932],{"class":99,"line":100},[97,926,89],{"class":118},[97,928,237],{"class":114},[97,930,931],{"class":114}," vendor",[97,933,934],{"class":125},"   # copy deps into .\u002Fvendor\u002F\n",[97,936,937,939,942,945],{"class":99,"line":111},[97,938,89],{"class":118},[97,940,941],{"class":114}," build",[97,943,944],{"class":364}," -mod=vendor",[97,946,947],{"class":125},"   # use vendored deps\n",[14,949,950],{},"Vendoring copies dependencies into the project for offline\u002Freproducible builds. With Go modules, vendoring is optional (the module cache + go.sum provides reproducibility). Use it for air-gapped environments or strict supply-chain control.",[32,952,954],{"id":953},"tips-tricks","💡 Tips & Tricks",[60,956,957,970,982,996,1008],{},[63,958,959,962,963,965,966,969],{},[18,960,961],{},"Idiom",": use ",[27,964,192],{}," for packages that shouldn't be imported outside your module — the toolchain enforces the boundary, so you don't need to document \"don't use this.\" Reserve ",[27,967,968],{},"pkg\u002F"," (or top-level packages) for genuinely public, reusable code.",[63,971,972,974,975,977,978,981],{},[18,973,961],{},": run ",[27,976,435],{}," before every commit (and in CI: ",[27,979,980],{},"go mod tidy && git diff --exit-code",") — it adds missing deps, removes unused ones, and updates go.sum. Without it, go.mod\u002Fgo.sum drift from actual imports.",[63,983,984,962,986,989,990,992,993,995],{},[18,985,961],{},[27,987,988],{},"go work"," (Go 1.18+) for multi-module local development — it lets local edits to a library take effect in an app without ",[27,991,899],{}," directives in go.mod (which you'd have to remove before publishing). ",[27,994,906],{}," is developer-specific (not committed).",[63,997,998,1000,1001,1003,1004,1007],{},[18,999,961],{},": follow semantic import versioning — v1 modules have no version suffix (",[27,1002,411],{},"); v2+ require ",[27,1005,1006],{},"\u002Fv2"," in the path. Upgrading to v2 means changing import paths deliberately, preventing accidental breaking upgrades.",[63,1009,1010,1012,1013,1016,1017,1016,1020,1023],{},[18,1011,961],{},": keep packages focused and small — a package should have a clear purpose, a small public API, and cohesive functionality. \"Packages of many unrelated things\" are hard to use and test. The Go stdlib (",[27,1014,1015],{},"io",", ",[27,1018,1019],{},"net",[27,1021,1022],{},"encoding\u002Fjson",") exemplifies focused packages.",[32,1025,1027],{"id":1026},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[60,1029,1030,1042,1060,1075,1092,1101,1118,1124,1133,1151],{},[63,1031,1032,1035,1036,1038,1039,1041],{},[18,1033,1034],{},"v2+ requires a version suffix",": ",[27,1037,421],{}," — forgetting the ",[27,1040,1006],{}," imports the v1 module (or fails if there's no v1). This is the #1 Go modules gotcha.",[63,1043,1044,1049,1050,1052,1053,1055,1056,1059],{},[18,1045,1046,1048],{},[27,1047,192],{}," is enforced by path",": the directory must be named ",[27,1051,185],{}," (or have ",[27,1054,185],{}," in the path) for the restriction to apply. ",[27,1057,1058],{},"private\u002F"," has no special meaning.",[63,1061,1062,1067,1068,892,1070,1072,1073,69],{},[18,1063,1064,1066],{},[27,1065,906],{}," shouldn't be committed",": it's developer-specific local paths. Commit ",[27,1069,220],{},[27,1071,276],{},"; gitignore ",[27,1074,906],{},[63,1076,1077,1082,1083,1085,1086,1088,1089,1091],{},[18,1078,1079,1081],{},[27,1080,899],{}," directives in go.mod affect downstream consumers",": if you publish a library with a ",[27,1084,899],{},", it's ignored by consumers (replacements are local). Don't use ",[27,1087,899],{}," for published libraries — use ",[27,1090,988],{}," for local dev.",[63,1093,1094,1035,1097,1100],{},[18,1095,1096],{},"Module path must be unique for publishing",[27,1098,1099],{},"example.com\u002Fmyapp"," is fine for private code, but if you publish, use a path you control (GitHub repo, custom domain). Collisions cause import ambiguity.",[63,1102,1103,1109,1110,1113,1114,1117],{},[18,1104,1105,1108],{},[27,1106,1107],{},"go get"," in a module adds to go.mod",": but ",[27,1111,1112],{},"go get pkg@latest"," outside a module is disabled (Go 1.16+) — use ",[27,1115,1116],{},"go install pkg@latest"," for tools.",[63,1119,1120,1123],{},[18,1121,1122],{},"Minimum version selection",": Go uses MVS — the final version is the maximum of all required versions in the dependency graph. There's no \"resolve to highest\" like npm; each module's go.mod pins a minimum, and Go picks the max.",[63,1125,1126,1132],{},[18,1127,1128,1131],{},[27,1129,1130],{},"go mod vendor"," and CGO",": vendoring copies Go source, not C source. CGO dependencies may not vendor cleanly (they need the C toolchain at build time).",[63,1134,1135,1138,1139,1142,1143,1146,1147,1150],{},[18,1136,1137],{},"Package name ≠ import path last segment",": usually they match (",[27,1140,1141],{},"github.com\u002Fx\u002Fy\u002Fusers"," → ",[27,1144,1145],{},"package users","), but a package can declare a different name (",[27,1148,1149],{},"package myusers","). Use an alias if it's confusing.",[63,1152,1153,1035,1156,1159,1160,1163,1164,1167,1168,1170],{},[18,1154,1155],{},"Test packages",[27,1157,1158],{},"users_test.go"," can declare ",[27,1161,1162],{},"package users_test"," (external test) — it imports ",[27,1165,1166],{},"users"," like an external package, accessing only exported identifiers. Use this to test the public API; use ",[27,1169,1145],{}," (internal test) for testing unexported code.",[32,1172,1174],{"id":1173},"spot-the-bug","🧠 Spot the Bug",[14,1176,1177,1178,221],{},"A developer upgrades a dependency from v1 to v2 and changes ",[27,1179,220],{},[47,1181,1182],{"language":224},[51,1183,1185],{"className":227,"code":1184,"language":224,"meta":56,"style":56},"go get github.com\u002Fx\u002Fy@v2.0.0\n",[27,1186,1187],{"__ignoreMap":56},[97,1188,1189,1191,1193],{"class":99,"line":100},[97,1190,89],{"class":118},[97,1192,327],{"class":114},[97,1194,1195],{"class":114}," github.com\u002Fx\u002Fy@v2.0.0\n",[14,1197,1198,1199,1202],{},"But the import in code still reads ",[27,1200,1201],{},"import \"github.com\u002Fx\u002Fy\"",", and the build fails with \"module requires github.com\u002Fx\u002Fy\u002Fv2\". What's wrong?",[1204,1205,1206,1210,1230,1235,1254,1260],"details",{},[1207,1208,1209],"summary",{},"Answer",[14,1211,1212,1213,1219,1220,1222,1223,1226,1227,1229],{},"Go's semantic import versioning requires ",[18,1214,1215,1216,1218],{},"v2+ modules to have a ",[27,1217,1006],{}," suffix in the import path",". The developer upgraded the ",[27,1221,220],{}," requirement to ",[27,1224,1225],{},"v2.0.0",", but the code still imports ",[27,1228,411],{}," (the v1 path). The build fails because the code imports v1, but go.mod requires v2 (and there's no v1 at that version).",[14,1231,1232,1233,221],{},"The fix — update all import paths to include ",[27,1234,1006],{},[51,1236,1238],{"className":92,"code":1237,"language":89,"meta":56,"style":56},"import \"github.com\u002Fx\u002Fy\u002Fv2\"   \u002F\u002F not \"github.com\u002Fx\u002Fy\"\n",[27,1239,1240],{"__ignoreMap":56},[97,1241,1242,1244,1247,1249,1251],{"class":99,"line":100},[97,1243,104],{"class":103},[97,1245,1246],{"class":114}," \"",[97,1248,421],{"class":118},[97,1250,122],{"class":114},[97,1252,1253],{"class":125},"   \u002F\u002F not \"github.com\u002Fx\u002Fy\"\n",[14,1255,1256,1257,1259],{},"::\nAnd the module's own path (in its go.mod) must be ",[27,1258,421],{}," for the v2 module. This is a deliberate Go design: major version changes require import path changes, preventing accidental breaking upgrades.",[14,1261,1262,1265,1266,1269],{},[18,1263,1264],{},"The lesson",": v2+ Go modules require a ",[27,1267,1268],{},"\u002FvN"," suffix in the import path. Upgrading a dependency to v2 means changing every import of it (and the module's own path if you're the v2 author).",[32,1271,1272],{"id":1207},"Summary",[14,1274,1275,1276,1278,1279,1281,1282,1284,1285,1287],{},"You can now organize code into packages (with ",[27,1277,192],{}," for private), manage dependencies with ",[27,1280,29],{}," (init\u002Ftidy\u002Fget), use workspaces (",[27,1283,988],{},") for multi-module dev, follow semantic import versioning (v2+ requires ",[27,1286,1006],{},"), and vendor for offline builds. Next: I\u002FO and files.",[1289,1290,1291],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}",{"title":56,"searchDepth":111,"depth":111,"links":1293},[1294,1297,1299,1304,1305,1306,1307,1308],{"id":20,"depth":111,"text":34,"children":1295},[1296],{"id":82,"depth":129,"text":83},{"id":181,"depth":111,"text":1298},"The internal Convention",{"id":24,"depth":111,"text":214,"children":1300},[1301,1302,1303],{"id":280,"depth":129,"text":281},{"id":392,"depth":129,"text":393},{"id":432,"depth":129,"text":435},{"id":914,"depth":111,"text":915},{"id":953,"depth":111,"text":954},{"id":1026,"depth":111,"text":1027},{"id":1173,"depth":111,"text":1174},{"id":1207,"depth":111,"text":1272},"Go organizes code into packages (directories of related code) and modules (versioned collections of packages, managed by go mod).","md",{},"\u002Fgo\u002F21-packages-and-modules",{"title":5,"description":1309},"go\u002F21-packages-and-modules","x_RLxEqie5jmat7U4iS59t6ELz3_81u9Cl-6tDYl4P4",1786943181895]