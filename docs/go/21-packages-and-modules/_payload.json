[{"data":1,"prerenderedAt":1316},["ShallowReactive",2],{"page-\u002Fgo\u002F21-packages-and-modules":3},{"id":4,"title":5,"body":6,"description":1309,"extension":1310,"meta":1311,"navigation":314,"path":1312,"seo":1313,"stem":1314,"__hash__":1315},"content\u002Fgo\u002F21-packages-and-modules.md","21 — Packages & Modules",{"type":7,"value":8,"toc":1292},"minimark",[9,13,31,35,46,59,79,84,87,179,187,197,205,212,215,222,244,252,278,282,390,394,401,427,430,436,1288],[10,11,5],"h1",{"id":12},"_21-packages-modules",[14,15,16,17,21,22,25,26,30],"p",{},"Go organizes code into ",[18,19,20],"strong",{},"packages"," (directories of related code) and ",[18,23,24],{},"modules"," (versioned collections of packages, managed by ",[27,28,29],"code",{},"go mod",").",[32,33,34],"h2",{"id":20},"Packages",[14,36,37,38,41,42,45],{},"A package is a directory of ",[27,39,40],{},".go"," files sharing the same ",[27,43,44],{},"package"," declaration:",[47,48,50],"code-wrapper",{"language":49},"text",[51,52,57],"pre",{"className":53,"code":55,"language":49,"meta":56},[54],"language-text","myapp\u002F\n├── go.mod\n├── main.go              # package main\n├── users\u002F\n│   ├── users.go         # package users\n│   └── users_test.go    # package users (or users_test)\n├── internal\u002F\n│   └── config\u002F          # package config (only importable within myapp)\n└── utils\u002F\n    └── strings.go       # package utils\n","",[27,58,55],{"__ignoreMap":56},[60,61,62,70,76],"ul",{},[63,64,65,66,69],"li",{},"Each directory is a package; all files declare the same ",[27,67,68],{},"package \u003Cname>",".",[63,71,72,73,69],{},"Import by the full path: ",[27,74,75],{},"import \"example.com\u002Fmyapp\u002Fusers\"",[63,77,78],{},"Exported (capitalized) identifiers are accessible after import; unexported (lowercase) are package-private.",[80,81,83],"h3",{"id":82},"import-paths-and-package-names","Import paths and package names",[14,85,86],{},"The import path is the full module path + subdirectory. The package name is usually the last segment, but can differ:",[47,88,90],{"language":89},"go",[51,91,94],{"className":92,"code":93,"language":89,"meta":56,"style":56},"language-go shiki shiki-themes github-light github-dark","import (\n    \"example.com\u002Fmyapp\u002Fusers\"        \u002F\u002F package users\n    u \"example.com\u002Fmyapp\u002Fusers\"      \u002F\u002F alias: u.User\n    . \"example.com\u002Fmyapp\u002Fusers\"      \u002F\u002F dot: User (no prefix) — discouraged\n    _ \"github.com\u002Flib\u002Fpq\"            \u002F\u002F blank: side-effect only (init())\n)\n",[27,95,96,109,127,142,157,173],{"__ignoreMap":56},[97,98,101,105],"span",{"class":99,"line":100},"line",1,[97,102,104],{"class":103},"svdQ7","import",[97,106,108],{"class":107},"ssxIu"," (\n",[97,110,112,116,120,123],{"class":99,"line":111},2,[97,113,115],{"class":114},"sJ6F3","    \"",[97,117,119],{"class":118},"sIsaT","example.com\u002Fmyapp\u002Fusers",[97,121,122],{"class":114},"\"",[97,124,126],{"class":125},"sdCPZ","        \u002F\u002F package users\n",[97,128,130,133,135,137,139],{"class":99,"line":129},3,[97,131,132],{"class":107},"    u ",[97,134,122],{"class":114},[97,136,119],{"class":118},[97,138,122],{"class":114},[97,140,141],{"class":125},"      \u002F\u002F alias: u.User\n",[97,143,145,148,150,152,154],{"class":99,"line":144},4,[97,146,147],{"class":107},"    . ",[97,149,122],{"class":114},[97,151,119],{"class":118},[97,153,122],{"class":114},[97,155,156],{"class":125},"      \u002F\u002F dot: User (no prefix) — discouraged\n",[97,158,160,163,165,168,170],{"class":99,"line":159},5,[97,161,162],{"class":107},"    _ ",[97,164,122],{"class":114},[97,166,167],{"class":118},"github.com\u002Flib\u002Fpq",[97,169,122],{"class":114},[97,171,172],{"class":125},"            \u002F\u002F blank: side-effect only (init())\n",[97,174,176],{"class":99,"line":175},6,[97,177,178],{"class":107},")\n",[32,180,182,183,186],{"id":181},"the-internal-convention","The ",[27,184,185],{},"internal"," Convention",[14,188,189,190,193,194,196],{},"Packages under an ",[27,191,192],{},"internal\u002F"," directory can only be imported by code within the parent of ",[27,195,192],{},". The toolchain enforces this:",[47,198,199],{"language":49},[51,200,203],{"className":201,"code":202,"language":49,"meta":56},[54],"example.com\u002Fmyapp\u002F\n├── internal\u002F\n│   └── config\u002F       # only importable from within example.com\u002Fmyapp\u002F...\n└── users\u002F\n    └── users.go      # can import example.com\u002Fmyapp\u002Finternal\u002Fconfig\n",[27,204,202],{"__ignoreMap":56},[14,206,207,208,211],{},"External modules can't import ",[27,209,210],{},"example.com\u002Fmyapp\u002Finternal\u002Fconfig",". This is the idiomatic way to keep implementation details private.",[32,213,214],{"id":24},"Modules",[14,216,217,218,221],{},"A module is a versioned collection of packages, defined by ",[27,219,220],{},"go.mod",":",[47,223,225],{"language":224},"bash",[51,226,229],{"className":227,"code":228,"language":224,"meta":56,"style":56},"language-bash shiki shiki-themes github-light github-dark","go mod init example.com\u002Fmyapp\n",[27,230,231],{"__ignoreMap":56},[97,232,233,235,238,241],{"class":99,"line":100},[97,234,89],{"class":118},[97,236,237],{"class":114}," mod",[97,239,240],{"class":114}," init",[97,242,243],{"class":114}," example.com\u002Fmyapp\n",[47,245,246],{"language":49},[51,247,250],{"className":248,"code":249,"language":49,"meta":56},[54],"\u002F\u002F go.mod\nmodule example.com\u002Fmyapp\n\ngo 1.22\n\nrequire (\n    github.com\u002Flib\u002Fpq v1.10.0\n    github.com\u002Fgin-gonic\u002Fgin v1.7.0\n)\n",[27,251,249],{"__ignoreMap":56},[60,253,254,260,266,272],{},[63,255,256,259],{},[27,257,258],{},"module example.com\u002Fmyapp"," — the module path (unique identifier + import prefix).",[63,261,262,265],{},[27,263,264],{},"go 1.22"," — the minimum Go version.",[63,267,268,271],{},[27,269,270],{},"require"," — dependencies with versions.",[63,273,