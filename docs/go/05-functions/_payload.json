6},[36,585,586],{"class":50},"()\n",[36,588,589,592,595],{"class":38,"line":191},[36,590,591],{"class":46},"c",[36,593,594],{"class":50},"()   ",[36,596,597],{"class":187},"\u002F\u002F 1\n",[36,599,600,602,604],{"class":38,"line":198},[36,601,591],{"class":46},[36,603,594],{"class":50},[36,605,606],{"class":187},"\u002F\u002F 2\n",[36,608,609],{"class":38,"line":204},[36,610,195],{"class":194},[14,612,613,614,618,619,622],{},"Closures capture variables ",[615,616,617],"strong",{},"by reference"," — ",[33,620,621],{},"n"," is shared across calls to the returned function. This is how stateful functions (counters, accumulators) are built.",[18,624,626],{"id":625},"functions-as-values-and-parameters","Functions as Values and Parameters",[23,628,629],{"language":25},[27,630,632],{"className":29,"code":631,"language":25,"meta":31,"style":31},"var f func(int) int = func(x int) int { return x * 2 }\n\n\u002F\u002F Higher-order function\nfunc apply(nums []int, fn func(int) int) []int {\n    result := make([]int, len(nums))\n    for i, n := range nums {\n        result[i] = fn(n)\n    }\n    return result\n}\n\napply([]int{1, 2, 3}, func(x int) int { return x * x })   \u002F\u002F [1 4 9]\n",[33,633,634,685,689,694,731,754,767,780,784,791,795,799],{"__ignoreMap":31},[36,635,636,639,642,644,646,648,650,652,655,657,659,662,664,666,668,671,673,676,679,682],{"class":38,"line":39},[36,637,638],{"class":42},"var",[36,640,641],{"class":50}," f ",[36,643,43],{"class":42},[36,645,51],{"class":50},[36,647,70],{"class":42},[36,649,67],{"class":50},[36,651,70],{"class":42},[36,653,654],{"class":42}," =",[36,656,541],{"class":42},[36,658,51],{"class":50},[36,660,661],{"class":54},"x",[36,663,64],{"class":42},[36,665,67],{"class":50},[36,667,70],{"class":42},[36,669,670],{"class":50}," { ",[36,672,232],{"class":42},[36,674,675],{"class":50}," x ",[36,677,678],{"class":42},"*",[36,680,681],{"class":175}," 2",[36,683,684],{"class":50}," }\n",[36,686,687],{"class":38,"line":76},[36,688,101],