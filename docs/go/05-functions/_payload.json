":38,"line":243},[36,1023,1024],{"class":50},"Use ",[36,1026,1027],{"class":194},"`defer`",[36,1029,1030],{"class":42}," for",[36,1032,1033],{"class":50}," cleanup (closing files, releasing locks, responding to HTTP requests) — it guarantees the cleanup runs regardless of how the function exits (",[36,1035,232],{"class":42},[36,1037,1038],{"class":50},", panic, early ",[36,1040,232],{"class":42},[36,1042,1043],{"class":50},").\n",[36,1045,1046],{"class":38,"line":249},[36,1047,101],{"emptyLinePlaceholder":100},[36,1049,1050,1053,1055],{"class":38,"line":254},[36,1051,1052],{"class":50},"### ",[36,1054,1027],{"class":194},[36,1056,1057],{"class":50}," evaluates arguments immediately\n",[36,1059,1060],{"class":38,"line":274},[36,1061,101],{"emptyLinePlaceholder":100},[36,1063,1064,1066,1068,1070,1072,1074],{"class":38,"line":280},[36,1065,257],{"class":50},[36,1067,260],{"class":42},[36,1069,263],{"class":50},[36,1071,266],{"class":42},[36,1073,269],{"class":194},[36,1075,94],{"class":50},[36,1077,1078],{"class":38,"line":286},[36,1079,277],{"class":194},[36,1081,1082],{"class":38,"line":292},[36,1083,1084],{"class":194},"i := 1\n",[36,1086,1087],{"class":38,"line":301},[36,1088,1089],{"class":194},"defer fmt.Println(i)   \u002F\u002F prints 1 — i is evaluated now, not at defer time\n",[36,1091,1092],{"class":38,"line":307},[36,1093,1094],{"class":194},"i = 2\n",[36,1096,1098],{"class":38,"line":1097},24,[36,1099,1100],{"class":194},"\u002F\u002F function returns, defer runs, prints 1\n",[14,1102,312],{},[14,1104,1105,1106,1110],{},"To capture the ",[1107,1108,1109],"em",{},"current"," value at defer time, use a closure:",[27,1112,1114],{"className":29,"code":1113,"language":25,"meta":31,"style":31},"defer func() { fmt.Println(i) }()   \u002F\u002F prints 2 — i is read at defer-run time\n",[33,1115,1116],{"__ignoreMap":31},[36,1117,1118,1120,1122,1125,1128,1131],{"class":38,"line":39},[36,1119,321],{"class":42},[36,1121,541],{"class":42},[36,1123,1124],{"class":50},"() { fmt.",[36,1126,1127],{"class":46},"Println",[36,1129,1130],{"class":50},"(i) }()   ",[36,1132,1133],{"class":187},"\u002F\u002F prints 2 — i is read at defer-run time\n",[1135,1136,1138,1140],"h3",{"id":1137},"defer-and-named-returns",[33,1139,321],{}," and named returns",[14,1142,1143,1144,1146],{},"A ",[33,1145,321],{},"d function can modify named return values:",[23,1148,1149],{"language":25},[27,1150,1152],{"className":29,"code":1151,"language":25,"meta":31,"style":31},"func example() (result int) {\n    defer func() {\n        result *= 2   \u002F\u002F modifies the named return\n    }()\n    result = 5\n    return            \u002F\u002F returns 10 (defer ran, doubled it)\n}\n``\n",[33,1153,1154,1171,1180,1193,1198,1207,1214,1218],{"__ignoreMap":31},[36,1155,1156,1158,1161,1164,1167,1169],{"class":38,"line":39},[36,1157,43],{"class":42},[36,1159,1160],{"class":46}," example",[36,1162,1163],{"class":50},"() (",[36,1165,1166],{"class":54},"result",[36,1168,64],{"class":42},[36,1170,131],{"class":50},[36,1172,1173,1175,1177],{"class":38,"line":76},[36,1174,941],{"class":42},[36,1176,541],{"class":42},[36,1178,1179],{"class":50},"() {\n",[36,1181,1182,1185,1188,1190],{"class":38,"line":91},[36,1183,1184],{"class":50},"        result ",[36,1186,1187],{"class":42},"*=",[36,1189,681],{"class":175},[36,1191,1192],{"class":187},"   \u002F\u002F modifies the named return\n",[36,1194,1195],{"class":38,"line":97},[36,1196,1197],{"class":50},"    }()\n",[36,1199,1200,1202,1204],{"class":38,"line":104},[36,1201,735],{"class":50},[36,1203,266],{"class":42},[36,1205,1206],{"class":175}," 5\n",[36,1208,1209,1211],{"class":38,"line":134},[36,1210,79],{"class":42},[36,1212,1213],{"class":187},"            \u002F\u002F returns 10 (defer ran, doubled it)\n",[36,1215,1216],{"class":38,"line":152},[36,1217,94],{"class":50},[36,1219,1220],{"class":38,"line":157},[36,1221,195],{"class":194},[14,1223,1224,1225,1227],{},"This is the main legitimate use of named returns — wrapping\u002Ftransforming the return value in a ",[33,1226,321],{}," (e.g., logging, error decoration).",[18,1229,1231,1234],{"id":1230},"init-functions-recap",[33,1232,1233],{},"init"," Functions (recap)",[14,1236,1237,1240],{},[33,1238,1239],{},"init()"," runs automatically at package load. Covered in chapter 02 — avoid for general setup; reserve for unavoidable side effects.",[18,1242,1244],{"id":1243},"anonymous-functions-and-iifes","Anonymous Functions and IIFEs",[23,1246,1247,1953,1955,1958,2188,2191],{"language":25},[27,1248,1250],{"className":29,"code":1249,"language":25,"meta":31,"style":31},"\u002F\u002F Immediately-invoked function expression\nresult := func(x int) int {\n    return x * 2\n}(5)   \u002F\u002F 10\n``\n::\n\nGo has no `async`\u002F`await` — goroutines (chapter 16) are the concurrency primitive.\n\n## 💡 Tips & Tricks\n\n- **Idiom**: use `defer f.Close()` immediately after opening a resource — it guarantees cleanup regardless of how the function exits (return, early return, panic). Pair every `os.Open`\u002F`sql.Open`\u002F`os.Create` with a `defer` of the corresponding `Close`.\n- **Idiom**: use named return values when you need to modify them in a `defer` (e.g., error wrapping, timing) — this is the legitimate use case. For simple functions, unnamed returns + explicit `return x, y` are clearer than naked returns.\n- **Idiom**: use multiple return values for `(result, error)` — it's the Go convention. Functions that can fail return `(T, error)`; callers check `if err != nil` before using `T`. Don't return only `error` and a pointer out-param; the `(T, error)` form is idiomatic.\n- **Idiom**: use `defer` for cleanup in **reverse order** of acquisition — open file A, open file B, `defer b.Close()`, `defer a.Close()`. LIFO ensures B (opened last) is closed first, matching resource lifetimes.\n- **Debug**: `defer` arguments are evaluated at defer time, not at execution time — `defer fmt.Println(i)` prints the value of `i` when `defer` was called, not when it runs. To capture the later value, use a closure: `defer func() { fmt.Println(i) }()`.\n\n## ⚠️ Edge Cases & Gotchas\n\n- **`defer` in a loop**: `for ... { defer f.Close() }` accumulates deferred calls until the function returns — resources pile up. Close inside the loop, or refactor the loop body into a function.\n- **`defer` and loops + closures (1.22 fix)**: pre-1.22, `for i := 0; ... { defer func() { fmt.Println(i) }() }` printed the *final* value of `i` for all iterations (loop variable captured by reference). Go 1.22+ makes each iteration's loop variable distinct, fixing this. On older Go, pass `i` as an argument: `defer func(i int) { ... }(i)`.\n- **Naked returns in long functions**: `return` (no values) in a 100-line function with named returns is opaque — readers must scan for where the named returns were set. Use naked returns only in short functions.\n- **`defer` has a small overhead**: each `defer` has a tiny cost (function call + stack bookkeeping). In hot paths (millions of iterations), it can matter — Go 1.14+ optimized the common case (open-coded defer) to near-zero, but `defer` in a loop still adds up.\n- **Multiple returns must be fully received or discarded**: `f, err := os.Open(...)` — you must use both (or `_`). You can't receive only one of a multi-return: `f := os.Open(...)` is an error. Use `f, _ := ...` to discard explicitly.\n- **`...` spread requires a slice, not a single value**: `sum(nums...)` where `nums` is `[]int` works; `sum(5...)` doesn't. The `...` is the spread operator for variadic calls.\n- **Function types are distinct**: `func(int) int` and `func(int64) int` are different types — you can't assign one to the other. This matches Go's no-implicit-conversion rule.\n- **Closures capture by reference**: `for i := 0; i \u003C 3; i++ { go func() { fmt.Println(i) }() }` (pre-1.22) prints \"3 3 3\" — all goroutines see the final `i`. Pass `i` as an argument: `go func(i int) { ... }(i)`.\n- **`defer` doesn't run on `os.Exit`**: `os.Exit(n)` terminates immediately without running deferred functions. Don't call `os.Exit` inside a function with cleanup `defer`s — return an error and let `main` exit.\n\n## 🧠 Spot the Bug\n\nA developer opens files in a loop to process them, but runs out of file descriptors:\n\n::code-wrapper{language=\"go\"}\n```go\nfunc processFiles(paths []string) error {\n    for _, p := range paths {\n        f, err := os.Open(p)\n        if err != nil {\n            return err\n        }\n        defer f.Close()   \u002F\u002F ❌ deferred until processFiles returns\n        \u002F\u002F process f...\n    }\n    return nil\n}\n",[33,1251,1252,1257,1278,1289,1301,1305,1309,1313,1335,1339,1350,1354,1413,1458,1519,1559,1605,1609,1619,1623,1644,1712,1717,1722,1754,1800,1816,1822,1851,1856,1862,1867,1873,1878,1884,1889,1895,1901,1907,1913,1919,1925,1931,1937,1942,1948],{"__ignoreMap":31},[36,1253,1254],{"class":38,"line":39},[36,1255,1256],{"class":187},"\u002F\u002F Immediately-invoked function expression\n",[36,1258,1259,1262,1264,1266,1268,1270,1272,1274,1276],{"class":38,"line":76},[36,1260,1261],{"class":50},"result ",[36,1263,168],{"class":42},[36,1265,541],{"class":42},[36,1267,51],{"class":50},[36,1269,661],{"class":54},[36,1271,64],{"class":42},[36,1273,67],{"class":50},[36,1275,70],{"class":42},[36,1277,73],{"class":50},[36,1279,1280,1282,1284,1286],{"class":38,"line":91},[36,1281,79],{"class":42},[36,1283,675],{"class":50},[36,1285,678],{"class":42},[36,1287,1288],{"class":175}," 2\n",[36,1290,1291,1294,1296,1298],{"class":38,"line":97},[36,1292,1293],{"class":50},"}(",[36,1295,181],{"class":175},[36,1297,184],{"class":50},[36,1299,1300],{"class":187},"\u002F\u002F 10\n",[36,1302,1303],{"class":38,"line":104},[36,1304,195],{"class":194},[36,1306,1307],{"class":38,"line":134},[36,1308,201],{"class":50},[36,1310,1311],{"class":38,"line":152},[36,1312,101],{"emptyLinePlaceholder":100},[36,1314,1315,1318,1321,1323,1326,1329,1332],{"class":38,"line":157},[36,1316,1317],{"class":