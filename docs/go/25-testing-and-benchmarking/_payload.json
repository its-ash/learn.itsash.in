1,1653,1654],{"class":57},"    \u002F\u002F teardown (before os.Exit, or use defer with a wrapper)\n",[51,1656,1657],{"class":53,"line":126},[51,1658,285],{"class":88},[14,1660,1661,1664],{},[18,1662,1663],{},"TestMain"," runs once for the package — use for global setup (database, mocks).",[23,1666,1668],{"id":1667},"tips-tricks","💡 Tips & Tricks",[287,1670,1671,1690,1708,1717,1733],{},[290,1672,1673,1677,1678,1681,1682,1685,1686,1689],{},[1674,1675,1676],"strong",{},"Idiom",": use table-driven tests — define cases as a slice of structs, loop with ",[18,1679,1680],{},"t.Run(name, ...)",". This is the universal Go pattern: easy to add cases, each runs as a named subtest (",[18,1683,1684],{},"go test -v"," shows each, ",[18,1687,1688],{},"-run"," selects one), and the table documents the function's behavior.",[290,1691,1692,1694,1695,1697,1698,1700,1701,1703,1704,1707],{},[1674,1693,1676],{},": use ",[18,1696,294],{}," (continue) for non-fatal assertion failures and ",[18,1699,300],{}," (stop) for fatal setup failures — ",[18,1702,254],{}," lets you see all failures in one run; ",[18,1705,1706],{},"Fatalf"," stops when setup is broken and further assertions would be meaningless.",[290,1709,1710,1694,1712,1586,1714,1716],{},[1674,1711,1676],{},[18,1713,1585],{},[18,1715,1589],{}," to test HTTP handlers without a server — construct a request, pass to the handler, inspect the recorder. Faster and more isolated than starting a real server.",[290,1718,1719,1694,1721,1723,1724,1726,1727,1729,1730,1732],{},[1674,1720,1676],{},[18,1722,1093],{}," after setup in benchmarks — without it, setup time counts toward the benchmark, skewing ",[18,1725,976],{},". ",[18,1728,1097],{}," (or ",[18,1731,988],{},") shows allocations, the key metric for optimization.",[290,1734,1735,1737,1738,1586,1741,1744,1745,1748,1749,1752],{},[1674,1736,1676],{},": use fuzzing (",[18,1739,1740],{},"FuzzXxx",[18,1742,1743],{},"go test -fuzz=...",") to find panics and edge cases — random inputs surface bugs that hand-written tests miss. Seed with ",[18,1746,1747],{},"f.Add(known inputs)"," for a starting corpus; failures are saved to ",[18,1750,1751],{},"testdata\u002F"," as regression tests.",[23,1754,1756],{"id":1755},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[287,1758,1759,1784,1804,1815,1830,1845,1858,1870,1885,1901],{},[290,1760,1761,1771,1772,1775,1776,1779,1780,1783],{},[1674,1762,1763,1764,1767,1768],{},"Test files use ",[18,1765,1766],{},"package X"," or ",[18,1769,1770],{},"package X_test",": ",[18,1773,1774],{},"package math"," (internal test — can access unexported) or ",[18,1777,1778],{},"package math_test"," (external test — imports ",[18,1781,1782],{},"math"," like an external package, only exported). Use external tests for testing the public API.",[290,1785,1786,1771,1793,1796,1797,1800,1801,1803],{},[1674,1787,1788,1789,1792],{},"Loop variable capture in ",[18,1790,1791],{},"t.Run"," (pre-1.22)",[18,1794,1795],{},"for _, tt := range tests { t.Run(tt.name, func(t *testing.T) { use(tt) }) }"," — pre-1.22, all subtests see the final ",[18,1798,1799],{},"tt",". Fix with ",[18,1802,780],{},". 1.22+ fixes this.",[290,1805,1806,1771,1812,1814],{},[1674,1807,1808,1811],{},[18,1809,1810],{},"t.Parallel"," must be called early",[18,1813,316],{}," signals parallelism; it should be the first line in the subtest. Tests that call it after doing work may not run in parallel.",[290,1816,1817,1823,1824,1826,1827,188],{},[1674,1818,1819,1820,1822],{},"Benchmark ",[18,1821,868],{}," is auto-adjusted",": don't assume ",[18,1825,868],{}," is a specific value — the framework increases it until the run takes ~1s. Write ",[18,1828,1829],{},"for i := 0; i \u003C b.N; i++",[290,1831,1832,1837,1838,1841,1842,1844],{},[1674,1833,1834,1835],{},"Benchmark setup counted without ",[18,1836,1046],{},": setup outside the ",[18,1839,1840],{},"for"," loop is included in timing. Call ",[18,1843,1093],{}," after setup.",[290,1846,1847,1850,1851,1854,1855,1857],{},[1674,1848,1849],{},"Benchmark loops must not be optimized away",": if the loop body's result is unused, the compiler may optimize it out, giving misleadingly fast results. Assign to a package-level ",[18,1852,1853],{},"var"," or use ",[18,1856,868],{},"-dependent logic to prevent dead-code elimination.",[290,1859,1860,1865,1866,1869],{},[1674,1861,1862,1864],{},[18,1863,20],{}," caches passing tests",": Go caches test results by inputs (files, env). ",[18,1867,1868],{},"go test -count=1"," disables caching (forces rerun). Useful when you've changed something the cache doesn't track.",[290,1871,1872,1877,1878,1880,1881,1884],{},[1674,1873,1874,1875],{},"Fuzz failures saved to ",[18,1876,1751],{},": these become regular tests — ",[18,1879,20],{}," runs them. Don't delete ",[18,1882,1883],{},"testdata\u002Ffuzz\u002F"," unless you've fixed the bug.",[290,1886,1887,1893,1894,1896,1897,1900],{},[1674,1888,1889,1892],{},[18,1890,1891],{},"ExampleXxx"," output must match exactly",": trailing whitespace, capitalization — the ",[18,1895,1433],{}," line is compared exactly. Use ",[18,1898,1899],{},"\u002F\u002F Unordered output:"," for any-order lines.",[290,1902,1903,1911,1912,188],{},[1674,1904,1905,1907,1908],{},[18,1906,306],{}," vs ",[18,1909,1910],{},"t.Skipf",": skip the test with a reason. Common for tests requiring a database\u002Fenv: ",[18,1913,1914],{},"if os.Getenv(\"DB_TEST\") == \"\" { t.Skip(\"set DB_TEST=1 to run\") }",[23,1916,1918],{"id":1917},"spot-the-bug","🧠 Spot the Bug",[14,1920,1921],{},"A benchmark shows 0 ns\u002Fop — impossibly fast:",[39,1923,1924],{"language":41},[43,1925,1927],{"className":45,"code":1926,"language":41,"meta":47,"style":47},"func BenchmarkSum(b *testing.B) {\n    var nums []int\n    for i := 0; i \u003C 1000; i++ {\n        nums = append(nums, i)\n    }\n    for i := 0; i \u003C b.N; i++ {\n        Sum(nums)\n    }\n}\n",[18,1928,1929,1950,1960,1984,1997,2001,2021,2029,2033],{"__ignoreMap":47},[51,1930,1931,1933,1936,1938,1940,1942,1944,1946,1948],{"class":53,"line":54},[51,1932,82],{"class":64},[51,1934,1935],{"class":68}," BenchmarkSum",[51,1937,89],{"class":88},[51,1939,99],{"class":92},[51,1941,183],{"class":64},[51,1943,159],{"class":68},[51,1945,188],{"class":88},[51,1947,812],{"class":68},[51,1949,194],{"class":88},[51,1951,1952,1955,1958],{"class":53,"line":61},[51,1953,1954],{"class":64},"    var",[51,1956,1957],{"class":88}," nums []",[51,1959,383],{"class":64},[51,1961,1962,1964,1966,1968,1970,1972,1974,1977,1980,1982],{"class":53,"line":72},[51,1963,502],{"class":64},[51,1965,821],{"class":88},[51,1967,203],{"class":64},[51,1969,826],{"class":210},[51,1971,829],{"class":88},[51,1973,832],{"class":64},[51,1975,1976],{"class":210}," 1000",[51,1978,1979],{"class":88},"; i",[51,1981,838],{"class":64},[51,1983,367],{"class":88},[51,1985,1986,1989,1991,1994],{"class":53,"line":79},[51,1987,1988],{"class":88},"        nums ",[51,1990,704],{"class":64},[51,1992,1993],{"class":68}," append",[51,1995,1996],{"class":88},"(nums, i)\n",[51,1998,1999],{"class":53,"line":126},[51,2000,279],{"class":88},[51,2002,2003,2005,2007,2009,2011,2013,2015,2017,2019],{"class":53,"line":131},[51,2004,502],{"class":64},[51,2006,821],{"class":88},[51,2008,203],{"class":64},[51,2010,826],{"class":210},[51,2012,829],{"class":88},[51,2014,832],{"class":64},[51,2016,835],{"class":88},[51,2018,838],{"class":64},[51,2020,367],{"class":88},[51,2022,2023,2026],{"class":53,"line":137},[51,2024,2025],{"class":68},"        Sum",[51,2027,2028],{"class":88},"(nums)\n",[51,2030,2031],{"class":53,"line":144},[51,2032,279],{"class":88},[51,2034,2035],{"class":53,"line":149},[51,2036,285],{"class":88},[14,2038,2039],{},"What's likely happening?",[2041,2042,2043,2047,2054,2057,2185,2188,2299,2302],"details",{},[2044,2045,2046],"summary",{},"Answer",[14,2048,2049,2050,2053],{},"The compiler is optimizing away the call to ",[18,2051,2052],{},"Sum(nums)"," because its result is unused — dead-code elimination removes it, so the benchmark measures nothing (0 ns\u002Fop).",[14,2055,2056],{},"The fix — prevent the optimizer from removing the call by using the result:",[43,2058,2060],{"className":45,"code":2059,"language":41,"meta":47,"style":47},"func BenchmarkSum(b *testing.B) {\n    nums := make([]int, 1000)\n    for i := range nums { nums[i] = i }\n    var result int   \u002F\u002F package-level or function-local sink\n    for i := 0; i \u003C b.N; i++ {\n        result = Sum(nums)\n    }\n    _ = result   \u002F\u002F ensure the result is \"used\"\n}\n",[18,2061,2062,2082,2104,2122,2133,2153,2164,2168,2181],{"__ignoreMap":47},[51,2063,2064,2066,2068,2070,2072,2074,2076,2078,2080],{"class":53,"line":54},[51,2065,82],{"class":64},[51,2067,1935],{"class":68},[51,2069,89],{"class":88},[51,2071,99],{"class":92},[51,2073,183],{"class":64},[51,2075,159],{"class":68},[51,2077,188],{"class":88},[51,2079,812],{"class":68},[51,2081,194],{"class":88},[51,2083,2084,2087,2089,2092,2095,2097,2099,2102],{"class":53,"line":61},[51,2085,2086],{"class":88},"    nums ",[51,2088,203],{"class":64},[51,2090,2091],{"class":68}," make",[51,2093,2094],{"class":88},"([]",[51,2096,108],{"class":64},[51,2098,96],{"class":88},[51,2100,2101],{"class":210},"1000",[51,2103,219],{"class":88},[51,2105,2106,2108,2110,2112,2114,2117,2119],{"class":53,"line":72},[51,2107,502],{"class":64},[51,2109,821],{"class":88},[51,2111,203],{"class":64},[51,2113,510],{"class":64},[51,2115,2116],{"class":88}," nums { nums[i] ",[51,2118,704],{"class":64},[51,2120,2121],{"class":88}," i }\n",[51,2123,2124,2126,2128,2130],{"class":53,"line":79},[51,2125,1954],{"class":64},[51,2127,1235],{"class":88},[51,2129,108],{"class":64},[51,2131,2132],{"class":57},"   \u002F\u002F package-level or function-local sink\n",[51,2134,2135,2137,2139,2141,2143,2145,2147,2149,2151],{"class":53,"line":126},[51,2136,502],{"class":64},[51,2138,821],{"class":88},[51,2140,203],{"class":64},[51,2142,826],{"class":210},[51,2144,829],{"class":88},[51,2146,832],{"class":64},[51,2148,835],{"class":88},[51,2150,838],{"class":64},[51,2152,367],{"class":88},[51,2154,2155,2157,2159,2162],{"class":53,"line":131},[51,2156,1215],{"class":88},[51,2158,704],{"class":64},[51,2160,2161],{"class":68}," Sum",[51,2163,2028],{"class":88},[51,2165,2166],{"class":53,"line":137},[51,2167,279],{"class":88},[51,2169,2170,2173,2175,2178],{"class":53,"line":144},[51,2171,2172],{"class":88},"    _ ",[51,2174,704],{"class":64},[51,2176,2177],{"class":88}," result   ",[51,2179,2180],{"class":57},"\u002F\u002F ensure the result is \"used\"\n",[51,2182,2183],{"class":53,"line":149},[51,2184,285],{"class":88},[14,2186,2187],{},"Or assign to a package-level var:",[43,2189,2191],{"className":45,"code":2190,"language":41,"meta":47,"style":47},"var sink int\n\nfunc BenchmarkSum(b *testing.B) {\n    nums := make([]int, 1000)\n    for i := range nums { nums[i] = i }\n    for i := 0; i \u003C b.N; i++ {\n        sink = Sum(nums)\n    }\n}\n",[18,2192,2193,2202,2206,2226,2244,2260,2280,2291,2295],{"__ignoreMap":47},[51,2194,2195,2197,2200],{"class":53,"line":54},[51,2196,1853],{"class":64},[51,2198,2199],{"class":88}," sink ",[51,2201,383],{"class":64},[51,2203,2204],{"class":53,"line":61},[51,2205,76],{"emptyLinePlaceholder":75},[51,2207,2208,2210,2212,2214,2216,2218,2220,2222,2224],{"class":53,"line":72},[51,2209,82],{"class":64},[51,2211,1935],{"class":68},[51,2213,89],{"class":88},[51,2215,99],{"class":92},[51,2217,183],{"class":64},[51,2219,159],{"class":68},[51,2221,188],{"class":88},[51,2223,812],{"class":68},[51,2225,194],{"class":88},[51,2227,2228,2230,2232,2234,2236,2238,2240,2242],{"class":53,"line":79},[51,2229,2086],{"class":88},[51,2231,203],{"class":64},[51,2233,2091],{"class":68},[51,2235,2094],{"class":88},[51,2237,108],{"class":64},[51,2239,96],{"class":88},[51,2241,2101],{"class":210},[51,2243,219],{"class":88},[51,2245,2246,2248,2250,2252,2254,2256,2258],{"class":53,"line":126},[51,2247,502],{"class":64},[51,2249,821],{"class":88},[51,2251,203],{"class":64},[51,2253,510],{"class":64},[51,2255,2116],{"class":88},[51,2257,704],{"class":64},[51,2259,2121],{"class":88},[51,2261,2262,2264,2266,2268,2270,2272,2274,2276,2278],{"class":53,"line":131},[51,2263,502],{"class":64},[51,2265,821],{"class":88},[51,2267,203],{"class":64},[51,2269,826],{"class":210},[51,2271,829],{"class":88},[51,2273,832],{"class":64},[51,2275,835],{"class":88},[51,2277,838],{"class":64},[51,2279,367],{"class":88},[51,2281,2282,2285,2287,2289],{"class":53,"line":137},[51,2283,2284],{"class":88},"        sink ",[51,2286,704],{"class":64},[51,2288,2161],{"class":68},[51,2290,2028],{"class":88},[51,2292,2293],{"class":53,"line":144},[51,2294,279],{"class":88},[51,2296,2297],{"class":53,"line":149},[51,2298,285],{"class":88},[14,2300,2301],{},"The \"sink\" pattern (assigning to a package-level var or a local that's \"used\") prevents dead-code elimination, so the benchmark measures the real cost.",[14,2303,2304,2307],{},[1674,2305,2306],{},"The lesson",": if a benchmark's result is unused, the compiler may optimize it away, giving misleadingly fast results. Assign the result to a package-level var (a \"sink\") to prevent elimination.",[23,2309,2310],{"id":2044},"Summary",[14,2312,2313,2314,2317,2318,2320,2321,2323,2324,2323,2326,2323,2328,2330,2331,2334,2335,2323,2337,2323,2339,2342,2343,2345,2346,2348],{},"You can now write tests (",[18,2315,2316],{},"TestXxx",", table-driven with ",[18,2319,1791],{},"), use ",[18,2322,1810],{},"\u002F",[18,2325,306],{},[18,2327,294],{},[18,2329,300],{},", benchmark (",[18,2332,2333],{},"BenchmarkXxx"," with ",[18,2336,868],{},[18,2338,1046],{},[18,2340,2341],{},"ReportAllocs","), fuzz (",[18,2344,1740],{},"), write example tests, and test HTTP handlers with ",[18,2347,1444],{}," — while avoiding the loop-variable-capture and optimizer-eliminates-the-benchmark traps. Next: concurrency patterns.",[2350,2351,2352],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}",{"title":47,"searchDepth":61,"depth":61,"links":2354},[2355,2356,2357],{"id":25,"depth":61,"text":26},{"id":320,"depth":61,"text":321},{"id":784,"depth":61,"text":785},"Go has testing built into the toolchain (go test), with benchmarks, fuzzing, and example functions. No external framework needed for the basics.","md",{},"\u002Fgo\u002F25-testing-and-benchmarking",{"title":5,"description":2358},"go\u002F25-testing-and-benchmarking","mKZL1kpmlapqb63fffvLGaekw5P5ULIjqLe4FnRADxg",1786908610234]