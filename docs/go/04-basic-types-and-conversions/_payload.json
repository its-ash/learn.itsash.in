ytes.Contains",", or ",[49,1673,1674],{},"strings.Builder"," to work in-place. For zero-copy (advanced), ",[49,1677,1565],{},[49,1679,1568],{}," (Go 1.20+) — but use only when you understand the safety implications.",[14,1682,1684],{"id":1683},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1579,1686,1687,1703,1716,1733,1745,1759,1772,1784,1798,1817],{},[1582,1688,1689,813,1695,1698,1699,1702],{},[43,1690,1691,1694],{},[49,1692,1693],{},"len(s)"," is bytes, not characters",[49,1696,1697],{},"len(\"世\")"," = 3, not 1. Use ",[49,1700,1701],{},"utf8.RuneCountInString(s)"," for the character count.",[1582,1704,1705,1710,1711,632,1713,1715],{},[43,1706,1707,1709],{},[49,1708,1614],{}," is a byte, not a character",": indexing a multi-byte UTF-8 string at an arbitrary position may give a byte in the middle of a rune (invalid UTF-8). Use ",[49,1712,1610],{},[49,1714,1153],{}," for character access.",[1582,1717,1718,1721,1722,1725,1726,1729,1730,1732],{},[43,1719,1720],{},"Integer overflow wraps silently",": no panic, no error — ",[49,1723,1724],{},"byte(255) + 1"," = 0. Use ",[49,1727,1728],{},"math\u002Fbits"," for overflow-checking operations, or ",[49,1731,514],{}," for arbitrary precision.",[1582,1734,1735,813,1738,1741,1742,1744],{},[43,1736,1737],{},"Floating-point is inexact",[49,1739,1740],{},"0.1 + 0.2 ≠ 0.3",". Use ",[49,1743,514],{}," or a decimal library for money.",[1582,1746,1747,813,1753,1755,1756,1758],{},[43,1748,1749,1752],{},[49,1750,1751],{},"string(int)"," gives a code point, not digits",[49,1754,1636],{}," = \"A\". Use ",[49,1757,1622],{}," for digits.",[1582,1760,1761,813,1764,632,1766,1768,1769,1771],{},[43,1762,1763],{},"No truthiness",[49,1765,631],{},[49,1767,635],{}," are compile errors — only ",[49,1770,543],{}," is allowed in conditions. This prevents \"truthy\u002Ffalsy\" bugs.",[1582,1773,1774,813,1777,1780,1781,1783],{},[43,1775,1776],{},"Strings are immutable",[49,1778,1779],{},"s[0] = 'x'"," is a compile error. Convert to ",[49,1782,1157],{},", modify, convert back (allocates).",[1582,1785,1786,1791,1792,1794,1795,1797],{},[43,1787,1788,1790],{},[49,1789,51],{}," size is platform-dependent",": 32 bits on 32-bit systems, 64 on 64-bit. Don't assume ",[49,1793,51],{}," is 64 bits — use ",[49,1796,65],{}," if you need a guaranteed size.",[1582,1799,1800,813,1807,1809,1810,56,1812,1809,1814,1816],{},[43,1801,1802,1558,1804,1806],{},[49,1803,135],{},[49,1805,142],{}," are aliases",[49,1808,135],{}," = ",[49,1811,81],{},[49,1813,142],{},[49,1815,62],{},". They're interchangeable with their underlying types, but using the alias is clearer for intent.",[1582,1818,1819,813,1822,1825,1826,1829,1830,1833],{},[43,1820,1821],{},"Truncating conversions",[49,1823,1824],{},"int(3.9)"," = 3 (truncates toward zero, not rounding). ",[49,1827,1828],{},"byte(300)"," = 44 (wraps). Use ",[49,1831,1832],{},"math.Round"," for rounding, and check bounds before narrowing conversions.",[14,1835,1837],{"id":1836},"spot-the-bug","🧠 Spot the Bug",[263,1839,1840],{},"A developer wants to reverse a string \"Hello, 世界\" and writes:",[147,1842,1843],{"language":149},[151,1844,1846],{"className":153,"code":1845,"language":149,"meta":155,"style":155},"func reverse(s string) string {\n    b := []byte(s)\n    for i, j := 0, len(b)-1; i \u003C j; i, j = i+1, j-1 {\n        b[i], b[j] = b[j], b[i]\n    }\n    return string(b)\n}\nfmt.Println(reverse(\"Hello, 世界\"))   \u002F\u002F garbled output\n",[49,1847,1848,1871,1885,1938,1948,1953,1963,1967],{"__ignoreMap":155},[159,1849,1850,1853,1856,1858,1862,1864,1866,1868],{"class":161,"line":162},[159,1851,1852],{"class":165},"func",[159,1854,1855],{"class":369}," reverse",[159,1857,675],{"class":169},[159,1859,1861],{"class":1860},"sCrzJ","s",[159,1863,1141],{"class":165},[159,1865,390],{"class":169},[159,1867,889],{"class":165},[159,1869,1870],{"class":169}," {\n",[159,1872,1873,1876,1878,1880,1882],{"class":161,"line":182},[159,1874,1875],{"class":169},"    b ",[159,1877,568],{"class":165},[159,1879,1119],{"class":169},[159,1881,135],{"class":165},[159,1883,1884],{"class":169},"(s)\n",[159,1886,1887,1890,1893,1895,1898,1900,1902,1905,1907,1910,1913,1916,1919,1921,1924,1927,1929,1932,1934,1936],{"class":161,"line":196},[159,1888,1889],{"class":165},"    for",[159,1891,1892],{"class":169}," i, j ",[159,1894,568],{"class":165},[159,1896,1897],{"class":178}," 0",[159,1899,56],{"class":169},[159,1901,678],{"class":369},[159,1903,1904],{"class":169},"(b)",[159,1906,376],{"class":165},[159,1908,1909],{"class":178},"1",[159,1911,1912],{"class":169},"; i ",[159,1914,1915],{"class":165},"\u003C",[159,1917,1918],{"class":169}," j; i, j ",[159,1920,479],{"class":165},[159,1922,1923],{"class":169}," i",[159,1925,1926],{"class":165},"+",[159,1928,1909],{"class":178},[159,1930,1931],{"class":169},", j",[159,1933,376],{"class":165},[159,1935,1909],{"class":178},[159,1937,1870],{"class":169},[159,1939,1940,1943,1945],{"class":161,"line":211},[159,1941,1942],{"class":169},"        b[i], b[j] ",[159,1944,479],{"class":165},[159,1946,1947],{"class":169}," b[j], b[i]\n",[159,1949,1950],{"class":161,"line":237},[159,1951,1952],{"class":169},"    }\n",[159,1954,1955,1958,1960],{"class":161,"line":344},[159,1956,1957],{"class":165},"    return",[159,1959,1141],{"class":165},[159,1961,1962],{"class":169},"(b)\n",[159,1964,1965],{"class":161,"line":350},[159,1966,485],{"class":169},[159,1968,1969,1971,1973,1975,1978,1980,1982,1985],{"class":161,"line":357},[159,1970,669],{"class":169},[159,1972,672],{"class":369},[159,1974,675],{"class":169},[159,1976,1977],{"class":369},"reverse",[159,1979,675],{"class":169},[159,1981,1126],{"class":223},[159,1983,1984],{"class":169},"))   ",[159,1986,1987],{"class":233},"\u002F\u002F garbled output\n",[263,1989,1990],{},"What's wrong?",[1992,1993,1994,1998,2006,2012,2137,2147],"details",{},[1995,1996,1997],"summary",{},"Answer",[263,1999,2000,2002,2003,2005],{},[49,2001,1557],{}," reverses the ",[43,2004,1572],{},", not the characters. Multi-byte UTF-8 runes (like \"世\" = 3 bytes, \"界\" = 3 bytes) get their bytes reversed individually, producing invalid UTF-8 — the output is garbled.",[263,2007,2008,2009,2011],{},"The fix — reverse ",[43,2010,1016],{},", not bytes:",[151,2013,2015],{"className":153,"code":2014,"language":149,"meta":155,"style":155},"func reverse(s string) string {\n    r := []rune(s)\n    for i, j := 0, len(r)-1; i \u003C j; i, j = i+1, j-1 {\n        r[i], r[j] = r[j], r[i]\n    }\n    return string(r)\n}\nfmt.Println(reverse(\"Hello, 世界\"))   \u002F\u002F \"界世 ,olleH\"\n",[49,2016,2017,2035,2048,2091,2101,2105,2114,2118],{"__ignoreMap":155},[159,2018,2019,2021,2023,2025,2027,2029,2031,2033],{"class":161,"line":162},[159,2020,1852],{"class":165},[159,2022,1855],{"class":369},[159,2024,675],{"class":169},[159,2026,1861],{"class":1860},[159,2028,1141],{"class":165},[159,2030,390],{"class":169},[159,2032,889],{"class":165},[159,2034,1870],{"class":169},[159,2036,2037,2040,2042,2044,2046],{"class":161,"line":182},[159,2038,2039],{"class":169},"    r ",[159,2041,568],{"class":165},[159,2043,1119],{"class":169},[159,2045,142],{"class":165},[159,2047,1884],{"class":169},[159,2049,2050,2052,2054,2056,2058,2060,2062,2065,2067,2069,2071,2073,2075,2077,2079,2081,2083,2085,2087,2089],{"class":161,"line":196},[159,2051,1889],{"class":165},[159,2053,1892],{"class":169},[159,2055,568],{"class":165},[159,2057,1897],{"class":178},[159,2059,56],{"class":169},[159,2061,678],{"class":369},[159,2063,2064],{"class":169},"(r)",[159,2066,376],{"class":165},[159,2068,1909],{"class":178},[159,2070,1912],{"class":169},[159,2072,1915],{"class":165},[159,2074,1918],{"class":169},[159,2076,479],{"class":165},[159,2078,1923],{"class":169},[159,2080,1926],{"class":165},[159,2082,1909],{"class":178},[159,2084,1931],{"class":169},[159,2086,376],{"class":165},[159,2088,1909],{"class":178},[159,2090,1870],{"class":169},[159,2092,2093,2096,2098],{"class":161,"line":211},[159,2094,2095],{"class":169},"        r[i], r[j] ",[