dth fields).",[251,278,280],{"id":279},"integer-overflow","Integer overflow",[263,282,283],{},"Integer arithmetic wraps silently (no panic):",[147,285,286],{"language":149},[151,287,289],{"className":153,"code":288,"language":149,"meta":155,"style":155},"var b byte = 255\nb++   \u002F\u002F 0 (wrapped)\nvar i int8 = 127\ni++   \u002F\u002F -128 (wrapped)\n``\n::\n\nThe `math\u002Fbits` package provides overflow-detecting operations (`bits.Add`, `bits.Mul`) for critical code. For arbitrary precision, use `math\u002Fbig`.\n\n### Floating-point\n\n`float64` is the default (and the type of float literals). `float32` is rarely used (smaller, less precision). Floating-point has the usual IEEE 754 issues:\n\n::code-wrapper{language=\"go\"}\n```go\nfmt.Println(0.1 + 0.2)   \u002F\u002F 0.30000000000000004\nfmt.Println(1.0 \u002F 3.0)   \u002F\u002F 0.3333333333333333\n``\n",[49,290,291,303,314,327,337,342,348,355,403,408,419,424,461,466,486,492,498,504],{"__ignoreMap":155},[159,292,293,295,297,299,301],{"class":161,"line":162},[159,294,166],{"class":165},[159,296,201],{"class":169},[159,298,135],{"class":165},[159,300,175],{"class":165},[159,302,208],{"class":178},[159,304,305,308,311],{"class":161,"line":182},[159,306,307],{"class":169},"b",[159,309,310],{"class":165},"++",[159,312,313],{"class":233},"   \u002F\u002F 0 (wrapped)\n",[159,315,316,318,320,322,324],{"class":161,"line":196},[159,317,166],{"class":165},[159,319,170],{"class":169},[159,321,55],{"class":165},[159,323,175],{"class":165},[159,325,326],{"class":178}," 127\n",[159,328,329,332,334],{"class":161,"line":211},[159,330,331],{"class":169},"i",[159,333,310],{"class":165},[159,335,336],{"class":233},"   \u002F\u002F -128 (wrapped)\n",[159,338,339],{"class":161,"line":237},[159,340,341],{"class":223},"``\n",[159,343,345],{"class":161,"line":344},6,[159,346,347],{"class":169},"::\n",[159,349,351],{"class":161,"line":350},7,[159,352,354],{"emptyLinePlaceholder":353},true,"\n",[159,356,358,361,364,367,371,374,377