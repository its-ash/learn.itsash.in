1,242],{"class":49},[43,553,554],{"class":150}," `Wait()`",[43,556,557],{"class":53}," — block until the counter is ",[43,559,560],{"class":410},"0.\n",[43,562,563],{"class":45,"line":213},[43,564,91],{"emptyLinePlaceholder":90},[43,566,567,569,572,575,578,580,583,586,589,591,594,596],{"class":45,"line":231},[43,568,174],{"class":49},[43,570,571],{"class":53},"Always ",[43,573,574],{"class":150},"`Add`",[43,576,577],{"class":53}," before starting the goroutine",[43,579,174],{"class":49},[43,581,582],{"class":53}," (not inside it — a race with ",[43,584,585],{"class":150},"`Wait`",[43,587,588],{"class":53},"). ",[43,590,174],{"class":49},[43,592,593],{"class":150},"`defer wg.Done()`",[43,595,174],{"class":49},[43,597,598],{"class":53}," ensures it runs even on panic.\n",[43,600,601],{"class":45,"line":236},[43,602,91],{"emptyLinePlaceholder":90},[43,604,605,608,611,614,616],{"class":45,"line":256},[43,606,607],{"class":53},"## ",[43,609,610],{"class":150},"`sync.Once`",[43,612,613],{"class":53}," — One",[43,615,242],{"class":49},[43,617,618],{"class":53},"Time Initialization\n",[43,620,621],{"class":45,"line":262},[43,622,91],{"emptyLinePlaceholder":90},[43,624,625,627,629,631,633,635],{"class":45,"line":268},[43,626,239],{"class":53},[43,628,242],{"class":49},[43,630,245],{"class":53},[43,632,248],{"class":49},[43,634,251],{"class":150},[43,636,144],{"class":53},[43,638,639],{"class":45,"line":274},[43,640,259],{"class":150},[43,642,643],{"class":45,"line":280},[43,644,265],{"class":150},[43,646,647],{"class":45,"line":285},[43,648,649],{"class":150},"    once sync.Once\n",[43,651,652],{"class":45,"line":290},[43,653,654],{"class":150},"    conn *Connection\n",[43,656,657],{"class":45,"line":296},[43,658,84],{"class":150},[43,660,661],{"class":45,"line":302},[43,662,91],{"emptyLinePlaceholder":90},[43,664,665],{"class":45,"line":308},[43,666,667],{"class":150},"func getConnection() *Connection {\n",[43,669,670],{"class":45,"line":314},[43,671,672],{"class":150},"   