[{"data":1,"prerenderedAt":2061},["ShallowReactive",2],{"page-\u002Fgo\u002F19-sync-package":3},{"id":4,"title":5,"body":6,"description":2054,"extension":2055,"meta":2056,"navigation":90,"path":2057,"seo":2058,"stem":2059,"__hash__":2060},"content\u002Fgo\u002F19-sync-package.md","19 — sync Package",{"type":7,"value":8,"toc":2043},"minimark",[9,13,22,30,356,369,376,696,706,713,1098,1121,1128,2039],[10,11,5],"h1",{"id":12},"_19-sync-package",[14,15,16,17,21],"p",{},"Channels are great for \"communicate by sharing,\" but sometimes you need lower-level primitives: mutexes, wait groups, once. The ",[18,19,20],"code",{},"sync"," package provides them.",[23,24,26,29],"h2",{"id":25},"syncmutex-mutual-exclusion",[18,27,28],{},"sync.Mutex"," — Mutual Exclusion",[31,32,34],"code-wrapper",{"language":33},"go",[35,36,40],"pre",{"className":37,"code":38,"language":33,"meta":39,"style":39},"language-go shiki shiki-themes github-light github-dark","var (\n    mu    sync.Mutex\n    count int\n)\n\nfunc increment() {\n    mu.Lock()\n    defer mu.Unlock()\n    count++\n}\n``\n::\n\n`Mutex` ensures only one goroutine is in the critical section at a time. **Always pair `Lock` with `Unlock` (use `defer`)** — a missing `Unlock` deadlocks.\n\n### `sync.RWMutex` — Reader\u002FWriter Lock\n\n::code-wrapper{language=\"go\"}\n```go\nvar (\n    rw    sync.RWMutex\n    cache map[string]string\n)\n\nfunc get(key string) string {\n    rw.RLock()\n    defer rw.RUnlock()\n    return cache[key]\n}\n\nfunc set(key, value string) {\n    rw.Lock()\n    defer rw.Unlock()\n    cache[key] = value\n}\n``\n","",[18,41,42,55,70,79,85,92,104,116,130,139,145,152,158,163,206,211,229,234,254,260,266,272,278,283,288,294,300,306,312,317,322,328,334,340,346,351],{"__ignoreMap":39},[43,44,47,51],"span",{"class":45,"line":46},"line",1,[43,48,50],{"class":49},"svdQ7","var",[43,52,54],{"class":53},"ssxIu"," (\n",[43,56,58,61,64,67],{"class":45,"line":57},2,[43,59,60],{"class":53},"    mu    ",[43,62,20],{"class":63},"sIsaT",[43,65,66],{"class":53},".",[43,68,69],{"class":63},"Mutex\n",[43,71,73,76],{"class":45,"line":72},3,[43,74,75],{"class":53},"    count ",[43,77,78],{"class":49},"int\n",[43,80,82],{"class":45,"line":81},4,[43,83,84],{"class":53},")\n",[43,86,88],{"class":45,"line":87},5,[43,89,91],{"emptyLinePlaceholder":90},true,"\n",[43,93,95,98,101],{"class":45,"line":94},6,[43,96,97],{"class":49},"func",[43,99,100],{"class":63}," increment",[43,102,103],{"class":53},"() {\n",[43,105,107,110,113],{"class":45,"line":106},7,[43,108,109],{"class":53},"    mu.",[43,111,112],{"class":63},"Lock",[43,114,115],{"class":53},"()\n",[43,117,119,122,125,128],{"class":45,"line":118},8,[43,120,121],{"class":49},"    defer",[43,123,124],{"class":53}," mu.",[43,126,127],{"class":63},"Unlock",[43,129,115],{"class":53},[43,131,133,136],{"class":45,"line":132},9,[43,134,135],{"class":53},"    count",[43,137,138],{"class":49},"++\n",[43,140,142],{"class":45,"line":141},10,[43,143,144],{"class":53},"}\n",[43,146,148],{"class":45,"line":147},11,[43,149,151],{"class":150},"sJ6F3","``\n",[43,153,155],{"class":45,"line":154},12,[43,156,157],{"class":53},"::\n",[43,159,161],{"class":45,"line":160},13,[43,162,91],{"emptyLinePlaceholder":90},[43,164,166,169,172,175,178,181,184,187,190,193,196,198,201,203],{"class":45,"line":165},14,[43,167,168],{"class":150},"`Mutex`",[43,170,171],{"class":53}," ensures only one goroutine is in the critical section at a time. ",[43,173,174],{"class":49},"**",[43,176,177],{"class":53},"Always pair ",[43,179,180],{"class":150},"`Lock`",[43,182,183],{"class":53}," with ",[43,185,186],{"class":150},"`Unlock`",[43,188,189],{"class":53}," (use ",[43,191,192],{"class":150},"`defer`",[43,194,195],{"class":53},")",[43,197,174],{"class":49},[43,199,200],{"class":53}," — a missing ",[43,202,186],{"class":150},[43,204,205],{"class":53}," deadlocks.\n",[43,207,209],{"class":45,"line":208},15,[43,210,91],{"emptyLinePlaceholder":90},[43,212,214,217,220,223,226],{"class":45,"line":213},16,[43,215,216],{"class":53},"### ",[43,218,219],{"class":150},"`sync.RWMutex`",[43,221,222],{"class":53}," — Reader",[43,224,225],{"class":49},"\u002F",[43,227,228],{"class":53},"Writer Lock\n",[43,230,232],{"class":45,"line":231},17,[43,233,91],{"emptyLinePlaceholder":90},[43,235,237,240,243,246,249,252],{"class":45,"line":236},18,[43,238,239],{"class":53},"::code",[43,241,242],{"class":49},"-",[43,244,245],{"class":53},"wrapper{language",[43,247,248],{"class":49},"=",[43,250,251],{"class":150},"\"go\"",[43,253,144],{"class":53},[43,255,257],{"class":45,"line":256},19,[43,258,259],{"class":150},"```go\n",[43,261,263],{"class":45,"line":262},20,[43,264,265],{"class":150},"var (\n",[43,267,269],{"class":45,"line":268},21,[43,270,271],{"class":150},"    rw    sync.RWMutex\n",[43,273,275],{"class":45,"line":274},22,[43,276,277],{"class":150},"    cache map[string]string\n",[43,279,281],{"class":45,"line":280},23,[43,282,84],{"class":150},[43,284,286],{"class":45,"line":285},24,[43,287,91],{"emptyLinePlaceholder":90},[43,289,291],{"class":45,"line":290},25,[43,292,293],{"class":150},"func get(key string) string {\n",[43,295,297],{"class":45,"line":296},26,[43,298,299],{"class":150},"    rw.RLock()\n",[43,301,303],{"class":45,"line":302},27,[43,304,305],{"class":150},"    defer rw.RUnlock()\n",[43,307,309],{"class":45,"line":308},28,[43,310,311],{"class":150},"    return cache[key]\n",[43,313,315],{"class":45,"line":314},29,[43,316,144],{"class":150},[43,318,320],{"class":45,"line":319},30,[43,321,91],{"emptyLinePlaceholder":90},[43,323,325],{"class":45,"line":324},31,[43,326,327],{"class":150},"func set(key, value string) {\n",[43,329,331],{"class":45,"line":330},32,[43,332,333],{"class":150},"    rw.Lock()\n",[43,335,337],{"class":45,"line":336},33,[43,338,339],{"class":150},"    defer rw.Unlock()\n",[43,341,343],{"class":45,"line":342},34,[43,344,345],{"class":150},"    cache[key] = value\n",[43,347,349],{"class":45,"line":348},35,[43,350,144],{"class":150},[43,352,354],{"class":45,"line":353},36,[43,355,151],{"class":150},[14,357,358,361,362,365,366,368],{},[18,359,360],{},"RWMutex"," allows multiple concurrent readers (",[18,363,364],{},"RLock",") or one writer (",[18,367,112],{},"). Use when reads vastly outnumber writes — the extra overhead isn't worth it for write-heavy or short critical sections.",[23,370,372,375],{"id":371},"syncwaitgroup-wait-for-goroutines",[18,373,374],{},"sync.WaitGroup"," — Wait for Goroutines",[31,377,378],{"language":33},[35,379,381],{"className":37,"code":380,"language":33,"meta":39,"style":39},"var wg sync.WaitGroup\nfor i := 0; i \u003C 5; i++ {\n    wg.Add(1)\n    go func(i int) {\n        defer wg.Done()\n        work(i)\n    }(i)\n}\nwg.Wait()   \u002F\u002F blocks until all Done\n``\n::\n\n- `Add(n)` — increment the counter (before starting the goroutine).\n- `Done()` — decrement (in the goroutine, via `defer`).\n- `Wait()` — block until the counter is 0.\n\n**Always `Add` before starting the goroutine** (not inside it — a race with `Wait`). **`defer wg.Done()`** ensures it runs even on panic.\n\n## `sync.Once` — One-Time Initialization\n\n::code-wrapper{language=\"go\"}\n```go\nvar (\n    once sync.Once\n    conn *Connection\n)\n\nfunc getConnection() *Connection {\n    once.Do(func() {\n        conn = connect()   \u002F\u002F runs exactly once, even with concurrent callers\n    })\n    return conn\n}\n``\n",[18,382,383,397,430,446,466,479,487,492,496,511,515,519,523,533,548,561,565,599,603,619,623,637,641,645,650,655,659,663,668,673,678,683,688,692],{"__ignoreMap":39},[43,384,385,387,390,392,394],{"class":45,"line":46},[43,386,50],{"class":49},[43,388,389],{"class":53}," wg ",[43,391,20],{"class":63},[43,393,66],{"class":53},[43,395,396],{"class":63},"WaitGroup\n",[43,398,399,402,405,408,412,415,418,421,424,427],{"class":45,"line":57},[43,400,401],{"class":49},"for",[43,403,404],{"class":53}," i ",[43,406,407],{"class":49},":=",[43,409,411],{"class":410},"snvgF"," 0",[43,413,414],{"cl