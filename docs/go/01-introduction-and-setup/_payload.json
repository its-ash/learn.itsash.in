[{"data":1,"prerenderedAt":1554},["ShallowReactive",2],{"page-\u002Fgo\u002F01-introduction-and-setup":3},{"id":4,"title":5,"body":6,"description":155,"extension":1548,"meta":1549,"navigation":205,"path":1550,"seo":1551,"stem":1552,"__hash__":1553},"content\u002Fgo\u002F01-introduction-and-setup.md","01 — Introduction & Setup",{"type":7,"value":8,"toc":1526},"minimark",[9,13,18,22,93,97,104,125,137,141,146,323,327,341,411,418,423,614,618,633,728,737,741,748,760,786,792,796,799,809,821,825,895,902,1522],[10,11,5],"h1",{"id":12},"_01-introduction-setup",[14,15,17],"h2",{"id":16},"why-go","Why Go?",[19,20,21],"p",{},"Go (or Golang) is a statically typed, compiled language designed at Google by Robert Griesemer, Rob Pike, and Ken Thompson. Key characteristics:",[23,24,25,33,39,50,56,62,68,74,84],"ul",{},[26,27,28,32],"li",{},[29,30,31],"strong",{},"Simple and readable"," — small keyword set, explicit over clever, one way to do things.",[26,34,35,38],{},[29,36,37],{},"Compiled and fast"," — native machine code, startup in milliseconds, performance near C.",[26,40,41,44,45,49],{},[29,42,43],{},"Statically typed"," — types catch bugs at compile time, but type inference (",[46,47,48],"code",{},":=",") keeps code concise.",[26,51,52,55],{},[29,53,54],{},"Garbage collected"," — no manual memory management; concurrent GC with low pause times.",[26,57,58,61],{},[29,59,60],{},"First-class concurrency"," — goroutines and channels make concurrent programming straightforward.",[26,63,64,67],{},[29,65,66],{},"Strong standard library"," — HTTP, JSON, crypto, compression, testing — batteries included.",[26,69,70,73],{},[29,71,72],{},"Fast compilation"," — large projects compile in seconds; no header files, no Makefiles for module-based projects.",[26,75,76,79,80,83],{},[29,77,78],{},"Single binary output"," — ",[46,81,82],{},"go build"," produces a static binary with no runtime dependencies.",[26,85,86,79,89,92],{},[29,87,88],{},"Cross-compilation",[46,90,91],{},"GOOS=linux GOARCH=arm64 go build"," cross-compiles from any host.",[14,94,96],{"id":95},"the-go-philosophy","The Go Philosophy",[19,98,99,100,103],{},"Go prioritizes ",[29,101,102],{},"simplicity and team scalability"," over language feature richness. It deliberately omits features common in other languages:",[23,105,106,109,116,119,122],{},[26,107,108],{},"No classes \u002F inheritance (use structs + composition + interfaces).",[26,110,111,112,115],{},"No exceptions (use explicit ",[46,113,114],{},"error"," returns).",[26,117,118],{},"No generics until 1.18 (now present, but deliberately minimal).",[26,120,121],{},"No implicit conversions (all conversions are explicit).",[26,123,124],{},"No operator overloading.",[19,126,127,128,132,133,136],{},"The result is a language that's easy to read, easy to onboard new team members into, and hard to write \"clever\" unmaintainable code in. Go optimizes for the ",[129,130,131],"em",{},"long-term cost"," of code, not the ",[129,134,135],{},"short-term expressiveness"," of the writer.",[14,138,140],{"id":139},"installing-go","Installing Go",[142,143,145],"h3",{"id":144},"macos","macOS",[147,148,150],"code-wrapper",{"language":149},"bash",[151,152,156],"pre",{"className":153,"code":154,"language":149,"meta":155,"style":155},"language-bash shiki shiki-themes github-light github-dark","brew install go\ngo version    # go version go1.22.0 darwin\u002Famd64\n``\n::\n\n### Linux\n\n::code-wrapper{language=\"bash\"}\n```bash\nwget https:\u002F\u002Fgo.dev\u002Fdl\u002Fgo1.22.0.linux-amd64.tar.gz\nsudo rm -rf \u002Fusr\u002Flocal\u002Fgo\nsudo tar -C \u002Fusr\u002Flocal -xzf go1.22.0.linux-amd64.tar.gz\necho 'export PATH=$PATH:\u002Fusr\u002Flocal\u002Fgo\u002Fbin' >> ~\u002F.bashrc\nsource ~\u002F.bashrc\ngo version\n``\n","",[46,157,158,174,187,193,200,207,213,218,233,242,251,266,286,302,310,318],{"__ignoreMap":155},[159,160,163,167,171],"span",{"class":161,"line":162},"line",1,[159,164,166],{"class":165},"sIsaT","brew",[159,168,170],{"class":169},"sJ6F3"," install",[159,172,173],{"class":169}," go\n",[159,175,177,180,183],{"class":161,"line":176},2,[159,178,179],{"class":165},"go",[159,181,182],{"class":169}," version",[159,184,186],{"class":185},"sdCPZ","    # go version go1.22.0 darwin\u002Famd64\n",[159,188,190],{"class":161,"line":189},3,[159,191,192],{"class":169},"``\n",[159,194,196],{"class":161,"line":195},4,[159,197,199],{"class":198},"snvgF","::\n",[159,201,203],{"class":161,"line":202},5,[159,204,206],{"emptyLinePlaceholder":205},true,"\n",[159,208,210],{"class":161,"line":209},6,[159,211,212],{"class":185},"### Linux\n",[159,214,216],{"class":161,"line":215},7,[159,217,206],{"emptyLinePlaceholder":205},[159,219,221,224,227,230],{"class":161,"line":220},8,[159,222,223],{"class":198},":",[159,225,226],{"class":169},":code-wrapper{language=",[159,228,229],{"class":165},"\"bash\"",[159,231,232],{"class":165},"}\n",[159,234,236,239],{"class":161,"line":235},9,[159,237,238],{"class":169},"```",[159,240,241],{"class":165},"bash\n",[159,243,245,248],{"class":161,"line":244},10,[159,246,247],{"class":165},"wget",[159,249,250],{"class":169}," https:\u002F\u002Fgo.dev\u002Fdl\u002Fgo1.22.0.linux-amd64.tar.gz\n",[159,252,254,257,260,263],{"class":161,"line":253},11,[159,255,256],{"class":165},"sudo",[159,258,259],{"class":169}," rm ",[159,261,262],{"class":198},"-rf",[159,264,265],{"class":169}," \u002Fusr\u002Flocal\u002Fgo\n",[159,267,269,271,274,277,280,283],{"class":161,"line":268},12,[159,270,256],{"class":165},[159,272,273],{"class":169}," tar ",[159,275,276],{"class":198},"-C",[159,278,279],{"class":169}," \u002Fusr\u002Flocal ",[159,281,282],{"class":198},"-xzf",[159,284,285],{"class":169}," go1.22.0.linux-amd64.tar.gz\n",[159,287,289,292,295,299],{"class":161,"line":288},13,[159,290,291],{"class":198},"echo",[159,293,294],{"class":169}," 'export PATH=$PATH:\u002Fusr\u002Flocal\u002Fgo\u002Fbin' ",[159,296,298],{"class":297},"svdQ7",">>",[159,300,301],{"class":169}," ~\u002F.bashrc\n",[159,303,305,308],{"class":161,"line":304},14,[159,306,307],{"class":198},"source",[159,309,301],{"class":169},[159,311,313,315],{"class":161,"line":312},15,[159,314,179],{"class":165},[159,316,317],{"class":169}," version\n",[159,319,321],{"class":161,"line":320},16,[159,322,192],{"class":169},[142,324,326],{"id":325},"windows","Windows",[19,328,329,330,337,338,223],{},"Download the MSI installer from ",[331,332,336],"a",{"href":333,"rel":334},"https:\u002F\u002Fgo.dev\u002Fdl",[335],"nofollow","go.dev\u002Fdl"," and run it. Or use ",[46,339,340],{},"winget",[147,342,343],{"language":149},[151,344,346],{"className":153,"code":345,"language":149,"meta":155,"style":155},"winget install GoLang.Go\n``\n::\n\n### Verify\n\n::code-wrapper{language=\"bash\"}\n```bash\ngo version\ngo env GOPATH GOROOT GOMODCACHE\n``\n",[46,347,348,357,361,365,369,374,378,388,394,400,407],{"__ignoreMap":155},[159,349,350,352,354],{"class":161,"line":162},[159,351,340],{"class":165},[159,353,170],{"class":169},[159,355,356],{"class":169}," GoLang.Go\n",[159,358,359],{"class":161,"line":176},[159,360,192],{"class":169},[159,362,363],{"class":161,"line":189},[159,364,199],{"class":198},[159,366,367],{"class":161,"line":195},[159,368,206],{"emptyLinePlaceholder":205},[159,370,371],{"class":161,"line":202},[159,372,373],{"class":185},"### Verify\n",[159,375,376],{"class":161,"line":209},[159,377,206],{"emptyLinePlaceholder":205},[159,379,380,382,384,386],{"class":161,"line":215},[159,381,223],{"class":198},[159,383,226],{"class":169},[159,385,229],{"class":165},[159,387,232],{"class":165},[159,389,390,392],{"class":161,"line":220},[159,391,238],{"class":169},[159,393,241],{"class":165},[159,395,396,398],{"class":161,"line":235},[159,397,179],{"class":165},[159,399,317],{"class":169},[159,401,402,404],{"class":161,"line":244},[159,403,179],{"class":165},[159,405,406],{"class":169}," env GOPATH GOROOT GOMODCACHE\n",[159,408,409],{"class":161,"line":253},[159,410,192],{"class":169},[14,412,414,415,417],{"id":413},"the-go-command","The ",[46,416,179],{}," Command",[19,419,414,420,422],{},[46,421,179],{}," command is the single entry point for building, testing, and managing Go code:",[424,425,426,439],"table",{},[427,428,429],"thead",{},[430,431,432,436],"tr",{},[433,434,435],"th",{},"Command",[433,437,438],{},"Purpose",[440,441,442,453,466,476,494,504,514,524,534,544,554,564,574,584,594,604],"tbody",{},[430,443,444,450],{},[445,446,447],"td",{},[46,448,449],{},"go run .",[445,451,452],{},"Compile and run immediately (no binary saved).",[430,454,455,459],{},[445,456,457],{},[46,458,82],{},[445,460,461,462,465],{},"Compile to a binary (in the current directory or ",[46,463,464],{},"bin\u002F",").",[430,467,468,473],{},[445,469,470],{},[46,471,472],{},"go build -o myapp",[445,474,475],{},"Compile to a named binary.",[430,477,478,483],{},[445,479,480],{},[46,481,482],{},"go install",[445,484,485,486,489,490,493],{},"Compile and install to ",[46,487,488],{},"$GOBIN","\u002F",[46,491,492],{},"$GOPATH\u002Fbin",".",[430,495,496,501],{},[445,497,498],{},[46,499,500],{},"go test",[445,502,503],{},"Run tests.",[430,505,506,511],{},[445,507,508],{},[46,509,510],{},"go test -bench=.",[445,512,513],{},"Run benchmarks.",[430,515,516,521],{},[445,517,518],{},[46,519,520],{},"go test -race",[445,522,523],{},"Run with the race detector.",[430,525,526,531],{},[445,527,528],{},[46,529,530],{},"go fmt",[445,532,533],{},"Format code (the canonical format).",[430,535,536,541],{},[445,537,538],{},[46,539,540],{},"go vet",[445,542,543],{},"Run static analysis for common mistakes.",[430,545,546,551],{},[445,547,548],{},[46,549,550],{},"go mod init",[445,552,553],{},"Initialize a new module.",[430,555,556,561],{},[445,557,558],{},[46,559,560],{},"go mod tidy",[445,562,563],{},"Add missing \u002F remove unused dependencies.",[430,565,566,571],{},[445,567,568],{},[46,569,570],{},"go get",[445,572,573],{},"Add\u002Fupgrade a dependency.",[430,575,576,581],{},[445,577,578],{},[46,579,580],{},"go doc fmt.Println",[445,582,583],{},"Show documentation.",[430,585,586,591],{},[445,587,588],{},[46,589,590],{},"go env",[445,592,593],{},"Show Go environment variables.",[430,595,596,601],{},[445,597,598],{},[46,599,600],{},"go clean",[445,602,603],{},"Remove build artifacts.",[430,605,606,611],{},[445,607,608],{},[46,609,610],{},"go work",[445,612,613],{},"Multi-module workspace (Go 1.18+).",[14,615,617],{"id":616},"modules-and-the-workspace","Modules and the Workspace",[19,619,620,621,624,625,628,629,632],{},"Go 1.16+ uses ",[29,622,623],{},"modules"," for dependency management (replacing the old ",[46,626,627],{},"GOPATH","-based workflow). A module is a collection of Go packages with a ",[46,630,631],{},"go.mod"," file at its root.",[147,634,635],{"language":149},[151,636,638],{"className":153,"code":637,"language":149,"meta":155,"style":155},"# Create a new module\nmkdir myapp && cd myapp\ngo mod init example.com\u002Fmyapp\n# Creates go.mod:\n#   module example.com\u002Fmyapp\n#   go 1.22\n\n# Add a dependency\ngo get github.com\u002Flib\u002Fpq\n\n# Tidy dependencies (add missing, remove unused)\ngo mod tidy\n",[46,639,640,645,663,676,681,686,691,695,700,710,714,719],{"__ignoreMap":155},[159,641,642],{"class":161,"line":162},[159,643,644],{"class":185},"# Create a new module\n",[159,646,647,650,653,657,660],{"class":161,"line":176},[159,648,649],{"class":165},"mkdir",[159,651,652],{"class":169}," myapp",[159,654,656],{"class":655},"ssxIu"," && ",[159,658,659],{"class":198},"cd",[159,661,662],{"class":169}," myapp\n",[159,664,665,667,670,673],{"class":161,"line":189},[159,666,179],{"class":165},[159,668,669],{"class":169}," mod",[159,671,672],{"class":169}," init",[159,674,675],{"class":169}," example.com\u002Fmyapp\n",[159,677,678],{"class":161,"line":195},[159,679,680],{"class":185},"# Creates go.mod:\n",[159,682,683],{"class":161,"line":202},[159,684,685],{"class":185},"#   module example.com\u002Fmyapp\n",[159,687,688],{"class":161,"line":209},[159,689,690],{"class":185},"#   go 1.22\n",[159,692,693],{"class":161,"line":215},[159,694,206],{"emptyLinePlaceholder":205},[159,696,697],{"class":161,"line":220},[159,698,699],{"class":185},"# Add a dependency\n",[159,701,702,704,707],{"class":161,"line":235},[159,703,179],{"class":165},[159,705,706],{"class":169}," get",[159,708,709],{"class":169}," github.com\u002Flib\u002Fpq\n",[159,711,712],{"class":161,"line":244},[159,713,206],{"emptyLinePlaceholder":205},[159,715,716],{"class":161,"line":253},[159,717,718],{"class":185},"# Tidy dependencies (add missing, remove unused)\n",[159,720,721,723,725],{"class":161,"line":268},[159,722,179],{"class":165},[159,724,669],{"class":169},[159,726,727],{"class":169}," tidy\n",[19,729,730,732,733,736],{},[46,731,631],{}," records the module path and Go version. ",[46,734,735],{},"go.sum"," records cryptographic hashes of dependencies for reproducibility. Both should be committed to version control.",[142,738,740],{"id":739},"the-module-path","The module path",[19,742,743,744,747],{},"The module path (",[46,745,746],{},"example.com\u002Fmyapp",") is the unique identifier for your module and the import prefix for its packages. If you're building a library others will import, it should be a path that you control (a GitHub repo, a custom domain). For a private application, any unique path works.",[142,749,751,753,754,753,757],{"id":750},"gopath-goroot-gomodcache",[46,752,627],{},", ",[46,755,756],{},"GOROOT",[46,758,759],{},"GOMODCACHE",[23,761,762,767,778],{},[26,763,764,766],{},[46,765,756],{}," — where the Go installation lives (the standard library source).",[26,768,769,771,772,774,775,465],{},[46,770,627],{}," — workspace for old-style code and ",[46,773,482],{},"'d binaries (default ",[46,776,777],{},"~\u002Fgo",[26,779,780,782,783,465],{},[46,781,759],{}," — where downloaded modules are cached (default ",[46,784,785],{},"$GOPATH\u002Fpkg\u002Fmod",[19,787,788,789,791],{},"You rarely need to set these manually — the defaults work. ",[46,790,590],{}," shows the current values.",[14,793,795],{"id":794},"project-layout","Project Layout",[19,797,798],{},"Go has a conventional layout (not enforced, but common):",[147,800,802],{"language":801},"text",[151,803,807],{"className":804,"code":806,"language":801,"meta":155},[805],"language-text","myapp\u002F\n├── go.mod\n├── go.sum\n├── main.go              # package main — the entry point\n├── cmd\u002F                 # multiple binaries (optional)\n│   └── myapp\u002F\n│       └── main.go\n├── internal\u002F            # packages only importable within this module\n│   └── handlers\u002F\n├── pkg\u002F                 # packages importable by other modules\n│   └── api\u002F\n├── test\u002F                # integration tests (outside packages)\n└── README.md\n",[46,808,806],{"__ignoreMap":155},[19,810,811,814,815,817,818,820],{},[46,812,813],{},"internal\u002F"," is enforced by the Go toolchain — packages under ",[46,816,813],{}," can only be imported by code within the parent of ",[46,819,813],{},". It's the way to keep implementation details private to your module.",[14,822,824],{"id":823},"a-first-program","A First Program",[147,826,827],{"language":179},[151,828,831],{"className":829,"code":830,"language":179,"meta":155,"style":155},"language-go shiki shiki-themes github-light github-dark","package main\n\nimport \"fmt\"\n\nfunc main() {\n    fmt.Println(\"Hello, Go!\")\n}\n",[46,832,833,841,845,859,863,874,891],{"__ignoreMap":155},[159,834,835,838],{"class":161,"line":162},[159,836,837],{"class":297},"package",[159,839,840],{"class":165}," main\n",[159,842,843],{"class":161,"line":176},[159,844,206],{"emptyLinePlaceholder":205},[159,846,847,850,853,856],{"class":161,"line":189},[159,848,849],{"class":297},"import",[159,851,852],{"class":169}," \"",[159,854,855],{"class":165},"fmt",[159,857,858],{"class":169},"\"\n",[159,860,861],{"class":161,"line":195},[159,862,206],{"emptyLinePlaceholder":205},[159,864,865,868,871],{"class":161,"line":202},[159,866,867],{"class":297},"func",[159,869,870],{"class":165}," main",[159,872,873],{"class":655},"() {\n",[159,875,876,879,882,885,888],{"class":161,"line":209},[159,877,878],{"class":655},"    fmt.",[159,880,881],{"class":165},"Println",[159,883,884],{"class":655},"(",[159,886,887],{"class":169},"\"Hello, Go!\"",[159,889,890],{"class":655},")\n",[159,892,893],{"class":161,"line":215},[159,894,232],{"class":655},[19,896,897,898,901],{},"Save as ",[46,899,900],{},"main.go",", then:",[147,903,904,1028,1031,1034,1038,1106,1110,1261,1265,1274,1336,1472,1476,1510,1513],{"language":149},[151,905,907],{"className":153,"code":906,"language":149,"meta":155,"style":155},"go run .\n# Hello, Go!\n``\n::\n\nEvery Go program starts in `package main`'s `func main()`. `fmt.Println` prints to stdout with a newline. Note the **tabs** — `gofmt` enforces tabs for indentation; spaces will be reformatted.\n\n## Cross-Compilation\n\n::code-wrapper{language=\"bash\"}\n```bash\n# Build a Linux binary from macOS\nGOOS=linux GOARCH=amd64 go build -o myapp-linux\n\n# Build for ARM (e.g., Raspberry Pi)\nGOOS=linux GOARCH=arm64 go build -o myapp-arm\n\n# Build for Windows\nGOOS=windows GOARCH=amd64 go build -o myapp.exe\n",[46,908,909,919,924,928,932,936,964,968,973,977,982,987,992,997,1001,1006,1011,1016,1022],{"__ignoreMap":155},[159,910,911,913,916],{"class":161,"line":162},[159,912,179],{"class":165},[159,914,915],{"class":169}," run",[159,917,918],{"class":169}," .\n",[159,920,921],{"class":161,"line":176},[159,922,923],{"class":185},"# Hello, Go!\n",[159,925,926],{"class":161,"line":189},[159,927,192],{"class":169},[159,929,930],{"class":161,"line":195},[159,931,199],{"class":198},[159,933,934],{"class":161,"line":202},[159,935,206],{"emptyLinePlaceholder":205},[159,937,938,941,944,947,950,953,956,958,961],{"class":161,"line":209},[159,939,940],{"class":165},"Every",[159,942,943],{"class":169}," Go",[159,945,946],{"class":169}," program",[159,948,949],{"class":169}," starts",[159,951,952],{"class":169}," in",[159,954,955],{"class":169}," `",[159,957,837],{"class":165},[159,959,960],{"class":169}," main`",[159,962,963],{"class":165},"'s `func main()`. `fmt.Println` prints to stdout with a newline. Note the **tabs** — `gofmt` enforces tabs for indentation; spaces will be reformatted.\n",[159,965,966],{"class":161,"line":215},[159,967,206],{"emptyLinePlaceholder":205},[159,969,970],{"class":161,"line":220},[159,971,972],{"class":165},"## Cross-Compilation\n",[159,974,975],{"class":161,"line":235},[159,976,206],{"emptyLinePlaceholder":205},[159,978,979],{"class":161,"line":244},[159,980,981],{"class":165},"::code-wrapper{language=\"bash\"}\n",[159,983,984],{"class":161,"line":253},[159,985,986],{"class":165},"```bash\n",[159,988,989],{"class":161,"line":268},[159,990,991],{"class":165},"# Build a Linux binary from macOS\n",[159,993,994],{"class":161,"line":288},[159,995,996],{"class":165},"GOOS=linux GOARCH=amd64 go build -o myapp-linux\n",[159,998,999],{"class":161,"line":304},[159,1000,206],{"emptyLinePlaceholder":205},[159,1002,1003],{"class":161,"line":312},[159,1004,1005],{"class":165},"# Build for ARM (e.g., Raspberry Pi)\n",[159,1007,1008],{"class":161,"line":320},[159,1009,1010],{"class":165},"GOOS=linux GOARCH=arm64 go build -o myapp-arm\n",[159,1012,1014],{"class":161,"line":1013},17,[159,1015,206],{"emptyLinePlaceholder":205},[159,1017,1019],{"class":161,"line":1018},18,[159,1020,1021],{"class":165},"# Build for Windows\n",[159,1023,1025],{"class":161,"line":1024},19,[159,1026,1027],{"class":165},"GOOS=windows GOARCH=amd64 go build -o myapp.exe\n",[19,1029,1030],{},"::",[19,1032,1033],{},"Go's cross-compilation is built in — no cross-toolchain needed (for pure-Go code; CGO requires a cross-compiler).",[14,1035,1037],{"id":1036},"tips-tricks","💡 Tips & Tricks",[23,1039,1040,1053,1064,1076,1093],{},[26,1041,1042,1045,1046,1048,1049,1052],{},[29,1043,1044],{},"Idiom",": run ",[46,1047,530],{}," (or ",[46,1050,1051],{},"gofmt -w .",") on every save — Go has one canonical format, and the formatter enforces it. IDEs with the Go extension do this automatically. Never argue about formatting in Go — there's only one way.",[26,1054,1055,1045,1057,1059,1060,1063],{},[29,1056,1044],{},[46,1058,540],{}," in CI and locally — it catches common mistakes (impossible conditions, misused ",[46,1061,1062],{},"Printf"," verbs, struct tags, lock copies) that the compiler doesn't. It's fast and nearly always right.",[26,1065,1066,1068,1069,1071,1072,1075],{},[29,1067,1044],{},": use ",[46,1070,813],{}," for packages that shouldn't be imported outside your module — the toolchain enforces the boundary, so you don't need to document \"don't use this.\" Reserve ",[46,1073,1074],{},"pkg\u002F"," for genuinely public, reusable packages.",[26,1077,1078,1080,1081,1083,1084,489,1086,1088,1089,1092],{},[29,1079,1044],{},": ",[46,1082,560],{}," before every commit — it adds missing dependencies and removes unused ones, keeping ",[46,1085,631],{},[46,1087,735],{}," accurate. A CI check that runs ",[46,1090,1091],{},"go mod tidy && git diff --exit-code"," prevents drift.",[26,1094,1095,1080,1098,1101,1102,1105],{},[29,1096,1097],{},"Debug",[46,1099,1100],{},"go doc \u003Cpkg>.\u003CFunc>"," from the terminal is faster than opening a browser for stdlib docs — ",[46,1103,1104],{},"go doc fmt.Printf"," shows the signature and usage right in your editor's terminal.",[14,1107,1109],{"id":1108},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[23,1111,1112,1132,1141,1159,1176,1193,1214,1240],{},[26,1113,1114,1119,1120,1123,1124,1127,1128,1131],{},[29,1115,1116,1117],{},"Go version in ",[46,1118,631],{},": the ",[46,1121,1122],{},"go 1.22"," line is a ",[129,1125,1126],{},"minimum version"," directive — it controls language features (e.g., the 1.22 ",[46,1129,1130],{},"for"," loop scoping) and the minimum toolchain, not the exact version you're using. Go 1.21+ introduced toolchain directives for automatic toolchain management.",[26,1133,1134,1137,1138,1140],{},[29,1135,1136],{},"Module path must be unique",": if you publish a library, the module path must be globally unique (a GitHub URL or custom domain). ",[46,1139,746],{}," is fine for private code but will collide if published.",[26,1142,1143,1148,1149,1151,1152,1155,1156,493],{},[29,1144,1145,1147],{},[46,1146,627],{}," mode is legacy",": some old docs assume ",[46,1150,627],{},"-based development (code in ",[46,1153,1154],{},"~\u002Fgo\u002Fsrc\u002F...","). Modern Go uses modules anywhere — don't put your code in ",[46,1157,1158],{},"$GOPATH\u002Fsrc",[26,1160,1161,1164,1165,1168,1169,1172,1173,1175],{},[29,1162,1163],{},"Tabs vs spaces",": Go uses ",[29,1166,1167],{},"tabs"," for indentation (enforced by ",[46,1170,1171],{},"gofmt","). If your editor inserts spaces, ",[46,1174,1171],{}," will rewrite them — configure your editor to use tabs for Go.",[26,1177,1178,1080,1184,1186,1187,1189,1190,1192],{},[29,1179,1180,1183],{},[46,1181,1182],{},"go run"," compiles to a temp dir",[46,1185,449],{}," compiles to a temp directory and runs, leaving no binary. Use ",[46,1188,82],{}," for a persistent binary. ",[46,1191,1182],{}," is for quick executions; don't use it in production.",[26,1194,1195,1080,1198,1201,1202,1205,1206,1209,1210,1213],{},[29,1196,1197],{},"CGO and cross-compilation",[46,1199,1200],{},"GOOS=... go build"," works for pure Go, but if your code imports CGO (e.g., ",[46,1203,1204],{},"github.com\u002Fmattn\u002Fgo-sqlite3","), you need a C cross-compiler (",[46,1207,1208],{},"CGO_ENABLED=1"," with the right toolchain). ",[46,1211,1212],{},"CGO_ENABLED=0"," disables CGO (pure Go, easy cross-compile, but can't use CGO packages).",[26,1215,1216,1080,1223,1225,1226,1048,1228,1230,1231,1233,1234,1236,1237,1239],{},[29,1217,1218,1220,1221],{},[46,1219,482],{}," vs ",[46,1222,82],{},[46,1224,482],{}," puts the binary in ",[46,1227,488],{},[46,1229,492],{},"); ",[46,1232,82],{}," puts it in the current directory. ",[46,1235,482],{}," is for installing tools globally; ",[46,1238,82],{}," is for project binaries.",[26,1241,1242,1080,1245,1247,1248,1048,1251,489,1254,1257,1258,1260],{},[29,1243,1244],{},"Private modules",[46,1246,570],{}," from a private repo needs ",[46,1249,1250],{},"GOPRIVATE=github.com\u002Fyourorg\u002F*",[46,1252,1253],{},"GOINSECURE",[46,1255,1256],{},".gitconfig"," auth) so the Go tool doesn't try the public proxy. Without it, ",[46,1259,570],{}," fails with a 404.",[14,1262,1264],{"id":1263},"spot-the-bug","🧠 Spot the Bug",[19,1266,1267,1268,1270,1271,1273],{},"A developer creates a module, writes ",[46,1269,900],{},", and runs ",[46,1272,449],{},", but gets \"package main is not a main package\" or \"function main is undeclared.\" What are the likely causes?",[147,1275,1276],{"language":179},[151,1277,1279],{"className":829,"code":1278,"language":179,"meta":155,"style":155},"\u002F\u002F main.go\npackage main\n\nimport \"fmt\"\n\nfunc Main() {\n    fmt.Println(\"Hello\")\n}\n",[46,1280,1281,1286,1292,1296,1306,1310,1319,1332],{"__ignoreMap":155},[159,1282,1283],{"class":161,"line":162},[159,1284,1285],{"class":185},"\u002F\u002F main.go\n",[159,1287,1288,1290],{"class":161,"line":176},[159,1289,837],{"class":297},[159,1291,840],{"class":165},[159,1293,1294],{"class":161,"line":189},[159,1295,206],{"emptyLinePlaceholder":205},[159,1297,1298,1300,1302,1304],{"class":161,"line":195},[159,1299,849],{"class":297},[159,1301,852],{"class":169},[159,1303,855],{"class":165},[159,1305,858],{"class":169},[159,1307,1308],{"class":161,"line":202},[159,1309,206],{"emptyLinePlaceholder":205},[159,1311,1312,1314,1317],{"class":161,"line":209},[159,1313,867],{"class":297},[159,1315,1316],{"class":165}," Main",[159,1318,873],{"class":655},[159,1320,1321,1323,1325,1327,1330],{"class":161,"line":215},[159,1322,878],{"class":655},[159,1324,881],{"class":165},[159,1326,884],{"class":655},[159,1328,1329],{"class":169},"\"Hello\"",[159,1331,890],{"class":655},[159,1333,1334],{"class":161,"line":220},[159,1335,232],{"class":655},[1337,1338,1339,1343,1365,1368,1392,1395,1452],"details",{},[1340,1341,1342],"summary",{},"Answer",[19,1344,1345,1346,1349,1350,1353,1354,1357,1358,1361,1362,1364],{},"The function is named ",[46,1347,1348],{},"Main",", not ",[46,1351,1352],{},"main"," — Go is case-sensitive, and the entry point must be exactly ",[46,1355,1356],{},"func main()"," (lowercase) in ",[46,1359,1360],{},"package main",". ",[46,1363,1348],{}," is just a regular function, so the program has no entry point, and the linker errors.",[19,1366,1367],{},"Other common causes of \"not a main package\":",[23,1369,1370,1378,1386],{},[26,1371,1372,1374,1375,465],{},[46,1373,1360],{}," is misspelled or the file declares a different package (",[46,1376,1377],{},"package myapp",[26,1379,1380,1381,1383,1384,493],{},"The file is in a subdirectory run as ",[46,1382,449],{}," but the subdirectory's package isn't ",[46,1385,1352],{},[26,1387,1388,1389,1391],{},"There are multiple files in the package but ",[46,1390,1352],{}," is in a file that's excluded by build tags.",[19,1393,1394],{},"The fix:",[151,1396,1398],{"className":829,"code":1397,"language":179,"meta":155,"style":155},"package main\n\nimport \"fmt\"\n\nfunc main() {   \u002F\u002F lowercase, exactly \"main\"\n    fmt.Println(\"Hello\")\n}\n",[46,1399,1400,1406,1410,1420,1424,1436,1448],{"__ignoreMap":155},[159,1401,1402,1404],{"class":161,"line":162},[159,1403,837],{"class":297},[159,1405,840],{"class":165},[159,1407,1408],{"class":161,"line":176},[159,1409,206],{"emptyLinePlaceholder":205},[159,1411,1412,1414,1416,1418],{"class":161,"line":189},[159,1413,849],{"class":297},[159,1415,852],{"class":169},[159,1417,855],{"class":165},[159,1419,858],{"class":169},[159,1421,1422],{"class":161,"line":195},[159,1423,206],{"emptyLinePlaceholder":205},[159,1425,1426,1428,1430,1433],{"class":161,"line":202},[159,1427,867],{"class":297},[159,1429,870],{"class":165},[159,1431,1432],{"class":655},"() {   ",[159,1434,1435],{"class":185},"\u002F\u002F lowercase, exactly \"main\"\n",[159,1437,1438,1440,1442,1444,1446],{"class":161,"line":209},[159,1439,878],{"class":655},[159,1441,881],{"class":165},[159,1443,884],{"class":655},[159,1445,1329],{"class":169},[159,1447,890],{"class":655},[159,1449,1450],{"class":161,"line":215},[159,1451,232],{"class":655},[19,1453,199,1454,1457,1458,1460,1461,1463,1464,489,1466,1469,1470,493],{},[29,1455,1456],{},"The lesson",": Go's entry point is ",[46,1459,1356],{}," (exactly) in ",[46,1462,1360],{}," (exactly). Case matters — ",[46,1465,1348],{},[46,1467,1468],{},"MAIN"," are not ",[46,1471,1352],{},[14,1473,1475],{"id":1474},"recommended-environment","Recommended Environment",[23,1477,1478,1487,1499],{},[26,1479,1480,1483,1484,1486],{},[29,1481,1482],{},"Go 1.22+"," for modern features (loop variable scoping, ",[46,1485,179],{}," toolchain management).",[26,1488,1489,1492,1493,489,1495,1498],{},[29,1490,1491],{},"VS Code + the Go extension"," (gopls for language server, dlv for debugging, automatic ",[46,1494,1171],{},[46,1496,1497],{},"gopls"," on save).",[26,1500,1501,1506,1507,1509],{},[29,1502,1503],{},[46,1504,1505],{},"golangci-lint"," for additional linters beyond ",[46,1508,540],{}," (recommended for CI).",[14,1511,1512],{"id":1340},"Summary",[19,1514,1515,1516,1518,1519,1521],{},"You now have Go installed, understand the module system and the ",[46,1517,179],{}," command, and can run a \"Hello, World.\" Next: the ",[46,1520,179],{}," command in depth and the anatomy of a Go program.",[1523,1524,1525],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--sh