,1422,1423,1427,1455,1458,1509,1512,1553,1559,1613,1619],"details",{},[1424,1425,1426],"summary",{},"Answer",[14,1428,1429,1431,1432,1435,1436,1439,1440,1442,1443,1446,1447,1450,1451,1454],{},[38,1430,1047],{}," embeds ",[38,1433,1434],{},"*Logger"," (a pointer). ",[38,1437,1438],{},"s := Service{}"," leaves the embedded ",[38,1441,1434],{}," as ",[38,1444,1445],{},"nil"," (the zero value of a pointer). Calling ",[38,1448,1449],{},"s.Log(\"hello\")"," invokes the promoted ",[38,1452,1453],{},"(*Logger).Log"," method on a nil receiver — a nil pointer dereference panic.",[14,1456,1457],{},"The fix — initialize the embedded pointer:",[32,1459,1461],{"className":34,"code":1460,"language":30,"meta":36,"style":36},"func main() {\n    s := Service{Logger: &Logger{}}\n    s.Log(\"hello\")   \u002F\u002F OK\n}\n",[38,1462,1463,1471,1490,1505],{"__ignoreMap":36},[41,1464,1465,1467,1469],{"class":43,"line":44},[41,1466,442],{"class":47},[41,1468,1380],{"class":51},[41,1470,1383],{"class":58},[41,1472,1473,1475,1477,1479,1482,1485,1487],{"class":43,"line":62},[41,1474,1388],{"class":58},[41,1476,90],{"class":47},[41,1478,1353],{"class":51},[41,1480,1481],{"class":58},"{Logger: ",[41,1483,1484],{"class":47},"&",[41,1486,1051],{"class":51},[41,1488,1489],{"class":58},"{}}\n",[41,1491,1492,1494,1496,1498,1500,1502],{"class":43,"line":71},[41,1493,1399],{"class":58},[41,1495,1324],{"class":51},[41,1497,1327],{"class":58},[41,1499,1406],{"class":273},[41,1501,1409],{"class":58},[41,1503,1504],{"class":111},"\u002F\u002F OK\n",[41,1506,1507],{"class":43,"line":77},[41,1508,74],{"class":58},[14,1510,1511],{},"::\nOr provide a constructor:",[32,1513,1515],{"className":34,"code":1514,"language":30,"meta":36,"style":36},"func NewService() *Service {\n    return &Service{Logger: &Logger{}}\n}\n",[38,1516,1517,1532,1549],{"__ignoreMap":36},[41,1518,1519,1521,1524,1526,1528,1530],{"class":43,"line":44},[41,1520,442],{"class":47},[41,1522,1523],{"class":51}," NewService",[41,1525,461],{"class":58},[41,1527,1317],{"class":47},[41,1529,1047],{"class":51},[41,1531,59],{"class":58},[41,1533,1534,1536,1539,1541,1543,1545,1547],{"class":43,"line":62},[41,1535,471],{"class":47},[41,1537,1538],{"class":47}," &",[41,1540,1047],{"class":51},[41,1542,1481],{"class":58},[41,1544,1484],{"class":47},[41,1546,1051],{"class":51},[41,1548,1489],{"class":58},[41,1550,1551],{"class":43,"line":71},[41,1552,74],{"class":58},[14,1554,1555,1556,1558],{},"::\nOr embed the value (not the pointer) if ",[38,1557,1051],{}," doesn't need pointer receivers:",[32,1560,1562],{"className":34,"code":1561,"language":30,"meta":36,"style":36},"type Service struct {\n    Logger   \u002F\u002F value, not pointer — zero value is a usable Logger\n}\ns := Service{}\ns.Log(\"hello\")   \u002F\u002F OK — Logger is a zero-value Logger, not nil\n",[38,1563,1564,1574,1582,1586,1597],{"__ignoreMap":36},[41,1565,1566,1568,1570,1572],{"class":43,"line":44},[41,1567,48],{"class":47},[41,1569,1353],{"class":51},[41,1571,55],{"class":47},[41,1573,59],{"class":58},[41,1575,1576,1579],{"class":43,"line":62},[41,1577,1578],{"class":51},"    Logger",[41,1580,1581],{"class":111},"   \u002F\u002F value, not pointer — zero value is a usable Logger\n",[41,1583,1584],{"class":43,"line":71},[41,1585,74],{"class":58},[41,1587,1588,1591,1593,1595],{"class":43,"line":77},[41,1589,1590],{"class":58},"s ",[41,1592,90],{"class":47},[41,1594,1353],{"class":51},[41,1596,1301],{"class":58},[41,1598,1599,1602,1604,1606,1608,1610],{"class":43,"line":84},[41,1600,1601],{"class":58},"s.",[41,1603,1324],{"class":51},[41,1605,1327],{"class":58},[41,1607,1406],{"class":273},[41,1609,1409],{"class":58},[41,1611,1612],{"class":111},"\u002F\u002F OK — Logger is a zero-value Logger, not nil\n",[14,1614,1615,1616,1618],{},"::\nBut value embedding requires the type to be usable with a zero value (and copies the value into ",[38,1617,1047],{},"). Pointer embedding is common for shared dependencies (a logger, a database) that should be injected.",[14,1620,1621,1624,1625,1628,1629,1631],{},[18,1622,1623],{},"The lesson",": embedding a pointer (",[38,1626,1627],{},"*T",") leaves the embedded field as ",[38,1630,1445],{}," unless initialized — promoted method calls on a nil embedded pointer panic. Initialize embedded pointers in the literal or via a constructor.",[23,1633,1634],{"id":1424},"Summary",[14,1636,1637],{},"You can now declare structs, use named\u002Fpositional\u002Fpartial literals, embed types for composition and method promotion, use struct tags for serialization, and understand embedding vs. inheritance (composition, no virtual dispatch). Next: pointers — when and why.",[1639,1640,1641],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-gi