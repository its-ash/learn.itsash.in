imal.Name`. The outer struct can override:\n",[41,612,613],{"class":43,"line":288},[41,614,81],{"emptyLinePlaceholder":80},[41,616,617],{"class":43,"line":294},[41,618,619],{"class":609},"::code-wrapper{language=\"go\"}\n",[41,621,622],{"class":43,"line":299},[41,623,321],{"class":609},[41,625,626],{"class":43,"line":318},[41,627,628],{"class":609},"func (d Dog) Speak() string {\n",[41,630,631],{"class":43,"line":324},[41,632,633],{"class":609},"    return d.Name + \" barks\"\n",[41,635,636],{"class":43,"line":330},[41,637,74],{"class":609},[41,639,640,643,645],{"class":43,"line":336},[41,641,642],{"class":609},"d.Speak()    \u002F\u002F \"Rex barks\" (Dog",[41,644,606],{"class":273},[41,646,647],{"class":58},"s method overrides the promoted one)\n",[41,649,650,652,654,656],{"class":43,"line":341},[41,651,576],{"class":58},[41,653,458],{"class":51},[41,655,581],{"class":58},[41,657,658],{"class":111},"\u002F\u002F \"Rex makes a sound\" (explicit access to the embedded method)\n",[41,660,661],{"class":43,"line":347},[41,662,274],{"class":273},[664,665,667],"h3",{"id":666},"embedding-vs-inheritance","Embedding vs Inheritance",[14,669,670,671,674],{},"Embedding is ",[18,672,673],{},"composition",", not inheritance:",[676,677,678,682,693],"ul",{},[679,680,681],"li",{},"There's no \"is-a\" relationship (no subtype polymorphism via embedding — use interfaces for that).",[679,683,684,685,689,690,21],{},"The outer struct ",[686,687,688],"em",{},"has-a"," inner struct; the inner's methods are ",[686,691,692],{},"delegated",[679,694,695,696,699,700,703,704,707],{},"No virtual dispatch: ",[38,697,698],{},"d.Speak()"," calls ",[38,701,702],{},"Dog.Speak"," if defined, else ",[38,705,706],{},"Animal.Speak"," — resolved at compile time by the method set.",[23,709,711],{"id":710},"struct-tags","Struct Tags",[14,713,714,715,102,718,721],{},"Tags are metadata on struct fields, read by reflection — used by ",[38,716,717],{},"encoding\u002Fjson",[38,719,720],{},"database\u002Fsql",", validation, etc.:",[28,723,724],{"language":30},[32,725,727],{"className":34,"code":726,"language":30,"meta":36,"style":36},"type User struct {\n    ID       int    `json:\"id\"`\n    Username string `json:\"username\" db:\"user_name\" validate:\"required\"`\n    Email    string `json:\"email,omitempty\"`\n    Password string `json:\"-\"`           \u002F\u002F never serialized\n}\n",[38,728,729,740,751,761,771,784],{"__ignoreMap":36},[41,730,731,733,736,738],{"class":43,"line":44},[41,732,48],{"class":47},[41,734,735],{"class":51}," User",[41,737,55],{"class":47},[41,739,59],{"class":58},[41,741,742,745,748],{"class":43,"line":62},[41,743,744],{"class":58},"    ID       ",[41,746,747],{"class":47},"int",[41,749,750],{"class":273},"    `json:\"id\"`\n",[41,752,753,756,758],{"class":43,"line":71},[41,754,755],{"class":58},"    Username ",[41,757,464],{"class":47},[41,759,760],{"class":273}," `json:\"username\" db:\"user_name\" validate:\"required\"`\n",[41,762,763,766,768],{"class":43,"line":77},[41,764,765],{"class":58},"    Email    ",[41,767,464],{"class":47},[41,769,770],{"class":273}," `json:\"email,omitempty\"`\n",[41,772,773,776,778,781],{"class":43,"line":84},[41,774,775],{"class":58},"    Password ",[41,777,464],{"class":47},[41,779,780],{"class":273}," `json:\"-\"`",[41,782,783],{"class":111},"           \u002F\u002F never serialized\n",[41,785,786],{"class":43,"line":115},[41,787,74],{"class":58},[676,789,790,800,806,812],{},[679,791,792,795,796,799],{},[38,793,794],{},"json:\"name\""," — serializes the field as ",[38,797,798],{},"\"name\""," in JSON.",[679,801,802,805],{},[38,803,804],{},"json:\"name,omitempty\""," — omits the field if it's the zero value.",[679,807,808,811],{},[38,809,810],{},"json:\"-\""," — never serializes the field.",[679,813,814,815,818],{},"Tags are raw strings; the format is ",[38,816,817],{},"key:\"value\""," repeated, space-separated.",[23,820,822],{"id":821},"anonymous-structs","Anonymous Structs",[28,824,825],{"language":30},[32,826,828],{"className":34,"code":827,"language":30,"meta":36,"style":36},"\u002F\u002F Inline, for one-off use\np := struct{ X, Y int }{1, 2}\n\n\u002F\u002F As a field type\ntype Config struct {\n    Limits struct {\n        Max int\n        Min int\n    }\n}\n``\n::\n\nUseful for ad-hoc grouping (test data, local organization). Don't overuse — named types are clearer for anything reused.\n\n## Struct Comparison\n\nStructs are comparable if **all fields are comparable**:\n\n::code-wrapper{language=\"go\"}\n```go\ntype Point struct{ X, Y int }\np1 := Point{1, 2}\np2 := Point{1, 2}\nfmt.Println(p1 == p2)   \u002F\u002F true\n\ntype Bad struct{ S []int }\n\u002F\u002F b1 == b2 is illegal — []int is not comparable\n``\n",[38,829,830,835,859,863,868,879,889,896,903,908,912,916,920,924,945,949,954,958,963,967,971,975,980,985,990,995,999,1004,1009],{"__ignoreMap":36},[41,831,832],{"class":43,"line":44},[41,833,834],{"class":111},"\u002F\u002F Inline, for one-off use\n",[41,836,837,839,841,843,846,848,851,853,855,857],{"class":43,"line":62},[41,838,87],{"class":58},[41,840,90],{"class":47},[41,842,55],{"class":47},[41,844,845],{"class":58},"{ X, Y ",[41,847,747],{"class":47},[41,849,850],{"class":58}," }{",[41,852,99],{"class":98},[41,854,102],{"class":58},[41,856,105],{"class":98},[41,858,74],{"class":58},[41,860,861],{"class":43,"line":71},[41,862,81],{"emptyLinePlaceholder":80},[41,864,865],{"class":43,"line":77},[41,866,867],{"class":111},"\u002F\u002F As a field type\n",[41,869,870,872,875,877],{"class":43,"line":84},[41,871,48],{"class":47},[41,873,874],{"class":51}," Config",[41,876,55],{"class":47},[41,878,59],{"class":58},[41,880,881,884,887],{"class":43,"line":115},[41,882,883],{"class":58},"    Limits ",[41,885,886],{"class":47},"struct",[41,888,59],{"class":58},[41,890,891,894],{"class":43,"line":140},[41,892,893],{"class":58},"        Max ",[41,895,68],{"class":47},[41,897,898,901],{"class":43,"line":155},[41,899,900],{"class":58},"        Min ",[41,902,68],