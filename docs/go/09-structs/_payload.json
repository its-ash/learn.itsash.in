,1011],{"class":43,"line":341},[41,1012,274],{"class":609},[14,1014,1015],{},"Comparable structs can be map keys; non-comparable (with slices\u002Fmaps\u002Ffuncs) can't.",[23,1017,1019],{"id":1018},"tips-tricks","💡 Tips & Tricks",[676,1021,1022,1036,1064,1085,1101],{},[679,1023,1024,1027,1028,1031,1032,1035],{},[18,1025,1026],{},"Idiom",": use named-field literals (",[38,1029,1030],{},"Point{X: 1, Y: 2}",") over positional (",[38,1033,1034],{},"Point{1, 2}",") — named literals are robust to field additions\u002Freorderings and self-documenting. Positional literals break silently when a field is inserted.",[679,1037,1038,1040,1041,1044,1045,1048,1049,1052,1053,1056,1057,1059,1060,1063],{},[18,1039,1026],{},": use embedding for composition and method promotion — ",[38,1042,1043],{},"type Service struct { Logger; DB }"," gives ",[38,1046,1047],{},"Service"," the ",[38,1050,1051],{},"Logger","'s and ",[38,1054,1055],{},"DB","'s methods without boilerplate delegation. This is Go's alternative to inheritance: ",[686,1058,688],{}," with delegation, not ",[686,1061,1062],{},"is-a"," with virtual dispatch.",[679,1065,1066,1068,1069,1071,1072,1075,1076,1071,1078,1080,1081,1084],{},[18,1067,1026],{},": use struct tags for serialization metadata — ",[38,1070,804],{}," and ",[38,1073,1074],{},"db:\"column\""," are read by reflection in ",[38,1077,717],{},[38,1079,720],{},". Keep tags consistent and use ",[38,1082,1083],{},"go vet"," (it checks tag syntax).",[679,1086,1087,1089,1090,1093,1094,1097,1098,1100],{},[18,1088,1026],{},": prefer embedding an ",[18,1091,1092],{},"interface"," (not a struct) when you want to delegate a capability without forcing a concrete type — ",[38,1095,1096],{},"type Service struct { Logger interface{ Log(string) } }"," lets ",[38,1099,1047],{}," accept any logger, and the embedded interface promotes the method.",[679,1102,1103,1105,1106,1109,1110,1113,1114,1117,1118,1121],{},[18,1104,1026],{},": use ",[38,1107,1108],{},"omitempty"," in JSON tags fo