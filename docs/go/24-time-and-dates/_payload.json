"go\"}\n```go\nstart := time.Now()\n\u002F\u002F ... work ...\nelapsed := time.Since(start)   \u002F\u002F uses the monotonic clock\n``\n",[18,840,841,860,882,886,899,912,916,921,926,930,934,938,997,1001,1006,1010,1046,1050,1064,1068,1073,1078,1083],{"__ignoreMap":55},[59,842,843,846,848,850,853,855,858],{"class":61,"line":62},[59,844,845],{"class":65},"loc, _ ",[59,847,70],{"class":69},[59,849,73],{"class":65},[59,851,852],{"class":76},"LoadLocation",[59,854,100],{"class":65},[59,856,857],{"class":158},"\"America\u002FNew_York\"",[59,859,190],{"class":65},[59,861,862,864,866,868,870,873,876,879],{"class":61,"line":87},[59,863,90],{"class":65},[59,865,70],{"class":69},[59,867,73],{"class":65},[59,869,77],{"class":76},[59,871,872],{"class":65},"().",[59,874,875],{"class":76},"In",[59,877,878],{"class":65},"(loc)   ",[59,880,881],{"class":83},"\u002F\u002F the current moment, displayed in NYC time\n",[59,883,884],{"class":61,"line":143},[59,885,400],{"emptyLinePlaceholder":399},[59,887,888,890,893,896],{"class":61,"line":173},[59,889,242],{"class":65},[59,891,892],{"class":76},"UTC",[59,894,895],{"class":65},"()                   ",[59,897,898],{"class":83},"\u002F\u002F convert to UTC display\n",[59,900,901,903,906,909],{"class":61,"line":193},[59,902,242],{"class":65},[59,904,905],{"class":76},"Local",[59,907,908],{"class":65},"()                 ",[59,910,911],{"class":83},"\u002F\u002F convert to local display\n",[59,913,914],{"class":61,"line":417},[59,915,400],{"emptyLinePlaceholder":399},[59,917,918],{"class":61,"line":428},[59,919,920],{"class":83},"\u002F\u002F LoadLocation needs the tz database. On Windows, it's bundled; on Unix,\n",[59,922,923],{"class":61,"line":442},[59,924,925],{"class":83},"\u002F\u002F it uses \u002Fusr\u002Fshare\u002Fzoneinfo. If missing, import \"time\u002Ftzdata\" to embed it.\n",[59,927,928],{"class":61,"line":447},[59,929,532],{"class":158},[59,931,932],{"class":61,"line":453},[59,933,538],{"class":65},[59,935,936],{"class":61,"l