 — normalization.\n",[59,665,667],{"class":61,"line":666},22,[59,668,400],{"emptyLinePlaceholder":399},[59,670,672],{"class":61,"line":671},23,[59,673,674],{"class":65},"## Comparing Times\n",[59,676,678],{"class":61,"line":677},24,[59,679,400],{"emptyLinePlaceholder":399},[59,681,683,686,688,691,694,697],{"class":61,"line":682},25,[59,684,685],{"class":65},"::code",[59,687,620],{"class":69},[59,689,690],{"class":65},"wrapper{language",[59,692,693],{"class":69},"=",[59,695,696],{"class":158},"\"go\"",[59,698,699],{"class":65},"}\n",[59,701,703],{"class":61,"line":702},26,[59,704,705],{"class":158},"```go\n",[59,707,709],{"class":61,"line":708},27,[59,710,711],{"class":158},"t1.Before(t2)\n",[59,713,715],{"class":61,"line":714},28,[59,716,717],{"class":158},"t1.After(t2)\n",[59,719,721],{"class":61,"line":720},29,[59,722,723],{"class":158},"t1.Equal(t2)   \u002F\u002F ✅ use Equal, not == (see below)\n",[59,725,727],{"class":61,"line":726},30,[59,728,532],{"class":158},[215,730,732,606,735],{"id":731},"vs-equal",[18,733,734],{},"==",[18,736,737],{},"Equal",[14,739,740,742,743,747,748,750,751,756],{},[18,741,734],{}," compares the wall clock ",[744,745,746],"em",{},"and"," the monotonic clock and the location. ",[18,749,737],{}," compares the instant (the moment in time), ignoring location and monotonic differences. ",[223,752,753,754],{},"Use ",[18,755,737],{}," for \"are these the same moment\":",[47,758,759],{"language":49},[51,760,762],{"className":53,"code":761,"language":49,"meta":55,"style":55},"t1, _ := time.Parse(time.RFC3339, \"2024-03-15T14:30:00Z\")\nt2, _ := time.Parse(time.RFC3339, \"2024-03-15T09:30:00-05:00\")\n\u002F\u002F t1 and t2 are the same instant (14:30 UTC = 09:30 EST)\nt1.Equal(t2)   \u002F\u002F true\nt1 == t2       \u002F\u002F false (different locations)\n",[18,763,764,781,799,804,817],{"__ignoreMap":55},[59,765,766,769,771,773,775,777,779],{"class":61,"line":62},[59,767,768],{"class":65},"t1, _ ",[59,770,70],{"class":69},[59,772,73],{"clas