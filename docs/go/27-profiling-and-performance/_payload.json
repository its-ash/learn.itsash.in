:51,"meta":40,"style":40},"\u002F\u002F ❌ copies the whole struct on every call\nfunc process(u User) { ... }\n\n\u002F\u002F ✅ passes a pointer (8 bytes)\nfunc process(u *User) { ... }\n",[18,1004,1005,1010,1035,1039,1044],{"__ignoreMap":40},[44,1006,1007],{"class":46,"line":47},[44,1008,1009],{"class":71},"\u002F\u002F ❌ copies the whole struct on every call\n",[44,1011,1012,1014,1017,1019,1023,1026,1029,1032],{"class":46,"line":68},[44,1013,899],{"class":286},[44,1015,1016],{"class":50}," process",[44,1018,195],{"class":194},[44,1020,1022],{"class":1021},"sCrzJ","u",[44,1024,1025],{"class":50}," User",[44,1027,1028],{"class":194},") { ",[44,1030,1031],{"class":286},"...",[44,1033,1034],{"class":194}," }\n",[44,1036,1037],{"class":46,"line":141},[44,1038,145],{"emptyLinePlaceholder":144},[44,1040,1041],{"class":46,"line":148},[44,1042,1043],{"class":71},"\u002F\u002F ✅ passes a pointer (8 bytes)\n",[44,1045,1046,1048,1050,1052,1054,1057,1060,1062,1064],{"class":46,"line":154},[44,1047,899],{"class":286},[44,1049,1016],{"class":50},[44,1051,195],{"class":194},[44,1053,1022],{"class":1021},[44,1055,1056],{"class":286}," *",[44,1058,1059],{"class":50},"User",[44,1061,1028],{"class":194},[44,1063,1031],{"class":286},[44,1065,1034],{"class":194},[14,1067,1068],{},"But don't over-pointer small structs — the indirection can cost more than the copy.",[27,1070,1072],{"id":1071},"escape-analysis","Escape Analysis",[14,1074,1075,1076,1079],{},"The compiler decides stack vs. heap allocation via ",[98,1077,1078],{},"escape analysis",". Stack allocations are free (no GC); heap allocations cost. See the decisions:",[32,1081,1082,1113,1116,1130,1134],{"language":34},[36,1083,1085],{"className":38,"code":1084,"language":34,"meta":40,"style":40},"go build -gcflags=\"-m\" main.go\n# \"moved to heap: x\" — x is heap-allocated (its address escapes)\n# \"x does not escape\" — x is stack-allocated\n",[18,1086,1087,1103,1108],{"__ignoreMap":40},[44,1088,1089,1091,1094,1097,1100],{"class":46,"line":47},[44,1090,51],{"class":50},[44,1092,1093],{"class":54}," build",[44,1095,1096],{"class":58}," -gcflags=",[44,1098,1099],{"class":54},"\"-m\"",[44,1101,1102],{"class":54}," main.go\n",[44,1104,1105],{"class":46,"line":68},[44,1106,1107],{"class":71},"# \"moved to heap: x\" — x is heap-allocated (its address escapes)\n",[44,1109,1110],{"class":46,"line":141},[44,1111,1112],{"class":71},"# \"x does not escape\" — x is stack-allocated\n",[14,1114,1115],{},"Common causes of escaping:",[74,1117,1118,1121,1124,1127],{},[77,1119,1120],{},"Returning a pointer to a local variable (escapes — necessary).",[77,1122,1123],{},"Storing a pointer in an interface (escapes — the compiler can't know the size).",[77,1125,1126],{},"Passing a pointer to a function that stores it (escapes).",[77,1128,1129],{},"Large stack frames (the compiler may heap-allocate to avoid stack growth).",[27,1131,1133],{"id":1132},"the-race-detector","The Race Detector",[32,1135,1136,1179,1186,1190],{"language":34},[36,1137,1139],{"className":38,"code":1138,"language":34,"meta":40,"style":40},"go test -race .\u002F...\ngo run -race .\ngo build -race -o myapp\n",[18,1140,1141,1153,1165],{"__ignoreMap":40},[44,1142,1143,1145,1147,1150],{"class":46,"line":47},[44,1144,51],{"class":50},[44,1146,55],{"class":54},[44,1148,1149],{"class":58}," -race",[44,1151,1152],{"class":54}," .\u002F...\n",[44,1154,1155,1157,1160,1162],{"class":46,"line":68},[44,1156,51],{"class":50},[44,1158,1159],{"class":54}," run",[44,1161,1149],{"class":58},[44,1163,1164],{"class":54}," .\n",[44,1166,1167,1169,1171,1173,1176],{"class":46,"line":141},[44,1168,51],{"class":50},[44,1170,1093],{"class":54},[44,1172,1149],{"class":58},[44,1174,1175],{"class":58}," -o",[44,1177,1178],{"class":54}," myapp\n",[14,1180,1181,1182,1185],{},"The race detector finds data races (concurrent reads\u002Fwrites without synchronization) at runtime. It has overhead (10-100x) — use in testing and CI, not production. A race detected by ",[18,1183,1184],{},"-race"," is a real bug; fix it before shipping.",[27,1187,1189],{"id":1188},"goroutine-leaks-profiling","Goroutine Leaks (profiling)",[32,1191,1192,1218,1221,1225],{"language":34},[36,1193,1195],{"className":38,"code":1194,"language":34,"meta":40,"style":40},"go tool pprof http:\u002F\u002Flocalhost:6060\u002Fdebug\u002Fpprof\u002Fgoroutine\n(pprof) top\n",[18,1196,1197,1208],{"__ignoreMap":40},[44,1198,1199,1201,1203,1205],{"class":46,"line":47},[44,1200,51],{"class":50},[44,1202,182],{"class":54},[44,1204,185],{"class":54},[44,1206,1207],{"class":54}," http:\u002F\u002Flocalhost:6060\u002Fdebug\u002Fpprof\u002Fgoroutine\n",[44,1209,1210,1212,1214,1216],{"class":46,"line":68},[44,1211,195],{"class":194},[44,1213,20],{"class":50},[44,1215,200],{"class":194},[44,1217,203],{"class":50},[14,1219,1220],{},"The goroutine profile shows the stack traces of all live goroutines. A growing number of stuck goroutines (blocked on a channel, a lock, an infinite loop) is a leak.",[27,1222,1224],{"id":1223},"memory-leaks-heap-profiling","Memory Leaks (heap profiling)",[32,1226,1227,1253,1264],{"language":34},[36,1228,1230],{"className":38,"code":1229,"language":34,"meta":40,"style":40},"go tool pprof http:\u002F\u002Flocalhost:6060\u002Fdebug\u002Fpprof\u002Fheap\n(pprof) top\n",[18,1231,1232,1243],{"__ignoreMap":40},[44,1233,1234,1236,1238,1240],{"class":46,"line":47},[44,1235,51],{"class":50},[44,1237,182],{"class":54},[44,1239,185],{"class":54},[44,1241,1242],{"class":54}," http:\u002F\u002Flocalhost:6060\u002Fdebug\u002Fpprof\u002Fheap\n",[44,1244,1245,1247,1249,1251],{"class":46,"line":68},[44,1246,195],{"class":194},[44,1248,20],{"class":50},[44,1250,200],{"class":194},[44,1252,203],{"class":50},[14,1254,1255,1256,1259,1260,1263],{},"The heap profile shows allocations. Use ",[18,1257,1258],{},"alloc_space"," (total) vs ",[18,1261,1262],{},"inuse_space"," (current) to distinguish \"allocates a lot\" (GC pressure) from \"holds a lot\" (leak):",[32,1265,1266,1303,1307,1346,1349,1353,1418,1422,1522,1526,1534],{"language":34},[36,1267,1269],{"className":38,"code":1268,"language":34,"meta":40,"style":40},"go tool pprof -alloc_space http:\u002F\u002Flocalhost:6060\u002Fdebug\u002Fpprof\u002Fheap   # total allocations\ngo tool pprof -inuse_space http:\u002F\u002Flocalhost:6060\u002Fdebug\u002Fpprof\u002Fheap   # currently held\n",[18,1270,1271,1287],{"__ignoreMap":40},[44,1272,1273,1275,1277,1279,1282,1284],{"class":46,"line":47},[44,1274,51],{"class":50},[44,1276,182],{"class":54},[44,1278,185],{"class":54},[44,1280,1281],{"class":58}," -alloc_space",[44,1283,380],{"class":54},[44,1285,1286],{"class":71},"   # total allocations\n",[44,1288,1289,1291,1293,1295,1298,1300],{"class":46,"line":68},[44,1290,51],{"class":50},[44,1292,182],{"class":54},[44,1294,185],{"class":54},[44,1296,1297],{"class":58}," -inuse_space",[44,1299,380],{"class":54},[44,1301,1302],{"class":71},"   # currently held\n",[27,1304,1306],{"id":1305},"optimization-process","Optimization Process",[1308,1309,1310,1319,1328,1334,1340],"ol",{},[77,1311,1312,1315,1316,533],{},[98,1313,1314],{},"Benchmark first"," — establish a baseline with ",[18,1317,1318],{},"go test -bench=. -benchmem",[77,1320,1321,1324,1325,1327],{},[98,1322,1323],{},"Profile"," — find the hotspot with ",[18,1326,20],{}," (CPU or heap).",[77,1329,1330,1333],{},[98,1331,1332],{},"Optimize the hotspot"," — reduce allocations, improve the algorithm.",[77,1335,1336,1339],{},[98,1337,1338],{},"Re-benchmark"," — confirm the improvement; check you didn't regress elsewhere.",[77,1341,1342,1345],{},[98,1343,1344],{},"Repeat"," — the next hotspot is now somewhere else.",[14,1347,1348],{},"Don't optimize without a profile — intuition about Go performance is often wrong (e.g., \"pointers are always faster\" is false for small structs).",[27,1350,1352],{"id":1351},"tips-tricks","💡 Tips & Tricks",[74,1354,1355,1365,1387,1396,1405],{},[77,1356,1357,1360,1361,1364],{},[98,1358,1359],{},"Idiom",": profile before optimizing — run ",[18,1362,1363],{},"go tool pprof"," on a CPU or heap profile and find the actual hotspot. Intuition about Go performance is often wrong (escape analysis, inlining, GC interactions are non-obvious). Optimizing a non-hotspot is wasted effort.",[77,1366,1367,1369,1370,1372,1373,1375,1376,334,1379,1381,1382,775,1384,1386],{},[98,1368,1359],{},": reduce allocations first — ",[18,1371,93],{}," is the key metric for most Go programs (heap allocations trigger GC pressure). ",[18,1374,451],{},", pre-sized ",[18,1377,1378],{},"make([]T, 0, n)",[18,1380,863],{},", and avoiding ",[18,1383,774],{},[18,1385,752],{}," conversions are the standard allocation reducers, often yielding more than CPU micro-optimization.",[77,1388,1389,1391,1392,1395],{},[98,1390,1359],{},": use ",[18,1393,1394],{},"go build -gcflags=\"-m\""," to see escape analysis — it prints \"moved to heap: x\" (escapes, heap-allocated, GC'd) vs \"x does not escape\" (stack-allocated, free). This tells you whether your \"optimization\" (e.g., passing a pointer) actually avoided an allocation or forced one.",[77,1397,1398,1400,1401,1404],{},[98,1399,1359],{},": run ",[18,1402,1403],{},"go test -race"," in CI — the race detector finds data races (concurrent reads\u002Fwrites without synchronization) that are nearly impossible to find by inspection. It has overhead (use in testing, not production), but a race it finds is a real bug.",[77,1406,1407,1409,1410,1413,1414,1417],{},[98,1408,1359],{},": benchmark with ",[18,1411,1412],{},"-count=5"," (or more) and look at variance — a single benchmark run is noisy (GC, scheduler, system load). Multiple runs let you distinguish real improvements from noise. ",[18,1415,1416],{},"benchstat"," compares two sets of benchmark results statistically.",[27,1419,1421],{"id":1420},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[74,1423,1424,1430,1447,1453,1465,1478,1487,1493,1503,1509],{},[77,1425,1426,1429],{},[98,1427,1428],{},"Premature optimization",": profile first — optimizing without a profile often targets the wrong code. \"The bottleneck is where you think it isn't.\"",[77,1431,1432,1435,1436,1439,1440,1443,1444,1446],{},[98,1433,1434],{},"Escape analysis can surprise",": returning ",[18,1437,1438],{},"&x"," forces ",[18,1441,1442],{},"x"," to the heap (necessary), but so does storing ",[18,1445,1438],{}," in an interface (the compiler can't know the concrete size). Assigning to an interface can be a hidden allocation.",[77,1448,1449,1452],{},[98,1450,1451],{},"Pointer vs value for small structs",": passing a small struct by value (copy) can be faster than a pointer (indirection + escape). Don't assume pointers are faster — benchmark.",[77,1454,1455,1460,1461,1464],{},[98,1456,1457,1459],{},[18,1458,20],{}," samples, doesn't trace",": CPU profiles sample at 100Hz by default — short-lived events may be missed. For exact tracing, use ",[18,1462,1463],{},"go tool trace"," (execution tracer).",[77,1466,1467,1473,1474,1477],{},[98,1468,1469,1470],{},"Heap profile needs ",[18,1471,1472],{},"runtime.MemProfileRate",": by default, the heap profile samples 1 in 524288 allocations. For more detail, set ",[18,1475,1476],{},"runtime.MemProfileRate = 1"," (every allocation — expensive).",[77,1479,1480,1483,1484,1486],{},[98,1481,1482],{},"Race detector overhead",": ",[18,1485,1184],{}," slows the program 10-100x and uses more memory. Don't run it in production. It catches races that actually execute — a race that doesn't fire in tests isn't detected.",[77,1488,1489,1492],{},[98,1490,1491],{},"Goroutine leaks show as memory growth",": a leaked goroutine holds its stack and any captured variables. The heap profile shows the captured allocations; the goroutine profile shows the stuck goroutines.",[77,1494,1495,1500,1501,533],{},[98,1496,1497,1499],{},[18,1498,863],{}," isn't a cache",": pooled objects can be reclaimed at any time (between GCs). Don't use it for stateful objects that must persist. Reset objects before ",[18,1502,972],{},[77,1504,1505,1508],{},[98,1506,1507],{},"Benchmark dead-code elimination",": if the benchmark's result is unused, the compiler may optimize it away, showing 0 ns\u002Fop. Assign to a package-level sink var.",[77,1510,1511,1517,1518,1521],{},[98,1512,1513,1516],{},[18,1514,1515],{},"runtime.GOMAXPROCS"," and CPU-bound benchmarks",": benchmarks run with GOMAXPROCS = NumCPU. For single-threaded benchmarks, set ",[18,1519,1520],{},"runtime.GOMAXPROCS(1)"," to avoid parallelism skewing results.",[27,1523,1525],{"id":1524},"spot-the-bug","🧠 Spot the Bug",[14,1527,1528,1529,1533],{},"A developer optimizes a hot function by passing a pointer instead of a value, but the benchmark shows ",[1530,1531,1532],"em",{},"worse"," performance:",[32,1535,1536],{"language":51},[36,1537,1539],{"className":278,"code":1538,"language":51,"meta":40,"style":40},"type Point struct{ X, Y, Z float64 }   \u002F\u002F 24 bytes\n\n\u002F\u002F Before: value receiver\nfunc (p Point) Dist() float64 { ... }\n\n\u002F\u002F After: pointer receiver (hypothesis: avoid copy)\nfunc (p *Point) Dist() float64 { ... }\n",[18,1540,1541,1564,1568,1573,1601,1605,1610],{"__ignoreMap":40},[44,1542,1543,1546,1549,1552,1555,1558,1561],{"class":46,"line":47},[44,1544,1545],{"class":286},"type",[44,1547,1548],{"class":50}," Point",[44,1550,1551],{"class":286}," struct",[44,1553,1554],{"class":194},"{ X, Y, Z ",[44,1556,1557],{"class":286},"float64",[44,1559,1560],{"class":194}," }   ",[44,1562,1563],{"class":71},"\u002F\u002F 24 bytes\n",[44,1565,1566],{"class":46,"line":68},[44,1567,145],{"emptyLinePlaceholder":144},[44,1569,1570],{"class":46,"line":141},[44,1571,1572],{"class":71},"\u002F\u002F Before: value receiver\n",[44,1574,1575,1577,1580,1583,1586,1588,1591,1593,1595,1597,1599],{"class":46,"line":148},[44,1576,899],{"class":286},[44,1578,1579],{"class":194}," (",[44,1581,1582],{"class":1021},"p ",[44,1584,1585],{"class":50},"Point",[44,1587,200],{"class":194},[44,1589,1590],{"class":50},"Dist",[44,1592,902],{"class":194},[44,1594,1557],{"class":286},[44,1596,908],{"class":194},[44,1598,1031],{"class":286},[44,1600,1034],{"class":194},[44,1602,1603],{"class":46,"line":154},[44,1604,145],{"emptyLinePlaceholder":144},[44,1606,1607],{"class":46,"line":166},[44,1608,1609],{"class":71},"\u002F\u002F After: pointer receiver (hypothesis: avoid copy)\n",[44,1611,1612,1614,1616,1618,1620,1622,1624,1626,1628,1630,1632,1634],{"class":46,"line":171},[44,1613,899],{"class":286},[44,1615,1579],{"class":194},[44,1617,1582],{"class":1021},[44,1619,954],{"class":286},[44,1621,1585],{"class":50},[44,1623,200],{"class":194},[44,1625,1590],{"class":50},[44,1627,902],{"class":194},[44,1629,1557],{"class":286},[44,1631,908],{"class":194},[44,1633,1031],{"class":286},[44,1635,1034],{"class":194},[14,1637,1638],{},"What likely happened?",[1640,1641,1642,1646,1653,1695,1701,1704,1738,1747],"details",{},[1643,1644,1645],"summary",{},"Answer",[14,1647,1648,1649,1652],{},"For a small struct (24 bytes — 3 float64), passing by value (copying 24 bytes) is often ",[98,1650,1651],{},"faster"," than passing a pointer (8 bytes) because:",[1308,1654,1655,1658,1685],{},[77,1656,1657],{},"The value is passed in registers \u002F on the stack (no heap allocation, no GC).",[77,1659,1660,1661,1664,1665,1667,1668,1670,1671,1674,1675,1678,1679,1681,1682,1684],{},"A pointer-receiver method on a value (",[18,1662,1663],{},"p.Dist()"," where ",[18,1666,14],{}," is a ",[18,1669,1585],{},", not ",[18,1672,1673],{},"*Point",") forces the compiler to take ",[18,1676,1677],{},"&p"," — and if ",[18,1680,14],{}," is in an interface or the address escapes, ",[18,1683,14],{}," escapes to the heap (an allocation + GC pressure).",[77,1686,1687,1688,334,1691,1694],{},"Pointer indirection (dereferencing ",[18,1689,1690],{},"p.X",[18,1692,1693],{},"p.Y",") is a memory access; a value copy is a register move (faster on modern CPUs).",[14,1696,1697,1698,1700],{},"So the \"optimization\" (pointer receiver) introduced an escape (heap allocation) where the value receiver kept ",[18,1699,14],{}," on the stack — the benchmark got worse due to the allocation, not the copy.",[14,1702,1703],{},"The fix — measure and choose based on the benchmark. For small structs, value receivers are often faster (no escape, no indirection). For large structs or when the method mutates, pointer receivers are appropriate (chapter 11). Don't assume pointers are faster; benchmark both.",[36,1705,1707],{"className":278,"code":1706,"language":51,"meta":40,"style":40},"\u002F\u002F Revert to value receiver for small structs\nfunc (p Point) Dist() float64 { ... }\n",[18,1708,1709,1714],{"__ignoreMap":40},[44,1710,1711],{"class":46,"line":47},[44,1712,1713],{"class":71},"\u002F\u002F Revert to value receiver for small structs\n",[44,1715,1716,1718,1720,1722,1724,1726,1728,1730,1732,1734,1736],{"class":46,"line":68},[44,1717,899],{"class":286},[44,1719,1579],{"class":194},[44,1721,1582],{"class":1021},[44,1723,1585],{"class":50},[44,1725,200],{"class":194},[44,1727,1590],{"class":50},[44,1729,902],{"class":194},[44,1731,1557],{"class":286},[44,1733,908],{"class":194},[44,1735,1031],{"class":286},[44,1737,1034],{"class":194},[14,1739,1740,1741,1743,1744,1746],{},"And run ",[18,1742,1394],{}," to confirm ",[18,1745,14],{}," doesn't escape.",[14,1748,1749,1752],{},[98,1750,1751],{},"The lesson",": for small structs, value receivers avoid escape (heap allocation) and indirection, often outperforming pointer receivers. Don't assume pointers are faster — benchmark and check escape analysis. Pointers win for large structs (avoid copy) or mutation; values win for small, read-only structs.",[27,1754,1755],{"id":1643},"Summary",[14,1757,1758,1759,334,1762,1765,1766,1768,1769,1375,1771,334,1774,1776,1777,1780],{},"You can now benchmark (",[18,1760,1761],{},"-benchmem",[18,1763,1764],{},"-count","), profile with ",[18,1767,20],{}," (CPU, heap, goroutine), reduce allocations (",[18,1770,451],{},[18,1772,1773],{},"make",[18,1775,863],{},", avoiding conversions), understand escape analysis (",[18,1778,1779],{},"-gcflags=\"-m\"","), use the race detector, and follow the profile-optimize-rebenchmark process — without falling for the pointer-is-always-faster myth. Next: exercises and projects.",[1782,1783,1784],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}",{"title":40,"searchDepth":68,"depth":68,"links":1786},[1787,1788,1793],{"id":29,"depth":68,"text":30},{"id":107,"depth":68,"text":1789,"children":1790},"pprof — CPU and Heap Profiling",[1791,1792],{"id":114,"depth":141,"text":115},{"id":261,"depth":141,"text":262},{"id":1643,"depth":68,"text":1755},"Go has excellent profiling built in via pprof and the testing package's benchmarks. This chapter covers finding and fixing performance issues.","md",{},"\u002Fgo\u002F27-profiling-and-performance",{"title":5,"description":1794},"go\u002F27-profiling-and-performance","--qub2bzkrofYl69w_BSDc0odLFbzbrro1dbep4UaI4",1786908610253]