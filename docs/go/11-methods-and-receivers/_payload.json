[{"data":1,"prerenderedAt":1417},["ShallowReactive",2],{"page-\u002Fgo\u002F11-methods-and-receivers":3},{"id":4,"title":5,"body":6,"description":1410,"extension":1411,"meta":1412,"navigation":71,"path":1413,"seo":1414,"stem":1415,"__hash__":1416},"content\u002Fgo\u002F11-methods-and-receivers.md","11 — Methods & Receivers",{"type":7,"value":8,"toc":1398},"minimark",[9,13,22,27,613,616,620,623,870,873,877,960,964,1083,1087,1098,1240,1250,1388,1391,1394],[10,11,5],"h1",{"id":12},"_11-methods-receivers",[14,15,16,17,21],"p",{},"Methods are functions with a ",[18,19,20],"strong",{},"receiver"," — a special parameter that binds the function to a type. They're Go's closest analog to object methods, without classes.",[23,24,26],"h2",{"id":25},"declaration","Declaration",[28,29,31,338,341,346,390,394,405,409,416,440],"code-wrapper",{"language":30},"go",[32,33,37],"pre",{"className":34,"code":35,"language":30,"meta":36,"style":36},"language-go shiki shiki-themes github-light github-dark","type Circle struct{ Radius float64 }\n\n\u002F\u002F Value receiver\nfunc (c Circle) Area() float64 {\n    return math.Pi * c.Radius * c.Radius\n}\n\nc := Circle{Radius: 5}\nc.Area()   \u002F\u002F 78.54\n``\n::\n\nThe receiver `(c Circle)` is the first parameter, written before the method name. `c` is the receiver — the instance the method is called on.\n\n## Value vs Pointer Receivers\n\n::code-wrapper{language=\"go\"}\n```go\n\u002F\u002F Value receiver — operates on a copy; can't mutate the original\nfunc (c Circle) Scale(f float64) {\n    c.Radius *= f   \u002F\u002F modifies the copy, not the original\n}\nc := Circle{Radius: 5}\nc.Scale(2)\nfmt.Println(c.Radius)   \u002F\u002F 5 (unchanged — Scale got a copy)\n\n\u002F\u002F Pointer receiver — operates on the original; can mutate\nfunc (c *Circle) Scale(f float64) {\n    c.Radius *= f   \u002F\u002F modifies the original\n}\nc := &Circle{Radius: 5}\nc.Scale(2)\nfmt.Println(c.Radius)   \u002F\u002F 10\n","",[38,39,40,66,73,80,110,130,136,141,160,174,181,187,192,210,215,221,226,246,252,258,264,270,275,281,287,293,298,304,310,316,321,327,332],"code",{"__ignoreMap":36},[41,42,45,49,53,56,60,63],"span",{"class":43,"line":44},"line",1,[41,46,48],{"class":47},"svdQ7","type",[41,50,52],{"class":51},"sIsaT"," Circle",[41,54,55],{"class":47}," struct",[41,57,59],{"class":58},"ssxIu","{ Radius ",[41,61,62],{"class":47},"float64",[41,64,65],{"class":58}," }\n",[41,67,69],{"class":43,"line":68},2,[41,70,72],{"emptyLinePlaceholder":71},true,"\n",[41,74,76],{"class":43,"line":75},3,[41,77,79],{"class":78},"sdCPZ","\u002F\u002F Value receiver\n",[41,81,83,86,89,93,96,99,102,105,107],{"class":43,"line":82},4,[41,84,85],{"class":47},"func",[41,87,88],{"class":58}," (",[41,90,92],{"class":91},"sCrzJ","c ",[41,94,95],{"class":51},"Circle",[41,97,98],{"class":58},") ",[41,100,101],{"class":51},"Area",[41,103,104],{"class":58},"() ",[41,106,62],{"class":47},[41,108,109],{"class":58}," {\n",[41,111,113,116,119,122,125,127],{"class":43,"line":112},5,[41,114,115],{"class":47},"    return",[41,117,118],{"class":58}," math.Pi ",[41,120,121],{"class":47},"*",[41,123,124],{"class":58}," c.Radius ",[41,126,121],{"class":47},[41,128,129],{"class":58}," c.Radius\n",[41,131,133],{"class":43,"line":132},6,[41,134,135],{"class":58},"}\n",[41,137,139],{"class":43,"line":138},7,[41,140,72],{"emptyLinePlaceholder":71},[41,142,144,146,149,151,154,158],{"class":43,"line":143},8,[41,145,92],{"class":58},[41,147,148],{"class":47},":=",[41,150,52],{"class":51},[41,152,153],{"class":58},"{Radius: ",[41,155,157],{"class":156},"snvgF","5",[41,159,135],{"class":58},[41,161,163,166,168,171],{"class":43,"line":162},9,[41,164,165],{"class":58},"c.",[41,167,101],{"class":51},[41,169,170],{"class":58},"()   ",[41,172,173],{"class":78},"\u002F\u002F 78.54\n",[41,175,177],{"class":43,"line":176},10,[41,178,180],{"class":179},"sJ6F3","``\n",[41,182,184],{"class":43,"line":183},11,[41,185,186],{"class":58},"::\n",[41,188,190],{"class":43,"line":189},12,[41,191,72],{"emptyLinePlaceholder":71},[41,193,195,198,201,204,207],{"class":43,"line":194},13,[41,196,197],{"class":58},"The receiver ",[41,199,200],{"class":179},"`(c Circle)`",[41,202,203],{"class":58}," is the first parameter, written before the method name. ",[41,205,206],{"class":179},"`c`",[41,208,209],{"class":58}," is the receiver — the instance the method is called on.\n",[41,211,213],{"class":43,"line":212},14,[41,214,72],{"emptyLinePlaceholder":71},[41,216,218],{"class":43,"line":217},15,[41,219,220],{"class":58},"## Value vs Pointer Receivers\n",[41,222,224],{"class":43,"line":223},16,[41,225,72],{"emptyLinePlaceholder":71},[41,227,229,232,235,238,241,244],{"class":43,"line":228},17,[41,230,231],{"class":58},"::code",[41,233,234],{"class":47},"-",[41,236,237],{"class":58},"wrapper{language",[41,239,240],{"class":47},"=",[41,242,243],{"class":179},"\"go\"",[41,245,135],{"class":58},[41,247,249],{"class":43,"line":248},18,[41,250,251],{"class":179},"```go\n",[41,253,255],{"class":43,"line":254},19,[41,256,257],{"class":179},"\u002F\u002F Value receiver — operates on a copy; can't mutate the original\n",[41,259,261],{"class":43,"line":260},20,[41,262,263],{"class":179},"func (c Circle) Scale(f float64) {\n",[41,265,267],{"class":43,"line":266},21,[41,268,269],{"class":179},"    c.Radius *= f   \u002F\u002F modifies the copy, not the original\n",[41,271,273],{"class":43,"line":272},22,[41,274,135],{"class":179},[41,276,278],{"class":43,"line":277},23,[41,279,280],{"class":179},"c := Circle{Radius: 5}\n",[41,282,284],{"class":43,"line":283},24,[41,285,286],{"class":179},"c.Scale(2)\n",[41,288,290],{"class":43,"line":289},25,[41,291,292],{"class":179},"fmt.Println(c.Radius)   \u002F\u002F 5 (unchanged — Scale got a copy)\n",[41,294,296],{"class":43,"line":295},26,[41,297,72],{"emptyLinePlaceholder":71},[41,299,301],{"class":43,"line":300},27,[41,302,303],{"class":179},"\u002F\u002F Pointer receiver — operates on the original; can mutate\n",[41,305,307],{"class":43,"line":306},28,[41,308,309],{"class":179},"func (c *Circle) Scale(f float64) {\n",[41,311,313],{"class":43,"line":312},29,[41,314,315],{"class":179},"    c.Radius *= f   \u002F\u002F modifies the original\n",[41,317,319],{"class":43,"line":318},30,[41,320,135],{"class":179},[41,322,324],{"class":43,"line":323},31,[41,325,326],{"class":179},"c := &Circle{Radius: 5}\n",[41,328,330],{"class":43,"line":329},32,[41,331,286],{"class":179},[41,333,335],{"class":43,"line":334},33,[41,336,337],{"class":179},"fmt.Println(c.Radius)   \u002F\u002F 10\n",[14,339,340],{},"::",[342,343,345],"h3",{"id":344},"choosing-value-vs-pointer","Choosing value vs pointer",[347,348,349,362],"table",{},[350,351,352],"thead",{},[353,354,355,359],"tr",{},[356,357,358],"th",{},"Use value receiver when",[356,360,361],{},"Use pointer receiver when",[363,364,365,374,382],"tbody",{},[353,366,367,371],{},[368,369,370],"td",{},"The method doesn't mutate the receiver",[368,372,373],{},"The method mutates the receiver",[353,375,376,379],{},[368,377,378],{},"The receiver is small (a few words)",[368,380,381],{},"The receiver is large (avoid copy)",[353,383,384,387],{},[368,385,386],{},"You want value semantics (immutability)",[368,388,389],{},"You want shared\u002Fmutable semantics",[342,391,393],{"id":392},"consistency-rule","Consistency rule",[14,395,396,399,400,404],{},[18,397,398],{},"All methods on a type should have the same receiver kind"," (all value or all pointer). Mixing causes method-set confusion and is flagged by linters. If any method needs a pointer receiver (it mutates), make ",[401,402,403],"em",{},"all"," methods pointer receivers.",[23,406,408],{"id":407},"method-sets-and-interfaces","Method Sets and Interfaces",[14,410,411,412,415],{},"A type's ",[18,413,414],{},"method set"," determines which interfaces it satisfies:",[417,418,419,430],"ul",{},[420,421,422,425,426,429],"li",{},[38,423,424],{},"T"," (value type) — method set is its ",[18,427,428],{},"value-receiver methods"," only.",[420,431,432,435,436,439],{},[38,433,434],{},"*T"," (pointer type) — method set is ",[18,437,438],{},"all methods"," (value + pointer receivers).",[28,441,442],{"language":30},[32,443,445],{"className":34,"code":444,"language":30,"meta":36,"style":36},"type Shape interface{ Area() float64 }\n\ntype Circle struct{ Radius float64 }\nfunc (c Circle) Area() float64 { return math.Pi * c.Radius * c.Radius }   \u002F\u002F value receiver\n\nvar s Shape\ns = Circle{Radius: 5}    \u002F\u002F OK — Circle's method set includes Area\ns = &Circle{Radius: 5}   \u002F\u002F OK — *Circle has all of Circle's methods\n\n\u002F\u002F If Area had a pointer receiver:\n\u002F\u002F func (c *Circle) Area() float64 { ... }\n\u002F\u002F s = Circle{Radius: 5}    \u002F\u002F ERROR — Circle's method set doesn't include *Circle's Area\n\u002F\u002F s = &Circle{Radius: 5}   \u002F\u002F OK\n``\n",[38,446,447,468,472,486,524,528,539,558,579,583,588,593,601,609],{"__ignoreMap":36},[41,448,449,451,454,457,460,462,464,466],{"class":43,"line":44},[41,450,48],{"class":47},[41,452,453],{"class":51}," Shape",[41,455,456],{"class":47}," interface",[41,458,459],{"class":58},"{ ",[41,461,101],{"class":51},[41,463,104],{"class":58},[41,465,62],{"class":47},[41,467,65],{"class":58},[41,469,470],{"class":43,"line":68},[41,471,72],{"emptyLinePlaceholder":71},[41,473,474,476,478,480,482,484],{"class":43,"line":75},[41,475,48],{"class":47},[41,477,52],{"class":51},[41,479,55],{"class":47},[41,481,59],{"class":58},[41,483,62],{"class":47},[41,485,65],{"class":58},[41,487,488,490,492,494,496,498,500,502,504,507,510,512,514,516,518,521],{"class":43,"line":82},[41,489,85],{"class":47},[41,491,88],{"class":58},[41,493,92],{"class":91},[41,495,95],{"class":51},[41,497,98],{"class":58},[41,499,101],{"class":51},[41,501,104],{"class":58},[41,503,62],{"class":47},[41,505,506],{"class":58}," { ",[41,508,509],{"class":47},"return",[41,511,118],{"class":58},[41,513,121],{"class":47},[41,515,124],{"class":58},[41,517,121],{"class":47},[41,519,520],{"class":58}," c.Radius }   ",[41,522,523],{"class":78},"\u002F\u002F value receiver\n",[41,525,526],{"class":43,"line":112},[41,527,72],{"emptyLinePlaceholder":71},[41,529,530,533,536],{"class":43,"line":132},[41,531,532],{"class":47},"var",[41,534,535],{"class":58}," s ",[41,537,538],{"class":51},"Shape\n",[41,540,541,544,546,548,550,552,555],{"class":43,"line":138},[41,542,543],{"class":58},"s ",[41,545,240],{"class":47},[41,547,52],{"class":51},[41,549,153],{"class":58},[41,551,157],{"class":156},[41,553,554],{"class":58},"}    ",[41,556,557],{"class":78},"\u002F\u002F OK — Circle's method set includes Area\n",[41,559,560,562,564,567,569,571,573,576],{"class":43,"line":143},[41,561,543],{"class":58},[41,563,240],{"class":47},[41,565,566],{"class":47}," &",[41,568,95],{"class":51},[41,570,153],{"class":58},[41,572,157],{"class":156},[41,574,575],{"class":58},"}   ",[41,577,578],{"class":78},"\u002F\u002F OK — *Circle has all of Circle's methods\n",[41,580,581],{"class":43,"line":162},[41,582,72],{"emptyLinePlaceholder":71},[41,584,585],{"class":43,"line":176},[41,586,587],{"class":78},"\u002F\u002F If Area had a pointer receiver:\n",[41,589,590],{"class":43,"line":183},[41,591,592],{"class":78},"\u002F\u002F func (c *Circle) Area() float64 { ... }\n",[41,594,595,598],{"class":43,"line":189},[41,596,597],{"class":78},"\u002F\u002F s = Circle{Radius: 5}",[41,599,600],{"class":78},"    \u002F\u002F ERROR — Circle's method set doesn't include *Circle's Area\n",[41,602,603,606],{"class":43,"line":194},[41,604,605],{"class":78},"\u002F\u002F s = &Circle{Radius: 5}",[41,607,608],{"class":78},"   \u002F\u002F OK\n",[41,610,611],{"class":43,"line":212},[41,612,180],{"class":179},[14,614,615],{},"This is the crux: a value can't satisfy an interface requiring a pointer-receiver method. Store\u002Fuse a pointer if any method is pointer-receiver.",[23,617,619],{"id":618},"method-promotion-embedding","Method Promotion (Embedding)",[14,621,622],{},"Methods of an embedded type are promoted to the outer type:",[28,624,625],{"language":30},[32,626,628],{"className":34,"code":627,"language":30,"meta":36,"style":36},"type Animal struct{ Name string }\nfunc (a Animal) Speak() string { return a.Name + \" speaks\" }\n\ntype Dog struct{ Animal }\nfunc (d Dog) Bark() string { return d.Name + \" barks\" }\n\nd := Dog{Animal: Animal{Name: \"Rex\"}}\nd.Speak()   \u002F\u002F \"Rex speaks\" (promoted from Animal)\nd.Bark()    \u002F\u002F \"Rex barks\" (Dog's own)\n``\n::\n\nThe outer type can \"override\" by defining a method with the same name — but it shadows (no virtual dispatch).\n\n## Pointer-Receiver Method Calls on Values\n\n::code-wrapper{language=\"go\"}\n```go\nc := Circle{Radius: 5}   \u002F\u002F value\nc.Scale(2)               \u002F\u002F OK — Go auto-takes &c for the pointer receiver\n(&c).Scale(2)            \u002F\u002F explicit, equivalent\n``\n",[38,629,630,647,683,687,702,737,741,763,775,787,791,795,799,815,819,829,833,847,851,856,861,866],{"__ignoreMap":36},[41,631,632,634,637,639,642,645],{"class":43,"line":44},[41,633,48],{"class":47},[41,635,636],{"class":51}," Animal",[41,638,55],{"class":47},[41,640,641],{"class":58},"{ Name ",[41,643,644],{"class":47},"string",[41,646,65],{"class":58},[41,648,649,651,653,656,659,661,664,666,668,670,672,675,678,681],{"class":43,"line":68},[41,650,85],{"class":47},[41,652,88],{"class":58},[41,654,655],{"class":91},"a ",[41,657,658],{"class":51},"Animal",[41,660,98],{"class":58},[41,662,663],{"class":51},"Speak",[41,665,104],{"class":58},[41,667,644],{"class":47},[41,669,506],{"class":58},[41,671,509],{"class":47},[41,673,674],{"class":58}," a.Name ",[41,676,677],{"class":47},"+",[41,679,680],{"class":179}," \" speaks\"",[41,682,65],{"class":58},[41,684,685],{"class":43,"line":75},[41,686,72],{"emptyLinePlaceholder":71},[41,688,689,691,694,696,698,700],{"class":43,"line":82},[41,690,48],{"class":47},[41,692,693],{"class":51}," Dog",[41,695,55],{"class":47},[41,697,459],{"class":58},[41,699,658],{"class":51},[41,701,65],{"class":58},[41,703,704,706,708,711,714,716,719,721,723,725,727,730,732,735],{"class":43,"line":112},[41,705,85],{"class":47},[41,707,88],{"class":58},[41,709,710],{"class":91},"d ",[41,712,713],{"class":51},"Dog",[41,715,98],{"class":58},[41,717,718],{"class":51},"Bark",[41,720,104],{"class":58},[41,722,644],{"class":47},[41,724,506],{"class":58},[41,726,509],{"class":47},[41,728,729],{"class":58}," d.Name ",[41,731,677],{"class":47},[41,733,734],{"class":179}," \" barks\"",[41,736,65],{"class":58},[41,738,739],{"class":43,"line":132},[41,740,72],{"emptyLinePlaceholder":71},[41,742,743,745,747,749,752,754,757,760],{"class":43,"line":138},[41,744,710],{"class":58},[41,746,148],{"class":47},[41,748,693],{"class":51},[41,750,751],{"class":58},"{Animal: ",[41,753,658],{"class":51},[41,755,756],{"class":58},"{Name: ",[41,758,759],{"class":179},"\"Rex\"",[41,761,762],{"class":58},"}}\n",[41,764,765,768,770,772],{"class":43,"line":143},[41,766,767],{"class":58},"d.",[41,769,663],{"class":51},[41,771,170],{"class":58},[41,773,774],{"class":78},"\u002F\u002F \"Rex speaks\" (promoted from Animal)\n",[41,776,777,779,781,784],{"class":43,"line":162},[41,778,767],{"class":58},[41,780,718],{"class":51},[41,782,783],{"class":58},"()    ",[41,785,786],{"class":78},"\u002F\u002F \"Rex barks\" (Dog's own)\n",[41,788,789],{"class":43,"line":176},[41,790,180],{"class":179},[41,792,793],{"class":43,"line":183},[41,794,186],{"class":58},[41,796,797],{"class":43,"line":189},[41,798,72],{"emptyLinePlaceholder":71},[41,800,801,804,806,809,812],{"class":43,"line":194},[41,802,803],{"class":58},"The outer ",[41,805,48],{"class":47},[41,807,808],{"class":58}," can ",[41,810,811],{"class":179},"\"override\"",[41,813,814],{"class":58}," by defining a method with the same name — but it shadows (no virtual dispatch).\n",[41,816,817],{"class":43,"line":212},[41,818,72],{"emptyLinePlaceholder":71},[41,820,821,824,826],{"class":43,"line":217},[41,822,823],{"class":58},"## Pointer",[41,825,234],{"class":47},[41,827,828],{"class":58},"Receiver Method Calls on Values\n",[41,830,831],{"class":43,"line":223},[41,832,72],{"emptyLinePlaceholder":71},[41,834,835,837,839,841,843,845],{"class":43,"line":228},[41,836,231],{"class":58},[41,838,234],{"class":47},[41,840,237],{"class":58},[41,842,240],{"class":47},[41,844,243],{"class":179},[41,846,135],{"class":58},[41,848,849],{"class":43,"line":248},[41,850,251],{"class":179},[41,852,853],{"class":43,"line":254},[41,854,855],{"class":179},"c := Circle{Radius: 5}   \u002F\u002F value\n",[41,857,858],{"class":43,"line":260},[41,859,860],{"class":179},"c.Scale(2)               \u002F\u002F OK — Go auto-takes &c for the pointer receiver\n",[41,862,863],{"class":43,"line":266},[41,864,865],{"class":179},"(&c).Scale(2)            \u002F\u002F explicit, equivalent\n",[41,867,868],{"class":43,"line":272},[41,869,180],{"class":179},[14,871,872],{},"Go automatically takes the address of an addressable value when calling a pointer-receiver method. But this doesn't work for map values (not addressable) or temporary values in some cases.",[23,874,876],{"id":875},"tips-tricks","💡 Tips & Tricks",[417,878,879,896,909,926,943],{},[420,880,881,884,885,887,888,891,892,895],{},[18,882,883],{},"Idiom",": use pointer receivers consistently within a type — if any method mutates (needs a pointer receiver), make ",[401,886,403],{}," methods pointer receivers. Mixing value and pointer receivers causes method-set confusion (a value doesn't satisfy interfaces requiring pointer-receiver methods) and is flagged by ",[38,889,890],{},"go vet","\u002F",[38,893,894],{},"golangci-lint",".",[420,897,898,900,901,904,905,908],{},[18,899,883],{},": use value receivers for small, immutable types (a ",[38,902,903],{},"Point",", a ",[38,906,907],{},"Time",") — copies are cheap and the immutability is a feature. Use pointer receivers for large structs or when the method mutates. The default is value; reach for pointer deliberately.",[420,910,911,913,914,917,918,921,922,925],{},[18,912,883],{},": use embedding for method promotion — ",[38,915,916],{},"type Service struct { Logger }"," gives ",[38,919,920],{},"Service"," the ",[38,923,924],{},"Logger","'s methods without writing delegation wrappers. The outer type can shadow a promoted method by defining its own (no virtual dispatch — resolved at compile time).",[420,927,928,930,931,934,935,938,939,942],{},[18,929,883],{},": receiver name should be short (1-2 letters, often the first letter of the type) — ",[38,932,933],{},"func (c Circle) Area()",", ",[38,936,937],{},"func (u *User) Save()",". Consistent receiver names across a type's methods improve readability; ",[38,940,941],{},"gofmt"," aligns them.",[420,944,945,948,949,952,953,955,956,959],{},[18,946,947],{},"Debug",": ",[38,950,951],{},"var i Interface = T{}"," failing with \"does not implement Interface (method X has pointer receiver)\" means a method is on ",[38,954,434],{}," but you're using a value — use ",[38,957,958],{},"&T{}"," or change the receiver to value.",[23,961,963],{"id":962},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[417,965,966,978,990,996,1007,1028,1047,1060],{},[420,967,968,948,971,974,975,895],{},[18,969,970],{},"Value receiver can't mutate",[38,972,973],{},"func (c Circle) Scale()"," modifies a copy — the original is unchanged. If you need mutation, use ",[38,976,977],{},"*Circle",[420,979,980,948,983,986,987,895],{},[18,981,982],{},"Pointer receiver on an unaddressable value",[38,984,985],{},"Circle{5}.Scale(2)"," (pointer receiver) fails — the literal isn't addressable. Use a variable: ",[38,988,989],{},"c := Circle{5}; c.Scale(2)",[420,991,992,995],{},[18,993,994],{},"Method set and interfaces",": a value type doesn't satisfy interfaces requiring pointer-receiver methods. This is the most common \"doesn't implement interface\" confusion.",[420,997,998,1001,1002,891,1004,1006],{},[18,999,1000],{},"Mixing receiver kinds is allowed but discouraged",": Go permits it, but ",[38,1003,890],{},[38,1005,894],{}," warn. The method-set asymmetry causes subtle interface bugs.",[420,1008,1009,948,1012,1015,1016,1019,1020,1023,1024,1027],{},[18,1010,1011],{},"Pointer-receiver method on a map value",[38,1013,1014],{},"m[key].Method()"," fails if ",[38,1017,1018],{},"Method"," is pointer-receiver (map values aren't addressable). Copy out: ",[38,1021,1022],{},"v := m[key]; v.Method()"," — but this calls the value-receiver method on a copy. Use ",[38,1025,1026],{},"map[K]*V"," if you need pointer methods on map values.",[420,1029,1030,948,1033,1036,1037,1040,1041,1044,1045,895],{},[18,1031,1032],{},"Receiver name consistency",[38,1034,1035],{},"func (c Circle) A()"," and ",[38,1038,1039],{},"func (circle Circle) B()"," — inconsistent receiver names. Use the same name (",[38,1042,1043],{},"c",") across all methods of ",[38,1046,95],{},[420,1048,1049,948,1052,1055,1056,1059],{},[18,1050,1051],{},"Methods on non-struct types",[38,1053,1054],{},"type MyInt int; func (m MyInt) IsEven() bool { return m%2 == 0 }"," — methods can be on any named type (not on imported types or unnamed types like ",[38,1057,1058],{},"[]int",").",[420,1061,1062,948,1065,1068,1069,1072,1073,1076,1077,1079,1080,1059],{},[18,1063,1064],{},"Method on a pointer type",[38,1066,1067],{},"func (p *Point) Reset()"," — the receiver is ",[38,1070,1071],{},"*Point",". Calling ",[38,1074,1075],{},"p.Reset()"," on a nil ",[38,1078,1071],{}," panics (unless the method handles nil — possible: ",[38,1081,1082],{},"func (p *Point) Safe() { if p == nil { return }; ... }",[23,1084,1086],{"id":1085},"spot-the-bug","🧠 Spot the Bug",[14,1088,1089,1090,1093,1094,1097],{},"A developer implements ",[38,1091,1092],{},"String()"," on a value receiver and gets unexpected output from ",[38,1095,1096],{},"fmt.Println",":",[28,1099,1100],{"language":30},[32,1101,1103],{"className":34,"code":1102,"language":30,"meta":36,"style":36},"type User struct{ Name string }\nfunc (u User) String() string { return \"User: \" + u.Name }\n\nusers := map[int]User{1: {\"Alice\"}}\nfor _, u := range users {\n    fmt.Println(u)   \u002F\u002F \"User: Alice\" — OK\n}\nfmt.Println(users)   \u002F\u002F \"map[1:{Alice}]\" — not \"User: Alice\"!\n",[38,1104,1105,1120,1154,1158,1193,1209,1223,1227],{"__ignoreMap":36},[41,1106,1107,1109,1112,1114,1116,1118],{"class":43,"line":44},[41,1108,48],{"class":47},[41,1110,1111],{"class":51}," User",[41,1113,55],{"class":47},[41,1115,641],{"class":58},[41,1117,644],{"class":47},[41,1119,65],{"class":58},[41,1121,1122,1124,1126,1129,1132,1134,1137,1139,1141,1143,1145,1148,1151],{"class":43,"line":68},[41,1123,85],{"class":47},[41,1125,88],{"class":58},[41,1127,1128],{"class":91},"u ",[41,1130,1131],{"class":51},"User",[41,1133,98],{"class":58},[41,1135,1136],{"class":51},"String",[41,1138,104],{"class":58},[41,1140,644],{"class":47},[41,1142,506],{"class":58},[41,1144,509],{"class":47},[41,1146,1147],{"class":179}," \"User: \"",[41,1149,1150],{"class":47}," +",[41,1152,1153],{"class":58}," u.Name }\n",[41,1155,1156],{"class":43,"line":75},[41,1157,72],{"emptyLinePlaceholder":71},[41,1159,1160,1163,1165,1168,1171,1174,1177,1179,1182,1185,1188,1191],{"class":43,"line":82},[41,1161,1162],{"class":58},"users ",[41,1164,148],{"class":47},[41,1166,1167],{"class":47}," map",[41,1169,1170],{"class":58},"[",[41,1172,1173],{"class":47},"int",[41,1175,1176],{"class":58},"]",[41,1178,1131],{"class":51},[41,1180,1181],{"class":58},"{",[41,1183,1184],{"class":156},"1",[41,1186,1187],{"class":58},": {",[41,1189,1190],{"class":179},"\"Alice\"",[41,1192,762],{"class":58},[41,1194,1195,1198,1201,1203,1206],{"class":43,"line":112},[41,1196,1197],{"class":47},"for",[41,1199,1200],{"class":58}," _, u ",[41,1202,148],{"class":47},[41,1204,1205],{"class":47}," range",[41,1207,1208],{"class":58}," users {\n",[41,1210,1211,1214,1217,1220],{"class":43,"line":132},[41,1212,1213],{"class":58},"    fmt.",[41,1215,1216],{"class":51},"Println",[41,1218,1219],{"class":58},"(u)   ",[41,1221,1222],{"class":78},"\u002F\u002F \"User: Alice\" — OK\n",[41,1224,1225],{"class":43,"line":138},[41,1226,135],{"class":58},[41,1228,1229,1232,1234,1237],{"class":43,"line":143},[41,1230,1231],{"class":58},"fmt.",[41,1233,1216],{"class":51},[41,1235,1236],{"class":58},"(users)   ",[41,1238,1239],{"class":78},"\u002F\u002F \"map[1:{Alice}]\" — not \"User: Alice\"!\n",[14,1241,1242,1243,1246,1247,1249],{},"Why doesn't ",[38,1244,1245],{},"fmt.Println(users)"," use the ",[38,1248,1092],{}," method?",[1251,1252,1253,1257,1300,1319,1327,1333,1365,1371],"details",{},[1254,1255,1256],"summary",{},"Answer",[14,1258,1259,1262,1263,1265,1266,1269,1270,1272,1273,1275,1276,1279,1280,1282,1283,1285,1286,1289,1290,1293,1294,1296,1297,1299],{},[38,1260,1261],{},"fmt"," calls ",[38,1264,1092],{}," (if defined) on the ",[401,1267,1268],{},"top-level"," value passed to ",[38,1271,1216],{},". For ",[38,1274,1245],{},", the top-level value is a ",[38,1277,1278],{},"map[int]User"," — maps don't have a ",[38,1281,1092],{}," method, so ",[38,1284,1261],{}," prints the default map representation (",[38,1287,1288],{},"map[1:{Alice}]","). It does ",[401,1291,1292],{},"not"," recursively call ",[38,1295,1092],{}," on each ",[38,1298,1131],{}," value inside the map.",[14,1301,1302,1303,1306,1307,1309,1310,1312,1313,1315,1316,1318],{},"For ",[38,1304,1305],{},"fmt.Println(u)"," (a single ",[38,1308,1131],{},"), the top-level value is a ",[38,1311,1131],{},", which has ",[38,1314,1092],{},", so ",[38,1317,1261],{}," calls it.",[14,1320,1321,1322,1324,1325,895],{},"This isn't a bug — it's how ",[38,1323,1261],{}," works: it formats the value it's given, using that value's methods. A container (map\u002Fslice) prints its elements with their default formatting, not each element's ",[38,1326,1092],{},[14,1328,1329,1330,1332],{},"To print a map of users with each user's ",[38,1331,1092],{},", iterate and print each:",[32,1334,1336],{"className":34,"code":1335,"language":30,"meta":36,"style":36},"for _, u := range users {\n    fmt.Println(u)   \u002F\u002F \"User: Alice\"\n}\n",[38,1337,1338,1350,1361],{"__ignoreMap":36},[41,1339,1340,1342,1344,1346,1348],{"class":43,"line":44},[41,1341,1197],{"class":47},[41,1343,1200],{"class":58},[41,1345,148],{"class":47},[41,1347,1205],{"class":47},[41,1349,1208],{"class":58},[41,1351,1352,1354,1356,1358],{"class":43,"line":68},[41,1353,1213],{"class":58},[41,1355,1216],{"class":51},[41,1357,1219],{"class":58},[41,1359,1360],{"class":78},"\u002F\u002F \"User: Alice\"\n",[41,1362,1363],{"class":43,"line":75},[41,1364,135],{"class":58},[14,1366,1367,1368,1370],{},"Or implement ",[38,1369,1092],{}," on a custom map type (rare) or use a custom formatter.",[14,1372,1373,948,1376,1262,1378,1380,1381,1384,1385,895],{},[18,1374,1375],{},"The lesson",[38,1377,1261],{},[38,1379,1092],{}," on the value you pass, not on nested values inside containers. A ",[38,1382,1383],{},"map[K]V"," prints its values with default formatting, not ",[38,1386,1387],{},"V.String()",[23,1389,1390],{"id":1254},"Summary",[14,1392,1393],{},"You can now declare methods with value\u002Fpointer receivers, choose between them (consistency rule, mutation, size, method set), understand interface satisfaction via method sets, use method promotion via embedding, and avoid the value-can't-satisfy-pointer-interface and map-value-not-addressable traps. Next: interfaces — Go's abstraction mechanism.",[1395,1396,1397],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}",{"title":36,"searchDepth":68,"depth":68,"links":1399},[1400,1404,1405,1406,1407,1408,1409],{"id":25,"depth":68,"text":26,"children":1401},[1402,1403],{"id":344,"depth":75,"text":345},{"id":392,"depth":75,"text":393},{"id":407,"depth":68,"text":408},{"id":618,"depth":68,"text":619},{"id":875,"depth":68,"text":876},{"id":962,"depth":68,"text":963},{"id":1085,"depth":68,"text":1086},{"id":1254,"depth":68,"text":1390},"Methods are functions with a receiver — a special parameter that binds the function to a type. They're Go's closest analog to object methods, without classes.","md",{},"\u002Fgo\u002F11-methods-and-receivers",{"title":5,"description":1410},"go\u002F11-methods-and-receivers","FPfC9QmSp_KIb6rmo8NBK2IM_aOMFZsV1CzAV6W42hI",1786908610043]