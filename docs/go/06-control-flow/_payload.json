onditions; braces are ",[241,242,243],"strong",{},"mandatory"," even for one-line bodies (and the opening brace must be on the same line as ",[18,246,20],{},").",[45,249,250],{"id":24},[18,251,24],{},[14,253,254,255,257,258,21,260,262,263,265],{},"Go has one loop construct — ",[18,256,24],{}," — which serves as ",[18,259,38],{},[18,261,42],{}," (via infinite loop + break), and traditional ",[18,264,24],{},":",[50,267,268],{"language":52},[54,269,271],{"className":56,"code":270,"language":52,"meta":58,"style":58},"\u002F\u002F Traditional for\nfor i := 0; i \u003C 10; i++ {\n    fmt.Println(i)\n}\n\n\u002F\u002F While-like (condition only)\nn := 10\nfor n > 0 {\n    n--\n}\n\n\u002F\u002F Infinite loop\nfor {\n    if done {\n        break\n    }\n}\n\n\u002F\u002F Range (over slice, array, map, string, channel)\nfor i, v := range items {\n    fmt.Println(i, v)\n}\nfor _, v := range items {   \u002F\u002F discard index\n    fmt.Println(v)\n}\nfor k, v := range m {       \u002F\u002F map: key, value\n    fmt.Println(k, v)\n}\nfor i, r := range \"Hello\" { \u002F\u002F string: byte offset, rune\n    fmt.Println(i, r)\n}\nfor v := range ch {         \u002F\u002F channel: values until closed\n    fmt.Println(v)\n}\n``\n::\n\n### Range over integers (Go 1.22+)\n\nGo 1.22 added `range` over integers:\n\n::code-wrapper{language=\"go\"}\n```go\nfor i := range 10 {   \u002F\u002F i = 0, 1, ..., 9\n    fmt.Println(i)\n}\n``\n",[18,272,273,278,305,314,318,322,327,337,350,358,362,366,371,377,386,392,398,403,408,414,430,440,445,463,473,478,496,506,511,532,542,547,565,574,579,585,591,596,610,615,632,637,657,663,669,675,680],{"__ignoreMap":58},[62,274,275],{"class":64,"line":65},[62,276,277],{"class":179},"\u002F\u002F Traditional for\n",[62,279,280,282,285,287,289,292,294,297,300,303],{"class":64,"line":85},[62,281,24],{"class":68},[62,283,284],{"class":71}," i ",[62,286,191],{"class":68},[62,288,79],{"class":78},[62,290,291],{"class":71},"; i ",[62,293,119],{"class":68},[62,295,29