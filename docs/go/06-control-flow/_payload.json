[{"data":1,"prerenderedAt":1996},["ShallowReactive",2],{"page-\u002Fgo\u002F06-control-flow":3},{"id":4,"title":5,"body":6,"description":1989,"extension":1990,"meta":1991,"navigation":172,"path":1992,"seo":1993,"stem":1994,"__hash__":1995},"content\u002Fgo\u002F06-control-flow.md","06 — Control Flow",{"type":7,"value":8,"toc":1976},"minimark",[9,13,44,49,229,248,252,266,685,690,693,986,999,1003,1252,1259,1265,1270,1491,1504,1508,1590,1594,1762,1766,1769,1835,1946,1949,1972],[10,11,5],"h1",{"id":12},"_06-control-flow",[14,15,16,17,21,22,21,25,21,28,31,32,35,36,39,40,43],"p",{},"Go has minimal control flow: ",[18,19,20],"code",{},"if",", ",[18,23,24],{},"for",[18,26,27],{},"switch",[18,29,30],{},"select",", and ",[18,33,34],{},"goto",". No ",[18,37,38],{},"while",", no ",[18,41,42],{},"do-while",". This simplicity is deliberate — fewer constructs, less to learn, less to argue about.",[45,46,47],"h2",{"id":20},[18,48,20],{},[50,51,53],"code-wrapper",{"language":52},"go",[54,55,59],"pre",{"className":56,"code":57,"language":52,"meta":58,"style":58},"language-go shiki shiki-themes github-light github-dark","if x > 0 {\n    fmt.Println(\"positive\")\n} else if x \u003C 0 {\n    fmt.Println(\"negative\")\n} else {\n    fmt.Println(\"zero\")\n}\n\n\u002F\u002F if with an initialization statement\nif err := doSomething(); err != nil {\n    log.Fatal(err)\n}\n\u002F\u002F err is scoped to the if\u002Felse block — not visible outside\n","",[18,60,61,83,103,124,138,147,161,167,174,181,206,218,223],{"__ignoreMap":58},[62,63,66,69,73,76,80],"span",{"class":64,"line":65},"line",1,[62,67,20],{"class":68},"svdQ7",[62,70,72],{"class":71},"ssxIu"," x ",[62,74,75],{"class":68},">",[62,77,79],{"class":78},"snvgF"," 0",[62,81,82],{"class":71}," {\n",[62,84,86,89,93,96,100],{"class":64,"line":85},2,[62,87,88],{"class":71},"    fmt.",[62,90,92],{"class":91},"sIsaT","Println",[62,94,95],{"class":71},"(",[62,97,99],{"class":98},"sJ6F3","\"positive\"",[62,101,102],{"class":71},")\n",[62,104,1