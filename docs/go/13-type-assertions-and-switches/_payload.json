[{"data":1,"prerenderedAt":1588},["ShallowReactive",2],{"page-\u002Fgo\u002F13-type-assertions-and-switches":3},{"id":4,"title":5,"body":6,"description":16,"extension":1582,"meta":1583,"navigation":66,"path":1584,"seo":1585,"stem":1586,"__hash__":1587},"content\u002Fgo\u002F13-type-assertions-and-switches.md","13 — Type Assertions & Type Switches",{"type":7,"value":8,"toc":1576},"minimark",[9,13,17,22,288,295,299,647,658,662,665,1572],[10,11,5],"h1",{"id":12},"_13-type-assertions-type-switches",[14,15,16],"p",{},"To use a value held in an interface, you need to get the concrete type back. Go provides type assertions and type switches for this.",[18,19,21],"h2",{"id":20},"type-assertion","Type Assertion",[23,24,26],"code-wrapper",{"language":25},"go",[27,28,32],"pre",{"className":29,"code":30,"language":25,"meta":31,"style":31},"language-go shiki shiki-themes github-light github-dark","var i interface{} = \"hello\"\n\ns := i.(string)      \u002F\u002F asserts i holds a string; panics if not\nfmt.Println(s)       \u002F\u002F hello\n\n\u002F\u002F n := i.(int)      \u002F\u002F PANIC: interface conversion: interface {} is string, not int\n``\n::\n\nA type assertion `i.(T)` claims `i`'s dynamic type is `T`. If it's not, the program **panics**.\n\n## Comma-Ok Form\n\n::code-wrapper{language=\"go\"}\n```go\nvar i interface{} = \"hello\"\n\ns, ok := i.(string)   \u002F\u002F ok = true, s = \"hello\"\nn, ok := i.(int)      \u002F\u002F ok = false, n = 0 (zero value) — no panic\n\nif s, ok := i.(string); ok {\n    fmt.Println(\"string:\", s)\n} else {\n    fmt.Println(\"not a string\")\n}\n``\n","",[33,34,35,61,68,90,106,111,120,126,132,137,179,184,196,201,220,226,232,237,243,249,254,260,266,272,278,283],"code",{"__ignoreMap":31},[36,37,40,44,48,51,54,57],"span",{"class":38,"line":39},"line",1,[36,41,43],{"class":42},"svdQ7","var",[36,45,47],{"class":46},"ssxIu"," i ",[36,49,50],{"class":42},"interface",[36,52,53],{"class":46},"{} ",[36,55,56],{"class":42},"=",[36,58,60],{"class":59},"sJ6F3"," \"hello\"\n",[36,62,64],{"class":38,"line":63},2,[36,65,67],{"emptyLinePlaceholder":66},true,"\n",[36,69,71,74,77,80,83,86],{"class":38,"line":70},3,[36,72,73],{"class":46},"s ",[36,75,76],{"class":42},":=",[36,78,79],{"class":46}," i.(",[36,81,82],{"class":42},"string",[36,84,85],{"class":46},")      ",[36,87,89],{"class":88},"sdCPZ","\u002F\u002F asserts i holds a string; panics if not\n",[36,91,93,96,100,103],{"class":38,"line":92},4,[36,94,95],{"class":46},"fmt.",[36,97,99],{"class":98},"sIsaT","Println",[36,101,102],{"class":46},"(s)       ",[36,104,105],{"class":88},"\u002F\u002F hello\n",[36,107,109],{"class":38,"line":108},5,[36,110,67],{"emptyLinePlaceholder":66},[36,112,114,117],{"class":38,"line":113},6,[36,115,116],{"class":88},"\u002F\u002F n := i.(int)",[36,118,119],{"class":88},"      \u002F\u002F PANIC: interface conversion: interface {} is string, not int\n",[36,121,123],{"class":38,"line":122},7,[36,124,125],{"class":59},"``\n",[36,127,129],{"class":38,"line":128},8,[36,130,131],{"class":46},"::\n",[36,133,135],{"class":38,"line":134},9,[36,136,67],{"emptyLinePlaceholder":66},[36,138,140,143,146,149,152,155,158,162,165,168,171,174,176],{"class":38,"line":139},10,[36,141,142],{"class":46},"A ",[36,144,145],{"class":42},"type",[36,147,148],{"class":46}," assertion ",[36,150,151],{"class":59},"`i.(T)`",[36,153,154],{"class":46}," claims ",[36,156,157],{"class":59},"`i`'",[36,159,161],{"class":160},"sMKGj","s dynamic type is `T`. If it",[36,163,164],{"class":59},"'",[36,166,167],{"class":46},"s not, the program ",[36,169,170],{"class":42},"**",[36,172,173],{"class":46},"panics",[36,175,170],{"class":42},[36,177,178],{"class":46},".\n",[36,180,182],{"class":38,"line":181},11,[36,183,67],{"emptyLinePlaceholder":66},[36,185,187,190,193],{"class":38,"line":186},12,[36,188,189],{"class":46},"## Comma",[36,191,192],{"class":42},"-",[36,194,195],{"class":46},"Ok Form\n",[36,197,199],{"class":38,"line":198},13,[36,200,67],{"emptyLinePlaceholder":66},[36,202,204,207,209,212,214,217],{"class":38,"line":203},14,[36,205,206],{"class":46},"::code",[36,208,192],{"class":42},[36,210,211],{"class":46},"wrapper{language",[36,213,56],{"class":42},[36,215,216],{"class":59},"\"go\"",[36,218,219],{"class":46},"}\n",[36,221,223],{"class":38,"line":222},15,[36,224,225],{"class":59},"```go\n",[36,227,229],{"class":38,"line":228},16,[36,230,231],{"class":59},"var i interface{} = \"hello\"\n",[36,233,235],{"class":38,"line":234},17,[36,236,67],{"emptyLinePlaceholder":66},[36,238,240],{"class":38,"line":239},18,[36,241,242],{"class":59},"s, ok := i.(string)   \u002F\u002F ok = true, s = \"hello\"\n",[36,244,246],{"class":38,"line":245},19,[36,247,248],{"class":59},"n, ok := i.(int)      \u002F\u002F ok = false, n = 0 (zero value) — no panic\n",[36,250,252],{"class":38,"line":251},20,[36,253,67],{"emptyLinePlaceholder":66},[36,255,257],{"class":38,"line":256},21,[36,258,259],{"class":59},"if s, ok := i.(string); ok {\n",[36,261,263],{"class":38,"line":262},22,[36,264,265],{"class":59},"    fmt.Println(\"string:\", s)\n",[36,267,269],{"class":38,"line":268},23,[36,270,271],{"class":59},"} else {\n",[36,273,275],{"class":38,"line":274},24,[36,276,277],{"class":59},"    fmt.Println(\"not a string\")\n",[36,279,281],{"class":38,"line":280},25,[36,282,219],{"class":59},[36,284,286],{"class":38,"line":285},26,[36,287,125],{"class":59},[14,289,290,291,294],{},"The comma-ok form is the safe way — it never panics, returning ",[33,292,293],{},"(zeroValue, false)"," on a mismatch. Use this whenever the type isn't guaranteed.",[18,296,298],{"id":297},"type-switch","Type Switch",[23,300,301],{"language":25},[27,302,304],{"className":29,"code":303,"language":25,"meta":31,"style":31},"func describe(i interface{}) {\n    switch v := i.(type) {\n    case string:\n        fmt.Println(\"string of length\", len(v))\n    case int:\n        fmt.Println(\"int:\", v)\n    case []int:\n        fmt.Println(\"int slice:\", v)\n    case nil:\n        fmt.Println(\"nil\")\n    default:\n        fmt.Printf(\"unknown type %T: %v\\n\", v, v)\n    }\n}\n\ndescribe(\"hi\")      \u002F\u002F string of length 2\ndescribe(42)        \u002F\u002F int: 42\ndescribe(nil)       \u002F\u002F nil\n``\n::\n\n`switch v := i.(type)` — `v` has the asserted type in each case. This is the idiomatic way to dispatch on an interface's dynamic type.\n\n### Multiple types in a case\n\n::code-wrapper{language=\"go\"}\n```go\nswitch v := i.(type) {\ncase int, int64, uint:\n    fmt.Println(\"integer:\", v)   \u002F\u002F v has type interface{} here (multiple types)\ncase string:\n    fmt.Println(\"string:\", v)    \u002F\u002F v is string\n}\n``\n",[33,305,306,327,344,355,376,385,399,411,424,434,448,455,482,487,491,495,510,525,540,544,548,552,584,588,593,597,602,607,613,619,625,631,637,642],{"__ignoreMap":31},[36,307,308,311,314,317,321,324],{"class":38,"line":39},[36,309,310],{"class":42},"func",[36,312,313],{"class":98}," describe",[36,315,316],{"class":46},"(",[36,318,320],{"class":319},"sCrzJ","i",[36,322,323],{"class":42}," interface",[36,325,326],{"class":46},"{}) {\n",[36,328,329,332,335,337,339,341],{"class":38,"line":63},[36,330,331],{"class":42},"    switch",[36,333,334],{"class":46}," v ",[36,336,76],{"class":42},[36,338,79],{"class":46},[36,340,145],{"class":42},[36,342,343],{"class":46},") {\n",[36,345,346,349,352],{"class":38,"line":70},[36,347,348],{"class":42},"    case",[36,350,351],{"class":42}," string",[36,353,354],{"class":46},":\n",[36,356,357,360,362,364,367,370,373],{"class":38,"line":92},[36,358,359],{"class":46},"        fmt.",[36,361,99],{"class":98},[36,363,316],{"class":46},[36,365,366],{"class":59},"\"string of length\"",[36,368,369],{"class":46},", ",[36,371,372],{"class":98},"len",[36,374,375],{"class":46},"(v))\n",[36,377,378,380,383],{"class":38,"line":108},[36,379,348],{"class":42},[36,381,382],{"class":42}," int",[36,384,354],{"class":46},[36,386,387,389,391,393,396],{"class":38,"line":113},[36,388,359],{"class":46},[36,390,99],{"class":98},[36,392,316],{"class":46},[36,394,395],{"class":59},"\"int:\"",[36,397,398],{"class":46},", v)\n",[36,400,401,403,406,409],{"class":38,"line":122},[36,402,348],{"class":42},[36,404,405],{"class":46}," []",[36,407,408],{"class":42},"int",[36,410,354],{"class":46},[36,412,413,415,417,419,422],{"class":38,"line":128},[36,414,359],{"class":46},[36,416,99],{"class":98},[36,418,316],{"class":46},[36,420,421],{"class":59},"\"int slice:\"",[36,423,398],{"class":46},[36,425,426,428,432],{"class":38,"line":134},[36,427,348],{"class":42},[36,429,431],{"class":430},"snvgF"," nil",[36,433,354],{"class":46},[36,435,436,438,440,442,445],{"class":38,"line":139},[36,437,359],{"class":46},[36,439,99],{"class":98},[36,441,316],{"class":46},[36,443,444],{"class":59},"\"nil\"",[36,446,447],{"class":46},")\n",[36,449,450,453],{"class":38,"line":181},[36,451,452],{"class":42},"    default",[36,454,354],{"class":46},[36,456,457,459,462,464,467,470,473,476,479],{"class":38,"line":186},[36,458,359],{"class":46},[36,460,461],{"class":98},"Printf",[36,463,316],{"class":46},[36,465,466],{"class":59},"\"unknown type ",[36,468,469],{"class":430},"%T",[36,471,472],{"class":59},": ",[36,474,475],{"class":430},"%v\\n",[36,477,478],{"class":59},"\"",[36,480,481],{"class":46},", v, v)\n",[36,483,484],{"class":38,"line":198},[36,485,486],{"class":46},"    }\n",[36,488,489],{"class":38,"line":203},[36,490,219],{"class":46},[36,492,493],{"class":38,"line":222},[36,494,67],{"emptyLinePlaceholder":66},[36,496,497,500,502,505,507],{"class":38,"line":228},[36,498,499],{"class":98},"describe",[36,501,316],{"class":46},[36,503,504],{"class":59},"\"hi\"",[36,506,85],{"class":46},[36,508,509],{"class":88},"\u002F\u002F string of length 2\n",[36,511,512,514,516,519,522],{"class":38,"line":234},[36,513,499],{"class":98},[36,515,316],{"class":46},[36,517,518],{"class":430},"42",[36,520,521],{"class":46},")        ",[36,523,524],{"class":88},"\u002F\u002F int: 42\n",[36,526,527,529,531,534,537],{"class":38,"line":239},[36,528,499],{"class":98},[36,530,316],{"class":46},[36,532,533],{"class":430},"nil",[36,535,536],{"class":46},")       ",[36,538,539],{"class":88},"\u002F\u002F nil\n",[36,541,542],{"class":38,"line":245},[36,543,125],{"class":59},[36,545,546],{"class":38,"line":251},[36,547,131],{"class":46},[36,549,550],{"class":38,"line":256},[36,551,67],{"emptyLinePlaceholder":66},[36,553,554,557,560,563,566,568,571,574,577,579,581],{"class":38,"line":262},[36,555,556],{"class":59},"`switch v := i.(type)`",[36,558,559],{"class":46}," — ",[36,561,562],{"class":59},"`v`",[36,564,565],{"class":46}," has the asserted ",[36,567,145],{"class":42},[36,569,570],{"class":46}," in each ",[36,572,573],{"class":42},"case",[36,575,576],{"class":46},". This is the idiomatic way to dispatch on an ",[36,578,50],{"class":42},[36,580,164],{"class":59},[36,582,583],{"class":160},"s dynamic type.\n",[36,585,586],{"class":38,"line":268},[36,587,67],{"emptyLinePlaceholder":66},[36,589,590],{"class":38,"line":274},[36,591,592],{"class":160},"### Multiple types in a case\n",[36,594,595],{"class":38,"line":280},[36,596,67],{"emptyLinePlaceholder":66},[36,598,599],{"class":38,"line":285},[36,600,601],{"class":160},"::code-wrapper{language=\"go\"}\n",[36,603,605],{"class":38,"line":604},27,[36,606,225],{"class":160},[36,608,610],{"class":38,"line":609},28,[36,611,612],{"class":160},"switch v := i.(type) {\n",[36,614,616],{"class":38,"line":615},29,[36,617,618],{"class":160},"case int, int64, uint:\n",[36,620,622],{"class":38,"line":621},30,[36,623,624],{"class":160},"    fmt.Println(\"integer:\", v)   \u002F\u002F v has type interface{} here (multiple types)\n",[36,626,628],{"class":38,"line":627},31,[36,629,630],{"class":160},"case string:\n",[36,632,634],{"class":38,"line":633},32,[36,635,636],{"class":160},"    fmt.Println(\"string:\", v)    \u002F\u002F v is string\n",[36,638,640],{"class":38,"line":639},33,[36,641,219],{"class":160},[36,643,645],{"class":38,"line":644},34,[36,646,125],{"class":160},[14,648,649,650,653,654,657],{},"When multiple types share a case, ",[33,651,652],{},"v"," is ",[33,655,656],{},"interface{}"," (the original type), since it could be any of them.",[18,659,661],{"id":660},"assertion-to-an-interface","Assertion to an Interface",[14,663,664],{},"You can assert to another interface, not just a concrete type:",[23,666,667,1186,1189,1192,1560,1563],{"language":25},[27,668,670],{"className":29,"code":669,"language":25,"meta":31,"style":31},"var r io.Reader = strings.NewReader(\"hello\")\nra, ok := r.(io.ReaderAt)   \u002F\u002F does r also satisfy io.ReaderAt?\n\u002F\u002F strings.Reader doesn't, so ok = false\n``\n::\n\nThis checks whether the dynamic type satisfies a *different* interface — useful for optional capabilities.\n\n## 💡 Tips & Tricks\n\n- **Idiom**: use the comma-ok form (`v, ok := i.(T)`) whenever the type isn't guaranteed — the single-value form (`v := i.(T)`) panics on mismatch, which is almost never what you want in production code. Reserve the panicking form for cases where a mismatch is a genuine programming error (a violated invariant).\n- **Idiom**: use a type switch (`switch v := i.(type)`) for multi-type dispatch — it's clearer and safer than a chain of `if v, ok := i.(T); ok` checks. Each case binds `v` to the asserted type, so you can use it directly.\n- **Idiom**: prefer type switches over long assertion chains — `switch v := i.(type) { case int: ...; case string: ... }` is more readable than `if v, ok := i.(int); ok { ... } else if v, ok := i.(string); ok { ... }`.\n- **Idiom**: assert to interfaces, not just concrete types — `if ra, ok := r.(io.ReaderAt); ok` checks an optional capability. This is how the stdlib does feature-checking (e.g., `io.Writer` vs `io.WriterAt`).\n- **Debug**: `i.(T)` panicking with \"interface conversion: interface {} is X, not T\" means the dynamic type isn't `T` — use comma-ok to handle the mismatch gracefully, or fix the logic that put the wrong type in the interface.\n\n## ⚠️ Edge Cases & Gotchas\n\n- **`i.(T)` panics on mismatch**: the single-value form. Use comma-ok unless a mismatch is a bug.\n- **Assertion to an unrelated type panics**: `i.(T)` where `i`'s dynamic type isn't `T` (and isn't assignable to `T`) panics, even if `T` is an interface the type doesn't satisfy.\n- **`v` in a multi-type case is `interface{}`**: `case int, string: ... v ...` — `v` is `any`, not `int` or `string` (it could be either). Type-assert again inside the case if needed.\n- **Assertion to a pointer type**: `i.(*Dog)` — works if `i` holds a `*Dog`. `i.(Dog)` fails if `i` holds a `*Dog` (pointer is not the value type).\n- **Type switch with `nil` case**: `case nil:` matches a nil interface (not an interface wrapping a nil pointer — see chapter 12). Handle `nil` explicitly to avoid panicking in other cases.\n- **`default` is required for unknown types**: without a `default`, an unrecognized type falls through silently. Add `default:` for safety (even if it just panics or logs).\n- **Type assertions don't work on non-interface types**: `var x int = 5; x.(int)` is a compile error — assertions are for interface values. Use a regular type conversion for concrete types.\n\n## 🧠 Spot the Bug\n\nA developer processes a JSON-decoded value and gets a panic:\n\n::code-wrapper{language=\"go\"}\n```go\nvar data interface{}\njson.Unmarshal([]byte(`{\"count\": 42}`), &data)\n\nm := data.(map[string]interface{})\ncount := m[\"count\"].(int)   \u002F\u002F PANIC: interface conversion: interface {} is float64, not int\n",[33,671,672,704,727,732,736,740,744,773,777,788,792,828,859,888,924,957,961,966,970,975,1029,1034,1039,1044,1049,1098,1102,1107,1111,1121,1125,1139,1143,1148,1169,1174,1180],{"__ignoreMap":31},[36,673,674,676,679,682,685,688,691,694,697,699,702],{"class":38,"line":39},[36,675,43],{"class":42},[36,677,678],{"class":46}," r ",[36,680,681],{"class":98},"io",[36,683,684],{"class":46},".",[36,686,687],{"class":98},"Reader