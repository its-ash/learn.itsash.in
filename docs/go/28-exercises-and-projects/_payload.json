0],{"class":87},"])\n",[60,232,234],{"class":62,"line":233},14,[60,235,236],{"class":87},"}\n",[28,238,240],{"id":239},"_2-fizzbuzz-control-flow","2. FizzBuzz (control flow)",[14,242,243,244,247,248,247,251,254],{},"Print FizzBuzz from 1 to 100. Practice ",[18,245,246],{},"for",", ",[18,249,250],{},"if\u002Felse",[18,252,253],{},"fmt.Printf",".",[28,256,258],{"id":257},"_3-slice-operations-slices-generics","3. Slice Operations (slices, generics)",[14,260,261,262,247,265,247,268,271,272,247,275,278],{},"Implement ",[18,263,264],{},"Map",[18,266,267],{},"Filter",[18,269,270],{},"Reduce"," as generic functions. Then use ",[18,273,274],{},"slices.Sort",[18,276,277],{},"slices.Contains"," from the standard library.",[28,280,282],{"id":281},"_4-word-count-maps-strings","4. Word Count (maps, strings)",[14,284,285,286,247,288,247,291,294],{},"Read a text file, count word frequencies, print the top 10. Practice ",[18,287,41],{},[18,289,290],{},"strings.Fields",[18,292,293],{},"map",", sorting.",[28,296,298],{"id":297},"_5-reverse-a-string-strings-runes","5. Reverse a String (strings, runes)",[14,300,301,302,305,306,309],{},"Reverse a string, handling UTF-8 correctly (use ",[18,303,304],{},"[]rune",", not ",[18,307,308],{},"[]byte",").",[23,311,313],{"id":312},"intermediate","Intermediate",[28,315,317],{"id":316},"_6-stack-and-queue-generics","6. Stack and Queue (generics)",[14,319,320,321,324,325,328,329,247,332,247,335,338],{},"Implement a generic ",[18,322,323],{},"Stack[T]"," and ",[18,326,327],{},"Queue[T]"," using slices. Include ",[18,330,331],{},"Push",[18,333,334],{},"Pop",[18,336,337],{},"Len",", and tests.",[28,340,342],{"id":341},"_7-http-api-client-interfaces-error-handling","7. HTTP API Client (interfaces, error handling)",[14,344,345,346,349,350,254],{},"Write a function ",[18,347,348],{},"fetchUser(ctx context.Context, id int) (*User, error)"," that calls a JSON API with a timeout, wraps errors with context, and handles ",[18,351,352],{},"context.DeadlineExceeded",[48,354,355],{"language":50},[52,356,358],{"className":54,"code":357,"language":50,"meta":56,"style":56},"func fetchUser(ctx context.Context, id int) (*User, error) {\n    ctx, cancel := context.WithTimeout(ctx, 5*time.Second)\n    defer cancel()\n\n    url := fmt.Sprintf(\"https:\u002F\u002Fapi.example.com\u002Fusers\u002F%d\", id)\n    req, _ := http.NewRequestWithContext(ctx, \"GET\", url, nil)\n    resp, err := http.DefaultClient.Do(req)\n    if err != nil {\n        return nil, fmt.Errorf(\"fetch user %d: %w\", id, err)\n    }\n    defer resp.Body.Close()\n\n    if resp.StatusCode != http.StatusOK {\n        return nil, fmt.Errorf(\"fetch user %d: status %d\", id, resp.StatusCode)\n    }\n\n    var u User\n    if err := json.NewDecoder(resp.Body).Decode(&u); err != nil {\n        return nil, fmt.Errorf(\"fetch user %d: decode: %w\", id, err)\n    }\n    return &u, nil\n}\n",[18,359,360,406,431,442,446,472,498,514,529,560,564,576,580,592,618,623,628,640,675,701,706,721],{"__ignoreMap":56},[60,361,362,364,367,369,373,376,378,381,383,386,389,392,395,398,400,403],{"class":62,"line":63},[60,363,128],{"class":66},[60,365,366],{"class":70}," fetchUser",[60,368,185],{"class":87},[60,370,372],{"class":371},"sCrzJ","ctx",[60,374,375],{"class":70}," context",[60,377,254],{"class":87},[60,379,380],{"class":70},"Context",[60,382,247],{"class":87},[60,384,385],{"class":371},"id",[60,387,388],{"class":66}," int",[60,390,391],{"class":87},") (",[60,393,394],{"class":66},"*",[60,396,397],{"class":70},"User",[60,399,247],{"class":87},[60,401,402],{"class":66},"error",[60,404,405],{"class":87},") {\n",[60,407,408,411,414,417,420,423,426,428],{"class":62,"line":74},[60,409,410],{"class":87},"    ctx, cancel ",[60,412,413],{"class":66},":=",[60,415,416],{"class":87}," context.",[60,418,419],{"class":70},"WithTimeout",[60,421,422],{"class":87},"(ctx, ",[60,424,425],{"class":152},"5",[60,427,394],{"class":66},[60,429,430],{"class":87},"time.Second)\n",[60,432,433,436,439],{"clas