[{"data":1,"prerenderedAt":2349},["ShallowReactive",2],{"page-\u002Fgo\u002F07-arrays-slices-and-strings":3},{"id":4,"title":5,"body":6,"description":2342,"extension":2343,"meta":2344,"navigation":158,"path":2345,"seo":2346,"stem":2347,"__hash__":2348},"content\u002Fgo\u002F07-arrays-slices-and-strings.md","07 — Arrays, Slices & Strings",{"type":7,"value":8,"toc":2325},"minimark",[9,13,22,27,39,758,770,775,780,884,893,897,1138,1154,1447,1460,1464,1579,1583,1765,1769,1772,1922,1925,2301,2304,2321],[10,11,5],"h1",{"id":12},"_07-arrays-slices-strings",[14,15,16,17,21],"p",{},"Slices are Go's primary list type. Understanding the array\u002Fslice distinction, capacity, and ",[18,19,20],"code",{},"append"," mechanics is essential — most Go bugs involve slices.",[23,24,26],"h2",{"id":25},"arrays","Arrays",[14,28,29,30,34,35,38],{},"An array has a ",[31,32,33],"strong",{},"fixed length"," (part of the type) and is ",[31,36,37],{},"value-typed"," (copied on assignment):",[40,41,43,429,432,437,444,469,481,485,490,632,639,648,660,667],"code-wrapper",{"language":42},"go",[44,45,49],"pre",{"className":46,"code":47,"language":42,"meta":48,"style":48},"language-go shiki shiki-themes github-light github-dark","var a [3]int              \u002F\u002F [0 0 0]\nb := [3]int{1, 2, 3}\nc := [...]int{4, 5, 6}    \u002F\u002F length inferred: [3]int{4, 5, 6}\n\n\u002F\u002F Length is part of the type — [3]int and [4]int are different types\n\u002F\u002F Arrays are copied on assignment (value semantics)\nd := b\nd[0] = 99\nfmt.Println(b)   \u002F\u002F [1 2 3] — b unchanged\nfmt.Println(d)   \u002F\u002F [99 2 3]\n``\n::\n\nArrays are rare in application code — use slices instead. Arrays are used for fixed-size collections (e.g., a SHA-256 hash `[32]byte`) or when the size is a compile-time constant.\n\n## Slices\n\nA slice is a **dynamic-length view** into an underlying array. It's a header (`{pointer, length, capacity}`), passed by value (the header, not the data):\n\n::code-wrapper{language=\"go\"}\n```go\nvar s []int               \u002F\u002F nil slice (len 0, cap 0, s == nil)\ns = []int{}               \u002F\u002F empty, non-nil slice\ns = []int{1, 2, 3}\ns = make([]int, 5)        \u002F\u002F len 5, cap 5, zero values\ns = make([]int, 5, 10)    \u002F\u002F len 5, cap 10\n\nlen(s)   \u002F\u002F length (number of elements)\ncap(s)   \u002F\u002F capacity (space in underlying array)\n\ns[0]     \u002F\u002F index\ns[1:3]   \u002F\u002F slice (half-open: indices 1, 2)\ns[:2]    \u002F\u002F first 2\ns[2:]    \u002F\u002F from index 2 to end\ns[:]     \u002F\u002F whole slice\n","",[18,50,51,78,115,153,160,166,172,183,201,217,230,237,243,248,285,290,296,301,330,335,341,347,353,359,365,371,377,382,388,394,399,405,411,417,423],{"__ignoreMap":48},[52,53,56,60,64,68,71,74],"span",{"class":54,"line":55},"line",1,[52,57,59],{"class":58},"svdQ7","var",[52,61,63],{"class":62},"ssxIu"," a [",[52,65,67],{"class":66},"snvgF","3",[52,69,70],{"class":62},"]",[52,72,73],{"class":58},"int",[52,75,77],{"class":76},"sdCPZ","              \u002F\u002F [0 0 0]\n",[52,79,81,84,87,90,92,94,96,99,102,105,108,110,112],{"class":54,"line":80},2,[52,82,83],{"class":62},"b ",[52,85,86],{"class":58},":=",[52,88,89],{"class":62}," [",[52,91,67],{"class":66},[52,93,70],{"class":62},[52,95,73],{"class":58},[52,97,98],{"class":62},"{",[52,100,101],{"class":66},"1",[52,103,104],{"class":62},", ",[52,106,107],{"class":66},"2",[52,109,104],{"class":62},[52,111,67],{"class":66},[52,113,114],{"class":62},"}\n",[52,116,118,121,123,125,128,130,132,134,137,139,142,144,147,150],{"class":54,"line":117},3,[52,119,120],{"class":62},"c ",[52,122,86],{"class":58},[52,124,89],{"class":62},[52,126,127],{"class":58},"...",[52,129,70],{"class":62},[52,131,73],{"class":58},[52,133,98],{"class":62},[52,135,136],{"class":66},"4",[52,138,104],{"class":62},[52,140,141],{"class":66},"5",[52,143,104],{"class":62},[52,145,146],{"class":66},"6",[52,148,149],{"class":62},"}    ",[52,151,152],{"class":76},"\u002F\u002F length inferred: [3]int{4, 5, 6}\n",[52,154,156],{"class":54,"line":155},4,[52,157,159],{"emptyLinePlaceholder":158},true,"\n",[52,161,163],{"class":54,"line":162},5,[52,164,165],{"class":76},"\u002F\u002F Length is part of the type — [3]int and [4]int are different types\n",[52,167,169],{"class":54,"line":168},6,[52,170,171],{"class":76},"\u002F\u002F Arrays are copied on assignment (value semantics)\n",[52,173,175,178,180],{"class":54,"line":174},7,[52,176,177],{"class":62},"d ",[52,179,86],{"class":58},[52,181,182],{"class":62}," b\n",[52,184,186,189,192,195,198],{"class":54,"line":185},8,[52,187,188],{"class":62},"d[",[52,190,191],{"class":66},"0",[52,193,194],{"class":62},"] ",[52,196,197],{"class":58},"=",[52,199,200],{"class":66}," 99\n",[52,202,204,207,211,214],{"class":54,"line":203},9,[52,205,206],{"class":62},"fmt.",[52,208,210],{"class":209},"sIsaT","Println",[52,212,213],{"class":62},"(b)   ",[52,215,216],{"class":76},"\u002F\u002F [1 2 3] — b unchanged\n",[52,218,220,222,224,227],{"class":54,"line":219},10,[52,221,206],{"class":62},[52,223,210],{"class":209},[52,225,226],{"class":62},"(d)   ",[52,228,229],{"class":76},"\u002F\u002F [99 2 3]\n",[52,231,233],{"class":54,"line":232},11,[52,234,236],{"class":235},"sJ6F3","``\n",[52,238,240],{"class":54,"line":239},12,[52,241,242],{"class":62},"::\n",[52,244,246],{"class":54,"line":245},13,[52,247,159],{"emptyLinePlaceholder":158},[52,249,251,254,257,260,263,266,268,271,274,277,280,282],{"class":54,"line":250},14,[52,252,253],{"class":62},"Arrays are rare in application code — use slices instead. Arrays are used ",[52,255,256],{"class":58},"for",[52,258,259],{"class":62}," fixed",[52,261,262],{"class":58},"-",[52,264,265],{"class":62},"size collections (e.g., a SHA",[52,267,262],{"class":58},[52,269,270],{"class":66},"256",[52,272,273],{"class":62}," hash ",[52,275,276],{"class":235},"`[32]byte`",[52,278,279],{"class":62},") or when the size is a compile",[52,281,262],{"class":58},[52,283,284],{"class":62},"time constant.\n",[52,286,288],{"class":54,"line":287},15,[52,289,159],{"emptyLinePlaceholder":158},[52,291,293],{"class":54,"line":292},16,[52,294,295],{"class":62},"## Slices\n",[52,297,299],{"class":54,"line":298},17,[52,300,159],{"emptyLinePlaceholder":158},[52,302,304,307,310,313,315,318,320,323,326],{"class":54,"line":303},18,[52,305,306],{"class":62},"A slice is a ",[52,308,309],{"class":58},"**",[52,311,312],{"class":62},"dynamic",[52,314,262],{"class":58},[52,316,317],{"class":62},"length view",[52,319,309],{"class":58},[52,321,322],{"class":62}," into an underlying array. It",[52,324,325],{"class":235},"'",[52,327,329],{"class":328},"sMKGj","s a header (`{pointer, length, capacity}`), passed by value (the header, not the data):\n",[52,331,333],{"class":54,"line":332},19,[52,334,159],{"emptyLinePlaceholder":158},[52,336,338],{"class":54,"line":337},20,[52,339,340],{"class":328},"::code-wrapper{language=\"go\"}\n",[52,342,344],{"class":54,"line":343},21,[52,345,346],{"class":328},"```go\n",[52,348,350],{"class":54,"line":349},22,[52,351,352],{"class":328},"var s []int               \u002F\u002F nil slice (len 0, cap 0, s == nil)\n",[52,354,356],{"class":54,"line":355},23,[52,357,358],{"class":328},"s = []int{}               \u002F\u002F empty, non-nil slice\n",[52,360,362],{"class":54,"line":361},24,[52,363,364],{"class":328},"s = []int{1, 2, 3}\n",[52,366,368],{"class":54,"line":367},25,[52,369,370],{"class":328},"s = make([]int, 5)        \u002F\u002F len 5, cap 5, zero values\n",[52,372,374],{"class":54,"line":373},26,[52,375,376],{"class":328},"s = make([]int, 5, 10)    \u002F\u002F len 5, cap 10\n",[52,378,380],{"class":54,"line":379},27,[52,381,159],{"emptyLinePlaceholder":158},[52,383,385],{"class":54,"line":384},28,[52,386,387],{"class":328},"len(s)   \u002F\u002F length (number of elements)\n",[52,389,391],{"class":54,"line":390},29,[52,392,393],{"class":328},"cap(s)   \u002F\u002F capacity (space in underlying array)\n",[52,395,397],{"class":54,"line":396},30,[52,398,159],{"emptyLinePlaceholder":158},[52,400,402],{"class":54,"line":401},31,[52,403,404],{"class":328},"s[0]     \u002F\u002F index\n",[52,406,408],{"class":54,"line":407},32,[52,409,410],{"class":328},"s[1:3]   \u002F\u002F slice (half-open: indices 1, 2)\n",[52,412,414],{"class":54,"line":413},33,[52,415,416],{"class":328},"s[:2]    \u002F\u002F first 2\n",[52,418,420],{"class":54,"line":419},34,[52,421,422],{"class":328},"s[2:]    \u002F\u002F from index 2 to end\n",[52,424,426],{"class":54,"line":425},35,[52,427,428],{"class":328},"s[:]     \u002F\u002F whole slice\n",[14,430,431],{},"::",[433,434,436],"h3",{"id":435},"slice-internals","Slice internals",[14,438,439,440,443],{},"A slice header is ",[18,441,442],{},"{ptr *array, len int, cap int}",":",[445,446,447,454,460],"ul",{},[448,449,450,453],"li",{},[18,451,452],{},"ptr"," points to the first element in the underlying array.",[448,455,456,459],{},[18,457,458],{},"len"," is the number of elements visible.",[448,461,462,465,466,468],{},[18,463,464],{},"cap"," is the number of elements from ",[18,467,452],{}," to the end of the underlying array.",[14,470,471,472,475,476,480],{},"Slicing (",[18,473,474],{},"s[1:3]",") creates a new header pointing into the ",[477,478,479],"em",{},"same"," array — no copy. Modifying elements through the sub-slice affects the original.",[23,482,483],{"id":20},[18,484,20],{},[14,486,487,489],{},[18,488,20],{}," adds elements, growing the underlying array if needed:",[40,491,492],{"language":42},[44,493,495],{"className":46,"code":494,"language":42,"meta":48,"style":48},"s := []int{1, 2, 3}\ns = append(s, 4)         \u002F\u002F [1 2 3 4]\ns = append(s, 5, 6)      \u002F\u002F [1 2 3 4 5 6]\ns = append(s, []int{7, 8}...)   \u002F\u002F spread another slice\n\n\u002F\u002F append returns a new slice — always reassign:\ns = append(s, x)         \u002F\u002F ✅\nappend(s, x)             \u002F\u002F ❌ result is lost\n",[18,496,497,523,543,565,599,603,608,622],{"__ignoreMap":48},[52,498,499,502,504,507,509,511,513,515,517,519,521],{"class":54,"line":55},[52,500,501],{"class":62},"s ",[52,503,86],{"class":58},[52,505,506],{"class":62}," []",[52,508,73],{"class":58},[52,510,98],{"class":62},[52,512,101],{"class":66},[52,514,104],{"class":62},[52,516,107],{"class":66},[52,518,104],{"class":62},[52,520,67],{"class":66},[52,522,114],{"class":62},[52,524,525,527,529,532,535,537,540],{"class":54,"line":80},[52,526,501],{"class":62},[52,528,197],{"class":58},[52,530,531],{"class":209}," append",[52,533,534],{"class":62},"(s, ",[52,536,136],{"class":66},[52,538,539],{"class":62},")         ",[52,541,542],{"class":76},"\u002F\u002F [1 2 3 4]\n",[52,544,545,547,549,551,553,555,557,559,562],{"class":54,"line":117},[52,546,501],{"class":62},[52,548,197],{"class":58},[52,550,531],{"class":209},[52,552,534],{"class":62},[52,554,141],{"class":66},[52,556,104],{"class":62},[52,558,146],{"class":66},[52,560,561],{"class":62},")      ",[52,563,564],{"class":76},"\u002F\u002F [1 2 3 4 5 6]\n",[52,566,567,569,571,573,576,578,580,583,585,588,591,593,596],{"class":54,"line":155},[52,568,501],{"class":62},[52,570,197],{"class":58},[52,572,531],{"class":209},[52,574,575],{"class":62},"(s, []",[52,577,73],{"class":58},[52,579,98],{"class":62},[52,581,582],{"class":66},"7",[52,584,104],{"class":62},[52,586,587],{"class":66},"8",[52,589,590],{"class":62},"}",[52,592,127],{"class":58},[52,594,595],{"class":62},")   ",[52,597,598],{"class":76},"\u002F\u002F spread another slice\n",[52,600,601],{"class":54,"line":162},[52,602,159],{"emptyLinePlaceholder":158},[52,604,605],{"class":54,"line":168},[52,606,607],{"class":76},"\u002F\u002F append returns a new slice — always reassign:\n",[52,609,610,612,614,616,619],{"class":54,"line":174},[52,611,501],{"class":62},[52,613,197],{"class":58},[52,615,531],{"class":209},[52,617,618],{"class":62},"(s, x)         ",[52,620,621],{"class":76},"\u002F\u002F ✅\n",[52,623,624,626,629],{"class":54,"line":185},[52,625,20],{"class":209},[52,627,628],{"class":62},"(s, x)             ",[52,630,631],{"class":76},"\u002F\u002F ❌ result is lost\n",[433,633,635,636,638],{"id":634},"how-append-grows","How ",[18,637,20],{}," grows",[14,640,641,642,104,645,647],{},"When ",[18,643,644],{},"len == cap",[18,646,20],{}," allocates a new, larger array, copies the old elements, and appends. The growth strategy (Go runtime): roughly doubles for small slices, ~1.25x for large — balancing allocation frequency vs. memory waste.",[14,649,650,655,656,659],{},[31,651,652,653],{},"Always reassign the result of ",[18,654,20],{},": ",[18,657,658],{},"s = append(s, x)",". If the slice grew, the new header points to a new array; the old header still points to the old (now-stale) array.",[433,661,663,664,666],{"id":662},"the-append-aliasing-trap","The ",[18,665,20],{}," aliasing trap",[40,668,669],{"language":42},[44,670,672],{"className":46,"code":671,"language":42,"meta":48,"style":48},"s := make([]int, 3, 5)   \u002F\u002F [0 0 0], cap 5\nt := s                   \u002F\u002F t shares the same underlying array\nt = append(t, 1)         \u002F\u002F t = [0 0 0 1], len 4 — still within cap 5, same array\n\u002F\u002F s is still [0 0 0] (len 3), but s[3] is now 1 (shared array!)\nfmt.Println(s[:4])       \u002F\u002F [0 0 0 1] — the append affected s's underlying array\n``\n",[18,673,674,701,714,732,737,754],{"__ignoreMap":48},[52,675,676,678,680,683,686,688,690,692,694,696,698],{"class":54,"line":55},[52,677,501],{"class":62},[52,679,86],{"class":58},[52,681,682],{"class":209}," make",[52,684,685],{"class":62},"([]",[52,687,73],{"class":58},[52,689,104],{"class":62},[52,691,67],{"class":66},[52,693,104],{"class":62},[52,695,141],{"class":66},[52,697,595],{"class":62},[52,699,700],{"class":76},"\u002F\u002F [0 0 0], cap 5\n",[52,702,703,706,708,711],{"class":54,"line":80},[52,704,705],{"class":62},"t ",[52,707,86],{"class":58},[52,709,710],{"class":62}," s                   ",[52,712,713],{"class":76},