"class":77}," flowing through call chains, not fields).\n",[71,1474,1475,1477,1479,1481,1483,1486,1489,1492,1494,1497,1500,1503,1505],{"class":73,"line":309},[71,1476,416],{"class":81},[71,1478,1388],{"class":81},[71,1480,1391],{"class":77},[71,1482,298],{"class":81},[71,1484,1485],{"class":77},": use ",[71,1487,1488],{"class":262},"`context.Background()`",[71,1490,1491],{"class":77}," at the top level (main, tests) and ",[71,1493,982],{"class":262},[71,1495,1496],{"class":77}," in HTTP handlers — ",[71,1498,1499],{"class":262},"`Background`",[71,1501,1502],{"class":77}," is the root that",[71,1504,988],{"class":262},[71,1506,1507],{"class":991},"s never canceled; `r.Context()` is canceled when the client disconnects. Derive timeouts\u002Fbranches from these.\n",[71,1509,1510,1513,1515,1518,1521,1524,1527,1530,1532],{"class":73,"line":314},[71,1511,1512],{"class":991},"- **Idiom**: include `\u003C-ctx.Done()` in every long-running goroutine",[71,1514,988],{"class":262},[71,1516,1517],{"class":77},"s ",[71,1519,1520],{"class":262},"`select`",[71,1522,1523],{"class":77}," — it provides the exit path when the parent cancels. A goroutine that never checks ",[71,1525,1526],{"class":262},"`ctx.Done()`",[71,1528,1529],{"class":77}," can",[71,1531,988],{"class":262},[71,1533,1534],{"class":991},"t be canceled (leak).\n",[71,1536,1537,1540,1542,1545,1548,1551,1553,1556,1558,1561,1564,1567,1569,1571],{"class":73,"line":326},[71,1538,1539],{"class":991},"- **Idiom**: use `WithValue` sparingly and only for cross-cutting concerns (request ID, trace ID) — it",[71,1541,988],{"class":262},[71,1543,1544],{"class":77},"s untyped (requires ",[71,1546,1547],{"class":81},"type",[71,1549,1550],{"class":77}," assertion) and encourages hidden coupling. Prefer explicit parameters ",[71,1552,399],{"class":81},[71,1554,1555],{"class":77}," most data. Use a custom key ",[71,1557,1547],{"class":81},[71,1559,1560],{"class":77}," (",[71,1562,1563],{"class":262},"`type ctxKey int`",[71,1565,1566],{"class":77},") to avoid ",[71,1568,1131],{"class":81},[71,1570,416],{"class":81},[71,1572,1573],{"class":77},"key collisions.\n",[71,1575,1576],{"class":73,"line":331},[71,1577,121],{"emptyLinePlaceholder":120},[71,1579,1580,1583,1585],{"class":73,"line":388},[71,1581,1582],{"class":77},"## ⚠️ Edge Cases ",[71,1584,1374],{"class":81},[71,1586,1587],{"class":77}," Gotchas\n",[71,1589,1590],{"class":73,"line":393},[71,1591,121],{"emptyLinePlaceholder":120},[71,1593,1594,1596,1598,1601,1603,1606,1608,1611,1613,1615,1617,1620,1622,1625,1627],{"class":73,"line":405},[71,1595,416],{"class":81},[71,1597,1388],{"class":81},[71,1599,1600],{"class":77},"Forgetting ",[71,1602,320],{"class":262},[71,1604,1605],{"class":77}," leaks",[71,1607,298],{"class":81},[71,1609,1610],{"class":77},": ",[71,1612,340],{"class":262},[71,1614,337],{"class":81},[71,1616,345],{"class":262},[71,1618,1619],{"class":77}," start a timer; not calling ",[71,1621,320],{"class":262},[71,1623,1624],{"class":77}," leaves the timer and context alive until the deadline. ",[71,1626,371],{"class":262},[71,1628,1629],{"class":77}," is the fix.\n",[71,1631,1632,1634,1636,1639,1641],{"class":73,"line":410},[71,1633,416],{"class":81},[71,1635,1388],{"class":81},[71,1637,1638],{"class":77},"Don",[71,1640,988],{"class":262},[71,1642,1643],{"class":991},"t store contexts in structs**: contexts are for passing through call chains, not for keeping in fields. A struct with a `ctx` field breaks cancellation propagation and is a code smell.\n",[71,1645,1646,1649,1651,1654,1657,1660,1662],{"class":73,"line":430},[71,1647,1648],{"class":991},"- **`ctx.Done()` is a channel, not a value**: `\u003C-ctx.Done()` blocks until canceled; `ctx.Err()` gives the reason. Don",[71,1650,988],{"class":262},[71,1652,1653],{"class":77},"t poll ",[71,1655,1656],{"class":262},"`Done()`",[71,1658,1659],{"class":77}," — ",[71,1661,1520],{"class":262},[71,1663,1664],{"class":77}," on it.\n",[71,1666,1667,1669,1671,1673,1676,1678,1681,1683,1686,1688,1691,1693],{"class":73,"line":436},[71,1668,416],{"class":81},[71,1670,1388],{"class":81},[71,1672,1488],{"class":262},[71,1674,1675],{"class":77}," is never canceled",[71,1677,298],{"class":81},[71,1679,1680],{"class":77},": it",[71,1682,988],{"class":262},[71,1684,1685],{"class":991},"s the root. Don",[71,1687,988],{"class":262},[71,1689,1690],{"class":77},"t use it where you want cancellation (e.g., in a handler — use ",[71,1692,982],{"class":262},[71,1694,1695],{"class":77},").\n",[71,1697,1698,1700,1702,1705,1708,1710,1712,1715,1718,1721,1724,1727,1730,1732,1735,1737,1740,1742],{"class":73,"line":442},[71,1699,416],{"class":81},[71,1701,1388],{"class":81},[71,1703,1704],{"class":262},"`WithValue`",[71,1706,1707],{"class":77}," is untyped",[71,1709,298],{"class":81},[71,1711,1610],{"class":77},[71,1713,1714],{"class":262},"`ctx.Value(key)`",[71,1716,1717],{"class":77}," returns ",[71,1719,1720],{"class":262},"`any`",[71,1722,1723],{"class":77}," — you must ",[71,1725,1726],{"class":81},"type-",[71,1728,1729],{"class":77},"assert. Mismatched key types (",[71,1731,1131],{"class":81},[71,1733,1734],{"class":77}," vs custom ",[71,1736,1547],{"class":81},[71,1738,1739],{"class":77},") silently miss. Use a custom key ",[71,1741,1547],{"class":81},[71,1743,1744],{"class":77},".\n",[71,1746,1747,1749,1751,1754,1756,1759,1761],{"class":73,"line":448},[71,1748,416],{"class":81},[71,1750,1388],{"class":81},[71,1752,1753],{"class":77},"Parent cancels children, not vice versa",[71,1755,298],{"class":81},[71,1757,1758],{"class":77},": canceling a child context doesn",[71,1760,988],{"class":262},[71,1762,1763],{"class":991},"t cancel the parent or siblings. The tree flows downward.\n",[71,1765,1766,1769,1771,1774,1777,1779,1781,1783,1786,1789,1792,1795,1798,1801,1803,1806,1808],{"class":73,"line":454},[71,1767,1768],{"class":991},"- **Don",[71,1770,988],{"class":262},[71,1772,1773],{"class":77},"t pass ",[71,1775,1776],{"class":262},"`nil`",[71,1778,549],{"class":77},[71,1780,298],{"class":81},[71,1782,1610],{"class":77},[71,1784,1785],{"class":262},"`func f(ctx context.Context)`",[71,1787,1788],{"class":77}," with ",[71,1790,1791],{"class":262},"`ctx == nil`",[71,1793,1794],{"class":77}," panics in some stdlib functions. Use ",[71,1796,1797],{"class":262},"`context.TODO()`",[71,1799,1800],{"class":77}," as a placeholder ",[71,1802,377],{"class":81},[71,1804,1805],{"class":77}," you don",[71,1807,988],{"class":262},[71,1809,1810],{"class":991},"t have one.\n",[71,1812,1813,1816,1818,1821],{"class":73,"line":460},[71,1814,1815],{"class":991},"- **`context.TODO()` vs `context.Background()`**: both are never-canceled roots; `TODO` signals \"I haven",[71,1817,988],{"class":262},[71,1819,1820],{"class":77},"t decided which context to use yet",[71,1822,1823],{"class":262},"\" (for work-in-progress). Use `Background` when you intentionally want the root.\n",[71,1825,1826],{"class":73,"line":466},[71,1827,1828],{"class":262},"- **`ctx.Err()` after `Done()`**: `ctx.Err()` returns `context.Canceled` (explicit cancel) or `context.DeadlineExceeded` (timeout). Before `Done()`, it returns `nil`.\n",[71,1830,1831],{"class":73,"line":471},[71,1832,1833],{"class":262},"- **Goroutines don't inherit context automatically**: `go f()` doesn't pass the current context — you must pass it explicitly (`go f(ctx)`). A goroutine without a context can't be canceled by the parent's context.\n",[71,1835,1836],{"class":73,"line":476},[71,1837,121],{"emptyLinePlaceholder":120},[71,1839,1840],{"class":73,"line":482},[71,1841,1842],{"class":262},"## 🧠 Spot the Bug\n",[71,1844,1845],{"class":73,"line":488},[71,1846,121],{"emptyLinePlaceholder":120},[71,1848,1849],{"class":73,"line":494},[71,1850,1851],{"class":262},"A developer sets a timeout on an HTTP call, but it leaks goroutines:\n",[71,1853,1855],{"class":73,"line":1854},38,[71,1856,121],{"emptyLinePlaceholder":120},[71,1858,1860,1863,1865],{"class":73,"line":1859},39,[71,1861,1862],{"class":262},"::code-wrapper{language=\"",[71,1864,61],{"class":81},[71,1866,1867],{"class":262},"\"}\n",[71,1869,1871],{"class":73,"line":1870},40,[71,1872,433],{"class":262},[71,1874,1876],{"class":73,"line":1875},41,[71,1877,1878],{"class":262},"func fetch(ctx context.Context, url string) (*http.Response, error) {\n",[71,1880,1882],{"class":73,"line":1881},42,[71,1883,1884],{"class":262},"    ctx, _ = context.WithTimeout(ctx, 5*time.Second)   \u002F\u002F ❌ cancel discarded\n",[71,1886,1888,1891,1894],{"class":73,"line":1887},43,[71,1889,1890],{"class":262},"    req, _ := http.NewRequestWithContext(ctx, \"",[71,1892,1893],{"class":77},"GET",[71,1895,1896],{"class":262},"\", url, nil)\n",[71,1898,1900],{"class":73,"line":1899},44,[71,1901,1902],{"class":262},"    return http.DefaultClient.Do(req)\n",[71,1904,1906],{"class":73,"line":1905},45,[71,1907,427],{"class":262},[14,1909,1910],{},"::",[14,1912,1913],{},"What's wrong?",[1915,1916,1917,1921,1937,1940,1946,2067,2074],"details",{},[1918,1919,1920],"summary",{},"Answer",[14,1922,1923,1926,1927,1930,1931,1560,1933,1936],{},[18,1924,1925],{},"context.WithTimeout"," returns a context and a ",[18,1928,1929],{},"cancel"," function. The developer discards ",[18,1932,1929],{},[18,1934,1935],{},"ctx, _ = ...","), so it's never called. This leaks the timer (and the context's resources) — the timer runs for 5 seconds even if the HTTP call returns immediately, and the context isn't cleaned up until the deadline.",[14,1938,1939],{},"For a single call, the leak is brief (5 seconds). But in a hot loop (thousands of calls per second), the leaked timers accumulate — each holds a goroutine and a timer until its deadline.",[14,1941,1942,1943,525],{},"The fix — ",[18,1944,1945],{},"defer cancel()",[63,1947,1949],{"className":65,"code":1948,"language":61,"meta":67,"style":67},"func fetch(ctx context.Context, url string) (*http.Response, error) {\n    ctx, cancel := context.WithTimeout(ctx, 5*time.Second)\n    defer cancel()   \u002F\u002F release the timer i