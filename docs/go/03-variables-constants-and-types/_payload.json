30,347,348],{},[33,349,350],{},"bool",[330,352,353],{},[33,354,355],{},"false",[315,357,358,363],{},[330,359,360],{},[33,361,362],{},"string",[330,364,365,368],{},[33,366,367],{},"\"\""," (empty string)",[315,370,371,391],{},[330,372,373,334,376,334,379,334,382,334,385,334,388],{},[33,374,375],{},"pointer",[33,377,378],{},"slice",[33,380,381],{},"map",[33,383,384],{},"chan",[33,386,387],{},"func",[33,389,390],{},"interface",[330,392,393],{},[33,394,395],{},"nil",[315,397,398,403],{},[330,399,400],{},[33,401,402],{},"struct",[330,404,405],{},"a struct with all fields at their zero values",[19,407,408,410],{},[33,409,395],{}," is the zero value for reference types. It's a predeclared identifier (not a keyword) representing \"no value.\"",[14,412,414],{"id":413},"constants","Constants",[19,416,417],{},"Constants are compile-time-known, immutable values:",[23,419,420],{"language":25},[27,421,423],{"className":29,"code":422,"language":25,"meta":31,"style":31},"const Pi = 3.14159\nconst MaxSize int = 100\n\nconst (\n    StatusOK = 200\n    StatusNotFound = 404\n)\n\n\u002F\u002F Untyped constants — can be used in any numeric context without conversion\nconst x = 5\nvar y int64 = x   \u002F\u002F no conversion needed — x is untyped\nvar z float64 = x \u002F\u002F also works\n",[33,424,425,438,453,457,463,473,483,487,491,496,508,526],{"__ignoreMap":31},[36,426,427,430,433,435],{"class":38,"line":39},[36,428,429],{"class":42},"const",[36,431,432],{"class":68}," Pi",[36,434,85],{"class":42},[36,436,437],{"class":68}," 3.14159\n",[36,439,440,442,445,448,450],{"class":38,"line":57},[36,441,429],{"class":42},[36,443,444],{"class":68}," MaxSize",[36,446,447],{"class":42}," int",[36,449,85],{"class":42},[36,451,452],{"class":68}," 100\n",[36,454,455],{"class":38,"line":75},[36,456,113],{"emptyLinePlaceholder":112},[36,458,459,461],{"class":38,"line":94},[36,460,429],{"class":42},[36,462,121],{"class":46},[36,464,465,468,470],{"class":38,"line":109},[36,466,467],{"class":68},"    StatusOK",[36,469,85],{"class":42},[36,471,472],{"class":68}," 200\n",[36,474,475,478,480],{"class":38,"line":116},[36,476,477],{"class":68},"    StatusNotFound",[36,479,85],{"class":42},[36,481,482],{"class":68}," 404\n",[36,484,485],{"class":38,"line":124},[36,486,160],{"class":46},[36,488,489],{"class":38,"line":135},[36,490,113],{"emptyLinePlaceholder":112},[36,492,493],{"class":38,"line":146},[36,494,495],{"class":53},"\u002F\u002F Untyped constants — can be used in any numeric context without conversion\n",[36,497,498,500,503,505],{"class":38,"line":157},[36,499,429],{"class":42},[36,501,502],{"class":68}," x",[36,504,85],{"class":42},[36,506,507],{"class":68}," 5\n",[36,509,511,513,515,518,520,523],{"class":38,"line":510},11,[36,512,43],{"class":42},[36,514,62],{"class":46},[36,516,517],{"class":42},"int64",[36,519,85],{"class":42},[36,521,522],{"class":46}," x   ",[36,524,525],{"class":53},"\u002F\u002F no conversion needed — x is untyped\n",[36,527,529,531,533,535,537,539],{"class":38,"line":528},12,[36,530,43],{"class":42},[36,532,80],{"class":46},[36,534,337],{"class":42},[36,536,85],{"class":42},[36,538,47],{"class":46},[36,540,541],{"class":53},"\u002F\u002F also works\n",[195,543,545],{"id":544},"untyped-constants","Untyped constants",[19,547,548,549,552,553,334,555,334,557,559],{},"An untyped constant has no fixed type — it adopts the type needed in its context. This lets ",[33,550,551],{},"const x = 5"," work with ",[33,554,50],{},[33,556,517],{},[33,558,337],{}," without explicit conversion, as long as the value fits. Typed constants require conversion.",[195,561,563],{"id":562},"iota",[33,564,562],{},[19,566,567,569],{},[33,568,562],{}," is a constant counter, used for enumerated values:",[23,571,572],{"language":25},[27,573,575],{"className":29,"code":574,"language":25,"meta":31,"style":31},"const (\n    Sunday    = iota   \u002F\u002F 0\n    Monday              \u002F\u002F 1\n    Tuesday             \u002F\u002F 2\n    Wednesday           \u002F\u002F 3\n    Thursday            \u002F\u002F 4\n    Friday              \u002F\u002F 5\n    Saturday            \u002F\u002F 6\n)\n\n\u002F\u002F Bit flags\nconst (\n    Read    = 1 \u003C\u003C iota   \u002F\u002F 1\n    Write                  \u002F\u002F 2\n    Execute                \u002F\u002F 4\n)\n\n\u002F\u002F Skipping values\nconst (\n    _  = iota   \u002F\u002F 0, ignored\n    KB = 1 \u003C\u003C (10 * iota)  \u002F\u002F 1 \u003C\u003C 10\n    MB                      \u002F\u002F 1 \u003C\u003C 20\n    GB                      \u002F\u002F 1 \u003C\u003C 30\n)\n",[33,576,577,583,597,605,613,621,629,637,645,649,653,658,664,683,692,701,706,711,717,724,738,767,776,785],{"__ignoreMap":31},[36,578,579,581],{"class":38,"line":39},[36,580,429],{"class":42},[36,582,121],{"class":46},[36,584,585,588,591,594],{"class":38,"line":57},[36,586,587],{"class":68},"    Sunday",[36,589,590],{"class":42},"    =",[36,592,593],{"class":68}," iota",[36,595,596],{"class":53},"   \u002F\u002F 0\n",[36,598,599,602],{"class":38,"line":75},[36,600,601],{"class":68},"    Monday",[36,603,604],{"class":53},"              \u002F\u002F 1\n",[36,606,607,610],{"class":38,"line":94},[36,608,609],{"class":68},"    Tuesday",[36,611,612],{"class":53},"             \u002F\u002F 2\n",[36,614,615,618],{"class":38,"line":109},[36,616,617],{"class":68},"    Wednesday",[36,619,620],{"class":53},"           \u002F\u002F 3\n",[36,622,623,626],{"class":38,"line":116},[36,624,625],{"class":68},"    Thursday",[36,627,628],{"class":53},"            \u002F\u002F 4\n",[36,630,631,634],{"class":38,"line":124},[36,632,633],{"class":68},"    Friday",[36,635,636],{"class":53},"              \u002F\u002F 5\n",[36,638,639,642],{"class":38,"line":135},[36,640,641],{"class":68},"    Saturday",[36,643,644],{"class":53},"            \u002F\u002F 6\n",[36,646,647],{"class":38,"line":146},[36,648,160],{"class":46},[36,650,651],{"class":38,"line":157},[36,652,113],{"emptyLinePlaceholder":112},[36,654,655],{"class":3