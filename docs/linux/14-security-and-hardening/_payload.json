y\u002Flimits.conf):\n# *    soft  nofile  65536\n# *    hard  nofile  65536\n\n# For services (systemd unit):\n# [Service]\n# LimitNOFILE=65536\n# LimitNPROC=4096\n",[18,1341,1342,1347,1361,1374,1378,1383,1388,1393,1397,1402,1407,1412],{"__ignoreMap":90},[94,1343,1344],{"class":96,"line":97},[94,1345,1346],{"class":100},"# Per-shell (ulimit):\n",[94,1348,1349,1352,1355,1358],{"class":96,"line":104},[94,1350,1351],{"class":223},"ulimit",[94,1353,1354],{"class":223}," -n",[94,1356,1357],{"class":223}," 65536",[94,1359,1360],{"class":100},"               # max open files\n",[94,1362,1363,1365,1368,1371],{"class":96,"line":124},[94,1364,1351],{"class":223},[94,1366,1367],{"class":223}," -u",[94,1369,1370],{"class":223}," 4096",[94,1372,1373],{"class":100},"                # max processes\n",[94,1375,1376],{"class":96,"line":139},[94,1377,441],{"emptyLinePlaceholder":440},[94,1379,1380],{"class":96,"line":154},[94,1381,1382],{"class":100},"# Persistent (\u002Fetc\u002Fsecurity\u002Flimits.conf):\n",[94,1384,1385],{"class":96,"line":169},[94,1386,1387],{"class":100},"# *    soft  nofile  65536\n",[94,1389,1390],{"class":96,"line":184},[94,1391,1392],{"class":100},"# *    hard  nofile  65536\n",[94,1394,1395],{"class":96,"line":199},[94,1396,441],{"emptyLinePlaceholder":440},[94,1398,1399],{"class":96,"line":230},[94,1400,1401],{"class":100},"# For services (systemd unit):\n",[94,1403,1404],{"class":96,"line":243},[94,1405,1406],{"class":100},"# [Service]\n",[94,1408,1409],{"class":96,"line":581},[94,1410,1411],{"class":100},"# LimitNOFILE=65536\n",[94,1413,1414],{"class":96,"line":587},[94,1415,1416],{"class":100},"# LimitNPROC=4096\n",[27,1418,1420],{"id":1419},"tips-tricks","💡 Tips & Tricks",[1422,1423,1424,1452,1470,1489,1503,1516],"ul",{},[35,1425,1426,1429,1430,1433,1434,1437,1438,1440,1441,1444,1445,1448,1449,1246],{},[38,1427,1428],{},"Idiom",": use ",[18,1431,1432],{},"visudo"," (never edit ",[18,1435,1436],{},"\u002Fetc\u002Fsudoers"," directly) — ",[18,1439,1432],{}," checks syntax before saving. A syntax error in ",[18,1442,1443],{},"sudoers"," can lock you out of root. Use ",[18,1446,1447],{},"\u002Fetc\u002Fsudoers.d\u002F"," files, mode ",[18,1450,1451],{},"440",[35,1453,1454,1456,1457,1460,1461,1464,1465,1469],{},[38,1455,1428],{},": prefer file capabilities over setuid root — ",[18,1458,1459],{},"setcap cap_net_bind_service+ep .\u002Fserver"," lets a binary bind to port 80 without running as root. Safer than ",[18,1462,1463],{},"chmod u+s"," (which grants ",[1466,1467,1468],"em",{},"all"," privileges).",[35,1471,1472,1429,1474,1476,1477,1480,1481,1484,1485,1488],{},[38,1473,1428],{},[18,1475,20],{}," with a custom ",[18,1478,1479],{},"jail.local"," (not ",[18,1482,1483],{},"jail.conf"," — it's overwritten on updates). Set ",[18,1486,1487],{},"banaction = ufw"," to integrate with your firewall.",[35,1490,1491,1493,1494,1496,1497,1499,1500,1502],{},[38,1492,1428],{},": don't disable SELinux — use ",[18,1495,710],{}," to debug, then fix the policy with ",[18,1498,813],{}," or ",[18,1501,799],{},". Disabling removes a key security layer.",[35,1504,1505,1507,1508,1511,1512,1515],{},[38,1506,1428],{},": install ",[18,1509,1510],{},"aide"," and establish a baseline at provisioning — run ",[18,1513,1514],{},"aide --check"," daily. An attacker who modifies binaries or configs will show up as a change.",[35,1517,1518,1429,1521,1524],{},[38,1519,1520],{},"Debug",[18,1522,1523],{},"sudo ausearch -m AVC -ts recent"," when SELinux blocks something — shows the exact denial and which process\u002Ffile was involved.",[27,1526,1528],{"id":1527},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1422,1530,1531,1544,1554,1572,1586,1596,1618,1628],{},[35,1532,1533,1536,1537,1540,1541,1246],{},[38,1534,1535],{},"Always allow SSH before enabling UFW",": otherwise you lock yourself out. ",[18,1538,1539],{},"sudo ufw allow 22\u002Ftcp"," BEFORE ",[18,1542,1543],{},"sudo ufw enable",[35,1545,1546,1549,1550,1553],{},[38,1547,1548],{},"Never disable password auth before verifying key auth",": ",[18,1551,1552],{},"ssh -i key user@server"," first. If it works, THEN disable passwords.",[35,1555,1556,1565,1566,1499,1569,1571],{},[38,1557,1558,1561,1562],{},[18,1559,1560],{},"PermitRootLogin no"," doesn't lock out ",[18,1563,1564],{},"su -",": it only disables SSH login as root. You can still ",[18,1567,1568],{},"sudo -i",[18,1570,1564],{}," from a regular account.",[35,1573,1574,1577,1578,1581,1582,1585],{},[38,1575,1576],{},"SELinux blocks with \"Permission denied\" even when Unix perms look fine",": check ",[18,1579,1580],{},"ausearch -m AVC"," for denials. Common on RHEL when serving files with wrong labels (",[18,1583,1584],{},"restorecon -Rv"," fixes).",[35,1587,1588,1595],{},[38,1589,1590,1591,1594],{},"Passwordless sudo (",[18,1592,1593],{},"NOPASSWD: ALL",") is a security hole",": any compromise of that user = instant root. Limit to specific commands.",[35,1597,1598,1549,1603,1605,1606,1609,1610,1613,1614,1617],{},[38,1599,1600,1602],{},[18,1601,108],{}," timestamp is per-terminal by default",[18,1604,108],{}," in one terminal doesn't cache for another. Use ",[18,1607,1608],{},"sudo -v"," in each terminal, or set ",[18,1611,1612],{},"tty_tickets"," to ",[18,1615,1616],{},"no"," in sudoers (less secure).",[35,1619,1620,1623,1624,1627],{},[38,1621,1622],{},"Logs on a compromised machine can't be trusted",": an attacker with root can delete ",[18,1625,1626],{},"\u002Fvar\u002Flog",". Forward logs to a remote server (so an attacker can't delete them).",[35,1629,1630,1636],{},[38,1631,1632,1635],{},[18,1633,1634],{},"barrier=0"," risks data corruption on power loss",": write barriers ensure write ordering. Disabling them is faster but risks filesystem corruption.",[27,1638,1640],{"id":1639},"quick-quiz","🧠 Quick Quiz",[14,1642,1643,1644,1647,1648,1651],{},"An admin sets ",[18,1645,1646],{},"PasswordAuthentication no"," in ",[18,1649,1650],{},"sshd_config",", reloads sshd, and loses SSH access. They have no physical access to the server. What went wrong, and how could they have prevented this?",[1653,1654,1655,1659,1669,1674],"details",{},[1656,1657,1658],"summary",{},"Answer",[14,1660,1661,1662,21,1665,1668],{},"They disabled password authentication without verifying that key-based authentication works. Their SSH key may not be properly set up on the server (wrong permissions in ",[18,1663,1664],{},"~\u002F.ssh\u002F",[18,1666,1667],{},"authorized_keys"," not in place, or the key wasn't copied).",[14,1670,1671],{},[38,1672,1673],{},"Prevention:",[32,1675,1676,1705,1711,1736],{},[35,1677,1678,1681],{},[38,1679,1680],{},"Always test key auth before disabling passwords:",[82,1682,1683,1689,1693,1696,1700],{"language":84},[86,1684,1685],{"className":88,"code":90,"language":84,"meta":90,"style":90},[18,1686,1687],{"__ignoreMap":90},[94,1688],{"class":96,"line":97},[10,1690,1692],{"id":1691},"from-a-different-terminal-keep-the-current-ssh-session-open-as-a-safety-net","From a DIFFERENT terminal (keep the current SSH session open as a safety net):",[14,1694,1695],{},"ssh -i ~\u002F.ssh\u002Fid_ed25519 alice@server",[10,1697,1699],{"id":1698},"if-this-works-youre-safe-to-disable-passwords","If this works, you're safe to disable passwords",[86,1701,1703],{"className":1702,"code":90,"language":372},[370],[18,1704,90],{"__ignoreMap":90},[35,1706,1707,1710],{},[38,1708,1709],{},"Keep your current SSH session open"," while making SSH config changes. If the new config breaks, your existing session is unaffected (you can fix the config from there).",[35,1712,1713,1719,1720],{},[38,1714,1715,1716],{},"Use ",[18,1717,1718],{},"sshd -t"," to test config syntax before reloading:",[82,1721,1722,1728,1731],{"language":84},[86,1723,1724],{"className":88,"code":90,"language":84,"meta":90,"style":90},[18,1725,1726],{"__ignoreMap":90},[94,1727],{"class":96,"line":97},[14,1729,1730],{},"sudo sshd -t                    # test syntax\nsudo systemctl reload sshd      # reload (not restart — no dropped connections)",[86,1732,1734],{"className":1733,"code":90,"language":372},[370],[18,1735,90],{"__ignoreMap":90},[35,1737,1738,1741,1742,1745],{},[38,1739,1740],{},"If already locked out",": boot to rescue mode (cloud provider's console, or VNC), mount the root filesystem, and re-enable ",[18,1743,1744],{},"PasswordAuthentication yes"," or fix the key setup.",[1747,1748,1749],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}",{"title":90,"searchDepth":104,"depth":104,"links":1751},[1752,1753,1758,1761,1763,1767,1768,1770,1771,1772,1773,1774,1775,1776],{"id":29,"depth":104,"text":30},{"id":74,"depth":104,"text":75,"children":1754},[1755,1756,1757],{"id":79,"depth":124,"text":80},{"id":256,"depth":124,"text":257},{"id":304,"depth":124,"text":305},{"id":365,"depth":104,"text":366,"children":1759},[1760],{"id":412,"depth":124,"text":413},{"id":507,"depth":104,"text":1762},"fail2ban — Brute-Force Protection",{"id":662,"depth":104,"text":663,"children":1764},[1765,1766],{"id":672,"depth":124,"text":673},{"id":836,"depth":124,"text":837},{"id":882,"depth":104,"text":883},{"id":990,"depth":104,"text":1769},"auditd — Security Auditing",{"id":1150,"depth":104,"text":1151},{"id":1232,"depth":104,"text":1233},{"id":1249,"depth":104,"text":1250},{"id":1333,"depth":104,"text":1334},{"id":1419,"depth":104,"text":1420},{"id":1527,"depth":104,"text":1528},{"id":1639,"depth":104,"text":1640},"Linux is relatively secure by default, but a stock install is not hardened. This chapter covers the defense-in-depth stack: firewall, SSH hardening, SELinux\u002FAppArmor, fail2ban, auditd, capabilities, and the mindset of reducing attack surface. Security is layered — no single tool is sufficient.","md",{},"\u002Flinux\u002F14-security-and-hardening",{"title":5,"description":1777},"linux\u002F14-security-and-hardening","qUYNjNQmlJ7miCDqP7GmdUHg-Omy7NTvcKfT69pzsWk",1789140923612]