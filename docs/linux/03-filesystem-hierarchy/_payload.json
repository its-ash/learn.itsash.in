,663,668],{"__ignoreMap":49},[53,635,636],{"class":55,"line":56},[53,637,638],{"class":410},"# NAIVE: try to measure \u002Fproc size (it's all virtual, in-kernel)\n",[53,640,641,644,647,650],{"class":55,"line":63},[53,642,643],{"class":59},"du",[53,645,646],{"class":479}," -sh",[53,648,649],{"class":69}," \u002Fproc",[53,651,652],{"class":410},"                          # reports 0 or errors\n",[53,654,655],{"class":55,"line":89},[53,656,657],{"class":410},"# Anti-Pattern: backing up \u002Fproc, \u002Fsys, \u002Fdev — they're generated at read time\n",[53,659,660],{"class":55,"line":110},[53,661,662],{"class":410},"# sudo tar -czf backup.tar.gz \u002F                     → includes garbage\n",[53,664,665],{"class":55,"line":131},[53,666,667],{"class":410},"# PRODUCTION: always exclude virtual filesystems\n",[53,669,670,673,676,679,682,685,688,691,694],{"class":55,"line":156},[53,671,672],{"class":59},"sudo",[53,674,675],{"class":69}," tar",[53,677,678],{"class":479}," -czf",[53,680,681],{"class":69}," backup.tar.gz",[53,683,684],{"class":479}," --exclude=\u002Fproc",[53,686,687],{"class":479}," --exclude=\u002Fsys",[53,689,690],{"class":479}," --exclude=\u002Fdev",[53,692,693],{"class":479}," --exclude=\u002Frun",[53,695,696],{"class":69}," \u002F\n",[36,698,700],{"id":699},"inodes-how-files-actually-work","Inodes — How Files Actually Work",[14,702,703,704,707],{},"A filesystem stores files as ",[31,705,706],{},"inodes"," (index nodes), not names. An inode holds the file's metadata and data block pointers; the directory just maps names to inode numbers.",[41,709,710],{"language":43},[45,711,713],{"className":47,"code":712,"language":43,"meta":49,"style":49},"Directory entry:        Inode (stored in the filesystem):\n  \"passwd\" → inode 123     inode 123:\n                              type: regular file\n                              size: 3218\n                              mode: 0644\n                              owner UID: 0\n                              mtime