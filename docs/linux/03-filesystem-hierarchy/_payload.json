nguage":43},[45,1525,1527],{"className":47,"code":1526,"language":43,"meta":49,"style":49},"# If \u002Fmnt\u002Fdata has files and you mount a filesystem there:\nsudo mount \u002Fdev\u002Fsdb1 \u002Fmnt\u002Fdata\n# The existing files are HIDDEN (not deleted) until you unmount.\n# Confusing if you forgot a mount is active. Unmount to see them again:\nsudo umount \u002Fmnt\u002Fdata\nls \u002Fmnt\u002Fdata                # original files reappear\n",[18,1528,1529,1534,1545,1550,1555,1563],{"__ignoreMap":49},[53,1530,1531],{"class":55,"line":56},[53,1532,1533],{"class":410},"# If \u002Fmnt\u002Fdata has files and you mount a filesystem there:\n",[53,1535,1536,1538,1540,1543],{"class":55,"line":63},[53,1537,672],{"class":59},[53,1539,1218],{"class":69},[53,1541,1542],{"class":69}," \u002Fdev\u002Fsdb1",[53,1544,1236],{"class":69},[53,1546,1547],{"class":55,"line":89},[53,1548,1549],{"class":410},"# The existing files are HIDDEN (not deleted) until you unmount.\n",[53,1551,1552],{"class":55,"line":110},[53,1553,1554],{"class":410},"# Confusing if you forgot a mount is active. Unmount to see them again:\n",[53,1556,1557,1559,1561],{"class":55,"line":131},[53,1558,672],{"class":59},[53,1560,1243],{"class":69},[53,1562,1236],{"class":69},[53,1564,1565,1567,1569],{"class":55,"line":156},[53,1566,476],{"class":59},[53,1568,1246],{"class":69},[53,1570,1571],{"class":410},"                # original files reappear\n",[36,1573,1575],{"id":1574},"filesystem-types","Filesystem Types",[1577,1578,1579,1592],"table",{},[1580,1581,1582],"thead",{},[1583,1584,1585,1589],"tr",{},[1586,1587,1588],"th",{},"Type",[1586,1590,1591],{},"Use",[1593,1594,1595,1606,1616,1626,1636,1652,1665,1683],"tbody",{},[1583,1596,1597,1603],{},[1598,1599,1600],"td",{},[18,1601,1602],{},"ext4",[1598,1604,1605],{},"Default on most Linux distros — mature, journaling, widely supported",[1583,1607,1608,1613],{},[1598,1609,1610],{},[18,1611,1612],{},"xfs",[1598,1614,1615],{},"Default on RHEL\u002FRocky — excellent for large files, online grow",[1583,1617,1618,1623],{},[1598,1619,1620],{},[18,1621,1622],{},"btrfs",[1598,1624,1625],{},"Copy-on-write, snapshots, compression, subvolumes",[1583,1627,1628,1633],{},[1598,1629,1630],{},[18,1631,1632],{},"zfs",[1598,1634,1635],{},"Enterprise: integrity, snapshots, RAID, compression (via OpenZFS)",[1583,1637,1638,1642],{},[1598,1639,1640],{},[18,1641,1403],{},[1598,1643,1644,1645,25,1648,1651],{},"RAM-backed (used for ",[18,1646,1647],{},"\u002Ftmp",[18,1649,1650],{},"\u002Frun",") — fast, volatile",[1583,1653,1654,1662],{},[1598,1655,1656,20,1659],{},[18,1657,1658],{},"vfat",[18,1660,1661],{},"exfat",[1598,1663,1664],{},"FAT32\u002FexFAT — cross-platform USB drives",[1583,1666,1667,1672],{},[1598,1668,1669],{},[18,1670,1671],{},"ntfs",[1598,1673,1674,1675,1678,1679,1682],{},"Windows filesystem (via ",[18,1676,1677],{},"ntfs-3g"," or kernel ",[18,1680,1681],{},"ntfs3",")",[1583,1684,1685,1690],{},[1598,1686,1687],{},[18,1688,1689],{},"overlay",[1598,1691,1692],{},"OverlayFS — containers (Docker\u002FPodman layers)",[41,1694,1695],{"language":43},[45,1696,1698],{"className":47,"code":1697,"language":43,"meta":49,"style":49},"# Complex Implementation: identify all mounted filesystems with types\nfindmnt -t ext4,xfs,btrfs              # only real filesystems\ndf -hT                                 # type + size\u002Fused\u002Favail\ndf -x tmpfs -x devtmpfs -x squashfs   # exclude virtual FS from df output\n",[18,1699,1700,1705,1718,1728],{"__ignoreMap":49},[53,1701,1702],{"class":55,"line":56},[53,1703,1704],{"class":410},"# Complex Implementation: identify all mounted filesystems with types\n",[53,1706,1707,1710,1712,1715],{"class":55,"line":63},[53,1708,1709],{"class":59},"findmnt",[53,1711,1221],{"class":479},[53,1713,1714],{"class":69}," ext4,xfs,btrfs",[53,1716,1717],{"class":410},"              # only real filesystems\n",[53,1719,1720,1722,1725],{"class":55,"line":89},[53,1721,867],{"class":59},[53,1723,1724],{"class":479}," -hT",[53,1726,1727],{"class":410},"                                 # type + size\u002Fused\u002Favail\n",[53,1729,1730,1732,1735,1738,1740,1743,1745,1748],{"class":55,"line":110},[53,1731,867],{"class":59},[53,1733,1734],{"class":479}," -x",[53,1736,1737],{"class":69}," tmpfs",[53,1739,1734],{"class":479},[53,1741,1742],{"class":69}," devtmpfs",[53,1744,1734],{"class":479},[53,1746,1747],{"class":69}," squashfs",[53,1749,1750],{"class":410},"   # exclude virtual FS from df output\n",[36,1752,1754],{"id":1753},"tips-tricks","💡 Tips & Tricks",[1170,1756,1757,1782,1790,1807,1819,1843],{},[1173,1758,1759,1762,1763,1765,1766,1768,1769,1771,1772,25,1775,25,1778,1781],{},[31,1760,1761],{},"Idiom",": use ",[18,1764,1709],{}," over ",[18,1767,1188],{}," for reading mounts — ",[18,1770,1709],{}," shows a readable tree, supports ",[18,1773,1774],{},"--source",[18,1776,1777],{},"--target",[18,1779,1780],{},"--type"," filters.",[1173,1783,1784,1762,1786,1789],{},[31,1785,1761],{},[18,1787,1788],{},"lsblk"," to see the disk layout at a glance — block devices, partitions, sizes, mount points, filesystem types, in one tree.",[1173,1791,1792,1794,1795,1798,1799,1802,1803,1451,1805,1455],{},[31,1793,1761],{},": use UUIDs in ",[18,1796,1797],{},"fstab",", not ",[18,1800,1801],{},"\u002Fdev\u002Fsda1"," — device names can change across reboots. UUIDs are unique per filesystem and stable. Get them with ",[18,1804,1450],{},[18,1806,1454],{},[1173,1808,1809,1811,1812,1815,1816,1818],{},[31,1810,1761],{},": add ",[18,1813,1814],{},"noatime"," to SSD mounts in ",[18,1817,1797],{}," — disables access-time updates on every read, reducing writes and improving SSD lifespan\u002Fperformance.",[1173,1820,1821,1762,1823,1826,1827,1830,1831,1834,1835,1837,1838,1451,1841,1455],{},[31,1822,1761],{},[18,1824,1825],{},"du -x \u002F"," to measure one filesystem only — ",[18,1828,1829],{},"-x"," (",[18,1832,1833],{},"--one-file-system",") prevents descending into other mounts, so you measure just ",[18,1836,20],{}," not ",[18,1839,1840],{},"\u002Fhome",[18,1842,388],{},[1173,1844,1845,1762,1848,1851,1852,1855],{},[31,1846,1847],{},"Debug",[18,1849,1850],{},"lsof +D \u002Fmnt\u002Fusb"," (or ",[18,1853,1854],{},"fuser -vm \u002Fmnt\u002Fusb",") to find what's blocking an unmount — shows processes with open files in that directory.",[36,1857,1859],{"id":1858},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1170,1861,1862,1880,1899,1912,1930],{},[1173,1863,1864,1867,1868,1871,1872,1875,1876,1879],{},[31,1865,1866],{},"You can run out of inodes before disk space",": millions of tiny files (e.g., a cache, mail queue) exhaust inodes first. ",[18,1869,1870],{},"df -h"," shows space free, but ",[18,1873,1874],{},"df -i"," shows inodes exhausted. Fix: delete files or reformat with more inodes (",[18,1877,1878],{},"mkfs.ext4 -i 4096",").",[1173,1881,1882,1885,1886,1889,1890,622,1892,1894,1895,1898],{},[31,1883,1884],{},"Hard links can't cross filesystems",": ",[18,1887,1888],{},"ln \u002Fhome\u002Falice\u002Ffile \u002Ftmp\u002Flink"," fails if ",[18,1891,1840],{},[18,1893,1647],{}," are different filesystems. Use ",[18,1896,1897],{},"ln -s"," (symlink) instead — but it breaks if the target moves.",[1173,1900,1901,1885,1904,1907,1908,1911],{},[31,1902,1903],{},"Moving a file across filesystems is copy + delete",[18,1905,1906],{},"mv \u002Fhome\u002Fbigfile \u002Fmnt\u002Fusb\u002F"," copies then deletes. If it runs out of space mid-copy, the destination has a partial file and the source may be gone. Use ",[18,1909,1910],{},"rsync -a --remove-source-files"," for safer cross-FS moves.",[1173,1913,1914,1919,1920,1922,1923,1926,1927,1929],{},[31,1915,1916,1918],{},[18,1917,1337],{}," errors can prevent booting",": a bad ",[18,1921,1797],{}," entry causes boot to drop to emergency mode. Test with ",[18,1924,1925],{},"sudo mount -a"," before rebooting. Use ",[18,1928,1462],{}," for non-critical mounts (e.g., USB) so boot continues if absent.",[1173,1931,1932,1885,1938,1941,1942,1945,1946,1949,1950,1953],{},[31,1933,1934,1937],{},[18,1935,1936],{},"\u002Fboot"," can fill up from old kernels",[18,1939,1940],{},"apt"," keeps old kernel images. ",[18,1943,1944],{},"df -h \u002Fboot"," filling up causes upgrade failures. Clean with ",[18,1947,1948],{},"sudo apt autoremove --purge"," (Debian\u002FUbuntu) or ",[18,1951,1952],{},"dnf remove --oldinstallonly"," (Fedora).",[36,1955,1957],{"id":1956},"quick-quiz","🧠 Quick Quiz",[14,1959,1960,1961,1964,1965,1968],{},"A user runs ",[18,1962,1963],{},"df -h \u002F"," and sees 40 GB free, but ",[18,1966,1967],{},"touch \u002Ftestfile"," fails with \"No space left on device\". What's likely happening, and how do you confirm it?",[1970,1971,1972,1976,1979,2025,2067],"details",{},[1973,1974,1975],"summary",{},"Answer",[14,1977,1978],{},"Two likely causes:",[1980,1981,1982,1996],"ol",{},[1173,1983,1984,1987,1988,1991,1992,1995],{},[31,1985,1986],{},"Inode exhaustion"," — the filesystem has free space but no free inodes (too many tiny files). Confirm with ",[18,1989,1990],{},"df -i \u002F"," — if ",[18,1993,1994],{},"IUse%"," is 100%, you're out of inodes. Fix by deleting files (especially many small ones), or reformat with more inodes.",[1173,1997,1998,1471,2001,2003,2004,2006,2007,2009,2010,2013,2014,2017,2018,2021,2022,1455],{},[31,1999,2000],{},"A separate small filesystem is full",[18,2002,20],{}," might have space, but the file is being created on a different mounted filesystem (e.g., ",[18,2005,1647],{}," is ",[18,2008,1403],{}," with a ",[18,2011,2012],{},"size="," limit, or ",[18,2015,2016],{},"\u002Fvar"," is a separate partition). Confirm with ",[18,2019,2020],{},"df -h \u002Ftestfile"," (resolves the actual filesystem) or ",[18,2023,2024],{},"findmnt \u002Ftestfile",[41,2026,2027],{"language":43},[45,2028,2030],{"className":47,"code":2029,"language":43,"meta":49,"style":49},"df -i \u002F                 # check inode usage\ndf -h \u002Ftestfile         # which filesystem does \u002Ftestfile live on?\nfindmnt -T \u002Ftestfile    # same, more readable\n",[18,2031,2032,2043,2055],{"__ignoreMap":49},[53,2033,2034,2036,2038,2040],{"class":55,"line":56},[53,2035,867],{"class":59},[53,2037,846],{"class":479},[53,2039,872],{"class":69},[53,2041,2042],{"class":410},"                 # check inode usage\n",[53,2044,2045,2047,2049,2052],{"class":55,"line":63},[53,2046,867],{"class":59},[53,2048,898],{"class":479},[53,2050,2051],{"class":69}," \u002Ftestfile",[53,2053,2054],{"class":410},"         # which filesystem does \u002Ftestfile live on?\n",[53,2056,2057,2059,2062,2064],{"class":55,"line":89},[53,2058,1709],{"class":59},[53,2060,2061],{"class":479}," -T",[53,2063,2051],{"class":69},[53,2065,2066],{"class":410},"    # same, more readable\n",[14,2068,2069,2070,2073],{},"Also check filesystem quotas (",[18,2071,2072],{},"quota -v",") if enabled — a user can hit their quota even if the filesystem has space.",[2075,2076,2077],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}",{"title":49,"searchDepth":63,"depth":63,"links":2079},[2080,2081,2086,2090,2095,2096,2097,2098],{"id":38,"depth":63,"text":39},{"id":385,"depth":63,"text":2082,"children":2083},"\u002Fproc — Process & Kernel Info (Virtual)",[2084],{"id":618,"depth":89,"text":2085},"Edge Case: \u002Fproc and \u002Fsys Are RAM-Only",{"id":699,"depth":63,"text":700,"children":2087},[2088,2089],{"id":878,"depth":89,"text":879},{"id":1025,"depth":89,"text":1026},{"id":1181,"depth":63,"text":1182,"children":2091},[2092,2094],{"id":1334,"depth":89,"text":2093},"\u002Fetc\u002Ffstab — Persistent Mounts",{"id":1520,"depth":89,"text":1521},{"id":1574,"depth":63,"text":1575},{"id":1753,"depth":63,"text":1754},{"id":1858,"depth":63,"text":1859},{"id":1956,"depth":63,"text":1957},"Linux organizes every file under a single root directory, \u002F. There are no drive letters (C:, D:) — additional disks are mounted into the tree at directories (mount points). This chapter covers the standard layout, virtual filesystems, inodes, and mount mechanics — through production patterns and edge-case behavior.","md",{},"\u002Flinux\u002F03-filesystem-hierarchy",{"title":5,"description":2099},"linux\u002F03-filesystem-hierarchy","Z14a-KzgOvzbO4dbFEqlrQtzEC1Y12qr9_QoyvZj3Pk",1789747015347]