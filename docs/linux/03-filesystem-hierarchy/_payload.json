data: PID files, sockets)\n",[36,384,386,389],{"id":385},"proc-process-kernel-info-virtual",[18,387,388],{},"\u002Fproc"," — Process & Kernel Info (Virtual)",[14,391,392,394,395,398],{},[18,393,388],{}," is a ",[31,396,397],{},"virtual filesystem"," — the files don't exist on disk; the kernel generates their content on the fly when you read them.",[41,400,401],{"language":43},[45,402,404],{"className":47,"code":403,"language":43,"meta":49,"style":49},"# Complex Implementation: read per-process state from \u002Fproc\u002F\u003Cpid>\u002F\n# — no ps\u002Ftop needed; the kernel exposes everything as files\npid=1\ncat \u002Fproc\u002F$pid\u002Fcomm                    # process name (e.g., \"systemd\")\ncat \u002Fproc\u002F$pid\u002Fcmdline | tr '\\0' ' '   # args (null-separated → space)\nls -l \u002Fproc\u002F$pid\u002Fcwd                   # symlink to working directory\nls -l \u002Fproc\u002F$pid\u002Fexe                   # symlink to the executable\nls -l \u002Fproc\u002F$pid\u002Ffd\u002F                   # open file descriptors (symlinks)\ncat \u002Fproc\u002F$pid\u002Fenviron | tr '\\0' '\\n'  # environment (null-separated → newline)\ncat \u002Fproc\u002F$pid\u002Fstatus | head -15       # human-readable status (UID, memory, state)\n\n# Kernel tunables — read AND write (writing changes live kernel state):\ncat \u002Fproc\u002Fsys\u002Fnet\u002Fipv4\u002Fip_forward      # 0 or 1\necho 1 | sudo tee \u002Fproc\u002Fsys\u002Fnet\u002Fipv4\u002Fip_forward  # enable IP forwarding NOW\n# (prefer: sudo sysctl -w net.ipv4.ip_forward=1)\n",[18,405,406,412,417,429,446,472,491,507,523,546,568,574,579,589,610],{"__ignoreMap":49},[53,407,408],{"class":55,"line":56},[53,409,411],{"class":410},"sdCPZ","# Complex Implementation: read per-process state from \u002Fproc\u002F\u003Cpid>\u002F\n",[53,413,414],{"class":55,"line":63},[53,415,416],{"class":410},"# — no ps\u002Ftop needed; the kernel exposes everything as files\n",[53,418,419,422,426],{"class":55,"line":89},[53,420,421],{"class":79},"pid",[53,423,425],{"class":424},"svdQ7","=",[53,427,428],{"class":69},"1\n",[53,430,431,434,437,440,443],{"class":55,"line":110},[53,432,433],{"class":59},"cat",[53,435,436],{"class":69}," \u002Fproc\u002F",[53,438,439],{"class":79},"$pid",[53,441,442],{"class":69},"\u002Fcomm",[53,444,445],{"class":410},"                    # process name (e.g., \"systemd\")\n",[53,447,448,450,452,454,457,460,463,466,469],{"class":55,"line":131},[53,449,433],{"class":59},[53,451,436],{"class":69},[53,453,439],{"class":79},[53,455,456],{"class":69},"\u002Fcmdline",[53,458,459],{"class":424}," |",[53,461,462],{"class":59}," tr",[53,464,465],{"class":69}," '\\0'",[53,467,468],{"class":69}," ' '",[53,470,471],{"class":410},"   # args (null-separated → space)\n",[53,473,474,477,481,483,485,488],{"class":55,"line":156},[53,475,476],{"class":59},"ls",[53,478,480],{"class":479},"snvgF"," -l",[53,482,436],{"class":69},[53,484,439],{"class":79},[53,486,487],{"class":69},"\u002Fcwd",[53,489,490],{"class":410},"                   # symlink to working directory\n",[53,492,493,495,497,499,501,504],{"class":55,"line":168},[53,494,476],{"class":59},[53,496,480],{"class":479},[53,498,436],{"class":69},[53,500,439],{"class":79},[53,502,503],{"class":69},"\u002Fexe",[53,505,506],{"class":410},"                   # symlink to the executable\n",[53,508,509,511,513,515,517,520],{"class":55,"line":178},[53,510,476],{"class":59},[53,512,480],{"class":479},[53,514,436],{"class":69},[53,516,439],{"class":79},[53,518,519],{"class":69},"\u002Ffd\u002F",[53,521,522],{"class":410},"                   # open file descriptors (symlinks)\n",[53,524,525,527,529,531,534,536,538,540,543],{"class":55,"line":188},[53,526,433],{"class":59},[53,528,436],{"class":69},[53,530,439],{"class":79},[53,532,533],{"class":69},"\u002Fenviron",[53,535,459],{"class":424},[53,537,462],{"class":59},[53,539,465],{"class":69},[53,541,542],{"class":69}," '\\n'",[53,544,545],{"class":410},"  # environment (null-separated → 