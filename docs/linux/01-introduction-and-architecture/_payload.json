[{"data":1,"prerenderedAt":1954},["ShallowReactive",2],{"page-\u002Flinux\u002F01-introduction-and-architecture":3},{"id":4,"title":5,"body":6,"description":1947,"extension":1948,"meta":1949,"navigation":264,"path":1950,"seo":1951,"stem":1952,"__hash__":1953},"content\u002Flinux\u002F01-introduction-and-architecture.md","01 — Introduction & Architecture",{"type":7,"value":8,"toc":1925},"minimark",[9,13,22,27,38,58,62,76,135,138,146,180,185,301,322,326,329,438,442,462,466,584,592,618,679,683,723,891,895,1066,1070,1090,1222,1229,1317,1390,1394,1486,1490,1501,1579,1626,1630,1707,1711,1828,1832,1843,1921],[10,11,5],"h1",{"id":12},"_01-introduction-architecture",[14,15,16,17,21],"p",{},"Linux is a monolithic kernel managing CPU, memory, devices, and process scheduling. Combined with GNU userspace tools, a display server, and applications, it forms a ",[18,19,20],"strong",{},"Linux distribution",". This chapter covers the kernel–userspace boundary, syscall mechanics, the FHS, and the virtual filesystems that make Linux a unified system — through the lens of production code and edge-case behavior.",[23,24,26],"h2",{"id":25},"the-layers","The Layers",[28,29,35],"pre",{"className":30,"code":32,"language":33,"meta":34},[31],"language-text","┌─────────────────────────────────────┐\n│          Applications               │  Firefox, nginx, your scripts\n├─────────────────────────────────────┤\n│     GNU Userspace (coreutils)       │  bash, ls, grep, awk, sed, gcc\n├─────────────────────────────────────┤\n│          System Libraries           │  glibc, systemd, PAM, NSS\n├─────────────────────────────────────┤\n│            Linux Kernel             │  scheduler, memory, drivers, VFS\n├─────────────────────────────────────┤\n│          Hardware (CPU\u002FRAM\u002Fdisk)    │\n└─────────────────────────────────────┘\n","text","",[36,37,32],"code",{"__ignoreMap":34},[39,40,41,48],"ul",{},[42,43,44,47],"li",{},[18,45,46],{},"Kernel space"," — privileged, full hardware access (ring 0 on x86).",[42,49,50,53,54,57],{},[18,51,52],{},"User space"," — unprivileged, goes through the kernel via ",[18,55,56],{},"syscalls",".",[23,59,61],{"id":60},"kernel-vs-userspace-the-syscall-boundary","Kernel vs Userspace — The Syscall Boundary",[14,63,64,65,68,69,72,73,75],{},"Every process runs in ",[18,66,67],{},"user space"," until it needs a kernel service (read a file, allocate memory, send a packet). It then issues a ",[18,70,71],{},"syscall"," — a controlled transition into kernel mode via a software interrupt or ",[36,74,71],{}," instruction.",[77,78,80],"code-wrapper",{"language":79},"bash",[28,81,84],{"className":82,"code":83,"language":79,"meta":34,"style":34},"language-bash shiki shiki-themes github-light github-dark","# Complex Implementation: count every syscall `ls` makes against \u002Fetc\n# — reveals the true cost of \"just listing a directory\"\nstrace -c -e trace=openat,read,close,getdents64,statx ls \u002Fetc >\u002Fdev\u002Fnull 2>&1\n",[36,85,86,95,101],{"__ignoreMap":34},[87,88,91],"span",{"class":89,"line":90},"line",1,[87,92,94],{"class":93},"sdCPZ","# Complex Implementation: count every syscall `ls` makes against \u002Fetc\n",[87,96,98],{"class":89,"line":97},2,[87,99,100],{"class":93},"# — reveals the true cost of \"just listing a directory\"\n",[87,102,104,108,112,115,119,122,125,129,132],{"class":89,"line":103},3,[87,105,107],{"class":106},"sIsaT","strace",[87,109,111],{"class":110},"snvgF"," -c",[87,113,114],{"class":110}," -e",[87,116,118],{"class":117},"sJ6F3"," trace=openat,read,close,getdents64,statx",[87,120,121],{"class":117}," ls",[87,123,124],{"class":117}," \u002Fetc",[87,126,128],{"class":127},"svdQ7"," >",[87,130,131],{"class":117},"\u002Fdev\u002Fnull",[87,133,134],{"class":127}," 2>&1\n",[14,136,137],{},"Output (truncated):",[77,139,140],{"language":33},[28,141,144],{"className":142,"code":143,"language":33,"meta":34},[31],"% time     seconds  usecs\u002Fcall     calls    errors syscall\n------ ----------- ----------- --------- --------- ----------------\n  0.00    0.000000           0        10           openat\n  0.00    0.000000           0        14           newfstatat\n  0.00    0.000000           0         7           getdents64\n  0.00    0.000000           0        31           close\n  100.00    0.000000                    62           total\n",[36,145,143],{"__ignoreMap":34},[14,147,148,149,152,153,156,157,160,161,160,164,167,168,171,172,175,176,179],{},"Key syscalls: ",[36,150,151],{},"openat"," (open a file), ",[36,154,155],{},"read","\u002F",[36,158,159],{},"write",", ",[36,162,163],{},"close",[36,165,166],{},"mmap"," (map file into memory), ",[36,169,170],{},"fork"," (create process), ",[36,173,174],{},"execve"," (run a program), ",[36,177,178],{},"exit"," (terminate).",[181,182,184],"h3",{"id":183},"caveat-anti-pattern-syscall-overhead-in-hot-paths","Caveat & Anti-Pattern: Syscall Overhead in Hot Paths",[77,186,187],{"language":79},[28,188,190],{"className":82,"code":189,"language":79,"meta":34,"style":34},"# NAIVE: 1 syscall per line — 1 million lines = 1 million syscalls\nwhile IFS= read -r line; do\n  printf '%s\\n' \"$line\"\ndone \u003C bigfile.txt\n# ~10 seconds for 1M lines (syscall overhead dominates)\n\n# PRODUCTION: batch I\u002FO — read in chunks, process in userspace\n# Use awk\u002Fsed (buffered I\u002FO, orders of magnitude faster)\nawk '{print}' bigfile.txt > \u002Fdev\u002Fnull\n# ~0.1 seconds for the same 1M lines — buffered read, no per-line syscall\n",[36,191,192,197,224,241,253,259,266,272,278,295],{"__ignoreMap":34},[87,193,194],{"class":89,"line":90},[87,195,196],{"class":93},"# NAIVE: 1 syscall per line — 1 million lines = 1 million syscalls\n",[87,198,199,202,206,209,212,215,218,221],{"class":89,"line":97},[87,200,201],{"class":127},"while",[87,203,205],{"class":204},"ssxIu"," IFS",[87,207,208],{"class":127},"=",[87,210,211],{"class":110}," read",[87,213,214],{"class":110}," -r",[87,216,217],{"class":117}," line",[87,219,220],{"class":204},"; ",[87,222,223],{"class":127},"do\n",[87,225,226,229,232,235,238],{"class":89,"line":103},[87,227,228],{"class":110},"  printf",[87,230,231],{"class":117}," '%s\\n'",[87,233,234],{"class":117}," \"",[87,236,237],{"class":204},"$line",[87,239,240],{"class":117},"\"\n",[87,242,244,247,250],{"class":89,"line":243},4,[87,245,246],{"class":127},"done",[87,248,249],{"class":127}," \u003C",[87,251,252],{"class":204}," bigfile.txt\n",[87,254,256],{"class":89,"line":255},5,[87,257,258],{"class":93},"# ~10 seconds for 1M lines (syscall overhead dominates)\n",[87,260,262],{"class":89,"line":261},6,[87,263,265],{"emptyLinePlaceholder":264},true,"\n",[87,267,269],{"class":89,"line":268},7,[87,270,271],{"class":93},"# PRODUCTION: batch I\u002FO — read in chunks, process in userspace\n",[87,273,275],{"class":89,"line":274},8,[87,276,277],{"class":93},"# Use awk\u002Fsed (buffered I\u002FO, orders of magnitude faster)\n",[87,279,281,284,287,290,292],{"class":89,"line":280},9,[87,282,283],{"class":106},"awk",[87,285,286],{"class":117}," '{print}'",[87,288,289],{"class":117}," bigfile.txt",[87,291,128],{"class":127},[87,293,294],{"class":117}," \u002Fdev\u002Fnull\n",[87,296,298],{"class":89,"line":297},10,[87,299,300],{"class":93},"# ~0.1 seconds for the same 1M lines — buffered read, no per-line syscall\n",[14,302,303,304,306,307,309,310,160,312,160,315,160,318,321],{},"The ",[36,305,155],{}," syscall fetches one buffer at a time; the shell ",[36,308,155],{}," builtin re-enters the kernel for every line. For any I\u002FO-heavy pipeline, prefer tools that buffer (",[36,311,283],{},[36,313,314],{},"sed",[36,316,317],{},"grep",[36,319,320],{},"dd",").",[23,323,325],{"id":324},"distributions-distros","Distributions (Distros)",[14,327,328],{},"A distro = kernel + GNU tools + package manager + init system + default apps. The major families:",[330,331,332,351],"table",{},[333,334,335],"thead",{},[336,337,338,342,345,348],"tr",{},[339,340,341],"th",{},"Family",[339,343,344],{},"Examples",[339,346,347],{},"Package Manager",[339,349,350],{},"Init",[352,353,354,374,392,407,424],"tbody",{},[336,355,356,360,363,371],{},[357,358,359],"td",{},"Debian",[357,361,362],{},"Debian, Ubuntu, Mint, Pop!_OS",[357,364,365,156,368],{},[36,366,367],{},"apt",[36,369,370],{},"dpkg",[357,372,373],{},"systemd",[336,375,376,379,382,390],{},[357,377,378],{},"Red Hat",[357,380,381],{},"RHEL, Fedora, CentOS Stream, Rocky, Alma",[357,383,384,156,387],{},[36,385,386],{},"dnf",[36,388,389],{},"rpm",[357,391,373],{},[336,393,394,397,400,405],{},[357,395,396],{},"Arch",[357,398,399],{},"Arch, Manjaro, EndeavourOS",[357,401,402],{},[36,403,404],{},"pacman",[357,406,373],{},[336,408,409,412,415,422],{},[357,410,411],{},"SUSE",[357,413,414],{},"openSUSE, SLES",[357,416,417,156,420],{},[36,418,419],{},"zypper",[36,421,389],{},[357,423,373],{},[336,425,426,429,432,435],{},[357,427,428],{},"Independent",[357,430,431],{},"Gentoo, NixOS, Alpine, Void",[357,433,434],{},"portage\u002Fnix\u002Fapk\u002Fxbps",[357,436,437],{},"systemd\u002FOpenRC",[181,439,441],{"id":440},"which-distro-should-you-use","Which Distro Should You Use?",[39,443,444,450,456],{},[42,445,446,449],{},[18,447,448],{},"Server"," — Debian, Ubuntu LTS, RHEL\u002FRocky, AlmaLinux. Stability, long support.",[42,451,452,455],{},[18,453,454],{},"Learning"," — Arch Linux. You build it yourself; you understand every piece.",[42,457,458,461],{},[18,459,460],{},"Minimal\u002Fembedded"," — Alpine (5 MB), NixOS (reproducible), Void (musl).",[23,463,465],{"id":464},"check-your-system","Check Your System",[77,467,468],{"language":79},[28,469,471],{"className":82,"code":470,"language":79,"meta":34,"style":34},"# Complex Implementation: portable system identification — works across all distros\n# \u002Fetc\u002Fos-release is FHS-specified (always present); lsb_release is not\n. \u002Fetc\u002Fos-release                    # source it (sets $NAME, $VERSION_ID, etc.)\necho \"Distro: $PRETTY_NAME\"\necho \"Kernel: $(uname -r)\"\necho \"Arch:   $(uname -m)\"\necho \"Kernel build: $(uname -v)\"\n\n# Edge case: $SHELL is your LOGIN shell, not your CURRENT shell\n# If you ran `zsh` from bash, $SHELL still says \u002Fbin\u002Fbash\nps -p $$ -o comm=                   # the actual current shell\n",[36,472,473,478,483,493,506,521,535,549,553,558,563],{"__ignoreMap":34},[87,474,475],{"class":89,"line":90},[87,476,477],{"class":93},"# Complex Implementation: portable system identification — works across all distros\n",[87,479,480],{"class":89,"line":97},[87,481,482],{"class":93},"# \u002Fetc\u002Fos-release is FHS-specified (always present); lsb_release is not\n",[87,484,485,487,490],{"class":89,"line":103},[87,486,57],{"class":110},[87,488,489],{"class":117}," \u002Fetc\u002Fos-release",[87,491,492],{"class":93},"                    # source it (sets $NAME, $VERSION_ID, etc.)\n",[87,494,495,498,501,504],{"class":89,"line":243},[87,496,497],{"class":110},"echo",[87,499,500],{"class":117}," \"Distro: ",[87,502,503],{"class":204},"$PRETTY_NAME",[87,505,240],{"class":117},[87,507,508,510,513,516,518],{"class":89,"line":255},[87,509,497],{"class":110},[87,511,512],{"class":117}," \"Kernel: $(",[87,514,515],{"class":106},"uname",[87,517,214],{"class":110},[87,519,520],{"class":117},")\"\n",[87,522,523,525,528,530,533],{"class":89,"line":261},[87,524,497],{"class":110},[87,526,527],{"class":117}," \"Arch:   $(",[87,529,515],{"class":106},[87,531,532],{"class":110}," -m",[87,534,520],{"class":117},[87,536,537,539,542,544,547],{"class":89,"line":268},[87,538,497],{"class":110},[87,540,541],{"class":117}," \"Kernel build: $(",[87,543,515],{"class":106},[87,545,546],{"class":110}," -v",[87,548,520],{"class":117},[87,550,551],{"class":89,"line":274},[87,552,265],{"emptyLinePlaceholder":264},[87,554,555],{"class":89,"line":280},[87,556,557],{"class":93},"# Edge case: $SHELL is your LOGIN shell, not your CURRENT shell\n",[87,559,560],{"class":89,"line":297},[87,561,562],{"class":93},"# If you ran `zsh` from bash, $SHELL still says \u002Fbin\u002Fbash\n",[87,564,566,569,572,575,578,581],{"class":89,"line":565},11,[87,567,568],{"class":106},"ps",[87,570,571],{"class":110}," -p",[87,573,574],{"class":110}," $$",[87,576,577],{"class":110}," -o",[87,579,580],{"class":117}," comm=",[87,582,583],{"class":93},"                   # the actual current shell\n",[181,585,587,588,591],{"id":586},"edge-case-merged-usr-on-modern-distros","Edge Case: Merged ",[36,589,590],{},"\u002Fusr"," on Modern Distros",[14,593,594,595,598,599,602,603,598,606,609,610,613,614,617],{},"Since Debian\u002FUbuntu \"merged \u002Fusr\", ",[36,596,597],{},"\u002Fbin"," → ",[36,600,601],{},"\u002Fusr\u002Fbin"," and ",[36,604,605],{},"\u002Fsbin",[36,607,608],{},"\u002Fusr\u002Fsbin",". Scripts hardcoding ",[36,611,612],{},"\u002Fbin\u002Ffoo"," still work (symlinks), but the real path is ",[36,615,616],{},"\u002Fusr\u002Fbin\u002Ffoo",":",[77,619,620],{"language":79},[28,621,623],{"className":82,"code":622,"language":79,"meta":34,"style":34},"ls -ld \u002Fbin \u002Fsbin \u002Flib              # show the symlinks\n# lrwxrwxrwx 1 root root 7 ... \u002Fbin -> usr\u002Fbin\n# lrwxrwxrwx 1 root root 7 ... \u002Fsbin -> usr\u002Fsbin\n# lrwxrwxrwx 1 root root 7 ... \u002Flib -> usr\u002Flib\n\n# Anti-Pattern: hardcoding \u002Fbin\u002Fbash in a shebang on a non-merged distro\n# If the script is copied to an Alpine container (no \u002Fbin\u002Fbash, only \u002Fbin\u002Fsh),\n# it breaks. Use #!\u002Fusr\u002Fbin\u002Fenv bash for portability.\n",[36,624,625,645,650,655,660,664,669,674],{"__ignoreMap":34},[87,626,627,630,633,636,639,642],{"class":89,"line":90},[87,628,629],{"class":106},"ls",[87,631,632],{"class":110}," -ld",[87,634,635],{"class":117}," \u002Fbin",[87,637,638],{"class":117}," \u002Fsbin",[87,640,641],{"class":117}," \u002Flib",[87,643,644],{"class":93},"              # show the symlinks\n",[87,646,647],{"class":89,"line":97},[87,648,649],{"class":93},"# lrwxrwxrwx 1 root root 7 ... \u002Fbin -> usr\u002Fbin\n",[8