[{"data":1,"prerenderedAt":2078},["ShallowReactive",2],{"page-\u002Flinux\u002F01-introduction-and-architecture":3},{"id":4,"title":5,"body":6,"description":2071,"extension":2072,"meta":2073,"navigation":393,"path":2074,"seo":2075,"stem":2076,"__hash__":2077},"content\u002Flinux\u002F01-introduction-and-architecture.md","01 — Introduction & Architecture",{"type":7,"value":8,"toc":2049},"minimark",[9,13,22,27,179,199,203,217,266,269,279,313,318,426,447,451,454,563,567,587,591,708,716,742,803,807,847,1015,1019,1190,1194,1214,1346,1353,1441,1514,1518,1610,1614,1625,1703,1750,1754,1831,1835,1952,1956,1967,2045],[10,11,5],"h1",{"id":12},"_01-introduction-architecture",[14,15,16,17,21],"p",{},"Linux is a monolithic kernel managing CPU, memory, devices, and process scheduling. Combined with GNU userspace tools, a display server, and applications, it forms a ",[18,19,20],"strong",{},"Linux distribution",". This chapter covers the kernel–userspace boundary, syscall mechanics, the FHS, and the virtual filesystems that make Linux a unified system — through the lens of production code and edge-case behavior.",[23,24,26],"h2",{"id":25},"the-layers","The Layers",[28,29,31],"code-wrapper",{"language":30},"bash",[32,33,37],"pre",{"className":34,"code":35,"language":30,"meta":36,"style":36},"language-bash shiki shiki-themes github-light github-dark","┌─────────────────────────────────────┐\n│          Applications               │  Firefox, nginx, your scripts\n├─────────────────────────────────────┤\n│     GNU Userspace (coreutils)       │  bash, ls, grep, awk, sed, gcc\n├─────────────────────────────────────┤\n│          System Libraries           │  glibc, systemd, PAM, NSS\n├─────────────────────────────────────┤\n│            Linux Kernel             │  scheduler, memory, drivers, VFS\n├─────────────────────────────────────┤\n│          Hardware (CPU\u002FRAM\u002Fdisk)    │\n└─────────────────────────────────────┘\n","",[38,39,40,49,74,80,95,100,126,131,157,162,173],"code",{"__ignoreMap":36},[41,42,45],"span",{"class":43,"line":44},"line",1,[41,46,48],{"class":47},"sIsaT","┌─────────────────────────────────────┐\n",[41,50,52,55,59,62,65,68,71],{"class":43,"line":51},2,[41,53,54],{"class":47},"│",[41,56,58],{"class":57},"sJ6F3","          Applications",[41,60,61],{"class":57},"               │",[41,63,64],{"class":57},"  Firefox,",[41,66,67],{"class":57}," nginx,",[41,69,70],{"class":57}," your",[41,72,73],{"class":57}," scripts\n",[41,75,77],{"class":43,"line":76},3,[41,78,79],{"class":47},"├─────────────────────────────────────┤\n",[41,81,83,85,88,91],{"class":43,"line":82},4,[41,84,54],{"class":47},[41,86,87],{"class":57},"     GNU",[41,89,90],{"class":57}," Userspace",[41,92,94],{"class":93},"ssxIu"," (coreutils)       │  bash, ls, grep, awk, sed, gcc\n",[41,96,98],{"class":43,"line":97},5,[41,99,79],{"class":47},[41,101,103,105,108,111,114,117,120,123],{"class":43,"line":102},6,[41,104,54],{"class":47},[41,106,107],{"class":57},"          System",[41,109,110],{"class":57}," Libraries",[41,112,113],{"class":57},"           │",[41,115,116],{"class":57},"  glibc,",[41,118,119],{"class":57}," systemd,",[41,121,122],{"class":57}," PAM,",[41,124,125],{"class":57}," NSS\n",[41,127,129],{"class":43,"line":128},7,[41,130,79],{"class":47},[41,132,134,136,139,142,145,148,151,154],{"class":43,"line":133},8,[41,135,54],{"class":47},[41,137,138],{"class":57},"            Linux",[41,140,141],{"class":57}," Kernel",[41,143,144],{"class":57},"             │",[41,146,147],{"class":57},"  scheduler,",[41,149,150],{"class":57}," memory,",[41,152,153],{"class":57}," drivers,",[41,155,156],{"class":57}," VFS\n",[41,158,160],{"class":43,"line":159},9,[41,161,79],{"class":47},[41,163,165,167,170],{"class":43,"line":164},10,[41,166,54],{"class":47},[41,168,169],{"class":57},"          Hardware",[41,171,172],{"class":93}," (CPU\u002FRAM\u002Fdisk)    │\n",[41,174,176],{"class":43,"line":175},11,[41,177,178],{"class":47},"└─────────────────────────────────────┘\n",[180,181,182,189],"ul",{},[183,184,185,188],"li",{},[18,186,187],{},"Kernel space"," — privileged, full hardware access (ring 0 on x86).",[183,190,191,194,195,198],{},[18,192,193],{},"User space"," — unprivileged, goes through the kernel via ",[18,196,197],{},"syscalls",".",[23,200,202],{"id":201},"kernel-vs-userspace-the-syscall-boundary","Kernel vs Userspace — The Syscall Boundary",[14,204,205,206,209,210,213,214,216],{},"Every process runs in ",[18,207,208],{},"user space"," until it needs a kernel service (read a file, allocate memory, send a packet). It then issues a ",[18,211,212],{},"syscall"," — a controlled transition into kernel mode via a software interrupt or ",[38,215,212],{}," instruction.",[28,218,219],{"language":30},[32,220,222],{"className":34,"code":221,"language":30,"meta":36,"style":36},"# Complex Implementation: count every syscall `ls` makes against \u002Fetc\n# — reveals the true cost of \"just listing a directory\"\nstrace -c -e trace=openat,read,close,getdents64,statx ls \u002Fetc >\u002Fdev\u002Fnull 2>&1\n",[38,223,224,230,235],{"__ignoreMap":36},[41,225,226],{"class":43,"line":44},[41,227,229],{"class":228},"sdCPZ","# Complex Implementation: count every syscall `ls` makes against \u002Fetc\n",[41,231,232],{"class":43,"line":51},[41,233,234],{"class":228},"# — reveals the true cost of \"just listing a directory\"\n",[41,236,237,240,244,247,250,253,256,260,263],{"class":43,"line":76},[41,238,239],{"class":47},"strace",[41,241,243],{"class":242},"snvgF"," -c",[41,245,246],{"class":242}," -e",[41,248,249],{"class":57}," trace=openat,read,close,getdents64,statx",[41,251,252],{"class":57}," ls",[41,254,255],{"class":57}," \u002Fetc",[41,257,259],{"class":258},"svdQ7"," >",[41,261,262],{"class":57},"\u002Fdev\u002Fnull",[41,264,265],{"class":258}," 2>&1\n",[14,267,268],{},"Output (truncated):",[28,270,272],{"language":271},"text",[32,273,277],{"className":274,"code":276,"language":271,"meta":36},[275],"language-text","% time     seconds  usecs\u002Fcall     calls    errors syscall\n------ ----------- ----------- --------- --------- ----------------\n  0.00    0.000000           0        10           openat\n  0.00    0.000000           0        14           newfstatat\n  0.00    0.000000           0         7           getdents64\n  0.00    0.000000           0        31           close\n  100.00    0.000000                    62           total\n",[38,278,276],{"__ignoreMap":36},[14,280,281,282,285,286,289,290,293,294,293,297,300,301,304,305,308,309,312],{},"Key syscalls: ",[38,283,284],{},"openat"," (open a file), ",[38,287,288],{},"read","\u002F",[38,291,292],{},"write",", ",[38,295,296],{},"close",[38,298,299],{},"mmap"," (map file into memory), ",[38,302,303],{},"fork"," (create process), ",[38,306,307],{},"execve"," (run a program), ",[38,310,311],{},"exit"," (terminate).",[314,315,317],"h3",{"id":316},"caveat-anti-pattern-syscall-overhead-in-hot-paths","Caveat & Anti-Pattern: Syscall Overhead in Hot Paths",[28,319,320],{"language":30},[32,321,323],{"className":34,"code":322,"language":30,"meta":36,"style":36},"# NAIVE: 1 syscall per line — 1 million lines = 1 million syscalls\nwhile IFS= read -r line; do\n  printf '%s\\n' \"$line\"\ndone \u003C bigfile.txt\n# ~10 seconds for 1M lines (syscall overhead dominates)\n\n# PRODUCTION: batch I\u002FO — read in chunks, process in userspace\n# Use awk\u002Fsed (buffered I\u002FO, orders of magnitude faster)\nawk '{print}' bigfile.txt > \u002Fdev\u002Fnull\n# ~0.1 seconds for the same 1M lines — buffered read, no per-line syscall\n",[38,324,325,330,356,373,384,389,395,400,405,421],{"__ignoreMap":36},[41,326,327],{"class":43,"line":44},[41,328,329],{"class":228},"# NAIVE: 1 syscall per line — 1 million lines = 1 million syscalls\n",[41,331,332,335,338,341,344,347,350,353],{"class":43,"line":51},[41,333,334],{"class":258},"while",[41,336,337],{"class":93}," IFS",[41,339,340],{"class":258},"=",[41,342,343],{"class":242}," read",[41,345,346],{"class":242}," -r",[41,348,349],{"class":57}," line",[41,351,352],{"class":93},"; ",[41,354,355],{"class":258},"do\n",[41,357,358,361,364,367,370],{"class":43,"line":76},[41,359,360],{"class":242},"  printf",[41,362,363],{"class":57}," '%s\\n'",[41,365,366],{"class":57}," \"",[41,368,369],{"class":93},"$line",[41,371,372],{"class":57},"\"\n",[41,374,375,378,381],{"class":43,"line":82},[41,376,377],{"class":258},"done",[41,379,380],{"class":258}," \u003C",[41,382,383],{"class":93}," bigfile.txt\n",[41,385,386],{"class":43,"line":97},[41,387,388],{"class":228},"# ~10 seconds for 1M lines (syscall overhead dominates)\n",[41,390,391],{"class":43,"line":102},[41,392,394],{"emptyLinePlaceholder":393},true,"\n",[41,396,397],{"class":43,"line":128},[41,398,399],{"class":228},"# PRODUCTION: batch I\u002FO — read in chunks, process in userspace\n",[41,401,402],{"class":43,"line":133},[41,403,404],{"class":228},"# Use awk\u002Fsed (buffered I\u002FO, orders of magnitude faster)\n",[41,406,407,410,413,416,418],{"class":43,"line":159},[41,408,409],{"class":47},"awk",[41,411,412],{"class":57}," '{print}'",[41,414,415],{"class":57}," bigfile.txt",[41,417,259],{"class":258},[41,419,420],{"class":57}," \u002Fdev\u002Fnull\n",[41,422,423],{"class":43,"line":164},[41,424,425],{"class":228},"# ~0.1 seconds for the same 1M lines — buffered read, no per-line syscall\n",[14,427,428,429,431,432,434,435,293,437,293,440,293,443,446],{},"The ",[38,430,288],{}," syscall fetches one buffer at a time; the shell ",[38,433,288],{}," builtin re-enters the kernel for every line. For any I\u002FO-heavy pipeline, prefer tools that buffer (",[38,436,409],{},[38,438,439],{},"sed",[38,441,442],{},"grep",[38,444,445],{},"dd",").",[23,448,450],{"id":449},"distributions-distros","Distributions (Distros)",[14,452,453],{},"A distro = kernel + GNU tools + package manager + init system + default apps. The major families:",[455,456,457,476],"table",{},[458,459,460],"thead",{},[461,462,463,467,470,473],"tr",{},[464,465,466],"th",{},"Family",[464,468,469],{},"Examples",[464,471,472],{},"Package Manager",[464,474,475],{},"Init",[477,478,479,499,517,532,549],"tbody",{},[461,480,481,485,488,496],{},[482,483,484],"td",{},"Debian",[482,486,487],{},"Debian, Ubuntu, Mint, Pop!_OS",[482,489,490,289,493],{},[38,491,492],{},"apt",[38,494,495],{},"dpkg",[482,497,498],{},"systemd",[461,500,501,504,507,515],{},[482,502,503],{},"Red Hat",[482,505,506],{},"RHEL, Fedora, CentOS Stream, Rocky, Alma",[482,508,509,289,512],{},[38,510,511],{},"dnf",[38,513,514],{},"rpm",[482,516,498],{},[461,518,519,522,525,530],{},[482,520,521],{},"Arch",[482,523,524],{},"Arch, Manjaro, EndeavourOS",[482,526,527],{},[38,528,529],{},"pacman",[482,531,498],{},[461,533,534,537,540,547],{},[482,535,536],{},"SUSE",[482,538,539],{},"openSUSE, SLES",[482,541,542,289,545],{},[38,543,544],{},"zypper",[38,546,514],{},[482,548,498],{},[461,550,551,554,557,560],{},[482,552,553],{},"Independent",[482,555,556],{},"Gentoo, NixOS, Alpine, Void",[482,558,559],{},"portage\u002Fnix\u002Fapk\u002Fxbps",[482,561,562],{},"systemd\u002FOpenRC",[314,564,566],{"id":565},"which-distro-should-you-use","Which Distro Should You Use?",[180,568,569,575,581],{},[183,570,571,574],{},[18,572,573],{},"Server"," — Debian, Ubuntu LTS, RHEL\u002FRocky, AlmaLinux. Stability, long support.",[183,576,577,580],{},[18,578,579],{},"Learning"," — Arch Linux. You build it yourself; you understand every piece.",[183,582,583,586],{},[18,584,585],{},"Minimal\u002Fembedded"," — Alpine (5 MB), NixOS (reproducible), Void (musl).",[23,588,590],{"id":589},"check-your-system","Check Your System",[28,592,593],{"language":30},[32,594,596],{"className":34,"code":595,"language":30,"meta":36,"style":36},"# Complex Implementation: portable system identification — works across all distros\n# \u002Fetc\u002Fos-release is FHS-specified (always present); lsb_release is not\n. \u002Fetc\u002Fos-release                    # source it (sets $NAME, $VERSION_ID, etc.)\necho \"Distro: $PRETTY_NAME\"\necho \"Kernel: $(uname -r)\"\necho \"Arch:   $(uname -m)\"\necho \"Kernel build: $(uname -v)\"\n\n# Edge case: $SHELL is your LOGIN shell, not your CURRENT shell\n# If you ran `zsh` from bash, $SHELL still says \u002Fbin\u002Fbash\nps -p $$ -o comm=                   # the actual current shell\n",[38,597,598,603,608,618,631,646,660,674,678,683,688],{"__ignoreMap":36},[41,599,600],{"class":43,"line":44},[41,601,602],{"class":228},"# Complex Implementation: portable system identification — works across all distros\n",[41,604,605],{"class":43,"line":51},[41,606,607],{"class":228},"# \u002Fetc\u002Fos-release is FHS-specified (always present); lsb_release is not\n",[41,609,610,612,615],{"class":43,"line":76},[41,611,198],{"class":242},[41,613,614],{"class":57}," \u002Fetc\u002Fos-release",[41,616,617],{"class":228},"                    # source it (sets $NAME, $VERSION_ID, etc.)\n",[41,619,620,623,626,629],{"class":43,"line":82},[41,621,622],{"class":242},"echo",[41,624,625],{"class":57}," \"Distro: ",[41,627,628],{"class":93},"$PRETTY_NAME",[41,630,372],{"class":57},[41,632,633,635,638,641,643],{"class":43,"line":97},[41,634,622],{"class":242},[41,636,637],{"class":57}," \"Kernel: $(",[41,639,640],{"class":47},"uname",[41,642,346],{"class":242},[41,644,645],{"class":57},")\"\n",[41,647,648,650,653,655,658],{"class":43,"line":102},[41,649,622],{"class":242},[41,651,652],{"class":57}," \"Arch:   $(",[41,654,640],{"class":47},[41,656,657],{"class":242}," -m",[41,659,645],{"class":57},[41,661,662,664,667,669,672],{"class":43,"line":128},[41,663,622],{"class":242},[41,665,666],{"class":57}," \"Kernel build: $(",[41,668,640],{"class":47},[41,670,671],{"class":242}," -v",[41,673,645],{"class":57},[41,675,676],{"class":43,"line":133},[41,677,394],{"emptyLinePlaceholder":393},[41,679,680],{"class":43,"line":159},[41,681,682],{"class":228},"# Edge case: $SHELL is your LOGIN shell, not your CURRENT shell\n",[41,684,685],{"class":43,"line":164},[41,686,687],{"class":228},"# If you ran `zsh` from bash, $SHELL still says \u002Fbin\u002Fbash\n",[41,689,690,693,696,699,702,705],{"class":43,"line":175},[41,691,692],{"class":47},"ps",[41,694,695],{"class":242}," -p",[41,697,698],{"class":242}," $$",[41,700,701],{"class":242}," -o",[41,703,704],{"class":57}," comm=",[41,706,707],{"class":228},"                   # the actual current shell\n",[314,709,711,712,715],{"id":710},"edge-case-merged-usr-on-modern-distros","Edge Case: Merged ",[38,713,714],{},"\u002Fusr"," on Modern Distros",[14,717,718,719,722,723,726,727,722,730,733,734,737,738,741],{},"Since Debian\u002FUbuntu \"merged \u002Fusr\", ",[38,720,721],{},"\u002Fbin"," → ",[38,724,725],{},"\u002Fusr\u002Fbin"," and ",[38,728,729],{},"\u002Fsbin",[38,731,732],{},"\u002Fusr\u002Fsbin",". Scripts hardcoding ",[38,735,736],{},"\u002Fbin\u002Ffoo"," still work (symlinks), but the real path is ",[38,739,740],{},"\u002Fusr\u002Fbin\u002Ffoo",":",[28,743,744],{"language":30},[32,745,747],{"className":34,"code":746,"language":30,"meta":36,"style":36},"ls -ld \u002Fbin \u002Fsbin \u002Flib              # show the symlinks\n# lrwxrwxrwx 1 root root 7 ... \u002Fbin -> usr\u002Fbin\n# lrwxrwxrwx 1 root root 7 ... \u002Fsbin -> usr\u002Fsbin\n# lrwxrwxrwx 1 root root 7 ... \u002Flib -> usr\u002Flib\n\n# Anti-Pattern: hardcoding \u002Fbin\u002Fbash in a shebang on a non-merged distro\n# If the script is copied to an Alpine container (no \u002Fbin\u002Fbash, only \u002Fbin\u002Fsh),\n# it breaks. Use #!\u002Fusr\u002Fbin\u002Fenv bash for portability.\n",[38,748,749,769,774,779,784,788,793,798],{"__ignoreMap":36},[41,750,751,754,757,760,763,766],{"class":43,"line":44},[41,752,753],{"class":47},"ls",[41,755,756],{"class":242}," -ld",[41,758,759],{"class":57}," \u002Fbin",[41,761,762],{"class":57}," \u002Fsbin",[41,764,765],{"class":57}," \u002Flib",[41,767,768],{"class":228},"              # show the symlinks\n",[41,770,771],{"class":43,"line":51},[41,772,773],{"class":228},"# lrwxrwxrwx 1 root root 7 ... \u002Fbin -> usr\u002Fbin\n",[41,775,776],{"class":43,"line":76},[41,777,778],{"class":228},"# lrwxrwxrwx 1 root root 7 ... \u002Fsbin -> usr\u002Fsbin\n",[41,780,781],{"class":43,"line":82},[41,782,783],{"class":228},"# lrwxrwxrwx 1 root root 7 ... \u002Flib -> usr\u002Flib\n",[41,785,786],{"class":43,"line":97},[41,787,394],{"emptyLinePlaceholder":393},[41,789,790],{"class":43,"line":102},[41,791,792],{"class":228},"# Anti-Pattern: hardcoding \u002Fbin\u002Fbash in a shebang on a non-merged distro\n",[41,794,795],{"class":43,"line":128},[41,796,797],{"class":228},"# If the script is copied to an Alpine container (no \u002Fbin\u002Fbash, only \u002Fbin\u002Fsh),\n",[41,799,800],{"class":43,"line":133},[41,801,802],{"class":228},"# it breaks. Use #!\u002Fusr\u002Fbin\u002Fenv bash for portability.\n",[23,804,806],{"id":805},"the-terminal-shell-and-console","The Terminal, Shell, and Console",[180,808,809,815,821,835],{},[183,810,811,814],{},[18,812,813],{},"Terminal"," — the window\u002Fapp you type into (GNOME Terminal, Alacritty).",[183,816,817,820],{},[18,818,819],{},"Shell"," — the program that interprets commands (Bash, Zsh, Fish).",[183,822,823,826,827,830,831,834],{},[18,824,825],{},"Console"," — the physical\u002Fvirtual text interface (",[38,828,829],{},"tty1","–",[38,832,833],{},"tty6","; Ctrl+Alt+F1–F6).",[183,836,837,840,841,293,844,446],{},[18,838,839],{},"TTY"," — teletypewriter; a terminal device (",[38,842,843],{},"\u002Fdev\u002Ftty1",[38,845,846],{},"\u002Fdev\u002Fpts\u002F0",[28,848,849],{"language":30},[32,850,852],{"className":34,"code":851,"language":30,"meta":36,"style":36},"# Complex Implementation: detect if we're in a TTY, a terminal emulator, or SSH\n# — drives behavior in scripts (color, interactive prompts)\nif [ -t 1 ]; then\n  # stdout is a terminal\n  if [ \"$(tty)\" = \"not a tty\" ] 2>\u002Fdev\u002Fnull; then\n    echo \"piped\u002Fredirected\"\n  else\n    echo \"interactive: $(tty)\"\n  fi\nelse\n  echo \"stdout redirected (no