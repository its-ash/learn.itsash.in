[{"data":1,"prerenderedAt":1552},["ShallowReactive",2],{"page-\u002Flinux\u002F01-introduction-and-architecture":3},{"id":4,"title":5,"body":6,"description":1544,"extension":1545,"meta":1546,"navigation":1547,"path":1548,"seo":1549,"stem":1550,"__hash__":1551},"content\u002Flinux\u002F01-introduction-and-architecture.md","01 — Introduction & Architecture",{"type":7,"value":8,"toc":1525},"minimark",[9,13,26,31,58,63,73,92,96,107,150,153,161,194,198,201,310,314,340,344,394,397,405,433,437,477,538,542,548,724,728,748,813,820,908,953,957,1049,1053,1064,1142,1189,1193,1277,1281,1428,1432,1443,1521],[10,11,5],"h1",{"id":12},"_01-introduction-architecture",[14,15,16,17,21,22,25],"p",{},"Linux is a free, open-source, Unix-like operating system kernel. When combined with GNU userspace tools, a display server, and applications, it forms a complete ",[18,19,20],"strong",{},"operating system"," called a ",[18,23,24],{},"Linux distribution"," (or \"distro\").",[27,28,30],"h2",{"id":29},"what-is-linux-really","What Is Linux, Really?",[14,32,33,34,37,38,42,43,42,46,49,50,53,54,57],{},"Strictly, \"Linux\" is just the ",[18,35,36],{},"kernel"," — the core that manages the CPU, memory, devices, and schedules processes. What you interact with (the shell, ",[39,40,41],"code",{},"ls",", ",[39,44,45],{},"grep",[39,47,48],{},"bash",") is mostly ",[18,51,52],{},"GNU software",". Hence the term ",[18,55,56],{},"GNU\u002FLinux",".",[59,60,62],"h3",{"id":61},"the-layers","The Layers",[64,65,71],"pre",{"className":66,"code":68,"language":69,"meta":70},[67],"language-text","┌─────────────────────────────────────┐\n│          Applications               │  Firefox, nginx, your scripts\n├─────────────────────────────────────┤\n│     GNU Userspace (coreutils)       │  bash, ls, grep, awk, sed, gcc\n├─────────────────────────────────────┤\n│          System Libraries           │  glibc, systemd, PAM, NSS\n├─────────────────────────────────────┤\n│            Linux Kernel             │  scheduler, memory, drivers, VFS\n├─────────────────────────────────────┤\n│          Hardware (CPU\u002FRAM\u002Fdisk)    │\n└─────────────────────────────────────┘\n","text","",[39,72,68],{"__ignoreMap":70},[74,75,76,83],"ul",{},[77,78,79,82],"li",{},[18,80,81],{},"Kernel space"," — privileged, full hardware access (ring 0 on x86).",[77,84,85,88,89,57],{},[18,86,87],{},"User space"," — unprivileged, goes through the kernel via ",[18,90,91],{},"syscalls",[27,93,95],{"id":94},"kernel-vs-userspace","Kernel vs Userspace",[14,97,98,99,102,103,106],{},"Every process runs in ",[18,100,101],{},"user space"," until it needs a kernel service (read a file, allocate memory, send a packet). It then issues a ",[18,104,105],{},"syscall"," — a controlled transition into kernel mode.",[108,109,110],"code-wrapper",{"language":48},[64,111,114],{"className":112,"code":113,"language":48,"meta":70,"style":70},"language-bash shiki shiki-themes github-light github-dark","strace -c ls \u002Fetc >\u002Fdev\u002Fnull 2>&1   # count syscalls made by ls\n",[39,115,116],{"__ignoreMap":70},[117,118,121,125,129,133,136,140,143,146],"span",{"class":119,"line":120},"line",1,[117,122,124],{"class":123},"sIsaT","strace",[117,126,128],{"class":127},"snvgF"," -c",[117,130,132],{"class":131},"sJ6F3"," ls",[117,134,135],{"class":131}," \u002Fetc",[117,137,139],{"class":138},"svdQ7"," >",[117,141,142],{"class":131},"\u002Fdev\u002Fnull",[117,144,145],{"class":138}," 2>&1",[117,147,149],{"class":148},"sdCPZ","   # count syscalls made by ls\n",[14,151,152],{},"Output (truncated):",[108,154,155],{"language":69},[64,156,159],{"className":157,"code":158,"language":69,"meta":70},[67],"% time     seconds  usecs\u002Fcall     calls    errors syscall\n------ ----------- ----------- --------- --------- ----------------\n  0.00    0.000000           0        10           mmap\n  0.00    0.000000           0         3           newfstatat\n  0.00    0.000000           0         7           getdents64\n  ...\n",[39,160,158],{"__ignoreMap":70},[14,162,163,164,167,168,171,172,42,175,42,178,181,182,185,186,189,190,193],{},"Key syscalls: ",[39,165,166],{},"openat"," (open a file), ",[39,169,170],{},"read","\u002F",[39,173,174],{},"write",[39,176,177],{},"close",[39,179,180],{},"mmap"," (map file into memory), ",[39,183,184],{},"fork"," (create process), ",[39,187,188],{},"execve"," (run a program), ",[39,191,192],{},"exit"," (terminate).",[27,195,197],{"id":196},"distributions-distros","Distributions (Distros)",[14,199,200],{},"A distro = kernel + GNU tools + package manager + init system + default apps. Hundreds exist; the major families:",[202,203,204,223],"table",{},[205,206,207],"thead",{},[208,209,210,214,217,220],"tr",{},[211,212,213],"th",{},"Family",[211,215,216],{},"Examples",[211,218,219],{},"Package Manager",[211,221,222],{},"Init",[224,225,226,246,264,279,296],"tbody",{},[208,227,228,232,235,243],{},[229,230,231],"td",{},"Debian",[229,233,234],{},"Debian, Ubuntu, Mint, Pop!_OS",[229,236,237,171,240],{},[39,238,239],{},"apt",[39,241,242],{},"dpkg",[229,244,245],{},"systemd",[208,247,248,251,254,262],{},[229,249,250],{},"Red Hat",[229,252,253],{},"RHEL, Fedora, CentOS Stream, Rocky, Alma",[229,255,256,171,259],{},[39,257,258],{},"dnf",[39,260,261],{},"rpm",[229,263,245],{},[208,265,266,269,272,277],{},[229,267,268],{},"Arch",[229,270,271],{},"Arch, Manjaro, EndeavourOS",[229,273,274],{},[39,275,276],{},"pacman",[229,278,245],{},[208,280,281,284,287,294],{},[229,282,283],{},"SUSE",[229,285,286],{},"openSUSE, SLES",[229,288,289,171,292],{},[39,290,291],{},"zypper",[39,293,261],{},[229,295,245],{},[208,297,298,301,304,307],{},[229,299,300],{},"Independent",[229,302,303],{},"Gentoo, NixOS, Alpine, Void",[229,305,306],{},"portage\u002Fnix\u002Fapk\u002Fxbps",[229,308,309],{},"systemd\u002FOpenRC",[59,311,313],{"id":312},"which-distro-should-you-use","Which Distro Should You Use?",[74,315,316,322,328,334],{},[77,317,318,321],{},[18,319,320],{},"Beginner"," — Ubuntu, Linux Mint, Fedora. Easy install, large community.",[77,323,324,327],{},[18,325,326],{},"Server"," — Debian, Ubuntu LTS, RHEL\u002FRocky, AlmaLinux. Stability, long support.",[77,329,330,333],{},[18,331,332],{},"Learning"," — Arch Linux. You build it yourself; you understand every piece.",[77,335,336,339],{},[18,337,338],{},"Minimal\u002Fembedded"," — Alpine (5 MB), NixOS (reproducible), Void (musl).",[27,341,343],{"id":342},"check-your-system","Check Your System",[108,345,346],{"language":48},[64,347,349],{"className":112,"code":348,"language":48,"meta":70,"style":70},"uname -a            # kernel version, hostname, arch\nhostnamectl         # distro, kernel, arch, hostname (systemd)\ncat \u002Fetc\u002Fos-release # distro info (portable)\nlsb_release -a      # Ubuntu\u002FDebian distro details\n",[39,350,351,362,371,383],{"__ignoreMap":70},[117,352,353,356,359],{"class":119,"line":120},[117,354,355],{"class":123},"uname",[117,357,358],{"class":127}," -a",[117,360,361],{"class":148},"            # kernel version, hostname, arch\n",[117,363,365,368],{"class":119,"line":364},2,[117,366,367],{"class":123},"hostnamectl",[117,369,370],{"class":148},"         # distro, kernel, arch, hostname (systemd)\n",[117,372,374,377,380],{"class":119,"line":373},3,[117,375,376],{"class":123},"cat",[117,378,379],{"class":131}," \u002Fetc\u002Fos-release",[117,381,382],{"class":148}," # distro info (portable)\n",[117,384,386,389,391],{"class":119,"line":385},4,[117,387,388],{"class":123},"lsb_release",[117,390,358],{"class":127},[117,392,393],{"class":148},"      # Ubuntu\u002FDebian distro details\n",[14,395,396],{},"Example output:",[108,398,399],{"language":69},[64,400,403],{"className":401,"code":402,"language":69,"meta":70},[67],"$ uname -a\nLinux workstation 6.8.0-31-generic #31-Ubuntu SMP PREEMPT_DYNAMIC ... x86_64 GNU\u002FLinux\n\n$ cat \u002Fetc\u002Fos-release\nPRETTY_NAME=\"Ubuntu 24.04 LTS\"\nNAME=\"Ubuntu\"\nVERSION_ID=\"24.04\"\nID=ubuntu\n",[39,404,402],{"__ignoreMap":70},[74,406,407,413,419],{},[77,408,409,412],{},[39,410,411],{},"Linux"," — kernel name.",[77,414,415,418],{},[39,416,417],{},"6.8.0-31-generic"," — kernel version (major.minor.patch-build-flavor).",[77,420,421,424,425,428,429,432],{},[39,422,423],{},"x86_64"," — CPU architecture (also ",[39,426,427],{},"aarch64","\u002FARM64, ",[39,430,431],{},"riscv64",").",[27,434,436],{"id":435},"the-terminal-shell-and-console","The Terminal, Shell, and Console",[74,438,439,445,451,465],{},[77,440,441,444],{},[18,442,443],{},"Terminal"," — the window\u002Fapp you type into (GNOME Terminal, Alacritty).",[77,446,447,450],{},[18,448,449],{},"Shell"," — the program that interprets commands (Bash, Zsh, Fish).",[77,452,453,456,457,460,461,464],{},[18,454,455],{},"Console"," — the physical\u002Fvirtual text interface (",[39,458,459],{},"tty1","–",[39,462,463],{},"tty6","; Ctrl+Alt+F1–F6).",[77,466,467,470,471,42,474,432],{},[18,468,469],{},"TTY"," — teletypewriter; a terminal device (",[39,472,473],{},"\u002Fdev\u002Ftty1",[39,475,476],{},"\u002Fdev\u002Fpts\u002F0",[108,478,479],{"language":48},[64,480,482],{"className":112,"code":481,"language":48,"meta":70,"style":70},"tty                 # show your terminal device (\u002Fdev\u002Fpts\u002F0)\necho $SHELL         # your default shell (\u002Fbin\u002Fbash)\nps -p $$ -o comm=   # your current shell (more reliable than $SHELL)\nchsh -s \u002Fusr\u002Fbin\u002Fzsh  # change default shell\n",[39,483,484,492,504,524],{"__ignoreMap":70},[117,485,486,489],{"class":119,"line":120},[117,487,488],{"class":123},"tty",[117,490,491],{"class":148},"                 # show your terminal device (\u002Fdev\u002Fpts\u002F0)\n",[117,493,494,497,501],{"class":119,"line":364},[117,495,496],{"class":127},"echo",[117,498,500],{"class":499},"ssxIu"," $SHELL         ",[117,502,503],{"class":148},"# your default shell (\u002Fbin\u002Fbash)\n",[117,505,506,509,512,515,518,521],{"class":119,"line":373},[117,507,508],{"class":123},"ps",[117,510,511],{"class":127}," -p",[117,513,514],{"