,1650,1651],{},"2",[482,1653,1654],{},"System calls",[461,1656,1657,1660],{},[482,1658,1659],{},"3",[482,1661,1662],{},"Library functions",[461,1664,1665,1668],{},[482,1666,1667],{},"4",[482,1669,1670],{},"Special files (devices)",[461,1672,1673,1676],{},[482,1674,1675],{},"5",[482,1677,1678],{},"File formats & config",[461,1680,1681,1684],{},[482,1682,1683],{},"6",[482,1685,1686],{},"Games",[461,1688,1689,1692],{},[482,1690,1691],{},"7",[482,1693,1694],{},"Conventions, misc",[461,1696,1697,1700],{},[482,1698,1699],{},"8",[482,1701,1702],{},"System administration",[28,1704,1705],{"language":30},[32,1706,1708],{"className":34,"code":1707,"language":30,"meta":36,"style":36},"man 5 crontab     # the crontab FILE format, not the command\nman 2 open        # the open(2) SYSCALL, not any command\nman -k cron       # search for \"cron\" across all sections\n",[38,1709,1710,1724,1737],{"__ignoreMap":36},[41,1711,1712,1715,1718,1721],{"class":43,"line":44},[41,1713,1714],{"class":47},"man",[41,1716,1717],{"class":242}," 5",[41,1719,1720],{"class":57}," crontab",[41,1722,1723],{"class":228},"     # the crontab FILE format, not the command\n",[41,1725,1726,1728,1731,1734],{"class":43,"line":51},[41,1727,1714],{"class":47},[41,1729,1730],{"class":242}," 2",[41,1732,1733],{"class":57}," open",[41,1735,1736],{"class":228},"        # the open(2) SYSCALL, not any command\n",[41,1738,1739,1741,1744,1747],{"class":43,"line":76},[41,1740,1714],{"class":47},[41,1742,1743],{"class":242}," -k",[41,1745,1746],{"class":57}," cron",[41,1748,1749],{"class":228},"       # search for \"cron\" across all sections\n",[23,1751,1753],{"id":1752},"tips-tricks","💡 Tips & Tricks",[180,1755,1756,1777,1795,1803,1821],{},[183,1757,1758,1761,1762,1765,1766,1769,1770,1773,1774,1776],{},[18,1759,1760],{},"Idiom",": use ",[38,1763,1764],{},"cat \u002Fetc\u002Fos-release"," (not ",[38,1767,1768],{},"lsb_release",") for portable distro detection — ",[38,1771,1772],{},"os-release"," is FHS-specified and present on every modern distro; ",[38,1775,1768],{}," is missing on minimal installs.",[183,1778,1779,1761,1781,1765,1784,1787,1788,1791,1792,1794],{},[18,1780,1760],{},[38,1782,1783],{},"command -v \u003Cname>",[38,1785,1786],{},"which",") to check if a command exists — ",[38,1789,1790],{},"command -v"," is POSIX, built into the shell, and respects functions\u002Faliases. ",[38,1793,1786],{}," is an external command and misses shell functions.",[183,1796,1797,1761,1799,1802],{},[18,1798,1760],{},[38,1800,1801],{},"hostnamectl"," on systemd distros — shows distro, kernel, arch, hostname, and chassis type in one command.",[183,1804,1805,1808,1809,1812,1813,1816,1817,1820],{},[18,1806,1807],{},"Performance",": ",[38,1810,1811],{},"strace -c \u003Ccmd>"," reveals syscall counts — if a tool makes 10,000 ",[38,1814,1815],{},"stat"," calls, switching to a buffered alternative (like ",[38,1818,1819],{},"find -maxdepth 1",") can be 100x faster.",[183,1822,1823,1826,1827,1830],{},[18,1824,1825],{},"Portability",": Alpine uses musl, not glibc — binaries compiled against glibc (most prebuilt Linux binaries) won't run on Alpine without ",[38,1828,1829],{},"gcompat"," or a musl build. This bites Docker users pulling glibc binaries into Alpine images.",[23,1832,1834],{"id":1833},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[180,1836,1837,1855,1875,1891,1917,1944],{},[183,1838,1839,1846,1847,1850,1851,1854],{},[18,1840,1841,726,1843,1845],{},[38,1842,1132],{},[38,1844,1142],{}," are virtual",": they exist in RAM, not on disk. ",[38,1848,1849],{},"du -sh \u002Fproc"," reports 0 or errors. Don't back them up. Writing to ",[38,1852,1853],{},"\u002Fproc\u002Fsys"," changes live kernel state — typos can crash the system.",[183,1856,1857,1862,1863,1866,1867,1870,1871,1874],{},[18,1858,1859,1861],{},[38,1860,262],{}," is not a regular file",": it's a character device. ",[38,1864,1865],{},"cp realfile \u002Fdev\u002Fnull"," doesn't \"save\" the file — it discards it. ",[38,1868,1869],{},"cat \u002Fdev\u002Fnull > bigfile"," truncates ",[38,1872,1873],{},"bigfile"," to 0 bytes (a common idiom).",[183,1876,1877,1882,1883,1886,1887,1890],{},[18,1878,1879,1881],{},[38,1880,1122],{}," is cleared on reboot"," (and sometimes hourly by ",[38,1884,1885],{},"systemd-tmpfiles","): don't store anything you need to keep. Use ",[38,1888,1889],{},"\u002Fvar\u002Ftmp"," for files that survive reboots (up to 30 days by default).",[183,1892,1893,1899,1900,1903,1904,293,1906,1908,1909,1912,1913,1916],{},[18,1894,1895,1898],{},[38,1896,1897],{},"$SHELL"," is your login shell, not necessarily your current shell",": if you run ",[38,1901,1902],{},"zsh"," from ",[38,1905,30],{},[38,1907,1897],{}," still says ",[38,1910,1911],{},"\u002Fbin\u002Fbash",". Use ",[38,1914,1915],{},"ps -p $$ -o comm="," for the current shell.",[183,1918,1919,1808,1928,1931,1932,1935,1936,1939,1940,1943],{},[18,1920,1921,1924,1925],{},[38,1922,1923],{},"uname -r"," vs ",[38,1926,1927],{},"uname -a",[38,1929,1930],{},"-r"," gives only the kernel release (",[38,1933,1934],{},"6.8.0-31-generic","), which is what ",[38,1937,1938],{},"apt install linux-image-$(uname -r)"," expects. ",[38,1941,1942],{},"-a"," includes hostname, kernel name, etc.",[183,1945,1946,1949,1950,1830],{},[18,1947,1948],{},"Alpine uses musl, not glibc",": binaries compiled against glibc (most prebuilt Linux binaries) won't run on Alpine without ",[38,1951,1829],{},[23,1953,1955],{"id":1954},"quick-quiz","🧠 Quick Quiz",[14,1957,1958,1959,1962,1963,1966],{},"You run ",[38,1960,1961],{},"man passwd"," and see the command documentation. You actually wanted the format of ",[38,1964,1965],{},"\u002Fetc\u002Fpasswd",". What went wrong, and how do you fix it?",[1968,1969,1970,1974,1994,2010],"details",{},[1971,1972,1973],"summary",{},"Answer",[14,1975,1976,1978,1979,1982,1983,1987,1988,1982,1990,1993],{},[38,1977,1961],{}," defaults to the lowest-numbered section with a match — section 1 (user commands), the ",[38,1980,1981],{},"passwd"," ",[1984,1985,1986],"em",{},"command",". The ",[38,1989,1965],{},[1984,1991,1992],{},"file format"," is in section 5. Fix it with:",[28,1995,1996],{"language":30},[32,1997,1999],{"className":34,"code":1998,"language":30,"meta":36,"style":36},"man 5 passwd\n",[38,2000,2001],{"__ignoreMap":36},[41,2002,2003,2005,2007],{"class":43,"line":44},[41,2004,1714],{"class":47},[41,2006,1717],{"class":242},[41,2008,2009],{"class":57}," passwd\n",[14,2011,2012,2013,2016,2017,2020,2021,2024,2025,2028,2029,2032,2033,2036,2037,2040,2041,2044],{},"This is the section-number syntax: ",[38,2014,2015],{},"man \u003Csection> \u003Cname>",". When a name exists in multiple sections, always specify the section to avoid ambiguity. Other common pairs: ",[38,2018,2019],{},"man 1 crontab"," (command) vs ",[38,2022,2023],{},"man 5 crontab"," (file), ",[38,2026,2027],{},"man 2 open"," (syscall) vs ",[38,2030,2031],{},"man 1 open"," (if a command named ",[38,2034,2035],{},"open"," exists), ",[38,2038,2039],{},"man 8 mount"," (admin command) vs ",[38,2042,2043],{},"man 2 mount"," (syscall).",[2046,2047,2048],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}",{"title":36,"searchDepth":51,"depth":51,"links":2050},[2051,2052,2055,2058,2062,2063,2064,2065,2068,2069,2070],{"id":25,"depth":51,"text":26},{"id":201,"depth":51,"text":202,"children":2053},[2054],{"id":316,"depth":76,"text":317},{"id":449,"depth":51,"text":450,"children":2056},[2057],{"id":565,"depth":76,"text":566},{"id":589,"depth":51,"text":590,"children":2059},[2060],{"id":710,"depth":76,"text":2061},"Edge Case: Merged \u002Fusr on Modern Distros",{"id":805,"depth":51,"text":806},{"id":1017,"depth":51,"text":1018},{"id":1192,"depth":51,"text":1193},{"id":1516,"depth":51,"text":1517,"children":2066},[2067],{"id":1612,"depth":76,"text":1613},{"id":1752,"depth":51,"text":1753},{"id":1833,"depth":51,"text":1834},{"id":1954,"depth":51,"text":1955},"Linux is a monolithic kernel managing CPU, memory, devices, and process scheduling. Combined with GNU userspace tools, a display server, and applications, it forms a Linux distribution. This chapter covers the kernel–userspace boundary, syscall mechanics, the FHS, and the virtual filesystems that make Linux a unified system — through the lens of production code and edge-case behavior.","md",{},"\u002Flinux\u002F01-introduction-and-architecture",{"title":5,"description":2071},"linux\u002F01-introduction-and-architecture","18dNzKNb0Fj9Fd5SHHw4d5lMG_HKi0SvM2qn9gO5AO0",1789747015301]