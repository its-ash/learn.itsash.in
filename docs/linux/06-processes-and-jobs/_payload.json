,1433,1434,1437,1440,1443],{"class":47,"line":61},[45,1435,1436],{"class":64},"sudo",[45,1438,1439],{"class":72}," lsof",[45,1441,1442],{"class":72}," +L1",[45,1444,1445],{"class":51},"               # list open files with link count 0 (deleted but open)\n",[45,1447,1448],{"class":47,"line":98},[45,1449,1450],{"class":51},"# COMMAND   PID  USER  FD  SIZE  NLINK  NAME\n",[45,1452,1453],{"class":47,"line":104},[45,1454,1455],{"class":51},"# nginx    1234  root  9w  50G   0      \u002Fvar\u002Flog\u002Fnginx\u002Faccess.log (deleted)\n",[45,1457,1458],{"class":47,"line":110},[45,1459,227],{"emptyLinePlaceholder":226},[45,1461,1462],{"class":47,"line":223},[45,1463,1464],{"class":51},"# Fix: restart the process (closes the fd, frees the space)\n",[45,1466,1467,1469,1472,1475],{"class":47,"line":230},[45,1468,1436],{"class":64},[45,1470,1471],{"class":72}," systemctl",[45,1473,1474],{"class":72}," restart",[45,1476,1477],{"class":72}," nginx\n",[45,1479,1480],{"class":47,"line":236},[45,1481,1482],{"class":51},"# Or truncate the file via \u002Fproc (without restarting):\n",[45,1484,1485,1487,1490,1492,1494],{"class":47,"line":256},[45,1486,1436],{"class":64},[45,1488,1489],{"class":72}," truncate",[45,1491,1077],{"class":68},[45,1493,209],{"class":68},[45,1495,1496],{"class":72}," \u002Fproc\u002F1234\u002Ffd\u002F9\n",[28,1498,1500],{"id":1499},"tips-tricks","💡 Tips & Tricks",[115,1502,1503,1521,1529,1540,1559,1571],{},[118,1504,1505,1508,1509,1512,1513,1516,1517,1520],{},[18,1506,1507],{},"Idiom",": use ",[23,1510,1511],{},"pgrep -a"," (not ",[23,1514,1515],{},"ps aux | grep",") to find processes by name — ",[23,1518,1519],{},"pgrep -a nginx"," lists PID + full command, no grep self-match, no noise.",[118,1522,1523,1508,1525,1528],{},[18,1524,1507],{},[23,1526,1527],{},"pkill -HUP \u003Cname>"," to reload daemon config — many daemons (nginx, sshd) reload their config on SIGHUP without dropping connections.",[118,1530,1531,1508,1533,1536,1537,152],{},[18,1532,1507],{},[23,1534,1535],{},"kill -0 $PID"," to check if a process exists — sends no signal, just returns 0 if the PID exists. ",[23,1538,1539],{},"kill -0 $pid 2>\u002Fdev\u002Fnull && echo \"running\" || echo \"stopped\"",[118,1541,1542,1508,1544,1547,1548,1551,1552,1554,1555,1558],{},[18,1543,1507],{},[23,1545,1546],{},"nice -n 19 ionice -c3"," for non-urgent heavy jobs — backup, ",[23,1549,1550],{},"find \u002F",", indexing. ",[23,1553,1093],{}," lowers CPU priority, ",[23,1556,1557],{},"ionice -c3"," lowers I\u002FO priority.",[118,1560,1561,1508,1564,1094,1567,1570],{},[18,1562,1563],{},"Debug",[23,1565,1566],{},"\u002Fproc\u002F\u003Cpid>\u002Ffd",[23,1568,1569],{},"lsof -p \u003Cpid>"," to see what a process is doing — open files reveal what it's reading\u002Fwriting, sockets reveal network connections.",[118,1572,1573,1508,1575,1578],{},[18,1574,1563],{},[23,1576,1577],{},"ls -l \u002Fproc\u002F\u003Cpid>\u002Fcwd"," to find a process's working directory — essential when a daemon's relative paths break.",[28,1580,1582],{"id":1581},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[115,1584,1585,1597,1609,1621,1647,1667],{},[118,1586,1587,1593,1594,1596],{},[18,1588,1589,1592],{},[23,1590,1591],{},"kill -9"," (SIGKILL) gives no cleanup",": the process can't flush buffers, close files cleanly, or notify peers. Databases may need recovery on next start. Always try ",[23,1595,756],{}," (SIGTERM) first.",[118,1598,1599,1605,1606,1608],{},[18,1600,1601,1602,1604],{},"State ",[23,1603,472],{}," processes can't be killed",": a process in uninterruptible sleep (I\u002FO wait) ignores even ",[23,1607,1591],{},". It will exit when the I\u002FO completes — or never, if the disk\u002FNFS is truly stuck.",[118,1610,1611,1614,1615,1617,1618,1620],{},[18,1612,1613],{},"Zombies persist until reaped",": a dead process (state ",[23,1616,492],{},") remains in the process table until its parent calls ",[23,1619,151],{},". Fix the parent or kill the parent (children get reaped by PID 1).",[118,1622,1623,1629,1630,1633,1634,1638,1639,1642,1643,1646],{},[18,1624,1625,1628],{},[23,1626,1627],{},"pkill -f"," can kill unintended processes",": ",[23,1631,1632],{},"pkill -f python"," matches ",[1635,1636,1637],"em",{},"any"," command line containing \"python\" — including ",[23,1640,1641],{},"vim python_notes.md",". Use ",[23,1644,1645],{},"pgrep -af"," first to preview.",[118,1648,1649,1658,1659,1662,1663,1666],{},[18,1650,1651,1654,1655,1657],{},[23,1652,1653],{},"%CPU"," in ",[23,1656,239],{}," is lifetime average, not current",": a process that spiked for 1 second and ran for 100 seconds shows ~1%. Use ",[23,1660,1661],{},"top","\u002F",[23,1664,1665],{},"htop"," for current CPU usage.",[118,1668,1669,1629,1672,1675,1676,1678,1679,1682],{},[18,1670,1671],{},"Nice doesn't affect I\u002FO or memory",[23,1673,1674],{},"nice -n 19"," only reduces CPU priority. An I\u002FO-heavy task still hammers the disk. Use ",[23,1677,1557],{}," for I\u002FO and ",[23,1680,1681],{},"cgroups"," for memory.",[28,1684,1686],{"id":1685},"spot-the-bug","🧠 Spot the Bug",[14,1688,1689,1690,1693,1694,1696],{},"A sysadmin wants to kill a runaway ",[23,1691,1692],{},"python"," process, but this command kills their ",[23,1695,935],{}," session too:",[33,1698,1699],{"language":35},[37,1700,1702],{"className":39,"code":1701,"language":35,"meta":41,"style":41},"pkill -f python\n",[23,1703,1704],{"__ignoreMap":41},[45,1705,1706,1709,1711],{"class":47,"line":48},[45,1707,1708],{"class":64},"pkill",[45,1710,69],{"class":68},[45,1712,1713],{"class":72}," python\n",[14,1715,1716],{},"What happened, and how do you fix it?",[1718,1719,1720,1724,1744,1749,1768,1777,1793,1800,1830],"details",{},[1721,1722,1723],"summary",{},"Answer",[14,1725,1726,1728,1729,1732,1733,1736,1737,1740,1741,1743],{},[23,1727,1627],{}," matches the ",[18,1730,1731],{},"full command line",", not just the process name. The sysadmin was editing ",[23,1734,1735],{},"python_server.py"," in vim — vim's command line is ",[23,1738,1739],{},"vim python_server.py",", which contains \"python.\" So ",[23,1742,1632],{}," matched and killed vim.",[14,1745,1746],{},[18,1747,1748],{},"Fix 1 — match the process name only:",[33,1750,1751],{"language":35},[37,1752,1754],{"className":39,"code":1753,"language":35,"meta":41,"style":41},"pkill -x python3    # exact match on process name (comm), not command line\n",[23,1755,1756],{"__ignoreMap":41},[45,1757,1758,1760,1762,1765],{"class":47,"line":48},[45,1759,1708],{"class":64},[45,1761,1246],{"class":68},[45,1763,1764],{"class":72}," python3",[45,1766,1767],{"class":51},"    # exact match on process name (comm), not command line\n",[14,1769,1770],{},[18,1771,1772,1773,1776],{},"Fix 2 — be specific with ",[23,1774,1775],{},"-f",":",[33,1778,1779],{"language":35},[37,1780,1782],{"className":39,"code":1781,"language":35,"meta":41,"style":41},"pkill -f \"python3 app.py\"\n",[23,1783,1784],{"__ignoreMap":41},[45,1785,1786,1788,1790],{"class":47,"line":48},[45,1787,1708],{"class":64},[45,1789,69],{"class":68},[45,1791,1792],{"class":72}," \"python3 app.py\"\n",[14,1794,1795],{},[18,1796,1797,1798,1776],{},"Fix 3 — preview first with ",[23,1799,1243],{},[33,1801,1802],{"language":35},[37,1803,1805],{"className":39,"code":1804,"language":35,"meta":41,"style":41},"pgrep -af python    # see what WOULD be killed (PID + full command)\n# 1234 python3 app.py\n# 5678 vim python_server.py   ← oops, this would be killed\n",[23,1806,1807,1820,1825],{"__ignoreMap":41},[45,1808,1809,1811,1814,1817],{"class":47,"line":48},[45,1810,1243],{"class":64},[45,1812,1813],{"class":68}," -af",[45,1815,1816],{"class":72}," python",[45,1818,1819],{"class":51},"    # see what WOULD be killed (PID + full command)\n",[45,1821,1822],{"class":47,"line":55},[45,1823,1824],{"class":51},"# 1234 python3 app.py\n",[45,1826,1827],{"class":47,"line":61},[45,1828,1829],{"class":51},"# 5678 vim python_server.py   ← oops, this would be killed\n",[14,1831,1832,1833,1836,1837,1840],{},"Always run ",[23,1834,1835],{},"pgrep -af \u003Cpattern>"," before ",[23,1838,1839],{},"pkill -f \u003Cpattern>"," to verify the match set.",[1842,1843,1844],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}",{"title":41,"searchDepth":55,"depth":55,"links":1846},[1847,1850,1857,1860,1863,1865,1867,1869,1870,1871],{"id":30,"depth":55,"text":31,"children":1848},[1849],{"id":163,"depth":61,"text":164},{"id":262,"depth":55,"text":263,"children":1851},[1852,1854,1855],{"id":266,"depth":61,"text":1853},"ps — Snapshot",{"id":424,"depth":61,"text":425},{"id":528,"depth":61,"text":1856},"Edge Case: The D State Trap",{"id":583,"depth":55,"text":584,"children":1858},[1859],{"id":810,"depth":61,"text":811},{"id":904,"depth":55,"text":905,"children":1861},[1862],{"id":996,"depth":61,"text":997},{"id":1089,"depth":55,"text":1864},"Process Priority: nice and renice",{"id":1213,"depth":55,"text":1866},"\u002Fproc\u002F\u003Cpid>\u002F — Process Internals",{"id":1410,"depth":55,"text":1868},"lsof — List Open Files",{"id":1499,"depth":55,"text":1500},{"id":1581,"depth":55,"text":1582},{"id":1685,"depth":55,"text":1686},"A process is a running instance of a program. Linux is a multitasking, multi-user system — dozens to thousands of processes run concurrently, sharing the CPU(s). This chapter covers process lifecycle, signals, scheduling, and the \u002Fproc interface — through the lens of production diagnostics and edge-case behavior.","md",{},"\u002Flinux\u002F06-processes-and-jobs",{"title":5,"description":1872},"linux\u002F06-processes-and-jobs","ueJy3LKtZHp71wpCvosU3a5BW07g5Kkc0lHntGkffrA",1789140923412]