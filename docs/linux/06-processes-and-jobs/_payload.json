a large deleted file open (space not freed until fd closes)\n",[45,1572,1573,1576,1579,1582],{"class":47,"line":61},[45,1574,1575],{"class":64},"sudo",[45,1577,1578],{"class":72}," lsof",[45,1580,1581],{"class":72}," +L1",[45,1583,1584],{"class":51},"               # list open files with link count 0 (deleted but open)\n",[45,1586,1587],{"class":47,"line":98},[45,1588,1589],{"class":51},"# COMMAND   PID  USER  FD  SIZE  NLINK  NAME\n",[45,1591,1592],{"class":47,"line":104},[45,1593,1594],{"class":51},"# nginx    1234  root  9w  50G   0      \u002Fvar\u002Flog\u002Fnginx\u002Faccess.log (deleted)\n",[45,1596,1597],{"class":47,"line":110},[45,1598,227],{"emptyLinePlaceholder":226},[45,1600,1601],{"class":47,"line":223},[45,1602,1603],{"class":51},"# Fix: restart the process (closes the fd, frees the space)\n",[45,1605,1606,1608,1611,1614],{"class":47,"line":230},[45,1607,1575],{"class":64},[45,1609,1610],{"class":72}," systemctl",[45,1612,1613],{"class":72}," restart",[45,1615,1616],{"class":72}," nginx\n",[45,1618,1619],{"class":47,"line":236},[45,1620,1621],{"class":51},"# Or truncate the file via \u002Fproc (without restarting):\n",[45,1623,1624,1626,1629,1631,1633],{"class":47,"line":256},[45,1625,1575],{"class":64},[45,1627,1628],{"class":72}," truncate",[45,1630,1216],{"class":68},[45,1632,209],{"class":68},[45,1634,1635],{"class":72}," \u002Fproc\u002F1234\u002Ffd\u002F9\n",[28,1637,1639],{"id":1638},"tips-tricks","💡 Tips & Tricks",[115,1641,1642,1660,1668,1679,1698,1710],{},[118,1643,1644,1647,1648,1651,1652,1655,1656,1659],{},[18,1645,1646],{},"Idiom",": use ",[23,1649,1650],{},"pgrep -a"," (not ",[23,1653,1654],{},"ps aux | grep",") to find processes by name — ",[23,1657,1658],{},"pgrep -a nginx"," lists PID + full command, no grep self-match, no noise.",[118,1661,1662,1647,1664,1667],{},[18,1663,1646],{},[23,1665,1666],{},"pkill -HUP \u003Cname>"," to reload daemon config — many daemons (nginx, sshd) reload their config on SIGHUP without dropping connections.",[118,1669,1670,1647,1672,1675,1676,152],{},[18,1671,1646],{},[23,1673,1674],{},"kill -0 $PID"," to check if a process exists — sends no signal, just returns 0 if the PID exists. ",[23,1677,1678],{},"kill -0 $pid 2>\u002Fdev\u002Fnull && echo \"running\" || echo \"stopped\"",[118,1680,1681,1647,1683,1686,1687,1690,1691,1693,1694,1697],{},[18,1682,1646],{},[23,1684,1685],{},"nice -n 19 ionice -c3"," for non-urgent heavy jobs — backup, ",[23,1688,1689],{},"find \u002F",", indexing. ",[23,1692,1232],{}," lowers CPU priority, ",[23,1695,1696],{},"ionice -c3"," lowers I\u002FO priority.",[118,1699,1700,1647,1703,1233,1706,1709],{},[18,1701,1702],{},"Debug",[23,1704,1705],{},"\u002Fproc\u002F\u003Cpid>\u002Ffd",[23,1707,1708],{},"lsof -p \u003Cpid>"," to see what a process is doing — open files reveal what it's reading\u002Fwriting, sockets reveal network connections.",[118,1711,1712,1647,1714,1717],{},[18,1713,1702],{},[23,1715,1716],{},"ls -l \u002Fproc\u002F\u003Cpid>\u002Fcwd"," to find a process's working directory — essential when a daemon's relative paths break.",[28,1719,1721],{"id":1720},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[115,1723,1724,1736,1748,1760,1786,1806],{},[118,1725,1726,1732,1733,1735],{},[18,1727,1728,1731],{},[23,1729,1730],{},"kill -9"," (SIGKILL) gives no cleanup",": the process can't flush buffers, close files cleanly, or notify peers. Databases may need recovery on next start. Always try ",[23,1734,895],{}," (SIGTERM) first.",[118,1737,1738,1744,1745,1747],{},[18,1739,1740,1741,1743],{},"State ",[23,1742,611],{}," processes can't be killed",": a process in uninterruptible sleep (I\u002FO wait) ignores even ",[23,1746,1730],{},". It will exit when the I\u002FO completes — or never, if the disk\u002FNFS is truly stuck.",[118,1749,1750,1753,1754,1756,1757,1759],{},[18,1751,1752],{},"Zombies persist until reaped",": a dead process (state ",[23,1755,631],{},") remains in the process table until its parent calls ",[23,1758,151],{},". Fix the parent or kill the parent (children get reaped by PID 1).",[118,1761,1762,1768,1769,1772,1773,1777,1778,1781,1782,1785],{},[18,1763,1764,1767],{},[23,1765,1766],{},"pkill -f"," can kill unintended processes",": ",[23,1770,1771],{},"pkill -f python"," matches ",[1774,1775,1776],"em",{},"any"," command line containing \"python\" — including ",[23,1779,1780],{},"vim python_notes.md",". Use ",[23,1783,1784],{},"pgrep -af"," first to preview.",[118,1787,1788,1797,1798,1801,1802,1805],{},[18,1789,1790,1793,1794,1796],{},[23,1791,1792],{},"%CPU"," in ",[23,1795,239],{}," is lifetime average, not current",": a process that spiked for 1 second and ran for 100 seconds shows ~1%. Use ",[23,1799,1800],{},"top","\u002F",[23,1803,1804],{},"htop"," for current CPU usage.",[118,1807,1808,1768,1811,1814,1815,1817,1818,1821],{},[18,1809,1810],{},"Nice doesn't affect I\u002FO or memory",[23,1812,1813],{},"nice -n 19"," only reduces CPU priority. An I\u002FO-heavy task still hammers the disk. Use ",[23,1816,1696],{}," for I\u002FO and ",[23,1819,1820],{},"cgroups"," for memory.",[28,1823,1825],{"id":1824},"spot-the-bug","🧠 Spot the Bug",[14,1827,1828,1829,1832,1833,1835],{},"A sysadmin wants to kill a runaway ",[23,1830,1831],{},"python"," process, but this command kills their ",[23,1834,1074],{}," session too:",[33,1837,1838],{"language":35},[37,1839,1841],{"className":39,"code":1840,"language":35,"meta":41,"style":41},"pkill -f python\n",[23,1842,1843],{"__ignoreMap":41},[45,1844,1845,1848,1850],{"class":47,"line":48},[45,1846,1847],{"class":64},"pkill",[45,1849,69],{"class":68},[45,1851,1852],{"class":72}," python\n",[14,1854,1855],{},"What happened, and how do you fix it?",[1857,1858,1859,1863,1883,1888,1907,1916,1932,1939,1969],"details",{},[1860,1861,1862],"summary",{},"Answer",[14,1864,1865,1867,1868,1871,1872,1875,1876,1879,1880,1882],{},[23,1866,1766],{}," matches the ",[18,1869,1870],{},"full command line",", not just the process name. The sysadmin was editing ",[23,1873,1874],{},"python_server.py"," in vim — vim's command line is ",[23,1877,1878],{},"vim python_server.py",", which contains \"python.\" So ",[23,1881,1771],{}," matched and killed vim.",[14,1884,1885],{},[18,1886,1887],{},"Fix 1 — match the process name only:",[33,1889,1890],{"language":35},[37,1891,1893],{"className":39,"code":1892,"language":35,"meta":41,"style":41},"pkill -x python3    # exact match on process name (comm), not command line\n",[23,1894,1895],{"__ignoreMap":41},[45,1896,1897,1899,1901,1904],{"class":47,"line":48},[45,1898,1847],{"class":64},[45,1900,1385],{"class":68},[45,1902,1903],{"class":72}," python3",[45,1905,1906],{"class":51},"    # exact match on process name (comm), not command line\n",[14,1908,1909],{},[18,1910,1911,1912,1915],{},"Fix 2 — be specific with ",[23,1913,1914],{},"-f",":",[33,1917,1918],{"language":35},[37,1919,1921],{"className":39,"code":1920,"language":35,"meta":41,"style":41},"pkill -f \"python3 app.py\"\n",[23,1922,1923],{"__ignoreMap":41},[45,1924,1925,1927,1929],{"class":47,"line":48},[45,1926,1847],{"class":64},[45,1928,69],{"class":68},[45,1930,1931],{"class":72}," \"python3 app.py\"\n",[14,1933,1934],{},[18,1935,1936,1937,1915],{},"Fix 3 — preview first with ",[23,1938,1382],{},[33,1940,1941],{"language":35},[37,1942,1944],{"className":39,"code":1943,"language":35,"meta":41,"style":41},"pgrep -af python    # see what WOULD be killed (PID + full command)\n# 1234 python3 app.py\n# 5678 vim python_server.py   ← oops, this would be killed\n",[23,1945,1946,1959,1964],{"__ignoreMap":41},[45,1947,1948,1950,1953,1956],{"class":47,"line":48},[45,1949,1382],{"class":64},[45,1951,1952],{"class":68}," -af",[45,1954,1955],{"class":72}," python",[45,1957,1958],{"class":51},"    # see what WOULD be killed (PID + full command)\n",[45,1960,1961],{"class":47,"line":55},[45,1962,1963],{"class":51},"# 1234 python3 app.py\n",[45,1965,1966],{"class":47,"line":61},[45,1967,1968],{"class":51},"# 5678 vim python_server.py   ← oops, this would be killed\n",[14,1970,1971,1972,1975,1976,1979],{},"Always run ",[23,1973,1974],{},"pgrep -af \u003Cpattern>"," before ",[23,1977,1978],{},"pkill -f \u003Cpattern>"," to verify the match set.",[1981,1982,1983],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}",{"title":41,"searchDepth":55,"depth":55,"links":1985},[1986,1989,1996,1999,2002,2004,2006,2008,2009,2010],{"id":30,"depth":55,"text":31,"children":1987},[1988],{"id":163,"depth":61,"text":164},{"id":262,"depth":55,"text":263,"children":1990},[1991,1993,1994],{"id":266,"depth":61,"text":1992},"ps — Snapshot",{"id":563,"depth":61,"text":564},{"id":667,"depth":61,"text":1995},"Edge Case: The D State Trap",{"id":722,"depth":55,"text":723,"children":1997},[1998],{"id":949,"depth":61,"text":950},{"id":1043,"depth":55,"text":1044,"children":2000},[2001],{"id":1135,"depth":61,"text":1136},{"id":1228,"depth":55,"text":2003},"Process Priority: nice and renice",{"id":1352,"depth":55,"text":2005},"\u002Fproc\u002F\u003Cpid>\u002F — Process Internals",{"id":1549,"depth":55,"text":2007},"lsof — List Open Files",{"id":1638,"depth":55,"text":1639},{"id":1720,"depth":55,"text":1721},{"id":1824,"depth":55,"text":1825},"A process is a running instance of a program. Linux is a multitasking, multi-user system — dozens to thousands of processes run concurrently, sharing the CPU(s). This chapter covers process lifecycle, signals, scheduling, and the \u002Fproc interface — through the lens of production diagnostics and edge-case behavior.","md",{},"\u002Flinux\u002F06-processes-and-jobs",{"title":5,"description":2011},"linux\u002F06-processes-and-jobs","Xts9NbVVIrF6PCtYlLtI46nAVLDCdXo2Q1ss06FiBCQ",1789749841095]