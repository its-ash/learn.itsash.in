[{"data":1,"prerenderedAt":1879},["ShallowReactive",2],{"page-\u002Flinux\u002F06-processes-and-jobs":3},{"id":4,"title":5,"body":6,"description":1872,"extension":1873,"meta":1874,"navigation":226,"path":1875,"seo":1876,"stem":1877,"__hash__":1878},"content\u002Flinux\u002F06-processes-and-jobs.md","06 — Processes & Jobs",{"type":7,"value":8,"toc":1845},"minimark",[9,13,27,32,114,160,165,260,264,270,387,394,402,422,426,526,533,581,585,745,808,812,902,906,994,998,1087,1098,1135,1211,1218,1408,1415,1497,1501,1579,1583,1683,1687,1697,1714,1717,1841],[10,11,5],"h1",{"id":12},"_06-processes-jobs",[14,15,16,17,21,22,26],"p",{},"A ",[18,19,20],"strong",{},"process"," is a running instance of a program. Linux is a multitasking, multi-user system — dozens to thousands of processes run concurrently, sharing the CPU(s). This chapter covers process lifecycle, signals, scheduling, and the ",[23,24,25],"code",{},"\u002Fproc"," interface — through the lens of production diagnostics and edge-case behavior.",[28,29,31],"h2",{"id":30},"process-lifecycle-fork-exec-exit-wait","Process Lifecycle: fork, exec, exit, wait",[33,34,36],"code-wrapper",{"language":35},"bash",[37,38,42],"pre",{"className":39,"code":40,"language":35,"meta":41,"style":41},"language-bash shiki shiki-themes github-light github-dark","# Complex Implementation: trace the fork\u002Fexec\u002Fwait cycle with strace\n# — reveals what \"running a command\" actually does at the syscall level\nstrace -f bash -c \"ls \u002Fetc >\u002Fdev\u002Fnull\" 2>&1 | grep -E \"clone|execve|wait4\"\n# clone(...) = child_pid          ← fork (Linux uses clone, not fork)\n# execve(\"\u002Fusr\u002Fbin\u002Fls\", ...) = 0  ← exec (child replaces itself with ls)\n# wait4(child_pid, ...) = ...     ← parent waits for exit status\n","",[23,43,44,53,59,96,102,108],{"__ignoreMap":41},[45,46,49],"span",{"class":47,"line":48},"line",1,[45,50,52],{"class":51},"sdCPZ","# Complex Implementation: trace the fork\u002Fexec\u002Fwait cycle with strace\n",[45,54,56],{"class":47,"line":55},2,[45,57,58],{"class":51},"# — reveals what \"running a command\" actually does at the syscall level\n",[45,60,62,66,70,74,77,80,84,87,90,93],{"class":47,"line":61},3,[45,63,65],{"class":64},"sIsaT","strace",[45,67,69],{"class":68},"snvgF"," -f",[45,71,73],{"class":72},"sJ6F3"," bash",[45,75,76],{"class":68}," -c",[45,78,79],{"class":72}," \"ls \u002Fetc >\u002Fdev\u002Fnull\"",[45,81,83],{"class":82},"svdQ7"," 2>&1",[45,85,86],{"class":82}," |",[45,88,89],{"class":64}," grep",[45,91,92],{"class":68}," -E",[45,94,95],{"class":72}," \"clone|execve|wait4\"\n",[45,97,99],{"class":47,"line":98},4,[45,100,101],{"class":51},"# clone(...) = child_pid          ← fork (Linux uses clone, not fork)\n",[45,103,105],{"class":47,"line":104},5,[45,106,107],{"class":51},"# execve(\"\u002Fusr\u002Fbin\u002Fls\", ...) = 0  ← exec (child replaces itself with ls)\n",[45,109,111],{"class":47,"line":110},6,[45,112,113],{"class":51},"# wait4(child_pid, ...) = ...     ← parent waits for exit status\n",[115,116,117,129,137,153],"ul",{},[118,119,120,125,126,128],"li",{},[18,121,122],{},[23,123,124],{},"fork()"," — child is an exact copy of the parent (memory, file descriptors, environment). Only difference: ",[23,127,124],{}," returns child PID to parent, 0 to child.",[118,130,131,136],{},[18,132,133],{},[23,134,135],{},"exec()"," — child loads a new program, replacing the copied parent code.",[118,138,139,144,145,148,149,152],{},[18,140,141],{},[23,142,143],{},"exit()"," — process terminates with a status code (0–255). Becomes a ",[18,146,147],{},"zombie"," until parent calls ",[23,150,151],{},"wait()",".",[118,154,155,159],{},[18,156,157],{},[23,158,151],{}," — parent collects exit status; zombie is reaped.",[161,162,164],"h3",{"id":163},"edge-case-zombies-and-orphans","Edge Case: Zombies and Orphans",[33,166,167],{"language":35},[37,168,170],{"className":39,"code":169,"language":35,"meta":41,"style":41},"# Complex Implementation: demonstrate zombie creation and reaping\n# — a process that dies before its parent wait()s becomes a zombie\n(\n  sleep 1 &        # child starts\n  exit 0           # parent exits immediately without waiting\n)                  # child is now an orphan (reparented to PID 1, which reaps it)\n\n# If the parent is buggy and never waits, zombies accumulate:\nps aux | awk '$8 ~ \u002FZ\u002F {print}'    # find zombies (state Z)\n# Fix: kill the parent (children get reaped by PID 1)\n",[23,171,172,177,182,188,202,213,221,228,234,254],{"__ignoreMap":41},[45,173,174],{"class":47,"line":48},[45,175,176],{"class":51},"# Complex Implementation: demonstrate zombie creation and reaping\n",[45,178,179],{"class":47,"line":55},[45,180,181],{"class":51},"# — a process that dies before its parent wait()s becomes a zombie\n",[45,183,184],{"class":47,"line":61},[45,185,187],{"class":186},"ssxIu","(\n",[45,189,190,193,196,199],{"class":47,"line":98},[45,191,192],{"class":64},"  sleep",[45,194,195],{"class":68}," 1",[45,197,198],{"class":186}," &        ",[45,200,201],{"class":51},"# child starts\n",[45,203,204,207,210],{"class":47,"line":104},[45,205,206],{"class":68},"  exit",[45,208,209],{"class":68}," 0",[45,211,212],{"class":51},"           # parent exits immediately without waiting\n",[45,214,215,218],{"class":47,"line":110},[45,216,217],{"class":186},")                  ",[45,219,220],{"class":51},"# child is now an orphan (reparented to PID 1, which reaps it)\n",[45,222,224],{"class":47,"line":223},7,[45,225,227],{"emptyLinePlaceholder":226},true,"\n",[45,229,231],{"class":47,"line":230},8,[45,232,233],{"class":51},"# If the parent is buggy and never waits, zombies accumulate:\n",[45,235,237,240,243,245,248,251],{"class":47,"line":236},9,[45,238,239],{"class":64},"ps",[45,241,242],{"class":72}," aux",[45,244,86],{"class":82},[45,246,247],{"class":64}," awk",[45,249,250],{"class":72}," '$8 ~ \u002FZ\u002F {print}'",[45,252,253],{"class":51},"    # find zombies (state Z)\n",[45,255,257],{"class":47,"line":256},10,[45,258,259],{"class":51},"# Fix: kill the parent (children get reaped by PID 1)\n",[28,261,263],{"id":262},"viewing-processes","Viewing Processes",[161,265,267,269],{"id":266},"ps-snapshot",[23,268,239],{}," — Snapshot",[33,271,272],{"language":35},[37,273,275],{"className":39,"code":274,"language":35,"meta":41,"style":41},"ps aux                      # all processes, BSD-style (most common)\nps -ef                      # all processes, System V-style\nps -e --forest              # tree view\nps -u alice                 # processes owned by alice\nps -C nginx                 # processes named nginx\nps -p 1234 -o pid,ppid,cmd  # specific PID, custom columns\nps aux --sort=-%cpu | head  # top CPU consumers\nps aux --sort=-%mem | head  # top memory consumers\n",[23,276,277,286,296,309,322,335,354,371],{"__ignoreMap":41},[45,278,279,281,283],{"class":47,"line":48},[45,280,239],{"class":64},[45,282,242],{"class":72},[45,284,285],{"class":51},"                      # all processes, BSD-style (most common)\n",[45,287,288,290,293],{"class":47,"line":55},[45,289,239],{"class":64},[45,291,292],{"class":68}," -ef",[45,294,295],{"class":51},"                      # all processes, System V-style\n",[45,297,298,300,303,306],{"class":47,"line":61},[45,299,239],{"class":64},[45,301,302],{"class":68}," -e",[45,304,305],{"class":68}," --forest",[45,307,308],{"class":51},"              # tree view\n",[45,310,311,313,316,319],{"class":47,"line":98},[45,312,239],{"class":64},[45,314,315],{"class":68}," -u",[45,317,318],{"class":72}," alice",[45,320,321],{"class":51},"                 # processes owned by alice\n",[45,323,324,326,329,332],{"class":47,"line":104},[45,325,239],{"class":64},[45,327,328],{"class":68}," -C",[45,330,331],{"class":72}," nginx",[45,333,334],{"class":51},"                 # processes named nginx\n",[45,336,337,339,342,345,348,351],{"class":47,"line":110},[45,338,239],{"class":64},[45,340,341],{"class":68}," -p",[45,343,344],{"class":68}," 1234",[45,346,347],{"class":68}," -o",[45,349,350],{"class":72}," pid,ppid,cmd",[45,352,353],{"class":51},"  # specific PID, custom columns\n",[45,355,356,358,360,363,365,368],{"class":47,"line":223},[45,357,239],{"class":64},[45,359,242],{"class":72},[45,361,362],{"class":68}," --sort=-%cpu",[45,364,86],{"class":82},[45,366,367],{"class":64}," head",[45,369,370],{"class":51},"  # top CPU consumers\n",[45,372,373,375,377,380,382,384],{"class":47,"line":230},[45,374,239],{"class":64},[45,376,242],{"class":72},[45,378,379],{"class":68}," --sort=-%mem",[45,381,86],{"class":82},[45,383,367],{"class":64},[45,385,386],{"class":51},"  # top memory consumers\n",[14,388,389,390,393],{},"The ",[23,391,392],{},"ps aux"," columns:",[37,395,400],{"className":396,"code":398,"language":399,"meta":41},[397],"language-text","USER       PID %CPU %MEM    VSZ   RSS TTY      STAT START   TIME COMMAND\nroot         1  0.0  0.1 168924 13140 ?        Ss   Jun15   1:23 \u002Fsbin\u002Finit\nalice     1240  0.0  0.2  25460  5232 pts\u002F0    Ss   10:00   0:00 -bash\nalice     1305  1.2  0.8 124356 32100 pts\u002F0    S+   10:15   0:05 vim notes.md\n","text",[23,401,398],{"__ignoreMap":41},[115,403,404,410,416],{},[118,405,406,409],{},[18,407,408],{},"VSZ"," — virtual memory size (KB) — address space (often large, mostly not in RAM).",[118,411,412,415],{},[18,413,414],{},"RSS"," — resident set size (KB) — actual physical memory used.",[118,417,418,421],{},[18,419,420],{},"STAT"," — process state (see below).",[161,423,425],{"id":424},"process-states","Process States",[427,428,429,442],"table",{},[430,431,432],"thead",{},[433,434,435,439],"tr",{},[436,437,438],"th",{},"Code",[436,440,441],{},"Meaning",[443,444,445,456,466,476,486,496,506,516],"tbody",{},[433,446,447,453],{},[448,449,450],"td",{},[23,451,452],{},"R",[448,454,455],{},"Running or runnable (on run queue)",[433,457,458,463],{},[448,459,460],{},[23,461,462],{},"S",[448,464,465],{},"Interruptible sleep (waiting for an event)",[433,467,468,473],{},[448,469,470],{},[23,471,472],{},"D",[448,474,475],{},"Uninterruptible sleep (usually I\u002FO — can't be killed)",[433,477,478,483],{},[448,479,480],{},[23,481,482],{},"T",[448,484,485],{},"Stopped (by signal, e.g., Ctrl+Z) or traced (debugger)",[433,487,488,493],{},[448,489,490],{},[23,491,492],{},"Z",[448,494,495],{},"Zombie (defunct — dead, not yet reaped)",[433,497,498,503],{},[448,499,500],{},[23,501,502],{},"\u003C",[448,504,505],{},"High priority (negative nice)",[433,507,508,513],{},[448,509,510],{},[23,511,512],{},"N",[448,514,515],{},"Low priority (positive nice)",[433,517,518,523],{},[448,519,520],{},[23,521,522],{},"+",[448,524,525],{},"In foreground process group",[161,527,529,530,532],{"id":528},"edge-case-the-d-state-trap","Edge Case: The ",[23,531,472],{}," State Trap",[33,534,535],{"language":35},[37,536,538],{"className":39,"code":537,"language":35,"meta":41,"style":41},"# A process in state D (uninterruptible sleep) is waiting for I\u002FO and CANNOT be killed\n# — not even with kill -9. It will exit only when the I\u002FO completes (or never, if the\n# disk\u002FNFS is truly stuck). Reboot is often the only fix.\n#\n# Typical cause: stuck NFS mount, failing disk, buggy driver\nps aux | awk '$8 ~ \u002FD\u002F'           # find D-state processes\n",[23,539,540,545,550,555,560,565],{"__ignoreMap":41},[45,541,542],{"class":47,"line":48},[45,543,544],{"class":51},"# A process in state D (uninterruptible sleep) is waiting for I\u002FO and CANNOT be killed\n",[45,546,547],{"class":47,"line":55},[45,548,549],{"class":51},"# — not even with kill -9. It will exit only when the I\u002FO completes (or never, if the\n",[45,551,552],{"class":47,"line":61},[45,553,554],{"class":51},"# disk\u002FNFS is truly stuck). Reboot is often the only fix.\n",[45,556,557],{"class":47,"line":98},[45,558,559],{"class":51},"#\n",[45,561,562],{"class":47,"line":104},[45,563,564],{"class":51},"# Typical cause: stuck NFS mount, failing disk, buggy driver\n",[45,566,567,569,571,573,575,578],{"class":47,"line":110},[45,568,239],{"class":64},[45,570,242],{"class":72},[45,572,86],{"class":82},[45,574,247],{"class":64},[45,576,577],{"class":72}," '$8 ~ \u002FD\u002F'",[45,579,580],{"class":51},"           # find D-state processes\n",[28,582,584],{"id":583},"signals","Signals",[427,586,587,603],{},[430,588,589],{},[433,590,591,594,597,600],{},[436,592,593],{},"Signal",[436,595,596],{},"Number",[436,598,599],{},"Default Action",[436,601,602],{},"Use",[443,604,605,621,637,652,667,683,699,714,730],{},[433,606,607,612,615,618],{},[448,608,609],{},[23,610,611],{},"SIGTERM",[448,613,614],{},"15",[448,616,617],{},"Terminate",[448,619,620],{},"Polite \"please stop\" (allows cleanup)",[433,622,623,628,631,634],{},[448,624,625],{},[23,626,627],{},"SIGKILL",[448,629,630],{},"9",[448,632,633],{},"Terminate (can't be caught)",[448,635,636],{},"Force kill — last resort",[433,638,639,644,647,649],{},[448,640,641],{},[23,642,643],{},"SIGINT",[448,645,646],{},"2",[448,648,617],{},[448,650,651],{},"Ctrl+C (interrupt)",[433,653,654,659,662,664],{},[448,655,656],{},[23,657,658],{},"SIGHUP",[448,660,661],{},"1",[448,663,617],{},[448,665,666],{},"\"Hang up\" — reload config (daemons)",[433,668,669,674,677,680],{},[448,670,671],{},[23,672,673],{},"SIGSTOP",[448,675,676],{},"19",[448,678,679],{},"Stop (can't be caught)",[448,681,682],{},"Suspend (Ctrl+Z sends SIGTSTP, catchable)",[433,684,685,690,693,696],{},[448,686,687],{},[23,688,689],{},"SIGCONT",[448,691,692],{},"18",[448,694,695],{},"Continue",[448,697,698],{},"Resume a stopped process",[433,700,701,706,709,711],{},[448,702,703],{},[23,704,705],{},"SIGUSR1",[448,707,708],{},"10",[448,710,617],{},[448,712,713],{},"User-defined (e.g., nginx reopens logs)",[433,715,716,721,724,727],{},[448,717,718],{},[23,719,720],{},"SIGSEGV",[448,722,723],{},"11",[448,725,726],{},"Core dump",[448,728,729],{},"Segmentation fault (bad memory access)",[433,731,732,737,740,742],{},[448,733,734],{},[23,735,736],{},"SIGPIPE",[448,738,739],{},"13",[448,741,617],{},[448,743,744],{},"Writing to a pipe with no reader",[33,746,747],{"language":35},[37,748,750],{"className":39,"code":749,"language":35,"meta":41,"style":41},"kill -l                  # list all signals\nkill 1234                # send SIGTERM (15) to PID 1234\nkill -9 1234             # SIGKILL (force — no cleanup)\nkill -HUP 1234           # SIGHUP (reload)\nkill -0 1234             # check if process exists (no signal sent)\n",[23,751,752,763,772,784,796],{"__ignoreMap":41},[45,753,754,757,760],{"class":47,"line":48},[45,755,756],{"class":68},"kill",[45,758,759],{"class":68}," -l",[45,761,762],{"class":51},"                  # list all signals\n",[45,764,765,767,769],{"class":47,"line":55},[45,766,756],{"class":68},[45,768,344],{"class":68},[45,770,771],{"class":51},"                # send SIGTERM (15) to PID 1234\n",[45,773,774,776,779,781],{"class":47,"line":61},[45,775,756],{"class":68},[45,777,778],{"class":68}," -9",[45,780,344],{"class":68},[45,782,783],{"class":51},"             # SIGKILL (force — no cleanup)\n",[45,785,786,788,791,793],{"class":47,"line":98},[45,787,756],{"class":68},[45,789,790],{"class":68}," -HUP",[45,792,344],{"class":68},[45,794,795],{"class":51},"           # SIGHUP (reload)\n",[45,797,798,800,803,805],{"class":47,"line":104},[45,799,756],{"class":68},[45,801,802],{"class":68}," -0",[45,804,344],{"class":68},[45,806,807],{"class":51},"             # check if process exists (no signal sent)\n",[161,809,811],{"id":810},"caveat-anti-pattern-sigterm-vs-sigkill","Caveat & Anti-Pattern: SIGTERM vs SIGKILL",[33,813,814],{"language":35},[37,815,817],{"className":39,"code":816,"language":35,"meta":41,"style":41},"# NAIVE: kill -9 immediately (no cleanup, databases may need recovery)\nkill -9 1234\n\n# PRODUCTION: SIGTERM first, wait, then SIGKILL only if needed\nkill 1234                    # SIGTERM — allows graceful shutdown\nsleep 5                      # give it time to clean up\nkill -0 1234 2>\u002Fdev\u002Fnull && kill -9 1234   # still alive? force kill\n\n# Edge Case: D-state processes ignore even SIGKILL\n# kill -9 \u003CD-state-pid> → no effect (process is in uninterruptible I\u002FO wait)\n",[23,818,819,824,833,837,842,851,862,888,892,897],{"__ignoreMap":41},[45,820,821],{"class":47,"line":48},[45,822,823],{"class":51},"# NAIVE: kill -9 immediately (no cleanup, databases may need recovery)\n",[45,825,826,828,830],{"class":47,"line":55},[45,827,756],{"class":68},[45,829,778],{"class":68},[45,831,832],{"class":68}," 1234\n",[45,834,835],{"class":47,"line":61},[45,836,227],{"emptyLinePlaceholder":226},[45,838,839],{"class":47,"line":98},[45,840,841],{"class":51},"# PRODUCTION: SIGTERM first, wait, then SIGKILL only if needed\n",[45,843,844,846,848],{"class":47,"line":104},[45,845,756],{"class":68},[45,847,344],{"class":68},[45,849,850],{"class":51},"                    # SIGTERM — allows graceful shutdown\n",[45,852,853,856,859],{"class":47,"line":110},[45,854,855],{"class":64},"sleep",[45,857,858],{"class":68}," 5",[45,860,861],{"class":51},"                      # give it time to clean up\n",[45,863,864,866,868,870,873,876,879,881,883,885],{"class":47,"line":223},[45,865,756],{"class":68},[45,867,802],{"class":68},[45,869,344],{"class":68},[45,871,872],{"class":82}," 2>",[45,874,875],{"class":72},"\u002Fdev\u002Fnull",[45,877,878],{"class":186}," && ",[45,880,756],{"class":68},[45,882,778],{"class":68},[45,884,344],{"class":68},[45,886,887],{"class":51},"   # still alive? force kill\n",[45,889,890],{"class":47,"line":230},[45,891,227],{"emptyLinePlaceholder":226},[45,893,894],{"class":47,"line":236},[45,895,896],{"class":51},"# Edge Case: D-state processes ignore even SIGKILL\n",[45,898,899],{"class":47,"line":256},[45,900,901],{"class":51},"# kill -9 \u003CD-state-pid> → no effect (process is in uninterruptible I\u002FO wait)\n",[28,903,905],{"id":904},"job-control","Job Control",[33,907,908],{"language":35},[37,909,911],{"className":39,"code":910,"language":35,"meta":41,"style":41},"# Complex Implementation: parallel jobs with exit-code capture\nsleep 100 &             # background (prints [1] 12345 — job 1, PID 12345)\nvim notes.md            # foreground (shell blocks)\nCtrl+Z                  # suspend vim → \"Stopped\", shell returns\nbg                      # resume vim in background\njobs                    # list background jobs\nfg %1                   # bring job 1 to foreground\nkill %1                 # send SIGTERM to job 1\nwait                    # wait for all background jobs\n",[23,912,913,918,931,942,950,958,966,977,986],{"__ignoreMap":41},[45,914,915],{"class":47,"line":48},[45,916,917],{"class":51},"# Complex Implementation: parallel jobs with exit-code capture\n",[45,919,920,922,925,928],{"class":47,"line":55},[45,921,855],{"class":64},[45,923,924],{"class":68}," 100",[45,926,927],{"class":186}," &             ",[45,929,930],{"class":51},"# background (prints [1] 12345 — job 1, PID 12345)\n",[45,932,933,936,939],{"class":47,"line":61},[45,934,935],{"class":64},"vim",[45,937,938],{"class":72}," notes.md",[45,940,941],{"class":51},"            # foreground (shell blocks)\n",[45,943,944,947],{"class":47,"line":98},[45,945,946],{"class":64},"Ctrl+Z",[45,948,949],{"class":51},"                  # suspend vim → \"Stopped\", shell returns\n",[45,951,952,955],{"class":47,"line":104},[45,953,954],{"class":68},"bg",[45,956,957],{"class":51},"                      # resume vim in background\n",[45,959,960,963],{"class":47,"line":110},[45,961,962],{"class":68},"jobs",[45,964,965],{"class":51},"                    # list background jobs\n",[45,967,968,971,974],{"class":47,"line":223},[45,969,970],{"class":68},"fg",[45,972,973],{"class":72}," %1",[45,975,976],{"class":51},"                   # bring job 1 to foreground\n",[45,978,979,981,983],{"class":47,"line":230},[45,980,756],{"class":68},[45,982,973],{"class":72},[45,984,985],{"class":51},"                 # send SIGTERM to job 1\n",[45,987,988,991],{"class":