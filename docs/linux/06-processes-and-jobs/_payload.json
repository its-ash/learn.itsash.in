6,1077],{"class":68}," -s",[45,1079,1080],{"class":72}," work",[45,1082,1083],{"class":72}," 'long-task'",[45,1085,1086],{"class":51},"   # run in tmux (survives logout, reattachable)\n",[28,1088,1090,1091,1094,1095],{"id":1089},"process-priority-nice-and-renice","Process Priority: ",[23,1092,1093],{},"nice"," and ",[23,1096,1097],{},"renice",[427,1099,1100,1110],{},[430,1101,1102],{},[433,1103,1104,1107],{},[436,1105,1106],{},"Nice",[436,1108,1109],{},"Priority",[443,1111,1112,1120,1128],{},[433,1113,1114,1117],{},[448,1115,1116],{},"-20",[448,1118,1119],{},"Highest (needs root to set)",[433,1121,1122,1125],{},[448,1123,1124],{},"0",[448,1126,1127],{},"Default",[433,1129,1130,1132],{},[448,1131,676],{},[448,1133,1134],{},"Lowest (runs only when CPU is idle)",[33,1136,1137],{"language":35},[37,1138,1140],{"className":39,"code":1139,"language":35,"meta":41,"style":41},"# Complex Implementation: low-priority backup job (CPU + I\u002FO)\nnice -n 19 ionice -c 3 tar -czf backup.tar.gz \u002Fhome\n# nice: low CPU priority\n# ionice -c 3: idle I\u002FO class (only uses disk when no one else does)\n# Prevents the backup from disrupting interactive work\n\nrenice -n 5 -p 1234     # change running process to nice 5\n",[23,1141,1142,1147,1177,1182,1187,1192,1196],{"__ignoreMap":41},[45,1143,1144],{"class":47,"line":48},[45,1145,1146],{"class":51},"# Complex Implementation: low-priority backup job (CPU + I\u002FO)\n",[45,1148,1149,1151,1154,1157,1160,1162,1165,1168,1171,1174],{"class":47,"line":55},[45,1150,1093],{"class":64},[45,1152,1153],{"class":68}," -n",[45,1155,1156],{"class":68}," 19",[45,1158,1159],{"class":72}," ionice",[45,1161,76],{"class":68},[45,1163,1164],{"class":68}," 3",[45,1166,1167],{"class":72}," tar",[45,1169,1170],{"class":68}," -czf",[45,1172,1173],{"class":72}," backup.tar.gz",[45,1175,1176],{"class":72}," \u002Fhome\n",[45,1178,1179],{"class":47,"line":61},[45,1180,1181],{"class":51},"# nice: low CPU priority\n",[45,1183,1184],{"class":47,"line":98},[4