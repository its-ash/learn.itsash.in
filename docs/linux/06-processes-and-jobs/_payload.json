[{"data":1,"prerenderedAt":2018},["ShallowReactive",2],{"page-\u002Flinux\u002F06-processes-and-jobs":3},{"id":4,"title":5,"body":6,"description":2011,"extension":2012,"meta":2013,"navigation":226,"path":2014,"seo":2015,"stem":2016,"__hash__":2017},"content\u002Flinux\u002F06-processes-and-jobs.md","06 — Processes & Jobs",{"type":7,"value":8,"toc":1984},"minimark",[9,13,27,32,114,160,165,260,264,270,387,394,541,561,565,665,672,720,724,884,947,951,1041,1045,1133,1137,1226,1237,1274,1350,1357,1547,1554,1636,1640,1718,1722,1822,1826,1836,1853,1856,1980],[10,11,5],"h1",{"id":12},"_06-processes-jobs",[14,15,16,17,21,22,26],"p",{},"A ",[18,19,20],"strong",{},"process"," is a running instance of a program. Linux is a multitasking, multi-user system — dozens to thousands of processes run concurrently, sharing the CPU(s). This chapter covers process lifecycle, signals, scheduling, and the ",[23,24,25],"code",{},"\u002Fproc"," interface — through the lens of production diagnostics and edge-case behavior.",[28,29,31],"h2",{"id":30},"process-lifecycle-fork-exec-exit-wait","Process Lifecycle: fork, exec, exit, wait",[33,34,36],"code-wrapper",{"language":35},"bash",[37,38,42],"pre",{"className":39,"code":40,"language":35,"meta":41,"style":41},"language-bash shiki shiki-themes github-light github-dark","# Complex Implementation: trace the fork\u002Fexec\u002Fwait cycle with strace\n# — reveals what \"running a command\" actually does at the syscall level\nstrace -f bash -c \"ls \u002Fetc >\u002Fdev\u002Fnull\" 2>&1 | grep -E \"clone|execve|wait4\"\n# clone(...) = child_pid          ← fork (Linux uses clone, not fork)\n# execve(\"\u002Fusr\u002Fbin\u002Fls\", ...) = 0  ← exec (child replaces itself with ls)\n# wait4(child_pid, ...) = ...     ← parent waits for exit status\n","",[23,43,44,53,59,96,102,108],{"__ignoreMap":41},[45,46,49],"span",{"class":47,"line":48},"line",1,[45,50,52],{"class":51},"sdCPZ","# Complex Implementation: trace the fork\u002Fexec\u002Fwait cycle with strace\n",[45,54,56],{"class":47,"line":55},2,[45,57,58],{"class":51},"# — reveals what \"running a command\" actually does at the syscall level\n",[45,60,62,66,70,74,77,80,84,87,90,93],{"class":47,"line":61},3,[45,63,65],{"class":64},"sIsaT","strace",[45,67,69],{"class":68},"snvgF"," -f",[45,71,73],{"class":72},"sJ6F3"," bash",[45,75,76],{"class":68}," -c",[45,78,79],{"class":72}," \"ls \u002Fetc >\u002Fdev\u002Fnull\"",[45,81,83],{"class":82},"svdQ7"," 2>&1",[45,85,86],{"class":82}," |",[45,88,89],{"class":64}," grep",[45,91,92],{"class":68}," -E",[45,94,95],{"class":72}," \"clone|execve|wait4\"\n",[45,97,99],{"class":47,"line":98},4,[45,100,101],{"class":51},"# clone(...) = child_pid          ← fork (Linux uses clone, not fork)\n",[45,103,105],{"class":47,"line":104},5,[45,106,107],{"class":51},"# execve(\"\u002Fusr\u002Fbin\u002Fls\", ...) = 0  ← exec (child replaces itself with ls)\n",[45,109,111],{"class":47,"line":110},6,[45,112,113],{"class":51},"# wait4(child_pid, ...) = ...     ← parent waits for exit status\n",[115,116,117,129,137,153],"ul",{},[118,119,120,125,126,128],"li",{},[18,121,122],{},[23,123,124],{},"fork()"," — child is an exact copy of the parent (memory, file descriptors, environment). Only difference: ",[23,127,124],{}," returns child PID to parent, 0 to child.",[118,130,131,136],{},[18,132,133],{},[23,134,135],{},"exec()"," — child loads a new program, replacing the copied parent code.",[118,138,139,144,145,148,149,152],{},[18,140,141],{},[23,142,143],{},"exit()"," — process terminates with a status code (0–255). Becomes a ",[18,146,147],{},"zombie"," until parent calls ",[23,150,151],{},"wait()",".",[118,154,155,159],{},[18,156,157],{},[23,158,151],{}," — parent collects exit status; zombie is reaped.",[161,162,164],"h3",{"id":163},"edge-case-zombies-and-orphans","Edge Case: Zombies and Orphans",[33,166,167],{"language":35},[37,168,170],{"className":39,"code":169,"language":35,"meta":41,"style":41},"# Complex Implementation: demonstrate zombie creation and reaping\n# — a process that dies before its parent wait()s becomes a zombie\n(\n  sleep 1 &        # child starts\n  exit 0           # parent exits immediately without waiting\n)                  # child is now an orphan (reparented to PID 1, which reaps it)\n\n# If the parent is buggy and never waits, zombies accumulate:\nps aux | awk '$8 ~ \u002FZ\u002F {print}'    # find zombies (state Z)\n# Fix: kill the parent (children get reaped by PID 1)\n",[23,171,172,177,182,188,202,213,221,228,234,254],{"__ignoreMap":41},[45,173,174],{"class":47,"line":48},[45,175,176],{"class":51},"# Complex Implementation: demonstrate zombie creation and reaping\n",[45,178,179],{"class":47,"line":55},[45,180,181],{"class":51},"# — a process that dies before its parent wait()s becomes a zombie\n",[45,183,184],{"class":47,"line":61},[45,185,187],{"class":186},"ssxIu","(\n",[45,189,190,193,196,199],{"class":47,"line":98},[45,191,192],{"class":64},"  sleep",[45,194,195],{"class":68}," 1",[45,197,198],{"class":186}," &        ",[45,200,201],{"class":51},"# child starts\n",[45,203,204,207,210],{"class":47,"line":104},[45,205,206],{"class":68},"  exit",[45,208,209],{"class":68}," 0",[45,211,212],{"class":51},"           # parent exits immediately without waiting\n",[45,214,215,218],{"class":47,"line":110},[45,216,217],{"class":186},")                  ",[45,219,220],{"class":51},"# child is now an orphan (reparented to PID 1, which reaps it)\n",[45,222,224],{"class":47,"line":223},7,[45,225,227],{"emptyLinePlaceholder":226},true,"\n",[45,229,231],{"class":47,"line":230},8,[45,232,233],{"class":51},"# If the parent is buggy and never waits, zombies accumulate:\n",[45,235,237,240,243,245,248,251],{"class":47,"line":236},9,[45,238,239],{"class":64},"ps",[45,241,242],{"class":72}," aux",[45,244,86],{"class":82},[45,246,247],{"class":64}," awk",[45,249,250],{"class":72}," '$8 ~ \u002FZ\u002F {print}'",[45,252,253],{"class":51},"    # find zombies (state Z)\n",[45,255,257],{"class":47,"line":256},10,[45,258,259],{"class":51},"# Fix: kill the parent (children get reaped by PID 1)\n",[28,261,263],{"id":262},"viewing-processes","Viewing Processes",[161,265,267,269],{"id":266},"ps-snapshot",[23,268,239],{}," — Snapshot",[33,271,272],{"language":35},[37,273,275],{"className":39,"code":274,"language":35,"meta":41,"style":41},"ps aux                      # all processes, BSD-style (most common)\nps -ef                      # all processes, System V-style\nps -e --forest              # tree view\nps -u alice                 # processes owned by alice\nps -C nginx                 # processes named nginx\nps -p 1234 -o pid,ppid,cmd  # specific PID, custom columns\nps aux --sort=-%cpu | head  # top CPU consumers\nps aux --sort=-%mem | head  # top memory consumers\n",[23,276,277,286,296,309,322,335,354,371],{"__ignoreMap":41},[45,278,279,281,283],{"class":47,"line":48},[45,280,239],{"class":64},[45,282,242],{"class":72},[45,284,285],{"class":51},"                      # all processes, BSD-style (most common)\n",[45,287,288,290,293],{"class":47,"line":55},[45,289,239],{"class":64},[45,291,292],{"class":68}," -ef",[45,294,295],{"class":51},"                      # all processes, System V-style\n",[45,297,298,300,303,306],{"class":47,"line":61},[45,299,239],{"class":64},[45,301,302],{"class":68}," -e",[45,304,305],{"class":68}," --forest",[45,307,308],{"class":51},"              # tree view\n",[45,310,311,313,316,319],{"class":47,"line":98},[45,312,239],{"class":64},[45,314,315],{"class":68}," -u",[45,317,318],{"class":72}," alice",[45,320,321],{"class":51},"                 # processes owned by alice\n",[45,323,324,326,329,332],{"class":47,"line":104},[45,325,239],{"class":64},[45,327,328],{"class":68}," -C",[45,330,331],{"class":72}," nginx",[45,333,334],{"class":51},"                 # processes named nginx\n",[45,336,337,339,342,345,348,351],{"class":47,"line":110},[45,338,239],{"class":64},[45,340,341],{"class":68}," -p",[45,343,344],{"class":68}," 1234",[45,346,347],{"class":68}," -o",[45,349,350],{"class":72}," pid,ppid,cmd",[45,352,353],{"class":51},"  # specific PID, custom columns\n",[45,355,356,358,360,363,365,368],{"class":47,"line":223},[45,357,239],{"class":64},[45,359,242],{"class":72},[45,361,362],{"class":68}," --sort=-%cpu",[45,364,86],{"class":82},[45,366,367],{"class":64}," head",[45,369,370],{"class":51},"  # top CPU consumers\n",[45,372,373,375,377,380,382,384],{"class":47,"line":230},[45,374,239],{"class":64},[45,376,242],{"class":72},[45,378,379],{"class":68}," --sort=-%mem",[45,381,86],{"class":82},[45,383,367],{"class":64},[45,385,386],{"class":51},"  # top memory consumers\n",[14,388,389,390,393],{},"The ",[23,391,392],{},"ps aux"," columns:",[33,395,396],{"language":35},[37,397,399],{"className":39,"code":398,"language":35,"meta":41,"style":41},"USER       PID %CPU %MEM    VSZ   RSS TTY      STAT START   TIME COMMAND\nroot         1  0.0  0.1 168924 13140 ?        Ss   Jun15   1:23 \u002Fsbin\u002Finit\nalice     1240  0.0  0.2  25460  5232 pts\u002F0    Ss   10:00   0:00 -bash\nalice     1305  1.2  0.8 124356 32100 pts\u002F0    S+   10:15   0:05 vim notes.md\n",[23,400,401,436,471,505],{"__ignoreMap":41},[45,402,403,406,409,412,415,418,421,424,427,430,433],{"class":47,"line":48},[45,404,405],{"class":64},"USER",[45,407,408],{"class":72},"       PID",[45,410,411],{"class":72}," %CPU",[45,413,414],{"class":72}," %MEM",[45,416,417],{"class":72},"    VSZ",[45,419,420],{"class":72},"   RSS",[45,422,423],{"class":72}," TTY",[45,425,426],{"class":72},"      STAT",[45,428,429],{"class":72}," START",[45,431,432],{"class":72},"   TIME",[45,434,435],{"class":72}," COMMAND\n",[45,437,438,441,444,447,450,453,456,459,462,465,468],{"class":47,"line":55},[45,439,440],{"class":64},"root",[45,442,443],{"class":68},"         1",[45,445,446],{"class":68},"  0.0",[45,448,449],{"class":68},"  0.1",[45,451,452],{"class":68}," 168924",[45,454,455],{"class":68}," 13140",[45,457,458],{"class":72}," ?",[45,460,461],{"class":72},"        Ss",[45,463,464],{"class":72},"   Jun15",[45,466,467],{"class":72},"   1:23",[45,469,470],{"class":72}," \u002Fsbin\u002Finit\n",[45,472,473,476,479,481,484,487,490,493,496,499,502],{"class":47,"line":61},[45,474,475],{"class":64},"alice",[45,477,478],{"class":68},"     1240",[45,480,446],{"class":68},[45,482,483],{"class":68},"  0.2",[45,485,486],{"class":68},"  25460",[45,488,489],{"class":68},"  5232",[45,491,492],{"class":72}," pts\u002F0",[45,494,495],{"class":72},"    Ss",[45,497,498],{"class":72},"   10:00",[45,500,501],{"class":72},"   0:00",[45,503,504],{"class":68}," -bash\n",[45,506,507,509,512,515,518,521,524,526,529,532,535,538],{"class":47,"line":98},[45,508,475],{"class":64},[45,510,511],{"class":68},"     1305",[45,513,514],{"class":68},"  1.2",[45,516,517],{"class":68},"  0.8",[45,519,520],{"class":68}," 124356",[45,522,523],{"class":68}," 32100",[45,525,492],{"class":72},[45,527,528],{"class":72},"    S+",[45,530,531],{"class":72},"   10:15",[45,533,534],{"class":72},"   0:05",[45,536,537],{"class":72}," vim",[45,539,540],{"class":72}," notes.md\n",[115,542,543,549,555],{},[118,544,545,548],{},[18,546,547],{},"VSZ"," — virtual memory size (KB) — address space (often large, mostly not in RAM).",[118,550,551,554],{},[18,552,553],{},"RSS"," — resident set size (KB) — actual physical memory used.",[118,556,557,560],{},[18,558,559],{},"STAT"," — process state (see below).",[161,562,564],{"id":563},"process-states","Process States",[566,567,568,581],"table",{},[569,570,571],"thead",{},[572,573,574,578],"tr",{},[575,576,577],"th",{},"Code",[575,579,580],{},"Meaning",[582,583,584,595,605,615,625,635,645,655],"tbody",{},[572,585,586,592],{},[587,588,589],"td",{},[23,590,591],{},"R",[587,593,594],{},"Running or runnable (on run queue)",[572,596,597,602],{},[587,598,599],{},[23,600,601],{},"S",[587,603,604],{},"Interruptible sleep (waiting for an event)",[572,606,607,612],{},[587,608,609],{},[23,610,611],{},"D",[587,613,614],{},"Uninterruptible sleep (usually I\u002FO — can't be killed)",[572,616,617,622],{},[587,618,619],{},[23,620,621],{},"T",[587,623,624],{},"Stopped (by signal, e.g., Ctrl+Z) or traced (debugger)",[572,626,627,632],{},[587,628,629],{},[23,630,631],{},"Z",[587,633,634],{},"Zombie (defunct — dead, not yet reaped)",[572,636,637,642],{},[587,638,639],{},[23,640,641],{},"\u003C",[587,643,644],{},"High priority (negative nice)",[572,646,647,652],{},[587,648,649],{},[23,650,651],{},"N",[587,653,654],{},"Low priority (positive nice)",[572,656,657,662],{},[587,658,659],{},[23,660,661],{},"+",[587,663,664],{},"In foreground process group",[161,666,668,669,671],{"id":667},"edge-case-the-d-state-trap","Edge Case: The ",[23,670,611],{}," State Trap",[33,673,674],{"language":35},[37,675,677],{"className":39,"code":676,"language":35,"meta":41,"style":41},"# A process in state D (uninterruptible sleep) is waiting for I\u002FO and CANNOT be killed\n# — not even with kill -9. It will exit only when the I\u002FO completes (or never, if the\n# disk\u002FNFS is truly stuck). Reboot is often the only fix.\n#\n# Typical cause: stuck NFS mount, failing disk, buggy driver\nps aux | awk '$8 ~ \u002FD\u002F'           # find D-state processes\n",[23,678,679,684,689,694,699,704],{"__ignoreMap":41},[45,680,681],{"class":47,"line":48},[45,682,683],{"class":51},"# A process in state D (uninterruptible sleep) is waiting for I\u002FO and CANNOT be killed\n",[45,685,686],{"class":47,"line":55},[45,687,688],{"class":51},"# — not even with kill -9. It will exit only when the I\u002FO completes (or never, if the\n",[45,690,691],{"class":47,"line":61},[45,692,693],{"class":51},"# disk\u002FNFS is truly stuck). Reboot is often the only fix.\n",[45,695,696],{"class":47,"line":98},[45,697,698],{"class":51},"#\n",[45,700,701],{"class":47,"line":104},[45,702,703],{"class":51},"# Typical cause: stuck NFS mount, failing disk, buggy driver\n",[45,705,706,708,710,712,714,717],{"class":47,"line":110},[45,707,239],{"class":64},[45