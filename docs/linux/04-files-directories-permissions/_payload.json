[{"data":1,"prerenderedAt":1724},["ShallowReactive",2],{"page-\u002Flinux\u002F04-files-directories-permissions":3},{"id":4,"title":5,"body":6,"description":16,"extension":1718,"meta":1719,"navigation":218,"path":1720,"seo":1721,"stem":1722,"__hash__":1723},"content\u002Flinux\u002F04-files-directories-permissions.md","04 — Files, Directories & Permissions",{"type":7,"value":8,"toc":1691},"minimark",[9,13,17,22,38,49,53,129,151,257,261,264,385,442,446,455,462,578,586,597,676,684,695,757,767,774,788,805,842,860,867,892,896,899,902,993,996,1010,1014,1077,1081,1088,1157,1164,1171,1238,1252,1256,1353,1357,1485,1489,1492,1528,1535,1687],[10,11,5],"h1",{"id":12},"_04-files-directories-permissions",[14,15,16],"p",{},"Linux permissions control who can read, write, and execute files, and who owns them. This is the foundation of filesystem-level security. This chapter covers ownership, permission bits, special bits, ACLs, capabilities, and the traps that cause \"permission denied\" mysteries.",[18,19,21],"h2",{"id":20},"ownership-users-and-groups","Ownership: Users and Groups",[14,23,24,25,29,30,33,34,37],{},"Every file has an owner (user, by UID), a group (by GID), and permissions for three classes: ",[26,27,28],"strong",{},"owner"," (user), ",[26,31,32],{},"group",", and ",[26,35,36],{},"others",".",[39,40,46],"pre",{"className":41,"code":43,"language":44,"meta":45},[42],"language-text","$ ls -l \u002Fetc\u002Fpasswd\n-rw-r--r-- 1 root root 3218 Jun 15 10:23 \u002Fetc\u002Fpasswd\n└──┘└─┘└─┘ └──┘ └──┘\n  │   │   │    │     └ group (root)\n  │   │   │    └ owner (root)\n  │   │   └ permissions for others (r--)\n  │   └ permissions for group (r--)\n  └ permissions for owner (rw-)\n","text","",[47,48,43],"code",{"__ignoreMap":45},[18,50,52],{"id":51},"permission-bits-meaning-by-file-type","Permission Bits — Meaning by File Type",[54,55,56,72],"table",{},[57,58,59],"thead",{},[60,61,62,66,69],"tr",{},[63,64,65],"th",{},"Bit",[63,67,68],{},"Regular File",[63,70,71],{},"Directory",[73,74,75,96,112],"tbody",{},[60,76,77,83,90],{},[78,79,80],"td",{},[47,81,82],{},"r",[78,84,85,86,89],{},"Read contents (",[47,87,88],{},"cat",")",[78,91,92,93,89],{},"List entries (",[47,94,95],{},"ls",[60,97,98,103,109],{},[78,99,100],{},[47,101,102],{},"w",[78,104,105,106,89],{},"Modify contents (",[47,107,108],{},"echo >",[78,110,111],{},"Create\u002Fdelete\u002Frename entries inside",[60,113,114,119,122],{},[78,115,116],{},[47,117,118],{},"x",[78,120,121],{},"Execute (run as program)",[78,123,124,125,128],{},"Enter (",[47,126,127],{},"cd",") \u002F traverse (use in a path)",[14,130,131,132,138,139,141,142,144,145,147,148,150],{},"Key difference: ",[26,133,134,135,137],{},"directory ",[47,136,118],{}," is \"traverse\u002Fsearch\" permission",", not \"execute.\" Without ",[47,140,118],{}," on a directory, you can't ",[47,143,127],{}," into it or access files inside it by path — even if you know their names. ",[47,146,82],{}," lets you list; ",[47,149,118],{}," lets you actually access.",[152,153,155],"code-wrapper",{"language":154},"bash",[39,156,159],{"className":157,"code":158,"language":154,"meta":45,"style":45},"language-bash shiki shiki-themes github-light github-dark","# Complex Implementation: demonstrate r vs x on directories\n# r but no x: can list names, can't access content\nchmod 444 somedir\u002F\nls somedir\u002F               # works (lists names)\ncat somedir\u002Ffile          # Permission denied (no x to traverse)\n\n# x but no r: can access by name, can't list\nchmod 111 somedir\u002F\ncat somedir\u002Fknownfile     # works (if you know the exact name)\nls somedir\u002F               # Permission denied (can't list)\n",[47,160,161,170,176,191,202,213,220,226,236,247],{"__ignoreMap":45},[162,163,166],"span",{"class":164,"line":165},"line",1,[162,167,169],{"class":168},"sdCPZ","# Complex Implementation: demonstrate r vs x on directories\n",[162,171,173],{"class":164,"line":172},2,[162,174,175],{"class":168},"# r but no x: can list names, can't access content\n",[162,177,179,183,187],{"class":164,"line":178},3,[162,180,182],{"class":181},"sIsaT","chmod",[162,184,186],{"class":185},"snvgF"," 444",[162,188,190],{"class":189},"sJ6F3"," somedir\u002F\n",[162,192,194,196,199],{"class":164,"line":193},4,[162,195,95],{"class":181},[162,197,198],{"class":189}," somedir\u002F",[162,200,201],{"class":168},"               # works (lists names)\n",[162,203,205,207,210],{"class":164,"line":204},5,[162,206,88],{"class":181},[162,208,209],{"class":189}," somedir\u002Ffile",[162,211,212],{"class":168},"          # Permission denied (no x to traverse)\n",[162,214,216],{"class":164,"line":215},6,[162,217,219],{"emptyLinePlaceholder":218},true,"\n",[162,221,223],{"class":164,"line":222},7,[162,224,225],{"class":168},"# x but no r: can access by name, can't list\n",[162,227,229,231,234],{"class":164,"line":228},8,[162,230,182],{"class":181},[162,232,233],{"class":185}," 111",[162,235,190],{"class":189},[162,237,239,241,244],{"class":164,"line":238},9,[162,240,88],{"class":181},[162,242,243],{"class":189}," somedir\u002Fknownfile",[162,245,246],{"class":168},"     # works (if you know the exact name)\n",[162,248,250,252,254],{"class":164,"line":249},10,[162,251,95],{"class":181},[162,253,198],{"class":189},[162,255,256],{"class":168},"               # Permission denied (can't list)\n",[18,258,260],{"id":259},"numeric-octal-mode","Numeric (Octal) Mode",[14,262,263],{},"Each triplet sums to 0–7:",[54,265,266,279],{},[57,267,268],{},[60,269,270,273,276],{},[63,271,272],{},"Octal",[63,274,275],{},"Symbolic",[63,277,278],{},"Meaning",[73,280,281,294,307,320,333,346,359,372],{},[60,282,283,286,291],{},[78,284,285],{},"0",[78,287,288],{},[47,289,290],{},"---",[78,292,293],{},"No access",[60,295,296,299,304],{},[78,297,298],{},"1",[78,300,301],{},[47,302,303],{},"--x",[78,305,306],{},"Execute\u002Ftraverse",[60,308,309,312,317],{},[78,310,311],{},"2",[78,313,314],{},[47,315,316],{},"-w-",[78,318,319],{},"Write",[60,321,322,325,330],{},[78,323,324],{},"3",[78,326,327],{},[47,328,329],{},"-wx",[78,331,332],{},"Write + execute",[60,334,335,338,343],{},[78,336,337],{},"4",[78,339,340],{},[47,341,342],{},"r--",[78,344,345],{},"Read",[60,347,348,351,356],{},[78,349,350],{},"5",[78,352,353],{},[47,354,355],{},"r-x",[78,357,358],{},"Read + execute",[60,360,361,364,369],{},[78,362,363],{},"6",[78,365,366],{},[47,367,368],{},"rw-",[78,370,371],{},"Read + write",[60,373,374,377,382],{},[78,375,376],{},"7",[78,378,379],{},[47,380,381],{},"rwx",[78,383,384],{},"All",[152,386,387],{"language":154},[39,388,390],{"className":157,"code":389,"language":154,"meta":45,"style":45},"chmod 644 file     # rw-r--r-- (typical file)\nchmod 755 file     # rwxr-xr-x (typical executable\u002Fdir)\nchmod 600 file     # rw------- (private file, e.g., SSH key)\nchmod 700 dir      # rwx------ (private directory)\n",[47,391,392,405,417,429],{"__ignoreMap":45},[162,393,394,396,399,402],{"class":164,"line":165},[162,395,182],{"class":181},[162,397,398],{"class":185}," 644",[162,400,401],{"class":189}," file",[162,403,404],{"class":168},"     # rw-r--r-- (typical file)\n",[162,406,407,409,412,414],{"class":164,"line":172},[162,408,182],{"class":181},[162,410,411],{"class":185}," 755",[162,413,401],{"class":189},[162,415,416],{"class":168},"     # rwxr-xr-x (typical executable\u002Fdir)\n",[162,418,419,421,424,426],{"class":164,"line":178},[162,420,182],{"class":181},[162,422,423],{"class":185}," 600",[162,425,401],{"class":189},[162,427,428],{"class":168},"     # rw------- (private file, e.g., SSH key)\n",[162,430,431,433,436,439],{"class":164,"line":193},[162,432,182],{"class":181},[162,434,435],{"class":185}," 700",[162,437,438],{"class":189}," dir",[162,440,441],{"class":168},"      # rwx------ (private directory)\n",[18,443,445],{"id":444},"special-permission-bits","Special Permission Bits",[447,448,450,451,454],"h3",{"id":449},"setuid-4000-run-as-owner","Setuid (",[47,452,453],{},"4000",") — Run as Owner",[14,456,457,458,461],{},"When set on an executable, it runs ",[26,459,460],{},"as the file's owner"," regardless of who invokes it:",[152,463,464],{"language":154},[39,465,467],{"className":157,"code":466,"language":154,"meta":45,"style":45},"ls -l \u002Fusr\u002Fbin\u002Fsudo\n# -rwsr-xr-x 1 root root ... \u002Fusr\u002Fbin\u002Fsudo\n   ↑\n   setuid (s in owner execute position)\n\nchmod 4755 program      # setuid + 755\nchmod u+s program       # symbolic\n\n# Security audit — find all setuid root binaries:\nfind \u002F -perm -4000 -type f 2>\u002Fdev\u002Fnull\n",[47,468,469,479,484,489,513,517,530,542,546,551],{"__ignoreMap":45},[162,470,471,473,476],{"class":164,"line":165},[162,472,95],{"class":181},[162,474,475],{"class":185}," -l",[162,477,478],{"class":189}," \u002Fusr\u002Fbin\u002Fsudo\n",[162,480,481],{"class":164,"line":172},[162,482,483],{"class":168},"# -rwsr-xr-x 1 root root ... \u002Fusr\u002Fbin\u002Fsudo\n",[162,485,486],{"class":164,"line":178},[162,487,488],{"class":181},"   ↑\n",[162,490,491,494,498,501,504,507,510],{"class":164,"line":193},[162,492,493],{"class":181},"   setuid",[162,495,497],{"class":496},"ssxIu"," (s ",[162,499,500],{"class":189},"in",[162,502,503],{"class":189}," owner",[162,505,506],{"class":189}," execute",[162,508,509],{"class":189}," position",[162,511,512],{"class":496},")\n",[162,514,515],{"class":164,"line":204},[162,516,219],{"emptyLinePlaceholder":218},[162,518,519,521,524,527],{"class":164,"line":215},[162,520,182],{"class":181},[162,522,523],{"class":185}," 4755",[162,525,526],{"class":189}," program",[162,528,529],{"class":168},"      # setuid + 755\n",[162,531,532,534,537,539],{"class":164,"line":222},[162,533,182],{"class":181},[162,535,536],{"class":189}," u+s",[162,538,526],{"class":189},[162,540,541],{"class":168},"       # symbolic\n",[162,543,544],{"class":164,"line":228},[162,545,219],{"emptyLinePlaceholder":218},[162,547,548],{"class":164,"line":238},[162,549,550],{"class":168},"# Security audit — find all setuid root binaries:\n",[162,552,553,556,559,562,565,568,571,575],{"class":164,"line":249},[162,554,555],{"class":181},"find",[162,557,558],{"class":189}," \u002F",[162,560,561],{"class":185}," -perm",[162,563,564],{"class":185}," -4000",[162,566,567],{"class":185}," -type",[162,569,570],{"class":189}," f",[162,572,574],{"class":573},"svdQ7"," 2>",[162,576,577],{"class":189},"\u002Fdev\u002Fnull\n",[447,579,581,582,585],{"id":580},"setgid-2000-inherit-group-on-directories","Setgid (",[47,583,584],{},"2000",") — Inherit Group on Directories",[14,587,588,589,592,593,596],{},"On a ",[26,590,591],{},"directory",": new files\u002Fdirs inside ",[26,594,595],{},"inherit the directory's group"," (instead of the creator's primary group). Essential for shared directories:",[152,598,599],{"language":154},[39,600,602],{"className":157,"code":601,"language":154,"meta":45,"style":45},"# Complex Implementation: collaborative directory with setgid + default ACL\nsudo mkdir \u002Fshared\nsudo chown :developers \u002Fshared\nsudo chmod 2775 \u002Fshared              # setgid + rwxrwsr-x\n# Now all new files in \u002Fshared inherit the \"developers\" group\n# Add default ACL so new files also get group write (regardless of umask):\nsudo setfacl -d -m g:developers:rw \u002Fshared\n",[47,603,604,609,620,632,648,653,658],{"__ignoreMap":45},[162,605,606],{"class":164,"line":165},[162,607,608],{"class":168},"# Complex Implementation: collaborative directory with setgid + default ACL\n",[162,610,611,614,617],{"class":164,"line":172},[162,612,613],{"class":181},"sudo",[162,615,616],{"class":189}," mkdir",[162,618,619],{"class":189}," \u002Fshared\n",[162,621,622,624,627,630],{"class":164,"line":178},[162,623,613],{"class":181},[162,625,626],{"class":189}," chown",[162,628,629],{"class":189}," :developers",[162,631,619],{"class":189},[162,633,634,636,639,642,645],{"class":164,"line":193},[162,635,613],{"class":181},[162,637,638],{"class":189}," chmod",[162,640,641],{"class":185}," 2775",[162,643,644],{"class":189}," \u002Fshared",[162,646,647],{"class":168},"              # setgid + rwxrwsr-x\n",[162,649,650],{"class":164,"line":204},[162,651,652],{"class":168},"# Now all new files in \u002Fshared inherit the \"developers\" group\n",[162,654,655],{"class":164,"line":215},[162,656,657],{"class":168},"# Add default ACL so new files also get group write (regardless of umask):\n",[162,659,660,662,665,668,671,674],{"class":164,"line":222},[162,661,613],{"class":181},[162,663,664],{"class":189}," setfacl",[162,666,667],{"class":185}," -d",[162,669,670],{"class":185}," -m",[162,672,673],{"class":189}," g:developers:rw",[162,675,619],{"class":189},[447,677,679,680,683],{"id":678},"sticky-bit-1000-restricted-deletion","Sticky Bit (",[47,681,682],{},"1000",") — Restricted Deletion",[14,685,686,687,690,691,694],{},"On a directory, the sticky bit means ",[26,688,689],{},"only the file's owner (or the directory's owner, or root) can delete\u002Frename files inside"," — even if others have write permission. The canonical use is ",[47,692,693],{},"\u002Ftmp",":",[152,696,697],{"language":154},[39,698,700],{"className":157,"code":699,"language":154,"meta":45,"style":45},"ls -ld \u002Ftmp\n# drwxrwxrwt 20 root root 4096 ... \u002Ftmp\n            ↑\n            sticky bit (t in others execute position)\nchmod 1777 \u002Ftmp         # sticky + 777\n",[47,701,702,712,717,722,744],{"__ignoreMap":45},[162,703,704,706,709],{"class":164,"line":165},[162,705,95],{"class":181},[162,707,708],{"class":185}," -ld",[162,710,711],{"class":189}," \u002Ftmp\n",[162,713,714],{"class":164,"line":172},[162,715,716],{"class":168},"# drwxrwxrwt 20 root root 4096 ... \u002Ftmp\n",[162,718,719],{"class":164,"line":178},[162,720,721],{"class":181},"            ↑\n",[162,723,724,727,730,733,735,738,740,742],{"class":164,"line":193},[162,725,726],{"class":181},"            sticky",[162,728,729],{"class":189}," bit",[162,731,732],{"class":496}," (t ",[162,734,500],{"class":189},[162,736,737],{"class":189}," others",[162,739,506],{"class":189},[162,741,509],{"class":189},[162,743,512],{"class":496},[162,745,746,748,751,754],{"class":164,"line":204},[162,747,182],{"class":181},[162,749,750],{"class":185}," 1777",[162,752,753],{"class":189}," \u002Ftmp",[162,755,756],{"class":168},"         # sticky + 777\n",[14,758,759,760,762,763,766],{},"Without the sticky bit, since ",[47,761,693],{}," is world-writable (",[47,764,765],{},"777","), any user could delete any other user's temp files.",[18,768,770,773],{"id":769},"umask-default-permissions",[47,771,772],{},"umask"," — Default Permissions",[14,775,776,778,779,782,783,787],{},[47,777,772],{}," is a ",[26,780,781],{},"mask"," (bits to ",[784,785,786],"em",{},"remove",") from the default mode:",[789,790,791,799],"ul",{},[792,793,794,795,798],"li",{},"Files default to ",[47,796,797],{},"666"," (rw-rw-rw-).",[792,800,801,802,804],{},"Directories default to ",[47,803,765],{}," (rwxrwxrwx).",[152,806,807],{"language":154},[39,808,810],{"className":157,"code":809,"language":154,"meta":45,"style":45},"umask 077        # files: 600, dirs: 700 (private)\numask 022        # files: 644, dirs: 755 (default on most systems)\numask 002        # files: 664, dirs: 775 (shared group, e.g., team dirs)\n",[47,811,812,822,832],{"__ignoreMap":45},[162,813,814,816,819],{"class":164,"line":165},[162,815,772],{"class":185},[162,817,818],{"class":185}," 077",[162,820,821],{"class":168},"        # files: 600, dirs: 700 (private)\n",[162,823,824,826,829],{"class":164,"line":172},[162,825,772],{"class":185},[162,827,828],{"class":185}," 022",[162,830,831],{"class":168},"        # files: 644, dirs: 755 (default on most systems)\n",[162,833,834,836,839],{"class":164,"line":178},[162,835,772],{"class":185},[162,837,838],{"class":185}," 002",[162,840,841],{"class":168},"        # files: 664, dirs: 775 (shared group, e.g., team dirs)\n",[14,843,844,845,848,849,852,853,856,857,37],{},"Calculation: ",[47,846,847],{},"mode = default & ~umask",". ",[47,850,851],{},"umask 022"," → files ",[47,854,855],{},"666 & ~022 = 644",", dirs ",[47,858,859],{},"777 & ~022 = 755",[447,861,863,864,866],{"id":862},"edge-case-umask-doesnt-add-execute","Edge Case: ",[47,865,772],{}," Doesn't Add Execute",[14,868,869,870,873,874,876,877,879,880,883,884,887,888,891],{},"Files are created ",[47,871,872],{},"666 & ~umask"," — never ",[47,875,765],{},". So ",[47,878,851],{}," gives files ",[47,881,882],{},"644"," (not executable), dirs ",[47,885,886],{},"755",". You must ",[47,889,890],{},"chmod +x"," scripts after creating them.",[18,893,895],{"id":894},"acls-access-control-lists","ACLs (Access Control Lists)",[14,897,898],{},"Traditional permissions have only three classes. ACLs allow per-user or per-group permissions:",[14,900,901],{},"::code-wrapper{language=\"language=\"bash\"}",[39,903,905],{"className":157,"code":904,"language":154,"meta":45,"style":45},"# Grant alice read-write, developers group read\nsetfacl -m u:alice:rw file\nsetfacl -m g:developers:r file\n\n# Set default ACL on a directory (inherited by new files)\nsetfacl -d -m g:developers:rw \u002Fshared\n\n# View\ngetfacl file\n\n# Remove all ACLs\nsetfacl -b file\n",[47,906,907,912,925,936,940,945,957,961,966,973,977,983],{"__ignoreMap":45},[162,908,909],{"class":164,"line":165},[162,910,911],{"class":168},"# Grant alice read-write, developers group read\n",[162,913,914,917,919,922],{"class":164,"line":172},[162,915,916],{"class":181},"setfacl",[162,918,670],{"class":185},[162,920,921],{"class":189}," u:alice:rw",[162,923,924],{"class":189}," file\n",[162,926,927,929,931,934],{"class":164,"line":178},[162,928,916],{"class":181},[162,930,670],{"class":185},[162,932,933],{"class":189}," g:developers:r",[162,935,924],{"class":189},[162,937,938],{"class":164,"line":193},[162,939,219],{"emptyLinePlaceholder":218},[162,941,942],{"class":164,"line":204},[162,943,944],{"class":168},"# Set default ACL on a directory (inherited by new files)\n",[162,946,947,949,951,953,955],{"class":164,"line":215},[162,948,916],{"class":181},[162,950,667],{"class":185},[162,952,670],{"class":185},[162,954,673],{"class":189},[162,956,619],{"class":189},[162,958,959],{"class":164,"line":222},[162,960,219],{"emptyLinePlaceholder":218},[162,962,963],{"class":164,"line":228},[162,964,965],{"class":168},"# View\n",[162,967,968,971],{"class":164,"line":238},[162,969,970],{"class":181},"getfacl",[162,972,924],{"class":189},[162,974,975],{"class":164,"line":249},[162,976,219],{"emptyLinePlaceholder":218},[162,978,980],{"class":164,"line":979},11,[162,981,982],{"class":168},"# Remove all ACLs\n",[162,984,986,988,991],{"class":164,"line":985},12,[162,987,916],{"class":181},[162,989,990],{"class":185}," -b",[162,992,924],{"class":189},[14,994,995],{},"::",[14,997,998,999,1002,1003,1006,1007,37],{},"In ",[47,1000,1001],{},"ls -l",", a ",[47,1004,1005],{},"+"," after the mode indicates an ACL is present: ",[47,1008,1009],{},"-rw-rw-r--+",[447,1011,1013],{"id":1012},"edge-case-acls-lost-on-copy","Edge Case: ACLs Lost on Copy",[152,1015,1016],{"language":154},[39,1017,1019],{"className":157,"code":1018,"language":154,"meta":45,"style":45},"# NAIVE: cp strips ACLs and capabilities\ncp file \u002Fbackup\u002Ffile              # ACLs gone, capabilities gone\n# PRODUCTION: preserve everything\ncp -a file \u002Fbackup\u002Ffile           # preserves mode, owner, timestamps, ACLs\nrsync -A -X file \u002Fbackup\u002F         # -A ACLs, -X xattrs (full preservation)\n",[47,1020,1021,1026,1039,1044,1058],{"__ignoreMap":45},[162,1022,1023],{"class":164,"line":165},[162,1024,1025],{"class":168},"# NAIVE: cp strips ACLs and capabilities\n",[162,1027,1028,1031,1033,1036],{"class":164,"line":172},[162,1029,1030],{"class":181},"cp",[162,1032,401],{"class":189},[162,1034,1035],{"class":189}," \u002Fbackup\u002Ffile",[162,1037,1038],{"class":168},"              # ACLs gone, capabilities gone\n",[162,1040,1041],{"class":164,"line":178},[162,1042,1043],{"class":168},"# PRODUCTION: preserve everything\n",[162,1045,1046,1048,1051,1053,1055],{"class":164,"line":193},[162,1047,1030],{"class":181},[162,1049,1050],{"class":185}," -a",[162,1052,401],{"class":189},[162,1054,1035],{"class":189},[162,1056,1057],{"class":168},"           # preserves mode, owner, timestamps, ACLs\n",[162,1059,1060,1063,1066,1069,1071,1074],{"class":164,"line":204},[162,1061,1062],{"class":181},"rsync",[162,1064,1065],{"class":185}," -A",[162,1067,1068],{"class":185}," -X",[162,1070,401],{"class":189},[162,1072,1073],{"class":189}," \u002Fbackup\u002F",[162,1075,1076],{"class":168},"         # -A ACLs, -X xattrs (full preservation)\n",[18,1078,1080],{"id":1079},"file-capabilities","File Capabilities",[14,1082,1083,1084,1087],{},"Instead of setuid root, grant a binary ",[26,1085,1086],{},"specific"," capabilities (fine-grained privileges):",[152,1089,1090],{"language":154},[39,1091,1093],{"className":157,"code":1092,"language":154,"meta":45,"style":45},"# Complex Implementation: allow a binary to bind to port 80 without root\n# — safer than setuid (grants only one capability, not all root powers)\nsudo setcap 'cap_net_bind_service+ep' \u002Fusr\u002Fbin\u002Fmyapp\ngetcap \u002Fusr\u002Fbin\u002Fmyapp                    # verify\nsudo setcap -r \u002Fusr\u002Fbin\u002Fmyapp            # remove\n\n# Anti-Pattern: setuid root for the same purpose\n# sudo chmod u+s \u002Fusr\u002Fbin\u002Fmyapp  → grants ALL root privileges (dangerous)\n",[47,1094,1095,1100,1105,1118,1129,1143,1147,1152],{"__ignoreMap":45},[162,1096,1097],{"class":164,"line":165},[162,1098,1099],{"class":168},"# Complex Implementation: allow a binary to bind to port 80 without root\n",[162,1101,1102],{"class":164,"line":172},[162,1103,1104],{"class":168},"# — safer than setuid (grants only one capability, not all root powers)\n",[162,1106,1107,1109,1112,1115],{"class":164,"line":178},[162,1108,613],{"class":181},[162,1110,1111],{"class":189}," setcap",[162,1113,1114],{"class":189}," 'cap_net_bind_service+ep'",[162,1116,1117],{"class":189}," \u002Fusr\u002Fbin\u002Fmyapp\n",[162,1119,1120,1123,1126],{"class":164,"line":193},[162,1121,1122],{"class":181},"getcap",[162,1124,1125],{"class":189}," \u002Fusr\u002Fbin\u002Fmyapp",[162,1127,1128],{"class":168},"                    # verify\n",[162,1130,1131,1133,1135,1138,1140],{"class":164,"line":204},[162,1132,613],{"class":181},[162,1134,1111],{"class":189},[162,1136,1137],{"class":185}," -r",[162,1139,1125],{"class":189},[162,1141,1142],{"class":168},"            # remove\n",[162,1144,1145],{"class":164,"line":215},[162,1146,219],{"emptyLinePlaceholder":218},[162,1148,1149],{"class":164,"line":222},[162,1150,1151],{"class":168},"# Anti-Pattern: setuid root for the same purpose\n",[162,1153,1154],{"class":164,"line":228},[162,1155,1156],{"class":168},"# sudo chmod u+s \u002Fusr\u002Fbin\u002Fmyapp  → grants ALL root privileges (dangerous)\n",[14,1158,1159,1160,1163],{},"Capabilities are stored in the ",[47,1161,1162],{},"security.capability"," extended attribute.",[18,1165,1167,1170],{"id":1166},"chown-change-owner",[47,1168,1169],{},"chown"," — Change Owner",[152,1172,1173],{"language":154},[39,1174,1176],{"className":157,"code":1175,"language":154,"meta":45,"style":45},"sudo chown alice file          # change owner\nsudo chown alice:staff file    # change owner and group\nsudo chown :staff file         # change group only (or use chgrp)\nsudo chown -R alice:alice dir\u002F # recursive\n",[47,1177,1178,1192,1206,1220],{"__ignoreMap":45},[162,1179,1180,1182,1184,1187,1189],{"class":164,"line":165},[162,1181,613],{"class":181},[162,1183,626],{"class":189},[162,1185,1186],{"class":189}," alice",[162,1188,401],{"class":189},[162,1190,1191],{"class":168},"          # change owner\n",[162,1193,1194,1196,1198,1201,1203],{"class":164,"line":172},[162,1195,613],{"class":181},[162,1197,626],{"class":189},[162,1199,1200],{"class":189}," alice:staff",[162,1202,401],{"class":189},[162,1204,1205],{"class":168},"    # change owner and group\n",[162,1207,1208,1210,1212,1215,1217],{"class":164,"line":178},[162,1209,613],{"class":181},[162,1211,626],{"class":189},[162,1213,1214],{"class":189}," :staff",[162,1216,401],{"class":189},[162,1218,1219],{"class":168},"         # change group only (or use chgrp)\n",[162,1221,1222,1224,1226,1229,1232,1235],{"class":164,"line":193},[162,1223,613],{"class":181},[162,1225,626],{"class":189},[162,1227,1228],{"class":185}," -R",[162,1230,1231],{"class":189}," alice:alice",[162,1233,1234],{"class":189}," dir\u002F",[162,1236,1237],{"class":168}," # recursive\n",[14,1239,1240,1241,1244,1245,1247,1248,1251],{},"Only ",[26,1242,1243],{},"root"," can change the owner (",[47,1246,1169],{},"). A regular user can ",[47,1249,1250],{},"chgrp"," to a group they belong to.",[18,1253,1255],{"id":1254},"tips-tricks","💡 Tips & Tricks",[789,1257,1258,1280,1303,1332,1341],{},[792,1259,1260,1263,1264,1267,1268,1271,1272,1274,1275,1277,1278,37],{},[26,1261,1262],{},"Idiom",": use ",[47,1265,1266],{},"install -m 755 script \u002Fusr\u002Flocal\u002Fbin\u002F"," to copy + set permissions in one step — ",[47,1269,1270],{},"install"," sets the mode explicitly (ignores ",[47,1273,772],{},"), so the result is predictable. Better than ",[47,1276,1030],{}," + ",[47,1279,182],{},[792,1281,1282,1263,1284,1287,1288,1291,1292,1295,1296,1299,1300,1302],{},[26,1283,1262],{},[47,1285,1286],{},"chmod -R"," with symbolic modes, not octal — ",[47,1289,1290],{},"chmod -R g+rw dir"," adds group read\u002Fwrite without touching other bits. ",[47,1293,1294],{},"chmod -R 644 dir"," would remove execute from ",[784,1297,1298],{},"everything"," (including subdirs, breaking ",[47,1301,127],{},").",[792,1304,1305,1307,1308,1311,1312,1315,1316,1319,1320,1323,1324,1327,1328,1331],{},[26,1306,1262],{},": set ",[47,1309,1310],{},"umask 077"," for private systems and ",[47,1313,1314],{},"umask 027"," for shared — ",[47,1317,1318],{},"077"," makes all new files ",[47,1321,1322],{},"600","\u002F",[47,1325,1326],{},"700"," (only owner). ",[47,1329,1330],{},"027"," allows group read.",[792,1333,1334,1336,1337,1340],{},[26,1335,1262],{},": prefer file capabilities over setuid root — ",[47,1338,1339],{},"setcap cap_net_bind_service+ep .\u002Fserver"," lets a binary bind to port 80 without running as root.",[792,1342,1343,1263,1346,1349,1350,1352],{},[26,1344,1345],{},"Debug",[47,1347,1348],{},"namei -l \u002Fpath\u002Fto\u002Ffile"," to see permissions on each component of a path — reveals when a \"Permission denied\" is due to a parent directory lacking ",[47,1351,118],{},", not the file itself.",[18,1354,1356],{"id":1355},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[789,1358,1359,1380,1404,1428,1446,1458,1472],{},[792,1360,1361,1367,1368,1370,1371,1373,1374,1376,1377,1379],{},[26,1362,1363,1364,1366],{},"Directory ",[47,1365,118],{}," ≠ execute",": on directories, ",[47,1369,118],{}," is \"search\u002Ftraverse\" — you need it to ",[47,1372,127],{}," in or access files by path. ",[47,1375,82],{}," alone lets you list names but not access content. ",[47,1378,118],{}," alone lets you access known files but not list.",[792,1381,1382,1388,1389,1392,1393,1396,1397,1399,1400,1403],{},[26,1383,1384,1387],{},[47,1385,1386],{},"rm"," doesn't use the trash",": deletion is permanent. There's no undo. ",[47,1390,1391],{},"rm -rf $UNSET_VAR\u002F"," with ",[47,1394,1395],{},"set +u"," can delete ",[47,1398,1323],{},". Always ",[47,1401,1402],{},"set -u"," in scripts.",[792,1405,1406,1411,1412,1415,1416,1419,1420,1423,1424,1427],{},[26,1407,1408,1410],{},[47,1409,1030],{}," silently overwrites",": ",[47,1413,1414],{},"cp important.conf old.conf.bak"," — if ",[47,1417,1418],{},"old.conf.bak"," exists, it's replaced with no warning. Use ",[47,1421,1422],{},"cp -n"," (no-clobber) or ",[47,1425,1426],{},"cp -i"," (interactive).",[792,1429,1430,1411,1433,1435,1436,1439,1440,1443,1444,37],{},[26,1431,1432],{},"Symlink permissions are meaningless",[47,1434,182],{}," on a symlink changes the ",[784,1437,1438],{},"target's"," permissions (on Linux). Symlinks always show ",[47,1441,1442],{},"lrwxrwxrwx"," in ",[47,1445,1001],{},[792,1447,1448,1411,1451,1454,1455,1457],{},[26,1449,1450],{},"setuid on scripts is ignored (on Linux)",[47,1452,1453],{},"chmod u+s script.sh"," has no effect on shell scripts — the kernel ignores setuid on interpreted scripts (a security measure). Use ",[47,1456,613],{}," or a setuid C wrapper instead.",[792,1459,1460,1463,1464,1467,1468,1471],{},[26,1461,1462],{},"Deleting a file requires write on the directory, not the file",": a file with ",[47,1465,1466],{},"r--r--r--"," (no write for anyone) can be deleted if its directory is writable by the user. The sticky bit (",[47,1469,1470],{},"+t",") prevents deleting others' files in a shared dir.",[792,1473,1474,1411,1477,1480,1481,1484],{},[26,1475,1476],{},"Hard links to directories are forbidden (on most filesystems)",[47,1478,1479],{},"ln dir\u002F link"," fails — ext4 disallows it to avoid filesystem loops. Use ",[47,1482,1483],{},"ln -s"," (symlink) for directories.",[18,1486,1488],{"id":1487},"spot-the-bug","🧠 Spot the Bug",[14,1490,1491],{},"A team sets up a shared directory. They run:",[152,1493,1494],{"language":154},[39,1495,1497],{"className":157,"code":1496,"language":154,"meta":45,"style":45},"sudo mkdir \u002Fshared\nsudo chown :developers \u002Fshared\nsudo chmod 777 \u002Fshared\n",[47,1498,1499,1507,1517],{"__ignoreMap":45},[162,1500,1501,1503,1505],{"class":164,"line":165},[162,1502,613],{"class":181},[162,1504,616],{"class":189},[162,1506,619],{"class":189},[162,1508,1509,1511,1513,1515],{"class":164,"line":172},[162,1510,613],{"class":181},[162,1512,626],{"class":189},[162,1514,629],{"class":189},[162,1516,619],{"class":189},[162,1518,1519,1521,1523,1526],{"class":164,"line":178},[162,1520,613],{"class":181},[162,1522,638],{"class":189},[162,1524,1525],{"class":185}," 777",[162,1527,619],{"class":189},[14,1529,1530,1531,1534],{},"Alice creates ",[47,1532,1533],{},"\u002Fshared\u002Freport.txt",". Bob can read it but can't edit it. The team wanted all developers to edit each other's files. What's wrong, and what are two fixes?",[1536,1537,1538,1542,1584,1590,1611,1625,1634,1668,1680],"details",{},[1539,1540,1541],"summary",{},"Answer",[14,1543,1544,1545,1548,1549,1552,1553,1556,1557,1560,1561,1564,1565,1568,1569,1571,1572,1574,1575,1577,1578,1580,1581,1583],{},"The problem: files created in ",[47,1546,1547],{},"\u002Fshared"," are owned by the ",[26,1550,1551],{},"creator's primary group"," (e.g., ",[47,1554,1555],{},"alice",", ",[47,1558,1559],{},"bob","), not ",[47,1562,1563],{},"developers",". So Alice's file is ",[47,1566,1567],{},"alice:alice",", and Bob (not in the ",[47,1570,1555],{}," group) only has ",[26,1573,36],{}," permissions — typically ",[47,1576,82],{}," (from ",[47,1579,851],{}," → ",[47,1582,882],{},"). No group write for Bob.",[14,1585,1586,1589],{},[26,1587,1588],{},"Fix 1 — setgid directory"," (classic Unix way):",[152,1591,1592],{"language":154},[39,1593,1595],{"className":157,"code":1594,"language":154,"meta":45,"style":45},"sudo chmod 2770 \u002Fshared    # setgid + rwxrws---\n",[47,1596,1597],{"__ignoreMap":45},[162,1598,1599,1601,1603,1606,1608],{"class":164,"line":165},[162,1600,613],{"class":181},[162,1602,638],{"class":189},[162,1604,1605],{"class":185}," 2770",[162,1607,644],{"class":189},[162,1609,1610],{"class":168},"    # setgid + rwxrws---\n",[14,1612,1613,1614,1616,1617,1620,1621,1624],{},"Now new files inherit the ",[47,1615,1563],{}," group. Combined with ",[47,1618,1619],{},"umask 002"," (gives group write: ",[47,1622,1623],{},"664","), Bob can edit Alice's files.",[14,1626,1627,1630,1631,1633],{},[26,1628,1629],{},"Fix 2 — default ACL"," (more robust, doesn't depend on ",[47,1632,772],{},"):",[152,1635,1636],{"language":154},[39,1637,1639],{"className":157,"code":1638,"language":154,"meta":45,"style":45},"sudo setfacl -d -m g:developers:rw \u002Fshared\nsudo setfacl -m g:developers:rwx \u002Fshared\n",[47,1640,1641,1655],{"__ignoreMap":45},[162,1642,1643,1645,1647,1649,1651,1653],{"class":164,"line":165},[162,1644,613],{"class":181},[162,1646,664],{"class":189},[162,1648,667],{"class":185},[162,1650,670],{"class":185},[162,1652,673],{"class":189},[162,1654,619],{"class":189},[162,1656,1657,1659,1661,1663,1666],{"class":164,"line":172},[162,1658,613],{"class":181},[162,1660,664],{"class":189},[162,1662,670],{"class":185},[162,1664,1665],{"class":189}," g:developers:rwx",[162,1667,619],{"class":189},[14,1669,1670,1671,1674,1675,1677,1678,37],{},"New files automatically get ",[47,1672,1673],{},"group:developers:rw",", regardless of the creator's ",[47,1676,772],{},". This is the modern approach and works even if users keep ",[47,1679,851],{},[14,1681,1682,1683,1686],{},"The key insight: ",[26,1684,1685],{},"directory write permission lets you create\u002Fdelete files, but it doesn't grant write on files created by others"," — that depends on each file's own group and permissions.",[1688,1689,1690],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}",{"title":45,"searchDepth":172,"depth":172,"links":1692},[1693,1694,1695,1696,1704,1709,1712,1713,1715,1716,1717],{"id":20,"depth":172,"text":21},{"id":51,"depth":172,"text":52},{"id":259,"depth":172,"text":260},{"id":444,"depth":172,"text":445,"children":1697},[1698,1700,1702],{"id":449,"depth":178,"text":1699},"Setuid (4000) — Run as Owner",{"id":580,"depth":178,"text":1701},"Setgid (2000) — Inherit Group on Directories",{"id":678,"depth":178,"text":1703},"Sticky Bit (1000) — Restricted Deletion",{"id":769,"depth":172,"text":1705,"children":1706},"umask — Default Permissions",[1707],{"id":862,"depth":178,"text":1708},"Edge Case: umask Doesn't Add Execute",{"id":894,"depth":172,"text":895,"children":1710},[1711],{"id":1012,"depth":178,"text":1013},{"id":1079,"depth":172,"text":1080},{"id":1166,"depth":172,"text":1714},"chown — Change Owner",{"id":1254,"depth":172,"text":1255},{"id":1355,"depth":172,"text":1356},{"id":1487,"depth":172,"text":1488},"md",{},"\u002Flinux\u002F04-files-directories-permissions",{"title":5,"description":16},"linux\u002F04-files-directories-permissions","It4sYN0jgnPZqkvNq8DVn3CpRk1M_O9FAna9IvGoNes",1789140923305]