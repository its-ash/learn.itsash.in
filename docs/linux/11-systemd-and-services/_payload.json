"meta":39,"style":39},"# Complex Implementation: edit a unit file safely\nsudo systemctl edit nginx    # creates a drop-in override\n# (edit the file, save, quit)\nsudo systemctl daemon-reload  # CRITICAL: re-read unit files from disk\nsudo systemctl restart nginx  # now the changes take effect\n\n# Anti-Pattern: edit + restart WITHOUT daemon-reload\n# sudo systemctl edit nginx\n# sudo systemctl restart nginx   → systemd uses the CACHED (old) definition\n# Forgetting daemon-reload is the #1 systemd bug\n",[26,176,177,182,196,201,213,227,233,238,243,249],{"__ignoreMap":39},[43,178,179],{"class":45,"line":46},[43,180,181],{"class":49},"# Complex Implementation: edit a unit file safely\n",[43,183,184,186,188,191,193],{"class":45,"line":53},[43,185,57],{"class":56},[43,187,61],{"class":60},[43,189,190],{"class":60}," edit",[43,192,71],{"class":60},[43,194,195],{"class":49},"    # creates a drop-in override\n",[43,197,198],{"class":45,"line":77},[43,199,200],{"class":49},"# (edit the file, save, quit)\n",[43,202,203,205,207,210],{"class":45,"line":92},[43,204,57],{"class":56},[43,206,61],{"class":60},[43,208,209],{"class":60}," daemon-reload",[43,211,212],{"class":49},"  # CRITICAL: re-read unit files from disk\n",[43,214,215,217,219,222,224],{"class":45,"line":107},[43,216,57],{"class":56},[43,218,61],{"class":60},[43,220,221],{"class":60}," restart",[43,223,71],{"class":60},[43,225,226],{"class":49},"  # now the changes take effect\n",[43,228,229],{"class":45,"line":122},[43,230,232],{"emptyLinePlaceholder":231},true,"\n",[43,234,235],{"class":45,"line":137},[43,236,237],{"class":49},"# Anti-Pattern: edit + restart WITHOUT daemon-reload\n",[43,239,240],{"class":45,"line":151},[43,241,242],{"class":49},"# sudo systemctl edit nginx\n",[43,244,246],{"class":45,"line":245},9,[43,247,248],{"class":49},"# sudo systemctl restart nginx   → systemd uses the CACHED (old) definition\n",[43,250,252],{"class":45,"line":251},10,[43,253,254],{"class":49},"# Forgetting daemon-reload is the #1 systemd bug\n",[22,256,258],{"id":257},"unit-file-structure","Unit File Structure",[31,260,262],{"language":261},"ini",[35,263,266],{"className":264,"code":265,"language":261,"meta":39,"style":39},"language-ini shiki shiki-themes github-light github-dark","# \u002Fetc\u002Fsystemd\u002Fsystem\u002Fmyapp.service\n[Unit]\nDescription=My Web Application\nAfter=network.target\nWants=network-online.target\n\n[Service]\nType=simple\nUser=appuser\nGroup=appuser\nWorkingDirectory=\u002Fopt\u002Fmyapp\nEnvironment=NODE_ENV=production\nEnvironmentFile=\u002Fetc\u002Fmyapp\u002Fenv\nExecStart=\u002Fusr\u002Fbin\u002Fnode \u002Fopt\u002Fmyapp\u002Fserver.js\nRestart=on-failure\nRestartSec=5\nTimeoutStopSec=30\n\n[Install]\nWantedBy=multi-user.target\n",[26,267,268,273,278,288,296,304,308,313,321,329,336,345,360,369,378,387,396,405,410,416],{"__ignoreMap":39},[43,269,270],{"class":45,"line":46},[43,271,272],{"class":49},"# \u002Fetc\u002Fsystemd\u002Fsystem\u002Fmyapp.service\n",[43,274,275],{"class":45,"line":53},[43,276,277],{"class":56},"[Unit]\n",[43,279,280,284],{"class":45,"line":77},[43,281,283],{"class":282},"svdQ7","Description",[43,285,287],{"class":286},"ssxIu","=My Web Application\n",[43,289,290,293],{"class":45,"line":92},[43,291,292],{"class":282},"After",[43,294,295],{"class":286},"=network.target\n",[43,297,298,301],{"class":45,"line":107},[43,299,300],{"class":282},"Wants",[43,302,303],{"class":286},"=network-online.target\n",[43,305,306],{"class":45,"line":122},[43,307,232],{"emptyLinePlaceholder":231},[43,309,310],{"class":45,"line":137},[43,311,312],{"class":56},"[Service]\n",[43,314,315,318],{"class":45,"line":151},[43,316,317],{"class":282},"Type",[43,319,320],{"class":286},"=simple\n",[43,322,323,326],{"class":45,"line":245},[43,324,325],{"class":282},"User",[43,327,328],{"class":286},"=appuser\n",[43,330,331,334],{"class":45,"line":251},[43,332,333],{"class":282},"Group",[43,335,328],{"class":286},[43,337,339,342],{"class":45,"line":338},11,[43,3