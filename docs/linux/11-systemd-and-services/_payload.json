1343],{"class":286},"MemoryMax",[43,1345,353],{"class":282},[43,1347,1348],{"class":60},"512M",[43,1350,1351],{"class":49},"            # hard memory limit (OOM-kill if exceeded)\n",[43,1353,1354,1357,1359,1362],{"class":45,"line":107},[43,1355,1356],{"class":286},"MemoryHigh",[43,1358,353],{"class":282},[43,1360,1361],{"class":60},"400M",[43,1363,1364],{"class":49},"           # soft limit (throttle, don't kill)\n",[43,1366,1367,1370,1372,1375],{"class":45,"line":122},[43,1368,1369],{"class":286},"TasksMax",[43,1371,353],{"class":282},[43,1373,1374],{"class":60},"100",[43,1376,1377],{"class":49},"              # max PIDs\n",[43,1379,1380,1383,1385,1387],{"class":45,"line":137},[43,1381,1382],{"class":286},"IOWeight",[43,1384,353],{"class":282},[43,1386,1374],{"class":60},[43,1388,1389],{"class":49},"              # I\u002FO weight (1-10000, default 100)\n",[43,1391,1392],{"class":45,"line":151},[43,1393,232],{"emptyLinePlaceholder":231},[43,1395,1396],{"class":45,"line":245},[43,1397,1398],{"class":49},"# Ad-hoc:\n",[43,1400,1401,1403,1406,1409,1412,1415,1418,1421],{"class":45,"line":251},[43,1402,57],{"class":56},[43,1404,1405],{"class":60}," systemd-run",[43,1407,1408],{"class":67}," --unit=test",[43,1410,1411],{"class":67}," --CPUQuota=25%",[43,1413,1414],{"class":67}," --MemoryMax=256M",[43,1416,1417],{"class":60}," stress",[43,1419,1420],{"class":67}," --cpu",[43,1422,1423],{"class":67}," 4\n",[22,1425,1427],{"id":1426},"tips-tricks","💡 Tips & Tricks",[516,1429,1430,1440,1448,1467,1478,1486,1498,1507],{},[519,1431,1432,1435,1436,1439],{},[17,1433,1434],{},"Idiom",": use ",[26,1437,1438],{},"systemctl enable --now \u003Cservice>"," — enables (boot) and starts (now) in one command.",[519,1441,1442,1435,1444,1447],{},[17,1443,1434],{},[26,1445,1446],{},"systemctl status \u003Cservice>"," as your first debug step — shows if the service is active, the main PID, recent log lines, and the cgroup.",[519,1449,1450,1435,1452,1455,1456,1459,1460,1462,1463,1466],{},[17,1451,1434],{},[26,1453,1454],{},"systemctl edit \u003Cservice>"," for overrides (never edit ",[26,1457,1458],{},"\u002Fusr\u002Flib\u002Fsystemd\u002Fsystem\u002F",") — creates a drop-in. Safe across package updates. Always ",[26,1461,168],{}," + ",[26,1464,1465],{},"restart"," after.",[519,1468,1469,1435,1471,1474,1475,477],{},[17,1470,1434],{},[26,1472,1473],{},"journalctl -u \u003Cservice> -f"," for live log tailing — replaces ",[26,1476,1477],{},"tail -f \u002Fvar\u002Flog\u002Ffoo.log",[519,1479,1480,1435,1482,1485],{},[17,1481,1434],{},[26,1483,1484],{},"journalctl -b -p err"," to find boot errors — shows only the current boot and error priority.",[519,1487,1488,1490,1491,1494,1495,1497],{},[17,1489,1434],{},": run ",[26,1492,1493],{},"systemctl daemon-reload"," after editing any unit file — systemd caches unit files; ",[26,1496,168],{}," re-reads them. Forgetting this is the #1 systemd gotcha.",[519,1499,1500,1435,1503,1506],{},[17,1501,1502],{},"Debug",[26,1504,1505],{},"systemd-analyze blame"," to find slow-booting services — lists services by startup time.",[519,1508,1509,1435,1511,1514,1515,1518],{},[17,1510,1502],{},[26,1512,1513],{},"journalctl -b -1"," to see the ",[17,1516,1517],{},"previous"," boot's logs — essential when a reboot fixed (or caused) an issue.",[22,1520,1522],{"id":1521},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[516,1524,1525,1540,1563,1578,1597,1610,1630],{},[519,1526,1527,1533,1534,1536,1537,1539],{},[17,1528,1529,1530,1532],{},"Forgetting ",[26,1531,168],{}," after editing a unit",": systemd caches unit files in memory. After editing, you MUST run ",[26,1535,1493],{}," before ",[26,1538,1465],{},". Otherwise systemd runs the old version. This is the #1 systemd bug.",[519,1541,1542,1549,1550,1552,1553,1555,1556,1559,1560,477],{},[17,1543,1544,511,1546],{},[26,1545,1465],{},[26,1547,1548],{},"reload",": ",[26,1551,1465],{}," stops and starts (downtime). ",[26,1554,1548],{}," sends the reload signal (often SIGHUP) without stopping (no downtime, if supported). Not all services support reload — check ",[26,1557,1558],{},"systemctl cat"," for ",[26,1561,1562],{},"ExecReload=",[519,1564,1565,1573,1574,1577],{},[17,1566,1567,1570,1571],{},[26,1568,1569],{},"Type=forking"," needs ",[26,1572,476],{},": without it, systemd may think the service died (the parent exited) and kill the children. Use ",[26,1575,1576],{},"Type=simple"," for apps that run in the foreground (preferred).",[519,1579,1580,1549,1583,1586,1587,1590,1591,1593,1594,477],{},[17,1581,1582],{},"Drop-in overrides merge, they don't replace",[26,1584,1585],{},"ExecStart="," in a drop-in ",[17,1588,1589],{},"adds"," to the original (you get two ExecStart lines, which errors). To replace, clear first: ",[26,1592,1585],{}," (empty) then ",[26,1595,1596],{},"ExecStart=\u002Fnew\u002Fcommand",[519,1598,1599,1549,1602,1605,1606,1609],{},[17,1600,1601],{},"User services stop at logout",[26,1603,1604],{},"systemctl --user"," services stop when the user's session ends, unless ",[26,1607,1608],{},"loginctl enable-linger \u003Cuser>"," is set.",[519,1611,1612,1615,1616,1619,1620,1623,1624,1626,1627,477],{},[17,1613,1614],{},"journald logs are lost on reboot by default",": if ",[26,1617,1618],{},"\u002Fvar\u002Flog\u002Fjournal\u002F"," doesn't exist, logs are in ",[26,1621,1622],{},"\u002Frun\u002Flog\u002Fjournal\u002F"," (RAM, volatile). Create ",[26,1625,1618],{}," or set ",[26,1628,1629],{},"Storage=persistent",[519,1631,1632,1549,1635,1638,1639,1642,1643,477],{},[17,1633,1634],{},"Masking prevents all starts",[26,1636,1637],{},"systemctl mask nginx"," makes it impossible to start nginx (even manually) — it links the unit to ",[26,1640,1641],{},"\u002Fdev\u002Fnull",". Undo with ",[26,1644,1645],{},"unmask",[22,1647,1649],{"id":1648},"spot-the-bug","🧠 Spot the Bug",[14,1651,1652,1653,555],{},"An admin edits the nginx service to add an environment variable. They create ",[26,1654,1655],{},"\u002Fetc\u002Fsystemd\u002Fsystem\u002Fnginx.service.d\u002Foverride.conf",[31,1657,1658],{"language":261},[35,1659,1661],{"className":264,"code":1660,"language":261,"meta":39,"style":39},"[Service]\nEnvironment=NGINX_WORKERS=8\nExecStart=\u002Fusr\u002Fsbin\u002Fnginx -g 'daemon off;' --with-debug\n",[26,1662,1663,1667,1679],{"__ignoreMap":39},[43,1664,1665],{"class":45,"line":46},[43,1666,312],{"class":56},[43,1668,1669,1671,1673,1676],{"class":45,"line":53},[43,1670,350],{"class":282},[43,1672,353],{"class":286},[43,1674,1675],{"class":282},"NGINX_WORKERS",[43,1677,1678],{"class":286},"=8\n",[43,1680,1681,1683,1686,1689],{"class":45,"line":77},[43,1682,374],{"class":282},[43,1684,1685],{"class":286},"=\u002Fusr\u002Fsbin\u002Fnginx -g ",[43,1687,1688],{"class":60},"'daemon off;'",[43,1690,1691],{"class":286}," --with-debug\n",[14,1693,1694,1695,1698,1699,1702,1703,1705,1706,1709],{},"They run ",[26,1696,1697],{},"sudo systemctl restart nginx",", but ",[26,1700,1701],{},"systemctl status nginx"," shows the original ",[26,1704,374],{}," (without ",[26,1707,1708],{},"--with-debug",") and the service fails. What happened?",[1711,1712,1713,1717,1720,1758,1763,1786,1831,1867],"details",{},[1714,1715,1716],"summary",{},"Answer",[14,1718,1719],{},"Two issues:",[1721,1722,1723,1735],"ol",{},[519,1724,1725,1730,1731,1734],{},[17,1726,1727,1728,477],{},"Missing ",[26,1729,168],{}," After creating a drop-in, you must run ",[26,1732,1733],{},"sudo systemctl daemon-reload"," before restarting. Without it, systemd uses the cached (old) unit definition. The drop-in wasn't read.",[519,1736,1737,1742,1743,1746,1747,1750,1751,1754,1755,1757],{},[17,1738,1739,1741],{},[26,1740,374],{}," in a drop-in adds, not replaces."," The original unit has ",[26,1744,1745],{},"ExecStart=\u002Fusr\u002Fsbin\u002Fnginx -g 'daemon off;'",". The drop-in adds ",[26,1748,1749],{},"ExecStart=... --with-debug",". Now there are ",[17,1752,1753],{},"two"," ",[26,1756,374],{}," lines — systemd errors (\"ExecStart has multiple lines\") and fails.",[14,1759,1760],{},[17,1761,1762],{},"Fix:",[31,1764,1765],{"language":33},[35,1766,1768],{"className":37,"code":1767,"language":33,"meta":39,"style":39},"# First, clear ExecStart, then set the new one:\nsudo systemctl edit nginx\n",[26,1769,1770,1775],{"__ignoreMap":39},[43,1771,1772],{"class":45,"line":46},[43,1773,1774],{"class":49},"# First, clear ExecStart, then set the new one:\n",[43,1776,1777,1779,1781,1783],{"class":45,"line":53},[43,1778,57],{"class":56},[43,1780,61],{"class":60},[43,1782,190],{"class":60},[43,1784,1785],{"class":60}," nginx\n",[31,1787,1788],{"language":261},[35,1789,1791],{"className":264,"code":1790,"language":261,"meta":39,"style":39},"[Service]\nEnvironment=NGINX_WORKERS=8\nExecStart=                                              # clear the original\nExecStart=\u002Fusr\u002Fsbin\u002Fnginx -g 'daemon off;' --with-debug  # set the new one\n",[26,1792,1793,1797,1807,1817],{"__ignoreMap":39},[43,1794,1795],{"class":45,"line":46},[43,1796,312],{"class":56},[43,1798,1799,1801,1803,1805],{"class":45,"line":53},[43,1800,350],{"class":282},[43,1802,353],{"class":286},[43,1804,1675],{"class":282},[43,1806,1678],{"class":286},[43,1808,1809,1811,1814],{"class":45,"line":77},[43,1810,374],{"class":282},[43,1812,1813],{"class":286},"=                                              ",[43,1815,1816],{"class":49},"# clear the original\n",[43,1818,1819,1821,1823,1825,1828],{"class":45,"line":92},[43,1820,374],{"class":282},[43,1822,1685],{"class":286},[43,1824,1688],{"class":60},[43,1826,1827],{"class":286}," --with-debug  ",[43,1829,1830],{"class":49},"# set the new one\n",[31,1832,1833],{"language":33},[35,1834,1836],{"className":37,"code":1835,"language":33,"meta":39,"style":39},"sudo systemctl daemon-reload\nsudo systemctl restart nginx\nsystemctl cat nginx    # verify the merged result\n",[26,1837,1838,1846,1856],{"__ignoreMap":39},[43,1839,1840,1842,1844],{"class":45,"line":46},[43,1841,57],{"class":56},[43,1843,61],{"class":60},[43,1845,857],{"class":60},[43,1847,1848,1850,1852,1854],{"class":45,"line":53},[43,1849,57],{"class":56},[43,1851,61],{"class":60},[43,1853,221],{"class":60},[43,1855,1785],{"class":60},[43,1857,1858,1860,1862,1864],{"class":45,"line":77},[43,1859,28],{"class":56},[43,1861,156],{"class":60},[43,1863,71],{"class":60},[43,1865,1866],{"class":49},"    # verify the merged result\n",[14,1868,1869,1870,1872,1873,1875,1876,1879],{},"The empty ",[26,1871,1585],{}," line clears the list; the next ",[26,1874,1585],{}," sets the new command. Same applies to ",[26,1877,1878],{},"Environment="," and other list-type keys.",[1881,1882,1883],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}",{"title":39,"searchDepth":53,"depth":53,"links":1885},[1886,1891,1897,1900,1901,1905,1909,1910,1911,1912],{"id":24,"depth":53,"text":1887,"children":1888},"systemctl — The Main Interface",[1889],{"id":165,"depth":77,"text":1890},"daemon-reload — The #1 systemd Gotcha",{"id":257,"depth":53,"text":258,"children":1892},[1893,1895],{"id":427,"depth":77,"text":1894},"Type= Is Critical",{"id":507,"depth":77,"text":1896},"After= vs Requires=",{"id":543,"depth":53,"text":544,"children":1898},[1899],{"id":611,"depth":77,"text":612},{"id":664,"depth":53,"text":665},{"id":892,"depth":53,"text":1902,"children":1903},"journalctl — The Log Viewer",[1904],{"id":1035,"depth":77,"text":1036},{"id":1104,"depth":53,"text":1105,"children":1906},[1907],{"id":1278,"depth":77,"text":1908},"Edge Case: OnCalendar=daily Is Midnight",{"id":1308,"depth":53,"text":1309},{"id":1426,"depth":53,"text":1427},{"id":1521,"depth":53,"text":1522},{"id":1648,"depth":53,"text":1649},"systemd is the init system and service manager on virtually every modern Linux distribution. It starts at boot (PID 1), launches all other services, monitors them, manages logging, networking, timers, and more. This chapter covers unit management, drop-in overrides, timers, resource limits, and the gotchas that cause service failures.","md",{},"\u002Flinux\u002F11-systemd-and-services",{"title":5,"description":1913},"linux\u002F11-systemd-and-services","4G5LpokjaGnnI52t8VaaPSl6mFxBkox3QV-_zAYTi4k",1789747015604]