72,1534,1474],{},[18,1536,1537],{},"dig +short"," for just the IP — ",[18,1540,1541],{},"dig +short example.com"," gives ",[18,1544,1545],{},"93.184.216.34"," (no headers, no metadata).",[158,1548,1549,1475,1552,1478,1554,1557,1558,1560,1561,1563],{},[1472,1550,1551],{},"Debug",[18,1553,524],{},[18,1555,1556],{},"traceroute",") for live route diagnosis — ",[18,1559,524],{}," updates continuously, showing packet loss per hop. ",[18,1562,1556],{}," is one-shot.",[38,1565,1567],{"id":1566},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[155,1569,1570,1576,1607,1622,1640,1669,1680],{},[158,1571,1572,1575],{},[1472,1573,1574],{},"\"Connection refused\" vs \"Connection timed out\"",": refused = something is listening but refused you (port closed, or firewall REJECT). Timed out = nothing responded (firewall DROP, or network issue). The distinction matters for diagnosis.",[158,1577,1578,330,1584,1586,1587,330,1590,1593,1594,1596,1597,1599,1600,1602,1603,1606],{},[1472,1579,1580,1583],{},[18,1581,1582],{},"\u002Fetc\u002Fhosts"," overrides DNS",[18,1585,1582],{}," is checked before DNS (controlled by ",[18,1588,1589],{},"nsswitch.conf",[18,1591,1592],{},"hosts: files dns","). A stale entry in ",[18,1595,1582],{}," can silently override the correct DNS record. ",[18,1598,605],{}," bypasses ",[18,1601,1582],{},"; ",[18,1604,1605],{},"getent hosts"," respects it.",[158,1608,1609,1614,1615,1618,1619,1621],{},[1472,1610,1611,1613],{},[18,1612,661],{}," is often auto-generated",": on systemd-resolved or NetworkManager systems, editing ",[18,1616,1617],{},"\u002Fetc\u002Fresolv.conf"," directly is overwritten on reboot. Use ",[18,1620,684],{}," or edit Netplan\u002FNetworkManager config.",[158,1623,1624,330,1629,1632,1633,1635,1636,1639],{},[1472,1625,1626,1628],{},[18,1627,1082],{}," can't do remote-to-remote",[18,1630,1631],{},"scp alice@server1:file alice@server2:file"," doesn't work directly — it tries to copy from server1 to your local machine then to server2. Use ",[18,1634,35],{}," or ",[18,1637,1638],{},"ssh alice@server1 \"scp file alice@server2:file\"",".",[158,1641,1642,330,1647,1650,1651,1655,1656,1659,1660,1663,1664,1666,1667,36],{},[1472,1643,1644,1646],{},[18,1645,35],{}," trailing slash matters",[18,1648,1649],{},"rsync dir\u002F dest\u002F"," copies the ",[1652,1653,1654],"em",{},"contents"," of ",[18,1657,1658],{},"dir",". ",[18,1661,1662],{},"rsync dir dest\u002F"," copies ",[18,1665,1658],{}," itself. Always dry-run first (",[18,1668,818],{},[158,1670,1671,1674,1675,1635,1677,1639],{},[1472,1672,1673],{},"Firewall can block ICMP (ping)",": a failed ping doesn't always mean the host is down. Try ",[18,1676,28],{},[18,1678,1679],{},"nc -zv host port",[158,1681,1682,330,1687,1690,1691,1639],{},[1472,1683,1684,1685],{},"Port conflicts on ",[18,1686,822],{},[18,1688,1689],{},"-p 8080:80"," fails if host port 8080 is already in use. Check with ",[18,1692,1693],{},"ss -tlnp | grep 8080",[38,1695,1697],{"id":1696},"spot-the-bug","🧠 Spot the Bug",[14,1699,1700],{},"An admin wants to test if a web server is reachable, but this command hangs for 60 seconds:",[57,1702,1703],{"language":59},[43,1704,1706],{"className":62,"code":1705,"language":59,"meta":49,"style":49},"curl http:\u002F\u002Finternal-server:80\u002F\n",[18,1707,1708],{"__ignoreMap":49},[67,1709,1710,1712],{"class":69,"line":70},[67,1711,28],{"class":80},[67,1713,1714],{"class":87}," http:\u002F\u002Finternal-server:80\u002F\n",[14,1716,1717,1720,1721,1724],{},[18,1718,1719],{},"ping internal-server"," works. ",[18,1722,1723],{},"dig internal-server"," returns the correct IP. What's likely wrong, and what should they check?",[1726,1727,1728,1732,1735,1771,1843],"details",{},[1729,1730,1731],"summary",{},"Answer",[14,1733,1734],{},"\"Connection timed out\" (curl hanging) + \"ping works\" means the host is reachable at the network layer (ICMP) but the TCP port (80) is not responding. Likely causes:",[1736,1737,1738,1753,1762],"ol",{},[158,1739,1740,1743,1744,1635,1747,1635,1750,1639],{},[1472,1741,1742],{},"Firewall is DROPping port 80"," (DROP = no response, hangs until timeout; REJECT = immediate \"connection refused\"). Check: ",[18,1745,1746],{},"sudo ufw status",[18,1748,1749],{},"sudo firewall-cmd --list-all",[18,1751,1752],{},"sudo iptables -L -n",[158,1754,1755,1758,1759,1639],{},[1472,1756,1757],{},"The web server isn't running"," and the firewall is set to DROP (not REJECT) — so instead of \"connection refused,\" it hangs. Check: ",[18,1760,1761],{},"ss -tlnp | grep :80",[158,1763,1764,1767,1768,1639],{},[1472,1765,1766],{},"A firewall on the path"," (not the server itself) is blocking port 80. Check: ",[18,1769,1770],{},"mtr --tcp --port 80 internal-server",[57,1772,1773],{"language":59},[43,1774,1776],{"className":62,"code":1775,"language":59,"meta":49,"style":49},"# Diagnostic flow:\nss -tlnp | grep :80               # is the server listening?\nnc -zv internal-server 80         # is the port open? (gives clearer error than curl)\nsudo iptables -L -n              # local firewall rules\nmtr --tcp --port 80 internal-server  # path diagnostic\n",[18,1777,1778,1783,1798,1812,1826],{"__ignoreMap":49},[67,1779,1780],{"class":69,"line":70},[67,1781,1782],{"class":73},"# Diagnostic flow:\n",[67,1784,1785,1787,1789,1791,1793,1795],{"class":69,"line":77},[67,1786,24],{"class":80},[67,1788,113],{"class":83},[67,1790,591],{"class":590},[67,1792,594],{"class":80},[67,1794,744],{"class":87},[67,1796,1797],{"class":73},"               # is the server listening?\n",[67,1799,1800,1802,1804,1807,1809],{"class":69,"line":97},[67,1801,1390],{"class":80},[67,1803,1393],{"class":83},[67,1805,1806],{"class":87}," internal-server",[67,1808,1398],{"class":83},[67,1810,1811],{"class":73},"         # is the port open? (gives clearer error than curl)\n",[67,1813,1814,1816,1819,1821,1823],{"class":69,"line":108},[67,1815,224],{"class":80},[67,1817,1818],{"class":87}," iptables",[67,1820,998],{"class":83},[67,1822,1420],{"class":83},[67,1824,1825],{"class":73},"              # local firewall rules\n",[67,1827,1828,1830,1833,1836,1838,1840],{"class":69,"line":119},[67,1829,524],{"class":80},[67,1831,1832],{"class":83}," --tcp",[67,1834,1835],{"class":83}," --port",[67,1837,1398],{"class":83},[67,1839,1806],{"class":87},[67,1841,1842],{"class":73},"  # path diagnostic\n",[14,1844,1845,1846],{},"The key insight: ",[1472,1847,1848],{},"\"connection refused\" (fast) vs \"connection timed out\" (slow) tells you whether the firewall is REJECTing or DROPping, and whether anything is listening at all.",[1850,1851,1852],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sk71V, html code.shiki .sk71V{--shiki-default:#22863A;--shiki-github-dark:#85E89D}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}",{"title":49,"searchDepth":77,"depth":77,"links":1854},[1855,1856,1860,1861,1865,1867,1869,1870,1872,1875,1876,1877,1878],{"id":40,"depth":77,"text":41},{"id":54,"depth":77,"text":55,"children":1857},[1858,1859],{"id":211,"depth":97,"text":212},{"id":299,"depth":97,"text":300},{"id":472,"depth":77,"text":473},{"id":546,"depth":77,"text":547,"children":1862},[1863],{"id":657,"depth":97,"text":1864},"Edge Case: resolv.conf Is Often Auto-Generated",{"id":712,"depth":77,"text":1866},"Sockets — ss (Replaces netstat)",{"id":826,"depth":77,"text":1868},"HTTP — curl",{"id":956,"depth":77,"text":957},{"id":1076,"depth":77,"text":1871},"rsync (Preferred over scp)",{"id":1188,"depth":77,"text":1189,"children":1873},[1874],{"id":1300,"depth":97,"text":1301},{"id":1347,"depth":77,"text":1348},{"id":1465,"depth":77,"text":1466},{"id":1566,"depth":77,"text":1567},{"id":1696,"depth":77,"text":1697},"Networking is how your Linux box talks to other machines — via TCP\u002FIP, DNS, HTTP, SSH. This chapter covers the network stack, interface configuration (ip), routing, DNS, sockets (ss), and the everyday tools (curl, ssh, rsync).","md",{},"\u002Flinux\u002F10-networking-fundamentals",{"title":5,"description":1879},"linux\u002F10-networking-fundamentals","e3YS8OazUSj7wgYPNFWjUdxBpOv2itUSsK_LPb1Yxgs",1789140923494]