62],{"class":80,"line":138},[78,553,29],{"class":97},[78,555,461],{"class":100},[78,557,264],{"class":100},[78,559,108],{"class":107},[78,561,132],{"class":97},[78,563,564],{"class":84},"       # verify output, then apply with -i.bak\n",[78,566,567],{"class":80,"line":144},[78,568,396],{"emptyLinePlaceholder":395},[78,570,571],{"class":80,"line":239},[78,572,573],{"class":84},"# Anti-Pattern: sed -i without backup (no undo if regex is wrong)\n",[78,575,576],{"class":80,"line":253},[78,577,578],{"class":84},"# sed -i 's\u002Fold\u002Fnew\u002Fg' file         → if wrong, file is corrupted\n",[362,580,582,583,585],{"id":581},"edge-case-sed-regex-is-bre-by-default","Edge Case: ",[23,584,29],{}," Regex is BRE by Default",[66,587,588],{"language":68},[70,589,591],{"className":72,"code":590,"language":68,"meta":74,"style":74},"# NAIVE: sed 's\u002Fa+\u002Fb\u002Fg' replaces literal \"a+\" (BRE — + is literal)\n# PRODUCTION: sed -E 's\u002Fa+\u002Fb\u002Fg' replaces \"one or more a\" (ERE)\nsed -E 's\u002Fa+\u002Fb\u002Fg' file              # ERE (extended regex)\n",[23,592,593,598,603],{"__ignoreMap":74},[78,594,595],{"class":80,"line":81},[78,596,597],{"class":84},"# NAIVE: sed 's\u002Fa+\u002Fb\u002Fg' replaces literal \"a+\" (BRE — + is literal)\n",[78,599,600],{"class":80,"line":88},[78,601,602],{"class":84},"# PRODUCTION: sed -E 's\u002Fa+\u002Fb\u002Fg' replaces \"one or more a\" (ERE)\n",[78,604,605,607,609,612,614],{"class":80,"line":94},[78,606,29],{"class":97},[78,608,258],{"class":119},[78,610,611],{"class":100}," 's\u002Fa+\u002Fb\u002Fg'",[78,613,264],{"class":100},[78,615,616],{"class":84},"              # ERE (extended regex)\n",[50,618,620,622],{"id":619},"awk-field-processing",[23,621,32],{}," — Field Processing",[14,624,625,627,628,26,631,634,635,638],{},[23,626,32],{}," is a full programming language for column-based text processing. It auto-splits each line into fields (",[23,629,630],{},"$1",[23,632,633],{},"$2",", ..., ",[23,636,637],{},"$0"," = whole line). Default field separator is whitespace.",[362,640,642],{"id":641},"complex-implementation-log-analysis-with-awk","Complex Implementation: Log Analysis with awk",[66,644,645],{"language":68},[70,646,648],{"className":72,"code":647,"language":68,"meta":74,"style":74},"# Sum HTTP status codes from an access log\nawk -F'\"' '{print $3}' access.log | awk '{print $1}' | sort | uniq -c | sort -rn\n#  1243 200\n#   872 404\n#    15 500\n\n# Top 10 requesting IPs with their request counts\nawk '{print $1}' access.log | sort | uniq -c | sort -rn | head -10\n\n# Total bandwidth (bytes transferred = field 10 in Common Log Format)\nawk '{sum += $10} END{printf \"Total: %.2f MB\\n\", sum\u002F1024\u002F1024}' access.log\n\n# Users with bash shell (field 7 in \u002Fetc\u002Fpasswd)\nawk -F: '$7 ~ \u002Fbash$\u002F {print $1}' \u002Fetc\u002Fpasswd\n\n# Average of column 2\nawk '{sum += $2} END{print sum\u002FNR}' file\n",[23,649,650,655,694,699,704,709,713,718,748,752,757,767,771,777,791,796,802],{"__ignoreMap":74},[78,651,652],{"class":80,"line":81},[78,653,654],{"class":84},"# Sum HTTP status codes from an access log\n",[78,656,657,659,662,665,668,670,672,675,677,679,681,683,685,687,689,691],{"class":80,"line":88},[78,658,32],{"class":97},[78,660,661],{"class":119}," -F",[78,663,664],{"class":100},"'\"'",[78,666,667],{"class":100}," '{print $3}'",[78,669,357],{"class":100},[78,671,108],{"class":107},[78,673,674],{"class":97}," awk",[78,676,101],{"class":100},[78,678,108],{"class":107},[78,680,111],{"class":97},[78,682,108],{"class":107},[78,684,116],{"class":97},[78,686,120],{"class":119},[78,688,108],{"class":107},[78,690,111],{"class":97},[78,692,693],{"class":119}," -rn\n",[78,695,696],{"class":80,"line":94},[78,697,698],{"class":84},"#  1243 200\n",[78,700,701],{"class":80,"line":138},[78,702,703],{"class":84},"#   872 404\n",[78,705,706],{"class":80,"line":144},[78,707,708],{"class":84},"#    15 500\n",[78,710,711],{"class":80,"line":239},[78,712,396],{"emptyLinePlac