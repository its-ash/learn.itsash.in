454],{},"sort | uniq -c | sort -rn"," as a frequency counter — the most reused pipeline in Linux. Counts how many times each line appears, sorted by frequency.",[1446,1457,1458,1451,1460,1463,1464,1467],{},[18,1459,1450],{},[23,1461,1462],{},"awk '{print $NF}'"," for the last field — ",[23,1465,1466],{},"$NF"," is \"field number NF\" (the count), so it's always the last field regardless of how many fields the line has.",[1446,1469,1470,1451,1472,1475,1476,1479,1480,1483],{},[18,1471,1450],{},[23,1473,1474],{},"tail -F"," (capital) instead of ",[23,1477,1478],{},"tail -f"," for log watching — ",[23,1481,1482],{},"-F"," handles log rotation (re-opens if the file is moved\u002Frecreated).",[1446,1485,1486,1451,1488,1491,1492,1494,1495,1498,1499,1502],{},[18,1487,1450],{},[23,1489,1490],{},"grep -E"," for readability over ",[23,1493,25],{}," with backslashes — ",[23,1496,1497],{},"grep -E \"cat|dog\""," is clearer than ",[23,1500,1501],{},"grep \"cat\\|dog\"",".",[1446,1504,1505,1508,1509,1511,1512,1514,1515,1517,1518,1520],{},[18,1506,1507],{},"Performance",": ",[23,1510,25],{}," is faster than ",[23,1513,32],{}," for plain matching — use ",[23,1516,25],{}," for filtering, ",[23,1519,32],{}," when you need field logic.",[1446,1522,1523,1508,1525,1528,1529,1532,1533,1536],{},[18,1524,1507],{},[23,1526,1527],{},"sort -S 50% --parallel=4"," speeds up large sorts — ",[23,1530,1531],{},"-S"," sets buffer size (50% of RAM), ",[23,1534,1535],{},"--parallel"," uses multiple cores.",[50,1538,1540],{"id":1539},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1443,1542,1543,1560,1579,1601,1618,1638,1659,1675],{},[1446,1544,1545,1508,1550,1553,1554,1556,1557,1559],{},[18,1546,1547,1549],{},[23,1548,41],{}," only removes adjacent duplicates",[23,1551,1552],{},"echo -e \"a\\nb\\na\" | uniq"," outputs all three lines. Always ",[23,1555,38],{}," before ",[23,1558,41],{}," unless you specifically want adjacent-only dedup.",[1446,1561,1562,1508,1568,1571,1572,1575,1576,1502],{},[18,1563,1564,1567],{},[23,1565,1566],{},"sed -i"," has no undo",[23,1569,1570],{},"sed -i 's\u002Fold\u002Fnew\u002Fg' file"," overwrites the file. If your regex is wrong, the file is corrupted. Always test without ",[23,1573,1574],{},"-i"," first, or use ",[23,1577,1578],{},"sed -i.bak",[1446,1580,1581,1508,1586,1589,1590,1593,1594,1597,1598,1502],{},[18,1582,1583,1584],{},"Filenames with spaces break ",[23,1585,47],{},[23,1587,1588],{},"find . -name \"*.txt\" | xargs grep foo"," fails on ",[23,1591,1592],{},"my notes.txt",". Use ",[23,1595,1596],{},"find -print0 | xargs -0"," or ",[23,1599,1600],{},"find -exec {} +",[1446,1602,1603,1508,1608,1610,1611,1614,1615,1502],{},[18,1604,1605,1607],{},[23,1606,38],{}," is locale-aware",[23,1609,38],{}," uses your locale (",[23,1612,1613],{},"LC_COLLATE","). For byte-order sorting (consistent across systems), use ",[23,1616,1617],{},"LC_ALL=C sort",[1446,1619,1620,1629,1630,1632,1633,1635,1636,1502],{},[18,1621,1622,1625,1626],{},[23,1623,1624],{},"grep -r"," vs ",[23,1627,1628],{},"-R",": GNU ",[23,1631,1624],{}," does NOT follow symlinks; ",[23,1634,1628],{}," does. Watch for symlink loops with ",[23,1637,1628],{},[1446,1639,1640,1508,1645,1648,1649,1651,1652,1593,1655,1658],{},[18,1641,1642,1644],{},[23,1643,32],{}," treats numbers as strings sometimes",[23,1646,1647],{},"awk '$1 > 10'"," may do string comparison if ",[23,1650,630],{}," is ",[23,1653,1654],{},"\"9abc\"",[23,1656,1657],{},"awk '$1 + 0 > 10'"," to force numeric.",[1446,1660,1661,1508,1667,1670,1671,1674],{},[18,1662,1663,1666],{},[23,1664,1665],{},"cut -d\" \""," treats consecutive spaces as multiple empty fields",[23,1668,1669],{},"echo \"a  b\" | cut -d\" \" -f2"," gives empty. Use ",[23,1672,1673],{},"awk '{print $2}'"," instead (awk treats consecutive whitespace as one separator).",[1446,1676,1677,1508,1680,1683,1684,1687,1688,1691,1692,1695,1696,1698,1699,1702],{},[18,1678,1679],{},"Pipelines hide intermediate failures",[23,1681,1682],{},"cmd1 | cmd2 | cmd3"," — if ",[23,1685,1686],{},"cmd1"," fails, ",[23,1689,1690],{},"cmd2"," and ",[23,1693,1694],{},"cmd3"," still run. The pipeline's exit status is ",[23,1697,1694],{},"'s. Use ",[23,1700,1701],{},"set -o pipefail"," in scripts.",[50,1704,1706],{"id":1705},"spot-the-bug","🧠 Spot the Bug",[14,1708,1709],{},"A sysadmin wants to count how many times each error code appears in a log, but this pipeline gives wrong counts — many error codes show count 1 that should be higher:",[66,1711,1712],{"language":68},[70,1713,1715],{"className":72,"code":1714,"language":68,"meta":74,"style":74},"grep \"ERROR\" app.log | awk '{print $4}' | uniq -c | sort -rn | head\n",[23,1716,1717],{"__ignoreMap":74},[78,1718,1719,1721,1724,1726,1728,1730,1733,1735,1737,1739,1741,1743,1745,1747],{"class":80,"line":81},[78,1720,25],{"class":97},[78,1722,1723],{"class":100}," \"ERROR\"",[78,1725,218],{"class":100},[78,1727,108],{"class":107},[78,1729,674],{"class":97},[78,1731,1732],{"class":100}," '{print $4}'",[78,1734,108],{"class":107},[78,1736,116],{"class":97},[78,1738,120],{"class":119},[78,1740,108],{"class":107},[78,1742,111],{"class":97},[78,1744,127],{"class":119},[78,1746,108],{"class":107},[78,1748,1749],{"class":97}," head\n",[14,1751,1752],{},"What's wrong, and how do you fix it?",[1754,1755,1756,1760,1779,1814,1823,1864,1873],"details",{},[1757,1758,1759],"summary",{},"Answer",[14,1761,1762,1767,1768,1770,1771,1774,1775,1778],{},[18,1763,1764,1766],{},[23,1765,41],{}," only deduplicates adjacent duplicates."," The error codes from ",[23,1769,32],{}," are in log order (not sorted), so ",[23,1772,1773],{},"E404 E500 E404 E404 E500"," has no adjacent duplicates collapsed — ",[23,1776,1777],{},"uniq -c"," reports each run separately:",[66,1780,1781],{"language":68},[70,1782,1784],{"className":72,"code":1783,"language":68,"meta":74,"style":74},"1 E404\n1 E500\n2 E404\n1 E500\n",[23,1785,1786,1794,1801,1808],{"__ignoreMap":74},[78,1787,1788,1791],{"class":80,"line":81},[78,1789,1790],{"clas