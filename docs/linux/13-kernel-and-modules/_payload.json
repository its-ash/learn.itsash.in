,1268,1269],{"class":55,"line":312},[53,1270,1271],{"class":67},"# Inspect:\n",[53,1273,1274,1277,1280,1283,1285,1287,1290,1293,1295,1298],{"class":55,"line":318},[53,1275,1276],{"class":59},"lsinitramfs",[53,1278,1279],{"class":88}," \u002Fboot\u002Finitrd.img-",[53,1281,1282],{"class":142},"$(",[53,1284,60],{"class":59},[53,1286,64],{"class":63},[53,1288,1289],{"class":142},") ",[53,1291,1292],{"class":355},"|",[53,1294,1052],{"class":59},[53,1296,1297],{"class":88}," ext4",[53,1299,1300],{"class":67},"   # has ext4 module?\n",[329,1302,1304],{"id":1303},"edge-case-missing-initramfs-causes-boot-failure","Edge Case: Missing initramfs Causes Boot Failure",[41,1306,1307],{"language":43},[45,1308,1310],{"className":47,"code":1309,"language":43,"meta":49,"style":49},"# Error: \"VFS: Unable to mount root fs on unknown-block(0,0)\"\n# The initramfs is missing or doesn't have the storage driver for the new kernel.\n# Fix: boot an older kernel (GRUB → \"Advanced options\"), then:\nsudo update-initramfs -u -k all\nsudo reboot\n",[23,1311,1312,1317,1322,1327,1340],{"__ignoreMap":49},[53,1313,1314],{"class":55,"line":56},[53,1315,1316],{"class":67},"# Error: \"VFS: Unable to mount root fs on unknown-block(0,0)\"\n",[53,1318,1319],{"class":55,"line":71},[53,1320,1321],{"class":67},"# The initramfs is missing or doesn't have the storage driver for the new kernel.\n",[53,1323,1324],{"class":55,"line":82},[53,1325,1326],{"class":67},"# Fix: boot an older kernel (GRUB → \"Advanced options\"), then:\n",[53,1328,1329,1331,1333,1335,1337],{"class":55,"line":164},[53,1330,265],{"class":59},[53,1332,1213],{"class":88},[53,1334,1216],{"class":63},[53,1336,1230],{"class":63},[53,1338,1339],{"class":88}," all\n",[53,1341,1342,1344],{"class":55,"line":185},[53,1343,265],{"class":59},[53,1345,1346],{"class":88}," reboot\n",[36,1348,1350],{"id":1349},"dkms-dynamic-kernel-module-support","DKMS — Dynamic Kernel Module Support",[41,1352,1353],{"language":43},[45,1354,1356],{"className":47,"code":1355,"language":43,"meta":49,"style":49},"# Third-party modules (NVIDIA, ZFS, VirtualBox) need rebuilding for each kernel version\nsudo dkms install nvidia\u002F550.54          # build + install for current kernel\ndkms status                              # list DKMS modules\n# When a new kernel is installed, DKMS auto-rebuilds via a postinst hook\n\n# Edge Case: if DKMS fails (API changed), the module is missing after reboot\n# Check dkms status after kernel updates — have a fallback kernel ready\n",[23,1357,1358,1363,1378,1389,1394,1398,1403],{"__ignoreMap":49},[53,1359,1360],{"class":55,"line":56},[53,1361,1362],{"class":67},"# Third-party modules (NVIDIA, ZFS, VirtualBox) need rebuilding for each kernel version\n",[53,1364,1365,1367,1370,1372,1375],{"class":55,"line":71},[53,1366,265],{"class":59},[53,1368,1369],{"class":88}," dkms",[53,1371,1011],{"class":88},[53,1373,1374],{"class":88}," nvidia\u002F550.54",[53,1376,1377],{"class":67},"          # build + install for current kernel\n",[53,1379,1380,1383,1386],{"class":55,"line":82},[53,1381,1382],{"class":59},"dkms",[53,1384,1385],{"class":88}," status",[53,1387,1388],{"class":67},"                              # list DKMS modules\n",[53,1390,1391],{"class":55,"line":164},[53,1392,1393],{"class":67},"# When a new kernel is installed, DKMS auto-rebuilds via a postinst hook\n",[53,1395,1396],{"class":55,"line":185},[53,1397,309],{"emptyLinePlaceholder":308},[53,1399,1400],{"class":55,"line":197},[53,1401,1402],{"class":67},"# Edge Case: if DKMS fails (API changed), the module is missing after reboot\n",[53,1404,1405],{"class":55,"line":312},[53,1406,1407],{"class":67},"# Check dkms status after kernel updates — have a fallback kernel ready\n",[36,1409,1411],{"id":1410},"tips-tricks","💡 Tips & Tricks",[207,1413,1414,1431,1452,1460,1477,1490,1499,1511],{},[210,1415,1416,1419,1420,1423,1424,1427,1428,1430],{},[18,1417,1418],{},"Idiom",": use ",[23,1421,1422],{},"sysctl --system"," after editing ",[23,1425,1426],{},"\u002Fetc\u002Fsysctl.d\u002F*.conf"," — loads all sysctl files in order. Put custom config in ",[23,1429,792],{}," so it loads last and wins.",[210,1432,1433,1419,1435,1438,1439,1442,1443,1445,1446,1448,1449,1451],{},[18,1434,1418],{},[23,1436,1437],{},"modprobe"," (not ",[23,1440,1441],{},"insmod",") for loading modules — ",[23,1444,1437],{}," resolves dependencies. ",[23,1447,1441],{}," loads a single ",[23,1450,239],{}," and fails if deps are missing.",[210,1453,1454,1419,1456,1459],{},[18,1455,1418],{},[23,1457,1458],{},"modinfo \u003Cmodule>"," before loading — shows description, parameters, dependencies, and which kernel it was built for.",[210,1461,1462,1464,1465,1468,1469,1472,1473,1476],{},[18,1463,1418],{},": blacklist problematic modules in ",[23,1466,1467],{},"\u002Fetc\u002Fmodprobe.d\u002F"," — ",[23,1470,1471],{},"blacklist"," stops auto-load; ",[23,1474,1475],{},"install \u003Cmodule> \u002Fbin\u002Ffalse"," blocks even manual loading.",[210,1478,1479,1481,1482,1485,1486,1489],{},[18,1480,1418],{},": run ",[23,1483,1484],{},"sudo update-initramfs -u"," (or ",[23,1487,1488],{},"dracut -f",") after storage\u002Fkernel changes — ensures the initramfs has the modules to boot.",[210,1491,1492,1419,1495,1498],{},[18,1493,1494],{},"Debug",[23,1496,1497],{},"udevadm monitor"," to watch device events live — plug in a USB device and see the kernel + udev events.",[210,1500,1501,1419,1503,1506,1507,1510],{},[18,1502,1494],{},[23,1504,1505],{},"cat \u002Fproc\u002Fcmdline"," to verify boot parameters — confirms that GRUB changes took effect after ",[23,1508,1509],{},"update-grub",".",[210,1512,1513,1419,1515,1485,1518,1521],{},[18,1514,1494],{},[23,1516,1517],{},"journalctl -k -p err",[23,1519,1520],{},"dmesg --level=err",") for kernel errors — hardware failures, driver issues, OOM kills.",[36,1523,1525],{"id":1524},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[207,1527,1528,1534,1553,1563,1577,1600,1610],{},[210,1529,1530,1533],{},[18,1531,1532],{},"Modules are kernel-version-specific",": a module built for 6.8.0-31 won't load on 6.8.0-32 (vermagic check). DKMS rebuilds on kernel updates — if DKMS fails (e.g., NVIDIA can't build against a new kernel), the module won't load after reboot.",[210,1535,1536,1542,1543,1546,1547,1550,1551,1510],{},[18,1537,1538,1541],{},[23,1539,1540],{},"rmmod"," fails if the module is in use",": you can't remove a filesystem module while a filesystem of that type is mounted, or a network driver while the interface is up. Stop the usage first (",[23,1544,1545],{},"umount",", ",[23,1548,1549],{},"ip link set down","), then ",[23,1552,1540],{},[210,1554,1555,1560,1561,1510],{},[18,1556,1557,1559],{},[23,1558,705],{}," changes are temporary",": lost on reboot. Always persist in ",[23,1562,777],{},[210,1564,1565,1568,1569,1572,1573,1576],{},[18,1566,1567],{},"Removing the running kernel breaks the system",": if you ",[23,1570,1571],{},"apt purge linux-image-$(uname -r)",", the running kernel's files are deleted. You can't load modules or rebuild initramfs. Never purge the running kernel — check ",[23,1574,1575],{},"uname -r"," first.",[210,1578,1579,1584,1585,1588,1589,1591,1592,1595,1596,1599],{},[18,1580,1581,1583],{},[23,1582,1110],{}," can fill up from old kernels",": ",[23,1586,1587],{},"apt"," keeps old kernels, and ",[23,1590,1110],{}," is often a small separate partition. Clean with ",[23,1593,1594],{},"sudo apt autoremove --purge"," (Debian) or ",[23,1597,1598],{},"dnf remove --oldinstallonly"," (RHEL).",[210,1601,1602,1605,1606,1609],{},[18,1603,1604],{},"DKMS can break on kernel updates",": if a third-party module (NVIDIA, ZFS) can't compile against a new kernel (API changed), DKMS fails, and after reboot the module is missing. Check ",[23,1607,1608],{},"dkms status"," and have a fallback kernel.",[210,1611,1612,1584,1620,1623,1624,1627],{},[18,1613,1614,1616,1617,1619],{},[23,1615,29],{}," and ",[23,1618,33],{}," are virtual",[23,1621,1622],{},"du -sh \u002Fproc"," gives nonsense. ",[23,1625,1626],{},"tar"," should exclude them. Don't try to back them up — they're generated by the kernel at read time.",[36,1629,1631],{"id":1630},"quick-quiz","🧠 Quick Quiz",[14,1633,1634,1635,1638],{},"You install a new kernel via ",[23,1636,1637],{},"sudo apt install linux-image-6.8.0-35-generic",", reboot, and get a kernel panic: \"VFS: Unable to mount root fs on unknown-block(0,0)\". What's the most likely cause, and how do you fix it?",[1640,1641,1642,1646,1652,1657,1665,1707,1712,1746],"details",{},[1643,1644,1645],"summary",{},"Answer",[14,1647,1648,1651],{},[18,1649,1650],{},"The initramfs is missing or doesn't have the storage driver."," \"Unable to mount root fs\" means the kernel booted but can't find\u002Fread the root filesystem — because the driver for your disk controller or filesystem (ext4, LVM, NVMe) is a module that wasn't included in the initramfs.",[14,1653,1654],{},[18,1655,1656],{},"Fix:",[1177,1658,1659,1662],{},[210,1660,1661],{},"Boot an older (working) kernel — GRUB → \"Advanced options\" → select the previous kernel (e.g., 6.8.0-31).",[210,1663,1664],{},"Regenerate the initramfs for the new kernel:",[41,1666,1667],{"language":43},[45,1668,1670],{"className":47,"code":1669,"language":43,"meta":49,"style":49},"sudo update-initramfs -u -k 6.8.0-35-generic\n# Or for all kernels:\nsudo update-initramfs -u -k all\n# RHEL: sudo dracut -f \u002Fboot\u002Finitramfs-6.8.0-35.img 6.8.0-35\n",[23,1671,1672,1685,1690,1702],{"__ignoreMap":49},[53,1673,1674,1676,1678,1680,1682],{"class":55,"line":56},[53,1675,265],{"class":59},[53,1677,1213],{"class":88},[53,1679,1216],{"class":63},[53,1681,1230],{"class":63},[53,1683,1684],{"class":88}," 6.8.0-35-generic\n",[53,1686,1687],{"class":55,"line":71},[53,1688,1689],{"class":67},"# Or for all kernels:\n",[53,1691,1692,1694,1696,1698,1700],{"class":55,"line":82},[53,1693,265],{"class":59},[53,1695,1213],{"class":88},[53,1697,1216],{"class":63},[53,1699,1230],{"class":63},[53,1701,1339],{"class":88},[53,1703,1704],{"class":55,"line":164},[53,1705,1706],{"class":67},"# RHEL: sudo dracut -f \u002Fboot\u002Finitramfs-6.8.0-35.img 6.8.0-35\n",[1177,1708,1709],{"start":82},[210,1710,1711],{},"Verify the initramfs exists and has the needed modules:",[41,1713,1714],{"language":43},[45,1715,1717],{"className":47,"code":1716,"language":43,"meta":49,"style":49},"ls -lh \u002Fboot\u002Finitrd.img-6.8.0-35-generic   # should be > 10 MB\nlsinitramfs \u002Fboot\u002Finitrd.img-6.8.0-35-generic | grep ext4   # has ext4 module?\n",[23,1718,1719,1732],{"__ignoreMap":49},[53,1720,1721,1723,1726,1729],{"class":55,"line":56},[53,1722,1033],{"class":59},[53,1724,1725],{"class":63}," -lh",[53,1727,1728],{"class":88}," \u002Fboot\u002Finitrd.img-6.8.0-35-generic",[53,1730,1731],{"class":67},"   # should be > 10 MB\n",[53,1733,1734,1736,1738,1740,1742,1744],{"class":55,"line":71},[53,1735,1276],{"class":59},[53,1737,1728],{"class":88},[53,1739,356],{"class":355},[53,1741,1052],{"class":59},[53,1743,1297],{"class":88},[53,1745,1300],{"class":67},[1177,1747,1748],{"start":164},[210,1749,1750],{},"Reboot — select the new kernel. It should boot now.",[1752,1753,1754],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}",{"title":49,"searchDepth":71,"depth":71,"links":1756},[1757,1758,1762,1770,1772,1773,1777,1781,1782,1783,1784],{"id":38,"depth":71,"text":39},{"id":228,"depth":71,"text":229,"children":1759},[1760,1761],{"id":331,"depth":82,"text":332},{"id":393,"depth":82,"text":394},{"id":452,"depth":71,"text":1763,"children":1764},"Kernel Parameters — sysctl",[1765,1766,1768],{"id":597,"depth":82,"text":598},{"id":701,"depth":82,"text":1767},"Edge Case: sysctl -w Changes Are Temporary",{"id":774,"depth":82,"text":1769},"\u002Fetc\u002Fsysctl.d\u002F Precedence",{"id":796,"depth":71,"text":1771},"\u002Fproc — Kernel & Process Interface",{"id":884,"depth":71,"text":885},{"id":978,"depth":71,"text":979,"children":1774},[1775],{"id":1107,"depth":82,"text":1776},"Edge Case: \u002Fboot Fills Up From Old Kernels",{"id":1166,"depth":71,"text":1778,"children":1779},"initramfs — Early Userspace",[1780],{"id":1303,"depth":82,"text":1304},{"id":1349,"depth":71,"text":1350},{"id":1410,"depth":71,"text":1411},{"id":1524,"depth":71,"text":1525},{"id":1630,"depth":71,"text":1631},"The kernel is the core of Linux — it manages the CPU, memory, devices, filesystems, and processes. This chapter covers kernel versions, loadable modules, kernel parameters (sysctl), \u002Fproc\u002F\u002Fsys interfaces, and kernel upgrades — through the lens of production tuning and troubleshooting.","md",{},"\u002Flinux\u002F13-kernel-and-modules",{"title":5,"description":1785},"linux\u002F13-kernel-and-modules","oarVp-4MrdY1LE7UNROwlCZL-8jlyoWlw5ASX4dAZf0",1789749841249]