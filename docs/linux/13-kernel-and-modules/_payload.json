[{"data":1,"prerenderedAt":1792},["ShallowReactive",2],{"page-\u002Flinux\u002F13-kernel-and-modules":3},{"id":4,"title":5,"body":6,"description":1785,"extension":1786,"meta":1787,"navigation":308,"path":1788,"seo":1789,"stem":1790,"__hash__":1791},"content\u002Flinux\u002F13-kernel-and-modules.md","13 — Kernel & Modules",{"type":7,"value":8,"toc":1755},"minimark",[9,13,35,40,93,96,206,226,230,241,328,333,391,395,450,456,595,599,699,707,772,779,794,800,882,886,976,980,1105,1112,1164,1171,1176,1195,1301,1305,1347,1351,1408,1412,1522,1526,1628,1632,1639,1751],[10,11,5],"h1",{"id":12},"_13-kernel-modules",[14,15,16,17,21,22,26,27,30,31,34],"p",{},"The ",[18,19,20],"strong",{},"kernel"," is the core of Linux — it manages the CPU, memory, devices, filesystems, and processes. This chapter covers kernel versions, loadable modules, kernel parameters (",[23,24,25],"code",{},"sysctl","), ",[23,28,29],{},"\u002Fproc","\u002F",[23,32,33],{},"\u002Fsys"," interfaces, and kernel upgrades — through the lens of production tuning and troubleshooting.",[36,37,39],"h2",{"id":38},"kernel-versions","Kernel Versions",[41,42,44],"code-wrapper",{"language":43},"bash",[45,46,50],"pre",{"className":47,"code":48,"language":43,"meta":49,"style":49},"language-bash shiki shiki-themes github-light github-dark","uname -r              # current kernel release (e.g., 6.8.0-31-generic)\nuname -a              # full info (hostname, kernel version, arch, build date)\ncat \u002Fproc\u002Fversion      # kernel version + gcc version it was built with\n","",[23,51,52,69,80],{"__ignoreMap":49},[53,54,57,61,65],"span",{"class":55,"line":56},"line",1,[53,58,60],{"class":59},"sIsaT","uname",[53,62,64],{"class":63},"snvgF"," -r",[53,66,68],{"class":67},"sdCPZ","              # current kernel release (e.g., 6.8.0-31-generic)\n",[53,70,72,74,77],{"class":55,"line":71},2,[53,73,60],{"class":59},[53,75,76],{"class":63}," -a",[53,78,79],{"class":67},"              # full info (hostname, kernel version, arch, build date)\n",[53,81,83,86,90],{"class":55,"line":82},3,[53,84,85],{"class":59},"cat",[53,87,89],{"class":88},"sJ6F3"," \u002Fproc\u002Fversion",[53,91,92],{"class":67},"      # kernel version + gcc version it was built with\n",[14,94,95],{},"Version numbering:",[41,97,98],{"language":43},[45,99,101],{"className":47,"code":100,"language":43,"meta":49,"style":49},"6.8.0-31-generic\n└┘└┘└┘ └┘ └─────┘\n │ │  │  │     └ distro\u002Fbuild flavor (Ubuntu: -generic, -aws; RHEL: -el9)\n │ │  │  └ patch level (distro-specific)\n │ │  └ minor\n │ └ major\n",[23,102,103,108,119,162,183,195],{"__ignoreMap":49},[53,104,105],{"class":55,"line":56},[53,106,107],{"class":59},"6.8.0-31-generic\n",[53,109,110,113,116],{"class":55,"line":71},[53,111,112],{"class":59},"└┘└┘└┘",[53,114,115],{"class":88}," └┘",[53,117,118],{"class":88}," └─────┘\n",[53,120,121,124,126,129,131,134,137,140,144,147,150,153,156,159],{"class":55,"line":82},[53,122,123],{"class":59}," │",[53,125,123],{"class":88},[53,127,128],{"class":88},"  │",[53,130,128],{"class":88},[53,132,133],{"class":88},"     └",[53,135,136],{"class":88}," distro\u002Fbuild",[53,138,139],{"class":88}," flavor",[53,141,143],{"class":142},"ssxIu"," (Ubuntu: ",[53,145,146],{"class":63},"-generic,",[53,148,149],{"class":63}," -aws",[53,151,152],{"class":142},"; ",[53,154,155],{"class":59},"RHEL:",[53,157,158],{"class":63}," -el9",[53,160,161],{"class":142},")\n",[53,163,165,167,169,171,174,177,180],{"class":55,"line":164},4,[53,166,123],{"class":59},[53,168,123],{"class":88},[53,170,128],{"class":88},[53,172,173],{"class":88},"  └",[53,175,176],{"class":88}," patch",[53,178,179],{"class":88}," level",[53,181,182],{"class":142}," (distro-specific)\n",[53,184,186,188,190,192],{"class":55,"line":185},5,[53,187,123],{"class":59},[53,189,123],{"class":88},[53,191,173],{"class":88},[53,193,194],{"class":88}," minor\n",[53,196,198,200,203],{"class":55,"line":197},6,[53,199,123],{"class":59},[53,201,202],{"class":88}," └",[53,204,205],{"class":88}," major\n",[207,208,209,220],"ul",{},[210,211,212,215,216,219],"li",{},[18,213,214],{},"Distro kernels",": Ubuntu\u002FRHEL patch and backport fixes onto a base version. ",[23,217,218],{},"6.8.0-31-generic"," is Ubuntu's 31st patch level of 6.8.",[210,221,222,225],{},[18,223,224],{},"LTS (Long Term Support)",": some mainline versions get long support (e.g., 6.1, 6.8). Distros often pick LTS bases.",[36,227,229],{"id":228},"loadable-kernel-modules-lkms","Loadable Kernel Modules (LKMs)",[14,231,232,233,236,237,240],{},"Drivers and features can be compiled as ",[18,234,235],{},"modules"," (",[23,238,239],{},".ko"," files) that are loaded on demand — rather than being built into the kernel.",[41,242,243],{"language":43},[45,244,246],{"className":47,"code":245,"language":43,"meta":49,"style":49},"# Complex Implementation: load a module with parameters + verify\nlsmod                            # list loaded modules\nsudo modprobe nfs version=4     # load a module (+ dependencies) with parameters\nsudo modprobe -r nfs            # remove a module (and deps)\nmodinfo nfs                     # show module info (author, params, deps)\n\n# Anti-Pattern: insmod (no dependency resolution)\n# sudo insmod \u002Fpath\u002Fto\u002Fdriver.ko   → fails if prerequisites are missing\n# Use modprobe instead — it resolves dependencies automatically\n",[23,247,248,253,261,281,294,304,310,316,322],{"__ignoreMap":49},[53,249,250],{"class":55,"line":56},[53,251,252],{"class":67},"# Complex Implementation: load a module with parameters + verify\n",[53,254,255,258],{"class":55,"line":71},[53,256,257],{"class":59},"lsmod",[53,259,260],{"class":67},"                            # list loaded modules\n",[53,262,263,266,269,272,275,278],{"class":55,"line":82},[53,264,265],{"class":59},"sudo",[53,267,268],{"class":88}," modprobe",[53,270,271],{"class":88}," nfs",[53,273,274],{"class":88}," version=",[53,276,277],{"class":63},"4",[53,279,280],{"class":67},"     # load a module (+ dependencies) with parameters\n",[53,282,283,285,287,289,291],{"class":55,"line":164},[53,284,265],{"class":59},[53,286,268],{"class":88},[53,288,64],{"class":63},[53,290,271],{"class":88},[53,292,293],{"class":67},"            # remove a module (and deps)\n",[53,295,296,299,301],{"class":55,"line":185},[53,297,298],{"class":59},"modinfo",[53,300,271],{"class":88},[53,302,303],{"class":67},"                     # show module info (author, params, deps)\n",[53,305,306],{"class":55,"line":197},[53,307,309],{"emptyLinePlaceholder":308},true,"\n",[53,311,313],{"class":55,"line":312},7,[53,314,315],{"class":67},"# Anti-Pattern: insmod (no dependency resolution)\n",[53,317,319],{"class":55,"line":318},8,[53,320,321],{"class":67},"# sudo insmod \u002Fpath\u002Fto\u002Fdriver.ko   → fails if prerequisites are missing\n",[53,323,325],{"class":55,"line":324},9,[53,326,327],{"class":67},"# Use modprobe instead — it resolves dependencies automatically\n",[329,330,332],"h3",{"id":331},"auto-loading-at-boot","Auto-Loading at Boot",[41,334,335],{"language":43},[45,336,338],{"className":47,"code":337,"language":43,"meta":49,"style":49},"# Modules in \u002Fetc\u002Fmodules-load.d\u002F*.conf are loaded at boot:\necho \"nfs\" | sudo tee \u002Fetc\u002Fmodules-load.d\u002Fnfs.conf\n\n# Module parameters in \u002Fetc\u002Fmodprobe.d\u002F*.conf:\necho \"options nfs version=4\" | sudo tee \u002Fetc\u002Fmodprobe.d\u002Fnfs.conf\n",[23,339,340,345,366,370,375],{"__ignoreMap":49},[53,341,342],{"class":55,"line":56},[53,343,344],{"class":67},"# Modules in \u002Fetc\u002Fmodules-load.d\u002F*.conf are loaded at boot:\n",[53,346,347,350,353,357,360,363],{"class":55,"line":71},[53,348,349],{"class":63},"echo",[53,351,352],{"class":88}," \"nfs\"",[53,354,356],{"class":355},"svdQ7"," |",[53,358,359],{"class":59}," sudo",[53,361,362],{"class":88}," tee",[53,364,365],{"class":88}," \u002Fetc\u002Fmodules-load.d\u002Fnfs.conf\n",[53,367,368],{"class":55,"line":82},[53,369,309],{"emptyLinePlaceholder":308},[53,371,372],{"class":55,"line":164},[53,373,374],{"class":67},"# Module parameters in \u002Fetc\u002Fmodprobe.d\u002F*.conf:\n",[53,376,377,379,382,384,386,388],{"class":55,"line":185},[53,378,349],{"class":63},[53,380,381],{"class":88}," \"options nfs version=4\"",[53,383,356],{"class":355},[53,385,359],{"class":59},[53,387,362],{"class":88},[53,389,390],{"class":88}," \u002Fetc\u002Fmodprobe.d\u002Fnfs.conf\n",[329,392,394],{"id":393},"blacklisting-modules","Blacklisting Modules",[41,396,397],{"language":43},[45,398,400],{"className":47,"code":399,"language":43,"meta":49,"style":49},"# Complex Implementation: fully block a problematic driver (e.g., nouveau before installing NVIDIA)\necho \"blacklist nouveau\" | sudo tee \u002Fetc\u002Fmodprobe.d\u002Fblacklist-nouveau.conf\n# \"blacklist\" prevents auto-load (by alias), but `modprobe nouveau` still works\n# To fully prevent even manual load:\necho \"install nouveau \u002Fbin\u002Ffalse\" | sudo tee -a \u002Fetc\u002Fmodprobe.d\u002Fblacklist-nouveau.conf\n",[23,401,402,407,423,428,433],{"__ignoreMap":49},[53,403,404],{"class":55,"line":56},[53,405,406],{"class":67},"# Complex Implementation: fully block a problematic driver (e.g., nouveau before installing NVIDIA)\n",[53,408,409,411,414,416,418,420],{"class":55,"line":71},[53,410,349],{"class":63},[53,412,413],{"class":88}," \"blacklist nouveau\"",[53,415,356],{"class":355},[53,417,359],{"class":59},[53,419,362],{"class":88},[53,421,422],{"class":88}," \u002Fetc\u002Fmodprobe.d\u002Fblacklist-nouveau.conf\n",[53,424,425],{"class":55,"line":82},[53,426,427],{"class":67},"# \"blacklist\" prevents auto-load (by alias), but `modprobe nouveau` still works\n",[53,429,430],{"class":55,"line":164},[53,431,432],{"class":67},"# To fully prevent even manual load:\n",[53,434,435,437,440,442,444,446,448],{"class":55,"line":185},[53,436,349],{"class":63},[53,438,439],{"class":88}," \"install nouveau \u002Fbin\u002Ffalse\"",[53,441,356],{"class":355},[53,443,359],{"class":59},[53,445,362],{"class":88},[53,447,76],{"class":63},[53,449,422],{"class":88},[36,451,453,454],{"id":452},"kernel-parameters-sysctl","Kernel Parameters — ",[23,455,25],{},[41,457,458],{"language":43},[45,459,461],{"className":47,"code":460,"language":43,"meta":49,"style":49},"# Complex Implementation: production network tuning with persistent config\n# Read:\nsysctl net.ipv4.ip_forward        # one parameter\ncat \u002Fproc\u002Fsys\u002Fnet\u002Fipv4\u002Fip_forward  # same (file path = parameter name with \u002F for .)\n\n# Set temporarily:\nsudo sysctl -w net.ipv4.ip_forward=1     # lost on reboot\necho 1 | sudo tee \u002Fproc\u002Fsys\u002Fnet\u002Fipv4\u002Fip_forward   # same\n\n# Set persistent:\necho \"net.ipv4.ip_forward = 1\" | sudo tee \u002Fetc\u002Fsysctl.d\u002F99-ip-forward.conf\nsudo sysctl -p \u002Fetc\u002Fsysctl.d\u002F99-ip-forward.conf   # load just this file\nsudo sysctl --system                               # load ALL configs\n",[23,462,463,468,473,483,493,497,502,521,539,543,549,566,582],{"__ignoreMap":49},[53,464,465],{"class":55,"line":56},[53,466,467],{"class":67},"# Complex Implementation: production network tuning with persistent config\n",[53,469,470],{"class":55,"line":71},[53,471,472],{"class":67},"# Read:\n",[53,474,475,477,480],{"class":55,"line":82},[53,476,25],{"class":59},[53,478,479],{"class":88}," net.ipv4.ip_forward",[53,481,482],{"class":67},"        # one parameter\n",[53,484,485,487,490],{"class":55,"line":164},[53,486,85],{"class":59},[53,488,489],{"class":88}," \u002Fproc\u002Fsys\u002Fnet\u002Fipv4\u002Fip_forward",[53,491,492],{"class":67},"  # same (file path = parameter name with \u002F for .)\n",[53,494,495],{"class":55,"line":185},[53,496,309],{"emptyLinePlaceholder":308},[53,498,499],{"class":55,"line":197},[53,500,501],{"class":67},"# Set temporarily:\n",[53,503,504,506,509,512,515,518],{"class":55,"line":312},[53,505,265],{"class":59},[53,507,508],{"class":88}," sysctl",[53,510,511],{"class":63}," -w",[53,513,514],{"class":88}," net.ipv4.ip_forward=",[53,516,517],{"class":63},"1",[53,519,520],{"class":67},"     # lost on reboot\n",[53,522,523,525,528,530,532,534,536],{"class":55,"line":318},[53,524,349],{"class":63},[53,526,527],{"class":63}," 1",[53,529,356],{"class":355},[53,531,359],{"class":59},[53,533,362],{"class":88},[53,535,489],{"class":88},[53,537,538],{"class":67},"   # same\n",[53,540,541],{"class":55,"line":324},[53,542,309],{"emptyLinePlaceholder":308},[53,544,546],{"class":55,"line":545},10,[53,547,548],{"class":67},"# Set persistent:\n",[53,550,552,554,557,559,561,563],{"class":55,"line":551},11,[53,553,349],{"class":63},[53,555,556],{"class":88}," \"net.ipv4.ip_forward = 1\"",[53,558,356],{"class":355},[53,560,359],{"class":59},[53,562,362],{"class":88},[53,564,565],{"class":88}," \u002Fetc\u002Fsysctl.d\u002F99-ip-forward.conf\n",[53,567,569,571,573,576,579],{"class":55,"line":568},12,[53,570,265],{"class":59},[53,572,508],{"class":88},[53,574,575],{"class":63}," -p",[53,577,578],{"class":88}," \u002Fetc\u002Fsysctl.d\u002F99-ip-forward.conf",[53,580,581],{"class":67},"   # load just this file\n",[53,583,585,587,589,592],{"class":55,"line":584},13,[53,586,265],{"class":59},[53,588,508],{"class":88},[53,590,591],{"class":63}," --system",[53,593,594],{"class":67},"                               # load ALL configs\n",[329,596,598],{"id":597},"common-parameters","Common Parameters",[600,601,602,615],"table",{},[603,604,605],"thead",{},[606,607,608,612],"tr",{},[609,610,611],"th",{},"Parameter",[609,613,614],{},"Purpose",[616,617,618,629,639,649,659,669,679,689],"tbody",{},[606,619,620,626],{},[621,622,623],"td",{},[23,624,625],{},"net.ipv4.ip_forward",[621,627,628],{},"IP forwarding (router\u002FVPN\u002FDocker)",[606,630,631,636],{},[621,632,633],{},[23,634,635],{},"net.ipv4.tcp_tw_reuse",[621,637,638],{},"Reuse TIME_WAIT sockets (high-conn servers)",[606,640,641,646],{},[621,642,643],{},[23,644,645],{},"net.core.somaxconn",[621,647,648],{},"Max backlog of pending connections",[606,650,651,656],{},[621,652,653],{},[23,654,655],{},"vm.swappiness",[621,657,658],{},"Swap tendency (0-100, default 60)",[606,660,661,666],{},[621,662,663],{},[23,664,665],{},"vm.overcommit_memory",[621,667,668],{},"Memory overcommit (0=heuristic, 1=always, 2=strict)",[606,670,671,676],{},[621,672,673],{},[23,674,675],{},"fs.file-max",[621,677,678],{},"System-wide max open files",[606,680,681,686],{},[621,682,683],{},[23,684,685],{},"fs.inotify.max_user_watches",[621,687,688],{},"Inotify watches (IDEs, Dropbox)",[606,690,691,696],{},[621,692,693],{},[23,694,695],{},"kernel.sysrq",[621,697,698],{},"Magic SysRq key (1=enable all)",[329,700,702,703,706],{"id":701},"edge-case-sysctl-w-changes-are-temporary","Edge Case: ",[23,704,705],{},"sysctl -w"," Changes Are Temporary",[41,708,709],{"language":43},[45,710,712],{"className":47,"code":711,"language":43,"meta":49,"style":49},"# NAIVE: set without persisting\nsudo sysctl -w vm.swappiness=10\n# After reboot: swappiness is back to 60\n\n# PRODUCTION: persist in \u002Fetc\u002Fsysctl.d\u002F\necho \"vm.swappiness = 10\" | sudo tee \u002Fetc\u002Fsysctl.d\u002F99-swappiness.conf\nsudo sysctl --system\n",[23,713,714,719,733,738,742,747,763],{"__ignoreMap":49},[53,715,716],{"class":55,"line":56},[53,717,718],{"class":67},"# NAIVE: set without persisting\n",[53,720,721,723,725,727,730],{"class":55,"line":71},[53,722,265],{"class":59},[53,724,508],{"class":88},[53,726,511],{"class":63},[53,728,729],{"class":88}," vm.swappiness=",[53,731,732],{"class":63},"10\n",[53,734,735],{"class":55,"line":82},[53,736,737],{"class":67},"# After reboot: swappiness is back to 60\n",[53,739,740],{"class":55,"line":164},[53,741,309],{"emptyLinePlaceholder":308},[53,743,744],{"class":55,"line":185},[53,745,746],{"class":67},"# PRODUCTION: persist in \u002Fetc\u002Fsysctl.d\u002F\n",[53,748,749,751,754,756,758,760],{"class":55,"line":197},[53,750,349],{"class":63},[53,752,753],{"class":88}," \"vm.swappiness = 10\"",[53,755,356],{"class":355},[53,757,359],{"class":59},[53,759,362],{"class":88},[53,761,762],{"class":88}," \u002Fetc\u002Fsysctl.d\u002F99-swappiness.conf\n",[53,764,765,767,769],{"class":55,"line":312},[53,766,265],{"class":59},[53,768,508],{"class":88},[53,770,771],{"class":63}," --system\n",[329,773,775,778],{"id":774},"etcsysctld-precedence",[23,776,777],{},"\u002Fetc\u002Fsysctl.d\u002F"," Precedence",[14,780,781,782,785,786,789,790,793],{},"Files are loaded in lexical order. ",[23,783,784],{},"99-sysctl.conf"," is a symlink to ",[23,787,788],{},"\u002Fetc\u002Fsysctl.conf"," (loaded last, lowest priority). Use ",[23,791,792],{},"99-*.conf"," for your overrides so they take precedence.",[36,795,797,799],{"id":796},"proc-kernel-process-interface",[23,798,29],{}," — Kernel & Process Interface",[41,801,802],{"language":43},[45,803,805],{"className":47,"code":804,"language":43,"meta":49,"style":49},"# Complex Implementation: read system state from \u002Fproc (no external tools needed)\ncat \u002Fproc\u002Floadavg\n# 0.45 0.32 0.28 2\u002F1024 12345\n#  └─────────────┘ └─────┘\n#  load avg (1,5,15)   running\u002Ftotal processes, last PID\n\ncat \u002Fproc\u002Fmeminfo | head -5\n# MemTotal:       16332940 kB\n# MemFree:         8234520 kB\n# MemAvailable:   11234567 kB   ← what apps can actually use (free + reclaimable cache)\n\ncat \u002Fproc\u002Fcmdline   # boot parameters passed to the kernel\n",[23,806,807,812,819,824,829,834,838,853,858,863,868,872],{"__ignoreMap":49},[53,808,809],{"class":55,"line":56},[53,810,811],{"class":67},"# Complex Implementation: read system state from \u002Fproc (no external tools needed)\n",[53,813,814,816],{"class":55,"line":71},[53,815,85],{"class":59},[53,817,818],{"class":88}," \u002Fproc\u002Floadavg\n",[53,820,821],{"class":55,"line":82},[53,822,823],{"class":67},"# 0.45 0.32 0.28 2\u002F1024 12345\n",[53,825,826],{"class":55,"line":164},[53,827,828],{"class":67},"#  └─────────────┘ └─────┘\n",[53,830,831],{"class":55,"line":185},[53,832,833],{"class":