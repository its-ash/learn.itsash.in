[{"data":1,"prerenderedAt":1541},["ShallowReactive",2],{"page-\u002Flinux\u002F16-boot-process-and-runlevels":3},{"id":4,"title":5,"body":6,"description":16,"extension":1535,"meta":1536,"navigation":235,"path":1537,"seo":1538,"stem":1539,"__hash__":1540},"content\u002Flinux\u002F16-boot-process-and-runlevels.md","16 — Boot Process & Runlevels",{"type":7,"value":8,"toc":1510},"minimark",[9,13,17,22,33,37,104,164,168,179,255,260,328,332,340,360,439,443,499,502,508,512,607,655,659,703,707,710,745,751,756,808,812,877,884,891,898,971,979,1050,1054,1148,1152,1250,1254,1371,1375,1382,1506],[10,11,5],"h1",{"id":12},"_16-boot-process-runlevels",[14,15,16],"p",{},"Understanding the Linux boot process is essential for troubleshooting boot failures, configuring services, and recovering a broken system. This chapter covers the full path from power-on to login prompt: firmware (BIOS\u002FUEFI), bootloader (GRUB), kernel, initramfs, systemd, and targets.",[18,19,21],"h2",{"id":20},"the-boot-sequence","The Boot Sequence",[23,24,30],"pre",{"className":25,"code":27,"language":28,"meta":29},[26],"language-text","1. Power on\n   ↓\n2. Firmware (BIOS or UEFI) — POST, hardware init, find boot device\n   ↓\n3. Bootloader (GRUB) — load kernel + initramfs into RAM\n   ↓\n4. Kernel — initialize, load drivers (from initramfs), mount root filesystem\n   ↓\n5. initramfs — early userspace, mount real root, pivot_root\n   ↓\n6. systemd (PID 1) — start services, targets, login prompt\n   ↓\n7. Login\n","text","",[31,32,27],"code",{"__ignoreMap":29},[18,34,36],{"id":35},"firmware-bios-or-uefi","Firmware — BIOS or UEFI",[38,39,40,56],"table",{},[41,42,43],"thead",{},[44,45,46,50,53],"tr",{},[47,48,49],"th",{},"Feature",[47,51,52],{},"BIOS",[47,54,55],{},"UEFI",[57,58,59,71,82,93],"tbody",{},[44,60,61,65,68],{},[62,63,64],"td",{},"Partition table",[62,66,67],{},"MBR (2 TB max)",[62,69,70],{},"GPT (8 ZB)",[44,72,73,76,79],{},[62,74,75],{},"Boot code",[62,77,78],{},"MBR (512 bytes)",[62,80,81],{},"EFI files on ESP",[44,83,84,87,90],{},[62,85,86],{},"Secure Boot",[62,88,89],{},"No",[62,91,92],{},"Yes (verify bootloader signature)",[44,94,95,98,101],{},[62,96,97],{},"Boot speed",[62,99,100],{},"Slower",[62,102,103],{},"Faster",[105,106,108],"code-wrapper",{"language":107},"bash",[23,109,112],{"className":110,"code":111,"language":107,"meta":29,"style":29},"language-bash shiki shiki-themes github-light github-dark","# Complex Implementation: detect firmware type\n[ -d \u002Fsys\u002Ffirmware\u002Fefi ] && echo \"UEFI\" || echo \"BIOS\u002FLegacy\"\nefibootmgr                       # UEFI boot entries (UEFI only)\n",[31,113,114,123,154],{"__ignoreMap":29},[115,116,119],"span",{"class":117,"line":118},"line",1,[115,120,122],{"class":121},"sdCPZ","# Complex Implementation: detect firmware type\n",[115,124,126,130,134,137,141,145,148,151],{"class":117,"line":125},2,[115,127,129],{"class":128},"ssxIu","[ ",[115,131,133],{"class":132},"svdQ7","-d",[115,135,136],{"class":128}," \u002Fsys\u002Ffirmware\u002Fefi ] && ",[115,138,140],{"class":139},"snvgF","echo",[115,142,144],{"class":143},"sJ6F3"," \"UEFI\"",[115,146,147],{"class":132}," ||",[115,149,150],{"class":139}," echo",[115,152,153],{"class":143}," \"BIOS\u002FLegacy\"\n",[115,155,157,161],{"class":117,"line":156},3,[115,158,160],{"class":159},"sIsaT","efibootmgr",[115,162,163],{"class":121},"                       # UEFI boot entries (UEFI only)\n",[18,165,167],{"id":166},"bootloader-grub","Bootloader — GRUB",[14,169,170,171,174,175,178],{},"GRUB loads the selected kernel (",[31,172,173],{},"vmlinuz-*",") and initramfs (",[31,176,177],{},"initrd.img-*",") into memory and passes boot parameters.",[105,180,181],{"language":107},[23,182,184],{"className":110,"code":183,"language":107,"meta":29,"style":29},"# Complex Implementation: add a kernel parameter (e.g., for recovery)\n# Edit \u002Fetc\u002Fdefault\u002Fgrub:\n# GRUB_CMDLINE_LINUX_DEFAULT=\"quiet splash systemd.unit=rescue.target\"\nsudo update-grub              # Debian\u002FUbuntu (generates grub.cfg)\nsudo grub2-mkconfig -o \u002Fboot\u002Fgrub2\u002Fgrub.cfg   # RHEL\u002FFedora\n\n# Anti-Pattern: editing \u002Fboot\u002Fgrub\u002Fgrub.cfg directly\n# It's GENERATED — update-grub overwrites it\n# Edit \u002Fetc\u002Fdefault\u002Fgrub (and \u002Fetc\u002Fgrub.d\u002F), then regenerate\n",[31,185,186,191,196,201,213,230,237,243,249],{"__ignoreMap":29},[115,187,188],{"class":117,"line":118},[115,189,190],{"class":121},"# Complex Implementation: add a kernel parameter (e.g., for recovery)\n",[115,192,193],{"class":117,"line":125},[115,194,195],{"class":121},"# Edit \u002Fetc\u002Fdefault\u002Fgrub:\n",[115,197,198],{"class":117,"line":156},[115,199,200],{"class":121},"# GRUB_CMDLINE_LINUX_DEFAULT=\"quiet splash systemd.unit=rescue.target\"\n",[115,202,204,207,210],{"class":117,"line":203},4,[115,205,206],{"class":159},"sudo",[115,208,209],{"class":143}," update-grub",[115,211,212],{"class":121},"              # Debian\u002FUbuntu (generates grub.cfg)\n",[115,214,216,218,221,224,227],{"class":117,"line":215},5,[115,217,206],{"class":159},[115,219,220],{"class":143}," grub2-mkconfig",[115,222,223],{"class":139}," -o",[115,225,226],{"class":143}," \u002Fboot\u002Fgrub2\u002Fgrub.cfg",[115,228,229],{"class":121},"   # RHEL\u002FFedora\n",[115,231,233],{"class":117,"line":232},6,[115,234,236],{"emptyLinePlaceholder":235},true,"\n",[115,238,240],{"class":117,"line":239},7,[115,241,242],{"class":121},"# Anti-Pattern: editing \u002Fboot\u002Fgrub\u002Fgrub.cfg directly\n",[115,244,246],{"class":117,"line":245},8,[115,247,248],{"class":121},"# It's GENERATED — update-grub overwrites it\n",[115,250,252],{"class":117,"line":251},9,[115,253,254],{"class":121},"# Edit \u002Fetc\u002Fdefault\u002Fgrub (and \u002Fetc\u002Fgrub.d\u002F), then regenerate\n",[256,257,259],"h3",{"id":258},"common-grub-parameters","Common GRUB Parameters",[38,261,262,272],{},[41,263,264],{},[44,265,266,269],{},[47,267,268],{},"Parameter",[47,270,271],{},"Effect",[57,273,274,284,294,304,314],{},[44,275,276,281],{},[62,277,278],{},[31,279,280],{},"quiet",[62,282,283],{},"Suppress kernel messages at boot",[44,285,286,291],{},[62,287,288],{},[31,289,290],{},"nomodeset",[62,292,293],{},"Don't load graphics drivers (for display issues)",[44,295,296,301],{},[62,297,298],{},[31,299,300],{},"systemd.unit=rescue.target",[62,302,303],{},"Boot to rescue mode (single-user)",[44,305,306,311],{},[62,307,308],{},[31,309,310],{},"init=\u002Fbin\u002Fbash",[62,312,313],{},"Bypass init (raw root shell — recovery only)",[44,315,316,321],{},[62,317,318],{},[31,319,320],{},"rw",[62,322,323,324,327],{},"Mount root read-write (default is ",[31,325,326],{},"ro"," initially)",[18,329,331],{"id":330},"initramfs-early-userspace","initramfs — Early Userspace",[14,333,334,335,339],{},"The ",[336,337,338],"strong",{},"initramfs"," is loaded into RAM by GRUB. It contains enough userspace to:",[341,342,343,347,350],"ol",{},[344,345,346],"li",{},"Load modules needed to see the root disk.",[344,348,349],{},"Mount the root filesystem.",[344,351,352,355,356,359],{},[31,353,354],{},"pivot_root"," into it and ",[31,357,358],{},"exec"," the real init (systemd).",[105,361,362],{"language":107},[23,363,365],{"className":110,"code":364,"language":107,"meta":29,"style":29},"# Regenerate after kernel or storage changes:\nsudo update-initramfs -u        # Debian\u002FUbuntu (current kernel)\nsudo dracut -f                  # RHEL\u002FFedora\n\n# Inspect:\nlsinitramfs \u002Fboot\u002Finitrd.img-$(uname -r) | grep ext4   # has ext4 module?\n",[31,366,367,372,385,398,402,407],{"__ignoreMap":29},[115,368,369],{"class":117,"line":118},[115,370,371],{"class":121},"# Regenerate after kernel or storage changes:\n",[115,373,374,376,379,382],{"class":117,"line":125},[115,375,206],{"class":159},[115,377,378],{"class":143}," update-initramfs",[115,380,381],{"class":139}," -u",[115,383,384],{"class":121},"        # Debian\u002FUbuntu (current kernel)\n",[115,386,387,389,392,395],{"class":117,"line":156},[115,388,206],{"class":159},[115,390,391],{"class":143}," dracut",[115,393,394],{"class":139}," -f",[115,396,397],{"class":121},"                  # RHEL\u002FFedora\n",[115,399,400],{"class":117,"line":203},[115,401,236],{"emptyLinePlaceholder":235},[115,403,404],{"class":117,"line":215},[115,405,406],{"class":121},"# Inspect:\n",[115,408,409,412,415,418,421,424,427,430,433,436],{"class":117,"line":232},[115,410,411],{"class":159},"lsinitramfs",[115,413,414],{"class":143}," \u002Fboot\u002Finitrd.img-",[115,416,417],{"class":128},"$(",[115,419,420],{"class":159},"uname",[115,422,423],{"class":139}," -r",[115,425,426],{"class":128},") ",[115,428,429],{"class":132},"|",[115,431,432],{"class":159}," grep",[115,434,435],{"class":143}," ext4",[115,437,438],{"class":121},"   # has ext4 module?\n",[18,440,442],{"id":441},"systemd-boot","systemd Boot",[105,444,445],{"language":107},[23,446,448],{"className":110,"code":447,"language":107,"meta":29,"style":29},"# Complex Implementation: analyze boot performance\nsystemd-analyze                   # total boot time\nsystemd-analyze blame              # services by startup time\nsystemd-analyze critical-chain    # the slow path\nsystemd-analyze plot > boot.svg    # visual timeline (open in browser)\n",[31,449,450,455,463,473,483],{"__ignoreMap":29},[115,451,452],{"class":117,"line":118},[115,453,454],{"class":121},"# Complex Implementation: analyze boot performance\n",[115,456,457,460],{"class":117,"line":125},[115,458,459],{"class":159},"systemd-analyze",[115,461,462],{"class":121},"                   # total boot time\n",[115,464,465,467,470],{"class":117,"line":156},[115,466,459],{"class":159},[115,468,469],{"class":143}," blame",[115,471,472],{"class":121},"              # services by startup time\n",[115,474,475,477,480],{"class":117,"line":203},[115,476,459],{"class":159},[115,478,479],{"class":143}," critical-chain",[115,481,482],{"class":121},"    # the slow path\n",[115,484,485,487,490,493,496],{"class":117,"line":215},[115,486,459],{"class":159},[115,488,489],{"class":143}," plot",[115,491,492],{"class":132}," >",[115,494,495],{"class":143}," boot.svg",[115,497,498],{"class":121},"    # visual timeline (open in browser)\n",[14,500,501],{},"Example:",[23,503,506],{"className":504,"code":505,"language":28,"meta":29},[26],"$ systemd-analyze\nStartup finished in 5.123s (kernel) + 8.456s (userspace) = 13.579s\n\n$ systemd-analyze blame | head -5\n8.200s dev-sda1.device\n5.100s NetworkManager-wait-online.service    ← common culprit\n2.300s snapd.service\n",[31,507,505],{"__ignoreMap":29},[18,509,511],{"id":510},"targets-the-modern-runlevels","Targets — The Modern Runlevels",[38,513,514,527],{},[41,515,516],{},[44,517,518,521,524],{},[47,519,520],{},"Target",[47,522,523],{},"Old Runlevel",[47,525,526],{},"Purpose",[57,528,529,542,555,568,581,594],{},[44,530,531,536,539],{},[62,532,533],{},[31,534,535],{},"poweroff.target",[62,537,538],{},"0",[62,540,541],{},"Shut down",[44,543,544,549,552],{},[62,545,546],{},[31,547,548],{},"rescue.target",[62,550,551],{},"1",[62,553,554],{},"Single-user rescue (root only, minimal services)",[44,556,557,562,565],{},[62,558,559],{},[31,560,561],{},"multi-user.target",[62,563,564],{},"2, 3",[62,566,567],{},"Text mode (server default)",[44,569,570,575,578],{},[62,571,572],{},[31,573,574],{},"graphical.target",[62,576,577],{},"5",[62,579,580],{},"GUI (desktop default)",[44,582,583,588,591],{},[62,584,585],{},[31,586,587],{},"reboot.target",[62,589,590],{},"6",[62,592,593],{},"Reboot",[44,595,596,601,604],{},[62,597,598],{},[31,599,600],{},"emergency.target",[62,602,603],{},"—",[62,605,606],{},"Emergency mode (even more minimal than rescue)",[105,608,609],{"language":107},[23,610,612],{"className":110,"code":611,"language":107,"meta":29,"style":29},"systemctl get-default                 # show default (e.g., graphical.target)\nsudo systemctl set-default multi-user.target   # set text mode as default\nsudo systemctl isolate multi-user.target       # switch now (without reboot)\n",[31,613,614,625,641],{"__ignoreMap":29},[115,615,616,619,622],{"class":117,"line":118},[115,617,618],{"class":159},"systemctl",[115,620,621],{"class":143}," get-default",[115,623,624],{"class":121},"                 # show default (e.g., graphical.target)\n",[115,626,627,629,632,635,638],{"class":117,"line":125},[115,628,206],{"class":159},[115,630,631],{"class":143}," systemctl",[115,633,634],{"class":143}," set-default",[115,636,637],{"class":143}," multi-user.target",[115,639,640],{"class":121},"   # set text mode as default\n",[115,642,643,645,647,650,652],{"class":117,"line":156},[115,644,206],{"class":159},[115,646,631],{"class":143},[115,648,649],{"class":143}," isolate",[115,651,637],{"class":143},[115,653,654],{"class":121},"       # switch now (without reboot)\n",[18,656,658],{"id":657},"rescue-mode-vs-emergency-mode","Rescue Mode vs Emergency Mode",[38,660,661,673],{},[41,662,663],{},[44,664,665,668,670],{},[47,666,667],{},"Mode",[47,669,520],{},[47,671,672],{},"What's Running",[57,674,675,689],{},[44,676,677,682,686],{},[62,678,679],{},[336,680,681],{},"Rescue",[62,683,684],{},[31,685,548],{},[62,687,688],{},"Single-user, root shell, minimal services, filesystems mounted",[44,690,691,696,700],{},[62,692,693],{},[336,694,695],{},"Emergency",[62,697,698],{},[31,699,600],{},[62,701,702],{},"Single-user, root shell, almost nothing — root mounted read-only",[256,704,706],{"id":705},"booting-to-rescue-mode","Booting to Rescue Mode",[14,708,709],{},"At the GRUB menu:",[341,711,712,719,726,739],{},[344,713,714,715,718],{},"Press ",[31,716,717],{},"e"," to edit the default entry.",[344,720,721,722,725],{},"Find the line starting with ",[31,723,724],{},"linux",".",[344,727,728,729,731,732,734,735,738],{},"Append ",[31,730,300],{}," (or just ",[31,733,551],{}," or ",[31,736,737],{},"single",").",[344,740,714,741,744],{},[31,742,743],{},"Ctrl+X"," to boot.",[256,746,748,750],{"id":747},"initbinbash-last-resort",[31,749,310],{}," (Last Resort)",[14,752,728,753,755],{},[31,754,310],{}," to the kernel line. Bypasses systemd entirely — raw bash shell as PID 1, no services, no mounts (except root, read-only):",[105,757,758],{"language":107},[23,759,761],{"className":110,"code":760,"language":107,"meta":29,"style":29},"mount -o remount,rw \u002F       # make root writable\n# fix the problem...\nmount -o remount,ro \u002F       # clean unmount\nexec \u002Fsbin\u002Finit             # start systemd normally\n",[31,762,763,779,784,798],{"__ignoreMap":29},[115,764,765,768,770,773,776],{"class":117,"line":118},[115,766,767],{"class":159},"mount",[115,769,223],{"class":139},[115,771,772],{"class":143}," remount,rw",[115,774,775],{"class":143}," \u002F",[115,777,778],{"class":121},"       # make root writable\n",[115,780,781],{"class":117,"line":125},[115,782,783],{"class":121},"# fix the problem...\n",[115,785,786,788,790,793,795],{"class":117,"line":156},[115,787,767],{"class":159},[115,789,223],{"class":139},[115,791,792],{"class":143}," remount,ro",[115,794,775],{"class":143},[115,796,797],{"class":121},"       # clean unmount\n",[115,799,800,802,805],{"class":117,"line":203},[115,801,358],{"class":139},[115,803,804],{"class":143}," \u002Fsbin\u002Finit",[115,806,807],{"class":121},"             # start systemd normally\n",[18,809,811],{"id":810},"resetting-a-lost-root-password","Resetting a Lost Root Password",[105,813,814],{"language":107},[23,815,817],{"className":110,"code":816,"language":107,"meta":29,"style":29},"# Complex Implementation: reset root password via GRUB\n# 1. Reboot, at GRUB menu press 'e'\n# 2. Find the 'linux' line, append: rw init=\u002Fbin\u002Fbash\n# 3. Ctrl+X to boot\n# 4. You're root, no password needed:\npasswd                         # set a new root password\n# On SELinux systems:\ntouch \u002F.autorelabel            # SELinux will relabel on next boot\nexec \u002Fsbin\u002Finit                # continue boot\n",[31,818,819,824,829,834,839,844,852,857,868],{"__ignoreMap":29},[115,820,821],{"class":117,"line":118},[115,822,823],{"class":121},"# Complex Implementation: reset root password via GRUB\n",[115,825,826],{"class":117,"line":125},[115,827,828],{"class":121},"# 1. Reboot, at GRUB menu press 'e'\n",[115,830,831],{"class":117,"line":156},[115,832,833],{"class":121},"# 2. Find the 'linux' line, append: rw init=\u002Fbin\u002Fbash\n",[115,835,836],{"class":117,"line":203},[115,837,838],{"class":121},"# 3. Ctrl+X to boot\n",[115,840,841],{"class":117,"line":215},[115,842,843],{"class":121},"# 4. You're root, no password needed:\n",[115,845,846,849],{"class":117,"line":232},[115,847,848],{"class":159},"passwd",[115,850,851],{"class":121},"                         # set a new root password\n",[115,853,854],{"class":117,"line":239},[115,855,856],{"class":121},"# On SELinux systems:\n",[115,858,859,862,865],{"class":117,"line":245},[115,860,861],{"class":159},"touch",[115,863,864],{"class":143}," \u002F.autorelabel",[115,866,867],{"class":121},"            # SELinux will relabel on next boot\n",[115,869,870,872,874],{"class":117,"line":251},[115,871,358],{"class":139},[115,873,804],{"class":143},[115,875,876],{"class":121},"                # continue boot\n",[14,878,879,880,883],{},"This is why ",[336,881,882],{},"physical\u002Fconsole access = root access"," — secure your physical servers and use disk encryption (LUKS).",[18,885,887,890],{"id":886},"fstab-issues-at-boot",[31,888,889],{},"fstab"," Issues at Boot",[14,892,893,894,897],{},"A bad ",[31,895,896],{},"\u002Fetc\u002Ffstab"," entry can drop you to emergency mode:",[105,899,900],{"language":107},[23,901,903],{"className":110,"code":902,"language":107,"meta":29,"style":29},"# In emergency mode:\njournalctl -b | grep -i \"mount\\|fstab\"\nmount -o remount,rw \u002F\nnano \u002Fetc\u002Ffstab                # fix or comment the bad line\nmount -a                       # test\nsystemctl default              # continue boot\n",[31,904,905,910,929,940,951,961],{"__ignoreMap":29},[115,906,907],{"class":117,"line":118},[115,908,909],{"class":121},"# In emergency mode:\n",[115,911,912,915,918,921,923,926],{"class":117,"line":125},[115,913,914],{"class":159},"journalctl",[115,916,917],{"class":139}," -b",[115,919,920],{"class":132}," |",[115,922,432],{"class":159},[115,924,925],{"class":139}," -i",[115,927,928],{"class":143}," \"mount\\|fstab\"\n",[115,930,931,933,935,937],{"class":117,"line":156},[115,932,767],{"class":159},[115,934,223],{"class":139},[115,936,772],{"class":143},[115,938,939],{"class":143}," \u002F\n",[115,941,942,945,948],{"class":117,"line":203},[115,943,944],{"class":159},"nano",[115,946,947],{"class":143}," \u002Fetc\u002Ffstab",[115,949,950],{"class":121},"                # fix or comment the bad line\n",[115,952,953,955,958],{"class":117,"line":215},[115,954,767],{"class":159},[115,956,957],{"class":139}," -a",[115,959,960],{"class":121},"                       # test\n",[115,962,963,965,968],{"class":117,"line":232},[115,964,618],{"class":159},[115,966,967],{"class":143}," default",[115,969,970],{"class":121},"              # continue boot\n",[256,972,974,975,978],{"id":973},"edge-case-nofail-prevents-boot-failure","Edge Case: ",[31,976,977],{},"nofail"," Prevents Boot Failure",[105,980,981],{"language":107},[23,982,984],{"className":110,"code":983,"language":107,"meta":29,"style":29},"# NAIVE: mount without nofail → boot fails if device is absent\nUUID=abcd-1234  \u002Fmnt\u002Fusb  ext4  defaults  0  2\n# If \u002Fmnt\u002Fusb is absent → emergency mode\n\n# PRODUCTION: nofail lets boot continue\nUUID=abcd-1234  \u002Fmnt\u002Fusb  ext4  defaults,nofail  0  2\n",[31,985,986,991,1017,1022,1026,1031],{"__ignoreMap":29},[115,987,988],{"class":117,"line":118},[115,989,990],{"class":121},"# NAIVE: mount without nofail → boot fails if device is absent\n",[115,992,993,996,999,1002,1005,1008,1011,1014],{"class":117,"line":125},[115,994,995],{"class":128},"UUID",[115,997,998],{"class":132},"=",[115,1000,1001],{"class":143},"abcd-1234",[115,1003,1004],{"class":159},"  \u002Fmnt\u002Fusb",[115,1006,1007],{"class":143},"  ext4",[115,1009,1010],{"class":143},"  defaults",[115,1012,1013],{"class":139},"  0",[115,1015,1016],{"class":139},"  2\n",[115,1018,1019],{"class":117,"line":156},[115,1020,1021],{"class":121},"# If \u002Fmnt\u002Fusb is absent → emergency mode\n",[115,1023,1024],{"class":117,"line":203},[115,1025,236],{"emptyLinePlaceholder":235},[115,1027,1028],{"class":117,"line":215},[115,1029,1030],{"class":121},"# PRODUCTION: nofail lets boot continue\n",[115,1032,1033,1035,1037,1039,1041,1043,1046,1048],{"class":117,"line":232},[115,1034,995],{"class":128},[115,1036,998],{"class":132},[115,1038,1001],{"class":143},[115,1040,1004],{"class":159},[115,1042,1007],{"class":143},[115,1044,1045],{"class":143},"  defaults,nofail",[115,1047,1013],{"class":139},[115,1049,1016],{"class":139},[18,1051,1053],{"id":1052},"shutdown-and-reboot","Shutdown and Reboot",[105,1055,1056],{"language":107},[23,1057,1059],{"className":110,"code":1058,"language":107,"meta":29,"style":29},"sudo shutdown -r now           # reboot immediately\nsudo shutdown +5 \"Rebooting\"   # reboot in 5 min with warning to users\nsudo shutdown -c               # cancel scheduled shutdown\nsudo systemctl poweroff        # systemd-native\nsudo systemctl reboot\nsudo systemctl suspend         # suspend to RAM\nsudo systemctl hibernate       # suspend to disk\n",[31,1060,1061,1076,1091,1103,1115,1124,1136],{"__ignoreMap":29},[115,1062,1063,1065,1068,1070,1073],{"class":117,"line":118},[115,1064,206],{"class":159},[115,1066,1067],{"class":143}," shutdown",[115,1069,423],{"class":139},[115,1071,1072],{"class":143}," now",[115,1074,1075],{"class":121},"           # reboot immediately\n",[115,1077,1078,1080,1082,1085,1088],{"class":117,"line":125},[115,1079,206],{"class":159},[115,1081,1067],{"class":143},[115,1083,1084],{"class":143}," +5",[115,1086,1087],{"class":143}," \"Rebooting\"",[115,1089,1090],{"class":121},"   # reboot in 5 min with warning to users\n",[115,1092,1093,1095,1097,1100],{"class":117,"line":156},[115,1094,206],{"class":159},[115,1096,1067],{"class":143},[115,1098,1099],{"class":139}," -c",[115,1101,1102],{"class":121},"               # cancel scheduled shutdown\n",[115,1104,1105,1107,1109,1112],{"class":117,"line":203},[115,1106,206],{"class":159},[115,1108,631],{"class":143},[115,1110,1111],{"class":143}," poweroff",[115,1113,1114],{"class":121},"        # systemd-native\n",[115,1116,1117,1119,1121],{"class":117,"line":215},[115,1118,206],{"class":159},[115,1120,631],{"class":143},[115,1122,1123],{"class":143}," reboot\n",[115,1125,1126,1128,1130,1133],{"class":117,"line":232},[115,1127,206],{"class":159},[115,1129,631],{"class":143},[115,1131,1132],{"class":143}," suspend",[115,1134,1135],{"class":121},"         # suspend to RAM\n",[115,1137,1138,1140,1142,1145],{"class":117,"line":239},[115,1139,206],{"class":159},[115,1141,631],{"class":143},[115,1143,1144],{"class":143}," hibernate",[115,1146,1147],{"class":121},"       # suspend to disk\n",[18,1149,1151],{"id":1150},"tips-tricks","💡 Tips & Tricks",[1153,1154,1155,1169,1179,1196,1220,1238],"ul",{},[344,1156,1157,1160,1161,1164,1165,1168],{},[336,1158,1159],{},"Idiom",": use ",[31,1162,1163],{},"systemd-analyze blame"," to find slow boot services — disable or mask unneeded ones (",[31,1166,1167],{},"systemctl mask NetworkManager-wait-online.service"," — a common culprit).",[344,1170,1171,1160,1173,1175,1176,1178],{},[336,1172,1159],{},[31,1174,977],{}," in ",[31,1177,889],{}," for non-critical mounts — if a secondary disk or USB is absent at boot, boot continues instead of dropping to emergency mode.",[344,1180,1181,1183,1184,1187,1188,1191,1192,1195],{},[336,1182,1159],{},": edit ",[31,1185,1186],{},"\u002Fetc\u002Fdefault\u002Fgrub"," then ",[31,1189,1190],{},"sudo update-grub"," — never edit ",[31,1193,1194],{},"grub.cfg"," directly (it's generated and overwritten).",[344,1197,1198,1160,1200,1203,1204,1207,1208,1211,1212,1215,1216,1219],{},[336,1199,1159],{},[31,1201,1202],{},"journalctl -b -k -p err"," for boot kernel errors — ",[31,1205,1206],{},"-b"," (current boot), ",[31,1209,1210],{},"-k"," (kernel), ",[31,1213,1214],{},"-p err"," (errors). Use ",[31,1217,1218],{},"-b -1"," for the previous boot.",[344,1221,1222,1225,1226,1228,1229,1231,1232,1234,1235,1237],{},[336,1223,1224],{},"Debug",": boot to ",[31,1227,548],{}," for recovery — at GRUB, press ",[31,1230,717],{},", append ",[31,1233,300],{}," to the ",[31,1236,724],{}," line.",[344,1239,1240,1160,1242,1245,1246,1249],{},[336,1241,1224],{},[31,1243,1244],{},"rw init=\u002Fbin\u002Fbash"," to reset a lost root password — bypasses all auth. On SELinux: ",[31,1247,1248],{},"touch \u002F.autorelabel"," before rebooting.",[18,1251,1253],{"id":1252},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1153,1255,1256,1279,1291,1307,1322,1334,1349,1365],{},[344,1257,1258,1264,1265,1268,1269,1272,1273,1275,1276,1278],{},[336,1259,1260,1261,1263],{},"Editing ",[31,1262,1194],{}," directly is futile",": ",[31,1266,1267],{},"update-grub"," \u002F ",[31,1270,1271],{},"grub-mkconfig"," overwrites it. Edit ",[31,1274,1186],{},", then regenerate. Changes to ",[31,1277,1194],{}," vanish on the next kernel update.",[344,1280,1281,1286,1287,1290],{},[336,1282,1283,1285],{},[31,1284,310],{}," gives no services, no mounts",": you get a raw shell with root on ",[31,1288,1289],{},"\u002F"," (read-only), no networking, no other filesystems. Don't expect a normal environment.",[344,1292,1293,1296,1297,1299,1300,1303,1304,1306],{},[336,1294,1295],{},"Rescue mode needs the root password",": on some systems, ",[31,1298,548],{}," prompts for the root password. If root has no password (",[31,1301,1302],{},"passwd -l root","), use ",[31,1305,310],{}," instead.",[344,1308,1309,1312,1313,1315,1316,1318,1319,1321],{},[336,1310,1311],{},"SELinux blocks password reset in rescue mode",": after ",[31,1314,310],{}," + ",[31,1317,848],{},", SELinux may not recognize the new context. ",[31,1320,1248],{}," and reboot — SELinux relabels all files on next boot (can take a long time).",[344,1323,1324,1330,1331,725],{},[336,1325,1326,1329],{},[31,1327,1328],{},"NetworkManager-wait-online.service"," delays boot",": it waits for network \"online\" (30-90s). On servers with static IPs, disable it: ",[31,1332,1333],{},"sudo systemctl mask NetworkManager-wait-online.service",[344,1335,1336,1341,1342,1345,1346,1348],{},[336,1337,1338,1340],{},[31,1339,889],{}," errors drop to emergency mode",": a mount that fails (bad UUID, missing disk) drops you to emergency mode. Always test with ",[31,1343,1344],{},"sudo mount -a"," after editing. Use ",[31,1347,977],{}," for non-critical mounts.",[344,1350,1351,1264,1354,1357,1358,1361,1362,725],{},[336,1352,1353],{},"UEFI vs BIOS GRUB commands differ",[31,1355,1356],{},"grub-install \u002Fdev\u002Fsda"," (BIOS) vs ",[31,1359,1360],{},"grub-install --target=x86_64-efi --efi-directory=\u002Fboot\u002Fefi"," (UEFI). Check with ",[31,1363,1364],{},"[ -d \u002Fsys\u002Ffirmware\u002Fefi ]",[344,1366,1367,1370],{},[336,1368,1369],{},"Secure Boot can block custom kernels\u002Fmodules",": signed bootloaders\u002Fkernels only. If you install a custom kernel or third-party module (e.g., NVIDIA), it may not load with Secure Boot on.",[18,1372,1374],{"id":1373},"quick-quiz","🧠 Quick Quiz",[14,1376,1377,1378,1381],{},"A server fails to boot after a kernel upgrade. The error is: ",[31,1379,1380],{},"kernel panic - not syncing: VFS: Unable to mount root fs on unknown-block(0,0)",". You have physical access. What are the steps to recover?",[1383,1384,1385,1389,1395,1400,1413,1457,1464,1499],"details",{},[1386,1387,1388],"summary",{},"Answer",[14,1390,1391,1394],{},[336,1392,1393],{},"The initramfs is missing or doesn't have the storage driver for the new kernel."," The kernel booted but can't mount the root filesystem because the needed modules (disk controller, filesystem, LVM) aren't in the initramfs.",[14,1396,1397],{},[336,1398,1399],{},"Recovery steps:",[341,1401,1402,1408],{},[344,1403,1404,1407],{},[336,1405,1406],{},"Reboot and select the old kernel"," — GRUB menu → \"Advanced options\" → select the previous (working) kernel.",[344,1409,1410],{},[336,1411,1412],{},"Regenerate the initramfs for the new kernel:",[105,1414,1415],{"language":107},[23,1416,1418],{"className":110,"code":1417,"language":107,"meta":29,"style":29},"sudo update-initramfs -u -k 6.8.0-35-generic\n# Or for all kernels:\nsudo update-initramfs -u -k all\n# RHEL: sudo dracut -f \u002Fboot\u002Finitramfs-6.8.0-35.img 6.8.0-35\n",[31,1419,1420,1434,1439,1452],{"__ignoreMap":29},[115,1421,1422,1424,1426,1428,1431],{"class":117,"line":118},[115,1423,206],{"class":159},[115,1425,378],{"class":143},[115,1427,381],{"class":139},[115,1429,1430],{"class":139}," -k",[115,1432,1433],{"class":143}," 6.8.0-35-generic\n",[115,1435,1436],{"class":117,"line":125},[115,1437,1438],{"class":121},"# Or for all kernels:\n",[115,1440,1441,1443,1445,1447,1449],{"class":117,"line":156},[115,1442,206],{"class":159},[115,1444,378],{"class":143},[115,1446,381],{"class":139},[115,1448,1430],{"class":139},[115,1450,1451],{"class":143}," all\n",[115,1453,1454],{"class":117,"line":203},[115,1455,1456],{"class":121},"# RHEL: sudo dracut -f \u002Fboot\u002Finitramfs-6.8.0-35.img 6.8.0-35\n",[341,1458,1459],{"start":156},[344,1460,1461],{},[336,1462,1463],{},"Verify the initramfs exists and has the needed modules:",[105,1465,1466],{"language":107},[23,1467,1469],{"className":110,"code":1468,"language":107,"meta":29,"style":29},"ls -lh \u002Fboot\u002Finitrd.img-6.8.0-35-generic   # should be > 10 MB\nlsinitramfs \u002Fboot\u002Finitrd.img-6.8.0-35-generic | grep ext4   # has ext4 module?\n",[31,1470,1471,1485],{"__ignoreMap":29},[115,1472,1473,1476,1479,1482],{"class":117,"line":118},[115,1474,1475],{"class":159},"ls",[115,1477,1478],{"class":139}," -lh",[115,1480,1481],{"class":143}," \u002Fboot\u002Finitrd.img-6.8.0-35-generic",[115,1483,1484],{"class":121},"   # should be > 10 MB\n",[115,1486,1487,1489,1491,1493,1495,1497],{"class":117,"line":125},[115,1488,411],{"class":159},[115,1490,1481],{"class":143},[115,1492,920],{"class":132},[115,1494,432],{"class":159},[115,1496,435],{"class":143},[115,1498,438],{"class":121},[341,1500,1501],{"start":203},[344,1502,1503,1505],{},[336,1504,593],{}," — select the new kernel. It should boot now.",[1507,1508,1509],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}",{"title":29,"searchDepth":125,"depth":125,"links":1511},[1512,1513,1514,1517,1518,1519,1520,1525,1526,1531,1532,1533,1534],{"id":20,"depth":125,"text":21},{"id":35,"depth":125,"text":36},{"id":166,"depth":125,"text":167,"children":1515},[1516],{"id":258,"depth":156,"text":259},{"id":330,"depth":125,"text":331},{"id":441,"depth":125,"text":442},{"id":510,"depth":125,"text":511},{"id":657,"depth":125,"text":658,"children":1521},[1522,1523],{"id":705,"depth":156,"text":706},{"id":747,"depth":156,"text":1524},"init=\u002Fbin\u002Fbash (Last Resort)",{"id":810,"depth":125,"text":811},{"id":886,"depth":125,"text":1527,"children":1528},"fstab Issues at Boot",[1529],{"id":973,"depth":156,"text":1530},"Edge Case: nofail Prevents Boot Failure",{"id":1052,"depth":125,"text":1053},{"id":1150,"depth":125,"text":1151},{"id":1252,"depth":125,"text":1253},{"id":1373,"depth":125,"text":1374},"md",{},"\u002Flinux\u002F16-boot-process-and-runlevels",{"title":5,"description":16},"linux\u002F16-boot-process-and-runlevels","2cMtB6vjcyZN4DK6DFAfeWCr7aeggzSjJiWfR2rzbgY",1789140923656]