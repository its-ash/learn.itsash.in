[55,1404,1405],{"class":68},"logger",[55,1407,1408],{"class":71}," -t",[55,1410,195],{"class":78},[55,1412,1413],{"class":78}," \"Starting up\"",[55,1415,1416],{"class":61},"                    # to syslog (user facility)\n",[55,1418,1419,1421,1423,1426,1429],{"class":57,"line":85},[55,1420,1405],{"class":68},[55,1422,75],{"class":71},[55,1424,1425],{"class":78}," local0.info",[55,1427,1428],{"class":78}," \"Info message\"",[55,1430,1431],{"class":61},"             # custom facility + priority\n",[23,1433,1435],{"id":1434},"centralized-logging","Centralized Logging",[45,1437,1438],{"language":47},[28,1439,1441],{"className":50,"code":1440,"language":47,"meta":34,"style":34},"# rsyslog forward to remote (TCP, reliable):\n# \u002Fetc\u002Frsyslog.d\u002F60-forward.conf\n*.*  @@logserver.example.com:514    # TCP (@@ = TCP, @ = UDP)\n",[18,1442,1443,1448,1453],{"__ignoreMap":34},[55,1444,1445],{"class":57,"line":58},[55,1446,1447],{"class":61},"# rsyslog forward to remote (TCP, reliable):\n",[55,1449,1450],{"class":57,"line":65},[55,1451,1452],{"class":61},"# \u002Fetc\u002Frsyslog.d\u002F60-forward.conf\n",[55,1454,1455,1458,1461,1463,1466],{"class":57,"line":85},[55,1456,1457],{"class":643},"*",[55,1459,1460],{"class":1374},".",[55,1462,1457],{"class":643},[55,1464,1465],{"class":1374},"  @@logserver.example.com:514    ",[55,1467,1468],{"class":61},"# TCP (@@ = TCP, @ = UDP)\n",[23,1470,1472],{"id":1471},"tips-tricks","💡 Tips & Tricks",[1474,1475,1476,1500,1516,1532,1556,1564,1584,1595],"ul",{},[1477,1478,1479,1483,1484,1487,1488,1491,1492,1495,1496,1499],"li",{},[1480,1481,1482],"strong",{},"Idiom",": use ",[18,1485,1486],{},"journalctl -u \u003Cservice> -f"," for live log tailing — the ",[18,1489,1490],{},"-f"," flag follows (like ",[18,1493,1494],{},"tail -f","). Pair with ",[18,1497,1498],{},"--since \"10 min ago\""," to skip old context.",[1477,1501,1502,1483,1504,1507,1508,1511,1512,1515],{},[1480,1503,1482],{},[18,1505,1506],{},"journalctl -b -p err"," to find boot errors fast — ",[18,1509,1510],{},"-b"," limits to current boot, ",[18,1513,1514],{},"-p err"," shows errors and worse.",[1477,1517,1518,1483,1520,1523,1524,1527,1528,1531],{},[1480,1519,1482],{},[18,1521,1522],{},"journalctl --list-boots"," + ",[18,1525,1526],{},"journalctl -b -1"," for previous-boot debugging — when a reboot happened, ",[18,1529,1530],{},"-b -1"," shows the last boot's logs.",[1477,1533,1534,1483,1536,1538,1539,1541,1542,1544,1545,1548,1549,1551,1552,1555],{},[1480,1535,1482],{},[18,1537,465],{}," and ",[18,1540,478],{}," for login forensics — ",[18,1543,465],{}," shows who logged in (from ",[18,1546,1547],{},"wtmp","); ",[18,1550,478],{}," shows failed attempts (from ",[18,1553,1554],{},"btmp",").",[1477,1557,1558,1483,1560,1563],{},[1480,1559,1482],{},[18,1561,1562],{},"logrotate -d"," to dry-run before relying on it — catches config errors without losing logs.",[1477,1565,1566,1568,1569,1572,1573,1577,1578,1580,1581,1583],{},[1480,1567,1482],{},": install ",[18,1570,1571],{},"sysstat"," and enable it ",[1574,1575,1576],"em",{},"before"," you need it — ",[18,1579,1069],{}," data is only collected if ",[18,1582,1571],{}," is running. If you install it after an incident, there's no historical data.",[1477,1585,1586,1483,1589,1591,1592,1460],{},[1480,1587,1588],{},"Debug",[18,1590,1289],{}," for historical \"what was running at time X?\" — replay with ",[18,1593,1594],{},"atop -r \u002Fvar\u002Flog\u002Fatop\u002Fatop_YYYYMMDD",[1477,1596,1597,1483,1599,1602,1603,1538,1606,1609,1610,1612],{},[1480,1598,1588],{},[18,1600,1601],{},"iostat -x 1"," and watch ",[18,1604,1605],{},"%util",[18,1607,1608],{},"await"," — ",[18,1611,1605],{}," near 100% = disk saturated. The most common cause of \"the app is slow\" is disk I\u002FO, not CPU.",[23,1614,1616],{"id":1615},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1474,1618,1619,1643,1654,1671,1691,1704,1720,1730],{},[1477,1620,1621,1624,1625,1628,1629,1632,1633,1635,1636,1639,1640,1460],{},[1480,1622,1623],{},"journald logs are lost on reboot by default",": if ",[18,1626,1627],{},"\u002Fvar\u002Flog\u002Fjournal\u002F"," doesn't exist, logs are in ",[18,1630,1631],{},"\u002Frun\u002Flog\u002Fjournal\u002F"," (RAM, volatile). Create ",[18,1634,1627],{}," or set ",[18,1637,1638],{},"Storage=persistent"," in ",[18,1641,1642],{},"journald.conf",[1477,1644,1645,1650,1651,1460],{},[1480,1646,1647,1649],{},[18,1648,865],{}," is cleared on reboot",": the kernel ring buffer is in RAM. For persistent kernel logs, rely on ",[18,1652,1653],{},"journalctl -k",[1477,1655,1656,1664,1665,1523,1667,1670],{},[1480,1657,1658,1660,1661,1663],{},[18,1659,20],{}," with ",[18,1662,772],{}," loses lines",": lines written between the copy and truncate are lost. Prefer ",[18,1666,814],{},[18,1668,1669],{},"postrotate"," (app reopens the new file).",[1477,1672,1673,1679,1680,1682,1683,1639,1686,1688,1689,1460],{},[1480,1674,1675,1678],{},[18,1676,1677],{},"\u002Fvar\u002Flog"," can fill up",": if logs aren't rotated or journald isn't size-limited, ",[18,1681,1677],{}," fills up. Set ",[18,1684,1685],{},"SystemMaxUse=",[18,1687,1642],{}," and configure ",[18,1690,20],{},[1477,1692,1693,1700,1701,1703],{},[1480,1694,1695,1580,1697,1699],{},[18,1696,1069],{},[18,1698,1571],{}," is enabled",": installing isn't enough — you must enable data collection. If you forget, ",[18,1702,1069],{}," shows \"No data.\"",[1477,1705,1706,1709,1710,1712,1713,1715,1716,1719],{},[1480,1707,1708],{},"Auth log locations differ by distro",": Debian\u002FUbuntu uses ",[18,1711,420],{},"; RHEL\u002FRocky uses ",[18,1714,423],{},". Use ",[18,1717,1718],{},"journalctl -u ssh"," for portability.",[1477,1721,1722,1725,1726,1729],{},[1480,1723,1724],{},"Remote syslog can leak sensitive data",": syslog is plain text over the network (unless you use TLS). Use TLS (",[18,1727,1728],{},"rsyslog"," supports it) or a VPN for log forwarding.",[1477,1731,1732,1735],{},[1480,1733,1734],{},"High-frequency logging can overwhelm journald",": journald rate-limits by default. If a service logs thousands of lines\u002Fsec, you may see \"Suppressed X messages.\"",[23,1737,1739],{"id":1738},"spot-the-bug","🧠 Spot the Bug",[14,1741,1742,1743,1746],{},"An admin sets up a web app as a systemd service. Logs are visible via ",[18,1744,1745],{},"journalctl -u myapp",". They want logs in a file too, so they add to the unit:",[28,1748,1750],{"className":1357,"code":1749,"language":1359,"meta":34,"style":34},"[Service]\nExecStart=\u002Fusr\u002Fbin\u002Fnode \u002Fopt\u002Fmyapp\u002Fserver.js >> \u002Fvar\u002Flog\u002Fmyapp.log 2>&1\n",[18,1751,1752,1756],{"__ignoreMap":34},[55,1753,1754],{"class":57,"line":58},[55,1755,1366],{"class":68},[55,1757,1758,1761],{"class":57,"line":65},[55,1759,1760],{"class":643},"ExecStart",[55,1762,1763],{"class":1374},"=\u002Fusr\u002Fbin\u002Fnode \u002Fopt\u002Fmyapp\u002Fserver.js >> \u002Fvar\u002Flog\u002Fmyapp.log 2>&1\n",[14,1765,1766,1767,1769,1770,1773],{},"After restart, ",[18,1768,1745],{}," shows nothing, and ",[18,1771,1772],{},"\u002Fvar\u002Flog\u002Fmyapp.log"," is owned by root. What went wrong?",[1775,1776,1777,1781,1784,1814,1819,1860,1867,1886],"details",{},[1778,1779,1780],"summary",{},"Answer",[14,1782,1783],{},"Two issues:",[1785,1786,1787,1801],"ol",{},[1477,1788,1789,1796,1797,1800],{},[1480,1790,1791,1792,1795],{},"The ",[18,1793,1794],{},">>"," redirect consumed stdout\u002Fstderr."," systemd captures stdout\u002Fstderr and sends them to journald. By redirecting ",[18,1798,1799],{},">> \u002Fvar\u002Flog\u002Fmyapp.log 2>&1",", nothing goes to stdout (it all goes to the file), so journald gets nothing.",[1477,1802,1803,1806,1807,1809,1810,1813],{},[1480,1804,1805],{},"The file is owned by root."," The ",[18,1808,1794],{}," redirect is performed by the shell systemd spawns (running as root or the specified user). If the app runs as ",[18,1811,1812],{},"appuser"," but the redirect created the file as root, the app can't write to it later.",[14,1815,1816],{},[1480,1817,1818],{},"Better approach — use systemd's built-in redirection:",[28,1820,1822],{"className":1357,"code":1821,"language":1359,"meta":34,"style":34},"[Service]\nExecStart=\u002Fusr\u002Fbin\u002Fnode \u002Fopt\u002Fmyapp\u002Fserver.js\nStandardOutput=journal\nStandardError=journal\n# Also append to a file:\nStandardOutput=append:\u002Fvar\u002Flog\u002Fmyapp.log\n",[18,1823,1824,1828,1835,1842,1848,1853],{"__ignoreMap":34},[55,1825,1826],{"class":57,"line":58},[55,1827,1366],{"class":68},[55,1829,1830,1832],{"class":57,"line":65},[55,1831,1760],{"class":643},[55,1833,1834],{"class":1374},"=\u002Fusr\u002Fbin\u002Fnode \u002Fopt\u002Fmyapp\u002Fserver.js\n",[55,1836,1837,1839],{"class":57,"line":85},[55,1838,1371],{"class":643},[55,1840,1841],{"class":1374},"=journal\n",[55,1843,1844,1846],{"class":57,"line":102},[55,1845,1383],{"class":643},[55,1847,1841],{"class":1374},[55,1849,1850],{"class":57,"line":113},[55,1851,1852],{"class":61},"# Also append to a file:\n",[55,1854,1855,1857],{"class":57,"line":130},[55,1856,1371],{"class":643},[55,1858,1859],{"class":1374},"=append:\u002Fvar\u002Flog\u002Fmyapp.log\n",[14,1861,1862,1863,1866],{},"Or use ",[18,1864,1865],{},"tee"," to split the stream:",[28,1868,1870],{"className":1357,"code":1869,"language":1359,"meta":34,"style":34},"[Service]\nExecStart=\u002Fbin\u002Fsh -c '\u002Fusr\u002Fbin\u002Fnode \u002Fopt\u002Fmyapp\u002Fserver.js 2>&1 | tee -a \u002Fvar\u002Flog\u002Fmyapp.log'\n",[18,1871,1872,1876],{"__ignoreMap":34},[55,1873,1874],{"class":57,"line":58},[55,1875,1366],{"class":68},[55,1877,1878,1880,1883],{"class":57,"line":65},[55,1879,1760],{"class":643},[55,1881,1882],{"class":1374},"=\u002Fbin\u002Fsh -c ",[55,1884,1885],{"class":78},"'\u002Fusr\u002Fbin\u002Fnode \u002Fopt\u002Fmyapp\u002Fserver.js 2>&1 | tee -a \u002Fvar\u002Flog\u002Fmyapp.log'\n",[14,1887,1888,1889,1892,1893,1896],{},"But the cleanest production approach is to let journald handle logging and use ",[18,1890,1891],{},"journalctl -u myapp -f"," for live viewing, ",[18,1894,1895],{},"journalctl -u myapp --since today -o cat > \u002Fvar\u002Flog\u002Fmyapp.log"," for export.",[1898,1899,1900],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}",{"title":34,"searchDepth":65,"depth":65,"links":1902},[1903,1904,1909,1914,1919,1924,1930,1932,1933,1934,1935,1936],{"id":25,"depth":65,"text":26},{"id":39,"depth":65,"text":1905,"children":1906},"journalctl — The Log Viewer",[1907,1908],{"id":202,"depth":85,"text":203},{"id":290,"depth":85,"text":291},{"id":373,"depth":65,"text":1910,"children":1911},"Traditional Syslog (\u002Fvar\u002Flog\u002F)",[1912,1913],{"id":481,"depth":85,"text":482},{"id":546,"depth":85,"text":547},{"id":610,"depth":65,"text":1915,"children":1916},"logrotate — Manage Log Size",[1917],{"id":768,"depth":85,"text":1918},"Caveat: copytruncate Loses Lines",{"id":861,"depth":65,"text":1920,"children":1921},"Kernel Logs — dmesg",[1922],{"id":925,"depth":85,"text":1923},"Common dmesg Messages",{"id":999,"depth":65,"text":1000,"children":1925},[1926,1928],{"id":1120,"depth":85,"text":1927},"sar — Historical Performance",{"id":1240,"depth":85,"text":1929},"Edge Case: sar Shows \"No Data\" If Not Enabled",{"id":1286,"depth":65,"text":1931},"atop — Historical Per-Process",{"id":1350,"depth":65,"text":1351},{"id":1434,"depth":65,"text":1435},{"id":1471,"depth":65,"text":1472},{"id":1615,"depth":65,"text":1616},{"id":1738,"depth":65,"text":1739},"Logs are how you know what's happening on your system. This chapter covers systemd-journald (the modern default), traditional syslog, logrotate, kernel logs, and real-time monitoring tools — through the lens of production diagnostics and post-incident forensics.","md",{},"\u002Flinux\u002F12-logging-and-monitoring",{"title":5,"description":1937},"linux\u002F12-logging-and-monitoring","FK5OOeZfcjQqgPII5Sh581IBp-iFgZWr694E1buLmUc",1789140923576]