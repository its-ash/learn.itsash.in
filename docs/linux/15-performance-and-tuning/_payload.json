[{"data":1,"prerenderedAt":2051},["ShallowReactive",2],{"page-\u002Flinux\u002F15-performance-and-tuning":3},{"id":4,"title":5,"body":6,"description":2044,"extension":2045,"meta":2046,"navigation":205,"path":2047,"seo":2048,"stem":2049,"__hash__":2050},"content\u002Flinux\u002F15-performance-and-tuning.md","15 — Performance & Tuning",{"type":7,"value":8,"toc":2007},"minimark",[9,13,22,27,146,152,155,160,228,232,339,349,413,437,441,495,501,581,591,594,601,630,653,660,687,691,773,777,894,899,942,945,952,1005,1061,1111,1118,1193,1196,1200,1271,1275,1330,1337,1445,1449,1511,1516,1520,1642,1646,1799,1803,1809,1833,1848,2003],[10,11,5],"h1",{"id":12},"_15-performance-tuning",[14,15,16,17,21],"p",{},"Linux performance tuning is about finding the ",[18,19,20],"strong",{},"bottleneck"," (CPU, memory, disk I\u002FO, network) and addressing it — without making things worse. This chapter covers the tools to identify bottlenecks, the tuning knobs, and the kernel's built-in responses (OOM killer, swappiness).",[23,24,26],"h2",{"id":25},"the-four-resources","The Four Resources",[28,29,30,46],"table",{},[31,32,33],"thead",{},[34,35,36,40,43],"tr",{},[37,38,39],"th",{},"Resource",[37,41,42],{},"Symptom",[37,44,45],{},"Tool",[47,48,49,73,94,122],"tbody",{},[34,50,51,57,60],{},[52,53,54],"td",{},[18,55,56],{},"CPU",[52,58,59],{},"High load, slow response",[52,61,62,66,67,66,70],{},[63,64,65],"code",{},"top",", ",[63,68,69],{},"mpstat",[63,71,72],{},"perf",[34,74,75,80,83],{},[52,76,77],{},[18,78,79],{},"Memory",[52,81,82],{},"OOM, swapping, slow",[52,84,85,66,88,66,91],{},[63,86,87],{},"free",[63,89,90],{},"vmstat",[63,92,93],{},"\u002Fproc\u002Fmeminfo",[34,95,96,101,111],{},[52,97,98],{},[18,99,100],{},"Disk I\u002FO",[52,102,103,104,66,107,110],{},"High ",[63,105,106],{},"await",[63,108,109],{},"%util",", slow apps",[52,112,113,66,116,66,119],{},[63,114,115],{},"iostat",[63,117,118],{},"iotop",[63,120,121],{},"pidstat -d",[34,123,124,129,132],{},[52,125,126],{},[18,127,128],{},"Network",[52,130,131],{},"High latency, low throughput",[52,133,134,66,137,66,140,66,143],{},[63,135,136],{},"iftop",[63,138,139],{},"nethogs",[63,141,142],{},"ss",[63,144,145],{},"mtr",[14,147,148,151],{},[18,149,150],{},"Find the bottleneck first, then tune."," Tuning the wrong resource is at best useless and at worst harmful.",[23,153,56],{"id":154},"cpu",[156,157,159],"h3",{"id":158},"load-average","Load Average",[161,162,164],"code-wrapper",{"language":163},"bash",[165,166,170],"pre",{"className":167,"code":168,"language":163,"meta":169,"style":169},"language-bash shiki shiki-themes github-light github-dark","# Complex Implementation: interpret load average correctly\nuptime\n# ... load average: 1.45, 0.92, 0.78\n#                   1m   5m   15m\n\nnproc                           # CPU count\n# Load = 4 on a 4-core system = fully utilized (good)\n# Load = 8 on a 4-core system = overloaded (processes waiting)\n","",[63,171,172,181,188,194,200,207,216,222],{"__ignoreMap":169},[173,174,177],"span",{"class":175,"line":176},"line",1,[173,178,180],{"class":179},"sdCPZ","# Complex Implementation: interpret load average correctly\n",[173,182,184],{"class":175,"line":183},2,[173,185,187],{"class":186},"sIsaT","uptime\n",[173,189,191],{"class":175,"line":190},3,[173,192,193],{"class":179},"# ... load average: 1.45, 0.92, 0.78\n",[173,195,197],{"class":175,"line":196},4,[173,198,199],{"class":179},"#                   1m   5m   15m\n",[173,201,203],{"class":175,"line":202},5,[173,204,206],{"emptyLinePlaceholder":205},true,"\n",[173,208,210,213],{"class":175,"line":209},6,[173,211,212],{"class":186},"nproc",[173,214,215],{"class":179},"                           # CPU count\n",[173,217,219],{"class":175,"line":218},7,[173,220,221],{"class":179},"# Load = 4 on a 4-core system = fully utilized (good)\n",[173,223,225],{"class":175,"line":224},8,[173,226,227],{"class":179},"# Load = 8 on a 4-core system = overloaded (processes waiting)\n",[156,229,231],{"id":230},"edge-case-high-load-isnt-always-cpu","Edge Case: High Load Isn't Always CPU",[161,233,234],{"language":163},[165,235,237],{"className":167,"code":236,"language":163,"meta":169,"style":169},"# Complex Implementation: diagnose \"high load but CPU looks fine\"\nuptime                          # load average: 16.20, 15.85, 15.70\ntop -b -n 1 | head -5           # CPU: 20% us, 80% id (mostly idle!)\nnproc                           # 4 cores → load 16 = 4x overloaded\n\n# But CPU is idle — where's the bottleneck?\nvmstat 1                        # check the \"b\" and \"wa\" columns\n#  r b  ... wa\n#  0 14 ... 65\n# b=14 (14 processes in D state = uninterruptible I\u002FO wait)\n# wa=65 (65% I\u002FO wait)\n# → The bottleneck is DISK I\u002FO, not CPU!\n# Load average includes D-state processes, so high load + low CPU = disk bottleneck\n",[63,238,239,244,252,279,286,290,295,304,309,315,321,327,333],{"__ignoreMap":169},[173,240,241],{"class":175,"line":176},[173,242,243],{"class":179},"# Complex Implementation: diagnose \"high load but CPU looks fine\"\n",[173,245,246,249],{"class":175,"line":183},[173,247,248],{"class":186},"uptime",[173,250,251],{"class":179},"                          # load average: 16.20, 15.85, 15.70\n",[173,253,254,256,260,263,266,270,273,276],{"class":175,"line":190},[173,255,65],{"class":186},[173,257,259],{"class":258},"snvgF"," -b",[173,261,262],{"class":258}," -n",[173,264,265],{"class":258}," 1",[173,267,269],{"class":268},"svdQ7"," |",[173,271,272],{"class":186}," head",[173,274,275],{"class":258}," -5",[173,277,278],{"class":179},"           # CPU: 20% us, 80% id (mostly idle!)\n",[173,280,281,283],{"class":175,"line":196},[173,282,212],{"class":186},[173,284,285],{"class":179},"                           # 4 cores → load 16 = 4x overloaded\n",[173,287,288],{"class":175,"line":202},[173,289,206],{"emptyLinePlaceholder":205},[173,291,292],{"class":175,"line":209},[173,293,294],{"class":179},"# But CPU is idle — where's the bottleneck?\n",[173,296,297,299,301],{"class":175,"line":218},[173,298,90],{"class":186},[173,300,265],{"class":258},[173,302,303],{"class":179},"                        # check the \"b\" and \"wa\" columns\n",[173,305,306],{"class":175,"line":224},[173,307,308],{"class":179},"#  r b  ... wa\n",[173,310,312],{"class":175,"line":311},9,[173,313,314],{"class":179},"#  0 14 ... 65\n",[173,316,318],{"class":175,"line":317},10,[173,319,320],{"class":179},"# b=14 (14 processes in D state = uninterruptible I\u002FO wait)\n",[173,322,324],{"class":175,"line":323},11,[173,325,326],{"class":179},"# wa=65 (65% I\u002FO wait)\n",[173,328,330],{"class":175,"line":329},12,[173,331,332],{"class":179},"# → The bottleneck is DISK I\u002FO, not CPU!\n",[173,334,336],{"class":175,"line":335},13,[173,337,338],{"class":179},"# Load average includes D-state processes, so high load + low CPU = disk bottleneck\n",[156,340,342,343,345,346,348],{"id":341},"cpu-states-from-vmstat-mpstat","CPU States (from ",[63,344,90],{}," \u002F ",[63,347,69],{},")",[28,350,351,361],{},[31,352,353],{},[34,354,355,358],{},[37,356,357],{},"State",[37,359,360],{},"Meaning",[47,362,363,373,383,393,403],{},[34,364,365,370],{},[52,366,367],{},[63,368,369],{},"us",[52,371,372],{},"User space (applications)",[34,374,375,380],{},[52,376,377],{},[63,378,379],{},"sy",[52,381,382],{},"System\u002Fkernel (syscalls, drivers)",[34,384,385,390],{},[52,386,387],{},[63,388,389],{},"id",[52,391,392],{},"Idle",[34,394,395,400],{},[52,396,397],{},[63,398,399],{},"wa",[52,401,402],{},"I\u002FO wait (waiting for disk)",[34,404,405,410],{},[52,406,407],{},[63,408,409],{},"st",[52,411,412],{},"Stolen (hypervisor took it — VM only)",[414,415,416,422,427,432],"ul",{},[417,418,103,419,421],"li",{},[63,420,369],{}," = CPU-bound app (optimize the app or scale).",[417,423,103,424,426],{},[63,425,379],{}," (>20%) = too many syscalls, kernel work, or driver issue.",[417,428,103,429,431],{},[63,430,399],{}," = disk bottleneck (not CPU!).",[417,433,103,434,436],{},[63,435,409],{}," = noisy neighbor on the VM host.",[156,438,440],{"id":439},"cpu-priority","CPU Priority",[161,442,443],{"language":163},[165,444,446],{"className":167,"code":445,"language":163,"meta":169,"style":169},"# Complex Implementation: low-priority backup job (CPU + I\u002FO)\nnice -n 19 ionice -c 3 tar -czf backup.tar.gz \u002Fhome\n# nice: low CPU priority (19 = lowest)\n# ionice -c 3: idle I\u002FO class (only uses disk when no one else does)\n",[63,447,448,453,485,490],{"__ignoreMap":169},[173,449,450],{"class":175,"line":176},[173,451,452],{"class":179},"# Complex Implementation: low-priority backup job (CPU + I\u002FO)\n",[173,454,455,458,460,463,467,470,473,476,479,482],{"class":175,"line":183},[173,456,457],{"class":186},"nice",[173,459,262],{"class":258},[173,461,462],{"class":258}," 19",[173,464,466],{"class":465},"sJ6F3"," ionice",[173,468,469],{"class":258}," -c",[173,471,472],{"class":258}," 3",[173,474,475],{"class":465}," tar",[173,477,478],{"class":258}," -czf",[173,480,481],{"class":465}," backup.tar.gz",[173,483,484],{"class":465}," \u002Fhome\n",[173,486,487],{"class":175,"line":190},[173,488,489],{"class":179},"# nice: low CPU priority (19 = lowest)\n",[173,491,492],{"class":175,"line":196},[173,493,494],{"class":179},"# ionice -c 3: idle I\u002FO class (only uses disk when no one else does)\n",[156,496,498,500],{"id":497},"perf-profiling",[63,499,72],{}," — Profiling",[161,502,503],{"language":163},[165,504,506],{"className":167,"code":505,"language":163,"meta":169,"style":169},"# Complex Implementation: find the exact function using CPU\nsudo perf top                    # live function-level profiling\nsudo perf record -p 1234 -- sleep 10   # record for 10s\nsudo perf report                 # analyze the recording\nsudo perf stat command           # counter stats (cache misses, branches)\n",[63,507,508,513,527,554,566],{"__ignoreMap":169},[173,509,510],{"class":175,"line":176},[173,511,512],{"class":179},"# Complex Implementation: find the exact function using CPU\n",[173,514,515,518,521,524],{"class":175,"line":183},[173,516,517],{"class":186},"sudo",[173,519,520],{"class":465}," perf",[173,522,523],{"class":465}," top",[173,525,526],{"class":179},"                    # live function-level profiling\n",[173,528,529,531,533,536,539,542,545,548,551],{"class":175,"line":190},[173,530,517],{"class":186},[173,532,520],{"class":465},[173,534,535],{"class":465}," record",[173,537,538],{"class":258}," -p",[173,540,541],{"class":258}," 1234",[173,543,544],{"class":258}," --",[173,546,547],{"class":465}," sleep",[173,549,550],{"class":258}," 10",[173,552,553],{"class":179},"   # record for 10s\n",[173,555,556,558,560,563],{"class":175,"line":196},[173,557,517],{"class":186},[173,559,520],{"class":465},[173,561,562],{"class":465}," report",[173,564,565],{"class":179},"                 # analyze the recording\n",[173,567,568,570,572,575,578],{"class":175,"line":202},[173,569,517],{"class":186},[173,571,520],{"class":465},[173,573,574],{"class":465}," stat",[173,576,577],{"class":465}," command",[173,579,580],{"class":179},"           # counter stats (cache misses, branches)\n",[14,582,583,585,586,590],{},[63,584,72],{}," shows ",[587,588,589],"em",{},"which function"," is using the CPU — essential for optimizing a slow app.",[23,592,79],{"id":593},"memory",[156,595,597,598],{"id":596},"understanding-free-h","Understanding ",[63,599,600],{},"free -h",[161,602,603],{"language":163},[165,604,606],{"className":167,"code":605,"language":163,"meta":169,"style":169},"free -h\n#               total   used    free   shared  buff\u002Fcache  available\n# Mem:           15G     4.2G    2.1G   210M    9.3G         10G\n# Swap:         2.0G     0B     2.0G\n",[63,607,608,615,620,625],{"__ignoreMap":169},[173,609,610,612],{"class":175,"line":176},[173,611,87],{"class":186},[173,613,614],{"class":258}," -h\n",[173,616,617],{"class":175,"line":183},[173,618,619],{"class":179},"#               total   used    free   shared  buff\u002Fcache  available\n",[173,621,622],{"class":175,"line":190},[173,623,624],{"class":179},"# Mem:           15G     4.2G    2.1G   210M    9.3G         10G\n",[173,626,627],{"class":175,"line":196},[173,628,629],{"class":179},"# Swap:         2.0G     0B     2.0G\n",[414,631,632,645],{},[417,633,634,637,638,641,642,644],{},[18,635,636],{},"available"," — estimate of RAM available for new apps (free + reclaimable cache). ",[18,639,640],{},"This is the number to watch",", not ",[63,643,87],{},".",[417,646,647,649,650,652],{},[18,648,87],{}," — completely unused RAM. Linux uses free RAM for cache (making things faster). ",[63,651,87],{}," near 0 is normal and fine.",[156,654,656,657,659],{"id":655},"edge-case-low-free-is-normal","Edge Case: Low ",[63,658,87],{}," Is Normal",[161,661,662],{"language":163},[165,663,665],{"className":167,"code":664,"language":163,"meta":169,"style":169},"# NAIVE: panic at low free RAM and add swap (unnecessary)\n# \"free is only 200 MB! We need more swap!\"\n# PRODUCTION: check \"available\" instead\n# available = 10 GB → plenty of memory. free is low because Linux uses RAM for cache.\n",[63,666,667,672,677,682],{"__ignoreMap":169},[173,668,669],{"class":175,"line":176},[173,670,671],{"class":179},"# NAIVE: panic at low free RAM and add swap (unnecessary)\n",[173,673,674],{"class":175,"line":183},[173,675,676],{"class":179},"# \"free is only 200 MB! We need more swap!\"\n",[173,678,679],{"class":175,"line":190},[173,680,681],{"class":179},"# PRODUCTION: check \"available\" instead\n",[173,683,684],{"class":175,"line":196},[173,685,686],{"class":179},"# available = 10 GB → plenty of memory. free is low because Linux uses RAM for cache.\n",[156,688,690],{"id":689},"swap","Swap",[161,692,693],{"language":163},[165,694,696],{"className":167,"code":695,"language":163,"meta":169,"style":169},"swapon --show                   # active swap\ncat \u002Fproc\u002Fsys\u002Fvm\u002Fswappiness     # tendency to swap (0-100, default 60)\nvmstat 1                        # si\u002Fso columns = swap in\u002Fout (should be 0)\n\n# Tune swappiness:\nsudo sysctl vm.swappiness=10    # servers: 10, databases: 1\necho \"vm.swappiness = 10\" | sudo tee \u002Fetc\u002Fsysctl.d\u002F99-swappiness.conf\n",[63,697,698,709,720,729,733,738,754],{"__ignoreMap":169},[173,699,700,703,706],{"class":175,"line":176},[173,701,702],{"class":186},"swapon",[173,704,705],{"class":258}," --show",[173,707,708],{"class":179},"                   # active swap\n",[173,710,711,714,717],{"class":175,"line":183},[173,712,713],{"class":186},"cat",[173,715,716],{"class":465}," \u002Fproc\u002Fsys\u002Fvm\u002Fswappiness",[173,718,719],{"class":179},"     # tendency to swap (0-100, default 60)\n",[173,721,722,724,726],{"class":175,"line":190},[173,723,90],{"class":186},[173,725,265],{"class":258},[173,727,728],{"class":179},"                        # si\u002Fso columns = swap in\u002Fout (should be 0)\n",[173,730,731],{"class":175,"line":196},[173,732,206],{"emptyLinePlaceholder":205},[173,734,735],{"class":175,"line":202},[173,736,737],{"class":179},"# Tune swappiness:\n",[173,739,740,742,745,748,751],{"class":175,"line":209},[173,741,517],{"class":186},[173,743,744],{"class":465}," sysctl",[173,746,747],{"class":465}," vm.swappiness=",[173,749,750],{"class":258},"10",[173,752,753],{"class":179},"    # servers: 10, databases: 1\n",[173,755,756,759,762,764,767,770],{"class":175,"line":218},[173,757,758],{"class":258},"echo",[173,760,761],{"class":465}," \"vm.swappiness = 10\"",[173,763,269],{"class":268},[173,765,766],{"class":186}," sudo",[173,768,769],{"class":465}," tee",[173,771,772],{"class":465}," \u002Fetc\u002Fsysctl.d\u002F99-swappiness.conf\n",[156,774,776],{"id":775},"oom-killer","OOM Killer",[161,778,779],{"language":163},[165,780,782],{"className":167,"code":781,"language":163,"meta":169,"style":169},"# Complex Implementation: protect critical services from OOM killer\n# The OOM killer picks the process with the highest oom_score (biggest memory consumer)\n# — which might be your database, not the misbehaving app\n\n# Check a process's OOM score:\ncat \u002Fproc\u002F\u003Cpid>\u002Foom_score\n\n# Protect a service (in systemd unit):\n# [Service]\n# OOMScoreAdjust=-500      # protect this service (lower = less likely killed)\n\n# Check OOM kills:\njournalctl -k | grep -i \"out of memory\"\njournalctl -k | grep -i \"killed process\"\n",[63,783,784,789,794,799,803,808,831,835,840,845,850,854,859,878],{"__ignoreMap":169},[173,785,786],{"class":175,"line":176},[173,787,788],{"class":179},"# Complex Implementation: protect critical services from OOM killer\n",[173,790,791],{"class":175,"line":183},[173,792,793],{"class":179},"# The OOM killer picks the process with the highest oom_score (biggest memory consumer)\n",[173,795,796],{"class":175,"line":190},[173,797,798],{"class":179},"# — which might be your database, not the misbehaving app\n",[173,800,801],{"class":175,"line":196},[173,802,206],{"emptyLinePlaceholder":205},[173,804,805],{"class":175,"line":202},[173,806,807],{"class":179},"# Check a process's OOM score:\n",[173,809,810,812,815,818,821,825,828],{"class":175,"line":209},[173,811,713],{"class":186},[173,813,814],{"class":465}," \u002Fproc\u002F",[173,816,817],{"class":268},"\u003C",[173,819,820],{"class":465},"pi",[173,822,824],{"class":823},"ssxIu","d",[173,826,827],{"class":268},">",[173,829,830],{"class":465},"\u002Foom_score\n",[173,832,833],{"class":175,"line":218},[173,834,206],{"emptyLinePlaceholder":205},[173,836,837],{"class":175,"line":224},[173,838,839],{"class":179},"# Protect a service (in systemd unit):\n",[173,841,842],{"class":175,"line":311},[173,843,844],{"class":179},"# [Service]\n",[173,846,847],{"class":175,"line":317},[173,848,849],{"class":179},"# OOMScoreAdjust=-500      # protect this service (lower = less likely killed)\n",[173,851,852],{"class":175,"line":323},[173,853,206],{"emptyLinePlaceholder":205},[173,855,856],{"class":175,"line":329},[173,857,858],{"class":1