179},"              # max PIDs\n",[173,1400,1401,1404,1406,1408],{"class":175,"line":218},[173,1402,1403],{"class":823},"IOWeight",[173,1405,1366],{"class":268},[173,1407,1395],{"class":465},[173,1409,1410],{"class":179},"              # I\u002FO weight (1-10000)\n",[173,1412,1413],{"class":175,"line":224},[173,1414,206],{"emptyLinePlaceholder":205},[173,1416,1417],{"class":175,"line":311},[173,1418,1419],{"class":179},"# Ad-hoc:\n",[173,1421,1422,1424,1427,1430,1433,1436,1439,1442],{"class":175,"line":317},[173,1423,517],{"class":186},[173,1425,1426],{"class":465}," systemd-run",[173,1428,1429],{"class":258}," --unit=test",[173,1431,1432],{"class":258}," --CPUQuota=25%",[173,1434,1435],{"class":258}," --MemoryMax=256M",[173,1437,1438],{"class":465}," stress",[173,1440,1441],{"class":258}," --cpu",[173,1443,1444],{"class":258}," 4\n",[23,1446,1448],{"id":1447},"quick-diagnostic-flow","Quick Diagnostic Flow",[1450,1451,1452,1471,1485,1500],"ol",{},[417,1453,1454,1457,1458,1460,1461,1464,1465,1467,1468,1470],{},[18,1455,1456],{},"Is it CPU?"," ",[63,1459,248],{}," (high load?), ",[63,1462,1463],{},"vmstat 1"," (high ",[63,1466,369],{},"\u002F",[63,1469,379],{},"?).",[417,1472,1473,1457,1476,1478,1479,1481,1482,1484],{},[18,1474,1475],{},"Is it memory?",[63,1477,600],{}," (low ",[63,1480,636],{},"?), ",[63,1483,1463],{}," (si\u002Fso non-zero?).",[417,1486,1487,1457,1490,1464,1493,1467,1495,1481,1497,1499],{},[18,1488,1489],{},"Is it disk?",[63,1491,1492],{},"iostat -x 1",[63,1494,109],{},[63,1496,106],{},[63,1498,118],{}," (which process?).",[417,1501,1502,1457,1505,1507,1508,1510],{},[18,1503,1504],{},"Is it network?",[63,1506,136],{}," (bandwidth?), ",[63,1509,145],{}," (latency\u002Floss?).",[14,1512,1513],{},[18,1514,1515],{},"Don't tune until you've identified the bottleneck.",[23,1517,1519],{"id":1518},"tips-tricks","💡 Tips & Tricks",[414,1521,1522,1543,1558,1573,1582,1595,1613,1634],{},[417,1523,1524,1527,1528,1530,1531,1533,1534,1536,1537,1539,1540,1542],{},[18,1525,1526],{},"Idiom",": use ",[63,1529,600],{}," and watch ",[63,1532,636],{}," (not ",[63,1535,87],{},") — Linux uses free RAM for cache (good). ",[63,1538,636],{}," is what apps can actually use. Low ",[63,1541,636],{}," = memory pressure.",[417,1544,1545,1527,1547,1530,1549,1551,1552,1554,1555,1557],{},[18,1546,1526],{},[63,1548,1492],{},[63,1550,109],{}," + ",[63,1553,106],{}," — ",[63,1556,109],{}," near 100% = disk saturated. This is the #1 cause of \"the app is slow\" — usually disk, not CPU.",[417,1559,1560,1527,1562,1551,1565,1568,1569,1572],{},[18,1561,1526],{},[63,1563,1564],{},"nice -n 19",[63,1566,1567],{},"ionice -c3"," for non-urgent heavy jobs — backups, ",[63,1570,1571],{},"find \u002F",", indexing. Prevents heavy jobs from disrupting interactive work.",[417,1574,1575,1577,1578,1581],{},[18,1576,1526],{},": set ",[63,1579,1580],{},"vm.swappiness=10"," on servers (1 for databases) — default 60 swaps too eagerly for production.",[417,1583,1584,1586,1587,1590,1591,1594],{},[18,1585,1526],{},": use systemd ",[63,1588,1589],{},"MemoryMax="," to limit service memory — prevents a buggy service from eating all RAM and triggering OOM killer (which might kill the ",[587,1592,1593],{},"wrong"," process).",[417,1596,1597,1527,1600,1602,1603,1605,1606,1609,1610,1612],{},[18,1598,1599],{},"Debug",[63,1601,1463],{}," and check ",[63,1604,399],{}," (I\u002FO wait) + ",[63,1607,1608],{},"b"," (blocked) — if load is high but ",[63,1611,369],{}," (user CPU) is low, the bottleneck is disk I\u002FO, not CPU. This is the most common \"high load but CPU looks fine\" mystery.",[417,1614,1615,1527,1617,1620,1621,1623,1624,1627,1628,1623,1630,1633],{},[18,1616,1599],{},[63,1618,1619],{},"perf top"," to find the exact function using CPU — ",[63,1622,65],{}," shows which ",[587,1625,1626],{},"process"," is busy, ",[63,1629,1619],{},[587,1631,1632],{},"function"," within it.",[417,1635,1636,1527,1638,1641],{},[18,1637,1599],{},[63,1639,1640],{},"journalctl -k | grep -i oom"," after a mysterious process death — the OOM killer logs which process it killed and why.",[23,1643,1645],{"id":1644},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[414,1647,1648,1666,1684,1705,1718,1741,1754,1771,1780,1793],{},[417,1649,1650,1653,1654,1657,1658,1554,1660,1662,1663,1665],{},[18,1651,1652],{},"High load average isn't always CPU",": load includes processes in ",[63,1655,1656],{},"D"," state (uninterruptible I\u002FO wait). High load + low CPU = disk bottleneck. Check ",[63,1659,90],{},[63,1661,1608],{}," (blocked) and ",[63,1664,399],{}," (I\u002FO wait) reveal the true cause.",[417,1667,1668,1673,1674,1676,1677,1679,1680,1683],{},[18,1669,1670,1672],{},[63,1671,87],{}," being low is normal",": Linux uses free RAM for page cache. ",[63,1675,87],{}," near 0 is expected. Watch ",[63,1678,636],{}," — if ",[587,1681,1682],{},"that's"," low, you're out of memory.",[417,1685,1686,1689,1690,1467,1693,1696,1697,1699,1700,1467,1702,1704],{},[18,1687,1688],{},"Swapping kills performance silently",": even small ",[63,1691,1692],{},"si",[63,1694,1695],{},"so"," in ",[63,1698,90],{}," causes huge latency spikes (disk is ~1000x slower than RAM). If ",[63,1701,1692],{},[63,1703,1695],{}," is non-zero, you have memory pressure.",[417,1706,1707,1710,1711,1714,1715,644],{},[18,1708,1709],{},"OOM killer may kill the wrong process",": it picks the highest ",[63,1712,1713],{},"oom_score"," (biggest memory user) — which might be your database. Protect with ",[63,1716,1717],{},"OOMScoreAdjust=-1000",[417,1719,1720,1725,1726,1729,1730,1732,1733,1467,1735,1737,1738,1740],{},[18,1721,1722,1724],{},[63,1723,457],{}," doesn't affect I\u002FO or memory",": a ",[63,1727,1728],{},"nice 19"," process still hammers the disk. Use ",[63,1731,1567],{}," for I\u002FO and ",[63,1734,1335],{},[63,1736,1377],{}," for memory. ",[63,1739,457],{}," is CPU-only.",[417,1742,1743,1749,1750,1753],{},[18,1744,1745,1748],{},[63,1746,1747],{},"ionice -c1"," (realtime) can starve the disk",": it blocks all other I\u002FO. Never use on a shared system. Use ",[63,1751,1752],{},"-c3"," (idle).",[417,1755,1756,1762,1763,1766,1767,1770],{},[18,1757,1758,1761],{},[63,1759,1760],{},"noatime"," can break some apps",": a few apps (like ",[63,1764,1765],{},"mutt",") rely on access times. ",[63,1768,1769],{},"relatime"," (default) is safer.",[417,1772,1773,1779],{},[18,1774,1775,1778],{},[63,1776,1777],{},"barrier=0"," risks data corruption on power loss",": faster but risks filesystem corruption. Don't use in production unless you have a battery-backed cache.",[417,1781,1782,1785,1786,66,1789,1792],{},[18,1783,1784],{},"Tuning can make things worse",": changing ",[63,1787,1788],{},"tcp_tw_reuse",[63,1790,1791],{},"dirty_ratio",", scheduler without measuring can degrade performance. Always benchmark before and after. Keep changes small and test one at a time.",[417,1794,1795,1798],{},[18,1796,1797],{},"BBR can hurt on some networks",": great on high-latency\u002Flossy links but can be aggressive on local networks. Test before deploying.",[23,1800,1802],{"id":1801},"spot-the-bug","🧠 Spot the Bug",[14,1804,1805,1806,1808],{},"A server is slow. The admin checks ",[63,1807,248],{},":",[161,1810,1811],{"language":163},[165,1812,1814],{"className":167,"code":1813,"language":163,"meta":169,"style":169},"load average: 16.20, 15.85, 15.70\n",[63,1815,1816],{"__ignoreMap":169},[173,1817,1818,1821,1824,1827,1830],{"class":175,"line":176},[173,1819,1820],{"class":186},"load",[173,1822,1823],{"class":465}," average:",[173,1825,1826],{"class":465}," 16.20,",[173,1828,1829],{"class":465}," 15.85,",[173,1831,1832],{"class":258}," 15.70\n",[14,1834,1835,1836,1838,1839,1841,1842,1844,1845,1847],{},"They check ",[63,1837,65],{}," — CPU usage is 20% (",[63,1840,369],{}," 15%, ",[63,1843,379],{}," 5%, ",[63,1846,389],{}," 80%). They conclude \"the load is wrong, CPU is mostly idle.\" They check CPU count: 4 cores. What's actually happening, and what should they check next?",[1849,1850,1851,1855,1867,1874,1879,1955,1958,1997],"details",{},[1852,1853,1854],"summary",{},"Answer",[14,1856,1857,1863,1864,1866],{},[18,1858,1859,1860,1862],{},"The load average includes processes in ",[63,1861,1656],{}," state (uninterruptible I\u002FO wait), not just CPU-bound processes."," Load 16 on a 4-core system with 80% idle CPU means ~14 processes are stuck in I\u002FO wait (state ",[63,1865,1656],{},"), not waiting for CPU.",[14,1868,1869,1870,1873],{},"The bottleneck is ",[18,1871,1872],{},"disk I\u002FO",", not CPU.",[14,1875,1876],{},[18,1877,1878],{},"Check:",[161,1880,1881],{"language":163},[165,1882,1884],{"className":167,"code":1883,"language":163,"meta":169,"style":169},"vmstat 1\n#  r  b  swpd  free  buff  cache  si  so  bi  bo  in  cs  us  sy  id  wa  st\n#  0  14     0 200M   1G    8G     0   0  40  80  ...  ...  15   5  20  60   0\n#                    ↑                                                ↑\n#  b=14 (14 processes in D state)                      wa=60 (60% I\u002FO wait)\n\niostat -x 1\n# Device  %util  await\n# sda      98     45.2\n# → disk is 98% utilized, 45ms average wait = saturated\n\niotop -o\n# → find which process is doing the I\u002FO\n",[63,1885,1886,1892,1897,1902,1907,1912,1916,1924,1929,1934,1939,1943,1950],{"__ignoreMap":169},[173,1887,1888,1890],{"class":175,"line":176},[173,1889,90],{"class":186},[173,1891,1251],{"class":258},[173,1893,1894],{"class":175,"line":183},[173,1895,1896],{"class":179},"#  r  b  swpd  free  buff  cache  si  so  bi  bo  in  cs  us  sy  id  wa  st\n",[173,1898,1899],{"class":175,"line":190},[173,1900,1901],{"class":179},"#  0  14     0 200M   1G    8G     0   0  40  80  ...  ...  15   5  20  60   0\n",[173,1903,1904],{"class":175,"line":196},[173,1905,1906],{"class":179},"#                    ↑                                                ↑\n",[173,1908,1909],{"class":175,"line":202},[173,1910,1911],{"class":179},"#  b=14 (14 processes in D state)                      wa=60 (60% I\u002FO wait)\n",[173,1913,1914],{"class":175,"line":209},[173,1915,206],{"emptyLinePlaceholder":205},[173,1917,1918,1920,1922],{"class":175,"line":218},[173,1919,115],{"class":186},[173,1921,1079],{"class":258},[173,1923,1251],{"class":258},[173,1925,1926],{"class":175,"line":224},[173,1927,1928],{"class":179},"# Device  %util  await\n",[173,1930,1931],{"class":175,"line":311},[173,1932,1933],{"class":179},"# sda      98     45.2\n",[173,1935,1936],{"class":175,"line":317},[173,1937,1938],{"class":179},"# → disk is 98% utilized, 45ms average wait = saturated\n",[173,1940,1941],{"class":175,"line":323},[173,1942,206],{"emptyLinePlaceholder":205},[173,1944,1945,1947],{"class":175,"line":329},[173,1946,118],{"class":186},[173,1948,1949],{"class":258}," -o\n",[173,1951,1952],{"class":175,"line":335},[173,1953,1954],{"class":179},"# → find which process is doing the I\u002FO\n",[14,1956,1957],{},"The fix depends on the cause:",[414,1959,1960,1966,1978,1991],{},[417,1961,1962,1965],{},[18,1963,1964],{},"Disk too slow",": upgrade to SSD, add more disks (RAID), or use a faster filesystem.",[417,1967,1968,1971,1972,1974,1975,1977],{},[18,1969,1970],{},"One process hogging I\u002FO",": ",[63,1973,1567],{}," the offender, or use ",[63,1976,1335],{}," to limit I\u002FO.",[417,1979,1980,1983,1984,1986,1987,1990],{},[18,1981,1982],{},"Memory pressure causing swap I\u002FO",": check ",[63,1985,600],{}," and ",[63,1988,1989],{},"vmstat si\u002Fso"," — add RAM or reduce memory usage.",[417,1992,1993,1996],{},[18,1994,1995],{},"Too many concurrent I\u002FO operations",": tune the application to batch writes or use async I\u002FO.",[14,1998,1999,2000],{},"The key insight: ",[18,2001,2002],{},"load average is not a CPU metric — it's a \"processes waiting for resources\" metric. High load + low CPU = I\u002FO bottleneck.",[2004,2005,2006],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}",{"title":169,"searchDepth":183,"depth":183,"links":2008},[2009,2010,2019,2028,2034,2038,2040,2041,2042,2043],{"id":25,"depth":183,"text":26},{"id":154,"depth":183,"text":56,"children":2011},[2012,2013,2014,2016,2017],{"id":158,"depth":190,"text":159},{"id":230,"depth":190,"text":231},{"id":341,"depth":190,"text":2015},"CPU States (from vmstat \u002F mpstat)",{"id":439,"depth":190,"text":440},{"id":497,"depth":190,"text":2018},"perf — Profiling",{"id":593,"depth":183,"text":79,"children":2020},[2021,2023,2025,2026,2027],{"id":596,"depth":190,"text":2022},"Understanding free -h",{"id":655,"depth":190,"text":2024},"Edge Case: Low free Is Normal",{"id":689,"depth":190,"text":690},{"id":775,"depth":190,"text":776},{"id":896,"depth":190,"text":896},{"id":944,"depth":183,"text":100,"children":2029},[2030,2032],{"id":947,"depth":190,"text":2031},"iostat -x Key Columns",{"id":1113,"depth":190,"text":2033},"I\u002FO Priority: ionice",{"id":1195,"depth":183,"text":128,"children":2035},[2036,2037],{"id":1198,"depth":190,"text":1199},{"id":1273,"depth":190,"text":1274},{"id":1332,"depth":183,"text":2039},"cgroups — Resource Limits",{"id":1447,"depth":183,"text":1448},{"id":1518,"depth":183,"text":1519},{"id":1644,"depth":183,"text":1645},{"id":1801,"depth":183,"text":1802},"Linux performance tuning is about finding the bottleneck (CPU, memory, disk I\u002FO, network) and addressing it — without making things worse. This chapter covers the tools to identify bottlenecks, the tuning knobs, and the kernel's built-in responses (OOM killer, swappiness).","md",{},"\u002Flinux\u002F15-performance-and-tuning",{"title":5,"description":2044},"linux\u002F15-performance-and-tuning","9qtNesJnROhIZVzWVM5STjmncSOxg711u8amDODOOmA",1789924650119]