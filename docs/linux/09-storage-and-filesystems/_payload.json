:142,"line":836},[140,1232,190],{"class":146},[140,1234,1158],{"class":164},[140,1236,1237],{"class":154},"                    # shows \"recovering\"\n",[140,1239,1240],{"class":142,"line":841},[140,1241,393],{"emptyLinePlaceholder":392},[140,1243,1244],{"class":142,"line":847},[140,1245,1246],{"class":154},"# Save config (so RAID assembles at boot):\n",[140,1248,1249,1251,1253,1256,1259,1261,1263,1265,1268],{"class":142,"line":865},[140,1250,161],{"class":146},[140,1252,1134],{"class":164},[140,1254,1255],{"class":150}," --detail",[140,1257,1258],{"class":150}," --scan",[140,1260,711],{"class":585},[140,1262,714],{"class":146},[140,1264,717],{"class":164},[140,1266,1267],{"class":150}," -a",[140,1269,1270],{"class":164}," \u002Fetc\u002Fmdadm\u002Fmdadm.conf\n",[140,1272,1273,1275,1278,1281],{"class":142,"line":878},[140,1274,161],{"class":146},[140,1276,1277],{"class":164}," update-initramfs",[140,1279,1280],{"class":150}," -u",[140,1282,1283],{"class":154},"            # Debian (so RAID is available at boot)\n",[423,1285,1287],{"id":1286},"edge-case-raid-is-not-a-backup","Edge Case: RAID Is Not a Backup",[130,1289,1290],{"language":132},[28,1291,1293],{"className":135,"code":1292,"language":132,"meta":34,"style":34},"# RAID protects against disk failure, NOT deletion, corruption, or ransomware.\n# A RAID 1 mirror replicates `rm -rf \u002F` to both disks instantly.\n# Always have off-site backups.\n",[18,1294,1295,1300,1305],{"__ignoreMap":34},[140,1296,1297],{"class":142,"line":143},[140,1298,1299],{"class":154},"# RAID protects against disk failure, NOT deletion, corruption, or ransomware.\n",[140,1301,1302],{"class":142,"line":158},[140,1303,1304],{"class":154},"# A RAID 1 mirror replicates `rm -rf \u002F` to both disks instantly.\n",[140,1306,1307],{"class":142,"line":174},[140,1308,1309],{"class":154},"# Always have off-site backups.\n",[23,1311,1313,1315],{"id":1312},"fsck-filesystem-check",[18,1314,20],{}," — Filesystem Check",[130,1317,1318],{"language":132},[28,1319,1321],{"className":135,"code":1320,"language":132,"meta":34,"style":34},"# Complex Implementation: repair a corrupted filesystem\n# — MUST be unmounted (running fsck on a mounted FS can corrupt it)\nsudo umount \u002Fdev\u002Fsdb1\nsudo fsck -y \u002Fdev\u002Fsdb1           # answer yes to all prompts\nsudo mount \u002Fdev\u002Fsdb1 \u002Fmnt\u002Fdata\n\n# For root filesystem: runs at boot from initramfs (before mount)\n# Force check at next boot: sudo touch \u002Fforcefsck\n",[18,1322,1323,1328,1333,1341,1356,1366,1370,1375],{"__ignoreMap":34},[140,1324,1325],{"class":142,"line":143},[140,1326,1327],{"class":154},"# Complex Implementation: repair a corrupted filesystem\n",[140,1329,1330],{"class":142,"line":158},[140,1331,1332],{"class":154},"# — MUST be unmounted (running fsck on a mounted FS can corrupt it)\n",[140,1334,1335,1337,1339],{"class":142,"line":174},[140,1336,161],{"class":146},[140,1338,962],{"class":164},[140,1340,371],{"class":164},[140,1342,1343,1345,1348,1351,1353],{"class":142,"line":187},[140,1344,161],{"class":146},[140,1346,1347],{"class":164}," fsck",[140,1349,1350],{"class":150}," -y",[140,1352,760],{"class":164},[140,1354,1355],{"class":154},"           # answer yes to all prompts\n",[140,1357,1358,1360,1362,1364],{"class":142,"line":313},[140,1359,161],{"class":146},[140,1361,548],{"class":164},[140,1363,760],{"class":164},[140,1365,833],{"class":164},[140,1367,1368],{"class":142,"line":389},[140,1369,393],{"emptyLinePlaceholder":392},[140,1371,1372],{"class":142,"line":396},[140,1373,1374],{"class":154},"# For root filesystem: runs at boot from initramfs (before mount)\n",[140,1376,1377],{"class":142,"line":410},[140,1378,1379],{"class":154},"# Force check at next boot: sudo touch \u002Fforcefsck\n",[423,1381,555,1383,1385],{"id":1382},"edge-case-fsck-on-a-mounted-filesystem-can-corrupt-it",[18,1384,20],{}," on a Mounted Filesystem Can Corrupt It",[130,1387,1388],{"language":132},[28,1389,1391],{"className":135,"code":1390,"language":132,"meta":34,"style":34},"# NAIVE: fsck on a mounted ext4\u002Fxfs\nsudo fsck \u002Fdev\u002Fsdb1               # while \u002Fdev\u002Fsdb1 is mounted → CORRUPTION\n# PRODUCTION: unmount first\nsudo umount \u002Fdev\u002Fsdb1 && sudo fsck -y \u002Fdev\u002Fsdb1\n# For root: boot from live USB \u002F rescue mode\n",[18,1392,1393,1398,1409,1414,1433],{"__ignoreMap":34},[140,1394,1395],{"class":142,"line":143},[140,1396,1397],{"class":154},"# NAIVE: fsck on a mounted ext4\u002Fxfs\n",[140,1399,1400,1402,1404,1406],{"class":142,"line":158},[140,1401,161],{"class":146},[140,1403,1347],{"class":164},[140,1405,760],{"class":164},[140,1407,1408],{"class":154},"               # while \u002Fdev\u002Fsdb1 is mounted → CORRUPTION\n",[140,1410,1411],{"class":142,"line":174},[140,1412,1413],{"class":154},"# PRODUCTION: unmount first\n",[140,1415,1416,1418,1420,1422,1425,1427,1429,1431],{"class":142,"line":187},[140,1417,161],{"class":146},[140,1419,962],{"class":164},[140,1421,760],{"class":164},[140,1423,1424],{"class":581}," && ",[140,1426,161],{"class":146},[140,1428,1347],{"class":164},[140,1430,1350],{"class":150},[140,1432,371],{"class":164},[140,1434,1435],{"class":142,"line":313},[140,1436,1437],{"class":154},"# For root: boot from live USB \u002F rescue mode\n",[23,1439,1441],{"id":1440},"smart-disk-health","SMART — Disk Health",[130,1443,1444],{"language":132},[28,1445,1447],{"className":135,"code":1446,"language":132,"meta":34,"style":34},"# Complex Implementation: automated disk failure detection\nsudo smartctl -H \u002Fdev\u002Fsda             # health status (PASSED\u002FFAILED)\nsudo smartctl -a \u002Fdev\u002Fsda             # all SMART attributes\nsudo smartctl -t long \u002Fdev\u002Fsda         # long self-test (hours)\n\n# Watch these attributes (non-zero + growing = failing disk):\n# Reallocated_Sector_Ct (5)\n# Current_Pending_Sector (197)\n# Offline_Uncorrectable (198)\n",[18,1448,1449,1454,1470,1483,1499,1503,1508,1513,1518],{"__ignoreMap":34},[140,1450,1451],{"class":142,"line":143},[140,1452,1453],{"class":154},"# Complex Implementation: automated disk failure detection\n",[140,1455,1456,1458,1461,1464,1467],{"class":142,"line":158},[140,1457,161],{"class":146},[140,1459,1460],{"class":164}," smartctl",[140,1462,1463],{"class":150}," -H",[140,1465,1466],{"class":164}," \u002Fdev\u002Fsda",[140,1468,1469],{"class":154},"             # health status (PASSED\u002FFAILED)\n",[140,1471,1472,1474,1476,1478,1480],{"class":142,"line":174},[140,1473,161],{"class":146},[140,1475,1460],{"class":164},[140,1477,1267],{"class":150},[140,1479,1466],{"class":164},[140,1481,1482],{"class":154},"             # all SMART attributes\n",[140,1484,1485,1487,1489,1491,1494,1496],{"class":142,"line":187},[140,1486,161],{"class":146},[140,1488,1460],{"class":164},[140,1490,302],{"class":150},[140,1492,1493],{"class":164}," long",[140,1495,1466],{"class":164},[140,1497,1498],{"class":154},"         # long self-test (hours)\n",[140,1500,1501],{"class":142,"line":313},[140,1502,393],{"emptyLinePlaceholder":392},[140,1504,1505],{"class":142,"line":389},[140,1506,1507],{"class":154},"# Watch these attributes (non-zero + growing = failing disk):\n",[140,1509,1510],{"class":142,"line":396},[140,1511,1512],{"class":154},"# Reallocated_Sector_Ct (5)\n",[140,1514,1515],{"class":142,"line":410},[140,1516,1517],{"class":154},"# Current_Pending_Sector (197)\n",[140,1519,1520],{"class":142,"line":685},[140,1521,1522],{"class":154},"# Offline_Uncorrectable (198)\n",[23,1524,1526,1529],{"id":1525},"dd-low-level-copy",[18,1527,1528],{},"dd"," — Low-Level Copy",[130,1531,1532],{"language":132},[28,1533,1535],{"className":135,"code":1534,"language":132,"meta":34,"style":34},"# Complex Implementation: clone a disk (sector-by-sector)\nsudo dd if=\u002Fdev\u002Fsda of=\u002Fdev\u002Fsdb bs=4M status=progress\n# — target must be same size or larger\n# — dd respects EXACTLY what you type; if= and of= are one char apart\n# — DOUBLE-CHECK of= before pressing Enter\n\n# Write an ISO to a USB:\nsudo dd if=ubuntu.iso of=\u002Fdev\u002Fsdb bs=4M status=progress conv=fsync\n# (use \u002Fdev\u002Fsdb, the whole disk, NOT \u002Fdev\u002Fsdb1)\n",[18,1536,1537,1542,1561,1566,1571,1576,1580,1585,1604],{"__ignoreMap":34},[140,1538,1539],{"class":142,"line":143},[140,1540,1541],{"class":154},"# Complex Implementation: clone a disk (sector-by-sector)\n",[140,1543,1544,1546,1549,1552,1555,1558],{"class":142,"line":158},[140,1545,161],{"class":146},[140,1547,1548],{"class":164}," dd",[140,1550,1551],{"class":164}," if=\u002Fdev\u002Fsda",[140,1553,1554],{"class":164}," of=\u002Fdev\u002Fsdb",[140,1556,1557],{"class":164}," bs=4M",[140,1559,1560],{"class":164}," status=progress\n",[140,1562,1563],{"class":142,"line":174},[140,1564,1565],{"class":154},"# — target must be same size or larger\n",[140,1567,1568],{"class":142,"line":187},[140,1569,1570],{"class":154},"# — dd respects EXACTLY what you type; if= and of= are one char apart\n",[140,1572,1573],{"class":142,"line":313},[140,1574,1575],{"class":154},"# — DOUBLE-CHECK of= before pressing Enter\n",[140,1577,1578],{"class":142,"line":389},[140,1579,393],{"emptyLinePlaceholder":392},[140,1581,1582],{"class":142,"line":396},[140,1583,1584],{"class":154},"# Write an ISO to a USB:\n",[140,1586,1587,1589,1591,1594,1596,1598,1601],{"class":142,"line":410},[140,1588,161],{"class":146},[140,1590,1548],{"class":164},[140,1592,1593],{"class":164}," if=ubuntu.iso",[140,1595,1554],{"class":164},[140,1597,1557],{"class":164},[140,1599,1600],{"class":164}," status=progress",[140,1602,1603],{"class":164}," conv=fsync\n",[140,1605,1606],{"class":142,"line":685},[140,1607,1608],{"class":154},"# (use \u002Fdev\u002Fsdb, the whole disk, NOT \u002Fdev\u002Fsdb1)\n",[423,1610,555,1612,1615],{"id":1611},"edge-case-dd-if-ofdevsda-destroys-the-target",[18,1613,1614],{},"dd if=... of=\u002Fdev\u002Fsda"," Destroys the Target",[130,1617,1618],{"language":132},[28,1619,1621],{"className":135,"code":1620,"language":132,"meta":34,"style":34},"# Anti-Pattern: a typo overwrites your boot disk\n# dd copies raw bytes with NO safety check\n# of=\u002Fdev\u002Fsda instead of of=disk.img → overwrites your whole disk\n# Always verify of= is the intended target. Use status=progress to see it's writing the right amount.\n",[18,1622,1623,1628,1633,1638],{"__ignoreMap":34},[140,1624,1625],{"class":142,"line":143},[140,1626,1627],{"class":154},"# Anti-Pattern: a typo overwrites your boot disk\n",[140,1629,1630],{"class":142,"line":158},[140,1631,1632],{"class":154},"# dd copies raw bytes with NO safety check\n",[140,1634,1635],{"class":142,"line":174},[140,1636,1637],{"class":154},"# of=\u002Fdev\u002Fsda instead of of=disk.img → overwrites your whole disk\n",[140,1639,1640],{"class":142,"line":187},[140,1641,1642],{"class":154},"# Always verify of= is the intended target. Use status=progress to see it's writing the right amount.\n",[23,1644,1646],{"id":1645},"tips-tricks","💡 Tips & Tricks",[1648,1649,1650,1661,1673,1686,1698,1711,1720],"ul",{},[1651,1652,1653,1656,1657,1660],"li",{},[466,1654,1655],{},"Idiom",": use ",[18,1658,1659],{},"lsblk -f"," as your first storage command — shows all block devices, partitions, filesystem types, UUIDs, and mount points in one tree.",[1651,1662,1663,1665,1666,1669,1670,1672],{},[466,1664,1655],{},": use UUIDs in ",[18,1667,1668],{},"fstab",", not ",[18,1671,83],{}," — device names can change across reboots. UUIDs are unique per filesystem and stable.",[1651,1674,1675,1656,1677,1679,1680,1682,1683,1685],{},[466,1676,1655],{},[18,1678,558],{}," in ",[18,1681,1668],{}," for non-critical mounts — if an external USB or secondary data disk is absent at boot, ",[18,1684,558],{}," lets the boot continue.",[1651,1687,1688,1656,1690,1693,1694,1697],{},[466,1689,1655],{},[18,1691,1692],{},"mkfs.ext4 -m 0"," for data-only filesystems — the default 5% reserved for root makes sense for ",[18,1695,1696],{},"\u002F"," (keeps root able to log in if disk is full), but on a 4 TB data disk it wastes 200 GB.",[1651,1699,1700,1702,1703,1706,1707,1710],{},[466,1701,1655],{},": use LVM for any non-root filesystem that might grow — resizing plain partitions is painful. LVM lets you ",[18,1704,1705],{},"lvextend"," + ",[18,1708,1709],{},"resize2fs"," online (while mounted).",[1651,1712,1713,1656,1716,1719],{},[466,1714,1715],{},"Debug",[18,1717,1718],{},"cat \u002Fproc\u002Fmdstat"," to watch RAID rebuild progress — shows array status, sync percentage, and which disks are involved.",[1651,1721,1722,1656,1724,1727],{},[466,1723,1715],{},[18,1725,1726],{},"smartctl -H \u002Fdev\u002Fsda"," and watch reallocated sector counts — early warning of disk failure.",[23,1729,1731],{"id":1730},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1648,1733,1734,1753,1768,1784,1794,1800,1806,1826],{},[1651,1735,1736,1741,1742,1744,1745,1748,1749,1752],{},[466,1737,1738,1740],{},[18,1739,1614],{}," destroys the target",": ",[18,1743,1528],{}," copies raw bytes with no safety check. ",[18,1746,1747],{},"if="," and ",[18,1750,1751],{},"of="," are one character apart — a typo overwrites your boot disk.",[1651,1754,1755,1760,1761,1763,1764,1767],{},[466,1756,1757,1759],{},[18,1758,20],{}," on a mounted filesystem can corrupt it",": never ",[18,1762,20],{}," a mounted ext4\u002Fxfs. Unmount first, or boot from a live USB. ",[18,1765,1766],{},"xfs_repair"," explicitly refuses to run on a mounted filesystem.",[1651,1769,1770,1741,1773,1776,1777,1780,1781,1783],{},[466,1771,1772],{},"XFS can't shrink",[18,1774,1775],{},"xfs_growfs"," expands (online), but there's no ",[18,1778,1779],{},"xfs_shrink",". If you need a smaller XFS, you must back up, ",[18,1782,330],{}," anew, and restore.",[1651,1785,1786,1789,1790,1793],{},[466,1787,1788],{},"LVM snapshot size matters",": if a snapshot fills up (more changes than its allocated size), it's ",[466,1791,1792],{},"invalidated"," — you can't use it for backup.",[1651,1795,1796,1799],{},[466,1797,1798],{},"RAID is not a backup",": RAID protects against disk failure, not deletion, corruption, or ransomware. Always have off-site backups.",[1651,1801,1802,1805],{},[466,1803,1804],{},"RAID 5 has a rebuild risk",": with large modern disks, the rebuild time is long, and a read error during rebuild can fail the array. RAID 6 (two parity disks) is safer for large arrays.",[1651,1807,1808,1813,1814,77,1816,1818,1819,1821,1822,1825],{},[466,1809,1810,1812],{},[18,1811,76],{}," ordering can change",": USB devices, hotplug SATA, BIOS settings can reorder ",[18,1815,76],{},[18,1817,80],{},". Use UUIDs (in ",[18,1820,1668],{},"), LVM (VG names), or ",[18,1823,1824],{},"mdadm"," (array UUID).",[1651,1827,1828,1834,1835,1838,1839,1842,1843,1846,1847,1850],{},[466,1829,1830,1833],{},[18,1831,1832],{},"umount"," fails if filesystem is busy",": open files, processes in the directory, or a shell's ",[18,1836,1837],{},"cwd"," prevent unmount. Find them with ",[18,1840,1841],{},"lsof +D \u002Fmnt"," or ",[18,1844,1845],{},"fuser -vm \u002Fmnt",". ",[18,1848,1849],{},"umount -l"," (lazy) detaches now but cleans up later — use cautiously.",[23,1852,1854],{"id":1853},"quick-quiz","🧠 Quick Quiz",[14,1856,1857,1858,1861],{},"A server's ",[18,1859,1860],{},"\u002Fvar\u002Flog"," is on a separate ext4 partition. After a power outage, the system boots to emergency mode with \"UNEXPECTED INCONSISTENCY; RUN fsck MANUALLY.\" How do you fix this?",[1863,1864,1865,1869,1878,1883,1993],"details",{},[1866,1867,1868],"summary",{},"Answer",[14,1870,1871,1872,1874,1875,1877],{},"The ext4 filesystem on ",[18,1873,1860],{}," wasn't cleanly unmounted (power loss) and the journal can't auto-repair it. ",[18,1876,20],{}," must run manually.",[14,1879,1880],{},[466,1881,1882],{},"Steps:",[1884,1885,1886,1905,1924,1949,1968],"ol",{},[1651,1887,1888,1889],{},"In emergency mode, remount root read-write:",[130,1890,1891,1897,1900],{"language":132},[28,1892,1893],{"className":135,"code":34,"language":132,"meta":34,"style":34},[18,1894,1895],{"__ignoreMap":34},[140,1896],{"class":142,"line":143},[14,1898,1899],{},"mount -o remount,rw \u002F",[28,1901,1903],{"className":1902,"code":34,"language":33},[31],[18,1904,34],{"__ignoreMap":34},[1651,1906,1907,1908],{},"Identify the problematic filesystem:",[130,1909,1910,1916,1919],{"language":132},[28,1911,1912],{"className":135,"code":34,"language":132,"meta":34,"style":34},[18,1913,1914],{"__ignoreMap":34},[140,1915],{"class":142,"line":143},[14,1917,1918],{},"journalctl -b | grep -i \"fsck|ext4|inconsistency\"\ncat \u002Fetc\u002Ffstab | grep \u002Fvar\u002Flog",[28,1920,1922],{"className":1921,"code":34,"language":33},[31],[18,1923,34],{"__ignoreMap":34},[1651,1925,1926,1927,1929,1930,1932,1933],{},"If ",[18,1928,1860],{}," is a separate partition, ",[18,1931,20],{}," it (it should be unmounted in emergency mode):",[130,1934,1935,1941,1944],{"language":132},[28,1936,1937],{"className":135,"code":34,"language":132,"meta":34,"style":34},[18,1938,1939],{"__ignoreMap":34},[140,1940],{"class":142,"line":143},[14,1942,1943],{},"fsck -y \u002Fdev\u002FsdXX        # replace with the actual device from fstab",[28,1945,1947],{"className":1946,"code":34,"language":33},[31],[18,1948,34],{"__ignoreMap":34},[1651,1950,1951,1952],{},"Continue boot:",[130,1953,1954,1960,1963],{"language":132},[28,1955,1956],{"className":135,"code":34,"language":132,"meta":34,"style":34},[18,1957,1958],{"__ignoreMap":34},[140,1959],{"class":142,"line":143},[14,1961,1962],{},"systemctl default",[28,1964,1966],{"className":1965,"code":34,"language":33},[31],[18,1967,34],{"__ignoreMap":34},[1651,1969,1970,1973,1974,1679,1977,1979,1980,1982,1983,1985,1986,1842,1989,1992],{},[466,1971,1972],{},"Prevent future occurrences",": ensure ",[18,1975,1976],{},"pass",[18,1978,1668],{}," is non-zero for ",[18,1981,1860],{}," (so ",[18,1984,20],{}," runs automatically at boot). Use a journaling filesystem (ext4 with ",[18,1987,1988],{},"data=ordered",[18,1990,1991],{},"data=journal",").",[130,1994,1995],{"language":132},[28,1996,1998],{"className":135,"code":1997,"language":132,"meta":34,"style":34},"# \u002Fetc\u002Ffstab — pass field controls boot-time fsck order\n# UUID=...  \u002Fvar\u002Flog  ext4  defaults  0  2   ← \"2\" means fsck at boot\n",[18,1999,2000,2005],{"__ignoreMap":34},[140,2001,2002],{"class":142,"line":143},[140,2003,2004],{"class":154},"# \u002Fetc\u002Ffstab — pass field controls boot-time fsck order\n",[140,2006,2007],{"class":142,"line":158},[140,2008,2009],{"class":154},"# UUID=...  \u002Fvar\u002Flog  ext4  defaults  0  2   ← \"2\" means fsck at boot\n",[2011,2012,2013],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-git