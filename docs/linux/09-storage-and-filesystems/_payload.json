[{"data":1,"prerenderedAt":2056},["ShallowReactive",2],{"page-\u002Flinux\u002F09-storage-and-filesystems":3},{"id":4,"title":5,"body":6,"description":2049,"extension":2050,"meta":2051,"navigation":392,"path":2052,"seo":2053,"stem":2054,"__hash__":2055},"content\u002Flinux\u002F09-storage-and-filesystems.md","09 — Storage & Filesystems",{"type":7,"value":8,"toc":2014},"minimark",[9,13,22,27,37,41,129,197,201,249,324,332,422,427,490,499,506,552,560,605,609,721,725,728,734,978,982,1009,1013,1116,1284,1288,1310,1316,1380,1386,1438,1442,1523,1530,1609,1616,1643,1647,1728,1732,1851,1855,1862,2010],[10,11,5],"h1",{"id":12},"_09-storage-filesystems",[14,15,16,17,21],"p",{},"Storage is where data lives persistently. This chapter covers disks, partitions, filesystems, mounting, LVM, RAID, ",[18,19,20],"code",{},"fsck",", and SMART — core sysadmin skills where mistakes cause the most damage (data loss).",[23,24,26],"h2",{"id":25},"the-storage-stack","The Storage Stack",[28,29,35],"pre",{"className":30,"code":32,"language":33,"meta":34},[31],"language-text","┌─────────────────────────────────────┐\n│  Filesystem (ext4, xfs, btrfs...)   │  ← what you mount\n├─────────────────────────────────────┤\n│  LVM Logical Volume (optional)      │  ← flexible virtual disk\n├─────────────────────────────────────┤\n│  Partition (sda1, sda2)             │  ← slice of a disk\n├─────────────────────────────────────┤\n│  Block Device (sda, nvme0n1)        │  ← the physical disk\n├─────────────────────────────────────┤\n│  Hardware (SATA, NVMe, USB, RAID)   │\n└─────────────────────────────────────┘\n","text","",[18,36,32],{"__ignoreMap":34},[23,38,40],{"id":39},"block-devices","Block Devices",[42,43,44,60],"table",{},[45,46,47],"thead",{},[48,49,50,54,57],"tr",{},[51,52,53],"th",{},"Device",[51,55,56],{},"Interface",[51,58,59],{},"Name Pattern",[61,62,63,84,100,116],"tbody",{},[48,64,65,69,72],{},[66,67,68],"td",{},"SATA, SCSI, USB",[66,70,71],{},"SATA\u002FSCSI",[66,73,74,77,78,77,81],{},[18,75,76],{},"\u002Fdev\u002Fsda",", ",[18,79,80],{},"\u002Fdev\u002Fsdb",[18,82,83],{},"\u002Fdev\u002Fsda1",[48,85,86,89,92],{},[66,87,88],{},"NVMe",[66,90,91],{},"PCIe",[66,93,94,77,97],{},[18,95,96],{},"\u002Fdev\u002Fnvme0n1",[18,98,99],{},"\u002Fdev\u002Fnvme0n1p1",[48,101,102,105,108],{},[66,103,104],{},"MMC\u002FSD",[66,106,107],{},"SD card",[66,109,110,77,113],{},[18,111,112],{},"\u002Fdev\u002Fmmcblk0",[18,114,115],{},"\u002Fdev\u002Fmmcblk0p1",[48,117,118,121,124],{},[66,119,120],{},"Loop",[66,122,123],{},"Image file",[66,125,126],{},[18,127,128],{},"\u002Fdev\u002Floop0",[130,131,133],"code-wrapper",{"language":132},"bash",[28,134,137],{"className":135,"code":136,"language":132,"meta":34,"style":34},"language-bash shiki shiki-themes github-light github-dark","lsblk -f               # tree view: devices + partitions + FS type + UUID + mount\nsudo fdisk -l          # list all disks + partition tables\nsudo parted -l         # same, different format\ncat \u002Fproc\u002Fpartitions   # kernel's view of partitions\n",[18,138,139,156,172,185],{"__ignoreMap":34},[140,141,144,148,152],"span",{"class":142,"line":143},"line",1,[140,145,147],{"class":146},"sIsaT","lsblk",[140,149,151],{"class":150},"snvgF"," -f",[140,153,155],{"class":154},"sdCPZ","               # tree view: devices + partitions + FS type + UUID + mount\n",[140,157,159,162,166,169],{"class":142,"line":158},2,[140,160,161],{"class":146},"sudo",[140,163,165],{"class":164},"sJ6F3"," fdisk",[140,167,168],{"class":150}," -l",[140,170,171],{"class":154},"          # list all disks + partition tables\n",[140,173,175,177,180,182],{"class":142,"line":174},3,[140,176,161],{"class":146},[140,178,179],{"class":164}," parted",[140,181,168],{"class":150},[140,183,184],{"class":154},"         # same, different format\n",[140,186,188,191,194],{"class":142,"line":187},4,[140,189,190],{"class":146},"cat",[140,192,193],{"class":164}," \u002Fproc\u002Fpartitions",[140,195,196],{"class":154},"   # kernel's view of partitions\n",[23,198,200],{"id":199},"partitioning","Partitioning",[42,202,203,219],{},[45,204,205],{},[48,206,207,210,213,216],{},[51,208,209],{},"Table",[51,211,212],{},"Max Disks",[51,214,215],{},"Max Partitions",[51,217,218],{},"Notes",[61,220,221,235],{},[48,222,223,226,229,232],{},[66,224,225],{},"MBR (DOS)",[66,227,228],{},"2 TB",[66,230,231],{},"4 primary (or 3 + 1 extended with logicals)",[66,233,234],{},"Legacy",[48,236,237,240,243,246],{},[66,238,239],{},"GPT",[66,241,242],{},"8 ZB",[66,244,245],{},"128 (typical)",[66,247,248],{},"Modern, required for UEFI boot",[130,250,251],{"language":132},[28,252,254],{"className":135,"code":253,"language":132,"meta":34,"style":34},"# Complex Implementation: scriptable GPT partitioning with sgdisk\nsudo sgdisk -Z \u002Fdev\u002Fsdb                    # zap all partitions\nsudo sgdisk -n 1:0:0 \u002Fdev\u002Fsdb             # partition 1, whole disk\nsudo sgdisk -t 1:8e00 \u002Fdev\u002Fsdb            # type = Linux LVM\nsudo partprobe \u002Fdev\u002Fsdb                    # tell kernel about new partitions\n",[18,255,256,261,277,294,311],{"__ignoreMap":34},[140,257,258],{"class":142,"line":143},[140,259,260],{"class":154},"# Complex Implementation: scriptable GPT partitioning with sgdisk\n",[140,262,263,265,268,271,274],{"class":142,"line":158},[140,264,161],{"class":146},[140,266,267],{"class":164}," sgdisk",[140,269,270],{"class":150}," -Z",[140,272,273],{"class":164}," \u002Fdev\u002Fsdb",[140,275,276],{"class":154},"                    # zap all partitions\n",[140,278,279,281,283,286,289,291],{"class":142,"line":174},[140,280,161],{"class":146},[140,282,267],{"class":164},[140,284,285],{"class":150}," -n",[140,287,288],{"class":164}," 1:0:0",[140,290,273],{"class":164},[140,292,293],{"class":154},"             # partition 1, whole disk\n",[140,295,296,298,300,303,306,308],{"class":142,"line":187},[140,297,161],{"class":146},[140,299,267],{"class":164},[140,301,302],{"class":150}," -t",[140,304,305],{"class":164}," 1:8e00",[140,307,273],{"class":164},[140,309,310],{"class":154},"            # type = Linux LVM\n",[140,312,314,316,319,321],{"class":142,"line":313},5,[140,315,161],{"class":146},[140,317,318],{"class":164}," partprobe",[140,320,273],{"class":164},[140,322,323],{"class":154},"                    # tell kernel about new partitions\n",[23,325,327,328,331],{"id":326},"creating-filesystems-mkfs","Creating Filesystems (",[18,329,330],{},"mkfs",")",[130,333,334],{"language":132},[28,335,337],{"className":135,"code":336,"language":132,"meta":34,"style":34},"# Complex Implementation: data disk with tuned inode count + no reserved space\nsudo mkfs.ext4 -L data -m 0 -i 4096 \u002Fdev\u002Fsdb1\n# -L data: filesystem label\n# -m 0: no reserved blocks (default 5% reserved for root — wastes 200GB on a 4TB disk)\n# -i 4096: one inode per 4 KB (for many small files; default 16384)\n\nsudo mkfs.xfs \u002Fdev\u002Fsdb2                  # XFS (RHEL default)\nsudo mkswap \u002Fdev\u002Fsdb7                    # swap\n",[18,338,339,344,372,377,382,387,394,408],{"__ignoreMap":34},[140,340,341],{"class":142,"line":143},[140,342,343],{"class":154},"# Complex Implementation: data disk with tuned inode count + no reserved space\n",[140,345,346,348,351,354,357,360,363,366,369],{"class":142,"line":158},[140,347,161],{"class":146},[140,349,350],{"class":164}," mkfs.ext4",[140,352,353],{"class":150}," -L",[140,355,356],{"class":164}," data",[140,358,359],{"class":150}," -m",[140,361,362],{"class":150}," 0",[140,364,365],{"class":150}," -i",[140,367,368],{"class":150}," 4096",[140,370,371],{"class":164}," \u002Fdev\u002Fsdb1\n",[140,373,374],{"class":142,"line":174},[140,375,376],{"class":154},"# -L data: filesystem label\n",[140,378,379],{"class":142,"line":187},[140,380,381],{"class":154},"# -m 0: no reserved blocks (default 5% reserved for root — wastes 200GB on a 4TB disk)\n",[140,383,384],{"class":142,"line":313},[140,385,386],{"class":154},"# -i 4096: one inode per 4 KB (for many small files; default 16384)\n",[140,388,390],{"class":142,"line":389},6,[140,391,393],{"emptyLinePlaceholder":392},true,"\n",[140,395,397,399,402,405],{"class":142,"line":396},7,[140,398,161],{"class":146},[140,400,401],{"class":164}," mkfs.xfs",[140,403,404],{"class":164}," \u002Fdev\u002Fsdb2",[140,406,407],{"class":154},"                  # XFS (RHEL default)\n",[140,409,411,413,416,419],{"class":142,"line":410},8,[140,412,161],{"class":146},[140,414,415],{"class":164}," mkswap",[140,417,418],{"class":164}," \u002Fdev\u002Fsdb7",[140,420,421],{"class":154},"                    # swap\n",[423,424,426],"h3",{"id":425},"xfs-vs-ext4","XFS vs ext4",[42,428,429,442],{},[45,430,431],{},[48,432,433,436,439],{},[51,434,435],{},"Feature",[51,437,438],{},"ext4",[51,440,441],{},"XFS",[61,443,444,455,469,479],{},[48,445,446,449,452],{},[66,447,448],{},"Default on",[66,450,451],{},"Debian\u002FUbuntu",[66,453,454],{},"RHEL\u002FRocky",[48,456,457,460,463],{},[66,458,459],{},"Shrink",[66,461,462],{},"Yes (offline)",[66,464,465],{},[466,467,468],"strong",{},"No",[48,470,471,474,477],{},[66,472,473],{},"Grow",[66,475,476],{},"Yes (online)",[66,478,476],{},[48,480,481,484,487],{},[66,482,483],{},"Large files",[66,485,486],{},"Good",[66,488,489],{},"Excellent",[14,491,492,495,496,498],{},[466,493,494],{},"XFS can't shrink."," If you need a smaller XFS, you must back up, ",[18,497,330],{}," anew, and restore. Choose filesystem based on whether you might need to shrink.",[23,500,502,503],{"id":501},"mounting-and-etcfstab","Mounting and ",[18,504,505],{},"\u002Fetc\u002Ffstab",[130,507,508],{"language":132},[28,509,511],{"className":135,"code":510,"language":132,"meta":34,"style":34},"# Complex Implementation: production fstab with UUID, noatime, and nofail\n# UUID=abcd-1234  \u002Fdata    ext4   defaults,noatime,nofail  0  2\n\n# Validate BEFORE rebooting (prevents emergency mode):\nsudo findmnt --verify\nsudo mount -a\n",[18,512,513,518,523,527,532,542],{"__ignoreMap":34},[140,514,515],{"class":142,"line":143},[140,516,517],{"class":154},"# Complex Implementation: production fstab with UUID, noatime, and nofail\n",[140,519,520],{"class":142,"line":158},[140,521,522],{"class":154},"# UUID=abcd-1234  \u002Fdata    ext4   defaults,noatime,nofail  0  2\n",[140,524,525],{"class":142,"line":174},[140,526,393],{"emptyLinePlaceholder":392},[140,528,529],{"class":142,"line":187},[140,530,531],{"class":154},"# Validate BEFORE rebooting (prevents emergency mode):\n",[140,533,534,536,539],{"class":142,"line":313},[140,535,161],{"class":146},[140,537,538],{"class":164}," findmnt",[140,540,541],{"class":150}," --verify\n",[140,543,544,546,549],{"class":142,"line":389},[140,545,161],{"class":146},[140,547,548],{"class":164}," mount",[140,550,551],{"class":150}," -a\n",[423,553,555,556,559],{"id":554},"edge-case-nofail-for-non-critical-mounts","Edge Case: ",[18,557,558],{},"nofail"," for Non-Critical Mounts",[130,561,562],{"language":132},[28,563,565],{"className":135,"code":564,"language":132,"meta":34,"style":34},"# Without nofail, if \u002Fdev\u002Fsdb1 is absent at boot, the system drops to emergency mode\n# With nofail, boot continues and the mount is simply skipped\nUUID=abcd-1234  \u002Fmnt\u002Fusb  ext4  defaults,noatime,nofail  0  2\n",[18,566,567,572,577],{"__ignoreMap":34},[140,568,569],{"class":142,"line":143},[140,570,571],{"class":154},"# Without nofail, if \u002Fdev\u002Fsdb1 is absent at boot, the system drops to emergency mode\n",[140,573,574],{"class":142,"line":158},[140,575,576],{"class":154},"# With nofail, boot continues and the mount is simply skipped\n",[140,578,579,583,587,590,593,596,599,602],{"class":142,"line":174},[140,580,582],{"class":581},"ssxIu","UUID",[140,584,586],{"class":585},"svdQ7","=",[140,588,589],{"class":164},"abcd-1234",[140,591,592],{"class":146},"  \u002Fmnt\u002Fusb",[140,594,595],{"class":164},"  ext4",[140,597,598],{"class":164},"  defaults,noatime,nofail",[140,600,601],{"class":150},"  0",[140,603,604],{"class":150},"  2\n",[23,606,608],{"id":607},"swap","Swap",[130,610,611],{"language":132},[28,612,614],{"className":135,"code":613,"language":132,"meta":34,"style":34},"# Complex Implementation: swap file (no partition needed)\nsudo fallocate -l 4G \u002Fswapfile      # create a 4 GB file\nsudo chmod 600 \u002Fswapfile\nsudo mkswap \u002Fswapfile\nsudo swapon \u002Fswapfile\n# Add to \u002Fetc\u002Ffstab: \u002Fswapfile none swap defaults 0 0\n\n# Tune swappiness (0=never swap, 100=swap aggressively, default 60)\nsudo sysctl vm.swappiness=10         # servers: 10, databases: 1\necho \"vm.swappiness = 10\" | sudo tee \u002Fetc\u002Fsysctl.d\u002F99-swappiness.conf\n",[18,615,616,621,639,652,660,669,674,678,683,700],{"__ignoreMap":34},[140,617,618],{"class":142,"line":143},[140,619,620],{"class":154},"# Complex Implementation: swap file (no partition needed)\n",[140,622,623,625,628,630,633,636],{"class":142,"line":158},[140,624,161],{"class":146},[140,626,627],{"class":164}," fallocate",[140,629,168],{"class":150},[140,631,632],{"class":164}," 4G",[140,634,635],{"class":164}," \u002Fswapfile",[140,637,638],{"class":154},"      # create a 4 GB file\n",[140,640,641,643,646,649],{"class":142,"line":174},[140,642,161],{"class":146},[140,644,645],{"class":164}," chmod",[140,647,648],{"class":150}," 600",[140,650,651],{"class":164}," \u002Fswapfile\n",[140,653,654,656,658],{"class":142,"line":187},[140,655,161],{"class":146},[140,657,415],{"class":164},[140,659,651],{"class":164},[140,661,662,664,667],{"class":142,"line":313},[140,663,161],{"class":146},[140,665,666],{"class":164}," swapon",[140,668,651],{"class":164},[140,670,671],{"class":142,"line":389},[140,672,673],{"class":154},"# Add to \u002Fetc\u002Ffstab: \u002Fswapfile none swap defaults 0 0\n",[140,675,676],{"class":142,"line":396},[140,677,393],{"emptyLinePlaceholder":392},[140,679,680],{"class":142,"line":410},[140,681,682],{"class":154},"# Tune swappiness (0=never swap, 100=swap aggressively, default 60)\n",[140,684,686,688,691,694,697],{"class":142,"line":685},9,[140,687,161],{"class":146},[140,689,690],{"class":164}," sysctl",[140,692,693],{"class":164}," vm.swappiness=",[140,695,696],{"class":150},"10",[140,698,699],{"class":154},"         # servers: 10, databases: 1\n",[140,701,703,706,709,712,715,718],{"class":142,"line":702},10,[140,704,705],{"class":150},"echo",[140,707,708],{"class":164}," \"vm.swappiness = 10\"",[140,710,711],{"class":585}," |",[140,713,714],{"class":146}," sudo",[140,716,717],{"class":164}," tee",[140,719,720],{"class":164}," \u002Fetc\u002Fsysctl.d\u002F99-swappiness.conf\n",[23,722,724],{"id":723},"lvm-logical-volume-manager","LVM — Logical Volume Manager",[14,726,727],{},"LVM abstracts physical disks into flexible logical volumes. You can resize, snapshot, and span multiple disks — impossible with plain partitions.",[28,729,732],{"className":730,"code":731,"language":33,"meta":34},[31],"Physical Volume (PV)      ← a disk or partition (e.g., \u002Fdev\u002Fsdb1)\n    ↓\nVolume Group (VG)         ← pool of PVs (e.g., vg_data)\n    ↓\nLogical Volume (LV)       ← a slice of the VG, used like a partition\n    ↓\nFilesystem                ← ext4\u002Fxfs on the LV\n",[18,733,731],{"__ignoreMap":34},[130,735,736],{"language":132},[28,737,739],{"className":135,"code":738,"language":132,"meta":34,"style":34},"# Complex Implementation: full LVM setup + online resize + snapshot backup\n# 1. Create PV on two partitions\nsudo pvcreate \u002Fdev\u002Fsdb1 \u002Fdev\u002Fsdc1\n# 2. Create VG spanning both\nsudo vgcreate vg_data \u002Fdev\u002Fsdb1 \u002Fdev\u002Fsdc1\n# 3. Create LV (10 GB)\nsudo lvcreate -L 10G -n lv_data vg_data\n# 4. Create filesystem + mount\nsudo mkfs.ext4 \u002Fdev\u002Fvg_data\u002Flv_data\nsudo mount \u002Fdev\u002Fvg_data\u002Flv_data \u002Fmnt\u002Fdata\n\n# ONLINE RESIZE (while mounted — the big advantage):\nsudo lvextend -l +100%FREE \u002Fdev\u002Fvg_data\u002Flv_data    # use all remaining VG space\nsudo resize2fs \u002Fdev\u002Fvg_data\u002Flv_data               # ext4 (online)\n# sudo xfs_growfs \u002Fmnt\u002Fdata                        # XFS (online)\n\n# SNAPSHOT BACKUP (copy-on-write, point-in-time):\nsudo lvcreate -L 5G -s -n lv_data_snap \u002Fdev\u002Fvg_data\u002Flv_data\nsudo mount -o ro \u002Fdev\u002Fvg_data\u002Flv_data_snap \u002Fmnt\u002Fsnap\ntar -czf \u002Ftmp\u002Fbackup.tar.gz -C \u002Fmnt\u002Fsnap .\nsudo umount \u002Fmnt\u002Fsnap\nsudo lvremove -f \u002Fdev\u002Fvg_data\u002Flv_data_snap\n",[18,740,741,746,751,764,769,783,788,808,813,822,834,839,845,863,876,882,887,893,915,934,955,965],{"__ignoreMap":34},[140,742,743],{"class":142,"line":143},[140,744,745],{"class":154},"# Complex Implementation: full LVM setup + online resize + snapshot backup\n",[140,747,748],{"class":142,"line":158},[140,749,750],{"class":154},"# 1. Create PV on two partitions\n",[140,752,753,755,758,761],{"class":142,"line":174},[140,754,161],{"class":146},[140,756,757],{"class":164}," pvcreate",[140,759,760],{"class":164}," \u002Fdev\u002Fsdb1",[140,762,763],{"class":164}," \u002Fdev\u002Fsdc1\n",[140,765,766],{"class":142,"line":187},[140,767,768],{"class":154},"# 2. Create VG spanning both\n",[140,770,771,773,776,779,781],{"class":142,"line":313},[140,772,161],{"class":146},[140,774,775],{"class":164}," vgcreate",[140,777,778],{"class":164}," vg_data",[140,780,760],{"class":164},[140,782,763],{"class":164},[140,784,785],{"class":142,"line":389},[140,786,787],{"class":154},"# 3. Create LV (10 GB)\n",[140,789,790,792,795,797,800,802,805],{"class":142,"line":396},[140,791,161],{"class":146},[140,793,794],{"class":164}," lvcreate",[140,796,353],{"class":150},[140,798,799],{"class":164}," 10G",[140,801,285],{"class":150},[140,803,804],{"class":164}," lv_data",[140,806,807],{"class":164}," vg_data\n",[140,809,810],{"class":142,"line":410},[140,811,812],{"class":154},"# 4. Create filesystem + mount\n",[140,814,815,817,819],{"class":142,"line":685},[140,816,161],{"class":146},[140,818,350],{"class":164},[140,820,821],{"class":164}," \u002Fdev\u002Fvg_data\u002Flv_data\n",[140,823,824,826,828,831],{"class":142,"line":702},[140,825,161],{"class":146},[140,827,548],{"class":164},[140,829,830],{"class":164}," \u002Fdev\u002Fvg_data\u002Flv_data",[140,832,833],{"class":164}," \u002Fmnt\u002Fdata\n",[140,835,837],{"class":142,"line":836},11,[140,838,393],{"emptyLinePlaceholder":392},[140,840,842],{"class":142,"line":841},12,[140,843,844],{"class":154},"# ONLINE RESIZE (while mounted — the big advantage):\n",[140,846,848,850,853,855,858,860],{"class":142,"line":847},13,[140,849,161],{"class":146},[140,851,852],{"class":164}," lvextend",[140,854,168],{"class":150},[140,856,857],{"class":164}," +100%FREE",[140,859,830],{"class":164},[140,861,862],{"class":154},"    # use all remaining VG space\n",[140,864,866,868,871,873],{"class":142,"line":865},14,[140,867,161],{"class":146},[140,869,870],{"class":164}," resize2fs",[140,872,830],{"class":164},[140,874,875],{"class":154},"               # ext4 (online)\n",[140,877,879],{"class":142,"line":878},15,[140,880,881],{"class":154},"# sudo xfs_growfs \u002Fmnt\u002Fdata                        # XFS (online)\n",[140,883,885],{"class":142,"line":884},16,[140,886,393],{"emptyLinePlaceholder":392},[140,888,890],{"class":142,"line":889},17,[140,891,892],{"class":154},"# SNAPSHOT BACKUP (copy-on-write, point-in-time):\n",[140,894,896,898,900,902,905,908,910,913],{"class":142,"line":895},18,[140,897,161],{"class":146},[140,899,794],{"class":164},[140,901,353],{"class":150},[140,903,904],{"class":164}," 5G",[140,906,907],{"class":150}," -s",[140,909,285],{"class":150},[140,911,912],{"class":164}," lv_data_snap",[140,914,821],{"class":164},[140,916,918,920,922,925,928,931],{"class":142,"line":917},19,[140,919,161],{"class":146},[140,921,548],{"class":164},[140,923,924],{"class":150}," -o",[140,926,927],{"class":164}," ro",[140,929,930],{"class":164}," \u002Fdev\u002Fvg_data\u002Flv_data_snap",[140,932,933],{"class":164}," \u002Fmnt\u002Fsnap\n",[140,935,937,940,943,946,949,952],{"class":142,"line":936},20,[140,938,939],{"class":146},"tar",[140,941,942],{"class":150}," -czf",[140,944,945],{"class":164}," \u002Ftmp\u002Fbackup.tar.gz",[140,947,948],{"class":150}," -C",[140,950,951],{"class":164}," \u002Fmnt\u002Fsnap",[140,953,954],{"class":164}," .\n",[140,956,958,960,963],{"class":142,"line":957},21,[140,959,161],{"class":146},[140,961,962],{"class":164}," umount",[140,964,933],{"class":164},[140,966,968,970,973,975],{"class":142,"line":967},22,[140,969,161],{"class":146},[140,971,972],{"class":164}," lvremove",[140,974,151],{"class":150},[140,976,977],{"class":164}," \u002Fdev\u002Fvg_data\u002Flv_data_snap\n",[423,979,981],{"id":980},"edge-case-lvm-snapshot-size-matters","Edge Case: LVM Snapshot Size Matters",[130,983,984],{"language":132},[28,985,987],{"className":135,"code":986,"language":132,"meta":34,"style":34},"# If a snapshot fills up (more changes than its allocated size), it's INVALIDATED\n# — you can't use it for backup. Size it based on the rate of change during backup.\nsudo lvs    # watch Snap% column — if it hits 100%, snapshot is dead\n",[18,988,989,994,999],{"__ignoreMap":34},[140,990,991],{"class":142,"line":143},[140,992,993],{"class":154},"# If a snapshot fills up (more changes than its allocated size), it's INVALIDATED\n",[140,995,996],{"class":142,"line":158},[140,997,998],{"class":154},"# — you can't use it for backup. Size it based on the rate of change during backup.\n",[140,1000,1001,1003,1006],{"class":142,"line":174},[140,1002,161],{"class":146},[140,1004,1005],{"class":164}," lvs",[140,1007,1008],{"class":154},"    # watch Snap% column — if it hits 100%, snapshot is dead\n",[23,1010,1012],{"id":1011},"raid-mdadm","RAID (mdadm)",[42,1014,1015,1034],{},[45,1016,1017],{},[48,1018,1019,1022,1025,1028,1031],{},[51,1020,1021],{},"Level",[51,1023,1024],{},"Min Disks",[51,1026,1027],{},"Redundancy",[51,1029,1030],{},"Space Efficiency",[51,1032,1033],{},"Use",[61,1035,1036,1053,1069,1085,1102],{},[48,1037,1038,1041,1044,1047,1050],{},[66,1039,1040],{},"0",[66,1042,1043],{},"2",[66,1045,1046],{},"None (data loss if any disk fails)",[66,1048,1049],{},"100%",[66,1051,1052],{},"Speed (not for data you need)",[48,1054,1055,1058,1060,1063,1066],{},[66,1056,1057],{},"1",[66,1059,1043],{},[66,1061,1062],{},"1 disk",[66,1064,1065],{},"50%",[66,1067,1068],{},"OS mirror",[48,1070,1071,1074,1077,1079,1082],{},[66,1072,1073],{},"5",[66,1075,1076],{},"3",[66,1078,1062],{},[66,1080,1081],{},"(n-1)\u002Fn",[66,1083,1084],{},"General purpose",[48,1086,1087,1090,1093,1096,1099],{},[66,1088,1089],{},"6",[66,1091,1092],{},"4",[66,1094,1095],{},"2 disks",[66,1097,1098],{},"(n-2)\u002Fn",[66,1100,1101],{},"Important data",[48,1103,1104,1106,1108,1111,1113],{},[66,1105,696],{},[66,1107,1092],{},[66,1109,1110],{},"1 per mirror pair",[66,1112,1065],{},[66,1114,1115],{},"Speed + redundancy",[130,1117,1118],{"language":132},[28,1119,1121],{"className":135,"code":1120,"language":132,"meta":34,"style":34},"# Complex Implementation: RAID 1 + disk failure simulation + rebuild\nsudo mdadm --create \u002Fdev\u002Fmd0 --level=1 --raid-devices=2 \u002Fdev\u002Fsdb \u002Fdev\u002Fsdc\ncat \u002Fproc\u002Fmdstat                    # watch it build (can take hours)\n\n# Simulate a disk failure:\nsudo mdadm --fail \u002Fdev\u002Fmd0 \u002Fdev\u002Fsdb\nsudo mdadm --remove \u002Fdev\u002Fmd0 \u002Fdev\u002Fsdb\ncat \u002Fproc\u002Fmdstat                    # shows \"degraded\"\n# Replace the disk:\nsudo mdadm --add \u002Fdev\u002Fmd0 \u002Fdev\u002Fsde  # rebuild starts\ncat \u002Fproc\u002Fmdstat                    # shows \"recovering\"\n\n# Save config (so RAID assembles at boot):\nsudo mdadm --detail --scan | sudo tee -a \u002Fetc\u002Fmdadm\u002Fmdadm.conf\nsudo update-initramfs -u            # Debian (so RAID is available at boot)\n",[18,1122,1123,1128,1152,1162,1166,1171,1185,1198,1207,1212,1229,1238,1242,1247,1271],{"__ignoreMap":34},[140,1124,1125],{"class":142,"line":143},[140,11