1451},"3. != silently drops NULLs",{"id":96,"depth":1126,"text":1453},"4. COUNT(*) vs COUNT(col) in a LEFT JOIN",{"id":121,"depth":1126,"text":1455},"5. AVG ignores NULLs, doesn't average them as 0",{"id":144,"depth":1126,"text":1457},"6. SUM of no rows is NULL, not 0",{"id":165,"depth":1126,"text":166},{"id":186,"depth":1126,"text":1460},"8. CHECK allows NULLs",{"id":216,"depth":1117,"text":217,"children":1462},[1463,1465,1466,1467],{"id":220,"depth":1126,"text":1464},"9. LEFT JOIN + WHERE on the right table demotes to INNER JOIN",{"id":249,"depth":1126,"text":250},{"id":267,"depth":1126,"text":268},{"id":289,"depth":1126,"text":1468},"12. NATURAL JOIN joins on all same-named columns",{"id":316,"depth":1117,"text":317,"children":1470},[1471,1472,1473,1474],{"id":320,"depth":1126,"text":321},{"id":343,"depth":1126,"text":344},{"id":360,"depth":1126,"text":361},{"id":379,"depth":1126,"text":1475},"16. AVG(SUM(x)) — nested aggregates are illegal",{"id":398,"depth":1117,"text":399,"children":1477},[1478,1480,1482,1483],{"id":402,"depth":1126,"text":1479},"17. LIMIT without ORDER BY is non-deterministic",{"id":431,"depth":1126,"text":1481},"18. OFFSET pagination is slow at depth",{"id":453,"depth":1126,"text":454},{"id":471,"depth":1126,"text":472},{"id":494,"depth":1117,"text":495,"children":1485},[1486,1488,1489,1490,1492,1493],{"id":498,"depth":1126,"text":1487},"21. LIKE '%middle' can't use a B-tree index",{"id":517,"depth":1126,"text":518},{"id":539,"depth":1126,"text":540},{"id":557,"depth":1126,"text":1491},"24. != \u002F \u003C> rarely uses indexes",{"id":582,"depth":1126,"text":583},{"id":612,"depth":1126,"text":613},{"id":630,"depth":1117,"text":631,"children":1495},[1496,1497,1498,1499],{"id":634,"depth":1126,"text":635},{"id":656,"depth":1126,"text":657},{"id":671,"depth":1126,"text":672},{"id":686,"depth":1126,"text":687},{"id":702,"depth":1117,"text":703,"children":1501},[1502,1504,1506,1508,1510],{"id":706,"depth":1126,"text":1503},"31. BETWEEN is inclusive on both ends",{"id":732,"depth":1126,"text":1505},"32. Floating-point SUM is inexact",{"id":760,"depth":1126,"text":1507},"33. char(n) pads and causes comparison surprises",{"id":798,"depth":1126,"text":1509},"34. Time zone confusion with TIMESTAMP (without zone)",{"id":820,"depth":1126,"text":1511},"35. date_trunc('day', ts) truncates in the session zone",{"id":838,"depth":1117,"text":839,"children":1513},[1514,1516,1518,1520],{"id":842,"depth":1126,"text":1515},"36. ALTER COLUMN ... TYPE rewrites the table",{"id":858,"depth":1126,"text":1517},"37. ADD COLUMN ... NOT NULL DEFAULT x rewrites (sometimes)",{"id":891,"depth":1126,"text":1519},"38. TRUNCATE doesn't reset sequences",{"id":912,"depth":1126,"text":913},{"id":929,"depth":1117,"text":930,"children":1522},[1523,1524,1526],{"id":933,"depth":1126,"text":934},{"id":948,"depth":1126,"text":1525},"41. PUBLIC grants left in place",{"id":970,"depth":1126,"text":1527},"42. SECURITY DEFINER without search_path",{"id":994,"depth":1117,"text":995,"children":1529},[1530,1531,1533],{"id":998,"depth":1126,"text":999},{"id":1013,"depth":1126,"text":1532},"44. work_mem too low causes disk spills",{"id":1032,"depth":1126,"text":1534},"45. MATERIALIZED CTE prevents predicate pushdown",{"id":1054,"depth":1117,"text":1055},{"id":1194,"depth":1117,"text":1434},"md",{},true,"\u002Fsql\u002F29-common-pitfalls",{"title":5,"description":16},"sql\u002F29-common-pitfalls","bOsI1w8nf1yxKywd7JpEGmL2Yzf6_guNNQzh1q9x-_k",1786943184785]