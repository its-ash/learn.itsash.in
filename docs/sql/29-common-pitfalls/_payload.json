[{"data":1,"prerenderedAt":1544},["ShallowReactive",2],{"page-\u002Fsql\u002F29-common-pitfalls":3},{"id":4,"title":5,"body":6,"description":16,"extension":1537,"meta":1538,"navigation":1539,"path":1540,"seo":1541,"stem":1542,"__hash__":1543},"content\u002Fsql\u002F29-common-pitfalls.md","29 — Common Pitfalls & Idiomatic Fixes",{"type":7,"value":8,"toc":1442},"minimark",[9,13,17,22,32,50,58,72,80,94,106,119,127,142,150,163,167,184,192,214,218,230,247,251,265,269,287,295,314,318,322,341,345,358,362,377,385,396,400,412,429,437,451,455,469,473,492,496,504,515,519,537,541,555,566,580,584,610,614,628,632,636,654,658,669,673,684,688,700,704,712,730,737,758,766,796,804,818,826,836,840,848,856,864,889,897,910,914,927,931,935,946,954,968,978,992,996,1000,1011,1019,1030,1038,1052,1056,1059,1190,1432,1435,1438],[10,11,5],"h1",{"id":12},"_29-common-pitfalls-idiomatic-fixes",[14,15,16],"p",{},"40+ traps that catch SQL developers, with the idiomatic fix for each.",[18,19,21],"h2",{"id":20},"null-traps","NULL Traps",[23,24,26,27,31],"h3",{"id":25},"_1-where-col-null-returns-nothing","1. ",[28,29,30],"code",{},"WHERE col = NULL"," returns nothing",[14,33,34,38,39,42,43,38,46,49],{},[35,36,37],"strong",{},"Wrong",": ",[28,40,41],{},"WHERE city = NULL"," (always UNKNOWN, never TRUE).\n",[35,44,45],{},"Fix",[28,47,48],{},"WHERE city IS NULL",".",[23,51,53,54,57],{"id":52},"_2-not-in-with-nulls-returns-zero-rows","2. ",[28,55,56],{},"NOT IN"," with NULLs returns zero rows",[14,59,60,38,62,65,66,38,68,71],{},[35,61,37],{},[28,63,64],{},"WHERE id NOT IN (SELECT customer_id FROM orders)"," — one NULL in the subquery poisons everything.\n",[35,67,45],{},[28,69,70],{},"WHERE NOT EXISTS (SELECT 1 FROM orders o WHERE o.customer_id = c.id)"," — NULL-safe.",[23,73,75,76,79],{"id":74},"_3-silently-drops-nulls","3. ",[28,77,78],{},"!="," silently drops NULLs",[14,81,82,38,84,87,88,38,90,93],{},[35,83,37],{},[28,85,86],{},"WHERE city != 'NYC'"," excludes NULL-city rows.\n",[35,89,45],{},[28,91,92],{},"WHERE city IS DISTINCT FROM 'NYC'"," — treats NULL as a distinct value.",[23,95,97,98,101,102,105],{"id":96},"_4-count-vs-countcol-in-a-left-join","4. ",[28,99,100],{},"COUNT(*)"," vs ",[28,103,104],{},"COUNT(col)"," in a LEFT JOIN",[14,107,108,38,110,112,113,38,115,118],{},[35,109,37],{},[28,111,100],{}," counts the NULL-extended row for unmatched left rows as 1.\n",[35,114,45],{},[28,116,117],{},"COUNT(o.id)"," (a non-nullable right-table column) — skips NULLs, counts only matches.",[23,120,122,123,126],{"id":121},"_5-avg-ignores-nulls-doesnt-average-them-as-0","5. ",[28,124,125],{},"AVG"," ignores NULLs, doesn't average them as 0",[14,128,129,131,132,135,136,38,138,141],{},[35,130,37],{},": expecting ",[28,133,134],{},"AVG([10, NULL])"," = 5.\n",[35,137,45],{},[28,139,140],{},"AVG(COALESCE(amount, 0))"," if NULL means 0 (but ask whether that's semantically right).",[23,143,145,146,149],{"id":144},"_6-sum-of-no-rows-is-null-not-0","6. ",[28,147,148],{},"SUM"," of no rows is NULL, not 0",[14,151,152,38,154,157,158,38,160,49],{},[35,153,37],{},[28,155,156],{},"SELECT SUM(amount) FROM orders WHERE FALSE"," returns NULL, not 0.\n",[35,159,45],{},[28,161,162],{},"COALESCE(SUM(amount), 0)",[23,164,166],{"id":165},"_7-string-concatenation-with-null-yields-null","7. String concatenation with NULL yields NULL",[14,168,169,38,171,174,175,38,177,180,181,49],{},[35,170,37],{},[28,172,173],{},"'hello' || NULL"," = NULL (the whole string becomes NULL).\n",[35,176,45],{},[28,178,179],{},"CONCAT(a, b)"," (ignores NULLs) or ",[28,182,183],{},"COALESCE(a, '') || COALESCE(b, '')",[23,185,187,188,191],{"id":186},"_8-check-allows-nulls","8. ",[28,189,190],{},"CHECK"," allows NULLs",[14,193,194,38,196,199,200,203,204,206,207,210,211,49],{},[35,195,37],{},[28,197,198],{},"CHECK (price > 0)"," passes for ",[28,201,202],{},"price = NULL"," (UNKNOWN passes).\n",[35,205,45],{},": add ",[28,208,209],{},"NOT NULL"," separately, or ",[28,212,213],{},"CHECK (price IS NOT NULL AND price > 0)",[18,215,217],{"id":216},"join-traps","JOIN Traps",[23,219,221,222,225,226,229],{"id":220},"_9-left-join-where-on-the-right-table-demotes-to-inner-join","9. ",[28,223,224],{},"LEFT JOIN"," + ",[28,227,228],{},"WHERE"," on the right table demotes to INNER JOIN",[14,231,232,38,234,237,238,240,241,38,244,49],{},[35,233,37],{},[28,235,236],{},"LEFT JOIN o ON ... WHERE o.amount > 100"," drops left-only rows.\n",[35,239,45],{},": put the right-table filter in ",[28,242,243],{},"ON",[28,245,246],{},"LEFT JOIN o ON ... AND o.amount > 100",[23,248,250],{"id":249},"_10-joining-on-null-doesnt-match","10. Joining on NULL doesn't match",[14,252,253,38,255,258,259,38,261,264],{},[35,254,37],{},[28,256,257],{},"JOIN ON a.col = b.col"," fails to match rows where both are NULL.\n",[35,260,45],{},[28,262,263],{},"JOIN ON a.col IS NOT DISTINCT FROM b.col"," (slower, no index) — or fix the schema (avoid NULL join keys).",[23,266,268],{"id":267},"_11-row-multiplication-from-a-many-join","11. Row multiplication from a \"many\" join",[14,270,271,38,273,276,277,38,279,282,283,286],{},[35,272,37],{},[28,274,275],{},"SELECT c.* FROM customers c JOIN orders o ON ..."," returns one row per order, not per customer.\n",[35,278,45],{},[28,280,281],{},"DISTINCT"," or aggregate (",[28,284,285],{},"GROUP BY",") if you want one row per customer.",[23,288,290,291,294],{"id":289},"_12-natural-join-joins-on-all-same-named-columns","12. ",[28,292,293],{},"NATURAL JOIN"," joins on all same-named columns",[14,296,297,38,299,301,302,304,305,307,308,310,311,49],{},[35,298,37],{},[28,300,293],{}," silently changes behavior when a same-named column is added.\n",[35,303,45],{},": never use ",[28,306,293],{},". Use ",[28,309,243],{}," or ",[28,312,313],{},"USING (specific_column)",[18,315,317],{"id":316},"group-by-traps","GROUP BY Traps",[23,319,321],{"id":320},"_13-column-in-select-but-not-in-group-by-or-aggregated","13. Column in SELECT but not in GROUP BY or aggregated",[14,323,324,38,326,329,330,332,333,336,337,340],{},[35,325,37],{},[28,327,328],{},"SELECT customer_id, amount FROM orders GROUP BY customer_id"," — error.\n",[35,331,45],{},": aggregate (",[28,334,335],{},"SUM(amount)",") or group by it (",[28,338,339],{},"GROUP BY customer_id, amount",").",[23,342,344],{"id":343},"_14-aggregate-in-where","14. Aggregate in WHERE",[14,346,347,38,349,352,353,38,355,49],{},[35,348,37],{},[28,350,351],{},"WHERE SUM(amount) > 100"," — aggregates aren't allowed in WHERE.\n",[35,354,45],{},[28,356,357],{},"HAVING SUM(amount) > 100",[23,359,361],{"id":360},"_15-alias-in-where","15. Alias in WHERE",[14,363,364,38,366,369,370,38,372,374,375,49],{},[35,365,37],{},[28,367,368],{},"SELECT SUM(amount) AS total ... WHERE total > 100"," — alias not visible in WHERE (created in SELECT, which runs after).\n",[35,371,45],{},[28,373,351],{}," (repeat the expression) or ",[28,376,357],{},[23,378,380,381,384],{"id":379},"_16-avgsumx-nested-aggregates-are-illegal","16. ",[28,382,383],{},"AVG(SUM(x))"," — nested aggregates are illegal",[14,386,387,38,389,392,393,395],{},[35,388,37],{},[28,390,391],{},"SELECT AVG(SUM(amount)) FROM orders GROUP BY customer_id",".\n",[35,394,45],{},": subquery\u002FCTE — aggregate to per-customer totals first, then average those.",[18,397,399],{"id":398},"ordering-and-pagination-traps","Ordering and Pagination Traps",[23,401,403,404,407,408,411],{"id":402},"_17-limit-without-order-by-is-non-deterministic","17. ",[28,405,406],{},"LIMIT"," without ",[28,409,410],{},"ORDER BY"," is non-deterministic",[14,413,414,38,416,419,420,422,423,425,426,428],{},[35,415,37],{},[28,417,418],{},"SELECT * FROM orders LIMIT 10"," — arbitrary rows.\n",[35,421,45],{},": always pair ",[28,424,406],{}," with ",[28,427,410],{}," on a unique key.",[23,430,432,433,436],{"id":431},"_18-offset-pagination-is-slow-at-depth","18. ",[28,434,435],{},"OFFSET"," pagination is slow at depth",[14,438,439,38,441,444,445,447,448,49],{},[35,440,37],{},[28,442,443],{},"LIMIT 10 OFFSET 100000"," scans and discards 100000 rows.\n",[35,446,45],{},": keyset pagination — ",[28,449,450],{},"WHERE (sort_key, id) \u003C (last_key, last_id) ORDER BY ... LIMIT 10",[23,452,454],{"id":453},"_19-pagination-without-a-unique-tie-breaker-skipsduplicates-rows","19. Pagination without a unique tie-breaker skips\u002Fduplicates rows",[14,456,457,38,459,462,463,38,465,468],{},[35,458,37],{},[28,460,461],{},"ORDER BY ordered_on LIMIT 10"," — tied dates drift between pages.\n",[35,464,45],{},[28,466,467],{},"ORDER BY ordered_on, id"," (unique tie-breaker).",[23,470,472],{"id":471},"_20-null-sort-order-is-engine-specific","20. NULL sort order is engine-specific",[14,474,475,477,478,38,480,483,484,487,488,491],{},[35,476,37],{},": assuming NULLs sort first (or last) across all engines.\n",[35,479,45],{},[28,481,482],{},"NULLS FIRST","\u002F",[28,485,486],{},"NULLS LAST"," (PostgreSQL) or ",[28,489,490],{},"ORDER BY (col IS NULL), col"," (portable).",[18,493,495],{"id":494},"index-traps","Index Traps",[23,497,499,500,503],{"id":498},"_21-like-middle-cant-use-a-b-tree-index","21. ",[28,501,502],{},"LIKE '%middle'"," can't use a B-tree index",[14,505,506,508,509,38,511,514],{},[35,507,37],{},": leading wildcards defeat the index.\n",[35,510,45],{},[28,512,513],{},"pg_trgm"," GiST\u002FGIN index for substring search, or full-text search.",[23,516,518],{"id":517},"_22-function-on-the-column-defeats-the-index","22. Function on the column defeats the index",[14,520,521,38,523,526,527,392,530,532,533,536],{},[35,522,37],{},[28,524,525],{},"WHERE lower(email) = 'x'"," doesn't use an index on ",[28,528,529],{},"email",[35,531,45],{},": expression index on ",[28,534,535],{},"lower(email)",", or a case-insensitive collation.",[23,538,540],{"id":539},"_23-type-mismatch-defeats-the-index","23. Type mismatch defeats the index",[14,542,543,38,545,548,549,38,551,554],{},[35,544,37],{},[28,546,547],{},"WHERE id = '42'"," (string vs integer) — cast function per row.\n",[35,550,45],{},[28,552,553],{},"WHERE id = 42"," (match the column type).",[23,556,558,559,561,562,565],{"id":557},"_24-rarely-uses-indexes","24. ",[28,560,78],{}," \u002F ",[28,563,564],{},"\u003C>"," rarely uses indexes",[14,567,568,38,570,573,574,38,576,579],{},[35,569,37],{},[28,571,572],{},"WHERE status != 'deleted'"," seq-scans (matches most of the table).\n",[35,575,45],{},[28,577,578],{},"WHERE status IN ('active', 'pending')"," (positive form, indexable) or a partial index.",[23,581,583],{"id":582},"_25-composite-index-leftmost-prefix-rule-forgotten","25. Composite index leftmost-prefix rule forgotten",[14,585,586,131,588,591,592,595,596,598,599,602,603,606,607,609],{},[35,587,37],{},[28,589,590],{},"(a, b)"," to serve ",[28,593,594],{},"WHERE b = ?"," alone.\n",[35,597,45],{},": add a separate index on ",[28,600,601],{},"b",", or reorder the composite to ",[28,604,605],{},"(b, a)"," if ",[28,608,601],{},"-only queries dominate.",[23,611,613],{"id":612},"_26-forgetting-to-index-fk-columns","26. Forgetting to index FK columns",[14,615,616,38,618,621,622,38,624,627],{},[35,617,37],{},[28,619,620],{},"ON DELETE CASCADE"," scans the child table to find referencing rows.\n",[35,623,45],{},[28,625,626],{},"CREATE INDEX ON child(parent_id)"," — always index FK columns.",[18,629,631],{"id":630},"transaction-traps","Transaction Traps",[23,633,635],{"id":634},"_27-lost-updates-at-read-committed","27. Lost updates at READ COMMITTED",[14,637,638,640,641,644,645,38,647,650,651,49],{},[35,639,37],{},": read-then-write (",[28,642,643],{},"SELECT balance; ...; UPDATE SET balance = 900",") — another transaction's update is overwritten.\n",[35,646,45],{},[28,648,649],{},"UPDATE SET balance = balance - 100"," (atomic) or ",[28,652,653],{},"SELECT ... FOR UPDATE",[23,655,657],{"id":656},"_28-deadlocks-from-inconsistent-lock-ordering","28. Deadlocks from inconsistent lock ordering",[14,659,660,662,663,665,666,340],{},[35,661,37],{},": T1 locks A then B; T2 locks B then A — deadlock.\n",[35,664,45],{},": always lock in a consistent order (e.g., ascending ",[28,667,668],{},"id",[23,670,672],{"id":671},"_29-long-transactions-block-vacuum","29. Long transactions block VACUUM",[14,674,675,677,678,680,681,49],{},[35,676,37],{},": a transaction spanning an HTTP call holds locks and pins dead tuples.\n",[35,679,45],{},": keep transactions short; never span external calls; set ",[28,682,683],{},"idle_in_transaction_session_timeout",[23,685,687],{"id":686},"_30-serializable-without-retry","30. SERIALIZABLE without retry",[14,689,690,692,693,696,697,699],{},[35,691,37],{},": using SERIALIZABLE but not retrying on ",[28,694,695],{},"40001"," — just adds aborts, no correctness.\n",[35,698,45],{},": retry the entire transaction on serialization failure.",[18,701,703],{"id":702},"type-and-coercion-traps","Type and Coercion Traps",[23,705,707,708,711],{"id":706},"_31-between-is-inclusive-on-both-ends","31. ",[28,709,710],{},"BETWEEN"," is inclusive on both ends",[14,713,714,131,716,719,720,722,723,726,727,49],{},[35,715,37],{},[28,717,718],{},"BETWEEN 10 AND 100"," to exclude 10 and 100.\n",[35,721,45],{},": it's ",[28,724,725],{},">= 10 AND \u003C= 100",". For exclusive, use ",[28,728,729],{},"> 10 AND \u003C 100",[23,731,733,734,736],{"id":732},"_32-floating-point-sum-is-inexact","32. Floating-point ",[28,735,148],{}," is inexact",[14,738,739,38,741,744,745,392,748,750,751,483,754,757],{},[35,740,37],{},[28,742,743],{},"SUM(amount::float)"," for money — ",[28,746,747],{},"0.1 + 0.2 ≠ 0.3",[35,749,45],{},": use ",[28,752,753],{},"NUMERIC",[28,755,756],{},"DECIMAL"," for money and exact arithmetic.",[23,759,761,762,765],{"id":760},"_33-charn-pads-and-causes-comparison-surprises","33. ",[28,763,764],{},"char(n)"," pads and causes comparison surprises",[14,767,768,38,770,773,774,777,778,780,781,784,785,750,787,310,790,793,794,49],{},[35,769,37],{},[28,771,772],{},"char(2)"," pads ",[28,775,776],{},"'NY'"," to ",[28,779,776],{}," but ",[28,782,783],{},"'NY' = 'NY  '"," may be true or false per engine.\n",[35,786,45],{},[28,788,789],{},"text",[28,791,792],{},"varchar(n)",", not ",[28,795,764],{},[23,797,799,800,803],{"id":798},"_34-time-zone-confusion-with-timestamp-without-zone","34. Time zone confusion with ",[28,801,802],{},"TIMESTAMP"," (without zone)",[14,805,806,808,809,811,812,750,814,817],{},[35,807,37],{},": storing event times as ",[28,810,802],{}," and assuming a zone — it's ambiguous.\n",[35,813,45],{},[28,815,816],{},"TIMESTAMPTZ"," for event times.",[23,819,821,822,825],{"id":820},"_35-date_truncday-ts-truncates-in-the-session-zone","35. ",[28,823,824],{},"date_trunc('day', ts)"," truncates in the session zone",[14,827,828,830,831,38,833,49],{},[35,829,37],{},": truncating in UTC when the business day is in New York.\n",[35,832,45],{},[28,834,835],{},"date_trunc('day', ts AT TIME ZONE 'America\u002FNew_York')",[18,837,839],{"id":838},"ddl-and-schema-traps","DDL and Schema Traps",[23,841,843,844,847],{"id":842},"_36-alter-column-type-rewrites-the-table","36. ",[28,845,846],{},"ALTER COLUMN ... TYPE"," rewrites the table",[14,849,850,852,853,855],{},[35,851,37],{},": changing a column type on a billion-row table in one statement — hours of downtime.\n",[35,854,45],{},": add a new column, backfill in batches, swap, drop old.",[23,857,859,860,863],{"id":858},"_37-add-column-not-null-default-x-rewrites-sometimes","37. ",[28,861,862],{},"ADD COLUMN ... NOT NULL DEFAULT x"," rewrites (sometimes)",[14,865,866,38,868,871,872,875,876,878,879,882,883,225,886,49],{},[35,867,37],{},[28,869,870],{},"ADD COLUMN processed_at TIMESTAMPTZ NOT NULL DEFAULT now()"," — ",[28,873,874],{},"now()"," is volatile, forces a rewrite.\n",[35,877,45],{},": add nullable + default, backfill, then ",[28,880,881],{},"SET NOT NULL"," via ",[28,884,885],{},"NOT VALID",[28,887,888],{},"VALIDATE",[23,890,892,893,896],{"id":891},"_38-truncate-doesnt-reset-sequences","38. ",[28,894,895],{},"TRUNCATE"," doesn't reset sequences",[14,898,899,38,901,904,905,38,907,49],{},[35,900,37],{},[28,902,903],{},"TRUNCATE orders"," leaves the sequence at its old position.\n",[35,906,45],{},[28,908,909],{},"TRUNCATE orders RESTART IDENTITY",[23,911,913],{"id":912},"_39-sequence-not-advanced-after-a-data-load","39. Sequence not advanced after a data load",[14,915,916,38,918,921,922,38,924,49],{},[35,917,37],{},[28,919,920],{},"COPY"," with explicit IDs, then auto-inserts collide.\n",[35,923,45],{},[28,925,926],{},"SELECT setval(pg_get_serial_sequence('t', 'id'), (SELECT max(id) FROM t))",[18,928,930],{"id":929},"security-traps","Security Traps",[23,932,934],{"id":933},"_40-table-owner-bypasses-rls","40. Table owner bypasses RLS",[14,936,937,939,940,38,942,945],{},[35,938,37],{},": app connects as the table owner, RLS doesn't apply.\n",[35,941,45],{},[28,943,944],{},"FORCE ROW LEVEL SECURITY",", or connect as a non-owner role.",[23,947,949,950,953],{"id":948},"_41-public-grants-left-in-place","41. ",[28,951,952],{},"PUBLIC"," grants left in place",[14,955,956,958,959,961,962,38,964,967],{},[35,957,37],{},": default ",[28,960,952],{}," access on databases\u002Ffunctions forgotten.\n",[35,963,45],{},[28,965,966],{},"REVOKE ... FROM PUBLIC"," and grant explicitly.",[23,969,971,972,407,975],{"id":970},"_42-security-definer-without-search_path","42. ",[28,973,974],{},"SECURITY DEFINER",[28,976,977],{},"search_path",[14,979,980,982,983,985,986,38,988,991],{},[35,981,37],{},": a definer function with default ",[28,984,977],{}," — vulnerable to hijacking.\n",[35,987,45],{},[28,989,990],{},"SET search_path = my_schema, pg_temp"," in the function.",[18,993,995],{"id":994},"query-plan-traps","Query Plan Traps",[23,997,999],{"id":998},"_43-stale-statistics-cause-bad-plans","43. Stale statistics cause bad plans",[14,1001,1002,1004,1005,38,1007,1010],{},[35,1003,37],{},": estimate says 1 row, actual is 1M — nested loop chosen, catastrophic.\n",[35,1006,45],{},[28,1008,1009],{},"ANALYZE table"," to refresh statistics.",[23,1012,1014,1015,1018],{"id":1013},"_44-work_mem-too-low-causes-disk-spills","44. ",[28,1016,1017],{},"work_mem"," too low causes disk spills",[14,1020,1021,1023,1024,38,1026,1029],{},[35,1022,37],{},": sort\u002Fhash spills to disk — slow.\n",[35,1025,45],{},[28,1027,1028],{},"SET work_mem = '256MB'"," per-session for big queries.",[23,1031,1033,1034,1037],{"id":1032},"_45-materialized-cte-prevents-predicate-pushdown","45. ",[28,1035,1036],{},"MATERIALIZED"," CTE prevents predicate pushdown",[14,1039,1040,38,1042,1045,1046,1048,1049,1051],{},[35,1041,37],{},[28,1043,1044],{},"WITH x AS MATERIALIZED (...) SELECT * FROM x WHERE ..."," — full CTE computed before the filter.\n",[35,1047,45],{},": drop ",[28,1050,1036],{}," (let the planner inline) or filter inside the CTE.",[18,1053,1055],{"id":1054},"spot-the-bug-comprehensive","🧠 Spot the Bug (Comprehensive)",[14,1057,1058],{},"A developer writes a report query and gets wrong results — NULL customers excluded, averages off, and pagination skips rows. Find the issues:",[1060,1061,1063],"code-wrapper",{"language":1062},"sql",[1064,1065,1069],"pre",{"className":1066,"code":1067,"language":1062,"meta":1068,"style":1068},"language-sql shiki shiki-themes github-light github-dark","SELECT c.name, AVG(o.amount) AS avg_order\nFROM customers c\nLEFT JOIN orders o ON c.id = o.customer_id\nWHERE o.amount > 50\nORDER BY avg_order DESC\nLIMIT 10;\n","",[28,1070,1071,1115,1124,1151,1168,1179],{"__ignoreMap":1068},[1072,1073,1076,1080,1084,1087,1090,1093,1095,1098,1101,1103,1106,1109,1112],"span",{"class":1074,"line":1075},"line",1,[1072,1077,1079],{"class":1078},"svdQ7","SELECT",[1072,1081,1083],{"class":1082},"snvgF"," c",[1072,1085,49],{"class":1086},"ssxIu",[1072,1088,1089],{"class":1082},"name",[1072,1091,1092],{"class":1086},", ",[1072,1094,125],{"class":1082},[1072,1096,1097],{"class":1086},"(",[1072,1099,1100],{"class":1082},"o",[1072,1102,49],{"class":1086},[1072,1104,1105],{"class":1082},"amount",[1072,1107,1108],{"class":1086},") ",[1072,1110,1111],{"class":1078},"AS",[1072,1113,1114],{"class":1086}," avg_order\n",[1072,1116,1118,1121],{"class":1074,"line":1117},2,[1072,1119,1120],{"class":1078},"FROM",[1072,1122,1123],{"class":1086}," customers c\n",[1072,1125,1127,1129,1132,1134,1136,1138,1140,1143,1146,1148],{"class":1074,"line":1126},3,[1072,1128,224],{"class":1078},[1072,1130,1131],{"class":1086}," orders o ",[1072,1133,243],{"class":1078},[1072,1135,1083],{"class":1082},[1072,1137,49],{"class":1086},[1072,1139,668],{"class":1082},[1072,1141,1142],{"class":1078}," =",[1072,1144,1145],{"class":1082}," o",[1072,1147,49],{"class":1086},[1072,1149,1150],{"class":1082},"customer_id\n",[1072,1152,1154,1156,1158,1160,1162,1165],{"class":1074,"line":1153},4,[1072,1155,228],{"class":1078},[1072,1157,1145],{"class":1082},[1072,1159,49],{"class":1086},[1072,1161,1105],{"class":1082},[1072,1163,1164],{"class":1078}," >",[1072,1166,1167],{"class":1082}," 50\n",[1072,1169,1171,1173,1176],{"class":1074,"line":1170},5,[1072,1172,410],{"class":1078},[1072,1174,1175],{"class":1086}," avg_order ",[1072,1177,1178],{"class":1078},"DESC\n",[1072,1180,1182,1184,1187],{"class":1074,"line":1181},6,[1072,1183,406],{"class":1078},[1072,1185,1186],{"class":1082}," 10",[1072,1188,1189],{"class":1086},";\n",[1191,1192,1193,1197,1200,1275,1278,1410],"details",{},[1194,1195,1196],"summary",{},"Answer",[14,1198,1199],{},"Three issues:",[1201,1202,1203,1238,1260],"ol",{},[1204,1205,1206,38,1211,1214,1215,1217,1218,1221,1222,1225,1226,1228,1229,1232,1233,38,1235,49],"li",{},[35,1207,1208,1210],{},[28,1209,224],{}," demoted to INNER JOIN",[28,1212,1213],{},"WHERE o.amount > 50"," filters on the right table in ",[28,1216,228],{},", dropping customers with no orders (the NULL-extended rows have ",[28,1219,1220],{},"o.amount = NULL",", and ",[28,1223,1224],{},"NULL > 50"," is UNKNOWN, not TRUE). The ",[28,1227,224],{}," is pointless — it behaves as an ",[28,1230,1231],{},"INNER JOIN",". Fix: move the filter to ",[28,1234,243],{},[28,1236,1237],{},"LEFT JOIN orders o ON c.id = o.customer_id AND o.amount > 50",[1204,1239,1240,1245,1246,1249,1250,1253,1254,1256,1257,1259],{},[35,1241,1242,1244],{},[28,1243,125],{}," ignores NULLs",": for a customer with no orders > 50, ",[28,1247,1248],{},"AVG(o.amount)"," is NULL (no non-NULL values). If the intent was \"customers with no qualifying orders show 0,\" wrap: ",[28,1251,1252],{},"COALESCE(AVG(o.amount), 0)",". But if the intent is \"only show customers with qualifying orders,\" the ",[28,1255,1231],{}," (original behavior) is correct — just remove the ",[28,1258,224],{}," to make the intent explicit.",[1204,1261,1262,38,1265,871,1268,1271,1272,49],{},[35,1263,1264],{},"Pagination without a tie-breaker",[28,1266,1267],{},"ORDER BY avg_order DESC LIMIT 10",[28,1269,1270],{},"avg_order"," isn't unique; tied customers can drift between pages. Fix: add a tie-breaker: ",[28,1273,1274],{},"ORDER BY avg_order DESC, c.id",[14,1276,1277],{},"The corrected query (assuming \"all customers, with their average order > 50, or 0 if none\"):",[1064,1279,1281],{"className":1066,"code":1280,"language":1062,"meta":1068,"style":1068},"SELECT c.name, COALESCE(AVG(o.amount), 0) AS avg_order\nFROM customers c\nLEFT JOIN orders o ON c.id = o.customer_id AND o.amount > 50\nGROUP BY c.id, c.name\nORDER BY avg_order DESC, c.id\nLIMIT 10;\n",[28,1282,1283,1322,1328,1364,1384,1402],{"__ignoreMap":1068},[1072,1284,1285,1287,1289,1291,1293,1295,1298,1300,1302,1304,1306,1308,1310,1313,1316,1318,1320],{"class":1074,"line":1075},[1072,1286,1079],{"class":1078},[1072,1288,1083],{"class":1082},[1072,1290,49],{"class":1086},[1072,1292,1089],{"class":1082},[1072,1294,1092],{"class":1086},[1072,1296,1297],{"class":1082},"COALESCE",[1072,1299,1097],{"class":1086},[1072,1301,125],{"class":1082},[1072,1303,1097],{"class":1086},[1072,1305,1100],{"class":1082},[1072,1307,49],{"class":1086},[1072,1309,1105],{"class":1082},[1072,1311,1312],{"class":1086},"), ",[1072,1314,1315],{"class":1082},"0",[1072,1317,1108],{"class":1086},[1