[{"data":1,"prerenderedAt":2141},["ShallowReactive",2],{"page-\u002Fsql\u002F05-aggregation-and-group-by":3},{"id":4,"title":5,"body":6,"description":16,"extension":2135,"meta":2136,"navigation":476,"path":2137,"seo":2138,"stem":2139,"__hash__":2140},"content\u002Fsql\u002F05-aggregation-and-group-by.md","05 — Aggregation & GROUP BY",{"type":7,"value":8,"toc":2108},"minimark",[9,13,17,22,137,280,292,340,402,406,415,578,582,588,604,684,690,694,704,799,811,815,838,974,978,1030,1046,1050,1057,1128,1134,1138,1145,1152,1266,1273,1280,1316,1323,1330,1363,1369,1381,1385,1395,1418,1428,1432,1527,1531,1719,1723,1726,1801,2074,2077,2104],[10,11,5],"h1",{"id":12},"_05-aggregation-group-by",[14,15,16],"p",{},"Aggregation collapses multiple rows into summary values — counts, sums, averages, minima, maxima. It's how you answer \"how many,\" \"how much,\" \"what's the average per group.\"",[18,19,21],"h2",{"id":20},"aggregate-functions","Aggregate Functions",[23,24,25,38],"table",{},[26,27,28],"thead",{},[29,30,31,35],"tr",{},[32,33,34],"th",{},"Function",[32,36,37],{},"Returns",[39,40,41,53,67,77,87,97,111,124],"tbody",{},[29,42,43,50],{},[44,45,46],"td",{},[47,48,49],"code",{},"COUNT(*)",[44,51,52],{},"Number of rows (including NULLs and duplicates).",[29,54,55,60],{},[44,56,57],{},[47,58,59],{},"COUNT(col)",[44,61,62,63,66],{},"Number of non-NULL values in ",[47,64,65],{},"col",".",[29,68,69,74],{},[44,70,71],{},[47,72,73],{},"COUNT(DISTINCT col)",[44,75,76],{},"Number of distinct non-NULL values.",[29,78,79,84],{},[44,80,81],{},[47,82,83],{},"SUM(col)",[44,85,86],{},"Sum of non-NULL values.",[29,88,89,94],{},[44,90,91],{},[47,92,93],{},"AVG(col)",[44,95,96],{},"Average of non-NULL values (NULLs excluded, not treated as 0).",[29,98,99,108],{},[44,100,101,104,105],{},[47,102,103],{},"MIN(col)"," \u002F ",[47,106,107],{},"MAX(col)",[44,109,110],{},"Smallest\u002Flargest non-NULL value. Works on text and dates too.",[29,112,113,121],{},[44,114,115,104,118],{},[47,116,117],{},"bool_or(col)",[47,119,120],{},"bool_and(col)",[44,122,123],{},"TRUE if any\u002Fall values are TRUE (PostgreSQL).",[29,125,126,134],{},[44,127,128,104,131],{},[47,129,130],{},"string_agg(col, ',')",[47,132,133],{},"GROUP_CONCAT(col)",[44,135,136],{},"Concatenate values (PostgreSQL \u002F SQLite & MySQL).",[138,139,141],"code-wrapper",{"language":140},"sql",[142,143,147],"pre",{"className":144,"code":145,"language":140,"meta":146,"style":146},"language-sql shiki shiki-themes github-light github-dark","SELECT\n  COUNT(*) AS total_orders,\n  COUNT(DISTINCT customer_id) AS unique_customers,\n  SUM(amount) AS revenue,\n  AVG(amount) AS avg_order,\n  MIN(amount) AS smallest,\n  MAX(amount) AS largest\nFROM orders;\n--  total_orders | unique_customers | revenue | avg_order | smallest | largest\n--  -------------+------------------+---------+----------+----------+---------\n--           4   |        3         |  568.75 |  142.19  |   7.25   |  450.00\n","",[47,148,149,158,181,199,213,226,239,252,261,268,274],{"__ignoreMap":146},[150,151,154],"span",{"class":152,"line":153},"line",1,[150,155,157],{"class":156},"svdQ7","SELECT\n",[150,159,161,165,169,172,175,178],{"class":152,"line":160},2,[150,162,164],{"class":163},"snvgF","  COUNT",[150,166,168],{"class":167},"ssxIu","(",[150,170,171],{"class":156},"*",[150,173,174],{"class":167},") ",[150,176,177],{"class":156},"AS",[150,179,180],{"class":167}," total_orders,\n",[150,182,184,186,188,191,194,196],{"class":152,"line":183},3,[150,185,164],{"class":163},[150,187,168],{"class":167},[150,189,190],{"class":156},"DISTINCT",[150,192,193],{"class":167}," customer_id) ",[150,195,177],{"class":156},[150,197,198],{"class":167}," unique_customers,\n",[150,200,202,205,208,210],{"class":152,"line":201},4,[150,203,204],{"class":163},"  SUM",[150,206,207],{"class":167},"(amount) ",[150,209,177],{"class":156},[150,211,212],{"class":167}," revenue,\n",[150,214,216,219,221,223],{"class":152,"line":215},5,[150,217,218],{"class":163},"  AVG",[150,220,207],{"class":167},[150,222,177],{"class":156},[150,224,225],{"class":167}," avg_order,\n",[150,227,229,232,234,236],{"class":152,"line":228},6,[150,230,231],{"class":163},"  MIN",[150,233,207],{"class":167},[150,235,177],{"class":156},[150,237,238],{"class":167}," smallest,\n",[150,240,242,245,247,249],{"class":152,"line":241},7,[150,243,244],{"class":163},"  MAX",[150,246,207],{"class":167},[150,248,177],{"class":156},[150,250,251],{"class":167}," largest\n",[150,253,255,258],{"class":152,"line":254},8,[150,256,257],{"class":156},"FROM",[150,259,260],{"class":167}," orders;\n",[150,262,264],{"class":152,"line":263},9,[150,265,267],{"class":266},"sdCPZ","--  total_orders | unique_customers | revenue | avg_order | smallest | largest\n",[150,269,271],{"class":152,"line":270},10,[150,272,273],{"class":266},"--  -------------+------------------+---------+----------+----------+---------\n",[150,275,277],{"class":152,"line":276},11,[150,278,279],{"class":266},"--           4   |        3         |  568.75 |  142.19  |   7.25   |  450.00\n",[281,282,284,286,287,286,289],"h3",{"id":283},"count-vs-countcol-vs-count1",[47,285,49],{}," vs ",[47,288,59],{},[47,290,291],{},"COUNT(1)",[293,294,295,306,318],"ul",{},[296,297,298,300,301,305],"li",{},[47,299,49],{}," counts ",[302,303,304],"strong",{},"all rows",", including those where every column is NULL.",[296,307,308,310,311,313,314,317],{},[47,309,59],{}," counts rows where ",[47,312,65],{}," is ",[302,315,316],{},"not NULL"," — it skips NULLs in that column.",[296,319,320,322,323,326,327,330,331,333,334,336,337,339],{},[47,321,291],{}," (or ",[47,324,325],{},"COUNT(0)",", ",[47,328,329],{},"COUNT('x')",") counts all rows — the constant is never NULL, so it behaves like ",[47,332,49],{},". It's a myth that ",[47,335,291],{}," is faster; the planner optimizes both identically. Use ",[47,338,49],{}," for clarity.",[138,341,342],{"language":140},[142,343,345],{"className":144,"code":344,"language":140,"meta":146,"style":146},"-- count(*) counts the customer even though city is NULL\nSELECT COUNT(*) AS total, COUNT(city) AS with_city FROM customers;\n--  total | with_city\n--  ------+----------\n--     3  |     2     -- Carol has city = NULL\n",[47,346,347,352,387,392,397],{"__ignoreMap":146},[150,348,349],{"class":152,"line":153},[150,350,351],{"class":266},"-- count(*) counts the customer even though city is NULL\n",[150,353,354,357,360,362,364,366,368,371,374,377,379,382,384],{"class":152,"line":160},[150,355,356],{"class":156},"SELECT",[150,358,359],{"class":163}," COUNT",[150,361,168],{"class":167},[150,363,171],{"class":156},[150,365,174],{"class":167},[150,367,177],{"class":156},[150,369,370],{"class":167}," total, ",[150,372,373],{"class":163},"COUNT",[150,375,376],{"class":167},"(city) ",[150,378,177],{"class":156},[150,380,381],{"class":167}," with_city ",[150,383,257],{"class":156},[150,385,386],{"class":167}," customers;\n",[150,388,389],{"class":152,"line":183},[150,390,391],{"class":266},"--  total | with_city\n",[150,393,394],{"class":152,"line":201},[150,395,396],{"class":266},"--  ------+----------\n",[150,398,399],{"class":152,"line":215},[150,400,401],{"class":266},"--     3  |     2     -- Carol has city = NULL\n",[18,403,405],{"id":404},"group-by","GROUP BY",[14,407,408,410,411,414],{},[47,409,405],{}," splits rows into groups, then applies aggregates ",[302,412,413],{},"per group",". Each group becomes one row in the output.",[138,416,417],{"language":140},[142,418,420],{"className":144,"code":419,"language":140,"meta":146,"style":146},"-- Total spend per customer\nSELECT customer_id, SUM(amount) AS total_spent\nFROM orders\nGROUP BY customer_id\nORDER BY total_spent DESC;\n\n-- Order count and average per city\nSELECT c.city, COUNT(*) AS order_count, AVG(o.amount) AS avg_amount\nFROM customers c\nJOIN orders o ON c.id = o.customer_id\nGROUP BY c.city;\n",[47,421,422,427,444,451,458,472,478,483,530,537,566],{"__ignoreMap":146},[150,423,424],{"class":152,"line":153},[150,425,426],{"class":266},"-- Total spend per customer\n",[150,428,429,431,434,437,439,441],{"class":152,"line":160},[150,430,356],{"class":156},[150,432,433],{"class":167}," customer_id, ",[150,435,436],{"class":163},"SUM",[150,438,207],{"class":167},[150,440,177],{"class":156},[150,442,443],{"class":167}," total_spent\n",[150,445,446,448],{"class":152,"line":183},[150,447,257],{"class":156},[150,449,450],{"class":167}," orders\n",[150,452,453,455],{"class":152,"line":201},[150,454,405],{"class":156},[150,456,457],{"class":167}," customer_id\n",[150,459,460,463,466,469],{"class":152,"line":215},[150,461,462],{"class":156},"ORDER BY",[150,464,465],{"class":167}," total_spent ",[150,467,468],{"class":156},"DESC",[150,470,471],{"class":167},";\n",[150,473,474],{"class":152,"line":228},[150,475,477],{"emptyLinePlaceholder":476},true,"\n",[150,479,480],{"class":152,"line":241},[150,481,482],{"class":266},"-- Order count and average per city\n",[150,484,485,487,490,492,495,497,499,501,503,505,507,510,513,515,518,520,523,525,527],{"class":152,"line":254},[150,486,356],{"class":156},[150,488,489],{"class":163}," c",[150,491,66],{"class":167},[150,493,494],{"class":163},"city",[150,496,326],{"class":167},[150,498,373],{"class":163},[150,500,168],{"class":167},[150,502,171],{"class":156},[150,504,174],{"class":167},[150,506,177],{"class":156},[150,508,509],{"class":167}," order_count, ",[150,511,512],{"class":163},"AVG",[150,514,168],{"class":167},[150,516,517],{"class":163},"o",[150,519,66],{"class":167},[150,521,522],{"class":163},"amount",[150,524,174],{"class":167},[150,526,177],{"class":156},[150,528,529],{"class":167}," avg_amount\n",[150,531,532,534],{"class":152,"line":263},[150,533,257],{"class":156},[150,535,536],{"class":167}," customers c\n",[150,538,539,542,545,548,550,552,555,558,561,563],{"class":152,"line":270},[150,540,541],{"class":156},"JOIN",[150,543,544],{"class":167}," orders o ",[150,546,547],{"class":156},"ON",[150,549,489],{"class":163},[150,551,66],{"class":167},[150,553,554],{"class":163},"id",[150,556,557],{"class":156}," =",[150,559,560],{"class":163}," o",[150,562,66],{"class":167},[150,564,565],{"class":163},"customer_id\n",[150,567,568,570,572,574,576],{"class":152,"line":276},[150,569,405],{"class":156},[150,571,489],{"class":163},[150,573,66],{"class":167},[150,575,494],{"class":163},[150,577,471],{"class":167},[281,579,581],{"id":580},"the-golden-rule-of-group-by","The Golden Rule of GROUP BY",[14,583,584,585,587],{},"Every column in the ",[47,586,356],{}," list must be either:",[589,590,591,599],"ol",{},[296,592,593,598],{},[302,594,595,596],{},"Listed in ",[47,597,405],{},", or",[296,600,601,66],{},[302,602,603],{},"Wrapped in an aggregate function",[138,605,606],{"language":140},[142,607,609],{"className":144,"code":608,"language":140,"meta":146,"style":146},"-- ❌ ERROR: column \"o.amount\" must appear in GROUP BY or be used in an aggregate\nSELECT customer_id, amount FROM orders GROUP BY customer_id;\n\n-- ✅ amount is aggregated\nSELECT customer_id, SUM(amount) FROM orders GROUP BY customer_id;\n\n-- ✅ amount is in GROUP BY (gives per-(customer, amount) groups — usually not intended)\nSELECT customer_id, amount FROM orders GROUP BY customer_id, amount;\n",[47,610,611,616,633,637,642,660,664,669],{"__ignoreMap":146},[150,612,613],{"class":152,"line":153},[150,614,615],{"class":266},"-- ❌ ERROR: column \"o.amount\" must appear in GROUP BY or be used in an aggregate\n",[150,617,618,620,623,625,628,630],{"class":152,"line":160},[150,619,356],{"class":156},[150,621,622],{"class":167}," customer_id, amount ",[150,624,257],{"class":156},[150,626,627],{"class":167}," orders ",[150,629,405],{"class":156},[150,631,632],{"class":167}," customer_id;\n",[150,634,635],{"class":152,"line":183},[150,636,477],{"emptyLinePlaceholder":476},[150,638,639],{"class":152,"line":201},[150,640,641],{"class":266},"-- ✅ amount is aggregated\n",[150,643,644,646,648,650,652,654,656,658],{"class":152,"line":215},[150,645,356],{"class":156},[150,647,433],{"class":167},[150,649,436],{"class":163},[150,651,207],{"class":167},[150,653,257],{"class":156},[150,655,627],{"class":167},[150,657,405],{"class":156},[150,659,632],{"class":167},[150,661,662],{"class":152,"line":228},[150,663,477],{"emptyLinePlaceholder":476},[150,665,666],{"class":152,"line":241},[150,667,668],{"class":266},"-- ✅ amount is in GROUP BY (gives per-(customer, amount) groups — usually not intended)\n",[150,670,671,673,675,677,679,681],{"class":152,"line":254},[150,672,356],{"class":156},[150,674,622],{"class":167},[150,676,257],{"class":156},[150,678,627],{"class":167},[150,680,405],{"class":156},[150,682,683],{"class":167}," customer_id, amount;\n",[14,685,686,687,689],{},"The rule is logical: when rows collapse into groups, which ",[47,688,522],{}," value should appear for a group with 5 rows? There's no single answer — so SQL requires you to aggregate it or group by it.",[281,691,693],{"id":692},"functional-dependency-exception-postgresql","Functional Dependency Exception (PostgreSQL)",[14,695,696,697,699,700,703],{},"PostgreSQL allows selecting a column not in ",[47,698,405],{}," if it's ",[302,701,702],{},"functionally dependent"," on the grouping columns — typically a primary key:",[138,705,706],{"language":140},[142,707,709],{"className":144,"code":708,"language":140,"meta":146,"style":146},"-- OK in PostgreSQL: c.id is the PK of customers, so c.name is determined by it\nSELECT c.id, c.name, COUNT(o.id) AS order_count\nFROM customers c LEFT JOIN orders o ON c.id = o.customer_id\nGROUP BY c.id;   -- c.name not listed, but allowed because c.id is the PK\n",[47,710,711,716,755,783],{"__ignoreMap":146},[150,712,713],{"class":152,"line":153},[150,714,715],{"class":266},"-- OK in PostgreSQL: c.id is the PK of customers, so c.name is determined by it\n",[150,717,718,720,722,724,726,728,731,733,736,738,740,742,744,746,748,750,752],{"class":152,"line":160},[150,719,356],{"class":156},[150,721,489],{"class":163},[150,723,66],{"class":167},[150,725,554],{"class":163},[150,727,326],{"class":167},[150,729,730],{"class":163},"c",[150,732,66],{"class":167},[150,734,735],{"class":163},"name",[150,737,326],{"class":167},[150,739,373],{"class":163},[150,741,168],{"class":167},[150,743,517],{"class":163},[150,745,66],{"class":167},[150,747,554],{"class":163},[150,749,174],{"class":167},[150,751,177],{"class":156},[150,753,754],{"class":167}," order_count\n",[150,756,757,759,762,765,767,769,771,773,775,777,779,781],{"class":152,"line":183},[150,758,257],{"class":156},[150,760,761],{"class":167}," customers c ",[150,763,764],{"class":156},"LEFT JOIN",[150,766,544],{"class":167},[150,768,547],{"class":156},[150,770,489],{"class":163},[150,772,66],{"class":167},[150,774,554],{"class":163},[150,776,557],{"class":156},[150,778,560],{"class":163},[150,780,66],{"class":167},[150,782,565],{"class":163},[150,784,785,787,789,791,793,796],{"class":152,"line":201},[150,786,405],{"class":156},[150,788,489],{"class":163},[150,790,66],{"class":167},[150,792,554],{"class":163},[150,794,795],{"class":167},";   ",[150,797,798],{"class":266},"-- c.name not listed, but allowed because c.id is the PK\n",[14,800,801,802,805,806,810],{},"This is standard SQL (feature T301) but not universally supported — MySQL's ",[47,803,804],{},"ONLY_FULL_GROUP_BY"," mode enforces it; older MySQL allowed ",[807,808,809],"em",{},"any"," column (silently picking an arbitrary value, a common bug source). Don't rely on the exception for portability; group by all non-aggregated columns.",[18,812,814],{"id":813},"having-filtering-groups","HAVING — Filtering Groups",[14,816,817,820,821,824,825,820,828,831,832,834,835,837],{},[47,818,819],{},"WHERE"," filters ",[302,822,823],{},"input rows"," (before grouping). ",[47,826,827],{},"HAVING",[302,829,830],{},"output groups"," (after grouping). Conditions in ",[47,833,827],{}," can reference aggregates; conditions in ",[47,836,819],{}," cannot.",[138,839,840],{"language":140},[142,841,843],{"className":144,"code":842,"language":140,"meta":146,"style":146},"-- Customers who spent more than $100 total\nSELECT customer_id, SUM(amount) AS total_spent\nFROM orders\nGROUP BY customer_id\nHAVING SUM(amount) > 100;\n\n-- Customers with at least 3 orders, placed after 2024-01-01\nSELECT customer_id, COUNT(*) AS n\nFROM orders\nWHERE ordered_on >= '2024-01-01'   -- row filter (before grouping)\nGROUP BY customer_id\nHAVING COUNT(*) >= 3;              -- group filter (after grouping)\n",[47,844,845,850,864,870,876,893,897,902,921,927,944,950],{"__ignoreMap":146},[150,846,847],{"class":152,"line":153},[150,848,849],{"class":266},"-- Customers who spent more than $100 total\n",[150,851,852,854,856,858,860,862],{"class":152,"line":160},[150,853,356],{"class":156},[150,855,433],{"class":167},[150,857,436],{"class":163},[150,859,207],{"class":167},[150,861,177],{"class":156},[150,863,443],{"class":167},[150,865,866,868],{"class":152,"line":183},[150,867,257],{"class":156},[150,869,450],{"class":167},[150,871,872,874],{"class":152,"line":201},[150,873,405],{"class":156},[150,875,457],{"class":167},[150,877,878,880,883,885,888,891],{"class":152,"line":215},[150,879,827],{"class":156},[150,881,882],{"class":163}," SUM",[150,884,207],{"class":167},[150,886,887],{"class":156},">",[150,889,890],{"class":163}," 100",[150,892,471],{"class":167},[150,894,895],{"class":152,"line":228},[150,896,477],{"emptyLinePlaceholder":476},[150,898,899],{"class":152,"line":241},[150,900,901],{"class":266},"-- Customers with at least 3 orders, placed after 2024-01-01\n",[150,903,904,906,908,910,912,914,916,918],{"class":152,"line":254},[150,905,356],{"class":156},[150,907,433],{"class":167},[150,909,373],{"class":163},[150,911,168],{"class":167},[150,913,171],{"class":156},[150,915,174],{"class":167},[150,917,177],{"class":156},[150,919,920],{"class":167}," n\n",[150,922,923,925],{"class":152,"line":263},[150,924,257],{"class":156},[150,926,450],{"class":167},[150,928,929,931,934,937,941],{"class":152,"line":270},[150,930,819],{"class":156},[150,932,933],{"class":167}," ordered_on ",[150,935,936],{"class":156},">=",[150,938,940],{"class":939},"sJ6F3"," '2024-01-01'",[150,942,943],{"class":266},"   -- row filter (before grouping)\n",[150,945,946,948],{"class":152,"line":276},[150,947,405],{"class":156},[150,949,457],{"class":167},[150,951,953,955,957,959,961,963,965,968,971],{"class":152,"line":952},12,[150,954,827],{"class":156},[150,956,359],{"class":163},[150,958,168],{"class":167},[150,960,171],{"class":156},[150,962,174],{"class":167},[150,964,936],{"class":156},[150,966,967],{"class":163}," 3",[150,969,970],{"class":167},";              ",[150,972,973],{"class":266},"-- group filter (after grouping)\n",[281,975,977],{"id":976},"where-vs-having-when-to-use-which","WHERE vs HAVING — when to use which",[23,979,980,990],{},[26,981,982],{},[29,983,984,987],{},[32,985,986],{},"Filter on",[32,988,989],{},"Clause",[39,991,992,1005,1017],{},[29,993,994,1001],{},[44,995,996,997,1000],{},"A raw column value (",[47,998,999],{},"amount > 100",")",[44,1002,1003],{},[47,1004,819],{},[29,1006,1007,1013],{},[44,1008,1009,1010,1000],{},"An aggregate (",[47,1011,1012],{},"SUM(amount) > 100",[44,1014,1015],{},[47,1016,827],{},[29,1018,1019,1022],{},[44,1020,1021],{},"Both",[44,1023,1024,1026,1027,1029],{},[47,1025,819],{}," for the raw, ",[47,1028,827],{}," for the aggregate",[14,1031,1032,1033,1035,1036,1038,1039,1042,1043,1045],{},"Putting a raw-column filter in ",[47,1034,827],{}," works but is slower — ",[47,1037,819],{}," eliminates rows ",[807,1040,1041],{},"before"," grouping, shrinking the work; ",[47,1044,827],{}," groups first, then filters. Push filters as early as possible.",[18,1047,1049],{"id":1048},"group-by-multiple-columns","GROUP BY Multiple Columns",[14,1051,1052,1053,1056],{},"Grouping by multiple columns produces a group for ",[302,1054,1055],{},"each unique combination",":",[138,1058,1059],{"language":140},[142,1060,1062],{"className":144,"code":1061,"language":140,"meta":146,"style":146},"-- Orders per customer per year\nSELECT customer_id, EXTRACT(YEAR FROM ordered_on) AS yr, COUNT(*) AS n\nFROM orders\nGROUP BY customer_id, EXTRACT(YEAR FROM ordered_on)\nORDER BY customer_id, yr;\n",[47,1063,1064,1069,1102,1108,1121],{"__ignoreMap":146},[150,1065,1066],{"class":152,"line":153},[150,1067,1068],{"class":266},"-- Orders per customer per year\n",[150,1070,1071,1073,1076,1079,1082,1085,1087,1090,1092,1094,1096,1098,1100],{"class":152,"line":160},[150,1072,356],{"class":156},[150,1074,1075],{"class":167}," customer_id, EXTRACT(",[150,1077,1078],{"class":156},"YEAR",[150,1080,1081],{"class":156}," FROM",[150,1083,1084],{"class":167}," ordered_on) ",[150,1086,177],{"class":156},[150,1088,1089],{"class":167}," yr, ",[150,1091,373],{"class":163},[150,1093,168],{"class":167},[150,1095,171],{"class":156},[150,1097,174],{"class":167},[150,1099,177],{"class":156},[150,1101,920],{"class":167},[150,1103,1104,1106],{"class":152,"line":183},[150,1105,257],{"class":156},[150,1107,450],{"class":167},[150,1109,1110,1112,1114,1116,1118],{"class":152,"line":201},[150,1111,405],{"class":156},[150,1113,1075],{"class":167},[150,1115,1078],{"class":156},[150,1117,1081],{"class":156},[150,1119,1120],{"class":167}," ordered_on)\n",[150,1122,1123,1125],{"class":152,"line":215},[150,1124,462],{"class":156},[150,1126,1127],{"class":167}," customer_id, yr;\n",[14,1129,1130,1131,1133],{},"The order of columns in ",[47,1132,405],{}," doesn't affect the result (groups are unordered sets) — but it can affect the planner's choice of sort vs hash aggregation.",[18,1135,1137],{"id":1136},"group-by-rollup-cube-grouping-sets","GROUP BY ROLLUP \u002F CUBE \u002F GROUPING SETS",[14,1139,1140,1141,1144],{},"These produce ",[302,1142,1143],{},"multiple levels of aggregation"," in one query — subtotals and grand totals.",[281,1146,1148,1151],{"id":1147},"grouping-sets-specific-combinations",[47,1149,1150],{},"GROUPING SETS"," — specific combinations",[138,1153,1154],{"language":140},[142,1155,1157],{"className":144,"code":1156,"language":140,"meta":146,"style":146},"-- Sales by (city, year), plus subtotals by city, by year, and a grand total\nSELECT city, EXTRACT(YEAR FROM ordered_on) AS yr, SUM(amount) AS total\nFROM customers c JOIN orders o ON c.id = o.customer_id\nGROUP BY GROUPING SETS (\n  (city, yr),   -- each city-year combo\n  (city),       -- subtotal per city (across all years)\n  (yr),         -- subtotal per year (across all cities)\n  ()            -- grand total\n);\n",[47,1158,1159,1164,1190,1216,1229,1237,1245,1253,1261],{"__ignoreMap":146},[150,1160,1161],{"class":152,"line":153},[150,1162,1163],{"class":266},"-- Sales by (city, year), plus subtotals by city, by year, and a grand total\n",[150,1165,1166,1168,1171,1173,1175,1177,1179,1181,1183,1185,1187],{"class":152,"line":160},[150,1167,356],{"class":156},[150,1169,1170],{"class":167}," city, EXTRACT(",[150,1172,1078],{"class":156},[150,1174,1081],{"class":156},[150,1176,1084],{"class":167},[150,1178,177],{"class":156},[150,1180,1089],{"class":167},[150,1182,436],{"class":163},[150,1184,207],{"class":167},[150,1186,177],{"class":156},[150,1188,1189],{"class":167}," total\n",[150,1191,1192,1194,1196,1198,1200,1202,1204,1206,1208,1210,1212,1214],{"class":152,"line":183},[150,1193,257],{"class":156},[150,1195,761],{"class":167},[150,1197,541],{"class":156},[150,1199,544],{"class":167},[150,1201,547],{"class":156},[150,1203,489],{"class":163},[150,1205,66],{"class":167},[150,1207,554],{"class":163},[150,1209,557],{"class":156},[150,1211,560],{"class":163},[150,1213,66],{"class":167},[150,1215,565],{"class":163},[150,1217,1218,1220,1223,1226],{"class":152,"line":201},[150,1219,405],{"class":156},[150,1221,1222],{"class":167}," GROUPING ",[150,1224,1225],{"class":156},"SETS",[150,1227,1228],{"class":167}," (\n",[150,1230,1231,1234],{"class":152,"line":215},[150,1232,1233],{"class":167},"  (city, yr),   ",[150,1235,1236],{"class":266},"-- each city-year combo\n",[150,1238,1239,1242],{"class":152,"line":228},[150,1240,1241],{"class":167},"  (city),       ",[150,1243,1244],{"class":266},"-- subtotal per city (across all years)\n",[150,1246,1247,1250],{"class":152,"line":241},[150,1248,1249],{"class":167},"  (yr),         ",[150,1251,1252],{"class":266},"-- subtotal per year (across all cities)\n",[150,1254,1255,1258],{"class":152,"line":254},[150,1256,1257],{"class":167},"  ()            ",[150,1259,1260],{"class":266},"-- grand total\n",[150,1262,1263],{"class":152,"line":263},[150,1264,1265],{"class":167},");\n",[14,1267,1268,1269,1272],{},"NULL appears in the columns not being grouped for each subtotal row. Distinguish \"real NULL\" from \"subtotal marker\" with ",[47,1270,1271],{},"GROUPING(col)"," — returns 1 when the column is a subtotal (NULL because of grouping), 0 otherwise.",[281,1274,1276,1279],{"id":1275},"rollup-hierarchical-subtotals",[47,1277,1278],{},"ROLLUP"," — hierarchical subtotals",[138,1281,1282],{"language":140},[142,1283,1285],{"className":144,"code":1284,"language":140,"meta":146,"style":146},"-- Subtotals for (city, year), (city), and grand total — in one hierarchy\nSELECT city, yr, SUM(amount) FROM ... GROUP BY ROLLUP (city, yr);\n",[47,1286,1287,1292],{"__ignoreMap":146},[150,1288,1289],{"class":152,"line":153},[150,1290,1291],{"class":266},"-- Subtotals for (city, year), (city), and grand total — in one hierarchy\n",[150,1293,1294,1296,1299,1301,1303,1305,1308,1310,1313],{"class":152,"line":160},[150,1295,356],{"class":156},[150,1297,1298],{"class":167}," city, yr, ",[150,1300,436],{"class":163},[150,1302,207],{"class":167},[150,1304,257],{"class":156},[150,1306,1307],{"class":167}," ... ",[150,1309,405],{"class":156},[150,1311,1312],{"class":156}," ROLLUP",[150,1314,1315],{"class":167}," (city, yr);\n",[14,1317,1318,1319,1322],{},"Equivalent to ",[47,1320,1321],{},"GROUPING SETS ((city, yr), (city), ())",". Useful for hierarchical dimensions (region → country → city).",[281,1324,1326,1329],{"id":1325},"cube-all-combinations",[47,1327,1328],{},"CUBE"," — all combinations",[138,1331,1332],{"language":140},[142,1333,1335],{"className":144,"code":1334,"language":140,"meta":146,"style":146},"-- Every combination of city and year subtotals\nSELECT city, yr, SUM(amount) FROM ... GROUP BY CUBE (city, yr);\n",[47,1336,1337,1342],{"__ignoreMap":146},[150,1338,1339],{"class":152,"line":153},[150,1340,1341],{"class":266},"-- Every combination of city and year subtotals\n",[150,1343,1344,1346,1348,1350,1352,1354,1356,1358,1361],{"class":152,"line":160},[150,1345,356],{"class":156},[150,1347,1298],{"class":167},[150,1349,436],{"class":163},[150,1351,207],{"class":167},[150,1353,257],{"class":156},[150,1355,1307],{"class":167},[150,1357,405],{"class":156},[150,1359,1360],{"class":156}," CUBE",[150,1362,1315],{"class":167},[14,1364,1318,1365,1368],{},[47,1366,1367],{},"GROUPING SETS ((city, yr), (city), (yr), ())",". Use when you want a full cross-tab of subtotals.",[14,1370,1371,1372,1374,1375,1377,1378,1380],{},"PostgreSQL supports all three. MySQL supports ",[47,1373,1278],{}," (with a slightly different syntax for NULL handling). SQLite supports ",[47,1376,405],{}," extensions only via ",[47,1379,1150],{}," in 3.44+.",[18,1382,1384],{"id":1383},"filtering-with-aggregates-without-group-by","Filtering with Aggregates Without GROUP BY",[14,1386,1387,1388,1390,1391,1394],{},"A query with an aggregate but no ",[47,1389,405],{}," produces a ",[302,1392,1393],{},"single group"," (the whole table):",[138,1396,1397],{"language":140},[142,1398,1400],{"className":144,"code":1399,"language":140,"meta":146,"style":146},"SELECT SUM(amount) FROM orders;   -- one row: the total of all orders\n",[47,1401,1402],{"__ignoreMap":146},[150,1403,1404,1406,1408,1410,1412,1415],{"class":152,"line":153},[150,1405,356],{"class":156},[150,1407,882],{"class":163},[150,1409,207],{"class":167},[150,1411,257],{"class":156},[150,1413,1414],{"class":167}," orders;   ",[150,1416,1417],{"class":266},"-- one row: the total of all orders\n",[14,1419,1420,1421,1424,1425,1427],{},"Even if the table has zero rows, this returns one row with ",[47,1422,1423],{},"SUM = NULL"," (not zero rows). To get zero rows from an empty table, add a ",[47,1426,827],{}," that's false, or filter in an outer query.",[18,1429,1431],{"id":1430},"tips-tricks","💡 Tips & Tricks",[293,1433,1434,1456,1477,1490,1510],{},[296,1435,1436,1439,1440,1443,1444,1446,1447,1449,1450,1452,1453,1455],{},[302,1437,1438],{},"Idiom",": use ",[47,1441,1442],{},"COUNT(o.id)"," (a non-nullable right-table column) instead of ",[47,1445,49],{}," when counting matches in a ",[47,1448,764],{}," — ",[47,1451,49],{}," counts the NULL-extended row for unmatched left rows as 1, inflating the count; ",[47,1454,1442],{}," skips NULLs and counts only real matches.",[296,1457,1458,1461,1462,1464,1465,1468,1469,1472,1473,1476],{},[302,1459,1460],{},"Performance",": ",[47,1463,73],{}," can be slow on large tables (it must sort or hash all values to deduplicate). For approximate distinct counts at scale, PostgreSQL has ",[47,1466,1467],{},"HyperLogLog"," via the ",[47,1470,1471],{},"hll"," extension, or the native ",[47,1474,1475],{},"approx_count_distinct"," in some setups — trading exactness for O(1) memory.",[296,1478,1479,1481,1482,1485,1486,1489],{},[302,1480,1438],{},": prefer ",[47,1483,1484],{},"SUM(CASE WHEN condition THEN 1 ELSE 0 END)"," (or the shorter ",[47,1487,1488],{},"COUNT(*) FILTER (WHERE condition)"," in PostgreSQL) over multiple subqueries for conditional counts — one pass over the data, multiple metrics per row.",[296,1491,1492,1495,1496,1498,1499,1502,1503,1506,1507,1509],{},[302,1493,1494],{},"Debug",": if a ",[47,1497,405],{}," query returns ",[807,1500,1501],{},"fewer"," groups than expected, check whether the grouping column has NULLs — all NULLs collapse into a single \"NULL group,\" so 100 NULL-valued rows become one group. If that's not desired, ",[47,1504,1505],{},"COALESCE(col, 'unknown')"," in the ",[47,1508,405],{}," makes the NULLs an explicit bucket.",[296,1511,1512,1461,1515,1518,1519,1522,1523,1526],{},[302,1513,1514],{},"Portability",[47,1516,1517],{},"string_agg(col, ',' ORDER BY col)"," (PostgreSQL) is ",[47,1520,1521],{},"GROUP_CONCAT(col ORDER BY col SEPARATOR ',')"," (MySQL) or ",[47,1524,1525],{},"LISTAGG(col, ',')"," (Oracle\u002FSQL Server) — string aggregation is one of the least portable areas of SQL. Pick your engine's function and document it.",[18,1528,1530],{"id":1529},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[293,1532,1533,1559,1574,1588,1610,1646,1660,1679,1693],{},[296,1534,1535,1461,1540,1543,1544,313,1547,1550,1551,1554,1555,1558],{},[302,1536,1537,1539],{},[47,1538,512],{}," ignores NULLs, doesn't treat them as 0",[47,1541,1542],{},"AVG(amount)"," over rows ",[47,1545,1546],{},"[10, 20, NULL]",[47,1548,1549],{},"15",", not ",[47,1552,1553],{},"10",". If you want NULL treated as 0, use ",[47,1556,1557],{},"AVG(COALESCE(amount, 0))"," — but ask whether that's semantically right (a missing value isn't necessarily zero).",[296,1560,1561,1461,1566,1569,1570,1573],{},[302,1562,1563,1565],{},[47,1564,436],{}," of an empty set is NULL, not 0",[47,1567,1568],{},"SELECT SUM(amount) FROM orders WHERE FALSE"," returns NULL. Use ",[47,1571,1572],{},"COALESCE(SUM(amount), 0)"," when you need 0 for \"no rows.\"",[296,1575,1576,1581,1582,1584,1585,1587],{},[302,1577,1578,1580],{},[47,1579,49],{}," on an empty group is 0, not NULL",": aggregates other than ",[47,1583,373],{}," return NULL on empty input; ",[47,1586,373],{}," returns 0. This asymmetry is a frequent source of confusion.",[296,1589,1590,1461,1598,1601,1602,1604,1605,1607,1608,66],{},[302,1591,1592,1594,1595],{},[47,1593,405],{}," and ",[47,1596,1597],{},"SELECT *",[47,1599,1600],{},"SELECT * ... GROUP BY x"," is almost always an error (columns not in ",[47,1603,405],{}," and not aggregated). Don't combine ",[47,1606,171],{}," with ",[47,1609,405],{},[296,1611,1612,1620,1621,1617,1624,1627,1628,1630,1631,1634,1635,1638,1639,1617,1642,1645],{},[302,1613,1614,1615,1617,1618],{},"Floating-point ",[47,1616,436],{},"\u002F",[47,1619,512],{},": summing ",[47,1622,1623],{},"REAL",[47,1625,1626],{},"DOUBLE PRECISION"," is subject to floating-point error — ",[47,1629,436],{}," of ",[47,1632,1633],{},"[0.1, 0.1, 0.1]"," may be ",[47,1636,1637],{},"0.30000000000000004",". Use ",[47,1640,1641],{},"NUMERIC",[47,1643,1644],{},"DECIMAL"," for money and exact arithmetic.",[296,1647,1648,1655,1656,1659],{},[302,1649,1650,1652,1653],{},[47,1651,827],{}," without ",[47,1654,405],{},": legal — treats the whole table as one group. ",[47,1657,1658],{},"SELECT COUNT(*) FROM orders HAVING COUNT(*) > 0"," returns one row if the table is non-empty, zero rows if empty (a way to \"return something only if there's data\").",[296,1661,1662,1667,1668,1671,1672,1674,1675,1678],{},[302,1663,1664,1665],{},"Alias in ",[47,1666,827],{},": PostgreSQL allows ",[47,1669,1670],{},"HAVING total_spent > 100"," (using the ",[47,1673,356],{}," alias), but the SQL standard and most engines require ",[47,1676,1677],{},"HAVING SUM(amount) > 100"," (the raw expression). Use the raw expression for portability.",[296,1680,1681,1461,1686,1689,1690,1692],{},[302,1682,1683,1685],{},[47,1684,405],{}," ordinal",[47,1687,1688],{},"GROUP BY 1, 2"," (group by first and second selected columns) is legal but fragile — reordering ",[47,1691,356],{}," columns silently changes the grouping. Prefer explicit column names.",[296,1694,1695,1461,1704,1707,1708,1710,1711,1714,1715,1718],{},[302,1696,1697,1617,1700,1703],{},[47,1698,1699],{},"MIN",[47,1701,1702],{},"MAX"," on text",[47,1705,1706],{},"MIN(name)"," returns the lexicographically smallest string per the column's collation — collation affects the result, so ",[47,1709,1699],{}," on a case-insensitive collation may return ",[47,1712,1713],{},"'apple'"," before ",[47,1716,1717],{},"'Banana'"," differently than a case-sensitive one.",[18,1720,1722],{"id":1721},"spot-the-bug","🧠 Spot the Bug",[14,1724,1725],{},"This query is supposed to report the average order amount per city, but the averages look wrong for cities with few orders. What's the subtle issue?",[138,1727,1728],{"language":140},[142,1729,1731],{"className":144,"code":1730,"language":140,"meta":146,"style":146},"SELECT c.city, AVG(o.amount) AS avg_amount\nFROM customers c\nLEFT JOIN orders o ON c.id = o.customer_id\nGROUP BY c.city;\n",[47,1732,1733,1761,1767,1789],{"__ignoreMap":146},[150,1734,1735,1737,1739,1741,1743,1745,1747,1749,1751,1753,1755,1757,1759],{"class":152,"line":153},[150,1736,356],{"class":156},[150,1738,489],{"class":163},[150,1740,66],{"class":167},[150,1742,494],{"class":163},[150,1744,326],{"class":167},[150,1746,512],{"class":163},[150,1748,168],{"class":167},[150,1750,517],{"class":163},[150,1752,66],{"class":167},[150,1754,522],{"class":163},[150,1756,174],{"class":167},[150,1758,177],{"class":156},[150,1760,529],{"class":167},[150,1762,1763,1765],{"class":152,"line":160},[150,1764,257],{"class":156},[150,1766,536],{"class":167},[150,1768,1769,1771,1773,1775,1777,1779,1781,1783,1785,1787],{"class":152,"line":183},[150,1770,764],{"class":156},[150,1772,544],{"class":167},[150,1774,547],{"class":156},[150,1776,489],{"class":163},[150,1778,66],{"class":167},[150,1780,554],{"class":163},[150,1782,557],{"class":156},[150,1784,560],{"class":163},[150,1786,66],{"class":167},[150,1788,565],{"class":163},[150,1790,1791,1793,1795,1797,1799],{"class":152,"line":201},[150,1792,405],{"class":156},[150,1794,489],{"class":163},[150,1796,66],{"class":167},[150,1798,494],{"class":163},[150,1800,471],{"class":167},[1802,1803,1804,1808,1811,1843,2053],"details",{},[1805,1806,1807],"summary",{},"Answer",[14,1809,1810],{},"There are two potential surprises, depending on the data:",[589,1812,1813,1833],{},[296,1814,1815,1818,1819,1821,1822,1825,1826,1828,1829,1832],{},[302,1816,1817],{},"Customers with no orders pull the average toward NULL\u002F0 via the NULL-extended row."," The ",[47,1820,764],{}," produces a row with ",[47,1823,1824],{},"o.amount = NULL"," for customers with no orders. ",[47,1827,512],{}," ignores NULLs, so a customer with no orders contributes nothing to the average — ",[807,1830,1831],{},"not"," zero. This is actually correct behavior, but it can confuse someone who expects \"no orders\" to count as $0.",[296,1834,1835,1838,1839,1842],{},[302,1836,1837],{},"The real bug: the average is per-(customer's orders), weighted equally per order, not per customer."," If Alice (NYC) has 1 order of $100 and Bob (NYC) has 10 orders averaging $20, the query reports NYC's average as ",[47,1840,1841],{},"(100 + 200) \u002F 11 = $27.27"," — the per-order average. If the intent was \"average customer spend in NYC\" (Alice's $100 vs Bob's $200, average = $150), you need a nested aggregate: average the per-customer totals.",[142,1844,1846],{"className":144,"code":1845,"language":140,"meta":146,"style":146},"-- Per-order average (what the original computes)\nSELECT c.city, AVG(o.amount) FROM customers c JOIN orders o ON c.id=o.customer_id GROUP BY c.city;\n\n-- Per-customer average (average of each customer's total)\nSELECT c.city, AVG(customer_total) AS avg_customer_spend\nFROM (\n  SELECT c.city, c.id, SUM(o.amount) AS customer_total\n  FROM customers c JOIN orders o ON c.id = o.customer_id\n  GROUP BY c.city, c.id\n) c\nGROUP BY c.city;\n",[47,1847,1848,1853,1914,1918,1923,1945,1951,1989,2016,2036,2041],{"__ignoreMap":146},[150,1849,1850],{"class":152,"line":153},[150,1851,1852],{"class":266},"-- Per-order average (what the original computes)\n",[150,1854,1855,1857,1859,1861,1863,1865,1867,1869,1871,1873,1875,1877,1879,1881,1883,1885,1887,1889,1891,1893,1896,1898,1900,1903,1906,1908,1910,1912],{"class":152,"line":160},[150,1856,356],{"class":156},[150,1858,489],{"class":163},[150,1860,66],{"class":167},[150,1862,494],{"class":163},[150,1864,326],{"class":167},[150,1866,512],{"class":163},[150,1868,168],{"class":167},[150,1870,517],{"class":163},[150,1872,66],{"class":167},[150,1874,522],{"class":163},[150,1876,174],{"class":167},[150,1878,257],{"class":156},[150,1880,761],{"class":167},[150,1882,541],{"class":156},[150,1884,544],{"class":167},[150,1886,547],{"class":156},[150,1888,489],{"class":163},[150,1890,66],{"class":167},[150,1892,554],{"class":163},[150,1894,1895],{"class":156},"=",[150,1897,517],{"class":163},[150,1899,66],{"class":167},[150,1901,1902],{"class":163},"customer_id",[150,1904,1905],{"class":156}," GROUP BY",[150,1907,489],{"class":163},[150,1909,66],{"class":167},[150,1911,494],{"class":163},[150,1913,471],{"class":167},[150,1915,1916],{"class":152,"line":183},[150,1917,477],{"emptyLinePlaceholder":476},[150,1919,1920],{"class":152,"line":201},[150,1921,1922],{"class":266},"-- Per-customer average (average of each customer's total)\n",[150,1924,1925,1927,1929,1931,1933,1935,1937,1940,1942],{"class":152,"line":215},[150,1926,356],{"class":156},[150,1928,489],{"class":163},[150,1930,66],{"class":167},[150,1932,494],{"class":163},[150,1934,326],{"class":167},[150,1936,512],{"class":163},[150,1938,1939],{"class":167},"(customer_total) ",[150,1941,177],{"class":156},[150,1943,1944],{"class":167}," avg_customer_spend\n",[150,1946,1947,1949],{"class":152,"line":228},[150,1948,257],{"class":156},[150,1950,1228],{"class":167},[150,1952,1953,1956,1958,1960,1962,1964,1966,1968,1970,1972,1974,1976,1978,1980,1982,1984,1986],{"class":152,"line":241},[150,1954,1955],{"class":156},"  SELECT",[150,1957,489],{"class":163},[150,1959,66],{"class":167},[150,1961,494],{"class":163},[150,1963,326],{"class":167},[150,1965,730],{"class":163},[150,1967,66],{"class":167},[150,1969,554],{"class":163},[150,1971,326],{"class":167},[150,1973,436],{"class":163},[150,1975,168],{"class":167},[150,1977,517],{"class":163},[150,1979,66],{"class":167},[150,1981,522],{"class":163},[150,1983,174],{"class":167},[150,1985,177],{"class":156},[150,1987,1988],{"class":167}," customer_total\n",[150,1990,1991,1994,1996,1998,2000,2002,2004,2006,2008,2010,2012,2014],{"class":152,"line":254},[150,1992,1993],{"class":156},"  FROM",[150,1995,761],{"class":167},[150,1997,541],{"class":156},[150,1999,544],{"class":167},[150,2001,547],{"class":156},[150,2003,489],{"class":163},[150,2005,66],{"class":167},[150,2007,554],{"class":163},[150,2009,557],{"class":156},[150,2011,560],{"class":163},[150,2013,66],{"class":167},[150,2015,565],{"class":163},[150,2017,2018,2021,2023,2025,2027,2029,2031,2033],{"class":152,"line":263},[150,2019,2020],{"class":156},"  GROUP BY",[150,2022,489],{"class":163},[150,2024,66],{"class":167},[150,2026,494],{"class":163},[150,2028,326],{"class":167},[150,2030,730],{"class":163},[150,2032,66],{"class":167},[150,2034,2035],{"class":163},"id\n",[150,2037,2038],{"class":152,"line":270},[150,2039,2040],{"class":167},") c\n",[150,2042,2043,2045,2047,2049,2051],{"class":152,"line":276},[150,2044,405],{"class":156},[150,2046,489],{"class":163},[150,2048,66],{"class":167},[150,2050,494],{"class":163},[150,2052,471],{"class":167},[14,2054,2055,2056,1461,2059,2061,2062,2065,2066,2069,2070,2073],{},"::\n",[302,2057,2058],{},"The lesson",[47,2060,512],{}," over a join computes the average over ",[807,2063,2064],{},"rows"," (orders), not over ",[807,2067,2068],{},"entities"," (customers). To average per-entity, aggregate to the entity level first, then average those aggregates. SQL can't nest aggregates directly (",[47,2071,2072],{},"AVG(SUM(x))"," is illegal), so use a subquery\u002FCTE.",[18,2075,2076],{"id":1805},"Summary",[14,2078,2079,2080,1617,2082,1617,2084,1617,2086,1617,2088,2090,2091,2093,2094,2096,2097,1617,2099,1617,2101,2103],{},"You can now aggregate with ",[47,2081,373],{},[47,2083,436],{},[47,2085,512],{},[47,2087,1699],{},[47,2089,1702],{},", group rows with ",[47,2092,405],{},", filter groups with ",[47,2095,827],{},", and generate multi-level subtotals with ",[47,2098,1278],{},[47,2100,1328],{},[47,2102,1150],{}," — while understanding the NULL-handling quirks that make aggregates surprise the unwary. Next: subqueries, the compositional building block of complex queries.",[2105,2106,2107],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}",{"title":146,"searchDepth":160,"depth":160,"links":2109},[2110,2114,2118,2121,2122,2130,2131,2132,2133,2134],{"id":20,"depth":160,"text":21,"children":2111},[2112],{"id":283,"depth":183,"text":2113},"COUNT(*) vs COUNT(col) vs COUNT(1)",{"id":404,"depth":160,"text":405,"children":2115},[2116,2117],{"id":580,"depth":183,"text":581},{"id":692,"depth":183,"text":693},{"id":813,"depth":160,"text":814,"children":2119},[2120],{"id":976,"depth":183,"text":977},{"id":1048,"depth":160,"text":1049},{"id":1136,"depth":160,"text":1137,"children":2123},[2124,2126,2128],{"id":1147,"depth":183,"text":2125},"GROUPING SETS — specific combinations",{"id":1275,"depth":183,"text":2127},"ROLLUP — hierarchical subtotals",{"id":1325,"depth":183,"text":2129},"CUBE — all combinations",{"id":1383,"depth":160,"text":1384},{"id":1430,"depth":160,"text":1431},{"id":1529,"depth":160,"text":1530},{"id":1721,"depth":160,"text":1722},{"id":1805,"depth":160,"text":2076},"md",{},"\u002Fsql\u002F05-aggregation-and-group-by",{"title":5,"description":16},"sql\u002F05-aggregation-and-group-by","g_kS70rICmyAV2xZhLE45lYm1Vnyj_WVJuUJXTSyK9o",1787401095681]