Placeholder":89},[40,1354,1355],{"class":42,"line":923},[40,1356,1357],{"class":73},"-- Delete returning what was removed\n",[40,1359,1360],{"class":42,"line":929},[40,1361,1362],{"class":73},"DELETE FROM sessions WHERE expires_at \u003C now() RETURNING id, user_id;\n",[40,1364,1365],{"class":42,"line":935},[40,1366,756],{"class":73},[271,1368,1370,1041,1372,1374],{"id":1369},"delete-without-where-empties-the-table",[18,1371,728],{},[18,1373,231],{}," empties the table",[14,1376,1377,1378,1380,1381,1383,1384,1386,1387,1390,1391,1394,1395,1397],{},"Like ",[18,1379,351],{},", a ",[18,1382,231],{},"-less ",[18,1385,728],{}," removes every row. It's slower than ",[18,1388,1389],{},"TRUNCATE"," (per-row work, WAL, triggers) and produces bloat until ",[18,1392,1393],{},"VACUUM",". Use ",[18,1396,1389],{}," for whole-table clears.",[271,1399,1401,1403],{"id":1400},"delete-and-foreign-keys",[18,1402,728],{}," and foreign keys",[14,1405,1406,1407,1410],{},"Deleting a row referenced by a FK triggers the ",[18,1408,1409],{},"ON DELETE"," action (chapter 12):",[1412,1413,1414,1424,1430],"ul",{},[1415,1416,1417,804,1420,1423],"li",{},[18,1418,1419],{},"RESTRICT",[18,1421,1422],{},"NO ACTION"," — the delete fails if referencing rows exist.",[1415,1425,1426,1429],{},[18,1427,1428],{},"CASCADE"," — referencing rows are deleted too.",[1415,1431,1432,1435],{},[18,1433,1434],{},"SET NULL"," — referencing rows' FK column is set to NULL.",[14,1437,1438,1439,1441],{},"Plan deletions in dependency order (children first), or use ",[18,1440,1428],{}," deliberately.",[23,1443,1445],{"id":1444},"batch-updates-and-deletes","Batch Updates and Deletes",[14,1447,1448],{},"Updating\u002Fdeleting millions of rows in one statement holds locks for a long time and bloats the table. Batch it:",[28,1450,1451],{"language":30},[32,1452,1454],{"className":34,"code":1453,"language":30,"meta":36,"style":36},"-- Delete in batches of 10000\nDELETE FROM logs WHERE created_at \u003C '2023-01-01'\n  AND id IN (SELECT id FROM logs WHERE created_at \u003C '2023-01-01' LIMIT 10000);\n-- Repeat until no rows are deleted.\n``\n::\n\nFor updates, use a CTE to select the IDs to update, then update in batches. This keeps locks short and allows other queries to proceed between batches.\n\n## Upsert Patterns Beyond ON CONFLICT\n\n### \"Insert or get the id\" (common with `RETURNING`)\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- Insert the user, or if the email exists, return the existing id — in one statement\nINSERT INTO users (email, name) VALUES ('a@x.com', 'Alice')\nON CONFLICT (email) DO UPDATE SET name = users.name  -- no-op update to return the row\nRETURNING id;\n``\n",[18,1455,1456,1461,1480,1518,1523,1527,1531,1535,1597,1601,1611,1615,1633,1637,1651,1655,1660,1665,1670,1675],{"__ignoreMap":36},[40,1457,1458],{"class":42,"line":43},[40,1459,1460],{"class":46},"-- Delete in batches of 10000\n",[40,1462,1463,1465,1467,1470,1472,1475,1477],{"class":42,"line":50},[40,1464,728],{"class":53},[40,1466,225],{"class":53},[40,1468,1469],{"class":57}," logs ",[40,1471,231],{"class":53},[40,1473,1474],{"class":57}," created_at ",[40,1476,237],{"class":53},[40,1478,1479],{"class":73}," '2023-01-01'\n",[40,1481,1482,1485,1488,1491,1493,1495,1497,1500,1502,1504,1506,1508,1510,1513,1516],{"class":42,"line":86},[40,1483,1484],{"class":53},"  AND",[40,1486,1487],{"class":57}," id ",[40,1489,1490],{"class":53},"IN",[40,1492,70],{"class":57},[40,1494,219],{"class":53},[40,1496,1487],{"class":57},[40,1498,1499],{"class":53},"FROM",[40,1501,1469],{"class":57},[40,1503,231],{"class":53},[40,1505,1474],{"class":57},[40,1507,237],{"class":53},[40,1509,240],{"class":73},[40,1511,1512],{"class":53}," LIMIT",[40,1514,1515],{"class":363}," 10000",[40,1517,83],{"class":57},[40,1519,1520],{"class":42,"line":93},[40,1521,1522],{"class":46},"-- Repeat until no rows are deleted.\n",[40,1524,1525],{"class":42,"line":99},[40,1526,756],{"class":73},[40,1528,1529],{"class":42,"line":113},[40,1530,761],{"class":57},[40,1532,1533],{"class":42,"line":130},[40,1534,90],{"emptyLinePlaceholder":89},[40,1536,1537,1540,1543,1546,1549,1552,1555,1558,1560,1563,1565,1568,1570,1573,1576,1579,1582,1585,1587,1590,1593,1595],{"class":42,"line":144},[40,1538,1539],{"class":53},"For",[40,1541,1542],{"class":57}," updates, ",[40,1544,1545],{"class":53},"use",[40,1547,1548],{"class":57}," a CTE ",[40,1550,1551],{"class":53},"to",[40,1553,1554],{"class":53}," select",[40,1556,1557],{"class":57}," the IDs ",[40,1559,1551],{"class":53},[40,1561,1562],{"class":53}," update",[40,1564,77],{"class":57},[40,1566,1567],{"class":53},"then",[40,1569,1562],{"class":53},[40,1571,1572],{"class":53}," in",[40,1574,1575],{"class":53}," batches",[40,1577,1578],{"class":57},". This keeps locks short ",[40,1580,1581],{"class":53},"and",[40,1583,1584],{"class":57}," allows other queries ",[40,1586,1551],{"class":53},[40,1588,1589],{"class":57}," proceed ",[40,1591,1592],{"class":53},"between",[40,1594,1575],{"class":53},[40,1596,818],{"class":57},[40,1598,1599],{"class":42,"line":159},[40,1600,90],{"emptyLinePlaceholder":89},[40,1602,1603,1606,1608],{"class":42,"line":164},[40,1604,1605],{"class":57},"## Upsert Patterns Beyond ",[40,1607,340],{"class":53},[40,1609,1610],{"class":57}," CONFLICT\n",[40,1612,1613],{"class":42,"line":170},[40,1614,90],{"emptyLinePlaceholder":89},[40,1616,1617,1620,1623,1626,1629,1631],{"class":42,"line":197},[40,1618,1619],{"class":57},"### ",[40,1621,1622],{"class":73},"\"Insert or get the id\"",[40,1624,1625],{"class":57}," (common ",[40,1627,1628],{"class":53},"with",[40,1630,841],{"class":73},[40,1632,335],{"class":57},[40,1634,1635],{"class":42,"line":202},[40,1636,90],{"emptyLinePlaceholder":89},[40,1638,1639,1641,1643,1645,1647,1649],{"class":42,"line":208},[40,1640,900],{"class":57},[40,1642,789],{"class":53},[40,1644,905],{"class":57},[40,1646,908],{"class":53},[40,1648,911],{"class":73},[40,1650,914],{"class":57},[40,1652,1653],{"class":42,"line":216},[40,1654,920],{"class":73},[40,1656,1657],{"class":42,"line":246},[40,1658,1659],{"class":73},"-- Insert the user, or if the email exists, return the existing id — in one statement\n",[40,1661,1662],{"class":42,"line":251},[40,1663,1664],{"class":73},"INSERT INTO users (email, name) VALUES ('a@x.com', 'Alice')\n",[40,1666,1667],{"class":42,"line":257},[40,1668,1669],{"class":73},"ON CONFLICT (email) DO UPDATE SET name = users.name  -- no-op update to return the row\n",[40,1671,1672],{"class":42,"line":768},[40,1673,1674],{"class":73},"RETURNING id;\n",[40,1676,1677],{"class":42,"line":786},[40,1678,756],{"class":73},[14,1680,1069,1681,1684,1685,1687,1688,1380,1690,1693],{},[18,1682,1683],{},"DO UPDATE SET name = users.name"," is a no-op (sets the column to its current value), but it lets ",[18,1686,20],{}," fire even on the conflict path. Without ",[18,1689,556],{},[18,1691,1692],{},"DO NOTHING"," conflict doesn't return the existing row.",[23,1695,1697],{"id":1696},"tips-tricks","💡 Tips & Tricks",[1412,1699,1700,1724,1737,1746,1764],{},[1415,1701,1702,1706,1707,1710,1711,1713,1714,1713,1717,1720,1721,1723],{},[1703,1704,1705],"strong",{},"Idiom",": always use ",[18,1708,1709],{},"INSERT ... RETURNING id"," instead of ",[18,1712,26],{}," + ",[18,1715,1716],{},"SELECT currval()",[18,1718,1719],{},"last_insert_id()"," — ",[18,1722,20],{}," is atomic, works for multi-row inserts, returns all generated columns, and doesn't rely on session state.",[1415,1725,1726,1728,1729,1732,1733,1736],{},[1703,1727,1705],{},": for bulk loads, ",[18,1730,1731],{},"INSERT INTO ... SELECT ... FROM"," or ",[18,1734,1735],{},"COPY"," (PostgreSQL) is orders of magnitude faster than per-row inserts from application code — batch inserts (100–1000 rows per statement) reduce network round-trips and parse overhead.",[1415,1738,1739,1741,1742,1745],{},[1703,1740,1705],{},": use ",[18,1743,1744],{},"ON CONFLICT (key) DO UPDATE SET ... = EXCLUDED..."," for idempotent upserts — replay-safe ingestion (ETL, webhooks, retries) where the same row may arrive multiple times.",[1415,1747,1748,1751,1752,804,1754,1756,1757,1760,1761,1763],{},[1703,1749,1750],{},"Performance",": batch large ",[18,1753,351],{},[18,1755,728],{}," operations (e.g., 10k rows per batch with a ",[18,1758,1759],{},"LIMIT"," subquery) to keep locks short and avoid bloating the table — a single 10M-row ",[18,1762,728],{}," holds locks for minutes and creates 10M dead tuples that autovacuum must clean.",[1415,1765,1766,1768,1769,1772,1773,804,1775,1777],{},[1703,1767,1705],{},": run ",[18,1770,1771],{},"SELECT ... WHERE \u003Csame condition>"," before ",[18,1774,351],{},[18,1776,728],{}," to preview affected rows — catches \"I forgot the WHERE\" and \"the condition matches more than I expected\" before damage is done.",[23,1779,1781],{"id":1780},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1412,1783,1784,1808,1825,1860,1880,1899,1924,1942,1954,1970],{},[1415,1785,1786,1795,1796,1798,1799,1801,1802,804,1804,1041,1806,367],{},[1703,1787,1788,804,1790,1041,1792,1794],{},[18,1789,351],{},[18,1791,728],{},[18,1793,231],{}," affects all rows",": the classic footgun. Always include a ",[18,1797,231],{},", or run a ",[18,1800,219],{}," with the same predicate first. Some tools have a \"safe updates\" mode that blocks ",[18,1803,351],{},[18,1805,728],{},[18,1807,231],{},[1415,1809,1810,1816,1817,1820,1821,1824],{},[1703,1811,1812,1815],{},[18,1813,1814],{},"ON CONFLICT"," requires a unique index\u002Fconstraint on the conflict target",": ",[18,1818,1819],{},"ON CONFLICT (email)"," needs a unique index on ",[18,1822,1823],{},"email",". Without it, \"there is no unique or exclusion constraint matching the ON CONFLICT specification\" error.",[1415,1826,1827,1832,1833,77,1836,1839,1840,1844,1845,1839,1848,1851,1852,1855,1856,1859],{},[1703,1828,1829,1831],{},[18,1830,552],{}," vs the table name",": in ",[18,1834,1835],{},"DO UPDATE SET col = EXCLUDED.col",[18,1837,1838],{},"EXCLUDED.col"," is the ",[1841,1842,1843],"em",{},"new"," value (from the INSERT), while ",[18,1846,1847],{},"users.col",[1841,1849,1850],{},"existing"," value. ",[18,1853,1854],{},"SET name = EXCLUDED.name"," (overwrite) vs ",[18,1857,1858],{},"SET count = users.count + EXCLUDED.count"," (increment) — pick deliberately.",[1415,1861,1862,1816,1870,1873,1874,1876,1877,1879],{},[1703,1863,1864,1866,1867,1869],{},[18,1865,20],{}," on ",[18,1868,1692],{}," returns nothing",[18,1871,1872],{},"ON CONFLICT DO NOTHING"," returns only the actually-inserted rows; conflicting rows don't appear in ",[18,1875,20],{},". To get the existing row too, use the no-op ",[18,1878,556],{}," trick.",[1415,1881,1882,1887,1888,1891,1892,1895,1896,1898],{},[1703,1883,1884,1886],{},[18,1885,1072],{}," ambiguity",": in PostgreSQL, ",[18,1889,1890],{},"UPDATE orders o SET status = c.status FROM customers c ..."," — the ",[18,1893,1894],{},"orders"," table can't be referenced in the ",[18,1897,1499],{}," (it's already the target). Re-listing it errors.",[1415,1900,1901,1816,1910,1913,1914,1917,1918,77,1921,1923],{},[1703,1902,1903,1905,1906,1909],{},[18,1904,728],{}," with ",[18,1907,1908],{},"USING"," deletes matching rows once",[18,1911,1912],{},"DELETE FROM o USING c WHERE o.c_id = c.id"," — if multiple ",[18,1915,1916],{},"c"," rows match one ",[18,1919,1920],{},"o",[18,1922,1920],{}," is still deleted once (not multiple times). Safe.",[1415,1925,1926,1933,1934,1937,1938,1941],{},[1703,1927,1928,1930,1931],{},[18,1929,728],{}," and ",[18,1932,1759],{},": PostgreSQL doesn't support ",[18,1935,1936],{},"DELETE ... LIMIT"," (MySQL does). For batched deletes in PostgreSQL, use the ",[18,1939,1940],{},"id IN (SELECT ... LIMIT n)"," subquery pattern.",[1415,1943,1944,1949,1950,1953],{},[1703,1945,1946,1948],{},[18,1947,351],{}," of a PK column",": changing a primary key value updates every FK that references it (with ",[18,1951,1952],{},"ON UPDATE CASCADE","). On large referenced tables, this is expensive and locks. Prefer surrogate keys that never change.",[1415,1955,1956,1961,1962,1965,1966,1969],{},[1703,1957,1958,1960],{},[18,1959,26],{}," into a view",": only simple views (single-table, no aggregation) are auto-updatable in PostgreSQL. Complex views need ",[18,1963,1964],{},"INSTEAD OF"," triggers or ",[18,1967,1968],{},"INSTEAD"," rules.",[1415,1971,1972,1981,1982,1985],{},[1703,1973,1974,1976,1977,1980],{},[18,1975,1814],{}," can't be used with ",[18,1978,1979],{},"ON CONFLICT DO UPDATE"," referencing columns not in the conflict target",": the ",[18,1983,1984],{},"DO UPDATE SET"," can reference any column, but the conflict detection is only on the named target.",[23,1987,1989],{"id":1988},"spot-the-bug","🧠 Spot the Bug",[14,1991,1992],{},"A developer writes this to \"increment a counter or create it if missing,\" but it occasionally overwrites the counter to 1 instead of incrementing. Why?",[28,1994,1995],{"language":30},[32,1996,1998],{"className":34,"code":1997,"language":30,"meta":36,"style":36},"INSERT INTO counters (key, value) VALUES ('visits', 1)\nON CONFLICT (key) DO UPDATE SET value = 1;\n",[18,1999,2000,2029],{"__ignoreMap":36},[40,2001,2002,2004,2007,2010,2012,2014,2016,2018,2020,2023,2025,2027],{"class":42,"line":43},[40,2003,54],{"class":53},[40,2005,2006],{"class":57}," counters (",[40,2008,2009],{"class":53},"key",[40,2011,77],{"class":57},[40,2013,493],{"class":53},[40,2015,321],{"class":57},[40,2017,67],{"class":53},[40,2019,70],{"class":57},[40,2021,2022],{"class":73},"'visits'",[40,2024,77],{"class":57},[40,2026,647],{"class":363},[40,2028,335],{"class":57},[40,2030,2031,2033,2035,2037,2040,2042,2044,2046,2048,2050],{"class":42,"line":50},[40,2032,340],{"class":53},[40,2034,521],{"class":57},[40,2036,2009],{"class":53},[40,2038,2039],{"class":57},") DO ",[40,2041,351],{"class":53},[40,2043,354],{"class":53},[40,2045,537],{"class":53},[40,2047,360],{"class":53},[40,2049,1225],{"class":363},[40,2051,243],{"class":57},[2053,2054,2055,2059,2074,2081,2217,2232],"details",{},[2056,2057,2058],"summary",{},"Answer",[14,2060,1069,2061,2064,2065,2067,2068,2070,2071,2073],{},[18,2062,2063],{},"DO UPDATE SET value = 1"," always sets ",[18,2066,493],{}," to 1, regardless of whether it was a conflict or an insert — it's not \"set to 1 if inserting, increment if conflicting.\" The ",[18,2069,647],{}," is the literal from the ",[18,2072,67],{}," clause, applied unconditionally on conflict.",[14,2075,2076,2077,2080],{},"The fix: use ",[18,2078,2079],{},"EXCLUDED.value"," (the proposed insert value) plus the existing value, or just increment the existing row:",[32,2082,2084],{"className":34,"code":2083,"language":30,"meta":36,"style":36},"-- On conflict, increment the existing value by the proposed amount\nINSERT INTO counters (key, value) VALUES ('visits', 1)\nON CONFLICT (key) DO UPDATE SET value = counters.value + EXCLUDED.value;\n\n-- Or, if you always want to add 1 on conflict regardless of the INSERT value:\nINSERT INTO counters (key, value) VALUES ('visits', 1)\nON CONFLICT (key) DO UPDATE SET value = counters.value + 1;\n",[18,2085,2086,2091,2117,2152,2156,2161,2187],{"__ignoreMap":36},[40,2087,2088],{"class":42,"line":43},[40,2089,2090],{"class":46},"-- On conflict, increment the existing value by the proposed amount\n",[40,2092,2093,2095,2097,2099,2101,2103,2105,2107,2109,2111,2113,2115],{"class":42,"line":50},[40,2094,54],{"class":53},[40,2096,2006],{"class":57},[40,2098,2009],{"class":53},[40,2100,77],{"class":57},[40,2102,493],{"class":53},[40,2104,321],{"class":57},[40,2106,67],{"class":53},[40,2108,70],{"class":57},[40,2110,2022],{"class":73},[40,2112,77],{"class":57},[40,2114,647],{"class":363},[40,2116,335],{"class":57},[40,2118,2119,2121,2123,2125,2127,2129,2131,2133,2135,2138,2140,2142,2144,2146,2148,2150],{"class":42,"line":86},[40,2120,340],{"class":53},[40,2122,521],{"class":57},[40,2124,2009],{"class":53},[40,2126,2039],{"class":57},[40,2128,351],{"class":53},[40,2130,354],{"class":53},[40,2132,537],{"class":53},[40,2134,360],{"class":53},[40,2136,2137],{"class":363}," counters",[40,2139,367],{"class":57},[40,2141,493],{"class":363},[40,2143,838],{"class":53},[40,2145,364],{"class":363},[40,2147,367],{"class":57},[40,2149,493],{"class":363},[40,2151,243],{"class":57},[40,2153,2154],{"class":42,"line":93},[40,2155,90],{"emptyLinePlaceholder":89},[40,2157,2158],{"class":42,"line":99},[40,2159,2160],{"class":46},"-- Or, if you always want to add 1 on conflict regardless of the INSERT value:\n",[40,2162,2163,2165,2167,2169,2171,2173,2175,2177,2179,2181,2183,2185],{"class":42,"line":113},[40,2164,54],{"class":53},[40,2166,2006],{"class":57},[40,2168,2009],{"class":53},[40,2170,77],{"class":57},[40,2172,493],{"class":53},[40,2174,321],{"class":57},[40,2176,67],{"class":53},[40,2178,70],{"class":57},[40,2180,2022],{"class":73},[40,2182,77],{"class":57},[40,2184,647],{"class":363},[40,2186,335],{"class":57},[40,2188,2189,2191,2193,2195,2197,2199,2201,2203,2205,2207,2209,2211,2213,2215],{"class":42,"line":130},[40,2190,340],{"class":53},[40,2192,521],{"class":57},[40,2194,2009],{"class":53},[40,2196,2039],{"class":57},[40,2198,351],{"class":53},[40,2200,354],{"class":53},[40,2202,537],{"class":53},[40,2204,360],{"class":53},[40,2206,2137],{"class":363},[40,2208,367],{"class":57},[40,2210,493],{"class":363},[40,2212,838],{"class":53},[40,2214,1225],{"class":363},[40,2216,243],{"class":57},[14,2218,761,2219,2222,2223,2225,2226,2228,2229,367],{},[18,2220,2221],{},"counters.value"," is the existing row's value; ",[18,2224,2079],{}," is the value from the ",[18,2227,67],{}," clause (the \"excluded\" insert that lost the conflict). For an increment-on-conflict, you want the existing value plus the proposed increment — ",[18,2230,2231],{},"counters.value + EXCLUDED.value",[14,2233,2234,1816,2237,2240,2241,2244,2245,2247],{},[1703,2235,2236],{},"The lesson",[18,2238,2239],{},"DO UPDATE SET col = \u003Cliteral>"," overwrites; ",[18,2242,2243],{},"DO UPDATE SET col = table.col + EXCLUDED.col"," accumulates. Always reference ",[18,2246,552],{}," for the proposed values and the table name for existing values; don't restate the literal.",[23,2249,2250],{"id":2056},"Summary",[14,2252,2253,2254,2256,2257,2259,2260,2262],{},"You can now insert single\u002Fbulk rows, upsert with ",[18,2255,1814],{},", return modified rows with ",[18,2258,20],{},", update\u002Fdelete with joins, and batch large modifications — while avoiding the \"no WHERE\" footgun and the ",[18,2261,552],{}," confusion. Next: transactions, isolation levels, and the concurrency hazards they prevent.",[2264,2265,2266],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}",{"title":36,"searchDepth":50,"depth":50,"links":2268},[2269,2282,2283,2284,2285,2286],{"id":25,"depth":50,"text":26,"children":2270},[2271,2272,2274,2275,2277,2278,2280],{"id":273,"depth":86,"text":274},{"id":290,"depth":86,"text":2273},"INSERT ... ON CONFLICT (Upsert)",{"id":575,"depth":86,"text":20},{"id":1038,"depth":86,"text":2276},"UPDATE without WHERE updates all rows",{"id":1065,"depth":86,"text":1066},{"id":1369,"depth":86,"text":2279},"DELETE without WHERE empties the table",{"id":1400,"depth":86,"text":2281},"DELETE and foreign keys",{"id":1444,"depth":50,"text":1445},{"id":1696,"depth":50,"text":1697},{"id":1780,"depth":50,"text":1781},{"id":1988,"depth":50,"text":1989},{"id":2056,"depth":50,"text":2250},"DML (Data Manipulation Language) modifies rows. This chapter covers the three core operations, RETURNING, upsert, and the cascade interactions that catch beginners.","md",{},"\u002Fsql\u002F14-insert-update-delete",{"title":5,"description":2287},"sql\u002F14-insert-update-delete","aaMAdTH-Om1WZhoi5Q3C48MLEHikkNPDQ8lswfPD2YE",1787401245300]