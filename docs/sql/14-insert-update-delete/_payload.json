 'LA', name = 'Bob' WHERE id = 2;\n",[40,951,953],{"class":42,"line":952},33,[40,954,90],{"emptyLinePlaceholder":89},[40,956,958],{"class":42,"line":957},34,[40,959,960],{"class":73},"-- Update based on a calculation\n",[40,962,964],{"class":42,"line":963},35,[40,965,966],{"class":73},"UPDATE products SET price = price * 1.1 WHERE category = 'electronics';\n",[40,968,970],{"class":42,"line":969},36,[40,971,90],{"emptyLinePlaceholder":89},[40,973,975],{"class":42,"line":974},37,[40,976,977],{"class":73},"-- Update from another table (PostgreSQL FROM clause)\n",[40,979,981],{"class":42,"line":980},38,[40,982,983],{"class":73},"UPDATE orders o\n",[40,985,987],{"class":42,"line":986},39,[40,988,989],{"class":73},"SET status = c.status\n",[40,991,993],{"class":42,"line":992},40,[40,994,995],{"class":73},"FROM customers c\n",[40,997,999],{"class":42,"line":998},41,[40,1000,1001],{"class":73},"WHERE o.customer_id = c.id AND c.status = 'banned';\n",[40,1003,1005],{"class":42,"line":1004},42,[40,1006,90],{"emptyLinePlaceholder":89},[40,1008,1010],{"class":42,"line":1009},43,[40,1011,1012],{"class":73},"-- Update with a subquery\n",[40,1014,1016],{"class":42,"line":1015},44,[40,1017,1018],{"class":73},"UPDATE orders\n",[40,1020,1022],{"class":42,"line":1021},45,[40,1023,1024],{"class":73},"SET amount = (SELECT AVG(amount) FROM orders WHERE customer_id = 1)\n",[40,1026,1028],{"class":42,"line":1027},46,[40,1029,1030],{"class":73},"WHERE id = 99;\n",[40,1032,1034],{"class":42,"line":1033},47,[40,1035,756],{"class":73},[271,1037,1039,1041,1042,1044],{"id":1038},"update-without-where-updates-all-rows",[18,1040,351],{}," without ",[18,1043,231],{}," updates all rows",[14,1046,1047,1050,1051,1053,1054,1056,1057,1059,1060,1062],{},[18,1048,1049],{},"UPDATE orders SET status = 'shipped'"," (no ",[18,1052,231],{},") updates every row. Always include a ",[18,1055,231],{}," unless you genuinely mean to update the whole table. Run a ",[18,1058,219],{}," with the same ",[18,1061,231],{}," first to see what will change.",[271,1064,1066],{"id":1065},"update-from-a-join-portability","Update from a join (portability)",[14,1068,1069,1070,1073],{},"The ",[18,1071,1072],{},"UPDATE ... FROM"," syntax is PostgreSQL-specific. Standard SQL (and MySQL) uses a different form:",[28,1075,1076],{"language":30},[32,1077,1079],{"className":34,"code":1078,"language":30,"meta":36,"style":36},"-- MySQL\nUPDATE orders o JOIN customers c ON o.customer_id = c.id\nSET o.status = c.status\nWHERE c.status = 'banned';\n\n-- Standard SQL (correlated subquery — portable)\nUPDATE orders o\nSET status = (SELECT c.status FROM customers c WHERE c.id = o.customer_id)\nWHERE EXISTS (SELECT 1 FROM customers c WHERE c.id = o.customer_id AND c.status = 'banned');\n``\n::\n\n## DELETE\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- Delete specific rows\nDELETE FROM orders WHERE id = 42;\n\n-- Delete all rows (slow — use TRUNCATE for whole-table)\nDELETE FROM orders;\n\n-- Delete based on a join (PostgreSQL USING)\nDELETE FROM orders o\nUSING customers c\nWHERE o.customer_id = c.id AND c.status = 'banned';\n\n-- Delete returning what was removed\nDELETE FROM sessions WHERE expires_at \u003C now() RETURNING id, user_id;\n``\n",[18,1080,1081,1086,1119,1138,1155,1159,1164,1171,1212,1261,1265,1269,1273,1280,1284,1298,1302,1307,1312,1316,1321,1326,1330,1335,1340,1345,1349,1353,1358,1363],{"__ignoreMap":36},[40,1082,1083],{"class":42,"line":43},[40,1084,1085],{"class":46},"-- MySQL\n",[40,1087,1088,1090,1093,1096,1099,1101,1104,1106,1109,1111,1114,1116],{"class":42,"line":50},[40,1089,351],{"class":53},[40,1091,1092],{"class":57}," orders o ",[40,1094,1095],{"class":53},"JOIN",[40,1097,1098],{"class":57}," customers c ",[40,1100,340],{"class":53},[40,1102,1103],{"class":363}," o",[40,1105,367],{"class":57},[40,1107,1108],{"class":363},"customer_id",[40,1110,360],{"class":53},[40,1112,1113],{"class":363}," c",[40,1115,367],{"class":57},[40,1117,1118],{"class":363},"id\n",[40,1120,1121,1123,1125,1