lation\nUPDATE products SET price = price * 1.1 WHERE category = 'electronics';\n\n-- Update from another table (PostgreSQL FROM clause)\nUPDATE orders o\nSET status = c.status\nFROM customers c\nWHERE o.customer_id = c.id AND c.status = 'banned';\n\n-- Update with a subquery\nUPDATE orders\nSET amount = (SELECT AVG(amount) FROM orders WHERE customer_id = 1)\nWHERE id = 99;\n``\n",[18,587,588,593,617,626,630,634,665,670,674,679,706,715,719,724,747,752,757,762,766,784,819,852,876,881,890,895,915,921,927,933,938,944,950,955,961,967,972,978,984,990,996,1002,1007,1013,1019,1025,1031],{"__ignoreMap":36},[40,589,590],{"class":42,"line":43},[40,591,592],{"class":46},"-- Get the auto-generated id back without a second query\n",[40,594,595,597,599,601,603,605,607,610,612,615],{"class":42,"line":50},[40,596,54],{"class":53},[40,598,58],{"class":57},[40,600,61],{"class":53},[40,602,64],{"class":57},[40,604,67],{"class":53},[40,606,70],{"class":57},[40,608,609],{"class":73},"'Frank'",[40,611,77],{"class":57},[40,613,614],{"class":73},"'Boston'",[40,616,335],{"class":57},[40,618,619,622,624],{"class":42,"line":86},[40,620,621],{"class":57},"RETURNING id, ",[40,623,61],{"class":53},[40,625,243],{"class":57},[40,627,628],{"class":42,"line":93},[40,629,90],{"emptyLinePlaceholder":89},[40,631,632],{"class":42,"line":99},[40,633,96],{"class":46},[40,635,636,638,641,643,645,648,650,653,656,658,660,663],{"class":42,"line":113},[40,637,54],{"class":53},[40,639,640],{"class":57}," orders (customer_id, amount) ",[40,642,67],{"class":53},[40,644,70],{"class":57},[40,646,647],{"class":363},"1",[40,649,77],{"class":57},[40,651,652],{"class":363},"50",[40,654,655],{"class":57},"), (",[40,657,647],{"class":363},[40,659,77],{"class":57},[40,661,662],{"class":363},"75",[40,664,335],{"class":57},[40,666,667],{"class":42,"line":130},[40,668,669],{"class":57},"RETURNING id, amount;\n",[40,671,672],{"class":42,"line":144},[40,673,90],{"emptyLinePlaceholder":89},[40,675,676],{"class":42,"line":159},[