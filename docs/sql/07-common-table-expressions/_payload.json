2,215],{"class":63},[54,404,406],{"class":56,"line":405},14,[54,407,409],{"class":408},"sJ6F3","``\n",[54,411,413],{"class":56,"line":412},15,[54,414,415],{"class":63},"::\n",[54,417,419],{"class":56,"line":418},16,[54,420,422],{"emptyLinePlaceholder":421},true,"\n",[54,424,426,429,432,435,438],{"class":56,"line":425},17,[54,427,428],{"class":63},"This reads ",[54,430,431],{"class":60},"top-to-",[54,433,434],{"class":63},"bottom ",[54,436,437],{"class":60},"as",[54,439,440],{"class":63}," a pipeline — far clearer than nested derived tables.\n",[54,442,444],{"class":56,"line":443},18,[54,445,422],{"emptyLinePlaceholder":421},[54,447,449,452,455],{"class":56,"line":448},19,[54,450,451],{"class":63},"## CTEs ",[54,453,454],{"class":60},"for",[54,456,457],{"class":63}," Readability\n",[54,459,461],{"class":56,"line":460},20,[54,462,422],{"emptyLinePlaceholder":421},[54,464,466,469],{"class":56,"line":465},21,[54,467,468],{"class":60},"Use",[54,470,471],{"class":63}," a CTE whenever a query has:\n",[54,473,475],{"class":56,"line":474},22,[54,476,422],{"emptyLinePlaceholder":421},[54,478,480,483],{"class":56,"line":479},23,[54,481,482],{"class":60},"-",[54,484,485],{"class":63}," Nested subqueries more than two levels deep.\n",[54,487,489,491],{"class":56,"line":488},24,[54,490,482],{"class":60},[54,492,493],{"class":63}," A subquery referenced more than once.\n",[54,495,497,499,502,505,507,510,513,516,519,522],{"class":56,"line":496},25,[54,498,482],{"class":60},[54,500,501],{"class":63}," A complex ",[54,503,504],{"class":408},"`WHERE`",[54,506,25],{"class":60},[54,508,509],{"class":408},"`CASE`",[54,511,512],{"class":63}," expression you want ",[54,514,515],{"class":60},"to",[54,517,518],{"class":60}," name",[54,520,521],{"class":60}," and",[54,523,524],{"class":63}," reuse.\n",[54,526,528,530,533,535,538,541],{"class":56,"line":527},26,[54,529,482],{"class":60},[54,531,532],{"class":63}," Multi",[54,534,482],{"class":60},[54,536,537],{"class":63},"stage aggregation (a