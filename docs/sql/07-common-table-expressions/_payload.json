 diff_from_mean,\n",[54,669,671],{"class":56,"line":670},44,[54,672,673],{"class":408},"  t.total - (SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY total) FROM totals) AS diff_from_median\n",[54,675,677],{"class":56,"line":676},45,[54,678,679],{"class":408},"FROM totals t;\n",[54,681,683],{"class":56,"line":682},46,[54,684,409],{"class":408},[14,686,687],{},"A derived table can't be referenced twice in the same query; a CTE can.",[37,689,691],{"id":690},"ctes-with-insertupdatedelete","CTEs with INSERT\u002FUPDATE\u002FDELETE",[14,693,694],{},"CTEs work with DML too:",[42,696,697],{"language":44},[46,698,700],{"className":48,"code":699,"language":44,"meta":50,"style":50},"-- Archive old orders: insert into archive, then delete\nWITH old_orders AS (\n  SELECT id FROM orders WHERE ordered_on \u003C '2023-01-01'\n)\nINSERT INTO orders_archive\nSELECT * FROM orders WHERE id IN (SELECT id FROM old_orders);\n\n-- Update the top spender's status\nWITH top AS (\n  SELECT customer_id FROM orders\n  GROUP BY customer_id ORDER BY SUM(amount) DESC LIMIT 1\n)\nUPDATE customers SET status = 'vip'\nWHERE id IN (SELECT customer_id FROM top);\n``\n::\n\n## Data-Modifying CTEs (PostgreSQL)\n\nPostgreSQL lets DML statements *be* CTEs, with `RETURNING` feeding subsequent CTEs — atomic multi-step operations:\n\n::code-wrapper{language=\"sql\"}\n```sql\nWITH moved AS (\n  DELETE FROM orders WHERE ordered_on \u003C '2023-01-01'\n  RETURNING *\n)\nINSERT INTO orders_archive SELECT * FROM moved;\n``\n",[18,701,702,708,719,742,746,754,783,787,792,804,815,836,840,858,879,883,887,891,902,906,942,946,960,964,969,974,979,983,988],{"__ignoreMap":50},[54,703,704],{"class":56,"line":57},[54,705,707],{"class":706},"sdCPZ","-- Archive old orders: insert into archive, then delete\n",[54,709,710,712,715,717],{"class":56,"line":73},[54,711,20],{"class":60},[54,713,714],{"class":63}," old_orders ",[54,716,67],{"class":60},[54,718,70],{"class":63},[54,720,721,723,726,728,731,733,736,739],{"class":56,"l