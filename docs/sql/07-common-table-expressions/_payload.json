[{"data":1,"prerenderedAt":1746},["ShallowReactive",2],{"page-\u002Fsql\u002F07-common-table-expressions":3},{"id":4,"title":5,"body":6,"description":1739,"extension":1740,"meta":1741,"navigation":421,"path":1742,"seo":1743,"stem":1744,"__hash__":1745},"content\u002Fsql\u002F07-common-table-expressions.md","07 — Common Table Expressions (CTEs)",{"type":7,"value":8,"toc":1728},"minimark",[9,13,36,41,216,222,226,229,685,688,692,695,992,1006,1010,1018,1024,1095,1101,1130,1136,1141,1145,1250,1258,1262,1340,1344,1471,1475,1485,1542,1545,1718,1721,1724],[10,11,5],"h1",{"id":12},"_07-common-table-expressions-ctes",[14,15,16,17,21,22,25,26,25,29,25,32,35],"p",{},"A Common Table Expression (CTE) is a named temporary result set defined with ",[18,19,20],"code",{},"WITH",", usable within a single ",[18,23,24],{},"SELECT","\u002F",[18,27,28],{},"INSERT",[18,30,31],{},"UPDATE",[18,33,34],{},"DELETE",". CTEs make complex queries readable by breaking them into named stages — and enable recursion (chapter 19).",[37,38,40],"h2",{"id":39},"basic-syntax","Basic Syntax",[42,43,45],"code-wrapper",{"language":44},"sql",[46,47,51],"pre",{"className":48,"code":49,"language":44,"meta":50,"style":50},"language-sql shiki shiki-themes github-light github-dark","WITH big_orders AS (\n  SELECT customer_id, SUM(amount) AS total\n  FROM orders\n  GROUP BY customer_id\n  HAVING SUM(amount) > 100\n)\nSELECT c.name, b.total\nFROM big_orders b\nJOIN customers c ON c.id = b.customer_id\nORDER BY b.total DESC;\n","",[18,52,53,71,92,101,110,127,133,158,167,197],{"__ignoreMap":50},[54,55,58,61,65,68],"span",{"class":56,"line":57},"line",1,[54,59,20],{"class":60},"svdQ7",[54,62,64],{"class":63},"ssxIu"," big_orders ",[54,66,67],{"class":60},"AS",[54,69,70],{"class":63}," (\n",[54,72,74,77,80,84,87,89],{"class":56,"line":73},2,[54,75,76],{"class":60},"  SELECT",[54,78,79],{"class":63}," customer_id, ",[54,81,83],{"class":82},"snvgF","SUM",[54,85,86],{"class":63},"(amount) ",[54,88,67],{"class":60},[54,90,91],{"class":63}," total\n",[54,93,95,98],{"class":56,"line":94},3,[54,96,97],{"class":60},"  FROM",[54,99,100],{"class":63}," orders\n",[54,102,104,107],{"class":56,"line":103},4,[54,105,106],{"class":60},"  GROUP BY",[54,108,109],{"class":63}," customer_id\n",[54,111,113,116,119,121,124],{"class":56,"line":112},5,[54,114,115],{"class":60},"  HAVING",[54,117,118],{"class":82}," SUM",[54,120,86],{"class":63},[54,122,123],{"class":60},">",[54,125,126],{"class":82}," 100\n",[54,128,130],{"class":56,"line":129},6,[54,131,132],{"class":63},")\n",[54,134,136,138,141,144,147,150,153,155],{"class":56,"line":135},7,[54,137,24],{"class":60},[54,139,140],{"class":82}," c",[54,142,143],{"class":63},".",[54,145,146],{"class":82},"name",[54,148,149],{"class":63},", ",[54,151,152],{"class":82},"b",[54,154,143],{"class":63},[54,156,157],{"class":82},"total\n",[54,159,161,164],{"class":56,"line":160},8,[54,162,163],{"class":60},"FROM",[54,165,166],{"class":63}," big_orders b\n",[54,168,170,173,176,179,181,183,186,189,192,194],{"class":56,"line":169},9,[54,171,172],{"class":60},"JOIN",[54,174,175],{"class":63}," customers c ",[54,177,178],{"class":60},"ON",[54,180,140],{"class":82},[54,182,143],{"class":63},[54,184,185],{"class":82},"id",[54,187,188],{"class":60}," =",[54,190,191],{"class":82}," b",[54,193,143],{"class":63},[54,195,196],{"class":82},"customer_id\n",[54,198,200,203,205,207,210,213],{"class":56,"line":199},10,[54,201,202],{"class":60},"ORDER BY",[54,204,191],{"class":82},[54,206,143],{"class":63},[54,208,209],{"class":82},"total",[54,211,212],{"class":60}," DESC",[54,214,215],{"class":63},";\n",[14,217,218,221],{},[18,219,220],{},"big_orders"," is a named subquery whose result is available in the main query. You can reference a CTE multiple times in the same statement (unlike a derived table, which is inline and used once).",[37,223,225],{"id":224},"multiple-ctes","Multiple CTEs",[14,227,228],{},"Chain multiple CTEs, separating with commas. Later CTEs can reference earlier ones:",[42,230,231],{"language":44},[46,232,234],{"className":48,"code":233,"language":44,"meta":50,"style":50},"WITH\n  customer_totals AS (\n    SELECT customer_id, SUM(amount) AS total\n    FROM orders\n    GROUP BY customer_id\n  ),\n  city_totals AS (\n    SELECT c.city, AVG(ct.total) AS avg_customer_spend\n    FROM customer_totals ct\n    JOIN customers c ON c.id = ct.customer_id\n    GROUP BY c.city\n  )\nSELECT * FROM city_totals WHERE avg_customer_spend > 50;\n``\n::\n\nThis reads top-to-bottom as a pipeline — far clearer than nested derived tables.\n\n## CTEs for Readability\n\nUse a CTE whenever a query has:\n\n- Nested subqueries more than two levels deep.\n- A subquery referenced more than once.\n- A complex `WHERE`\u002F`CASE` expression you want to name and reuse.\n- Multi-stage aggregation (aggregating an aggregate).\n\nNaming a stage turns \"what does this subquery do?\" into a readable label.\n\n## CTEs Reused Multiple Times\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- Compare each customer's spend to the overall median and mean\nWITH totals AS (\n  SELECT customer_id, SUM(amount) AS total\n  FROM orders\n  GROUP BY customer_id\n)\nSELECT\n  t.customer_id,\n  t.total,\n  t.total - (SELECT AVG(total) FROM totals) AS diff_from_mean,\n  t.total - (SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY total) FROM totals) AS diff_from_median\nFROM totals t;\n``\n",[18,235,236,241,250,265,272,279,284,293,327,334,358,370,376,403,410,416,423,441,446,458,463,472,477,486,494,525,544,549,564,569,578,583,603,609,615,621,627,633,639,644,650,656,662,668,674,680],{"__ignoreMap":50},[54,237,238],{"class":56,"line":57},[54,239,240],{"class":60},"WITH\n",[54,242,243,246,248],{"class":56,"line":73},[54,244,245],{"class":63},"  customer_totals ",[54,247,67],{"class":60},[54,249,70],{"class":63},[54,251,252,255,257,259,261,263],{"class":56,"line":94},[54,253,254],{"class":60},"    SELECT",[54,256,79],{"class":63},[54,258,83],{"class":82},[54,260,86],{"class":63},[5