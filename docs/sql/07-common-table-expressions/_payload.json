54,982,132],{"class":408},[54,984,985],{"class":56,"line":551},[54,986,987],{"class":408},"INSERT INTO orders_archive SELECT * FROM moved;\n",[54,989,990],{"class":56,"line":566},[54,991,409],{"class":408},[14,993,994,995,997,998,1000,1001,1005],{},"The ",[18,996,34],{}," and ",[18,999,28],{}," run in the same transaction. This is a clean way to \"move\" rows. Note: data-modifying CTEs see the ",[1002,1003,1004],"em",{},"pre-statement"," snapshot of tables, so they don't see each other's changes within the same statement.",[37,1007,1009],{"id":1008},"materialized-vs-not-materialized","MATERIALIZED vs NOT MATERIALIZED",[14,1011,1012,1013,1017],{},"By default, PostgreSQL (12+) ",[1014,1015,1016],"strong",{},"inlines"," non-recursive CTEs — it folds them into the main query, like a macro, allowing the optimizer to push predicates down and reorder joins. This is usually what you want.",[14,1019,1020,1023],{},[18,1021,1022],{},"MATERIALIZED"," forces the CTE to be computed once and stored (like a temp table):",[42,1025,1026],{"language":44},[46,1027,1029],{"className":48,"code":1028,"language":44,"meta":50,"style":50},"WITH expensive AS MATERIALIZED (\n  SELECT id, complex_function(data) AS result FROM big_table\n)\nSELECT * FROM expensive WHERE result > 0.5;\n",[18,1030,1031,1043,1065,1069],{"__ignoreMap":50},[54,1032,1033,1035,1038,1040],{"class":56,"line":57},[54,1034,20],{"class":60},[54,1036,1037],{"class":63}," expensive ",[54,1039,67],{"class":60},[54,1041,1042],{"class":63}," MATERIALIZED (\n",[54,1044,1045,1047,1050,1053,1055,1057,1060,1062],{"class":56,"line":73},[54,1046,76],{"class":60},[54,1048,1049],{"class":63}," id, complex_function(",[54,1051,1052],{"class":60},"data",[54,1054,321],{"class":63},[54,1056,67],{"class":60},[54,1058,1059],{"class":63}," result ",[54,1061,163],{"class":60},[54,1063,1064],{"class":63}," big_table\n",[54,1066,1067],{"class":56,"line":94},[54,1068,132],{"class":63},[54,1070,1071,1073,1075,1077,1079,1081,1083,1085,1088,1090,1093],{"class":56,"line":103},[54,1072,24],{"class":60},[54,1074,383],{"class":60},[54,1076,386],{"class":60},[54,1078,1037],{"class":63},[54,1080,392],{"class":60},[54,1082,1059],{"class":63},[54,1084,123],{"class":60},[54,1086,1087],{"class":82}," 0",[54,1089,143],{"class":63},[54,1091,1092],{"class":82},"5",[54,1094,215],{"class":63},[14,1096,1097,1098,1100],{},"Use ",[18,1099,1022],{}," when:",[1102,1103,1104,1116,1123],"ul",{},[1105,1106,1107,1108,1111,1112,1115],"li",{},"The CTE is ",[1014,1109,1110],{},"expensive"," and referenced ",[1014,1113,1114],{},"multiple times"," — compute once, reuse.",[1105,1117,1118,1119,1122],{},"You want to ",[1014,1120,1121],{},"fence"," the optimizer out of a transformation that would be slower (rare — measure first).",[1105,1124,1125,1126,1129],{},"The CTE has ",[1014,1127,1128],{},"side effects"," (data-modifying CTEs are always materialized).",[14,1131,1132,1135],{},[18,1133,1134],{},"NOT MATERIALIZED"," forces inlining even when the planner would materialize (e.g., recursive CTEs, or CTEs referenced multiple times with costly re-evaluation).",[14,1137,1138,1139,143],{},"Before PostgreSQL 12, all CTEs were materialized (CTEs were \"optimization fences\"). That behavior is now opt-in via ",[18,1140,1022],{},[37,1142,1144],{"id":1143},"ctes-vs-derived-tables-vs-subqueries","CTEs vs Derived Tables vs Subqueries",[1146,1147,1148,1167],"table",{},[1149,1150,1151],"thead",{},[1152,1153,1154,1158,1161,1164],"tr",{},[1155,1156,1157],"th",{},"Feature",[1155,1159,1160],{},"CTE",[1155,1162,1163],{},"Derived table",[1155,1165,1166],{},"Subquery",[1168,1169,1170,1185,1199,1210,1226,1238],"tbody",{},[1152,1171,1172,1176,1179,1182],{},[1173,1174,1175],"td",{},"Named",[1173,1177,1178],{},"✅",[1173,1180,1181],{},"✅ (alias)",[1173,1183,1184],{},"inline",[1152,1186,1187,1190,1193,1196],{},[1173,1188,1189],{},"Reusable in same query",[1173,1191,1192],{},"✅ (multiple refs)",[1173,1194,1195],{},"❌ (one use)",[1173,1197,1198],{},"❌",[1152,1200,1201,1204,1206,1208],{},[1173,1202,1203],{},"Can reference earlier CTEs",[1173,1205,1178],{},[1173,1207,1198],{},[1173,1209,1198],{},[1152,1211,1212,1215,1222,1224],{},[1173,1213,1214],{},"Recursion",[1173,1216,1217,1218,1221],{},"✅ (",[18,1219,1220],{},"WITH RECURSIVE",")",[1173,1223,1198],{},[1173,1225,1198],{},[1152,1227,1228,1231,1234,1236],{},[1173,1229,1230],{},"Readability for multi-stage",[1173,1232,1233],{},"✅✅",[1173,1235,1178],{},[1173,1237,1198],{},[1152,1239,1240,1243,1246,1248],{},[1173,1241,1242],{},"Inlined by optimizer (PG 12+)",[1173,1244,1245],{},"✅ (default)",[1173,1247,1178],{},[1173,1249,1178],{},[14,1251,1252,1253,25,1255,1257],{},"Reach for a CTE when you have multiple stages or reuse; reach for a derived table for a single inline step; reach for a subquery for a simple ",[18,1254,392],{},[18,1256,24],{}," lookup.",[37,1259,1261],{"id":1260},"tips-tricks","💡 Tips & Tricks",[1102,1263,1264,1292,1308,1313,1326],{},[1105,1265,1266,1269,1270,1273,1274,149,1276,149,1279,1282,1283,149,1286,149,1288,1291],{},[1014,1267,1268],{},"Idiom",": name CTEs by ",[1014,1271,1272],{},"what they compute",", not by the table they scan — ",[18,1275,220],{},[18,1277,1278],{},"customer_totals",[18,1280,1281],{},"city_avg"," are good; ",[18,1284,1285],{},"cte1",[18,1287,1052],{},[18,1289,1290],{},"temp"," are bad. The name is the documentation.",[1105,1293,1294,1297,1298,1300,1301,1304,1305,1307],{},[1014,1295,1296],{},"Performance",": in PostgreSQL 12+, default (inlined) CTEs perform like derived tables — no penalty. But if you mark a CTE ",[18,1299,1022],{}," and reference it once, you may ",[1002,1302,1303],{},"prevent"," predicate pushdown and slow the query. Use ",[18,1306,1022],{}," deliberately (expensive + reused), not reflexively.",[1105,1309,1310,1312],{},[1014,1311,1268],{},": chain CTEs as a pipeline (each reads the prior) — this top-to-bottom flow matches how you'd explain the query in English and is far more readable than inside-out nested subqueries. Resist the urge to nest CTEs inside CTEs (define them flat at the top, in dependency order).",[1105,1314,1315,1318,1319,1321,1322,1325],{},[1014,1316,1317],{},"Debug",": to debug a multi-CTE pipeline, comment out the final ",[18,1320,24],{}," and replace it with ",[18,1323,1324],{},"SELECT * FROM some_cte"," to inspect an intermediate stage — much easier than unwinding nested subqueries.",[1105,1327,1328,1331,1332,1334,1335,25,1337,1339],{},[1014,1329,1330],{},"Portability",": ",[18,1333,20],{}," is standard SQL and widely supported (PostgreSQL, MySQL 8.0+, SQLite 3.8+, SQL Server, Oracle). ",[18,1336,1022],{},[18,1338,1134],{}," hints are PostgreSQL-specific. Data-modifying CTEs are PostgreSQL-specific (and SQL Server with OUTPUT, differently).",[37,1341,1343],{"id":1342},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1102,1345,1346,1363,1376,1385,1393,1421,1437,1458],{},[1105,1347,1348,1351,1352,1355,1356,1358,1359,1362],{},[1014,1349,1350],{},"CTE visibility",": a CTE can reference CTEs defined ",[1002,1353,1354],{},"before"," it in the same ",[18,1357,20],{},", but not ",[1002,1360,1361],{},"after"," (no forward references). Define CTEs in dependency order.",[1105,1364,1365,1368,1369,1372,1373,1375],{},[1014,1366,1367],{},"CTE name shadows tables",": a CTE named ",[18,1370,1371],{},"orders"," shadows the real ",[18,1374,1371],{}," table in the main query. This is legal but confusing — avoid reusing table names as CTE names.",[1105,1377,1378,1331,1381,1384],{},[1014,1379,1380],{},"A CTE is only valid for one statement",[18,1382,1383],{},"WITH ... SELECT ..."," — the CTE doesn't persist to the next query. For跨-query reuse, use a temp table or a view.",[1105,1386,1387,1392],{},[1014,1388,1389,1391],{},[18,1390,1022],{}," + single reference can hurt",": materializing prevents predicate pushdown from the outer query into the CTE. If the outer query filters heavily, inlining lets the filter reach the CTE's tables; materializing computes the full CTE first. Measure before forcing materialization.",[1105,1394,1395,1398,1399,1402,1403,1406,1407,1410,1411,1414,1415,1417,1418,1420],{},[1014,1396,1397],{},"Data-modifying CTEs see a snapshot",": in ",[18,1400,1401],{},"WITH ins AS (INSERT ... RETURNING), sel AS (SELECT ... FROM ins)",", the ",[18,1404,1405],{},"sel"," CTE sees the ",[18,1408,1409],{},"RETURNING"," rows, but a ",[1002,1412,1413],{},"separate"," CTE reading the same table the ",[18,1416,28],{}," targets sees the pre-",[18,1419,28],{}," state. This is \"all data-modifying CTEs execute against the same snapshot.\"",[1105,1422,1423,1331,1430,1433,1434,1436],{},[1014,1424,1425,1426,1429],{},"Recursive CTEs require the ",[18,1427,1428],{},"RECURSIVE"," keyword",[18,1431,1432],{},"WITH RECURSIVE ..."," — forgetting ",[18,1435,1428],{}," on a self-referencing CTE is a syntax error. See chapter 19.",[1105,1438,1439,1447,1448,1451,1452,1454,1455,1457],{},[1014,1440,1441,1442,25,1444,1446],{},"CTEs in ",[18,1443,31],{},[18,1445,34],{}," can't target the CTE's own table",": you can't ",[18,1449,1450],{},"WITH t AS (SELECT ...) DELETE FROM t"," — the CTE is read-only. You can reference a CTE in the ",[18,1453,392],{}," of a ",[18,1456,34],{}," from a real table, though.",[1105,1459,1460,1463,1464,1466,1467,1470],{},[1014,1461,1462],{},"Column names from a CTE",": a CTE's columns are named by its ",[18,1465,24],{}," — if an expression has no alias, the column name is implementation-defined (PostgreSQL uses ",[18,1468,1469],{},"?column?","). Always alias expressions in CTEs you'll reference by name.",[37,1472,1474],{"id":1473},"spot-the-bug","🧠 Spot the Bug",[14,1476,1477,1478,1480,1481,1484],{},"A developer writes this and is surprised the query is slow, even though ",[18,1479,1371],{}," has an index on ",[18,1482,1483],{},"ordered_on",":",[42,1486,1487],{"language":44},[46,1488,1490],{"className":48,"code":1489,"language":44,"meta":50,"style":50},"WITH recent AS MATERIALIZED (\n  SELECT customer_id, amount, ordered_on\n  FROM orders\n)\nSELECT * FROM recent WHERE ordered_on >= '2024-01-01';\n",[18,1491,1492,1503,1510,1516,1520],{"__ignoreMap":50},[54,1493,1494,1496,1499,1501],{"class":56,"line":57},[54,1495,20],{"class":60},[54,1497,1498],{"class":63}," recent ",[54,1500,67],{"class":60},[54,1502,1042],{"class":63},[54,1504,1505,1507],{"class":56,"line":73},[54,1506,76],{"class":60},[54,1508,1509],{"class":63}," customer_id, amount, ordered_on\n",[54,1511,1512,1514],{"class":56,"line":94},[54,1513,97],{"class":60},[54,1515,100],{"class":63},[54,1517,1518],{"class":56,"line":103},[54,1519,132],{"class":63},[54,1521,1522,1524,1526,1528,1530,1532,1534,1537,1540],{"class":56,"line":112},[54,1523,24],{"class":60},[54,1525,383],{"class":60},[54,1527,386],{"class":60},[54,1529,1498],{"class":63},[54,1531,392],{"class":60},[54,1533,735],{"class":63},[54,1535,1536],{"class":60},">=",[54,1538,1539],{"class":408}," '2024-01-01'",[54,1541,215],{"class":63},[14,1543,1544],{},"What's happening, and how should it be fixed?",[1546,1547,1548,1552,1577,1590,1596,1707],"details",{},[1549,1550,1551],"summary",{},"Answer",[14,1553,1554,1556,1557,1560,1561,1563,1564,1566,1567,1569,1570,1573,1574,1576],{},[18,1555,1022],{}," forces the ",[18,1558,1559],{},"recent"," CTE to be computed fully ",[1002,1562,1354],{}," the outer query's ",[18,1565,392],{}," is applied — so PostgreSQL scans the entire ",[18,1568,1371],{}," table, materializes all rows into the CTE, and only then filters to ",[18,1571,1572],{},"ordered_on >= '2024-01-01'",". The index on ",[18,1575,1483],{}," is never used, because the filter isn't pushed down into the CTE's table scan.",[14,1578,1579,1580,1582,1583,1585,1586,1589],{},"Without ",[18,1581,1022],{}," (the default in PostgreSQL 12+), the planner would ",[1014,1584,1184],{}," the CTE, transforming it into ",[18,1587,1588],{},"SELECT customer_id, amount, ordered_on FROM orders WHERE ordered_on >= '2024-01-01'"," — and the index would be used.",[14,1591,1592,1593,1595],{},"The fix: drop ",[18,1594,1022],{}," (let the planner inline), or add the filter inside the CTE:",[46,1597,1599],{"className":48,"code":1598,"language":44,"meta":50,"style":50},"-- Option 1: let the planner inline (default)\nWITH recent AS (\n  SELECT customer_id, amount, ordered_on FROM orders\n)\nSELECT * FROM recent WHERE ordered_on >= '2024-01-01';\n\n-- Option 2: filter inside the CTE\nWITH recent AS (\n  SELECT customer_id, amount, ordered_on FROM orders\n  WHERE ordered_on >= '2024-01-01'\n)\nSELECT * FROM recent;\n",[18,1600,1601,1606,1616,1627,1631,1651,1655,1660,1670,1680,1692,1696],{"__ignoreMap":50},[54,1602,1603],{"class":56,"line":57},[54,1604,1605],{"class":706},"-- Option 1: let the planner inline (default)\n",[54,1607,1608,1610,1612,1614],{"class":56,"line":73},[54,1609,20],{"class":60},[54,1611,1498],{"class":63},[54,1613,67],{"class":60},[54,1615,70],{"class":63},[54,1617,1618,1620,1623,1625],{"class":56,"line":94},[54,1619,76],{"class":60},[54,1621,1622],{"class":63}," customer_id, amount, ordered_on ",[54,1624,163],{"class":60},[54,1626,100],{"class":63},[54,1628,1629],{"class":56,"line":103},[54,1630,132],{"class":63},[54,1632,1633,1635,1637,1639,1641,1643,1645,1647,1649],{"class":56,"line":112},[54,1634,24],{"class":60},[54,1636,383],{"class":60},[54,1638,386],{"class":60},[54,1640,1498],{"class":63},[54,1642,392],{"class":60},[54,1644,735],{"class":63},[54,1646,1536],{"class":60},[54,1648,1539],{"class":408},[54,1650,215],{"class":63},[54,1652,1653],{"class":56,"line":129},[54,1654,422],{"emptyLinePlaceholder":421},[54,1656,1657],{"class":56,"line":135},[54,1658,1659],{"class":706},"-- Option 2: filter inside the CTE\n",[54,1661,1662,1664,1666,1668],{"class":56,"line":160},[54,1663,20],{"class":60},[54,1665,1498],{"class":63},[54,1667,67],{"class":60},[54,1669,70],{"class":63},[54,1671,1672,1674,1676,1678],{"class":56,"line":169},[54,1673,76],{"class":60},[54,1675,1622],{"class":63},[54,1677,163],{"class":60},[54,1679,100],{"class":63},[54,1681,1682,1685,1687,1689],{"class":56,"line":199},[54,1683,1684],{"class":60},"  WHERE",[54,1686,735],{"class":63},[54,1688,1536],{"class":60},[54,1690,1691],{"class":408}," '2024-01-01'\n",[54,1693,1694],{"class":56,"line":360},[54,1695,132],{"class":63},[54,1697,1698,1700,1702,1704],{"class":56,"line":372},[54,1699,24],{"class":60},[54,1701,383],{"class":60},[54,1703,386],{"class":60},[54,1705,1706],{"class":63}," recent;\n",[14,1708,1709,1331,1712,1714,1715,1717],{},[1014,1710,1711],{},"The lesson",[18,1713,1022],{}," is an optimization ",[1002,1716,1121],{}," — it prevents predicate pushdown. Use it only when the CTE is expensive and reused; otherwise, let the planner inline so filters and joins can reach the underlying tables.",[37,1719,1720],{"id":1549},"Summary",[14,1722,1723],{},"You can now write single and chained CTEs, reuse them, drive DML from them, and choose between inlining and materialization — turning multi-stage queries into readable pipelines. Next: set operations for combining result sets.",[1725,1726,1727],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}",{"title":50,"searchDepth":73,"depth":73,"links":1729},[1730,1731,1732,1733,1734,1735,1736,1737,1738],{"id":39,"depth":73,"text":40},{"id":224,"depth":73,"text":225},{"id":690,"depth":73,"text":691},{"id":1008,"depth":73,"text":1009},{"id":1143,"depth":73,"text":1144},{"id":1260,"depth":73,"text":1261},{"id":1342,"depth":73,"text":1343},{"id":1473,"depth":73,"text":1474},{"id":1549,"depth":73,"text":1720},"A Common Table Expression (CTE) is a named temporary result set defined with WITH, usable within a single SELECT\u002FINSERT\u002FUPDATE\u002FDELETE. CTEs make complex queries readable by breaking them into named stages — and enable recursion (chapter 19).","md",{},"\u002Fsql\u002F07-common-table-expressions",{"title":5,"description":1739},"sql\u002F07-common-table-expressions","PGa5O2s7vGzA68r-hj0GFq-79V_7Gpu6SYd1RR9jH1g",1786908612725]