n in the SELECT list\"\n",[47,209,210,212,214,216,218,220,222,226],{"class":49,"line":80},[47,211,32],{"class":53},[47,213,56],{"class":53},[47,215,60],{"class":59},[47,217,63],{"class":53},[47,219,66],{"class":59},[47,221,17],{"class":53},[47,223,225],{"class":224},"snvgF"," 2",[47,227,228],{"class":59},";\n",[19,230,231,232,234],{},"This positional form is legal SQL but discouraged — it's fragile (reordering columns in ",[22,233,32],{}," silently changes the sort) and harder to read. Always use column names or aliases.",[192,236,238],{"id":237},"sorting-by-expression","Sorting by Expression",[35,240,241],{"language":37},[39,242,244],{"className":41,"code":243,"language":37,"meta":43,"style":43},"-- Sort by a computed value\nSELECT name, length(name) AS name_len\nFROM customers\nORDER BY length(name) DESC, name;\n\n-- Sort by a CASE (custom order)\nSELECT name, city FROM customers\nORDER BY\n  CASE city\n    WHEN 'NYC' THEN 1\n    WHEN 'LA'  THEN 2\n    ELSE 3\n  END,\n  name;\n",[22,245,246,251,276,283,304,310,316,329,335,344,360,374,383,392],{"__ignoreMap":43},[47,247,248],{"class":49,"line":50},[47,249,250],{"class":76},"-- Sort by a computed value\n",[47,252,253,255,257,259,262,265,267,270,273],{"class":49,"line":80},[47,254,32],{"class":53},[47,256,56],{"class":53},[47,258,180],{"class":59},[47,260,261],{"class":53},"length",[47,263,264],{"class":59},"(",[47,266,150],{"class":53},[47,268,269],{"class":59},") ",[47,271,272],{"class":53},"AS",[47,274,275],{"class":59}," name_len\n",[47,277,278,280],{"class":49,"line":106},[47,279,63],{"class":53},[47,281,282],{"class":59}," customers\n",[47,284,285,287,290,292,294,296,298,300,302],{"class":49,"line":132},[47,286,17],{"class":53},[47,288,289],{"class":53}," length",[47,291,264],{"class":59},[47,293,150],{"class":53},[47,295,269],{"class":59},[47,297,177],{"class":53},[47,299,180],{"class":59},[47,301,150],{"class":53},[47,303,228],{"class":59},[47,305,306],{"class":49,"line":159},[47,307,309],{"emptyLinePlaceholder":308},true,"\n",[47,311,313],{"class":49,"line":312},6,[47,314,315],{"class":76},"-- Sort by a CASE (custom order)\n",[47,317,319,321,323,325,327],{"class":49,"line":318},7,[47,320,32],{"class":53},[47,322,56],{"class":53},[47,324,60],{"class":59},[47,326,63],{"class":53},[47,328,282],{"class":59},[47,330,332],{"class":49,"line":331},8,[47,333,334],{"class":53},"ORDER BY\n",[47,336,338,341],{"class":49,"line":337},9,[47,339,340],{"class":53},"  CASE",[47,342,343],{"class":59}," city\n",[47,345,347,350,354,357],{"class":49,"line":346},10,[47,348,349],{"class":53},"    WHEN",[47,351,353],{"class":352},"sJ6F3"," 'NYC'",[47,355,356],{"class":53}," THEN",[47,358,359],{"class":224}," 1\n",[47,361,363,365,368,371],{"class":49,"line":362},11,[47,364,349],{"class":53},[47,366,367],{"class":352}," 'LA'",[47,369,370],{"class":53},"  THEN",[47,372,373],{"class":224}," 2\n",[47,375,377,380],{"class":49,"line":376},12,[47,378,379],{"class":53},"    ELSE",[47,381,382],{"class":224}," 3\n",[47,384,386,389],{"class":49,"line":385},13,[47,387,388],{"class":53},"  END",[47,390,391],{"class":59},",\n",[47,393,395,398],{"class":49,"line":394},14,[47,396,397],{"class":53},"  name",[47,399,228],{"class":59},[14,401,403],{"id":402},"nulls-in-order-by","NULLs in ORDER BY",[19,405,406],{},"NULLs sort either first or last depending on the engine and direction. The SQL standard leaves this implementation-defined, which makes it a portability hazard.",[408,409,410,423],"table",{},[411,412,413],"thead",{},[414,415,416,420],"tr",{},[417,418,419],"th",{},"Engine",[417,421,422],{},"Default NULL placement",[424,425,426,449,464,480],"tbody",{},[414,427,428,432],{},[429,430,431],"td",{},"PostgreSQL",[429,433,434,435,439,440,180,443,439,446,448],{},"NULLs ",[436,437,438],"strong",{},"last"," in ",[22,441,442],{},"ASC",[436,444,445],{},"first",[22,447,177],{},".",[414,450,451,454],{},[429,452,453],{},"MySQL \u002F SQLite",[429,455,434,456,439,458,180,460,439,462,448],{},[436,457,445],{},[22,459,442],{},[436,461,438],{},[22,463,177],{},[414,465,466,469],{},[429,467,468],{},"Oracle",[429,470,434,471,439,473,180,475,439,477,479],{},[436,472,438],{},[22,474,442],{},[436,476,445],{},[22,478,177],{}," (like PostgreSQL).",[414,481,482,485],{},[429,483,484],{},"SQL Server",[429,486,487,488,490],{},"NULLs treated as the smallest value (first in ",[22,489,442],{},").",[192,492,494],{"id":493},"forcing-null-placement-postgresql","Forcing NULL placement (PostgreSQL)",[19,496,497,498,501,502,505],{},"PostgreSQL offers ",[22,499,500],{},"NULLS FIRST"," \u002F ",[22,503,504],{},"NULLS LAST",":",[35,507,508],{"language":37},[39,509,511],{"className":41,"code":510,"language":37,"meta":43,"style":43},"-- Newest orders first, with NULL ordered_at sorted last regardless of direction\nSELECT id, ordered_on FROM orders\nORDER BY ordered_on DESC NULLS LAST;\n\n-- Always put NULLs first\nSELECT id, ordered_on FROM orders\nORDER BY ordered_on NULLS FIRST;\n",[22,512,513,518,530,547,551,556,566],{"__ignoreMap":43},[47,514,515],{"class":49,"line":50},[47,516,517],{"class":76},"-- Newest orders first, with NULL ordered_at sorted last regardless of direction\n",[47,519,520,522,525,527],{"class":49,"line":80},[47,521,32],{"class":53},[47,523,524],{"class":59}," id, ordered_on ",[47,526,63],{"class":53},[47,528,529],{"class":59}," orders\n",[47,531,532,534,537,539,542,545],{"class":49,"line":106},[47,533,17],{"class":53},[47,535,536],{"class":59}," ordered_on ",[47,538,177],{"class":53},[47,540,541],{"class":53}," NULLS",[47,543,544],{"class":53}," LAST",[47,546,228],{"class":59},[47,548,549],{"class":49,"line":132},[47,550,309],{"emptyLinePlaceholder":308},[47,552,553],{"class":49,"line":159},[47,554,555],{"class":76},"-- Always put NULLs first\n",[47,557,558,560,562,564],{"class":49,"line":312},[47,559,32],{"class":53},[47,561,524],{"class":59},[47,563,63],{"class":53},[47,565,529],{"class":59},[47,567,568,570,572,575,578],{"class":49,"line":318},[47,569,17],{"class":53},[47,571,536],{"class":59},[47,573,574],{"class":53},"NULLS",[47,576,577],{"class":53}," FIRST",[47,579,228],{"class":59},[19,581,582,583,586,587,590,591,594],{},"For cross-database portability without ",[22,584,585],{},"NULLS FIRST\u002FLAST",", use a ",[22,588,589],{},"CASE"," or ",[22,592,593],{},"COALESCE"," trick:",[35,596,597],{"language":37},[39,598,600],{"className":41,"code":599,"language":37,"meta":43,"style":43},"-- NULLs last in ascending order (portable)\nSELECT id, ordered_on FROM orders\nORDER BY (ordered_on IS NULL), ordered_on;\n",[22,601,602,607,617],{"__ignoreMap":43},[47,603,604],{"class":49,"line":50},[47,605,606],{"class":76},"-- NULLs last in ascending order (portable)\n",[47,608,609,611,613,615],{"class":49,"line":80},[47,610,32],{"class":53},[47,612,524],{"class":59},[47,614,63],{"class":53},[47,616,529],{"class":59},[47,618,619,621,624,627,630],{"class":49,"line":106},[47,620,17],{"class":53},[47,622,623],{"class":59}," (ordered_on ",[47,625,626],{"class":53},"IS",[47,628,629],{"class":53}," NULL",[47,631,632],{"class":59},"), ordered_on;\n",[14,634,636],{"id":635},"limit-and-offset","LIMIT and OFFSET",[19,638,639,642,643,646],{},[22,640,641],{},"LIMIT"," restricts the number of rows returned. ",[22,644,645],{},"OFFSET"," skips rows before counting.",[35,648,649],{"language":37},[39,650,652],{"className":41,"code":651,"language":37,"meta":43,"style":43},"-- First 10 rows\nSELECT * FROM orders ORDER BY ordered_on DESC LIMIT 10;\n\n-- Skip 20, take 10 (page 3 of a 10-per-page listing)\nSELECT * FROM orders ORDER BY ordered_on DESC LIMIT 10 OFFSET 20;\n\n-- FETCH syntax (ANSI standard, equivalent to LIMIT\u002FOFFSET)\nSELECT * FROM orders ORDER BY ordered_on DESC\nOFFSET 20 ROWS FETCH NEXT 10 ROWS ONLY;\n",[22,653,654,659,686,690,695,723,727,732,749],{"__ignoreMap":43},[47,655,656],{"class":49,"line":50},[47,657,658],{"class":76},"-- First 10 rows\n",[47,660,661,663,666,669,672,674,676,678,681,684],{"class":49,"line":80},[47,662,32],{"class":53},[47,664,665],{"class":53}," *",[47,667,668],{"class":53}," FROM",[47,670,671],{"class":59}," orders ",[47,673,17],{"class":53},[47,675,536],{"class":59},[47,677,177],{"class":53},[47,679,680],{"class":53}," LIMIT",[47,682,683],{"class":224}," 10",[47,685,228],{"class":59},[47,687,688],{"class":49,"line":106},[47,689,309],{"emptyLinePlaceholder":308},[47,691,692],{"class":49,"line":132},[47,693,694],{"class":76},"-- Skip 20, take 10 (page 3 of a 10-per-page listing)\n",[47,696,697,699,701,703,705,707,709,711,713,715,718,721],{"class":49,"line":159},[47,698,32],{"class":53},[47,700,665],{"class":53},[47,702,668],{"class":53},[47,704,671],{"class":59},[47,706,17],{"class":53},[47,708,536],{"class":59},[47,710,177],{"class":53},[47,712,680],{"class":53},[47,714,683],{"class":224},[47,716,717],{"class":59}," OFFSET ",[47,719,720],{"class":224},"20",[47,722,228],{"class":59},[47,724,725],{"class":49,"line":312},[47,726,309],{"emptyLinePlaceholder":308},[47,728,729],{"class":49,"line":318},[47,730,731],{"class":76},"-- FETCH syntax (ANSI standard, equivalent to LIMIT\u002FOFFSET)\n",[47,733,734,736,738,740,742,744,746],{"class":49,"line":331},[47,735,32],{"class":53},[47,737,665],{"class":53},[47,739,668],{"class":53},[47,741,671],{"class":59},[47,743,17],{"class":53},[47,745,536],{"class":59},[47,747,748],{"class":53},"DESC\n",[47,750,751,754,756,759,762,765,767,769],{"class":49,"line":337},[47,752,753],{"class":59},"OFFSET ",[47,755,720],{"class":224},[47,757,758],{"class":53}," ROWS",[47,760,761],{"class":53}," FETCH",[47,763,764],{"class":53}," NEXT",[47,766,683],{"class":224},[47,768,758],{"class":53},[47,770,771],{"class":59}," ONLY;\n",[19,773,774,776,777,779,780,783,784,786,787,789],{},[22,775,641],{}," without ",[22,778,17],{}," returns an ",[436,781,782],{},"arbitrary"," set of rows — the planner is free to return any rows in any order. Always pair ",[22,785,641],{}," with an ",[22,788,17],{}," on a unique column (or a tie-breaker) for deterministic results.",[192,791,793,796],{"id":792},"limit-0-a-schema-probe",[22,794,795],{},"LIMIT 0"," — a schema probe",[35,798,799],{"language":37},[39,800,802],{"className":41,"code":801,"language":37,"meta":43,"style":43},"-- Get column names\u002Ftypes without fetching any data — useful for introspection\nSELECT * FROM orders LIMIT 0;\n",[22,803,804,809],{"__ignoreMap":43},[47,805,806],{"class":49,"line":50},[47,807,808],{"class":76},"-- Get column names\u002Ftypes without fetching any data — useful for introspection\n",[47,810,811,813,815,817,819,821,824],{"class":49,"line":80},[47,812,32],{"class":53},[47,814,665],{"class":53},[47,816,668],{"class":53},[47,818,671],{"class":59},[47,820,641],{"class":53},[47,822,823],{"class":224}," 0",[47,825,228],{"class":59},[192,827,829,832],{"id":828},"fetch-with-ties-postgresql-13-sql-server",[22,830,831],{},"FETCH ... WITH TIES"," (PostgreSQL 13+, SQL Server)",[19,834,835,836,839],{},"If the last row ties with the next row on the sort key, ",[22,837,838],{},"WITH TIES"," includes all tied rows:",[35,841,842],{"language":37},[39,843,845],{"className":41,"code":844,"language":37,"meta":43,"style":43},"-- Top 3 amounts, but include any other orders with the same amount as the 3rd\nSELECT id, amount FROM orders\nORDER BY amount DESC\nFETCH FIRST 3 ROWS WITH TIES;\n",[22,846,847,852,863,872],{"__ignoreMap":43},[47,848,849],{"class":49,"line":50},[47,850,851],{"class":76},"-- Top 3 amounts, but include any other orders with the same amount as the 3rd\n",[47,853,854,856,859,861],{"class":49,"line":80},[47,855,32],{"class":53},[47,857,858],{"class":59}," id, amount ",[47,860,63],{"class":53},[47,862,529],{"class":59},[47,864,865,867,870],{"class":49,"line":106},[47,866,17],{"class":53},[47,868,869],{"class":59}," amount ",[47,871,748],{"class":53},[47,873,874,877,879,882,884,887],{"class":49,"line":132},[47,875,876],{"class":53},"FETCH",[47,878,577],{"class":53},[47,880,881],{"class":224}," 3",[47,883,758],{"class":53},[47,885,886],{"class":53}," WITH",[47,888,889],{"class":59}," TIES;\n",[14,891,893],{"id":892},"pagination-patterns","Pagination Patterns",[192,895,897],{"id":896},"offset-pagination-simple-but-slow-at-scale","OFFSET pagination (simple but slow at scale)",[35,899,901],{"language":900},"text",[39,902,906],{"className":903,"code":905,"language":900,"meta":43},[904],"language-text","Page 1: LIMIT 10 OFFSET 0\nPage 2: LIMIT 10 OFFSET 10\nPage 3: LIMIT 10 OFFSET 20\n...\nPage N: LIMIT 10 OFFSET (N-1)*10\n",[22,907,905],{"__ignoreMap":43},[19,909,910,913,914,917],{},[436,911,912],{},"Problem",": ",[22,915,916],{},"OFFSET 100000"," still scans and discards 100000 rows before returning 10. On a large table, deep pages become progressively slower — O(N) per page. This is the classic \"offset pagination is fine until page 1000, then it's terrible.\"",[192,919,921],{"id":920},"keyset-seek-pagination-the-fast-alternative","Keyset (seek) pagination — the fast alternative",[19,923,924,925,927],{},"Instead of skipping rows, remember the last row's sort value and ask for rows ",[26,926,28],{}," it:",[35,929,930],{"language":37},[39,931,933],{"className":41,"code":932,"language":37,"meta":43,"style":43},"-- Page 1\nSELECT id, name, ordered_on\nFROM orders\nORDER BY ordered_on DESC, id DESC   -- id as tie-breaker\nLIMIT 10;\n\n-- Suppose the last row was (id=42, ordered_on='2024-03-01')\n-- Page 2 — fetch rows strictly \"before\" that row in the sort order\nSELECT id, name, ordered_on\nFROM orders\nWHERE (ordered_on, id) \u003C ('2024-03-01', 42)\nORDER BY ordered_on DESC, id DESC\nLIMIT 10;\n",[22,934,935,940,952,958,974,982,986,991,996,1006,1012,1037,1049],{"__ignoreMap":43},[47,936,937],{"class":49,"line":50},[47,938,939],{"class":76},"-- Page 1\n",[47,941,942,944,947,949],{"class":49,"line":80},[47,943,32],{"class":53},[47,945,946],{"class":59}," id, ",[47,948,150],{"class":53},[47,950,951],{"class":59},", ordered_on\n",[47,953,954,956],{"class":49,"line":106},[47,955,63],{"class":53},[47,957,529],{"class":59},[47,959,960,962,964,966,969,971],{"class":49,"line":132},[47,961,17],{"class":53},[47,963,536],{"class":59},[47,965,177],{"class":53},[47,967,968],{"class":59},", id ",[47,970,177],{"class":53},[47,972,973],{"class":76},"   -- id as tie-breaker\n",[47,975,976,978,980],{"class":49,"line":159},[47,977,641],{"class":53},[47,979,683],{"class":224},[47,981,228],{"class":59},[47,983,984],{"class":49,"line":312},[47,985,309],{"emptyLinePlaceholder":308},[47,987,988],{"class":49,"line":318},[47,989,990],{"class":76},"-- Suppose the last row was (id=42, ordered_on='2024-03-01')\n",[47,992,993],{"class":49,"line":331},[47,994,995],{"class":76},"-- Page 2 — fetch rows strictly \"before\" that row in the sort order\n",[47,997,998,1000,1002,1004],{"class":49,"line":337},[47,999,32],{"class":53},[47,1001,946],{"class":59},[47,1003,150],{"class":53},[47,1005,951],{"class":59},[47,1007,1008,1010],{"class":49,"line":346},[47,1009,63],{"class":53},[47,1011,529],{"class":59},[47,1013,1014,1017,1020,1023,1026,1029,1031,1034],{"class":49,"line":362},[47,1015,1016],{"class":53},"WHERE",[47,1018,1019],{"class":59}," (ordered_on, id) ",[47,1021,1022],{"class":53},"\u003C",[47,1024,1025],{"class":59}," (",[47,1027,1028],{"class":352},"'2024-03-01'",[47,1030,180],{"class":59},[47,1032,1033],{"class":224},"42",[47,1035,1036],{"class":59},")\n",[47,1038,1039,1041,1043,1045,1047],{"class":49,"line":376},[47,1040,17],{"class":53},[47,1042,536],{"class":59},[47,1044,177],{"class":53},[47,1046,968],{"class":59},[47,1048,748],{"class":53},[47,1050,1051,1053,1055],{"class":49,"line":385},[47,1052,641],{"class":53},[47,1054,683],{"class":224},[47,1056,228],{"class":59},[19,1058,1059,1060,1063,1064,1067,1068,1071],{},"The row-value comparison ",[22,1061,1062],{},"(ordered_on, id) \u003C (date, id)"," is a clean way to express \"lexicographically before.\" It uses an index on ",[22,1065,1066],{},"(ordered_on DESC, id DESC)"," and is ",[436,1069,1070],{},"O(1) per page"," regardless of depth — page 10000 is as fast as page 1.",[19,1073,1074,505],{},[436,1075,1076],{},"Keyset pagination requirements",[1078,1079,1080,1084,1087],"ul",{},[1081,1082,1083],"li",{},"A stable, unique sort key (or a composite key with a unique tie-breaker).",[1081,1085,1086],{},"An index covering the sort key(s).",[1081,1088,1089],{},"The client must remember the last row's key, not just a page number.",[192,1091,1093],{"id":1092},"when-offset-is-fine","When OFFSET is fine",[1078,1095,1096,1099,1102],{},[1081,1097,1098],{},"Small result sets (a few thousand rows).",[1081,1100,1101],{},"Admin\u002Finternal tools where performance doesn't matter.",[1081,1103,1104],{},"Random-access pages (\"jump to page 50\") where keyset doesn't apply (keyset only goes forward\u002Fbackward from a known position).",[14,1106,1108],{"id":1107},"tips-tricks","💡 Tips & Tricks",[1078,1110,1111,1121,1134,1150,1161],{},[1081,1112,1113,1116,1117,1120],{},[436,1114,1115],{},"Performance",": for user-facing paginated lists on large tables, ",[436,1118,1119],{},"always prefer keyset over OFFSET"," — keyset is O(log N) to seek plus O(page_size) to fetch, while OFFSET is O(offset + page_size). The difference is invisible at page 5 and dramatic at page 5000.",[1081,1122,1123,1126,1127,1129,1130,1133],{},[436,1124,1125],{},"Idiom",": when using ",[22,1128,17],{}," for pagination, always include a ",[436,1131,1132],{},"unique tie-breaker column"," (typically the primary key) as the final sort key — without it, rows with equal sort values can appear in arbitrary order across pages, causing duplicates or skips when data changes between page loads.",[1081,1135,1136,1139,1140,1142,1143,1146,1147,1149],{},[436,1137,1138],{},"Debug",": if pagination results seem to skip or duplicate rows, check whether the underlying data changed between page fetches — ",[22,1141,645],{}," pagination is not stable under inserts\u002Fdeletes. Keyset pagination is stable for inserts ",[26,1144,1145],{},"before"," the cursor but not for inserts ",[26,1148,28],{}," it; for fully stable pagination, snapshot the result set (e.g., into a temp table or a cursor).",[1081,1151,1152,913,1154,1157,1158,1160],{},[436,1153,1125],{},[22,1155,1156],{},"ORDER BY (col IS NULL), col"," is a portable way to push NULLs to the end of an ascending sort without relying on ",[22,1159,504],{}," — the boolean expression sorts FALSE (0) before TRUE (1), so non-NULL rows come first, then NULLs, then within each group the actual column values sort normally.",[1081,1162,1163,913,1165,776,1167,1169,1170,29,1173,29,1176,1178],{},[436,1164,1115],{},[22,1166,641],{},[22,1168,17],{}," is cheap (the planner just stops early), but ",[22,1171,1172],{},"LIMIT n",[26,1174,1175],{},"with",[22,1177,17],{}," on an unindexed column still sorts the entire result set before taking the top n — add an index on the sort column for \"top N\" queries to avoid a full sort.",[14,1180,1182],{"id":1181},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1078,1184,1185,1208,1233,1250,1273,1282,1298,1317],{},[1081,1186,1187,1194,1195,1198,1199,1201,1202,1205,1206,448],{},[436,1188,1189,776,1191,1193],{},[22,1190,641],{},[22,1192,17],{}," is non-deterministic",": the database may return ",[26,1196,1197],{},"any"," rows that match the ",[22,1200,1016],{},", in any order, and the set can differ between runs (especially after ",[22,1203,1204],{},"VACUUM"," or index changes). Never rely on \"the first 10 rows\" being meaningful without an ",[22,1207,17],{},[1081,1209,1210,1224,1225,1228,1229,1232],{},[436,1211,1212,1214,1215,1217,1218,1217,1221],{},[22,1213,645],{}," counts from the result after ",[22,1216,1016],{},"\u002F",[22,1219,1220],{},"GROUP BY",[22,1222,1223],{},"HAVING",", not from the table. A query with ",[22,1226,1227],{},"WHERE amount > 100 LIMIT 10 OFFSET 20"," skips 20 rows ",[26,1230,1231],{},"that pass the WHERE",", not 20 rows of the table.",[1081,1234,1235,1238,1239,1242,1243,1245,1246,1249],{},[436,1236,1237],{},"NULL sort order is engine-specific",": the same ",[22,1240,1241],{},"ORDER BY col ASC"," can put NULLs first (MySQL, SQLite) or last (PostgreSQL, Oracle). If the order matters, use ",[22,1244,585],{}," or the ",[22,1247,1248],{},"IS NULL"," trick — don't assume.",[1081,1251,1252,1260,1261,1263,1264,1266,1267,1269,1270,1272],{},[436,1253,1254,1257,1258],{},[22,1255,1256],{},"FETCH FIRST n ROWS ONLY"," vs ",[22,1259,1172],{},": they're equivalent in PostgreSQL, but ",[22,1262,876],{}," is ANSI standard and supports ",[22,1265,838],{},", while ",[22,1268,641],{}," is a PostgreSQL\u002FMySQL extension. SQLite uses ",[22,1271,641],{}," only.",[1081,1274,1275,1281],{},[436,1276,1277,1280],{},[22,1278,1279],{},"OFFSET 0"," is legal but pointless",": it's a no-op. Some ORMs generate it; ignore it.",[1081,1283,1284,913,1290,1293,1294,1297],{},[436,1285,1286,1287,1289],{},"Large ",[22,1288,645],{}," can be slower than a full scan",[22,1291,1292],{},"OFFSET 1000000 LIMIT 10"," on a 2M-row table may take longer than ",[22,1295,1296],{},"SELECT count(*)"," because the planner has to produce and discard a million rows. Keyset pagination avoids this entirely.",[1081,1299,1300,913,1305,1308,1309,1312,1313,1316],{},[436,1301,1302,1303],{},"Tie-breakers and ",[22,1304,838],{},[22,1306,1307],{},"FETCH FIRST 3 ROWS WITH TIES"," can return ",[26,1310,1311],{},"more"," than 3 rows if there are ties at the boundary — this is correct behavior (you asked for the top 3 ",[26,1314,1315],{},"values","), but callers expecting exactly 3 rows must handle variable result sizes.",[1081,1318,1319,1324,1325,1327,1328,1330,1331,1333],{},[436,1320,1321,1323],{},[22,1322,17],{}," in subqueries is ignored by the standard",": the SQL standard does not guarantee that ",[22,1326,17],{}," inside a subquery or view is preserved in the outer query — the outer query's ",[22,1329,17],{}," is what matters. PostgreSQL mostly preserves it as an optimization fence, but don't rely on it; move ",[22,1332,17],{}," to the outermost query.",[14,1335,1337],{"id":1336},"spot-the-bug","🧠 Spot the Bug",[19,1339,1340],{},"A developer implements pagination like this and reports that \"page 2 sometimes shows rows that were already on page 1.\" What's wrong?",[35,1342,1343],{"language":37},[39,1344,1346],{"className":41,"code":1345,"language":37,"meta":43,"style":43},"-- Page 1\nSELECT id, name, ordered_on FROM orders ORDER BY ordered_on DESC LIMIT 10;\n\n-- Page 2\nSELECT id, name, ordered_on FROM orders ORDER BY ordered_on DESC LIMIT 10 OFFSET 10;\n",[22,1347,1348,1352,1379,1383,1388],{"__ignoreMap":43},[47,1349,1350],{"class":49,"line":50},[47,1351,939],{"class":76},[47,1353,1354,1356,1358,1360,1363,1365,1367,1369,1371,1373,1375,1377],{"class":49,"line":80},[47,1355,32],{"class":53},[47,1357,946],{"class":59},[47,1359,150],{"class":53},[47,1361,1362],{"class":59},", ordered_on ",[47,1364,63],{"class":53},[47,1366,671],{"class":59},[47,1368,17],{"class":53},[47,1370,536],{"class":59},[47,1372,177],{"class":53},[47,1374,680],{"class":53},[47,1376,683],{"class":224},[47,1378,228],{"class":59},[47,1380,1381],{"class":49,"line":106},[47,1382,309],{"emptyLinePlaceholder":308},[47,1384,1385],{"class":49,"line":132},[47,1386,1387],{"class":76},"-- Page 2\n",[47,1389,1390,1392,1394,1396,1398,1400,1402,1404,1406,1408,1410,1412,1414,1417],{"class":49,"line":159},[47,1391,32],{"class":53},[47,1393,946],{"class":59},[47,1395,150],{"class":53},[47,1397,1362],{"class":59},[47,1399,63],{"class":53},[47,1401,671],{"class":59},[47,1403,17],{"class":53},[47,1405,536],{"class":59},[47,1407,177],{"class":53},[47,1409,680],{"class":53},[47,1411,683],{"class":224},[47,1413,717],{"class":59},[47,1415,1416],{"class":224},"10",[47,1418,228],{"class":59},[1420,1421,1422,1426,1454,1461,1506,1517],"details",{},[1423,1424,1425],"summary",{},"Answer",[19,1427,1428,1429,1432,1433,1435,1436,1439,1440,1442,1443,1445,1446,1449,1450,1453],{},"The sort key is ",[22,1430,1431],{},"ordered_on"," alone, and ",[22,1434,1431],{}," is ",[436,1437,1438],{},"not unique"," — many orders can share the same date. When multiple rows have the same ",[22,1441,1431],{}," value, their relative order is unspecified, and the planner is free to return them in ",[26,1444,1197],{}," order on each execution. Between the page-1 and page-2 queries, the planner may choose a different order for the tied rows, causing a row to appear in the ",[22,1447,1448],{},"LIMIT 10"," window of page 1 and again in the ",[22,1451,1452],{},"OFFSET 10 LIMIT 10"," window of page 2 (or to be skipped entirely).",[19,1455,1456,1457,1460],{},"The fix: add a ",[436,1458,1459],{},"unique tie-breaker"," — typically the primary key — as the final sort key:",[39,1462,1464],{"className":41,"code":1463,"language":37,"meta":43,"style":43},"SELECT id, name, ordered_on\nFROM orders\nORDER BY ordered_on DESC, id DESC\nLIMIT 10 OFFSET 10;\n",[22,1465,1466,1476,1482,1494],{"__ignoreMap":43},[47,1467,1468,1470,1472,1474],{"class":49,"line":50},[47,1469,32],{"class":53},[47,1471,946],{"class":59},[47,1473,150],{"class":53},[47,1475,951],{"class":59},[47,1477,1478,1480],{"class":49,"line":80},[47,1479,63],{"class":53},[47,1481,529],{"class":59},[47,1483,1484,1486,1488,1490,1492],{"class":49,"line":106},[47,1485,17],{"class":53},[47,1487,536],{"class":59},[47,1489,177],{"class":53},[47,1491,968],{"class":59},[47,1493,748],{"class":53},[47,1495,1496,1498,1500,1502,1504],{"class":49,"line":132},[47,1497,641],{"class":53},[47,1499,683],{"class":224},[47,1501,717],{"class":59},[47,1503,1416],{"class":224},[47,1505,228],{"class":59},[19,1507,1508,1509,1512,1513,1516],{},"::\nWith a total order (",[22,1510,1511],{},"ordered_on, id","), every row has a deterministic position, and pagination is stable. Even better, use keyset pagination on ",[22,1514,1515],{},"(ordered_on, id)"," for O(1) page seeks.",[19,1518,1519,913,1522,1524,1525,1528],{},[436,1520,1521],{},"The lesson",[22,1523,17],{}," on a non-unique column produces a ",[26,1526,1527],{},"partial"," order — tied rows are in arbitrary order and can drift between queries. Always add a unique tie-breaker for pagination.",[14,1530,1531],{"id":1423},"Summary",[19,1533,1534,1535,1537,1538,1217,1540,1542,1543,1545],{},"You can now sort with ",[22,1536,17],{}," (including NULL placement and custom orders), limit results with ",[22,1539,641],{},[22,1541,876],{},", and paginate — knowing why keyset pagination beats ",[22,1544,645],{}," at scale. Next: combining tables with joins, the most powerful feature of relational databases.",[1547,1548,1549],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}",{"title":43,"searchDepth":80,"depth":80,"links":1551},[1552,1556,1559,1565,1570,1571,1572,1573],{"id":16,"depth":80,"text":17,"children":1553},[1554,1555],{"id":194,"depth":106,"text":195},{"id":237,"depth":106,"text":238},{"id":402,"depth":80,"text":403,"children":1557},[1558],{"id":493,"depth":106,"text":494},{"id":635,"depth":80,"text":636,"children":1560},[1561,1563],{"id":792,"depth":106,"text":1562},"LIMIT 0 — a schema probe",{"id":828,"depth":106,"text":1564},"FETCH ... WITH TIES (PostgreSQL 13+, SQL Server)",{"id":892,"depth":80,"text":893,"children":1566},[1567,1568,1569],{"id":896,"depth":106,"text":897},{"id":920,"depth":106,"text":921},{"id":1092,"depth":106,"text":1093},{"id":1107,"depth":80,"text":1108},{"id":1181,"depth":80,"text":1182},{"id":1336,"depth":80,"text":1337},{"id":1423,"depth":80,"text":1531},"md",{},"\u002Fsql\u002F03-sorting-and-pagination",{"title":5,"description":43},"sql\u002F03-sorting-and-pagination","2W8llwc-qzUndeYujzzWr6pBhF_tz8-DPKXJkuTHElM",1787401244947]