[{"data":1,"prerenderedAt":2103},["ShallowReactive",2],{"page-\u002Fsql\u002F04-joins":3},{"id":4,"title":5,"body":6,"description":16,"extension":2097,"meta":2098,"navigation":187,"path":2099,"seo":2100,"stem":2101,"__hash__":2102},"content\u002Fsql\u002F04-joins.md","04 — Joins",{"type":7,"value":8,"toc":2074},"minimark",[9,13,17,22,30,46,54,58,65,352,361,366,369,440,463,467,479,657,683,687,693,2070],[10,11,5],"h1",{"id":12},"_04-joins",[14,15,16],"p",{},"Joins combine rows from two (or more) tables based on a related column. They are the defining feature of relational databases — the \"relational\" in \"relational\" is realized through joins.",[18,19,21],"h2",{"id":20},"the-mental-model","The Mental Model",[14,23,24,25,29],{},"A join produces a ",[26,27,28],"strong",{},"combined result set"," by matching rows from the left and right inputs. Think of it in two steps:",[31,32,33,40],"ol",{},[34,35,36,39],"li",{},[26,37,38],{},"Cartesian product"," — every row of the left table paired with every row of the right table.",[34,41,42,45],{},[26,43,44],{},"Filter"," — keep only the pairs that satisfy the join condition.",[14,47,48,49,53],{},"Different join types vary step 2's filter and which un-matched rows are kept. The optimizer doesn't actually compute the full Cartesian product (it uses nested loops, hashes, or merges), but the ",[50,51,52],"em",{},"result"," is as if it did.",[18,55,57],{"id":56},"inner-join","INNER JOIN",[14,59,60,61,64],{},"Keeps only rows that match in ",[26,62,63],{},"both"," tables.",[66,67,69],"code-wrapper",{"language":68},"sql",[70,71,75],"pre",{"className":72,"code":73,"language":68,"meta":74,"style":74},"language-sql shiki shiki-themes github-light github-dark","-- Customers and their orders (only customers who have orders)\nSELECT c.name, o.id AS order_id, o.amount\nFROM customers c\nINNER JOIN orders o ON c.id = o.customer_id;\n``\n::\n\nUnmatched rows (customers with no orders, orders with no customer) are dropped.\n\n## LEFT (OUTER) JOIN\n\nKeeps **all rows from the left** table, with NULLs for unmatched right rows.\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- All customers, with their orders if any (NULLs for customers with no orders)\nSELECT c.name, o.id AS order_id, o.amount\nFROM customers c\nLEFT JOIN orders o ON c.id = o.customer_id;\n``\n","",[76,77,78,87,129,138,169,176,182,189,217,222,243,248,291,296,317,323,329,335,341,347],"code",{"__ignoreMap":74},[79,80,83],"span",{"class":81,"line":82},"line",1,[79,84,86],{"class":85},"sdCPZ","-- Customers and their orders (only customers who have orders)\n",[79,88,90,94,98,102,105,108,111,113,116,119,122,124,126],{"class":81,"line":89},2,[79,91,93],{"class":92},"svdQ7","SELECT",[79,95,97],{"class":96},"snvgF"," c",[79,99,101],{"class":100},"ssxIu",".",[79,103,104],{"class":96},"name",[79,106,107],{"class":100},", ",[79,109,110],{"class":96},"o",[79,112,101],{"class":100},[79,114,115],{"class":96},"id",[79,117,118],{"class":92}," AS",[79,120,121],{"class":100}," order_id, ",[79,123,110],{"class":96},[79,125,101],{"class":100},[79,127,128],{"class":96},"amount\n",[79,130,132,135],{"class":81,"line":131},3,[79,133,134],{"class":92},"FROM",[79,136,137],{"class":100}," customers c\n",[79,139,141,143,146,149,151,153,155,158,161,163,166],{"class":81,"line":140},4,[79,142,57],{"class":92},[79,144,145],{"class":100}," orders o ",[79,147,148],{"class":92},"ON",[79,150,97],{"class":96},[79,152,101],{"class":100},[79,154,115],{"class":96},[79,156,157],{"class":92}," =",[79,159,160],{"class":96}," o",[79,162,101],{"class":100},[79,164,165],{"class":96},"customer_id",[79,167,168],{"class":100},";\n",[79,170,172],{"class":81,"line":171},5,[79,173,175],{"class":174},"sJ6F3","``\n",[79,177,179],{"class":81,"line":178},6,[79,180,181],{"class":100},"::\n",[79,183,185],{"class":81,"line":184},7,[79,186,188],{"emptyLinePlaceholder":187},true,"\n",[79,190,192,195,198,201,204,207,210,212,214],{"class":81,"line":191},8,[79,193,194],{"class":100},"Unmatched ",[79,196,197],{"class":92},"rows",[79,199,200],{"class":100}," (customers ",[79,202,203],{"class":92},"with",[79,205,206],{"class":92}," no",[79,208,209],{"class":100}," orders, orders ",[79,211,203],{"class":92},[79,213,206],{"class":92},[79,215,216],{"class":100}," customer) are dropped.\n",[79,218,220],{"class":81,"line":219},9,[79,221,188],{"emptyLinePlaceholder":187},[79,223,225,228,231,234,237,240],{"class":81,"line":224},10,[79,226,227],{"class":100},"## ",[79,229,230],{"class":96},"LEFT",[79,232,233],{"class":100}," (",[79,235,236],{"class":92},"OUTER",[79,238,239],{"class":100},") ",[79,241,242],{"class":92},"JOIN\n",[79,244,246],{"class":81,"line":245},11,[79,247,188],{"emptyLinePlaceholder":187},[79,249,251,254,257,260,262,265,268,270,273,275,277,280,283,286,288],{"class":81,"line":250},12,[79,252,253],{"class":100},"Keeps ",[79,255,256],{"class":92},"**",[79,258,259],{"class":100},"all ",[79,261,197],{"class":92},[79,263,264],{"class":92}," from",[79,266,267],{"class":100}," the left",[79,269,256],{"class":92},[79,271,272],{"class":92}," table",[79,274,107],{"class":100},[79,276,203],{"class":92},[79,278,279],{"class":92}," NULLs",[79,281,282],{"class":92}," for",[79,284,285],{"class":100}," unmatched right ",[79,287,197],{"class":92},[79,289,290],{"class":100},".\n",[79,292,294],{"class":81,"line":293},13,[79,295,188],{"emptyLinePlaceholder":187},[79,297,299,302,305,308,311,314],{"class":81,"line":298},14,[79,300,301],{"class":100},"::code",[79,303,304],{"class":92},"-",[79,306,307],{"class":100},"wrapper{",[79,309,310],{"class":92},"language=",[79,312,313],{"class":174},"\"sql\"",[79,315,316],{"class":100},"}\n",[79,318,320],{"class":81,"line":319},15,[79,321,322],{"class":174},"```sql\n",[79,324,326],{"class":81,"line":325},16,[79,327,328],{"class":174},"-- All customers, with their orders if any (NULLs for customers with no orders)\n",[79,330,332],{"class":81,"line":331},17,[79,333,334],{"class":174},"SELECT c.name, o.id AS order_id, o.amount\n",[79,336,338],{"class":81,"line":337},18,[79,339,340],{"class":174},"FROM customers c\n",[79,342,344],{"class":81,"line":343},19,[79,345,346],{"class":174},"LEFT JOIN orders o ON c.id = o.customer_id;\n",[79,348,350],{"class":81,"line":349},20,[79,351,175],{"class":174},[14,353,354,355,107,358,101],{},"Customers without orders appear once with ",[76,356,357],{},"order_id = NULL",[76,359,360],{},"amount = NULL",[362,363,365],"h3",{"id":364},"using-left-join-to-find-rows-with-no-match","Using LEFT JOIN to find \"rows with no match\"",[14,367,368],{},"This is the idiomatic \"anti-join\" pattern:",[66,370,371],{"language":68},[70,372,374],{"className":72,"code":373,"language":68,"meta":74,"style":74},"-- Customers who have never placed an order\nSELECT c.*\nFROM customers c\nLEFT JOIN orders o ON c.id = o.customer_id\nWHERE o.id IS NULL;\n",[76,375,376,381,391,397,421],{"__ignoreMap":74},[79,377,378],{"class":81,"line":82},[79,379,380],{"class":85},"-- Customers who have never placed an order\n",[79,382,383,385,388],{"class":81,"line":89},[79,384,93],{"class":92},[79,386,387],{"class":100}," c.",[79,389,390],{"class":92},"*\n",[79,392,393,395],{"class":81,"line":131},[79,394,134],{"class":92},[79,396,137],{"class":100},[79,398,399,402,404,406,408,410,412,414,416,418],{"class":81,"line":140},[79,400,401],{"class":92},"LEFT JOIN",[79,403,145],{"class":100},[79,405,148],{"class":92},[79,407,97],{"class":96},[79,409,101],{"class":100},[79,411,115],{"class":96},[79,413,157],{"class":92},[79,415,160],{"class":96},[79,417,101],{"class":100},[79,419,420],{"class":96},"customer_id\n",[79,422,423,426,428,430,432,435,438],{"class":81,"line":171},[79,424,425],{"class":92},"WHERE",[79,427,160],{"class":96},[79,429,101],{"class":100},[79,431,115],{"class":96},[79,433,434],{"class":92}," IS",[79,436,437],{"class":92}," NULL",[79,439,168],{"class":100},[14,441,442,443,446,447,450,451,454,455,458,459,462],{},"The ",[76,444,445],{},"WHERE o.id IS NULL"," filters to rows where the join found no match. Test a ",[26,448,449],{},"non-nullable"," column (like ",[76,452,453],{},"o.id",", the primary key) — testing ",[76,456,457],{},"o.amount IS NULL"," would also exclude rows where the order exists but ",[76,460,461],{},"amount"," happens to be NULL.",[18,464,466],{"id":465},"right-outer-join","RIGHT (OUTER) JOIN",[14,468,253,469,472,473,475,476,478],{},[26,470,471],{},"all rows from the right"," table. It's a ",[76,474,401],{}," with the tables swapped — most people just swap the tables and use ",[76,477,401],{}," for readability.",[66,480,481],{"language":68},[70,482,484],{"className":72,"code":483,"language":68,"meta":74,"style":74},"-- All orders, with their customer if any\nSELECT c.name, o.id AS order_id, o.amount\nFROM customers c\nRIGHT JOIN orders o ON c.id = o.customer_id;\n``\n::\n\n## FULL (OUTER) JOIN\n\nKeeps **all rows from both** tables, with NULLs on whichever side has no match.\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- All customers and all orders, matched where possible\nSELECT c.name, o.id AS order_id, o.amount\nFROM customers c\nFULL JOIN orders o ON c.id = o.customer_id;\n``\n",[76,485,486,491,519,525,550,554,558,562,573,577,613,617,631,635,640,644,648,653],{"__ignoreMap":74},[79,487,488],{"class":81,"line":82},[79,489,490],{"class":85},"-- All orders, with their customer if any\n",[79,492,493,495,497,499,501,503,505,507,509,511,513,515,517],{"class":81,"line":89},[79,494,93],{"class":92},[79,496,97],{"class":96},[79,498,101],{"class":100},[79,500,104],{"class":96},[79,502,107],{"class":100},[79,504,110],{"class":96},[79,506,101],{"class":100},[79,508,115],{"class":96},[79,510,118],{"class":92},[79,512,121],{"class":100},[79,514,110],{"class":96},[79,516,101],{"class":100},[79,518,128],{"class":96},[79,520,521,523],{"class":81,"line":131},[79,522,134],{"class":92},[79,524,137],{"class":100},[79,526,527,530,532,534,536,538,540,542,544,546,548],{"class":81,"line":140},[79,528,529],{"class":92},"RIGHT JOIN",[79,531,145],{"class":100},[79,533,148],{"class":92},[79,535,97],{"class":96},[79,537,101],{"class":100},[79,539,115],{"class":96},[79,541,157],{"class":92},[79,543,160],{"class":96},[79,545,101],{"class":100},[79,547,165],{"class":96},[79,549,168],{"class":100},[79,551,552],{"class":81,"line":171},[79,553,175],{"class":174},[79,555,556],{"class":81,"line":178},[79,557,181],{"class":100},[79,559,560],{"class":81,"line":184},[79,561,188],{"emptyLinePlaceholder":187},[79,563,564,567,569,571],{"class":81,"line":191},[79,565,566],{"class":100},"## FULL (",[79,568,236],{"class":92},[79,570,239],{"class":100},[79,572,242],{"class":92},[79,574,575],{"class":81,"line":219},[79,576,188],{"emptyLinePlaceholder":187},[79,578,579,581,583,585,587,589,592,595,597,599,602,605,608,611],{"class":81,"line":224},[79,580,253],{"class":100},[79,582,256],{"class":92},[79,584,259],{"class":100},[79,586,197],{"class":92},[79,588,264],{"class":92},[79,590,591],{"class":92}," both**",[79,593,594],{"class":100}," tables, ",[79,596,203],{"class":92},[79,598,279],{"class":92},[79,600,601],{"class":92}," on",[79,603,604],{"class":100}," whichever side has ",[79,606,607],{"class":92},"no",[79,609,610],{"class":92}," match",[79,612,290],{"class":100},[79,614,615],{"class":81,"line":245},[79,616,188],{"emptyLinePlaceholder":187},[79,618,619,621,623,625,627,629],{"class":81,"line":250},[79,620,301],{"class":100},[79,622,304],{"class":92},[79,624,307],{"class":100},[79,626,310],{"class":92},[79,628,313],{"class":174},[79,630,316],{"class":100},[79,632,633],{"class":81,"line":293},[79,634,322],{"class":174},[79,636,637],{"class":81,"line":298},[79,638,639],{"class":174},"-- All customers and all orders, matched where possible\n",[79,641,642],{"class":81,"line":319},[79,643,334],{"class":174},[79,645,646],{"class":81,"line":325},[79,647,340],{"class":174},[79,649,650],{"class":81,"line":331},[79,651,652],{"class":174},"FULL JOIN orders o ON c.id = o.customer_id;\n",[79,654,655],{"class":81,"line":337},[79,656,175],{"class":174},[14,658,659,660,663,664,667,668,670,671,670,674,676,677,670,679,682],{},"PostgreSQL and SQL Server support ",[76,661,662],{},"FULL JOIN",". ",[26,665,666],{},"MySQL and SQLite do not"," — emulate it with a ",[76,669,401],{}," + ",[76,672,673],{},"UNION",[76,675,529],{}," (or ",[76,678,401],{},[76,680,681],{},"UNION ALL"," + anti-join).",[18,684,686],{"id":685},"cross-join","CROSS JOIN",[14,688,689,690,692],{},"The Cartesian product — every left row paired with every right row, no filter. No ",[76,691,148],{}," clause.",[66,694,695,908,911,931,935,941,1039,1045,1078,1106,1113,1135,1155,1159,1162,1306,1310,1313,1387,1390,1394,1401,1463,1466,1470,1579,1583,1744,1748,1755,1851,2032,2035],{"language":68},[70,696,698],{"className":72,"code":697,"language":68,"meta":74,"style":74},"-- All (customer, product) pairs — useful for generating combinations\nSELECT c.name, p.name AS product\nFROM customers c\nCROSS JOIN products p;\n``\n::\n\nIf `customers` has 3 rows and `products` has 5, the result has 15 rows. `CROSS JOIN` is rare in business queries but common for generating test data, sparse matrices, or \"every X for every Y\" reports.\n\n### ⚠️ Accidental CROSS JOIN\n\nForgetting the `ON` clause in an `INNER JOIN` turns it into a `CROSS JOIN`:\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- Oops — no ON condition, this is a CROSS JOIN producing 3*4=12 rows\nSELECT * FROM customers c JOIN orders o;   -- some engines require ON; PostgreSQL allows this as CROSS JOIN\n",[76,699,700,705,728,734,741,745,749,753,827,831,839,843,876,880,894,898,903],{"__ignoreMap":74},[79,701,702],{"class":81,"line":82},[79,703,704],{"class":85},"-- All (customer, product) pairs — useful for generating combinations\n",[79,706,707,709,711,713,715,717,719,721,723,725],{"class":81,"line":89},[79,708,93],{"class":92},[79,710,97],{"class":96},[79,712,101],{"class":100},[79,714,104],{"class":96},[79,716,107],{"class":100},[79,718,14],{"class":96},[79,720,101],{"class":100},[79,722,104],{"class":96},[79,724,118],{"