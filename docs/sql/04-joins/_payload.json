79,855,802],{"class":92},[79,857,858],{"class":100}," an ",[79,860,861],{"class":174},"`INNER JOIN`",[79,863,864],{"class":100}," turns it ",[79,866,867],{"class":92},"into",[79,869,870],{"class":100}," a ",[79,872,793],{"class":174},[79,874,875],{"class":100},":\n",[79,877,878],{"class":81,"line":293},[79,879,188],{"emptyLinePlaceholder":187},[79,881,882,884,886,888,890,892],{"class":81,"line":298},[79,883,301],{"class":100},[79,885,304],{"class":92},[79,887,307],{"class":100},[79,889,310],{"class":92},[79,891,313],{"class":174},[79,893,316],{"class":100},[79,895,896],{"class":81,"line":319},[79,897,322],{"class":174},[79,899,900],{"class":81,"line":325},[79,901,902],{"class":174},"-- Oops — no ON condition, this is a CROSS JOIN producing 3*4=12 rows\n",[79,904,905],{"class":81,"line":331},[79,906,907],{"class":174},"SELECT * FROM customers c JOIN orders o;   -- some engines require ON; PostgreSQL allows this as CROSS JOIN\n",[14,909,910],{},"::",[14,912,913,914,916,917,920,921,924,925,927,928,930],{},"MySQL is lenient (allows it). PostgreSQL requires ",[76,915,148],{}," or ",[76,918,919],{},"USING"," for ",[76,922,923],{},"JOIN"," (use explicit ",[76,926,686],{}," for the cartesian product). Always include ",[76,929,148],{}," for inner\u002Fouter joins.",[18,932,934],{"id":933},"join-syntax-on-using-natural","JOIN Syntax: ON, USING, NATURAL",[362,936,938,940],{"id":937},"on-explicit-condition",[76,939,148],{}," — explicit condition",[66,942,943],{"language":68},[70,944,946],{"className":72,"code":945,"language":68,"meta":74,"style":74},"SELECT * FROM customers c JOIN orders o ON c.id = o.customer_id;\n-- ON can include any boolean expression, not just equality\nSELECT * FROM orders o JOIN customers c ON o.customer_id = c.id AND o.amount > c.credit_limit;\n",[76,947,948,983,988],{"__ignoreMap":74},[79,949,950,952,955,958,961,963,965,967,969,971,973,975,977,979,981],{"class":81,"line":82},[79,951,93],{"class":92},[79,953,954],{"class":92}," *",[79,956,957],{"class":