HEN",[44,89,90],{"class":57}," true ",[44,92,93],{"class":50},"ELSE",[44,95,96],{"class":57}," false ",[44,98,99],{"class":50},"END",[44,101,102],{"class":50}," AS",[44,104,105],{"class":57}," starts_with_vowel\n",[44,107,109,112],{"class":46,"line":108},3,[44,110,111],{"class":50},"FROM",[44,113,114],{"class":57}," customers\n",[44,116,118,121,124,127,130,133,136,139],{"class":46,"line":117},4,[44,119,120],{"class":50},"WHERE",[44,122,123],{"class":57}," city ",[44,125,126],{"class":50},"IN",[44,128,129],{"class":57}," (",[44,131,132],{"class":83},"'NYC'",[44,134,135],{"class":57},", ",[44,137,138],{"class":83},"'LA'",[44,140,141],{"class":57},")\n",[44,143,145,148,150],{"class":46,"line":144},5,[44,146,147],{"class":50},"ORDER BY",[44,149,54],{"class":50},[44,151,152],{"class":57},";\n",[23,154,156],{"id":155},"_2-order-summary-aggregation-group-by","2. Order Summary (aggregation, GROUP BY)",[14,158,159],{},"For each customer, show their name, number of orders, total spent, and average order amount. Sort by total spent descending.",[31,161,162],{"language":33},[35,163,165],{"className":37,"code":164,"language":33,"meta":39,"style":39},"SELECT c.name, COUNT(o.id) AS order_count,\n  COALESCE(SUM(o.amount), 0) AS total_spent,\n  COALESCE(AVG(o.amount), 0) AS avg_order\nFROM customers c\nLEFT JOIN orders o ON c.id = o.customer_id\nGROUP BY c.id, c.name\nORDER BY total_spent DESC;\n",[41,166,167,203,235,263,270,298,320],{"__ignoreMap":39},[44,168,169,171,174,177,179,181,184,186,189,191,194,197,200],{"class":46,"line":47},[44,170,51],{"class":50},[44,172,173],{"class":70}," c",[44,175,176],{"class":57},".",[44,178,77],{"class":70},[44,180,135],{"class":57},[44,182,183],{"class":70},"COUNT",[44,185,74],{"class":57},[44,187,188],{"class":70},"o",[44,190,176],{"class":57},[44,192,193],{"class":70},"id",[44,195,196],{"class":57},") ",[44,198,199],{"class":50},"AS",[44,201,202],{"class":57}," order_count,\n",[44,204,205,208,210,213,215,217,219,222,225,228,230,232],{"class":4