_4-pagination-limit-keyset","4. Pagination (LIMIT, keyset)",[14,345,346,347,350,351,176],{},"Implement keyset pagination for orders ordered by ",[41,348,349],{},"(ordered_on DESC, id DESC)"," — write the query for page 1, then page 2 given the last row's ",[41,352,353],{},"(ordered_on, id)",[23,355,357],{"id":356},"_5-missing-data-anti-join","5. Missing Data (anti-join)",[14,359,360,361,364,365,368],{},"Find customers who have never placed an order, using ",[41,362,363],{},"LEFT JOIN ... IS NULL"," and ",[41,366,367],{},"NOT EXISTS",". Compare the two approaches.",[18,370,372],{"id":371},"intermediate","Intermediate",[23,374,376],{"id":375},"_6-top-3-orders-per-customer-window-functions","6. Top 3 Orders per Customer (window functions)",[14,378,379,380,176],{},"For each customer, show their top 3 orders by amount. Use ",[41,381,382],{},"ROW_NUMBER() OVER (PARTITION BY ...)",[31,384,385],{"language":33},[35,386,388],{"className":37,"code":387,"language":33,"meta":39,"style":39},"WITH ranked AS (\n  SELECT customer_id, id, amount,\n    ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC) AS rn\n  FROM orders\n)\nSELECT customer_id, id, amount FROM ranked WHERE rn \u003C= 3 ORDER BY customer_id, rn;\n",[41,389,390,403,411,447,455,459],{"__ignoreMap":39},[44,391,392,395,398,400],{"class":46,"line":47},[44,393,394],{"class":50},"WITH",[44,396,397],{"class":57}," ranked ",[44,399,199],{"class":50},[44,401,402],{"class":57}," (\n",[44,404,405,408],{"class":46,"line":61},[44,406,407],{"class":50},"  SELECT",[44,409,410],{"class":57}," customer_id, id, amount,\n",[44,412,413,416,419,422,424,427,430,433,435,438,440,442,444],{"class":46,"line":108},[44,414,415],{"class":70},"    ROW_NUMBER",[44,417,418],{"class":57},"() ",[44,420,421],{"class":50},"OVER",[44,423,129],{"class":57},[44,425,426],{"class":50},"PARTITION",[44,428,429],{"class":50}," BY",[44,431,432],{"class":57}," customer_id ",[44,434,147],{"class":50},[44,436,437],{"class":57}," amount ",[44,439,330],{"class":50},[44,441,196],{"class":57},[44,443,199],{"class":50},[44,445,446],{"class":57}," rn\n",[44,448,449,452],{"class":46,"line":117},[44,450,451],{"class":50},"  FROM",[44,453,454],{"class":57}," orders\n",[44,456,457],{"class":46,"line":144},[44,458,141],{"class":57},[44,460,461,463,466,468,470,472,475,478,481,484],{"class":46,"line":300},[44,462,51],{"class":50},[44,464,465],{"class":57}," customer_id, id, amount ",[44,467,111],{"class":50},[44,469,397],{"class":57},[44,471,120],{"class":50},[44,473,474],{"class":57}," rn ",[44,476,477],{"class":50},"\u003C=",[44,479,480],{"class":70}," 3",[44,482,483],{"class":50}," ORDER BY",[44,485,486],{"class":57}," customer_id, rn;\n",[23,488,490],{"id":489},"_7-running-total-window-functions","7. Running Total (window functions)",[14,492,493,494,176],{},"For each customer, show each order with a running total of their spending, ordered by date. Handle ties (same-day orders) with ",[41,495,496],{},"ROWS",[23,498,500],{"id":499},"_8-monthly-revenue-date_trunc-generate_series","8. Monthly Revenue (date_trunc, generate_series)",[14,502,503,504,507,508,510],{},"Build a monthly revenue report for 2024, including months with zero revenue (use ",[41,505,506],{},"generate_series"," + ",[41,509,274],{},").",[23,512,514],{"id":513},"_9-gaps-and-islands-advanced-pattern","9. Gaps and Islands (advanced pattern)",[14,516,517,518,521,522,525],{},"Given an ",[41,519,520],{},"activity"," table ",[41,523,524],{},"(user_id, activity_date)",", find the longest streak of consecutive active days per user.",[23,527,529],{"id":528},"_10-pivot-conditional-aggregation","10. Pivot (conditional aggregation)",[14,531,532],{},"Pivot the monthly revenue into a cross-tab: one row per customer, one column per month (Jan, Feb, Mar).",[23,534,536],{"id":535},"_11-recursive-hierarchy-recursive-cte","11. Recursive Hierarchy (recursive CTE)",[14,538,517,539,521,542,545],{},[41,540,541],{},"employees",[41,543,544],{},"(id, name, manager_id)",", list all descendants of employee 1 with their depth. Then, build the management chain path as an array.",[23,547,549],{"id":548},"_12-jsonb-events-json-indexing","12. JSONB Events (JSON, indexing)",[14,551,552,553,556,557,560,561,564],{},"Create an ",[41,554,555],{},"events"," table with a ",[41,558,559],{},"JSONB payload",". Insert events with ",[41,562,563],{},"{\"type\": \"click\", \"user_id\": 42, \"amount\": 10}",". Create a GIN index and query for all \"click\" events for user 42 with amount > 5.",[18,566,568],{"id":567},"advanced","Advanced",[23,570,572],{"id":571},"_13-inventory-reservation-transactions-for-update","13. Inventory Reservation (transactions, FOR UPDATE)",[14,574,575,576,579],{},"Write a transaction that reserves an item: check stock, decrement if available, record the reservation. Use ",[41,577,578],{},"SELECT ... FOR UPDATE"," to prevent overselling under concurrency.",[31,581,582,1250,1253,1274,1278,1370,1386,1390,1435,1454,1458,1483,1502,1506,1546,1559,1563,1609,1613,1616],{"language":33},[35,583,585],{"className":37,"code":584,"language":33,"meta":39,"style":39},"BEGIN;\nSELECT qty FROM inventory WHERE product_id = 5 FOR UPDATE;\n-- if qty > 0:\nUPDATE inventory SET qty = qty - 1 WHERE product_id = 5;\nINSERT INTO reservations (product_id, reserved_at) VALUES (5, now());\nCOMMIT;\n-- else: ROLLBACK\n``\n::\n\n### 14. SERIALIZABLE Transfer (isolation, retry)\n\nImplement a money transfer between two accounts at SERIALIZABLE isolation, with retry on serialization failure. Test that concurrent transfers don't lose money.\n\n### 15. Audit Trigger (triggers)\n\nCreate an audit trigger that logs every `UPDATE` and `DELETE` on `orders` to an `orders_audit` table with the old and new values, timestamp, and user.\n\n### 16. Search Engine (full-text search)\n\nBuild a search over an `articles` table: generate a `tsvector` from title + body (title weighted higher), create a GIN index, and query with ranking and highlighting. Support multi-word queries with `&`.\n\n### 17. Materialized View Dashboard (materialized views, refresh)\n\nCreate a materialized view for a dashboard (e.g., sales by city by month). Refresh it concurrently (add a unique index first). Schedule a refresh with `pg_cron`.\n\n### 18. Multi-Tenant RLS (security)\n\nSet up a multi-tenant schema: every table has `tenant_id`, RLS policies enforce `tenant_id = current_setting('app.tenant')`, and the app sets `app.tenant` per request. Test that a query with tenant=1 doesn't see tenant=2's rows.\n\n### 19. Query Optimization (EXPLAIN)\n\nTake a slow query (a 3-table join with a filter), run `EXPLAIN (ANALYZE, BUFFERS)`, identify the bottleneck (seq scan, missing index, bad join order), add an index or rewrite, and measure the improvement.\n\n### 20. Backup and Restore (administration)\n\nTake a `pg_dump` of your database, drop a table, restore it from the dump, and verify the data. Then, set up WAL archiving and test point-in-time recovery (restore to a specific timestamp).\n\n## Pro \u002F Capstone\n\n### 21. ETL Pipeline (stored procedure, batches)\n\nWrite a stored procedure that archives orders older than N days, in batches of 10000, committing per batch, with progress logging (`RAISE NOTICE`). Test with a million-row table.\n\n### 22. Analytics Schema (data modeling)\n\nDesign a normalized schema for an e-commerce analytics system: customers, orders, order_items, products, categories (hierarchical), events. Then denormalize a hot query path (e.g., \"customer lifetime spend\") with a materialized view or a trigger-maintained summary column.\n\n### 23. Job Queue (SKIP LOCKED, transactions)\n\nBuild a database-backed job queue: a `jobs` table, workers grab the next pending job with `FOR UPDATE SKIP LOCKED`, mark it in-progress, process, mark done. Handle worker crashes (stale in-progress jobs) with a timeout.\n\n### 24. Time-Series Aggregation (date_trunc, BRIN, partitioning)\n\nBuild a time-series table for millions of log events. Partition it by month. Add a BRIN index on the timestamp. Aggregate events per hour with `date_trunc` + `generate_series`. Drop an old partition and observe it's instant.\n\n### 25. Full-Stack Search App (FTS, ranking, highlighting)\n\nBuild a search interface over a documents table: support boolean queries (`postgres & index`), phrase queries (`full text search`), prefix matching (`post:*`), ranking by `ts_rank`, and result highlighting with `ts_headline`. Add a trigram fallback for substring search.\n\n## Exercise: Find the Bug\n\nFor each query below, find the bug and write the fix. (Answers in `\u003Cdetails>`.)\n\n### A. NULL in NOT IN\n\n::code-wrapper{language=\"sql\"}\n```sql\nSELECT * FROM customers WHERE id NOT IN (SELECT customer_id FROM orders);\n",[41,586,587,594,625,631,664,688,695,700,706,712,719,745,750,794,799,805,810,816,821,827,832,838,843,849,854,860,865,871,876,904,909,915,920,926,931,937,942,948,953,959,964,970,975,981,986,992,997,1003,1008,1014,1019,1025,1030,1036,1041,1050,1055,1071,1076,1151,1156,1162,1167,1190,1195,1213,1218,1238,1244],{"__ignoreMap":39},[44,588,589,592],{"class":46,"line":47},[44,590,591],{"class":50},"BEGIN",[44,593,152],{"class":57},[44,595,596,598,601,603,606,608,611,614,617,620,623],{"class":46,"line":61},[44,597,51],{"class":50},[44,599,600],{"class":57}," qty ",[44,602,111],{"class":50},[44,604,605],{"class":57}," inventory ",[44,607,120],{"class":50},[44,609,610],{"class":57}," product_id ",[44,612,613],{"class":50},"=",[44,615,616],{"class":70}," 5",[44,618,619],{"class":50}," FOR",[44,621,622],{"class":50}," UPDATE",[44,624,152],{"class":57},[44,626,627],{"class":46,"line":108},[44,628,630],{"class":629},"sdCPZ","-- if qty > 0:\n",[44,632,633,636,638,641,643,645,647,650,653,656,658,660,662],{"class":46,"line":117},[44,634,635],{"class":50},"UPDATE",[44,637,605],{"class":57},[44,639,640],{"class":50},"SET",[44,642,600],{"class":57},[44,644,613],{"class":50},[44,646,600],{"class":57},[44,648,649],{"class":50},"-",[44,651,652],{"class":70}," 1",[44,654,655],{"class":50}," WHERE",[44,657,610],{"class":57},[44,659,613],{"class":50},[44,661,616],{"class":70},[44,663,152],{"class":57},[44,665,666,669,672,675,677,680,682,685],{"class":46,"line":144},[44,667,668],{"class":50},"INSERT INTO",[44,670,671],{"class":57}," reservations (product_id, reserved_at) ",[44,673,674],{"class":50},"VALUES",[44,676,129],{"class":57},[44,678,679],{"class":70},"5",[44,681,135],{"class":57},[44,683,684],{"class":50},"now",[44,686,687],{"class":57},"());\n",[44,689,690,693],{"class":46,"line":300},[44,691,692],{"class":50},"COMMIT",[44,694,152],{"class":57},[44,696,697],{"class":46,"line":322},[44,698,699],{"class":629},"-- else: ROLLBACK\n",[44,701,703],{"class":46,"line":702},8,[44,704,705],{"class":83},"``\n",[44,707,709],{"class":46,"line":708},9,[44,710,711],{"class":57},"::\n",[44,713,715],{"class":46,"line":714},10,[44,716,718],{"emptyLinePlaceholder":717},true,"\n",[44,720,722,725,728,731,734,737,739,742],{"class":46,"line":721},11,[44,723,724],{"class":57},"### ",[44,726,727],{"class":70},"14",[44,729,730],{"class":57},". ",[44,732,733],{"class":50},"SERIALIZABLE",[44,735,736],{"class":50}," Transfer",[44,738,129],{"class":57},[44,740,741],{"class":50},"isolation",[44,743,744],{"class":57},", retry)\n",[44,746,748],{"class":46,"line":747},12,[44,749,718],{"emptyLinePlaceholder":717},[44,751,753,756,759,762,765,768,771,774,777,779,782,785,788,791],{"class":46,"line":752},13,[44,754,755],{"class":57},"Implement a ",[44,757,758],{"class":50},"money",[44,760,761],{"class":50}," transfer",[44,763,764],{"class":50}," between",[44,766,767],{"class":57}," two accounts ",[44,769,770],{"class":50},"at",[44,772,773],{"class":50}," SERIALIZABLE",[44,775,776],{"class":50}," isolation",[44,778,135],{"class":57},[44,780,781],{"class":50},"with",[44,783,784],{"class":57}," retry ",[44,786,787],{"class":50},"on",[44,789,790],{"class":57}," serialization failure. Test that concurrent transfers don",[44,792,793],{"class":83},"'t lose money.\n",[44,795,797],{"class":46,"line":796},14,[44,798,718],{"emptyLinePlaceholder":717},[44,800,802],{"class":46,"line":801},15,[44,803,804],{"class":83},"### 15. Audit Trigger (triggers)\n",[44,806,808],{"class":46,"line":807},16,[44,809,718],{"emptyLinePlaceholder":717},[44,811,813],{"class":46,"line":812},17,[44,814,815],{"class":83},"Create an audit trigger that logs every `UPDATE` and `DELETE` on `orders` to an `orders_audit` table with the old and new values, timestamp, and user.\n",[44,817,819],{"class":46,"line":818},18,[44,820,718],{"emptyLinePlaceholder":717},[44,822,824],{"class":46,"line":823},19,[44,825,826],{"class":83},"### 16. Search Engine (full-text search)\n",[44,828,830],{"class":46,"line":829},20,[44,831,718],{"emptyLinePlaceholder":717},[44,833,835],{"class":46,"line":834},21,[44,836,837],{"class":83},"Build a search over an `articles` table: generate a `tsvector` from title + body (title weighted higher), create a GIN index, and query with ranking and highlighting. Support multi-word queries with `&`.\n",[44,839,841],{"class":46,"line":840},22,[44,842,718],{"emptyLinePlaceholder":717},[44,844,846],{"class":46,"line":845},23,[44,847,848],{"class":83},"### 17. Materialized View Dashboard (materialized views, refresh)\n",[44,850,852],{"class":46,"line":851},24,[44,853,718],{"emptyLinePlaceholder":717},[44,855,857],{"class":46,"line":856},25,[44,858,859],{"class":83},"Create a materialized view for a dashboard (e.g., sales by city by month). Refresh it concurrently (add a unique index first). Schedule a refresh with `pg_cron`.\n",[44,861,863],{"class":46,"line":862},26,[44,864,718],{"emptyLinePlaceholder":717},[44,866,868],{"class":46,"line":867},27,[44,869,870],{"class":83},"### 18. Multi-Tenant RLS (security)\n",[44,872,874],{"class":46,"line":873},28,[44,875,718],{"emptyLinePlaceholder":717},[44,877,879,882,885,887,890,893,896,898,901],{"class":46,"line":878},29,[44,880,881],{"class":83},"Set up a multi-tenant schema: every table has `tenant_id`, RLS policies enforce `tenant_id = current_setting('",[44,883,884],{"class":70},"app",[44,886,176],{"class":57},[44,888,889],{"class":70},"tenant",[44,891,892],{"class":83},"')`, and the app sets `app.tenant` per request. Test that a query with tenant=1 doesn'",[44,894,895],{"class":57},"t see tenant",[44,897,613],{"class":50},[44,899,900],{"class":70},"2",[44,902,903],{"class":83},"'s rows.\n",[44,905,907],{"class":46,"line":906},30,[44,908,718],{"emptyLinePlaceholder":717},[44,910,912],{"class":46,"line":911},31,[44,913,914],{"class":83},"### 19. Query Optimization (EXPLAIN)\n",[44,916,918],{"class":46,"line":917},32,[44,919,718],{"emptyLinePlaceholder":717},[44,921,923],{"class":46,"line":922},33,[44,924,925],{"class":83},"Take a slow query (a 3-table join with a filter), run `EXPLAIN (ANALYZE, BUFFERS)`, identify the bottleneck (seq scan, missing index, bad join order), add an index or rewrite, and measure the improvement.\n",[44,927,929],{"class":46,"line":928},34,[44,930,718],{"emptyLinePlaceholder":717},[44,932,934],{"class":46,"line":933},35,[44,935,936],{"class":83},"### 20. Backup and Restore (administration)\n",[44,938,940],{"class":46,"line":939},36,[44,941,718],{"emptyLinePlaceholder":717},[44,943,945],{"class":46,"line":944},37,[44,946,947],{"class":83},"Take a `pg_dump` of your database, drop a table, restore it from the dump, and verify the data. Then, set up WAL archiving and test point-in-time recovery (restore to a specific timestamp).\n",[44,949,951],{"class":46,"line":950},38,[44,952,718],{"emptyLinePlaceholder":717},[44,954,956],{"class":46,"line":955},39,[44,957,958],{"class":83},"## Pro \u002F Capstone\n",[44,960,962],{"class":46,"line":961},40,[44,963,718],{"emptyLinePlaceholder":717},[44,965,967],{"class":46,"line":966},41,[44,968,969],{"class":83},"### 21. ETL Pipeline (stored procedure, batches)\n",[44,971,973],{"class":46,"line":972},42,[44,974,718],{"emptyLinePlaceholder":717},[44,976,978],{"class":46,"line":977},43,[44,979,980],{"class":83},"Write a stored procedure that archives orders older than N days, in batches of 10000, committing per batch, with progress logging (`RAISE NOTICE`). Test with a million-row table.\n",[44,982,984],{"class":46,"line":983},44,[44,985,718],{"emptyLinePlaceholder":717},[44,987,989],{"class":46,"line":988},45,[44,990,991],{"class":83},"### 22. Analytics Schema (data modeling)\n",[44,993,995],{"class":46,"line":994},46,[44,996,718],{"emptyLinePlaceholder":717},[44,998,1000],{"class":46,"line":999},47,[44,1001,1002],{"class":83},"Design a normalized schema for an e-commerce analytics system: customers, orders, order_items, products, categories (hierarchical), events. Then denormalize a hot query path (e.g., \"customer lifetime spend\") with a materialized view or a trigger-maintained summary column.\n",[44,1004,1006],{"class":46,"line":1005},48,[44,1007,718],{"emptyLinePlaceholder":717},[44,1009,1011],{"class":46,"line":1010},49,[44,1012,1013],{"class":83},"### 23. Job Queue (SKIP LOCKED, transactions)\n",[44,1015,1017],{"class":46,"line":1016},50,[44,1018,718],{"emptyLinePlaceholder":717},[44,1020,1022],{"class":46,"line":1021},51,[44,1023,1024],{"class":83},"Build a database-backed job queue: a `jobs` table, workers grab the next pending job with `FOR UPDATE SKIP LOCKED`, mark it in-progress, process, mark done. Handle worker crashes (stale in-progress jobs) with a timeout.\n",[44,1026,1028],{"class":46,"line":1027},52,[44,1029,718],{"emptyLinePlaceholder":717},[44,1031,1033],{"class":46,"line":1032},53,[44,1034,1035],{"class":83},"### 24. Time-Series Aggregation (date_trunc, BRIN, partitioning)\n",[44,1037,1039],{"class":46,"line":1038},54,[44,1040,718],{"emptyLinePlaceholder":717},[44,1042,1044,1047],{"class":46,"line":1043},55,[44,1045,1046],{"class":83},"Build a time-series table for millions of log events. Partition it by month. Add a BRIN index on the timestamp. Aggregate events per hour with `date_trunc` + `generate_series`. Drop an old partition and observe it'",[44,1048,1049],{"class":57},"s instant.\n",[44,1051,1053],{"class":46,"line":1052},56,[44,1054,718],{"emptyLinePlaceholder":717},[44,1056,1058,1060,1063,1066,1068],{"class":46,"line":1057},57,[44,1059,724],{"class":57},[44,1061,1062],{"class":70},"25",[44,1064,1065],{"class":57},". Full",[44,1067,649],{"class":50},[44,1069,1070],{"class":57},"Stack Search App (FTS, ranking, highlighting)\n",[44,1072,1074],{"class":46,"line":1073},58,[44,1075,718],{"emptyLinePlaceholder":717},[44,1077,1079,1082,1085,1088,1091,1094,1097,1100,1103,1106,1109,1112,1115,1118,1121,1124,1126,1129,1132,1134,1137,1139,1142,1145,1148],{"class":46,"line":1078},59,[44,1080,1081],{"class":57},"Build a search interface ",[44,1083,1084],{"class":50},"over",[44,1086,1087],{"class":57}," a documents ",[44,1089,1090],{"class":50},"table",[44,1092,1093],{"class":57},": support ",[44,1095,1096],{"class":50},"boolean",[44,1098,1099],{"class":57}," queries (",[44,1101,1102],{"class":83},"`postgres & index`",[44,1104,1105],{"class":57},"), phrase queries (",[44,1107,1108],{"class":83},"`full text search`",[44,1110,1111],{"class":57},"), prefix matching (",[44,1113,1114],{"class":83},"`post:*`",[44,1116,1117],{"class":57},"), ranking ",[44,1119,1120],{"class":50},"by",[44,1122,1123],{"class":83}," `ts_rank`",[44,1125,135],{"class":57},[44,1127,1128],{"class":50},"and",[44,1130,1131],{"class":57}," result highlighting ",[44,1133,781],{"class":50},[44,1135,1136],{"class":83}," `ts_headline`",[44,1138,730],{"class":57},[44,1140,1141],{"class":50},"Add",[44,1143,1144],{"class":57}," a trigram fallback ",[44,1146,1147],{"class":50},"for",[44,1149,1150],{"class":57}," substring search.\n",[44,1152,1154],{"class":46,"line":1153},60,[44,1155,718],{"emptyLinePlaceholder":717},[44,1157,1159],{"class":46,"line":1158},61,[44,1160,1161],{"class":57},"## Exercise: Find the Bug\n",[44,1163,1165],{"class":46,"line":1164},62,[44,1166,718],{"emptyLinePlaceholder":717},[44,1168,1170,1173,1176,1178,1181,1184,1187],{"class":46,"line":1169},63,[44,1171,1172],{"class":50},"For",[44,1174,1175],{"class":57}," each query below, find the bug ",[44,1177,1128],{"class":50},[44,1179,1180],{"class":57}," write the fix. (Answers ",[44,1182,1183],{"class":50},"in",[44,1185,1186],{"class":83}," `\u003Cdetails>`",[44,1188,1189],{"class":57},".)\n",[44,1191,1193],{"class":46,"line":1192},64,[44,1194,718],{"emptyLinePlaceholder":717},[44,1196,1198,1201,1204,1207,1210],{"class":46,"line":1197},65,[44,1199,1200],{"class":57},"### A. ",[44,1202,1203],{"class":50},"NULL",[44,1205,1206],{"class":50}," in",[44,1208,1209],{"class":50}," NOT",[44,1211,1212],{"class":50}," IN\n",[44,1214,1216],{"class":46,"line":1215},66,[44,1217,718],{"emptyLinePlaceholder":717},[44,1219,1221,1224,1226,1229,1232,1235],{"class":46,"line":1220},67,[44,1222,1223],{"class":57},"::code",[44,1225,649],{"class":50},[44,1227,1228],{"class":57},"wrapper{",[44,1230,1231],{"class":50},"language=",[44,1233,1234],{"class":83},"\"sql\"",[44,1236,1237],{"class":57},"}\n",[44,1239,1241],{"class":46,"line":1240},68,[44,1242,1243],{"class":83},"```sql\n",[44,1245,1247],{"class":46,"line":1246},69,[44,1248,1249],{"class":83},"SELECT * FROM customers WHERE id NOT IN (SELECT customer_id FROM orders);\n",[14,1251,1252],{},"::",[1254,1255,1256,1260],"details",{},[1257,1258,1259],"summary",{},"Answer",[14,1261,1262,1263,1266,1267,1270,1271,176],{},"If ",[41,1264,1265],{},"orders.customer_id"," has any NULL, ",[41,1268,1269],{},"NOT IN"," returns zero rows. Fix: ",[41,1272,1273],{},"WHERE NOT EXISTS (SELECT 1 FROM orders o WHERE o.customer_id = c.id)",[23,1275,1277],{"id":1276},"b-left-join-demoted","B. LEFT JOIN demoted",[31,1279,1280],{"language":33},[35,1281,1283],{"className":37,"code":1282,"language":33,"meta":39,"style":39},"SELECT c.name, COUNT(o.id) AS n\nFROM customers c LEFT JOIN orders o ON c.id = o.customer_id\nWHERE o.ordered_on >= '2024-01-01'\nGROUP BY c.name;\n",[41,1284,1285,1314,1341,1358],{"__ignoreMap":39},[44,1286,1287,1289,