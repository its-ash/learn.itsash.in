[{"data":1,"prerenderedAt":2299},["ShallowReactive",2],{"page-\u002Fsql\u002F10-data-types-and-null":3},{"id":4,"title":5,"body":6,"description":16,"extension":2293,"meta":2294,"navigation":831,"path":2295,"seo":2296,"stem":2297,"__hash__":2298},"content\u002Fsql\u002F10-data-types-and-null.md","10 — Data Types & NULL Handling",{"type":7,"value":8,"toc":2263},"minimark",[9,13,17,22,343,350,374,382,414,430,434,468,472,478,536,541,588,593,624,642,649,681,685,764,767,771,782,940,957,961,1031,1037,1162,1169,1405,1412,1416,1429,1433,1473,1477,1568,1583,1587,1620,1624,1645,1649,1676,1680,1757,1761,1982,1986,1989,2259],[10,11,5],"h1",{"id":12},"_10-data-types-null-handling",[14,15,16],"p",{},"SQL has rich types and a strict — but surprising — treatment of NULL. NULL is the single biggest source of bugs in SQL. This chapter covers the type system and the three-valued logic that NULL introduces.",[18,19,21],"h2",{"id":20},"core-data-types","Core Data Types",[23,24,25,41],"table",{},[26,27,28],"thead",{},[29,30,31,35,38],"tr",{},[32,33,34],"th",{},"Category",[32,36,37],{},"PostgreSQL types",[32,39,40],{},"Notes",[42,43,44,78,104,122,156,180,215,230,248,269,288,303,321],"tbody",{},[29,45,46,53,72],{},[47,48,49],"td",{},[50,51,52],"strong",{},"Integer",[47,54,55,59,60,63,64,67,68,71],{},[56,57,58],"code",{},"smallint"," (2B), ",[56,61,62],{},"integer","\u002F",[56,65,66],{},"int"," (4B), ",[56,69,70],{},"bigint"," (8B)",[47,73,74,75,77],{},"Exact. Range: e.g. ",[56,76,66],{}," = −2.1B to +2.1B.",[29,79,80,85,94],{},[47,81,82],{},[50,83,84],{},"Decimal",[47,86,87,90,91],{},[56,88,89],{},"numeric(p, s)",", ",[56,92,93],{},"decimal(p, s)",[47,95,96,97,99,100,103],{},"Exact, arbitrary precision. ",[56,98,14],{}," = precision (total digits), ",[56,101,102],{},"s"," = scale (digits after decimal).",[29,105,106,111,119],{},[47,107,108],{},[50,109,110],{},"Floating",[47,112,113,67,116,71],{},[56,114,115],{},"real",[56,117,118],{},"double precision",[47,120,121],{},"Inexact, IEEE 754. Don't use for money.",[29,123,124,129,143],{},[47,125,126],{},[50,127,128],{},"Text",[47,130,131,134,135,138,139,142],{},[56,132,133],{},"text"," (variable, unlimited), ",[56,136,137],{},"varchar(n)"," (variable, max n), ",[56,140,141],{},"char(n)"," (fixed n, padded)",[47,144,145,146,148,149,152,153,155],{},"PostgreSQL's ",[56,147,133],{}," and ",[56,150,151],{},"varchar"," are identical in performance; ",[56,154,137],{}," is a length constraint, not a perf win.",[29,157,158,163,168],{},[47,159,160],{},[50,161,162],{},"Boolean",[47,164,165],{},[56,166,167],{},"boolean",[47,169,170,63,173,63,176,179],{},[56,171,172],{},"TRUE",[56,174,175],{},"FALSE",[56,177,178],{},"NULL",".",[29,181,182,187,204],{},[47,183,184],{},[50,185,186],{},"Date\u002FTime",[47,188,189,90,192,90,195,90,198,90,201],{},[56,190,191],{},"date",[56,193,194],{},"time",[56,196,197],{},"timestamp",[56,199,200],{},"timestamptz",[56,202,203],{},"interval",[47,205,206,207,209,210,214],{},"See chapter 17. ",[56,208,200],{}," stores a timestamp ",[211,212,213],"em",{},"with time zone"," (stored as UTC, displayed in session zone).",[29,216,217,222,227],{},[47,218,219],{},[50,220,221],{},"Binary",[47,223,224],{},[56,225,226],{},"bytea",[47,228,229],{},"Variable-length binary.",[29,231,232,237,242],{},[47,233,234],{},[50,235,236],{},"UUID",[47,238,239],{},[56,240,241],{},"uuid",[47,243,244,245,179],{},"128-bit. Generate with ",[56,246,247],{},"gen_random_uuid()",[29,249,250,255,263],{},[47,251,252],{},[50,253,254],{},"JSON",[47,256,257,90,260],{},[56,258,259],{},"json",[56,261,262],{},"jsonb",[47,264,265,266,268],{},"See chapter 18. ",[56,267,262],{}," is binary, indexable, deduplicated.",[29,270,271,276,285],{},[47,272,273],{},[50,274,275],{},"Array",[47,277,278,90,281,284],{},[56,279,280],{},"int[]",[56,282,283],{},"text[]",", etc.",[47,286,287],{},"PostgreSQL-specific.",[29,289,290,295,300],{},[47,291,292],{},[50,293,294],{},"Enumerated",[47,296,297],{},[56,298,299],{},"enum",[47,301,302],{},"Static set of labels.",[29,304,305,310,318],{},[47,306,307],{},[50,308,309],{},"Bit",[47,311,312,90,315],{},[56,313,314],{},"bit(n)",[56,316,317],{},"bit varying(n)",[47,319,320],{},"Bit strings. Rare.",[29,322,323,328,333],{},[47,324,325],{},[50,326,327],{},"Money",[47,329,330],{},[56,331,332],{},"money",[47,334,335,336,339,340,179],{},"Don't use — it's a locale-dependent wrapper around ",[56,337,338],{},"numeric",". Use ",[56,341,342],{},"numeric(p, 2)",[344,345,347,349],"h3",{"id":346},"numeric-vs-floating-point",[56,348,338],{}," vs floating-point",[14,351,352,354,355,358,359,362,363,63,365,367,368,339,371,373],{},[56,353,338],{}," is ",[50,356,357],{},"exact"," — ",[56,360,361],{},"0.1 + 0.2 = 0.3",", always. Floating-point (",[56,364,115],{},[56,366,118],{},") is inexact — ",[56,369,370],{},"0.1::float + 0.2::float = 0.30000000000000004",[56,372,338],{}," for money, scientific computations needing exact decimals, and anything where rounding errors are unacceptable. Use floats for approximate scientific work and when storage\u002Fspeed matter more than exactness.",[344,375,377,379,380],{"id":376},"varcharn-vs-text",[56,378,137],{}," vs ",[56,381,133],{},[14,383,384,385,148,387,389,390,392,393,395,396,399,400,402,403,405,406,409,410,413],{},"In PostgreSQL, ",[56,386,133],{},[56,388,151],{}," (no length limit) are identical — there's no performance difference, and ",[56,391,137],{}," doesn't save storage (the storage is variable-length either way). ",[56,394,137],{}," is just a ",[56,397,398],{},"CHECK (length(col) \u003C= n)"," constraint. Use ",[56,401,133],{}," by default; use ",[56,404,137],{}," when you have a real business-rule length limit (e.g., ISO country codes = ",[56,407,408],{},"char(2)"," or ",[56,411,412],{},"varchar(2)",").",[14,415,416,418,419,422,423,426,427,429],{},[56,417,141],{}," pads with spaces to width ",[56,420,421],{},"n",". This padding causes subtle comparison bugs (",[56,424,425],{},"'NY' = 'NY  '"," may be true or false depending on the engine and collation). Avoid ",[56,428,141],{}," except for truly fixed-width codes.",[18,431,433],{"id":432},"null-the-absence-of-value","NULL — The Absence of Value",[14,435,436,438,439,442,443,90,446,449,450,452,453,456,457,90,459,461,462,465,466,413],{},[56,437,178],{}," means \"unknown\" or \"not applicable\" — it is ",[50,440,441],{},"not"," the same as ",[56,444,445],{},"0",[56,447,448],{},"''"," (empty string), or ",[56,451,175],{},". SQL uses ",[50,454,455],{},"three-valued logic (3VL)",": every comparison evaluates to ",[56,458,172],{},[56,460,175],{},", or ",[56,463,464],{},"UNKNOWN"," (also called ",[56,467,178],{},[344,469,471],{"id":470},"the-truth-tables","The truth tables",[14,473,474,477],{},[50,475,476],{},"AND",":",[23,479,480,493],{},[26,481,482],{},[29,483,484,487,490],{},[32,485,486],{},"A",[32,488,489],{},"B",[32,491,492],{},"A AND B",[42,494,495,503,511,519,528],{},[29,496,497,499,501],{},[47,498,172],{},[47,500,172],{},[47,502,172],{},[29,504,505,507,509],{},[47,506,172],{},[47,508,175],{},[47,510,175],{},[29,512,513,515,517],{},[47,514,172],{},[47,516,464],{},[47,518,464],{},[29,520,521,523,526],{},[47,522,175],{},[47,524,525],{},"*",[47,527,175],{},[29,529,530,532,534],{},[47,531,464],{},[47,533,464],{},[47,535,464],{},[14,537,538,477],{},[50,539,540],{},"OR",[23,542,543,554],{},[26,544,545],{},[29,546,547,549,551],{},[32,548,486],{},[32,550,489],{},[32,552,553],{},"A OR B",[42,555,556,564,572,580],{},[29,557,558,560,562],{},[47,559,172],{},[47,561,525],{},[47,563,172],{},[29,565,566,568,570],{},[47,567,175],{},[47,569,175],{},[47,571,175],{},[29,573,574,576,578],{},[47,575,175],{},[47,577,464],{},[47,579,464],{},[29,581,582,584,586],{},[47,583,464],{},[47,585,464],{},[47,587,464],{},[14,589,590,477],{},[50,591,592],{},"NOT",[23,594,595,604],{},[26,596,597],{},[29,598,599,601],{},[32,600,486],{},[32,602,603],{},"NOT A",[42,605,606,612,618],{},[29,607,608,610],{},[47,609,172],{},[47,611,175],{},[29,613,614,616],{},[47,615,175],{},[47,617,172],{},[29,619,620,622],{},[47,621,464],{},[47,623,464],{},[14,625,626,627,630,631,634,635,638,639,179],{},"Key insight: ",[56,628,629],{},"FALSE AND UNKNOWN = FALSE"," (one false makes the AND false regardless of the unknown), but ",[56,632,633],{},"TRUE AND UNKNOWN = UNKNOWN"," (the unknown could still be false). Symmetrically, ",[56,636,637],{},"TRUE OR UNKNOWN = TRUE",", but ",[56,640,641],{},"FALSE OR UNKNOWN = UNKNOWN",[344,643,645,648],{"id":644},"where-keeps-only-true",[56,646,647],{},"WHERE"," keeps only TRUE",[14,650,651,653,654,656,657,659,660,659,663,665,666,669,670,354,673,675,676,678,679,179],{},[56,652,647],{}," retains rows where the condition is ",[50,655,172],{},". Rows where it's ",[56,658,175],{}," ",[211,661,662],{},"or",[56,664,464],{}," are discarded. This is why ",[56,667,668],{},"WHERE col = NULL"," returns nothing — ",[56,671,672],{},"col = NULL",[56,674,464],{},", and ",[56,677,464],{}," is not ",[56,680,172],{},[344,682,684],{"id":683},"null-comparisons","NULL comparisons",[686,687,689],"code-wrapper",{"language":688},"sql",[690,691,695],"pre",{"className":692,"code":693,"language":688,"meta":694,"style":694},"language-sql shiki shiki-themes github-light github-dark","NULL  = NULL    -- UNKNOWN (not TRUE!)\nNULL \u003C> NULL    -- UNKNOWN (not TRUE!)\nNULL  = 5       -- UNKNOWN\nNULL \u003C> 5       -- UNKNOWN\nNULL  > 5       -- UNKNOWN\n","",[56,696,697,715,727,741,752],{"__ignoreMap":694},[698,699,702,705,708,711],"span",{"class":700,"line":701},"line",1,[698,703,178],{"class":704},"svdQ7",[698,706,707],{"class":704},"  =",[698,709,710],{"class":704}," NULL",[698,712,714],{"class":713},"sdCPZ","    -- UNKNOWN (not TRUE!)\n",[698,716,718,720,723,725],{"class":700,"line":717},2,[698,719,178],{"class":704},[698,721,722],{"class":704}," \u003C>",[698,724,710],{"class":704},[698,726,714],{"class":713},[698,728,730,732,734,738],{"class":700,"line":729},3,[698,731,178],{"class":704},[698,733,707],{"class":704},[698,735,737],{"class":736},"snvgF"," 5",[698,739,740],{"class":713},"       -- UNKNOWN\n",[698,742,744,746,748,750],{"class":700,"line":743},4,[698,745,178],{"class":704},[698,747,722],{"class":704},[698,749,737],{"class":736},[698,751,740],{"class":713},[698,753,755,757,760,762],{"class":700,"line":754},5,[698,756,178],{"class":704},[698,758,759],{"class":704},"  >",[698,761,737],{"class":736},[698,763,740],{"class":713},[14,765,766],{},"Two NULLs are not \"equal\" — they're both \"unknown,\" and whether they're the same unknown value is... unknown. This is the core of 3VL and the source of most NULL bugs.",[18,768,770],{"id":769},"testing-for-null","Testing for NULL",[14,772,773,774,777,778,781],{},"Use ",[56,775,776],{},"IS NULL"," \u002F ",[56,779,780],{},"IS NOT NULL"," — these are the only NULL tests that return TRUE\u002FFALSE (never UNKNOWN):",[686,783,784],{"language":688},[690,785,787],{"className":692,"code":786,"language":688,"meta":694,"style":694},"WHERE col IS NULL      -- TRUE when col is NULL\nWHERE col IS NOT NULL  -- TRUE when col is not NULL\n``\n::\n\n## NULL-Safe Equality: `IS NOT DISTINCT FROM`\n\n`IS NOT DISTINCT FROM` treats NULLs as equal to NULL:\n\n::code-wrapper{language=\"sql\"}\n```sql\nNULL IS NOT DISTINCT FROM NULL   -- TRUE\nNULL IS DISTINCT FROM NULL       -- FALSE\n5   IS NOT DISTINCT FROM 5       -- TRUE\n5   IS DISTINCT FROM 6           -- TRUE\n``\n",[56,788,789,805,816,822,827,833,848,853,879,884,905,911,917,923,929,935],{"__ignoreMap":694},[698,790,791,793,797,800,802],{"class":700,"line":701},[698,792,647],{"class":704},[698,794,796],{"class":795},"ssxIu"," col ",[698,798,799],{"class":704},"IS",[698,801,710],{"class":704},[698,803,804],{"class":713},"      -- TRUE when col is NULL\n",[698,806,807,809,811,813],{"class":700,"line":717},[698,808,647],{"class":704},[698,810,796],{"class":795},[698,812,780],{"class":704},[698,814,815],{"class":713},"  -- TRUE when col is not NULL\n",[698,817,818],{"class":700,"line":729},[698,819,821],{"class":820},"sJ6F3","``\n",[698,823,824],{"class":700,"line":743},[698,825,826],{"class":795},"::\n",[698,828,829],{"class":700,"line":754},[698,830,832],{"emptyLinePlaceholder":831},true,"\n",[698,834,836,839,842,845],{"class":700,"line":835},6,[698,837,838],{"class":795},"## ",[698,840,841],{"class":704},"NULL-Safe",[698,843,844],{"class":795}," Equality: ",[698,846,847],{"class":820},"`IS NOT DISTINCT FROM`\n",[698,849,851],{"class":700,"line":850},7,[698,852,832],{"emptyLinePlaceholder":831},[698,854,856,859,862,865,868,871,874,876],{"class":700,"line":855},8,[698,857,858],{"class":820},"`IS NOT DISTINCT FROM`",[698,860,861],{"class":795}," treats ",[698,863,864],{"class":704},"NULLs",[698,866,867],{"class":704}," as",[698,869,870],{"class":795}," equal ",[698,872,873],{"class":704},"to",[698,875,710],{"class":704},[698,877,878],{"class":795},":\n",[698,880,882],{"class":700,"line":881},9,[698,883,832],{"emptyLinePlaceholder":831},[698,885,887,890,893,896,899,902],{"class":700,"line":886},10,[698,888,889],{"class":795},"::code",[698,891,892],{"class":704},"-",[698,894,895],{"class":795},"wrapper{",[698,897,898],{"class":704},"language=",[698,900,901],{"class":820},"\"sql\"",[698,903,904],{"class":795},"}\n",[698,906,908],{"class":700,"line":907},11,[698,909,910],{"class":820},"```sql\n",[698,912,914],{"class":700,"line":913},12,[698,915,916],{"class":820},"NULL IS NOT DISTINCT FROM NULL   -- TRUE\n",[698,918,920],{"class":700,"line":919},13,[698,921,922],{"class":820},"NULL IS DISTINCT FROM NULL       -- FALSE\n",[698,924,926],{"class":700,"line":925},14,[698,927,928],{"class":820},"5   IS NOT DISTINCT FROM 5       -- TRUE\n",[698,930,932],{"class":700,"line":931},15,[698,933,934],{"class":820},"5   IS DISTINCT FROM 6           -- TRUE\n",[698,936,938],{"class":700,"line":937},16,[698,939,821],{"class":820},[14,941,942,943,946,947,950,951,953,954,956],{},"It's the \"null-safe ",[56,944,945],{},"=","\" \u002F \"null-safe ",[56,948,949],{},"\u003C>",".\" Use it in joins where NULL keys should match, and in ",[56,952,647],{}," when \"not equal\" should include NULLs as a distinct value. Caveat: it can't use a plain B-tree index (the planner must evaluate the expression per row), so it's slower than ",[56,955,945],{}," on indexed columns.",[18,958,960],{"id":959},"null-handling-functions","NULL-Handling Functions",[23,962,963,973],{},[26,964,965],{},[29,966,967,970],{},[32,968,969],{},"Function",[32,971,972],{},"Behavior",[42,974,975,985,1003,1020],{},[29,976,977,982],{},[47,978,979],{},[56,980,981],{},"COALESCE(a, b, c, ...)",[47,983,984],{},"Returns the first non-NULL argument; NULL if all are NULL.",[29,986,987,992],{},[47,988,989],{},[56,990,991],{},"NULLIF(a, b)",[47,993,994,995,998,999,1002],{},"Returns NULL if ",[56,996,997],{},"a = b",", else ",[56,1000,1001],{},"a",". Idiom for avoiding divide-by-zero.",[29,1004,1005,1013],{},[47,1006,1007,777,1010],{},[56,1008,1009],{},"GREATEST(a, b, ...)",[56,1011,1012],{},"LEAST(a, b, ...)",[47,1014,1015,1016,1019],{},"Max\u002Fmin, but return NULL if ",[50,1017,1018],{},"any"," argument is NULL (PostgreSQL behavior).",[29,1021,1022,1028],{},[47,1023,1024,1027],{},[56,1025,1026],{},"a OR b"," (with NULLs)",[47,1029,1030],{},"See truth table above.",[344,1032,1034],{"id":1033},"coalesce",[56,1035,1036],{},"COALESCE",[686,1038,1039],{"language":688},[690,1040,1042],{"className":692,"code":1041,"language":688,"meta":694,"style":694},"-- Provide a fallback for missing values\nSELECT name, COALESCE(city, 'Unknown') AS city FROM customers;\n\n-- Provide multiple fallbacks\nSELECT COALESCE(preferred_name, full_name, email) AS display_name FROM users;\n\n-- Default a sum to 0 (SUM of no rows is NULL)\nSELECT COALESCE(SUM(amount), 0) AS total FROM orders WHERE customer_id = 999;\n",[56,1043,1044,1049,1082,1086,1091,1111,1115,1120],{"__ignoreMap":694},[698,1045,1046],{"class":700,"line":701},[698,1047,1048],{"class":713},"-- Provide a fallback for missing values\n",[698,1050,1051,1054,1057,1059,1061,1064,1067,1070,1073,1076,1079],{"class":700,"line":717},[698,1052,1053],{"class":704},"SELECT",[698,1055,1056],{"class":704}," name",[698,1058,90],{"class":795},[698,1060,1036],{"class":736},[698,1062,1063],{"class":795},"(city, ",[698,1065,1066],{"class":820},"'Unknown'",[698,1068,1069],{"class":795},") ",[698,1071,1072],{"class":704},"AS",[698,1074,1075],{"class":795}," city ",[698,1077,1078],{"class":704},"FROM",[698,1080,1081],{"class":795}," customers;\n",[698,1083,1084],{"class":700,"line":729},[698,1085,832],{"emptyLinePlaceholder":831},[698,1087,1088],{"class":700,"line":743},[698,1089,1090],{"class":713},"-- Provide multiple fallbacks\n",[698,1092,1093,1095,1098,1101,1103,1106,1108],{"class":700,"line":754},[698,1094,1053],{"class":704},[698,1096,1097],{"class":736}," COALESCE",[698,1099,1100],{"class":795},"(preferred_name, full_name, email) ",[698,1102,1072],{"class":704},[698,1104,1105],{"class":795}," display_name ",[698,1107,1078],{"class":704},[698,1109,1110],{"class":795}," users;\n",[698,1112,1113],{"class":700,"line":835},[698,1114,832],{"emptyLinePlaceholder":831},[698,1116,1117],{"class":700,"line":850},[698,1118,1119],{"class":713},"-- Default a sum to 0 (SUM of no rows is NULL)\n",[698,1121,1122,1124,1126,1129,1132,1135,1137,1139,1141,1144,1146,1149,1151,1154,1156,1159],{"class":700,"line":855},[698,1123,1053],{"class":704},[698,1125,1097],{"class":736},[698,1127,1128],{"class":795},"(",[698,1130,1131],{"class":736},"SUM",[698,1133,1134],{"class":795},"(amount), ",[698,1136,445],{"class":736},[698,1138,1069],{"class":795},[698,1140,1072],{"class":704},[698,1142,1143],{"class":795}," total ",[698,1145,1078],{"class":704},[698,1147,1148],{"class":795}," orders ",[698,1150,647],{"class":704},[698,1152,1153],{"class":795}," customer_id ",[698,1155,945],{"class":704},[698,1157,1158],{"class":736}," 999",[698,1160,1161],{"class":795},";\n",[344,1163,1165,1168],{"id":1164},"nullif-the-divide-by-zero-fix",[56,1166,1167],{},"NULLIF"," — the divide-by-zero fix",[686,1170,1171],{"language":688},[690,1172,1174],{"className":692,"code":1173,"language":688,"meta":694,"style":694},"-- ❌ Division by zero if any total is 0\nSELECT sales \u002F total FROM metrics;\n\n-- ✅ NULLIF turns 0 into NULL; division by NULL yields NULL (not an error)\nSELECT sales \u002F NULLIF(total, 0) AS ratio FROM metrics;\n\n-- Then COALESCE the NULL result if you want 0 or some sentinel\nSELECT COALESCE(sales \u002F NULLIF(total, 0), 0) AS ratio FROM metrics;\n``\n::\n\n## NULL in Aggregates\n\nAggregates **ignore NULL** (except `COUNT(*)`):\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- AVG ignores NULLs: AVG of [10, 20, NULL] = 15, not 10\nSELECT AVG(amount) FROM orders;\n\n-- COUNT(*) counts rows; COUNT(col) counts non-NULL values\nSELECT COUNT(*), COUNT(amount) FROM orders;\n\n-- SUM of all-NULL is NULL, not 0\nSELECT SUM(amount) FROM orders WHERE FALSE;   -- NULL\nSELECT COALESCE(SUM(amount), 0) FROM orders WHERE FALSE;   -- 0\n``\n",[56,1175,1176,1181,1197,1201,1206,1233,1237,1242,1274,1278,1282,1286,1298,1302,1325,1329,1343,1348,1354,1360,1365,1371,1377,1382,1388,1394,1400],{"__ignoreMap":694},[698,1177,1178],{"class":700,"line":701},[698,1179,1180],{"class":713},"-- ❌ Division by zero if any total is 0\n",[698,1182,1183,1185,1188,1190,1192,1194],{"class":700,"line":717},[698,1184,1053],{"class":704},[698,1186,1187],{"class":795}," sales ",[698,1189,63],{"class":704},[698,1191,1143],{"class":795},[698,1193,1078],{"class":704},[698,1195,1196],{"class":795}," metrics;\n",[698,1198,1199],{"class":700,"line":729},[698,1200,832],{"emptyLinePlaceholder":831},[698,1202,1203],{"class":700,"line":743},[698,1204,1205],{"class":713},"-- ✅ NULLIF turns 0 into NULL; division by NULL yields NULL (not an error)\n",[698,1207,1208,1210,1212,1214,1217,1220,1222,1224,1226,1229,1231],{"class":700,"line":754},[698,1209,1053],{"class":704},[698,1211,1187],{"class":795},[698,1213,63],{"class":704},[698,1215,1216],{"class":736}," NULLIF",[698,1218,1219],{"class":795},"(total, ",[698,1221,445],{"class":736},[698,1223,1069],{"class":795},[698,1225,1072],{"class":704},[698,1227,1228],{"class":795}," ratio ",[698,1230,1078],{"class":704},[698,1232,1196],{"class":795},[698,1234,1235],{"class":700,"line":835},[698,1236,832],{"emptyLinePlaceholder":831},[698,1238,1239],{"class":700,"line":850},[698,1240,1241],{"class":713},"-- Then COALESCE the NULL result if you want 0 or some sentinel\n",[698,1243,1244,1246,1248,1251,1253,1255,1257,1259,1262,1264,1266,1268,1270,1272],{"class":700,"line":855},[698,1245,1053],{"class":704},[698,1247,1097],{"class":736},[698,1249,1250],{"class":795},"(sales ",[698,1252,63],{"class":704},[698,1254,1216],{"class":736},[698,1256,1219],{"class":795},[698,1258,445],{"class":736},[698,1260,1261],{"class":795},"), ",[698,1263,445],{"class":736},[698,1265,1069],{"class":795},[698,1267,1072],{"class":704},[698,1269,1228],{"class":795},[698,1271,1078],{"class":704},[698,1273,1196],{"class":795},[698,1275,1276],{"class":700,"line":881},[698,1277,821],{"class":820},[698,1279,1280],{"class":700,"line":886},[698,1281,826],{"class":795},[698,1283,1284],{"class":700,"line":907},[698,1285,832],{"emptyLinePlaceholder":831},[698,1287,1288,1290,1292,1295],{"class":700,"line":913},[698,1289,838],{"class":795},[698,1291,178],{"class":704},[698,1293,1294],{"class":704}," in",[698,1296,1297],{"class":795}," Aggregates\n",[698,1299,1300],{"class":700,"line":919},[698,1301,832],{"emptyLinePlaceholder":831},[698,1303,1304,1307,1310,1313,1316,1319,1322],{"class":700,"line":925},[698,1305,1306],{"class":795},"Aggregates ",[698,1308,1309],{"class":704},"**ignore",[698,1311,1312],{"class":704}," NULL**",[698,1314,1315],{"class":795}," (",[698,1317,1318],{"class":704},"except",[698,1320,1321],{"class":820}," `COUNT(*)`",[698,1323,1324],{"class":795},"):\n",[698,1326,1327],{"class":700,"line":931},[698,1328,832],{"emptyLinePlaceholder":831},[698,1330,1331,1333,1335,1337,1339,1341],{"class":700,"line":937},[698,1332,889],{"class":795},[698,1334,892],{"class":704},[698,1336,895],{"class":795},[698,1338,898],{"class":704},[698,1340,901],{"class":820},[698,1342,904],{"class":795},[698,1344,1346],{"class":700,"line":1345},17,[698,1347,910],{"class":820},[698,1349,1351],{"class":700,"line":1350},18,[698,1352,1353],{"class":820},"-- AVG ignores NULLs: AVG of [10, 20, NULL] = 15, not 10\n",[698,1355,1357],{"class":700,"line":1356},19,[698,1358,1359],{"class":820},"SELECT AVG(amount) FROM orders;\n",[698,1361,1363],{"class":700,"line":1362},20,[698,1364,832],{"emptyLinePlaceholder":831},[698,1366,1368],{"class":700,"line":1367},21,[698,1369,1370],{"class":820},"-- COUNT(*) counts rows; COUNT(col) counts non-NULL values\n",[698,1372,1374],{"class":700,"line":1373},22,[698,1375,1376],{"class":820},"SELECT COUNT(*), COUNT(amount) FROM orders;\n",[698,1378,1380],{"class":700,"line":1379},23,[698,1381,832],{"emptyLinePlaceholder":831},[698,1383,1385],{"class":700,"line":1384},24,[698,1386,1387],{"class":820},"-- SUM of all-NULL is NULL, not 0\n",[698,1389,1391],{"class":700,"line":1390},25,[698,1392,1393],{"class":820},"SELECT SUM(amount) FROM orders WHERE FALSE;   -- NULL\n",[698,1395,1397],{"class":700,"line":1396},26,[698,1398,1399],{"class":820},"SELECT COALESCE(SUM(amount), 0) FROM orders WHERE FALSE;   -- 0\n",[698,1401,1403],{"class":700,"line":1402},27,[698,1404,821],{"class":820},[14,1406,1407,1408,1411],{},"This is usually what you want (averaging non-missing values), but it's a trap if you expected NULL to count as 0. Use ",[56,1409,1410],{},"AVG(COALESCE(amount, 0))"," if NULL means \"zero\" — but ask whether that's semantically right first.",[18,1413,1415],{"id":1414},"null-in-order-by","NULL in ORDER BY",[14,1417,1418,1419,63,1422,1425,1426,1428],{},"NULL sorts either first or last depending on the engine (see chapter 03). Use ",[56,1420,1421],{},"NULLS FIRST",[56,1423,1424],{},"NULLS LAST"," (PostgreSQL) or the ",[56,1427,776],{}," trick for portable control.",[18,1430,1432],{"id":1431},"null-in-constraints","NULL in Constraints",[1434,1435,1436,1443,1456,1467],"ul",{},[1437,1438,1439,1442],"li",{},[56,1440,1441],{},"NOT NULL"," — the column can't be NULL. The most important constraint; add it to every column unless you have a reason not to.",[1437,1444,1445,358,1448,1451,1452,1455],{},[56,1446,1447],{},"UNIQUE",[50,1449,1450],{},"allows multiple NULLs"," in PostgreSQL and the SQL standard (NULLs aren't \"equal,\" so they don't violate uniqueness). MySQL with ",[56,1453,1454],{},"InnoDB"," also allows multiple NULLs. SQL Server allows one NULL. Be aware of this divergence.",[1437,1457,1458,1461,1462,148,1464,1466],{},[56,1459,1460],{},"PRIMARY KEY"," — implies ",[56,1463,1441],{},[56,1465,1447],{},". A PK column can never be NULL.",[1437,1468,1469,1472],{},[56,1470,1471],{},"FOREIGN KEY"," — a NULL FK value is allowed and means \"no reference\" (it doesn't violate the FK constraint). This is how optional relationships are modeled.",[18,1474,1476],{"id":1475},"null-in-boolean-contexts","NULL in Boolean Contexts",[686,1478,1479],{"language":688},[690,1480,1482],{"className":692,"code":1481,"language":688,"meta":694,"style":694},"-- In WHERE, NULL is treated as \"not true\" (excluded)\nWHERE col           -- keeps rows where col IS TRUE (NULL and FALSE excluded)\nWHERE NOT col       -- keeps rows where col IS FALSE (NULL and TRUE excluded) — NULL is NOT excluded!\nWHERE col = TRUE    -- keeps only TRUE\nWHERE col IS TRUE   -- keeps only TRUE (clearer)\nWHERE col IS FALSE  -- keeps only FALSE\nWHERE col IS UNKNOWN -- keeps only NULL\n",[56,1483,1484,1489,1499,1512,1526,1540,1554],{"__ignoreMap":694},[698,1485,1486],{"class":700,"line":701},[698,1487,1488],{"class":713},"-- In WHERE, NULL is treated as \"not true\" (excluded)\n",[698,1490,1491,1493,1496],{"class":700,"line":717},[698,1492,647],{"class":704},[698,1494,1495],{"class":795}," col           ",[698,1497,1498],{"class":713},"-- keeps rows where col IS TRUE (NULL and FALSE excluded)\n",[698,1500,1501,1503,1506,1509],{"class":700,"line":729},[698,1502,647],{"class":704},[698,1504,1505],{"class":704}," NOT",[698,1507,1508],{"class":795}," col       ",[698,1510,1511],{"class":713},"-- keeps rows where col IS FALSE (NULL and TRUE excluded) — NULL is NOT excluded!\n",[698,1513,1514,1516,1518,1520,1523],{"class":700,"line":743},[698,1515,647],{"class":704},[698,1517,796],{"class":795},[698,1519,945],{"class":704},[698,1521,1522],{"class":795}," TRUE    ",[698,1524,1525],{"class":713},"-- keeps only TRUE\n",[698,1527,1528,1530,1532,1534,1537],{"class":700,"line":754},[698,1529,647],{"class":704},[698,1531,796],{"class":795},[698,1533,799],{"class":704},[698,1535,1536],{"class":795}," TRUE   ",[698,1538,1539],{"class":713},"-- keeps only TRUE (clearer)\n",[698,1541,1542,1544,1546,1548,1551],{"class":700,"line":835},[698,1543,647],{"class":704},[698,1545,796],{"class":795},[698,1547,799],{"class":704},[698,1549,1550],{"class":795}," FALSE  ",[698,1552,1553],{"class":713},"-- keeps only FALSE\n",[698,1555,1556,1558,1560,1562,1565],{"class":700,"line":850},[698,1557,647],{"class":704},[698,1559,796],{"class":795},[698,1561,799],{"class":704},[698,1563,1564],{"class":795}," UNKNOWN ",[698,1566,1567],{"class":713},"-- keeps only NULL\n",[14,1569,1570,1573,1574,354,1576,1578,1579,1582],{},[56,1571,1572],{},"WHERE NOT col"," excludes NULLs — because ",[56,1575,1441],{},[56,1577,178],{}," (UNKNOWN), which isn't TRUE. This is a subtle trap: \"not true\" in English feels like it should include NULL, but ",[56,1580,1581],{},"NOT col"," in SQL doesn't.",[18,1584,1586],{"id":1585},"null-and-set-operations","NULL and Set Operations",[14,1588,1589,1590,90,1593,90,1596,1599,1600,1603,1604,148,1607,1609,1610,1612,1613,1616,1617,1619],{},"Set operations (",[56,1591,1592],{},"UNION",[56,1594,1595],{},"INTERSECT",[56,1597,1598],{},"EXCEPT",") treat NULLs as ",[50,1601,1602],{},"equal"," for deduplication — ",[56,1605,1606],{},"(1, NULL)",[56,1608,1606],{}," are considered duplicates, and ",[56,1611,1592],{}," keeps one. This differs from ",[56,1614,1615],{},"NULL = NULL"," being UNKNOWN in ",[56,1618,647],{},". The set ops use \"is not distinct from\" semantics internally.",[18,1621,1623],{"id":1622},"null-and-joins","NULL and Joins",[14,1625,1626,1627,1630,1631,1633,1634,1637,1638,1640,1641,1644],{},"A join ",[56,1628,1629],{},"ON a.col = b.col"," does ",[50,1632,441],{}," match rows where both ",[56,1635,1636],{},"col","s are NULL — ",[56,1639,1615],{}," is UNKNOWN, not TRUE. If you need NULL keys to match, use ",[56,1642,1643],{},"IS NOT DISTINCT FROM"," (slower, no index) or reconsider your schema (use a sentinel value, or split the table).",[18,1646,1648],{"id":1647},"null-and-not-in-the-killer-trap","NULL and NOT IN (the killer trap)",[14,1650,1651,354,1654,1657,1658,1657,1661,1663,1664,1667,1668,1671,1672,1675],{},[56,1652,1653],{},"x NOT IN (a, b, NULL)",[56,1655,1656],{},"x \u003C> a AND x \u003C> b AND x \u003C> NULL"," = ",[56,1659,1660],{},"... AND UNKNOWN",[56,1662,464],{}," for every ",[56,1665,1666],{},"x",". The ",[50,1669,1670],{},"entire query returns zero rows",". See chapter 06. Use ",[56,1673,1674],{},"NOT EXISTS"," or filter NULLs.",[18,1677,1679],{"id":1678},"tips-tricks","💡 Tips & Tricks",[1434,1681,1682,1695,1708,1722,1744],{},[1437,1683,1684,1687,1688,1690,1691,1694],{},[50,1685,1686],{},"Idiom",": mark every column ",[56,1689,1441],{}," unless you have a ",[211,1692,1693],{},"specific"," reason to allow NULL — most \"optional\" columns have a natural default (0, '', false) that's safer than NULL. NULLs infect every comparison, aggregate, and join; the fewer the better.",[1437,1696,1697,1699,1700,1703,1704,1707],{},[50,1698,1686],{},": use ",[56,1701,1702],{},"NULLIF(x, 0)"," everywhere you divide by a column that could be 0 — it converts the 0 to NULL, making the division yield NULL instead of throwing \"division by zero.\" Wrap in ",[56,1705,1706],{},"COALESCE(..., 0)"," if you need a numeric result.",[1437,1709,1710,1712,1713,1715,1716,1718,1719,179],{},[50,1711,1686],{},": prefer ",[56,1714,1643],{}," over ",[56,1717,945],{}," when comparing nullable columns where NULL should match NULL — but be aware it's slower (no index). For indexed equality with NULLs, consider splitting the predicate: ",[56,1720,1721],{},"WHERE (a = b OR (a IS NULL AND b IS NULL))",[1437,1723,1724,1727,1728,90,1730,675,1733,1736,1737,1739,1740,1743],{},[50,1725,1726],{},"Debug",": when a query returns fewer rows than expected, audit every ",[56,1729,949],{},[56,1731,1732],{},"!=",[56,1734,1735],{},"NOT IN"," — these silently drop NULLs. Replace ",[56,1738,949],{}," with ",[56,1741,1742],{},"IS DISTINCT FROM"," if NULL is a meaningful \"other\" value.",[1437,1745,1746,1749,1750,1752,1753,1756],{},[50,1747,1748],{},"Portability",": ",[56,1751,1447],{}," constraint with NULLs is engine-dependent (standard: multiple NULLs allowed; SQL Server: one NULL). If you need \"at most one non-NULL value per group\" portably, use a partial unique index: ",[56,1754,1755],{},"CREATE UNIQUE INDEX ON t(col) WHERE col IS NOT NULL"," (PostgreSQL\u002FSQLite).",[18,1758,1760],{"id":1759},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1434,1762,1763,1776,1800,1823,1838,1852,1863,1886,1915,1943,1967],{},[1437,1764,1765,1770,1771,1773,1774,179],{},[50,1766,1767,1769],{},[56,1768,1615],{}," is UNKNOWN, not TRUE",": the #1 NULL gotcha. Never compare to NULL with ",[56,1772,945],{},"; use ",[56,1775,776],{},[1437,1777,1778,1749,1784,1657,1787,1657,1790,1792,1793,148,1796,1799],{},[50,1779,1780,1783],{},[56,1781,1782],{},"NOT (col = 5)"," excludes NULLs",[56,1785,1786],{},"NOT (NULL = 5)",[56,1788,1789],{},"NOT UNKNOWN",[56,1791,464],{}," ≠ TRUE. So ",[56,1794,1795],{},"WHERE col \u003C> 5",[56,1797,1798],{},"WHERE NOT (col = 5)"," both drop NULL rows.",[1437,1801,1802,1749,1812,1815,1816,1818,1819,1822],{},[50,1803,1804,1807,1808,1811],{},[56,1805,1806],{},"COUNT(col)"," ignores NULLs, ",[56,1809,1810],{},"COUNT(*)"," doesn't",[56,1813,1814],{},"COUNT(amount)"," may be less than ",[56,1817,1810],{}," if ",[56,1820,1821],{},"amount"," has NULLs. Pick deliberately.",[1437,1824,1825,1749,1831,1834,1835,1837],{},[50,1826,1827,1830],{},[56,1828,1829],{},"AVG"," ignores NULLs, doesn't average them as 0",[56,1832,1833],{},"AVG([10, 20, NULL])"," = 15. If NULL means 0, ",[56,1836,1410],{}," = 10.",[1437,1839,1840,1749,1845,1847,1848,1851],{},[50,1841,1842,1844],{},[56,1843,1131],{}," of all-NULL is NULL",[56,1846,1131],{}," over an empty or all-NULL set is NULL, not 0. ",[56,1849,1850],{},"COALESCE(SUM(x), 0)"," for 0.",[1437,1853,1854,1859,1860,1862],{},[50,1855,1856,1858],{},[56,1857,1447],{}," allows multiple NULLs"," (in most engines): a ",[56,1861,1447],{}," constraint on a nullable column permits many rows with NULL — NULLs aren't \"equal.\" Use a partial index if you need \"at most one NULL.\"",[1437,1864,1865,1874,1875,1878,1879,409,1882,1885],{},[50,1866,1867,63,1870,1873],{},[56,1868,1869],{},"GREATEST",[56,1871,1872],{},"LEAST"," return NULL if any arg is NULL"," (PostgreSQL): ",[56,1876,1877],{},"GREATEST(5, NULL)"," = NULL. Use ",[56,1880,1881],{},"GREATEST(COALESCE(a, -1), COALESCE(b, -1))",[56,1883,1884],{},"MAX(a, b)"," in a custom function if you want NULL ignored.",[1437,1887,1888,1749,1891,1657,1894,1896,1897,1900,1901,1904,1905,354,1908,1910,1911,1914],{},[50,1889,1890],{},"String concatenation with NULL",[56,1892,1893],{},"'hello' || NULL",[56,1895,178],{}," (in PostgreSQL and standard SQL). The whole concatenation becomes NULL. Use ",[56,1898,1899],{},"CONCAT(a, b)"," (ignores NULLs) or ",[56,1902,1903],{},"COALESCE(a, '') || COALESCE(b, '')",". MySQL's ",[56,1906,1907],{},"||",[56,1909,540],{}," by default (not concat) unless ",[56,1912,1913],{},"PIPES_AS_CONCAT"," is set.",[1437,1916,1917,1925,1926,1929,1930,1933,1934,63,1936,63,1939,1942],{},[50,1918,1919,379,1922],{},[56,1920,1921],{},"boolean IS TRUE",[56,1923,1924],{},"boolean = TRUE",": both work, but ",[56,1927,1928],{},"IS TRUE"," treats NULL as \"not true\" cleanly (returns FALSE), while ",[56,1931,1932],{},"NULL = TRUE"," is UNKNOWN. Use ",[56,1935,1928],{},[56,1937,1938],{},"IS FALSE",[56,1940,1941],{},"IS UNKNOWN"," for boolean tests.",[1437,1944,1945,1749,1953,1956,1957,1960,1961,1963,1964,179],{},[50,1946,1947,1949,1950],{},[56,1948,178],{}," in ",[56,1951,1952],{},"CASE",[56,1954,1955],{},"CASE WHEN NULL THEN ..."," never matches (NULL is not TRUE). ",[56,1958,1959],{},"CASE col WHEN NULL THEN ..."," (simple form) also never matches (it compares ",[56,1962,672],{},"). Use ",[56,1965,1966],{},"CASE WHEN col IS NULL THEN ...",[1437,1968,1969,1975,1976,63,1978,1981],{},[50,1970,1971,1974],{},[56,1972,1973],{},"ORDER BY"," with NULLs is engine-specific",": see chapter 03. Always specify ",[56,1977,1421],{},[56,1979,1980],{},"LAST"," if the order matters.",[18,1983,1985],{"id":1984},"spot-the-bug","🧠 Spot the Bug",[14,1987,1988],{},"This query is supposed to find customers whose city is \"not NYC\" — including those whose city is unknown (NULL). It returns far fewer rows than expected. What's wrong, and how do you fix it portably?",[686,1990,1991,2197,2221,2236,2239],{"language":688},[690,1992,1994],{"className":692,"code":1993,"language":688,"meta":694,"style":694},"SELECT name FROM customers WHERE city \u003C> 'NYC';\n``\n::\n\n\u003Cdetails>\n\u003Csummary>Answer\u003C\u002Fsummary>\n\n`city \u003C> 'NYC'` is `UNKNOWN` when `city` is `NULL` (any comparison with NULL yields UNKNOWN). `WHERE` keeps only `TRUE`, so NULL-city rows are excluded — they're not \"not NYC,\" they're \"unknown.\" The query silently drops everyone with an unknown city.\n\nTwo fixes, depending on intent:\n\n```sql\n-- If \"not NYC\" includes unknown cities (NULL is a distinct \"other\"):\nSELECT name FROM customers WHERE city IS DISTINCT FROM 'NYC';\n-- or\nSELECT name FROM customers WHERE city \u003C> 'NYC' OR city IS NULL;\n\n-- If \"not NYC\" means \"known to be a city other than NYC\" (NULLs excluded):\nSELECT name FROM customers WHERE city \u003C> 'NYC';\n",[56,1995,1996,2019,2023,2027,2031,2042,2062,2066,2140,2144,2155,2159,2163,2168,2173,2178,2183,2187,2192],{"__ignoreMap":694},[698,1997,1998,2000,2002,2005,2008,2010,2012,2014,2017],{"class":700,"line":701},[698,1999,1053],{"class":704},[698,2001,1056],{"class":704},[698,2003,2004],{"class":704}," FROM",[698,2006,2007],{"class":795}," customers ",[698,2009,647],{"class":704},[698,2011,1075],{"class":795},[698,2013,949],{"class":704},[698,2015,2016],{"class":820}," 'NYC'",[698,2018,1161],{"class":795},[698,2020,2021],{"class":700,"line":717},[698,2022,821],{"class":820},[698,2024,2025],{"class":700,"line":729},[698,2026,826],{"class":795},[698,2028,2029],{"class":700,"line":743},[698,2030,832],{"emptyLinePlaceholder":831},[698,2032,2033,2036,2039],{"class":700,"line":754},[698,2034,2035],{"class":704},"\u003C",[698,2037,2038],{"class":795},"details",[698,2040,2041],{"class":704},">\n",[698,2043,2044,2046,2049,2052,2055,2058,2060],{"class":700,"line":835},[698,2045,2035],{"class":704},[698,2047,2048],{"class":795},"summary",[698,2050,2051],{"class":704},">",[698,2053,2054],{"class":795},"Answer",[698,2056,2057],{"class":704},"\u003C\u002F",[698,2059,2048],{"class":795},[698,2061,2041],{"class":704},[698,2063,2064],{"class":700,"line":850},[698,2065,832],{"emptyLinePlaceholder":831},[698,2067,2068,2071,2074,2077,2080,2083,2085,2088,2091,2094,2096,2099,2102,2105,2108,2111,2114,2117,2120,2123,2126,2129,2132,2135,2137],{"class":700,"line":855},[698,2069,2070],{"class":820},"`city \u003C> 'NYC'`",[698,2072,2073],{"class":704}," is",[698,2075,2076],{"class":820}," `UNKNOWN`",[698,2078,2079],{"class":704}," when",[698,2081,2082],{"class":820}," `city`",[698,2084,2073],{"class":704},[698,2086,2087],{"class":820}," `NULL`",[698,2089,2090],{"class":795}," (any comparison ",[698,2092,2093],{"class":704},"with",[698,2095,710],{"class":704},[698,2097,2098],{"class":795}," yields UNKNOWN). ",[698,2100,2101],{"class":820},"`WHERE`",[698,2103,2104],{"class":795}," keeps only ",[698,2106,2107],{"class":820},"`TRUE`",[698,2109,2110],{"class":795},", so ",[698,2112,2113],{"class":704},"NULL-",[698,2115,2116],{"class":795},"city ",[698,2118,2119],{"class":704},"rows",[698,2121,2122],{"class":795}," are excluded — they",[698,2124,2125],{"class":820},"'re not \"not NYC,\" they'",[698,2127,2128],{"class":795},"re ",[698,2130,2131],{"class":820},"\"unknown.\"",[698,2133,2134],{"class":795}," The query silently drops everyone ",[698,2136,2093],{"class":704},[698,2138,2139],{"class":795}," an unknown city.\n",[698,2141,2142],{"class":700,"line":881},[698,2143,832],{"emptyLinePlaceholder":831},[698,2145,2146,2149,2152],{"class":700,"line":886},[698,2147,2148],{"class":795},"Two fixes, depending ",[698,2150,2151],{"class":704},"on",[698,2153,2154],{"class":795}," intent:\n",[698,2156,2157],{"class":700,"line":907},[698,2158,832],{"emptyLinePlaceholder":831},[698,2160,2161],{"class":700,"line":913},[698,2162,910],{"class":820},[698,2164,2165],{"class":700,"line":919},[698,2166,2167],{"class":820},"-- If \"not NYC\" includes unknown cities (NULL is a distinct \"other\"):\n",[698,2169,2170],{"class":700,"line":925},[698,2171,2172],{"class":820},"SELECT name FROM customers WHERE city IS DISTINCT FROM 'NYC';\n",[698,2174,2175],{"class":700,"line":931},[698,2176,2177],{"class":820},"-- or\n",[698,2179,2180],{"class":700,"line":937},[698,2181,2182],{"class":820},"SELECT name FROM customers WHERE city \u003C> 'NYC' OR city IS NULL;\n",[698,2184,2185],{"class":700,"line":1345},[698,2186,832],{"emptyLinePlaceholder":831},[698,2188,2189],{"class":700,"line":1350},[698,2190,2191],{"class":820},"-- If \"not NYC\" means \"known to be a city other than NYC\" (NULLs excluded):\n",[698,2193,2194],{"class":700,"line":1356},[698,2195,2196],{"class":820},"SELECT name FROM customers WHERE city \u003C> 'NYC';\n",[14,2198,826,2199,2201,2202,2204,2205,2208,2209,2212,2213,2216,2217,2220],{},[56,2200,1742],{}," is the NULL-safe \"not equal\" — it treats NULL and NULL as ",[211,2203,441],{}," distinct (so ",[56,2206,2207],{},"NULL IS DISTINCT FROM NULL"," = FALSE), and NULL and ",[56,2210,2211],{},"'NYC'"," as distinct (TRUE). It's the cleanest expression of \"different from X, counting NULL as a real value.\" Its only downside is that it can't use a plain B-tree index, so on large tables the ",[56,2214,2215],{},"OR city IS NULL"," form (which can use an index on ",[56,2218,2219],{},"city"," plus a scan for NULLs) may be faster.",[14,2222,2223,1749,2226,148,2228,2230,2231,2233,2234,179],{},[50,2224,2225],{},"The lesson",[56,2227,949],{},[56,2229,1732],{}," silently drop NULLs. If NULL is a meaningful category in your data (not just \"missing\"), use ",[56,2232,1742],{}," or explicitly handle ",[56,2235,776],{},[18,2237,2238],{"id":2048},"Summary",[14,2240,2241,2242,2244,2245,379,2247,2249,2250,777,2252,777,2254,777,2256,2258],{},"You now understand SQL's type system (when to use ",[56,2243,338],{}," vs float, ",[56,2246,133],{},[56,2248,151],{},"), the three-valued logic of NULL, the ",[56,2251,776],{},[56,2253,1643],{},[56,2255,1036],{},[56,2257,1167],{}," toolkit, and the dozen ways NULL silently breaks queries. Next: defining tables and schema with DDL.",[2260,2261,2262],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}",{"title":694,"searchDepth":717,"depth":717,"links":2264},[2265,2271,2277,2278,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292],{"id":20,"depth":717,"text":21,"children":2266},[2267,2269],{"id":346,"depth":729,"text":2268},"numeric vs floating-point",{"id":376,"depth":729,"text":2270},"varchar(n) vs text",{"id":432,"depth":717,"text":433,"children":2272},[2273,2274,2276],{"id":470,"depth":729,"text":471},{"id":644,"depth":729,"text":2275},"WHERE keeps only TRUE",{"id":683,"depth":729,"text":684},{"id":769,"depth":717,"text":770},{"id":959,"depth":717,"text":960,"children":2279},[2280,2281],{"id":1033,"depth":729,"text":1036},{"id":1164,"depth":729,"text":2282},"NULLIF — the divide-by-zero fix",{"id":1414,"depth":717,"text":1415},{"id":1431,"depth":717,"text":1432},{"id":1475,"depth":717,"text":1476},{"id":1585,"depth":717,"text":1586},{"id":1622,"depth":717,"text":1623},{"id":1647,"depth":717,"text":1648},{"id":1678,"depth":717,"text":1679},{"id":1759,"depth":717,"text":1760},{"id":1984,"depth":717,"text":1985},{"id":2048,"depth":717,"text":2238},"md",{},"\u002Fsql\u002F10-data-types-and-null",{"title":5,"description":16},"sql\u002F10-data-types-and-null","XwQZkGAlHukc76zYhd3gUuBkTZCq2LWAO3AEop4t3Cg",17874012