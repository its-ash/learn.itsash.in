[{"data":1,"prerenderedAt":2082},["ShallowReactive",2],{"page-\u002Fsql\u002F18-json-and-arrays":3},{"id":4,"title":5,"body":6,"description":2075,"extension":2076,"meta":2077,"navigation":185,"path":2078,"seo":2079,"stem":2080,"__hash__":2081},"content\u002Fsql\u002F18-json-and-arrays.md","18 — JSON & Array Columns",{"type":7,"value":8,"toc":2050},"minimark",[9,13,22,27,102,114,118,295,299,304,435,601,608,621,625,629,705,714,718,781,784,788,823,830,834,837,969,978,982,985,1095,1099,1184,1323,1330,1448,1453,1457,1478,1481,1485,1577,1581,1792,1796,1803,1862,1865,2014,2017,2046],[10,11,5],"h1",{"id":12},"_18-json-array-columns",[14,15,16,17,21],"p",{},"PostgreSQL has first-class support for semi-structured data: ",[18,19,20],"code",{},"JSONB"," (binary JSON) and array columns. This lets you store variable-structure data (event payloads, user preferences, nested objects) without a separate document database, while keeping relational power for the rest of the schema.",[23,24,26],"h2",{"id":25},"json-vs-jsonb","JSON vs JSONB",[28,29,30,55],"table",{},[31,32,33],"thead",{},[34,35,36,40,43,46,49,52],"tr",{},[37,38,39],"th",{},"Type",[37,41,42],{},"Storage",[37,44,45],{},"Indexing",[37,47,48],{},"Deduplication",[37,50,51],{},"Preserves key order",[37,53,54],{},"Speed",[56,57,58,81],"tbody",{},[34,59,60,66,69,72,75,78],{},[61,62,63],"td",{},[18,64,65],{},"json",[61,67,68],{},"Text (as input)",[61,70,71],{},"Limited (expression indexes)",[61,73,74],{},"No",[61,76,77],{},"Yes",[61,79,80],{},"Slower to query (re-parsed)",[34,82,83,88,91,94,97,99],{},[61,84,85],{},[18,86,87],{},"jsonb",[61,89,90],{},"Binary",[61,92,93],{},"Full (GIN, expression)",[61,95,96],{},"Yes (duplicate keys merged)",[61,98,74],{},[61,100,101],{},"Faster to query",[14,103,104,110,111,113],{},[105,106,107,108],"strong",{},"Use ",[18,109,87],{}," for almost everything — it's indexable, faster to query, and deduplicates keys. Use ",[18,112,65],{}," only when you need to preserve the exact input (key order, duplicate keys) — rare.",[23,115,117],{"id":116},"inserting-json","Inserting JSON",[119,120,122],"codewrapper",{"language":121},"sql",[123,124,128],"pre",{"className":125,"code":126,"language":121,"meta":127,"style":127},"language-sql shiki shiki-themes github-light github-dark","CREATE TABLE events (\n  id BIGSERIAL PRIMARY KEY,\n  payload JSONB NOT NULL\n);\n\n-- From a JSON string\nINSERT INTO events (payload) VALUES ('{\"type\": \"click\", \"user\": {\"id\": 42, \"name\": \"Alice\"}, \"tags\": [\"web\", \"mobile\"]}');\n\n-- From a row via jsonb_build_object\nINSERT INTO events (payload)\nSELECT jsonb_build_object('type', 'click', 'user_id', id, 'ts', now())\nFROM users WHERE email = 'a@x.com';\n","",[18,129,130,150,165,174,180,187,194,215,220,226,234,271],{"__ignoreMap":127},[131,132,135,139,142,146],"span",{"class":133,"line":134},"line",1,[131,136,138],{"class":137},"svdQ7","CREATE",[131,140,141],{"class":137}," TABLE",[131,143,145],{"class":144},"sIsaT"," events",[131,147,149],{"class":148},"ssxIu"," (\n",[131,151,153,156,159,162],{"class":133,"line":152},2,[131,154,155],{"class":148},"  id ",[131,157,158],{"class":137},"BIGSERIAL",[131,160,161],{"class":137}," PRIMARY KEY",[131,163,164],{"class":148},",\n",[131,166,168,171],{"class":133,"line":167},3,[131,169,170],{"class":148},"  payload JSONB ",[131,172,173],{"class":137},"NOT NULL\n",[131,175,177],{"class":133,"line":176},4,[131,178,179],{"class":148},");\n",[131,181,183],{"class":133,"line":182},5,[131,184,186],{"emptyLinePlaceholder":185},true,"\n",[131,188,190],{"class":133,"line":189},6,[131,191,193],{"class":192},"sdCPZ","-- From a JSON string\n",[131,195,197,200,203,206,209,213],{"class":133,"line":196},7,[131,198,199],{"class":137},"INSERT INTO",[131,201,202],{"class":148}," events (payload) ",[131,204,205],{"class":137},"VALUES",[131,207,208],{"class":148}," (",[131,210,212],{"class":211},"sJ6F3","'{\"type\": \"click\", \"user\": {\"id\": 42, \"name\": \"Alice\"}, \"tags\": [\"web\", \"mobile\"]}'",[131,214,179],{"class":148},[131,216,218],{"class":133,"line":217},8,[131,219,186],{"emptyLinePlaceholder":185},[131,221,223],{"class":133,"line":222},9,[131,224,225],{"class":192},"-- From a row via jsonb_build_object\n",[131,227,229,231],{"class":133,"line":228},10,[131,230,199],{"class":137},[131,232,233],{"class":148}," events (payload)\n",[131,235,237,240,243,246,249,252,254,257,260,263,265,268],{"class":133,"line":236},11,[131,238,239],{"class":137},"SELECT",[131,241,242],{"class":148}," jsonb_build_object(",[131,244,245],{"class":211},"'type'",[131,247,248],{"class":148},", ",[131,250,251],{"class":211},"'click'",[131,253,248],{"class":148},[131,255,256],{"class":211},"'user_id'",[131,258,259],{"class":148},", id, ",[131,261,262],{"class":211},"'ts'",[131,264,248],{"class":148},[131,266,267],{"class":137},"now",[131,269,270],{"class":148},"())\n",[131,272,274,277,280,283,286,289,292],{"class":133,"line":273},12,[131,275,276],{"class":137},"FROM",[131,278,279],{"class":148}," users ",[131,281,282],{"class":137},"WHERE",[131,284,285],{"class":148}," email ",[131,287,288],{"class":137},"=",[131,290,291],{"class":211}," 'a@x.com'",[131,293,294],{"class":148},";\n",[23,296,298],{"id":297},"querying-json","Querying JSON",[300,301,303],"h3",{"id":302},"operators","Operators",[28,305,306,316],{},[31,307,308],{},[34,309,310,313],{},[37,311,312],{},"Operator",[37,314,315],{},"Returns",[56,317,318,332,349,362,375,388,398,411,419,429],{},[34,319,320,325],{},[61,321,322],{},[18,323,324],{},"->",[61,326,327,328,331],{},"JSON value at key (or array index), as JSONB. ",[18,329,330],{},"payload->'user'",".",[34,333,334,339],{},[61,335,336],{},[18,337,338],{},"->>",[61,340,341,342,345,346,331],{},"Value at key (or index), as ",[105,343,344],{},"text",". ",[18,347,348],{},"payload->>'type'",[34,350,351,356],{},[61,352,353],{},[18,354,355],{},"#>",[61,357,358,359,331],{},"Value at a path (array of keys), as JSONB. ",[18,360,361],{},"payload #> '{user,id}'",[34,363,364,369],{},[61,365,366],{},[18,367,368],{},"#>>",[61,370,371,372,331],{},"Value at a path, as text. ",[18,373,374],{},"payload #>> '{user,name}'",[34,376,377,382],{},[61,378,379],{},[18,380,381],{},"@>",[61,383,384,385,331],{},"Containment — left contains right. ",[18,386,387],{},"payload @> '{\"type\": \"click\"}'",[34,389,390,395],{},[61,391,392],{},[18,393,394],{},"\u003C@",[61,396,397],{},"Contained by.",[34,399,400,405],{},[61,401,402],{},[18,403,404],{},"?",[61,406,407,408,331],{},"Key exists. ",[18,409,410],{},"payload ? 'user'",[34,412,413,416],{},[61,414,415],{},"`?",[61,417,418],{},"`",[34,420,421,426],{},[61,422,423],{},[18,424,425],{},"?&",[61,427,428],{},"All of these keys exist.",[34,430,431,433],{},[61,432,418],{},[61,434],{},[436,437,438],"code-wrapper",{"language":121},[123,439,441],{"className":125,"code":440,"language":121,"meta":127,"style":127},"-- Get a field as text\nSELECT payload->>'type' FROM events;\n\n-- Get a nested field\nSELECT payload->'user'->>'name' FROM events;\nSELECT payload #>> '{user,name}' FROM events;\n\n-- Get an array element\nSELECT payload->'tags'->>0 FROM events;   -- first tag\n\n-- Containment (the key JSONB query operator)\nSELECT * FROM events WHERE payload @> '{\"type\": \"click\"}';\nSELECT * FROM events WHERE payload @> '{\"user\": {\"id\": 42}}';\n",[18,442,443,448,465,469,474,494,511,515,520,545,549,554,579],{"__ignoreMap":127},[131,444,445],{"class":133,"line":134},[131,446,447],{"class":192},"-- Get a field as text\n",[131,449,450,452,455,457,459,462],{"class":133,"line":152},[131,451,239],{"class":137},[131,453,454],{"class":148}," payload",[131,456,338],{"class":137},[131,458,245],{"class":211},[131,460,461],{"class":137}," FROM",[131,463,464],{"class":148}," events;\n",[131,466,467],{"class":133,"line":167},[131,468,186],{"emptyLinePlaceholder":185},[131,470,471],{"class":133,"line":176},[131,472,473],{"class":192},"-- Get a nested field\n",[131,475,476,478,480,482,485,487,490,492],{"class":133,"line":182},[131,477,239],{"class":137},[131,479,454],{"class":148},[131,481,324],{"class":137},[131,483,484],{"class":211},"'user'",[131,486,338],{"class":137},[131,488,489],{"class":211},"'name'",[131,491,461],{"class":137},[131,493,464],{"class":148},[131,495,496,498,501,504,507,509],{"class":133,"line":189},[131,497,239],{"class":137},[131,499,500],{"class":148}," payload #",[131,502,503],{"class":137},">>",[131,505,506],{"class":211}," '{user,name}'",[131,508,461],{"class":137},[131,510,464],{"class":148},[131,512,513],{"class":133,"line":196},[131,514,186],{"emptyLinePlaceholder":185},[131,516,517],{"class":133,"line":217},[131,518,519],{"class":192},"-- Get an array element\n",[131,521,522,524,526,528,531,533,537,539,542],{"class":133,"line":222},[131,523,239],{"class":137},[131,525,454],{"class":148},[131,527,324],{"class":137},[131,529,530],{"class":211},"'tags'",[131,532,338],{"class":137},[131,534,536],{"class":535},"snvgF","0",[131,538,461],{"class":137},[131,540,541],{"class":148}," events;   ",[131,543,544],{"class":192},"-- first tag\n",[131,546,547],{"class":133,"line":228},[131,548,186],{"emptyLinePlaceholder":185},[131,550,551],{"class":133,"line":236},[131,552,553],{"class":192},"-- Containment (the key JSONB query operator)\n",[131,555,556,558,561,563,566,568,571,574,577],{"class":133,"line":273},[131,557,239],{"class":137},[131,559,560],{"class":137}," *",[131,562,461],{"class":137},[131,564,565],{"class":148}," events ",[131,567,282],{"class":137},[131,569,570],{"class":148}," payload @",[131,572,573],{"class":137},">",[131,575,576],{"class":211}," '{\"type\": \"click\"}'",[131,578,294],{"class":148},[131,580,582,584,586,588,590,592,594,596,599],{"class":133,"line":581},13,[131,583,239],{"class":137},[131,585,560],{"class":137},[131,587,461],{"class":137},[131,589,565],{"class":148},[131,591,282],{"class":137},[131,593,570],{"class":148},[131,595,573],{"class":137},[131,597,598],{"class":211}," '{\"user\": {\"id\": 42}}'",[131,600,294],{"class":148},[300,602,604,605,607],{"id":603},"containment-is-the-indexable-one","Containment ",[18,606,381],{}," is the indexable one",[14,609,610,612,613,616,617,620],{},[18,611,381],{}," (contains) is the operator that GIN indexes optimize. Prefer ",[18,614,615],{},"WHERE payload @> '{\"type\": \"click\"}'"," over ",[18,618,619],{},"WHERE payload->>'type' = 'click'"," — the former can use a GIN index; the latter needs an expression index on the specific path.",[23,622,624],{"id":623},"indexing-jsonb","Indexing JSONB",[300,626,628],{"id":627},"gin-index-indexes-everything","GIN index (indexes everything)",[436,630,631],{"language":121},[123,632,634],{"className":125,"code":633,"language":121,"meta":127,"style":127},"CREATE INDEX events_payload_gin ON events USING gin(payload);\n\n-- Now containment, key-existence, and path queries use the index\nSELECT * FROM events WHERE payload @> '{\"type\": \"click\"}';\nSELECT * FROM events WHERE payload ? 'user_id';\n",[18,635,636,657,661,666,686],{"__ignoreMap":127},[131,637,638,640,643,646,649,651,654],{"class":133,"line":134},[131,639,138],{"class":137},[131,641,642],{"class":137}," INDEX",[131,644,645],{"class":144}," events_payload_gin",[131,647,648],{"class":137}," ON",[131,650,565],{"class":148},[131,652,653],{"class":137},"USING",[131,655,656],{"class":148}," gin(payload);\n",[131,658,659],{"class":133,"line":152},[131,660,186],{"emptyLinePlaceholder":185},[131,662,663],{"class":133,"line":167},[131,664,665],{"class":192},"-- Now containment, key-existence, and path queries use the index\n",[131,667,668,670,672,674,676,678,680,682,684],{"class":133,"line":176},[131,669,239],{"class":137},[131,671,560],{"class":137},[131,673,461],{"class":137},[131,675,565],{"class":148},[131,677,282],{"class":137},[131,679,570],{"class":148},[131,681,573],{"class":137},[131,683,576],{"class":211},[131,685,294],{"class":148},[131,687,688,690,692,694,696,698,701,703],{"class":133,"line":182},[131,689,239],{"class":137},[131,691,560],{"class":137},[131,693,461],{"class":137},[131,695,565],{"class":148},[131,697,282],{"class":137},[131,699,700],{"class":148}," payload ? ",[131,702,256],{"class":211},[131,704,294],{"class":148},[14,706,707,708,710,711,713],{},"A full GIN index on a JSONB column indexes every key and value. It's the most flexible (any ",[18,709,381],{},"\u002F",[18,712,404],{}," query benefits) but takes space.",[300,715,717],{"id":716},"expression-index-indexes-a-specific-path","Expression index (indexes a specific path)",[436,719,720],{"language":121},[123,721,723],{"className":125,"code":722,"language":121,"meta":127,"style":127},"CREATE INDEX events_type_idx ON events((payload->>'type'));\n\n-- Uses this index\nSELECT * FROM events WHERE payload->>'type' = 'click';\n",[18,724,725,746,750,755],{"__ignoreMap":127},[131,726,727,729,731,734,736,739,741,743],{"class":133,"line":134},[131,728,138],{"class":137},[131,730,642],{"class":137},[131,732,733],{"class":144}," events_type_idx",[131,735,648],{"class":137},[131,737,738],{"class":148}," events((payload",[131,740,338],{"class":137},[131,742,245],{"class":211},[131,744,745],{"class":148},"));\n",[131,747,748],{"class":133,"line":152},[131,749,186],{"emptyLinePlaceholder":185},[131,751,752],{"class":133,"line":167},[131,753,754],{"class":192},"-- Uses this index\n",[131,756,757,759,761,763,765,767,769,771,773,776,779],{"class":133,"line":176},[131,758,239],{"class":137},[131,760,560],{"class":137},[131,762,461],{"class":137},[131,764,565],{"class":148},[131,766,282],{"class":137},[131,768,454],{"class":148},[131,770,338],{"class":137},[131,772,245],{"class":211},[131,774,775],{"class":137}," =",[131,777,778],{"class":211}," 'click'",[131,780,294],{"class":148},[14,782,783],{},"Expression indexes are smaller and faster for queries on a known path, but they only help that exact expression.",[300,785,787],{"id":786},"partial-gin-for-hot-subsets","Partial GIN for hot subsets",[436,789,790],{"language":121},[123,791,793],{"className":125,"code":792,"language":121,"meta":127,"style":127},"CREATE INDEX events_clicks_gin ON events USING gin(payload) WHERE payload @> '{\"type\": \"click\"}';\n",[18,794,795],{"__ignoreMap":127},[131,796,797,799,801,804,806,808,810,813,815,817,819,821],{"class":133,"line":134},[131,798,138],{"class":137},[131,800,642],{"class":137},[131,802,803],{"class":144}," events_clicks_gin",[131,805,648],{"class":137},[131,807,565],{"class":148},[131,809,653],{"class":137},[131,811,812],{"class":148}," gin(payload) ",[131,814,282],{"class":137},[131,816,570],{"class":148},[131,818,573],{"class":137},[131,820,576],{"class":211},[131,822,294],{"class":148},[14,824,825,826,829],{},"Index only the ",[18,827,828],{},"click"," events — much smaller, and the planner uses it when the predicate matches.",[23,831,833],{"id":832},"modifying-jsonb","Modifying JSONB",[14,835,836],{},"JSONB is immutable in place — you replace it with a modified version:",[436,838,839],{"language":121},[123,840,842],{"className":125,"code":841,"language":121,"meta":127,"style":127},"-- Add\u002Fset a key (jsonb_set)\nUPDATE events SET payload = jsonb_set(payload, '{user,name}', '\"Bob\"');\n\n-- Add a key (|| merge)\nUPDATE events SET payload = payload || '{\"processed\": true}';\n\n-- Remove a key (- operator)\nUPDATE events SET payload = payload - 'tags';\n\n-- Remove a nested key (- with path)\nUPDATE events SET payload = payload #- '{user,id}';\n",[18,843,844,849,877,881,886,908,912,917,939,943,948],{"__ignoreMap":127},[131,845,846],{"class":133,"line":134},[131,847,848],{"class":192},"-- Add\u002Fset a key (jsonb_set)\n",[131,850,851,854,856,859,862,864,867,870,872,875],{"class":133,"line":152},[131,852,853],{"class":137},"UPDATE",[131,855,565],{"class":148},[131,857,858],{"class":137},"SET",[131,860,861],{"class":148}," payload ",[131,863,288],{"class":137},[131,865,866],{"class":148}," jsonb_set(payload, ",[131,868,869],{"class":211},"'{user,name}'",[131,871,248],{"class":148},[131,873,874],{"class":211},"'\"Bob\"'",[131,876,179],{"class":148},[131,878,879],{"class":133,"line":167},[131,880,186],{"emptyLinePlaceholder":185},[131,882,883],{"class":133,"line":176},[131,884,885],{"class":192},"-- Add a key (|| merge)\n",[131,887,888,890,892,894,896,898,900,903,906],{"class":133,"line":182},[131,889,853],{"class":137},[131,891,565],{"class":148},[131,893,858],{"class":137},[131,895,861],{"class":148},[131,897,288],{"class":137},[131,899,861],{"class":148},[131,901,902],{"class":137},"||",[131,904,905],{"class":211}," '{\"processed\": true}'",[131,907,294],{"class":148},[131,909,910],{"class":133,"line":189},[131,911,186],{"emptyLinePlaceholder":185},[131,913,914],{"class":133,"line":196},[131,915,916],{"class":192},"-- Remove a key (- operator)\n",[131,918,919,921,923,925,927,929,931,934,937],{"class":133,"line":217},[131,920,853],{"class":137},[131,922,565],{"class":148},[131,924,858],{"class":137},[131,926,861],{"class":148},[131,928,288],{"class":137},[131,930,861],{"class":148},[131,932,933],{"class":137},"-",[131,935,936],{"class":211}," 'tags'",[131,938,294],{"class":148},[131,940,941],{"class":133,"line":222},[131,942,186],{"emptyLinePlaceholder":185},[131,944,945],{"class":133,"line":228},[131,946,947],{"class":192},"-- Remove a nested key (- with path)\n",[131,949,950,952,954,956,958,960,962,964,967],{"class":133,"line":236},[131,951,853],{"class":137},[131,953,565],{"class":148},[131,955,858],{"class":137},[131,957,861],{"class":148},[131,959,288],{"class":137},[131,961,500],{"class":148},[131,963,933],{"class":137},[131,965,966],{"class":211}," '{user,id}'",[131,968,294],{"class":148},[14,970,971,974,975,977],{},[18,972,973],{},"jsonb_set(target, path, new_value, create_if_missing)",". The path is a text array. The new value must be valid JSONB (so strings need double quotes: ",[18,976,874],{},").",[23,979,981],{"id":980},"array-columns","Array Columns",[14,983,984],{},"PostgreSQL columns can be arrays of any type:",[436,986,987],{"language":121},[123,988,990],{"className":125,"code":989,"lan