[{"data":1,"prerenderedAt":2229},["ShallowReactive",2],{"page-\u002Fsql\u002F02-select-basics-and-filtering":3},{"id":4,"title":5,"body":6,"description":35,"extension":2223,"meta":2224,"navigation":133,"path":2225,"seo":2226,"stem":2227,"__hash__":2228},"content\u002Fsql\u002F02-select-basics-and-filtering.md","02 — SELECT Basics & Filtering",{"type":7,"value":8,"toc":2198},"minimark",[9,13,18,26,68,99,103,248,256,262,276,279,283,390,418,422,427,473,487,494,500,547,556,560,565,569,742,949,953,995,1011,1160,1164,1244,1260,1300,1316,1320,1325,1368,1375,1379,1399,1478,1495,1499,1508,1603,1606,1610,1699,1703,1804,1808,1981,1985,1995,2022,2185,2188,2194],[10,11,5],"h1",{"id":12},"_02-select-basics-filtering",[14,15,17],"h2",{"id":16},"the-select-statement","The SELECT Statement",[19,20,21,25],"p",{},[22,23,24],"code",{},"SELECT"," is the workhorse of SQL. Its core form:",[27,28,30],"code-wrapper",{"language":29},"sql",[31,32,36],"pre",{"className":33,"code":34,"language":29,"meta":35,"style":35},"language-sql shiki shiki-themes github-light github-dark","SELECT column1, column2, ...\nFROM table_name\nWHERE condition;\n","",[22,37,38,50,59],{"__ignoreMap":35},[39,40,43,46],"span",{"class":41,"line":42},"line",1,[39,44,24],{"class":45},"svdQ7",[39,47,49],{"class":48},"ssxIu"," column1, column2, ...\n",[39,51,53,56],{"class":41,"line":52},2,[39,54,55],{"class":45},"FROM",[39,57,58],{"class":48}," table_name\n",[39,60,62,65],{"class":41,"line":61},3,[39,63,64],{"class":45},"WHERE",[39,66,67],{"class":48}," condition;\n",[69,70,71,82,91],"ul",{},[72,73,74,76,77,81],"li",{},[22,75,24],{}," chooses ",[78,79,80],"strong",{},"columns"," (projection).",[72,83,84,86,87,90],{},[22,85,55],{}," chooses the ",[78,88,89],{},"source"," (a table, or later: a join, subquery, CTE).",[72,92,93,76,95,98],{},[22,94,64],{},[78,96,97],{},"rows"," (selection \u002F filtering).",[14,100,102],{"id":101},"selecting-columns","Selecting Columns",[27,104,105],{"language":29},[31,106,108],{"className":33,"code":107,"language":29,"meta":35,"style":35},"-- All columns\nSELECT * FROM customers;\n\n-- Specific columns (prefer this — explicit, faster, stable)\nSELECT name, city FROM customers;\n\n-- Expressions\nSELECT name, length(name) AS name_len FROM customers;\n\n-- Constants and computations\nSELECT name, 'US' AS country, 2024 - 2000 AS age_estimate FROM customers;\n",[22,109,110,116,129,135,141,156,161,167,199,204,210],{"__ignoreMap":35},[39,111,112],{"class":41,"line":42},[39,113,115],{"class":114},"sdCPZ","-- All columns\n",[39,117,118,120,123,126],{"class":41,"line":52},[39,119,24],{"class":45},[39,121,122],{"class":45}," *",[39,124,125],{"class":45}," FROM",[39,127,128],{"class":48}," customers;\n",[39,130,131],{"class":41,"line":61},[39,132,134],{"emptyLinePlaceholder":133},true,"\n",[39,136,138],{"class":41,"line":137},4,[39,139,140],{"class":114},"-- Specific columns (prefer this — explicit, faster, stable)\n",[39,142,144,146,149,152,154],{"class":41,"line":143},5,[39,145,24],{"class":45},[39,147,148],{"class":45}," name",[39,150,151],{"class":48},", city ",[39,153,55],{"class":45},[39,155,128],{"class":48},[39,157,159],{"class":41,"line":158},6,[39,160,134],{"emptyLinePlaceholder":133},[39,162,164],{"class":41,"line":163},7,[39,165,166],{"class":114},"-- Expressions\n",[39,168,170,172,174,177,180,183,186,189,192,195,197],{"class":41,"line":169},8,[39,171,24],{"class":45},[39,173,148],{"class":45},[39,175,176],{"class":48},", ",[39,178,179],{"class":45},"length",[39,181,182],{"class":48},"(",[39,184,185],{"class":45},"name",[39,187,188],{"class":48},") ",[39,190,191],{"class":45},"AS",[39,193,194],{"class":48}," name_len ",[39,196,55],{"class":45},[39,198,128],{"class":48},[39,200,202],{"class":41,"line":201},9,[39,203,134],{"emptyLinePlaceholder":133},[39,205,207],{"class":41,"line":206},10,[39,208,209],{"class":114},"-- Constants and computations\n",[39,211,213,215,217,219,223,226,229,233,236,239,241,244,246],{"class":41,"line":212},11,[39,214,24],{"class":45},[39,216,148],{"class":45},[39,218,176],{"class":48},[39,220,222],{"class":221},"sJ6F3","'US'",[39,224,225],{"class":45}," AS",[39,227,228],{"class":48}," country, ",[39,230,232],{"class":231},"snvgF","2024",[39,234,235],{"class":45}," -",[39,237,238],{"class":231}," 2000",[39,240,225],{"class":45},[39,242,243],{"class":48}," age_estimate ",[39,245,55],{"class":45},[39,247,128],{"class":48},[249,250,252,255],"h3",{"id":251},"vs-explicit-columns",[22,253,254],{},"*"," vs explicit columns",[19,257,258,261],{},[22,259,260],{},"SELECT *"," is fine for exploration but an anti-pattern in production code:",[69,263,264,267,273],{},[72,265,266],{},"It returns columns you may not need, wasting I\u002FO and network bandwidth.",[72,268,269,270,272],{},"If the table schema changes (a column is added), ",[22,271,260],{}," silently returns the new column, which can break applications expecting a fixed shape.",[72,274,275],{},"It prevents the planner from using covering indexes (indexes that include all needed columns).",[19,277,278],{},"Always list columns explicitly in application queries.",[14,280,282],{"id":281},"aliasing-columns","Aliasing Columns",[27,284,285],{"language":29},[31,286,288],{"className":33,"code":287,"language":29,"meta":35,"style":35},"-- AS is optional but improves readability\nSELECT amount * 1.08 AS total_with_tax\nFROM orders;\n\n-- Without AS (works, but less clear)\nSELECT amount * 1.08 total_with_tax\nFROM orders;\n\n-- Quoted alias when it contains spaces or reserved words\nSELECT amount * 1.08 AS \"Total With Tax\"\nFROM orders;\n",[22,289,290,295,318,325,329,334,350,356,360,365,384],{"__ignoreMap":35},[39,291,292],{"class":41,"line":42},[39,293,294],{"class":114},"-- AS is optional but improves readability\n",[39,296,297,299,302,304,307,310,313,315],{"class":41,"line":52},[39,298,24],{"class":45},[39,300,301],{"class":48}," amount ",[39,303,254],{"class":45},[39,305,306],{"class":231}," 1",[39,308,309],{"class":48},".",[39,311,312],{"class":231},"08",[39,314,225],{"class":45},[39,316,317],{"class":48}," total_with_tax\n",[39,319,320,322],{"class":41,"line":61},[39,321,55],{"class":45},[39,323,324],{"class":48}," orders;\n",[39,326,327],{"class":41,"line":137},[39,328,134],{"emptyLinePlaceholder":133},[39,330,331],{"class":41,"line":143},[39,332,333],{"class":114},"-- Without AS (works, but less clear)\n",[39,335,336,338,340,342,344,346,348],{"class":41,"line":158},[39,337,24],{"class":45},[39,339,301],{"class":48},[39,341,254],{"class":45},[39,343,306],{"class":231},[39,345,309],{"class":48},[39,347,312],{"class":231},[39,349,317],{"class":48},[39,351,352,354],{"class":41,"line":163},[39,353,55],{"class":45},[39,355,324],{"class":48},[39,357,358],{"class":41,"line":169},[39,359,134],{"emptyLinePlaceholder":133},[39,361,362],{"class":41,"line":201},[39,363,364],{"class":114},"-- Quoted alias when it contains spaces or reserved words\n",[39,366,367,369,371,373,375,377,379,381],{"class":41,"line":206},[39,368,24],{"class":45},[39,370,301],{"class":48},[39,372,254],{"class":45},[39,374,306],{"class":231},[39,376,309],{"class":48},[39,378,312],{"class":231},[39,380,225],{"class":45},[39,382,383],{"class":221}," \"Total With Tax\"\n",[39,385,386,388],{"class":41,"line":212},[39,387,55],{"class":45},[39,389,324],{"class":48},[19,391,392,393,396,397,400,401,403,404,407,408,410,411,414,415,417],{},"Aliases are purely display labels — they don't change data. They're visible in ",[22,394,395],{},"ORDER BY"," and ",[22,398,399],{},"LIMIT"," (clauses after ",[22,402,24],{},") but ",[78,405,406],{},"not"," in ",[22,409,64],{}," or ",[22,412,413],{},"GROUP BY"," (clauses before ",[22,416,24],{},"). See chapter 01's evaluation order.",[14,419,421],{"id":420},"distinct","DISTINCT",[19,423,424,426],{},[22,425,421],{}," removes duplicate rows from the result:",[27,428,429],{"language":29},[31,430,432],{"className":33,"code":431,"language":29,"meta":35,"style":35},"-- Unique cities\nSELECT DISTINCT city FROM customers;\n\n-- Distinct combinations of multiple columns\nSELECT DISTINCT city, name FROM customers;\n",[22,433,434,439,451,455,460],{"__ignoreMap":35},[39,435,436],{"class":41,"line":42},[39,437,438],{"class":114},"-- Unique cities\n",[39,440,441,444,447,449],{"class":41,"line":52},[39,442,443],{"class":45},"SELECT DISTINCT",[39,445,446],{"class":48}," city ",[39,448,55],{"class":45},[39,450,128],{"class":48},[39,452,453],{"class":41,"line":61},[39,454,134],{"emptyLinePlaceholder":133},[39,456,457],{"class":41,"line":137},[39,458,459],{"class":114},"-- Distinct combinations of multiple columns\n",[39,461,462,464,467,469,471],{"class":41,"line":143},[39,463,443],{"class":45},[39,465,466],{"class":48}," city, ",[39,468,185],{"class":45},[39,470,125],{"class":45},[39,472,128],{"class":48},[19,474,475,477,478,482,483,486],{},[22,476,421],{}," applies to the ",[479,480,481],"em",{},"entire row",", not individual columns. ",[22,484,485],{},"SELECT DISTINCT city, name"," returns unique (city, name) pairs, not unique cities and unique names separately.",[249,488,490,493],{"id":489},"distinct-on-postgresql-specific",[22,491,492],{},"DISTINCT ON"," (PostgreSQL-specific)",[19,495,496,497,499],{},"PostgreSQL has a powerful extension: ",[22,498,492],{}," keeps the first row of each group per a sort order:",[27,501,502],{"language":29},[31,503,505],{"className":33,"code":504,"language":29,"meta":35,"style":35},"-- The largest order per customer\nSELECT DISTINCT ON (customer_id)\n  customer_id, id, amount\nFROM orders\nORDER BY customer_id, amount DESC;\n",[22,506,507,512,522,527,534],{"__ignoreMap":35},[39,508,509],{"class":41,"line":42},[39,510,511],{"class":114},"-- The largest order per customer\n",[39,513,514,516,519],{"class":41,"line":52},[39,515,443],{"class":45},[39,517,518],{"class":45}," ON",[39,520,521],{"class":48}," (customer_id)\n",[39,523,524],{"class":41,"line":61},[39,525,526],{"class":48},"  customer_id, id, amount\n",[39,528,529,531],{"class":41,"line":137},[39,530,55],{"class":45},[39,532,533],{"class":48}," orders\n",[39,535,536,538,541,544],{"class":41,"line":143},[39,537,395],{"class":45},[39,539,540],{"class":48}," customer_id, amount ",[39,542,543],{"class":45},"DESC",[39,545,546],{"class":48},";\n",[19,548,549,550,552,553,555],{},"The ",[22,551,395],{}," must start with the ",[22,554,492],{}," columns. This is a concise alternative to window functions (chapter 09) for \"greatest-N-per-group\" queries.",[14,557,559],{"id":558},"where-filtering-rows","WHERE — Filtering Rows",[19,561,562,564],{},[22,563,64],{}," keeps rows where the condition is true. Conditions use comparison and logical operators.",[249,566,568],{"id":567},"comparison-operators","Comparison Operators",[570,571,572,585],"table",{},[573,574,575],"thead",{},[576,577,578,582],"tr",{},[579,580,581],"th",{},"Operator",[579,583,584],{},"Meaning",[586,587,588,606,625,644,657,667,677,687,705,718,732],"tbody",{},[576,589,590,596],{},[591,592,593],"td",{},[22,594,595],{},"=",[591,597,598,599,601,602,605],{},"Equal (note: single ",[22,600,595],{},", not ",[22,603,604],{},"==",").",[576,607,608,616],{},[591,609,610,410,613],{},[22,611,612],{},"\u003C>",[22,614,615],{},"!=",[591,617,618,619,621,622,624],{},"Not equal. ",[22,620,612],{}," is standard; ",[22,623,615],{}," is widely supported.",[576,626,627,641],{},[591,628,629,176,632,176,635,176,638],{},[22,630,631],{},"\u003C",[22,633,634],{},"\u003C=",[22,636,637],{},">",[22,639,640],{},">=",[591,642,643],{},"Ordering comparisons.",[576,645,646,651],{},[591,647,648],{},[22,649,650],{},"BETWEEN x AND y",[591,652,653,654,309],{},"Inclusive range: ",[22,655,656],{},">= x AND \u003C= y",[576,658,659,664],{},[591,660,661],{},[22,662,663],{},"NOT BETWEEN x AND y",[591,665,666],{},"Outside the range.",[576,668,669,674],{},[591,670,671],{},[22,672,673],{},"IN (a, b, c)",[591,675,676],{},"Equal to any of the listed values.",[576,678,679,684],{},[591,680,681],{},[22,682,683],{},"NOT IN (a, b, c)",[591,685,686],{},"Not equal to any of the listed values.",[576,688,689,694],{},[591,690,691],{},[22,692,693],{},"LIKE",[591,695,696,697,700,701,704],{},"Pattern match with ",[22,698,699],{},"%"," (any chars) and ",[22,702,703],{},"_"," (one char).",[576,706,707,713],{},[591,708,709,712],{},[22,710,711],{},"ILIKE"," (PostgreSQL)",[591,714,715,716,309],{},"Case-insensitive ",[22,717,693],{},[576,719,720,729],{},[591,721,722,725,726],{},[22,723,724],{},"IS NULL"," \u002F ",[22,727,728],{},"IS NOT NULL",[591,730,731],{},"NULL tests (see chapter 10).",[576,733,734,739],{},[591,735,736],{},[22,737,738],{},"IS [NOT] DISTINCT FROM",[591,740,741],{},"NULL-safe equality (treats NULL = NULL as true).",[27,743,744],{"language":29},[31,745,747],{"className":33,"code":746,"language":29,"meta":35,"style":35},"SELECT name, city FROM customers WHERE city = 'NYC';\nSELECT name FROM customers WHERE name \u003C> 'Alice';\nSELECT * FROM orders WHERE amount >= 100;\nSELECT * FROM orders WHERE amount BETWEEN 10 AND 100;\nSELECT * FROM orders WHERE customer_id IN (1, 3);\nSELECT * FROM customers WHERE name LIKE 'A%';       -- starts with A\nSELECT * FROM customers WHERE name LIKE '_a%';      -- second char is 'a'\nSELECT * FROM customers WHERE city IS NULL;\n",[22,748,749,773,795,817,844,876,902,927],{"__ignoreMap":35},[39,750,751,753,755,757,759,762,764,766,768,771],{"class":41,"line":42},[39,752,24],{"class":45},[39,754,148],{"class":45},[39,756,151],{"class":48},[39,758,55],{"class":45},[39,760,761],{"class":48}," customers ",[39,763,64],{"class":45},[39,765,446],{"class":48},[39,767,595],{"class":45},[39,769,770],{"class":221}," 'NYC'",[39,772,546],{"class":48},[39,774,775,777,779,781,783,785,787,790,793],{"class":41,"line":52},[39,776,24],{"class":45},[39,778,148],{"class":45},[39,780,125],{"class":45},[39,782,761],{"class":48},[39,784,64],{"class":45},[39,786,148],{"class":45},[39,788,789],{"class":45}," \u003C>",[39,791,792],{"class":221}," 'Alice'",[39,794,546],{"class":48},[39,796,797,799,801,803,806,808,810,812,815]