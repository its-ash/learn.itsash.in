},[86,1546,1547,1550,1552,1554,1556],{"class":88,"line":151},[86,1548,1549],{"class":92},"  PARTITION",[86,1551,134],{"class":92},[86,1553,137],{"class":99},[86,1555,58],{"class":92},[86,1557,980],{"class":99},[86,1559,1560,1562,1564,1566,1568,1570,1572],{"class":88,"line":391},[86,1561,985],{"class":92},[86,1563,988],{"class":92},[86,1565,991],{"class":92},[86,1567,994],{"class":92},[86,1569,997],{"class":92},[86,1571,991],{"class":92},[86,1573,1574],{"class":92}," FOLLOWING\n",[86,1576,1577],{"class":88,"line":423},[86,1578,565],{"class":99},[14,1580,1581,1582,1584],{},"Or use ",[23,1583,939],{}," with a descending order — cleaner for \"last value\":",[74,1586,1587],{"language":76},[78,1588,1590],{"className":80,"code":1589,"language":76,"meta":82,"style":82},"-- Customer's most recent amount — using FIRST_VALUE with DESC\nFIRST_VALUE(amount) OVER (PARTITION BY customer_id ORDER BY ordered_on DESC)\n",[23,1591,1592,1597],{"__ignoreMap":82},[86,1593,1594],{"class":88,"line":89},[86,1595,1596],{"class":331},"-- Customer's most recent amount — using FIRST_VALUE with DESC\n",[86,1598,1599,1601,1603,1605,1607,1609,1611,1613,1615,1618,1620],{"class":88,"line":96},[86,1600,939],{"class":118},[86,1602,122],{"class":99},[86,1604,125],{"class":92},[86,1606,128],{"class":99},[86,1608,131],{"class":92},[86,1610,134],{"class":92},[86,1612,137],{"class":99},[86,1614,58],{"class":92},[86,1616,1617],{"class":99}," ordered_on ",[86,1619,380],{"class":92},[86,1621,565],{"class":99},[28,1623,1625],{"id":1624},"window-naming-reusable-over-clauses","Window Naming (Reusable OVER Clauses)",[14,1627,1628,1629,1632,1633,1636],{},"If you repeat the same ",[23,1630,1631],{},"OVER (...)"," clause, name it with ",[23,1634,1635],{},"WINDOW"," and reference it:",[74,1638,1639],{"language":76},[78,1640,1642],{"className":80,"code":1641,"language":76,"meta":82,"style":82},"SELECT\n  customer_id, ordered_on, amount,\n  ROW_NUMBER() OVER cust_window AS rn,\n  SUM(amount)   OVER cust_window AS running_total,\n  AVG(amount)   OVER cust_window AS running_avg\nFROM orders\nWINDOW cust_window AS (PARTITION BY customer_id ORDER BY ordered_on);\n",[23,1643,1644,1648,1652,1667,1683,1699,1705],{"__ignoreMap":82},[86,1645,1646],{"class":88,"line":89},[86,1647,93],{"class":92},[86,1649,1650],{"class":88,"line":96},[86,1651,1434],{"class":99},[86,1653,1654,1656,1658,1660,1663,1665],{"class":88,"line":103},[86,1655,359],{"class":118},[86,1657,362],{"class":99},[86,1659,125],{"class":92},[86,1661,1662],{"class":99}," cust_window ",[86,1664,145],{"class":92},[86,1666,388],{"class":99},[86,1668,1669,1671,1674,1676,1678,1680],{"class":88,"line":109},[86,1670,119],{"class":118},[86,1672,1673],{"class":99},"(amount)   ",[86,1675,125],{"class":92},[86,1677,1662],{"class":99},[86,1679,145],{"class":92},[86,1681,1682],{"class":99}," running_total,\n",[86,1684,1685,1688,1690,1692,1694,1696],{"class":88,"line":115},[86,1686,1687],{"class":118},"  AVG",[86,1689,1673],{"class":99},[86,1691,125],{"class":92},[86,1693,1662],{"class":99},[86,1695,145],{"class":92},[86,1697,1698],{"class":99}," running_avg\n",[86,1700,1701,1703],{"class":88,"line":151},[86,1702,154],{"class":92},[86,1704,560],{"class":99},[86,1706,1707,1709,1711,1713,1715,1717,1719,1721,1723],{"class":88,"line":391},[86,1708,1635],{"class":92},[86,1710,1662],{"class":99},[86,1712,145],{"class":92},[86,1714,128],{"class":99},[86,1716,131],{"class":92},[86,1718,134],{"class":92},[86,1720,137],{"class":99},[86,1722,58],{"class":92},[86,1724,1725],{"class":99}," ordered_on);\n",[14,1727,1728,1730],{},[23,1729,1635],{}," clauses reduce repetition and make the query's partitioning strategy explicit.",[28,1732,1734],{"id":1733},"tips-tricks","💡 Tips & Tricks",[183,1736,1737,1759,1776,1798,1811],{},[39,1738,1739,1742,1743,1746,1747,1750,1751,1754,1755,1758],{},[42,1740,1741],{},"Idiom",": use ",[23,1744,1745],{},"ROW_NUMBER() OVER (PARTITION BY ... ORDER BY ...) AS rn"," + ",[23,1748,1749],{},"WHERE rn \u003C= N"," for \"top-N per group\" — it's the most portable and readable pattern, and unlike ",[23,1752,1753],{},"DISTINCT ON"," (PostgreSQL-only) or ",[23,1756,1757],{},"LATERAL"," (engine-specific), it works in every modern database.",[39,1760,1761,1764,1765,1768,1769,1771,1772,1775],{},[42,1762,1763],{},"Performance",": window functions require ",[42,1766,1767],{},"sorting"," the partition by the ",[23,1770,58],{}," key — if that key isn't indexed, the planner does an explicit sort (memory permitting, else disk spill). For large partitions, an index on ",[23,1773,1774],{},"(partition_cols..., order_col)"," lets the planner use an index scan and avoid the sort.",[39,1777,1778,1780,1781,1784,1785,1788,1789,1791,1792,1794,1795,1797],{},[42,1779,1741],{},": prefer ",[23,1782,1783],{},"FIRST_VALUE(x) OVER (... ORDER BY ... DESC)"," over ",[23,1786,1787],{},"LAST_VALUE(x) OVER (... ROWS BETWEEN ... UNBOUNDED FOLLOWING)"," for \"last value in partition\" — the ",[23,1790,939],{},"-with-",[23,1793,380],{}," form avoids the ",[23,1796,942],{}," default-frame trap and is one less clause to get wrong.",[39,1799,1800,1803,1804,1806,1807,1810],{},[42,1801,1802],{},"Debug",": when a running total looks wrong (jumps, repeats, or excludes the current row), check the frame — the default ",[23,1805,1195],{}," frame includes peers (ties), which can make the total \"jump\" at ties; switch to ",[23,1808,1809],{},"ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW"," for strict row-by-row accumulation.",[39,1812,1813,1742,1815,1818,1819,1821,1822,1825,1826,1829],{},[42,1814,1741],{},[23,1816,1817],{},"COUNT(*) OVER ()"," (empty ",[23,1820,125],{},") to attach a total row count to every row — handy for paginated APIs that need ",[23,1823,1824],{},"total_count"," alongside each page's rows, without a separate ",[23,1827,1828],{},"count(*)"," query.",[28,1831,1833],{"id":1832},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[183,1835,1836,1861,1890,1907,1922,1944,1968,1983,2008],{},[39,1837,1838,1843,1844,1846,1847,626,1849,626,1851,1854,1855,1857,1858,295],{},[42,1839,1840,1841],{},"Window functions can't appear in ",[23,1842,580],{},": they're computed ",[18,1845,1297],{}," ",[23,1848,580],{},[23,1850,25],{},[23,1852,1853],{},"HAVING"," (logically, in the ",[23,1856,570],{}," phase). Filter on window values in an outer query or CTE: ",[23,1859,1860],{},"WITH t AS (SELECT ..., ROW_NUMBER() OVER (...) AS rn FROM ...) SELECT * FROM t WHERE rn \u003C= 3",[39,1862,1863,1871,1872,1874,1875,1877,1878,1880,1881,1883,1884,1886,1887,1889],{},[42,1864,1865,1867,1868,1870],{},[23,1866,209],{}," vs ",[23,1869,482],{}," skip behavior",": ",[23,1873,209],{}," skips numbers after ties (1, 1, 3); ",[23,1876,482],{}," doesn't (1, 1, 2). The \"next rank\" after two ties is 3 with ",[23,1879,209],{},", 2 with ",[23,1882,482],{},". Pick based on whether you want \"how many rows are strictly ahead\" (",[23,1885,209],{}," - 1) or \"how many distinct values are ahead\" (",[23,1888,482],{}," - 1).",[39,1891,1892,1897,1898,1900,1901,1903,1904,49],{},[42,1893,1894,1896],{},[23,1895,205],{}," is non-deterministic on ties",": tied rows get distinct but arbitrary numbers (the planner picks). For stable, repeatable ",[23,1899,205],{},", add a unique tie-breaker to ",[23,1902,58],{}," (e.g., ",[23,1905,1906],{},"ORDER BY amount DESC, id",[39,1908,1909,1871,1916,1918,1919,1921],{},[42,1910,1911,626,1913,1915],{},[23,1912,933],{},[23,1914,936],{}," at partition boundaries",[23,1917,933],{}," at the first row of a partition returns NULL (no preceding row), not a value from the previous partition. Partitions are independent — ",[23,1920,933],{}," doesn't cross them.",[39,1923,1924,1935,1936,1938,1939,1941,1942,295],{},[42,1925,1926,1927,1929,1930,1932,1933],{},"Default frame with ",[23,1928,58],{}," is ",[23,1931,1195],{},", not ",[23,1934,1182],{},": this includes peers (rows with the same ",[23,1937,58],{}," value), so a running ",[23,1940,901],{}," over tied rows gives the same total for all tied rows. If you want strict per-row accumulation, use ",[23,1943,1809],{},[39,1945,1946,1951,1952,1955,1956,1958,1959,1962,1963,1746,1965,295],{},[42,1947,1948,1950],{},[23,1949,942],{}," default-frame trap",": the default frame ends at ",[23,1953,1954],{},"CURRENT ROW",", so ",[23,1957,942],{}," returns the current row's value. Always specify ",[23,1960,1961],{},"ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING"," for \"last in partition,\" or use ",[23,1964,939],{},[23,1966,1967],{},"ORDER BY ... DESC",[39,1969,1970,1975,1976,1978,1979,1982],{},[42,1971,1972,1973],{},"Window functions and ",[23,1974,25],{},": you can combine them — ",[23,1977,25],{}," collapses rows, then window functions operate over the grouped rows. ",[23,1980,1981],{},"SELECT customer_id, SUM(amount), RANK() OVER (ORDER BY SUM(amount) DESC) FROM orders GROUP BY customer_id"," ranks customers by their total — the window function sees the grouped output, not the raw rows.",[39,1984,1985,1871,1992,1994,1995,1997,1998,2000,2001,2003,2004,2007],{},[42,1986,1987,1867,1989],{},[23,1988,1817],{},[23,1990,1991],{},"COUNT(*)",[23,1993,1817],{}," returns the total row count as a column on every row; bare ",[23,1996,1991],{}," without ",[23,1999,125],{}," is an aggregate that collapses rows (illegal in a non-grouped ",[23,2002,570],{}," with other columns). The ",[23,2005,2006],{},"OVER ()"," is what makes it a window function.",[39,2009,2010,2013,2014,626,2016,2018],{},[42,2011,2012],{},"Empty partition",": a window function over a partition with zero rows simply produces no rows (the partition doesn't exist). Over a partition with one row, ",[23,2015,933],{},[23,2017,936],{}," return NULL.",[28,2020,2022],{"id":2021},"spot-the-bug","🧠 Spot the Bug",[14,2024,2025],{},"A developer computes a running total per customer, but for orders placed on the same day, the running total \"jumps ahead\" — the first of two same-day orders already shows the sum of both. Why?",[74,2027,2028],{"language":76},[78,2029,2031],{"className":80,"code":2030,"language":76,"meta":82,"style":82},"SELECT\n  customer_id,\n  ordered_on,\n  amount,\n  SUM(amount) OVER (\n    PARTITION BY customer_id\n    ORDER BY ordered_on\n  ) AS running_total\nFROM orders;\n",[23,2032,2033,2037,2041,2045,2049,2059,2069,2076,2085],{"__ignoreMap":82},[86,2034,2035],{"class":88,"line":89},[86,2036,93],{"class":92},[86,2038,2039],{"class":88,"line":96},[86,2040,100],{"class":99},[86,2042,2043],{"class":88,"line":103},[86,2044,106],{"class":99},[86,2046,2047],{"class":88,"line":109},[86,2048,112],{"class":99},[86,2050,2051,2053,2055,2057],{"class":88,"line":115},[86,2052,119],{"class":118},[86,2054,122],{"class":99},[86,2056,125],{"class":92},[86,2058,511],{"class":99},[86,2060,2061,2064,2066],{"class":88,"line":151},[86,2062,2063],{"class":92},"    PARTITION",[86,2065,134],{"class":92},[86,2067,2068],{"class":99}," customer_id\n",[86,2070,2071,2074],{"class":88,"line":391},[86,2072,2073],{"class":92},"    ORDER BY",[86,2075,980],{"class":99},[86,2077,2078,2081,2083],{"class":88,"line":423},[86,2079,2080],{"class":99},"  ) ",[86,2082,145],{"class":92},[86,2084,148],{"class":99},[86,2086,2087,2089],{"class":88,"line":454},[86,2088,154],{"class":92},[86,2090,157],{"class":99},[2092,2093,2094,2098,2137,2143,2220,2229],"details",{},[2095,2096,2097],"summary",{},"Answer",[14,2099,2100,2101,2103,2104,2108,2109,2111,2112,2114,2115,2117,2118,2121,2122,2124,2125,2128,2129,2132,2133,2136],{},"The default frame when ",[23,2102,58],{}," is present is ",[42,2105,2106],{},[23,2107,919],{},". ",[23,2110,1195],{}," (not ",[23,2113,1182],{},") treats the ",[23,2116,1954],{}," boundary as including all ",[42,2119,2120],{},"peer rows"," — rows with the same ",[23,2123,58],{}," value as the current row. So when two orders share the same ",[23,2126,2127],{},"ordered_on",", they're peers, and both include each other in their frame: the running total for the ",[18,2130,2131],{},"first"," same-day order already includes the ",[18,2134,2135],{},"second"," same-day order's amount (and vice versa). The running total \"jumps ahead\" within the tied group.",[14,2138,2139,2140,2142],{},"The fix: use ",[23,2141,1182],{}," (strict row-count semantics) so the frame is exactly \"from the partition start to this physical row\":",[78,2144,2146],{"className":80,"code":2145,"language":76,"meta":82,"style":82},"SELECT\n  customer_id,\n  ordered_on,\n  amount,\n  SUM(amount) OVER (\n    PARTITION BY customer_id\n    ORDER BY ordered_on\n    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n  ) AS running_total\nFROM orders;\n",[23,2147,2148,2152,2156,2160,2164,2174,2182,2188,2206,2214],{"__ignoreMap":82},[86,2149,2150],{"class":88,"line":89},[86,2151,93],{"class":92},[86,2153,2154],{"class":88,"line":96},[86,2155,100],{"class":99},[86,2157,2158],{"class":88,"line":103},[86,2159,106],{"class":99},[86,2161,2162],{"class":88,"line":109},[86,2163,112],{"class":99},[86,2165,2166,2168,2170,2172],{"class":88,"line":115},[86,2167,119],{"class":118},[86,2169,122],{"class":99},[86,2171,125],{"class":92},[86,2173,511],{"class":99},[86,2175,2176,2178,2180],{"class":88,"line":151},[86,2177,2063],{"class":92},[86,2179,134],{"class":92},[86,2181,2068],{"class":99},[86,2183,2184,2186],{"class":88,"line":391},[86,2185,2073],{"class":92},[86,2187,980],{"class":99},[86,2189,2190,2193,2195,2197,2199,2201,2203],{"class":88,"line":423},[86,2191,2192],{"class":92},"    ROWS",[86,2194,988],{"class":92},[86,2196,991],{"class":92},[86,2198,994],{"class":92},[86,2200,997],{"class":92},[86,2202,1000],{"class":99},[86,2204,2205],{"class":92},"ROW\n",[86,2207,2208,2210,2212],{"class":88,"line":454},[86,2209,2080],{"class":99},[86,2211,145],{"class":92},[86,2213,148],{"class":99},[86,2215,2216,2218],{"class":88,"line":612},[86,2217,154],{"class":92},[86,2219,157],{"class":99},[14,2221,2222,2223,2225,2226,49],{},"::\nWith ",[23,2224,1182],{},", each row's frame ends at that specific row, so the running total accumulates one row at a time, even across same-day orders. To make the row order deterministic within ties, add a tie-breaker (",[23,2227,2228],{},"ORDER BY ordered_on, id",[14,2230,2231,1871,2234,2236,2237,2239,2240,2242,2243,2245],{},[42,2232,2233],{},"The lesson",[23,2235,1195],{}," (the default) includes peers; ",[23,2238,1182],{}," doesn't. For running totals that should accumulate row-by-row, always specify ",[23,2241,1809],{}," — the default ",[23,2244,1195],{}," silently sums all tied rows together.",[28,2247,2248],{"id":2095},"Summary",[14,2250,2251,2252,626,2254,2256,2257,1867,2259,2261,2262,2264,2265,2267],{},"You can now rank rows, compute running totals and moving averages, compare rows with ",[23,2253,933],{},[23,2255,936],{},", and solve \"top-N per group\" — all without collapsing rows. You understand frames (",[23,2258,1182],{},[23,2260,1195],{},"), the ",[23,2263,942],{}," trap, and why ",[23,2266,205],{}," is the right tool for \"exactly N.\" Next: data types and the three-valued logic of NULL.",[2269,2270,2271],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}",{"title":82,"searchDepth":96,"depth":96,"links":2273},[2274,2275,2276,2279,2285,2288,2289,2290,2291,2292],{"id":30,"depth":96,"text":31},{"id":170,"depth":96,"text":171},{"id":222,"depth":96,"text":223,"children":2277},[2278],{"id":487,"depth":103,"text":488},{"id":874,"depth":96,"text":875,"children":2280},[2281,2283,2284],{"id":889,"depth":103,"text":2282},"Default frames (when ORDER BY is present)",{"id":946,"depth":103,"text":947},{"id":1154,"depth":103,"text":1155},{"id":1246,"depth":96,"text":1247,"children":2286},[2287],{"id":1473,"depth":103,"text":1474},{"id":1624,"depth":96,"text":1625},{"id":1733,"depth":96,"text":1734},{"id":1832,"depth":96,"text":1833},{"id":2021,"depth":96,"text":2022},{"id":2095,"depth":96,"text":2248},"Window functions perform calculations across a set of rows related to the current row, without collapsing them like GROUP BY does. They are the most powerful analytical feature in SQL — ranking, running totals, moving averages, lead\u002Flag comparisons, and \"top-N per group\" all become one-liners.","md",{},"\u002Fsql\u002F09-window-functions",{"title":5,"description":2293},"sql\u002F09-window-functions","QYSbGNCwVeS8swujO_F6WuefbhMA-bknPFGAGZv2r9c",1787401244996]