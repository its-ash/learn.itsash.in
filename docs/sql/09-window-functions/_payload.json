[{"data":1,"prerenderedAt":2300},["ShallowReactive",2],{"page-\u002Fsql\u002F09-window-functions":3},{"id":4,"title":5,"body":6,"description":2293,"extension":2294,"meta":2295,"navigation":608,"path":2296,"seo":2297,"stem":2298,"__hash__":2299},"content\u002Fsql\u002F09-window-functions.md","09 — Window Functions",{"type":7,"value":8,"toc":2272},"minimark",[9,13,27,32,35,73,158,168,172,182,220,224,320,459,466,484,489,492,2268],[10,11,5],"h1",{"id":12},"_09-window-functions",[14,15,16,17,21,22,26],"p",{},"Window functions perform calculations across a set of rows ",[18,19,20],"em",{},"related to the current row",", without collapsing them like ",[23,24,25],"code",{},"GROUP BY"," does. They are the most powerful analytical feature in SQL — ranking, running totals, moving averages, lead\u002Flag comparisons, and \"top-N per group\" all become one-liners.",[28,29,31],"h2",{"id":30},"the-core-idea","The Core Idea",[14,33,34],{},"A window function:",[36,37,38,50,59,66],"ol",{},[39,40,41,45,46,49],"li",{},[42,43,44],"strong",{},"Partitions"," the result set into groups (",[23,47,48],{},"PARTITION BY",").",[39,51,52,55,56,49],{},[42,53,54],{},"Orders"," each partition (",[23,57,58],{},"ORDER BY",[39,60,61,62,65],{},"Defines a ",[42,63,64],{},"frame"," (the subset of rows used for the current calculation).",[39,67,68,69,72],{},"Computes a value per row, ",[42,70,71],{},"keeping all rows"," in the output (no collapse).",[74,75,77],"code-wrapper",{"language":76},"sql",[78,79,83],"pre",{"className":80,"code":81,"language":76,"meta":82,"style":82},"language-sql shiki shiki-themes github-light github-dark","SELECT\n  customer_id,\n  ordered_on,\n  amount,\n  SUM(amount) OVER (PARTITION BY customer_id ORDER BY ordered_on) AS running_total\nFROM orders;\n","",[23,84,85,94,101,107,113,149],{"__ignoreMap":82},[86,87,90],"span",{"class":88,"line":89},"line",1,[86,91,93],{"class":92},"svdQ7","SELECT\n",[86,95,97],{"class":88,"line":96},2,[86,98,100],{"class":99},"ssxIu","  customer_id,\n",[86,102,104],{"class":88,"line":103},3,[86,105,106],{"class":99},"  ordered_on,\n",[86,108,110],{"class":88,"line":109},4,[86,111,112],{"class":99},"  amount,\n",[86,114,116,120,123,126,129,132,135,138,140,143,146],{"class":88,"line":115},5,[86,117,119],{"class":118},"snvgF","  SUM",[86,121,122],{"class":99},"(amount) ",[86,124,125],{"class":92},"OVER",[86,127,128],{"class":99}," (",[86,130,131],{"class":92},"PARTITION",[86,133,134],{"class":92}," BY",[86,136,137],{"class":99}," customer_id ",[86,139,58],{"class":92},[86,141,142],{"class":99}," ordered_on) ",[86,144,145],{"class":92},"AS",[86,147,148],{"class":99}," running_total\n",[86,150,152,155],{"class":88,"line":151},6,[86,153,154],{"class":92},"FROM",[86,156,157],{"class":99}," orders;\n",[14,159,160,161,164,165,167],{},"This computes a running total of ",[23,162,163],{},"amount"," per customer, ordered by date — and every original row appears in the output with its running total alongside. ",[23,166,25],{}," would collapse each customer into one row; the window function keeps them all.",[28,169,171],{"id":170},"anatomy-of-a-window-function","Anatomy of a Window Function",[74,173,175],{"language":174},"text",[78,176,180],{"className":177,"code":179,"language":174,"meta":82},[178],"language-text","function(args) OVER (\n  [PARTITION BY ...]     -- groups; default = whole result set\n  [ORDER BY ...]         -- order within each partition; default = unspecified\n  [frame_clause]         -- which rows to include; default depends on the function\n)\n",[23,181,179],{"__ignoreMap":82},[183,184,185,192,214],"ul",{},[39,186,187,191],{},[42,188,189],{},[23,190,48],{}," — divides rows into independent groups. Omit it and the whole result set is one partition.",[39,193,194,198,199,202,203,206,207,210,211,213],{},[42,195,196],{},[23,197,58],{}," — orders rows ",[18,200,201],{},"within"," each partition. For ranking functions (",[23,204,205],{},"ROW_NUMBER",", ",[23,208,209],{},"RANK","), it's essential. For pure aggregates without ",[23,212,58],{},", the frame is the whole partition.",[39,215,216,219],{},[42,217,218],{},"Frame"," — defines the window's row range. Defaults differ by function (see below).",[28,221,223],{"id":222},"ranking-functions","Ranking Functions",[225,226,227,240],"table",{},[228,229,230],"thead",{},[231,232,233,237],"tr",{},[234,235,236],"th",{},"Function",[234,238,239],{},"Behavior on ties",[241,242,243,254,268,282,296,306],"tbody",{},[231,244,245,251],{},[246,247,248],"td",{},[23,249,250],{},"ROW_NUMBER()",[246,252,253],{},"Unique sequential number — ties get arbitrary but distinct numbers.",[231,255,256,261],{},[246,257,258],{},[23,259,260],{},"RANK()",[246,262,263,264,267],{},"Same rank for ties, then ",[42,265,266],{},"skips"," (1, 1, 3).",[231,269,270,275],{},[246,271,272],{},[23,273,274],{},"DENSE_RANK()",[246,276,277,278,281],{},"Same rank for ties, ",[42,279,280],{},"no skip"," (1, 1, 2).",[231,283,284,289],{},[246,285,286],{},[23,287,288],{},"PERCENT_RANK()",[246,290,291,292,295],{},"Relative rank as a fraction: ",[23,293,294],{},"(rank - 1) \u002F (total - 1)",".",[231,297,298,303],{},[246,299,300],{},[23,301,302],{},"CUME_DIST()",[246,304,305],{},"Cumulative distribution: rows with a value ≤ current \u002F total.",[231,307,308,313],{},[246,309,310],{},[23,311,312],{},"NTILE(n)",[246,314,315,316,319],{},"Divides partition into ",[23,317,318],{},"n"," equal-ish buckets; returns bucket number.",[74,321,322],{"language":76},[78,323,325],{"className":80,"code":324,"language":76,"meta":82,"style":82},"-- Rank orders by amount within each customer\nSELECT\n  customer_id,\n  id AS order_id,\n  amount,\n  ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC) AS rn,\n  RANK()       OVER (PARTITION BY customer_id ORDER BY amount DESC) AS rnk,\n  DENSE_RANK() OVER (PARTITION BY customer_id ORDER BY amount DESC) AS drnk\nFROM orders;\n",[23,326,327,333,337,341,351,355,389,421,452],{"__ignoreMap":82},[86,328,329],{"class":88,"line":89},[86,330,332],{"class":331},"sdCPZ","-- Rank orders by amount within each customer\n",[86,334,335],{"class":88,"line":96},[86,336,93],{"class":92},[86,338,339],{"class":88,"line":103},[86,340,100],{"class":99},[86,342,343,346,348],{"class":88,"line":109},[86,344,345],{"class":99},"  id ",[86,347,145],{"class":92},[86,349,350],{"class":99}," order_id,\n",[86,352,353],{"class":88,"line":115},[86,354,112],{"class":99},[86,356,357,360,363,365,367,369,371,373,375,378,381,384,386],{"class":88,"line":151},[86,358,359],{"class":118},"  ROW_NUMBER",[86,361,362],{"class":99},"() ",[86,364,125],{"class":92},[86,366,128],{"class":99},[86,368,131],{"class":92},[86,370,134],{"class":92},[86,372,137],{"class":99},[86,374,58],{"class":92},[86,376,377],{"class":99}," amount ",[86,379,380],{"class":92},"DESC",[86,382,383],{"class":99},") ",[86,385,145],{"class":92},[86,387,388],{"class":99}," rn,\n",[86,390,392,395,398,400,402,404,406,408,410,412,414,416,418],{"class":88,"line":391},7,[86,393,394],{"class":118},"  RANK",[86,396,397],{"class":99},"()       ",[86,399,125],{"class":92},[86,401,128],{"class":99},[86,403,131],{"class":92},[86,405,134],{"class":92},[86,407,137],{"class":99},[86,409,58],{"class":92},[86,411,377],{"class":99},[86,413,380],{"class":92},[86,415,383],{"class":99},[86,417,145],{"class":92},[86,419,420],{"class":99}," rnk,\n",[86,422,424,427,429,431,433,435,437,439,441,443,445,447,449],{"class":88,"line":423},8,[86,425,426],{"class":118},"  DENSE_RANK",[86,428,362],{"class":99},[86,430,125],{"class":92},[86,432,128],{"class":99},[86,434,131],{"class":92},[86,436,134],{"class":92},[86,438,137],{"class":99},[86,440,58],{"class":92},[86,442,377],{"class":99},[86,444,380],{"class":92},[86,446,383],{"class":99},[86,448,145],{"class":92},[86,450,451],{"class":99}," drnk\n",[86,453,455,457],{"class":88,"line":454},9,[86,456,154],{"class":92},[86,458,157],{"class":99},[14,460,461,462,465],{},"If a customer has orders ",[23,463,464],{},"[450, 100, 100, 50]",":",[183,467,468,473,478],{},[39,469,470,472],{},[23,471,205],{},": 1, 2, 3, 4 (ties get distinct arbitrary numbers)",[39,474,475,477],{},[23,476,209],{},": 1, 2, 2, 4 (skips 3)",[39,479,480,483],{},[23,481,482],{},"DENSE_RANK",": 1, 2, 2, 3 (no skip)",[485,486,488],"h3",{"id":487},"top-n-per-group","Top-N per group",[14,490,491],{},"The canonical pattern — find the top 3 orders per customer:",[74,493,494,853,856,872,876,879,887,894,944,948,1152,1156,1223,1244,1248,1328,1471,1475,1491,1494,1579,1585,1622,1626,1637,1726,1731,1735,1830,1834,2019,2023,2026,2091,2246,2249],{"language":76},[78,495,497],{"className":80,"code":496,"language":76,"meta":82,"style":82},"WITH ranked AS (\n  SELECT *,\n    ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC) AS rn\n  FROM orders\n)\nSELECT * FROM ranked WHERE rn \u003C= 3;\n``\n::\n\n`ROW_NUMBER` (not `RANK`\u002F`DENSE_RANK`) is the right choice for \"exactly N\" — it never produces ties, so `rn \u003C= 3` returns exactly 3 rows per partition (or fewer if the partition is smaller).\n\n## Aggregate Functions as Windows\n\nAny aggregate (`SUM`, `AVG`, `MIN`, `MAX`, `COUNT`) can be a window function with `OVER`:\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- Each order alongside its customer's total and the overall average\nSELECT\n  id,\n  customer_id,\n  amount,\n  SUM(amount) OVER (PARTITION BY customer_id) AS customer_total,\n  AVG(amount) OVER ()                       AS overall_avg\nFROM orders;\n",[23,498,499,512,523,553,561,566,593,599,604,610,696,701,719,724,776,781,802,808,814,819,825,830,835,841,847],{"__ignoreMap":82},[86,500,501,504,507,509],{"class":88,"line":89},[86,502,503],{"class":92},"WITH",[86,505,506],{"class":99}," ranked ",[86,508,145],{"class":92},[86,510,511],{"class":99}," (\n",[86,513,514,517,520],{"class":88,"line":96},[86,515,516],{"class":92},"  SELECT",[86,518,519],{"class":92}," *",[86,521,522],{"class":99},",\n",[86,524,525,528,530,532,534,536,538,540,542,544,546,548,550],{"class":88,"line":103},[86,526,527],{"class":118},"    ROW_NUMBER",[86,529,362],{"class":99},[86,531,125],{"class":92},[86,533,128],{"class":99},[86,535,131],{"class":92},[86,537,134],{"class":92},[86,539,137],{"class":99},[86,541,58],{"class":92},[86,543,377],{"class":99},[86,545,380],{"class":92},[86,547,383],{"class":99},[86,549,145],{"class":92},[86,551,552],{"class":99}," rn\n",[86,554,555,558],{"class":88,"line":109},[86,556,557],{"class":92},"  FROM",[86,559,560],{"class":99}," orders\n",[86,562,563],{"class":88,"line":115},[86,564,565],{"class":99},")\n",[86,567,568,571,573,576,578,581,584,587,590],{"class":88,"line":151},[86,569,570],{"class":92},"SELECT",[86,572,519],{"class":92},[86,574,575],{"class":92}," FROM",[86,577,506],{"class":99},[86,579,580],{"class":92},"WHERE",[86,582,583],{"class":99}," rn ",[86,585,586],{"class":92},"\u003C=",[86,588,589],{"class":118}," 3",[86,591,592],{"class":99},";\n",[86,594,595],{"class":88,"line":391},[86,596,598],{"class":597},"sJ6F3","``\n",[86,600,601],{"class":88,"line":423},[86,602,603],{"class":99},"::\n",[86,605,606],{"class":88,"line":454},[86,607,609],{"emptyLinePlaceholder":608},true,"\n",[86,611,613,616,618,621,624,627,630,632,635,638,641,644,647,650,653,656,659,662,665,668,671,674,676,679,682,685,688,690,693],{"class":88,"line":612},10,[86,614,615],{"class":597},"`ROW_NUMBER`",[86,617,128],{"class":99},[86,619,620],{"class":92},"not",[86,622,623],{"class":597}," `RANK`",[86,625,626],{"class":92},"\u002F",[86,628,629],{"class":597},"`DENSE_RANK`",[86,631,383],{"class":99},[86,633,634],{"class":92},"is",[86,636,637],{"class":99}," the right choice ",[86,639,640],{"class":92},"for",[86,642,643],{"class":597}," \"exactly N\"",[86,645,646],{"class":99}," — it ",[86,648,649],{"class":92},"never",[86,651,652],{"class":99}," produces ties, so ",[86,654,655],{"class":597},"`rn \u003C= 3`",[86,657,658],{"class":92}," returns",[86,660,661],{"class":99}," exactly ",[86,663,664],{"class":118},"3",[86,666,667],{"class":92}," rows",[86,669,670],{"class":99}," per ",[86,672,673],{"class":92},"partition",[86,675,128],{"class":99},[86,677,678],{"class":92},"or",[86,680,681],{"class":99}," fewer ",[86,683,684],{"class":92},"if",[86,686,687],{"class":99}," the ",[86,689,673],{"class":92},[86,691,692],{"class":92}," is",[86,694,695],{"class":99}," smaller).\n",[86,697,699],{"class":88,"line":698},11,[86,700,609],{"emptyLinePlaceholder":608},[86,702,704,707,710,713,716],{"class":88,"line":703},12,[86,705,706],{"class":99},"## ",[86,708,709],{"class":92},"Aggregate",[86,711,712],{"class":99}," Functions ",[86,714,715],{"class":92},"as",[86,717,718],{"class":92}," Windows\n",[86,720,722],{"class":88,"line":721},13,[86,723,609],{"emptyLinePlaceholder":608},[86,725,727,730,733,735,738,740,743,745,748,750,753,755,758,761,764,767,770,773],{"class":88,"line":726},14,[86,728,729],{"class":99},"Any ",[86,731,732],{"class":92},"aggregate",[86,734,128],{"class":99},[86,736,737],{"class":597},"`SUM`",[86,739,206],{"class":99},[86,741,742],{"class":597},"`AVG`",[86,744,206],{"class":99},[86,746,747],{"class":597},"`MIN`",[86,749,206],{"class":99},[86,751,752],{"class":597},"`MAX`",[86,754,206],{"class":99},[86,756,757],{"class":597},"`COUNT`",[86,759,760],{"class":99},") can be a ",[86,762,763],{"class":92},"window",[86,765,766],{"class":92}," function",[86,768,769],{"class":92}," with",[86,771,772],{"class":597}," `OVER`",[86,774,775],{"class":99},":\n",[86,777,779],{"class":88,"line":778},15,[86,780,609],{"emptyLinePlaceholder":608},[86,782,784,787,790,793,796,799],{"class":88,"line":783},16,[86,785,786],{"class":99},"::code",[86,788,789],{"class":92},"-",[86,791,792],{"class":99},"wrapper{",[86,794,795],{"class":92},"language=",[86,797,798],{"class":597},"\"sql\"",[86,800,801],{"class":99},"}\n",[86,803,805],{"class":88,"line":804},17,[86,806,807],{"class":597},"```sql\n",[86,809,811],{"class":88,"line":810},18,[86,812,813],{"class":597},"-- Each order alongside its customer's total and the overall average\n",[86,815,817],{"class":88,"line":816},19,[86,818,93],{"class":597},[86,820,822],{"class":88,"line":821},20,[86,823,824],{"class":597},"  id,\n",[86,826,828],{"class":88,"line":827},21,[86,829,100],{"class":597},[86,831,833],{"class":88,"line":832},22,[86,834,112],{"class":597},[86,836,838],{"class":88,"line":837},23,[86,839,840],{"class":597},"  SUM(amount) OVER (PARTITION BY customer_id) AS customer_total,\n",[86,842,844],{"class":88,"line":843},24,[86,845,846],{"class":597},"  AVG(amount) OVER ()                       AS overall_avg\n",[86,848,850],{"class":88,"line":849},25,[86,851,852],{"class":597},"FROM orders;\n",[14,854,855],{},"::",[14,857,858,859,861,862,864,865,868,869,871],{},"Without ",[23,860,58],{}," in the ",[23,863,125],{},", the frame is the ",[42,866,867],{},"entire partition"," — every row gets the same value (the partition total). With ",[23,870,58],{},", the default frame becomes \"from the partition start to the current row,\" enabling running totals.",[28,873,875],{"id":874},"frames","Frames",[14,877,878],{},"The frame specifies which rows the function sees, relative to the current row. The full syntax:",[74,880,881],{"language":174},[78,882,885],{"className":883,"code":884,"language":174,"meta":82},[178],"{ROWS | RANGE | GROUPS} BETWEEN \u003Cstart> AND \u003Cend>\n  \u003Cstart>\u002F\u003Cend> := UNBOUNDED PRECEDING | \u003Cn> PRECEDING | CURRENT ROW | \u003Cn> FOLLOWING | UNBOUNDED FOLLOWING\n",[23,886,884],{"__ignoreMap":82},[485,888,890,891,893],{"id":889},"default-frames-when-order-by-is-present","Default frames (when ",[23,892,58],{}," is present)",[183,895,896,921,929],{},[39,897,898,899,206,902,206,905,206,908,206,911,914,915,920],{},"For ",[23,900,901],{},"SUM",[23,903,904],{},"AVG",[23,906,907],{},"MIN",[23,909,910],{},"MAX",[23,912,913],{},"COUNT"," — ",[42,916,917],{},[23,918,919],{},"RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW"," (a running aggregate, including all peers with the same order key as the current row).",[39,922,923,924,206,926,928],{},"For ranking functions (",[23,925,205],{},[23,927,209],{},", etc.) — the whole partition (frame is irrelevant; they use the order, not a frame).",[39,930,898,931,626,934,626,937,626,940,943],{},[23,932,933],{},"LAG",[23,935,936],{},"LEAD",[23,938,939],{},"FIRST_VALUE",[23,941,942],{},"LAST_VALUE"," — the whole partition.",[485,945,947],{"id":946},"common-frame-patterns","Common frame patterns",[74,949,950],{"language":76},[78,951,953],{"className":80,"code":952,"language":76,"meta":82,"style":82},"-- Running total (sum from partition start to current row)\nSUM(amount) OVER (PARTITION BY customer_id ORDER BY ordered_on\n  ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)\n\n-- Running total excluding the current row\nSUM(amount) OVER (PARTITION BY customer_id ORDER BY ordered_on\n  ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING)\n\n-- Moving average over a 3-row window (current + 1 before + 1 after)\nAVG(amount) OVER (ORDER BY ordered_on\n  ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING)\n\n-- Sum of the whole partition (same for every row)\nSUM(amount) OVER (PARTITION BY customer_id)\n\n-- Cumulative sum up to and including all peers (default RANGE behavior)\nSUM(amount) OVER (PARTITION BY customer_id ORDER BY ordered_on)\n",[23,954,955,960,981,1006,1010,1015,1035,1054,1058,1063,1077,1096,1100,1105,1122,1126,1131],{"__ignoreMap":82},[86,956,957],{"class":88,"line":89},[86,958,959],{"class":331},"-- Running total (sum from partition start to current row)\n",[86,961,962,964,966,968,970,972,974,976,978],{"class":88,"line":96},[86,963,901],{"class":118},[86,965,122],{"class":99},[86,967,125],{"class":92},[86,969,128],{"class":99},[86,971,131],{"class":92},[86,973,134],{"class":92},[86,975,137],{"class":99},[86,977,58],{"class":92},[86,979,980],{"class":99}," ordered_on\n",[86,982,983,986,989,992,995,998,1001,1004],{"class":88,"line":103},[86,984,985],{"class":92},"  ROWS",[86,987,988],{"class":92}," BETWEEN",[86,990,991],{"class":92}," UNBOUNDED",[86,993,994],{"class":92}