why a running total over ties gives the same value for all tied rows. Use ",[23,1242,1182],{}," for strict row-count semantics (one row per step).",[28,1245,1247],{"id":1246},"value-functions","Value Functions",[225,1249,1250,1259],{},[228,1251,1252],{},[231,1253,1254,1256],{},[234,1255,236],{},[234,1257,1258],{},"Returns",[241,1260,1261,1282,1298,1308,1318],{},[231,1262,1263,1268],{},[246,1264,1265],{},[23,1266,1267],{},"LAG(col, n, default)",[246,1269,1270,1271,1274,1275,1277,1278,1281],{},"Value of ",[23,1272,1273],{},"col"," from ",[23,1276,318],{}," rows ",[42,1279,1280],{},"before"," the current row (within the partition\u002Forder).",[231,1283,1284,1289],{},[246,1285,1286],{},[23,1287,1288],{},"LEAD(col, n, default)",[246,1290,1270,1291,1274,1293,1277,1295,295],{},[23,1292,1273],{},[23,1294,318],{},[42,1296,1297],{},"after",[231,1299,1300,1305],{},[246,1301,1302],{},[23,1303,1304],{},"FIRST_VALUE(col)",[246,1306,1307],{},"First value in the frame.",[231,1309,1310,1315],{},[246,1311,1312],{},[23,1313,1314],{},"LAST_VALUE(col)",[246,1316,1317],{},"Last value in the frame (⚠️ see below).",[231,1319,1320,1325],{},[246,1321,1322],{},[23,1323,1324],{},"NTH_VALUE(col, n)",[246,1326,1327],{},"Nth value in the frame.",[74,1329,1330],{"language":76},[78,1331,1333],{"className":80,"code":1332,"language":76,"meta":82,"style":82},"-- Day-over-day change in amount\nSELECT\n  ordered_on,\n  amount,\n  amount - LAG(amount) OVER (ORDER BY ordered_on) AS daily_delta,\n  amount - LAG(amount, 1, 0) OVER (ORDER BY ordered_on) AS delta_with_default\nFROM orders;\n\n-- Compare each order to the customer's first order\nSELECT\n  customer_id, ordered_on, amount,\n  amount - FIRST_VALUE(amount) OVER (PARTITION BY customer_id ORDER BY ordered_on) AS diff_from_first\nFROM orders;\n",[23,1334,1335,1340,1344,1348,1352,1377,1411,1417,1421,1426,1430,1435,1465],{"__ignoreMap":82},[86,1336,1337],{"class":88,"line":89},[86,1338,1339],{"class":331},"-- Day-over-day change in amount\n",[86,1341,