`",[120,1477,563],{"class":133},[120,1479,1480],{"class":287},"`EXCEPT ALL`",[120,1482,1483],{"class":137}," are PostgreSQL",[120,1485,473],{"class":133},[120,1487,1488],{"class":137},"specific. ",[120,1490,388],{"class":133},[120,1492,1493],{"class":137}," you need multiplicity",[120,1495,473],{"class":133},[120,1497,1498],{"class":137},"preserving ",[120,1500,1501],{"class":133},"set",[120,1503,1504],{"class":137}," ops portably, ",[120,1506,730],{"class":133},[120,1508,1509],{"class":287}," `JOIN`",[120,1511,1235],{"class":133},[120,1513,1514],{"class":287}," `GROUP BY`",[120,1516,1426],{"class":133},[120,1518,1519],{"class":287}," `count()`",[120,1521,1522],{"class":137}," comparisons.\n",[120,1524,1525,1527,1529,1532,1534,1536,1539,1541,1543,1546,1549,1552,1554,1557,1559,1561,1564,1566,1568,1571,1573,1575,1578,1580,1583,1586,1589,1591,1593,1595,1598,1600,1603,1606,1609,1611],{"class":122,"line":323},[120,1526,473],{"class":133},[120,1528,1268],{"class":133},[120,1530,1531],{"class":137},"Debug",[120,1533,341],{"class":133},[120,1535,1276],{"class":137},[120,1537,1538],{"class":133},"if",[120,1540,1217],{"class":137},[120,1542,1501],{"class":133},[120,1544,1545],{"class":137}," operation ",[120,1547,1548],{"class":133},"returns",[120,1550,1551],{"class":137}," fewer ",[120,1553,20],{"class":133},[120,1555,1556],{"class":137}," than expected, suspect an unexpected duplicate collapse — ",[120,1558,326],{"class":287},[120,1560,563],{"class":133},[120,1562,1563],{"class":287},"`INTERSECT`",[120,1565,563],{"class":133},[120,1567,1454],{"class":287},[120,1569,1570],{"class":137}," dedup silently. Switch ",[120,1572,1399],{"class":133},[120,1574,405],{"class":287},[120,1576,1577],{"class":137}," temporarily ",[120,1579,1399],{"class":133},[120,1581,1582],{"class":137}," see the ",[120,1584,1585],{"class":133},"raw",[120,1587,1588],{"class":137}," combined ",[120,1590,20],{"class":133},[120,1592,593],{"class":137},[120,1594,347],{"class":133},[120,1596,1597],{"class":133}," add",[120,1599,1217],{"class":137},[120,1601,1602],{"class":133},"unique",[120,1604,1605],{"class":133}," row",[120,1607,1608],{"class":137}," identifier ",[120,1610,1399],{"class":133},[120,1612,1613],{"class":137}," make duplicates visible.\n",[120,1615,1616,1618,1620,1622,1624,1626,1628,1631,1633,1636,1638,1641,1644,1647,1650,1653,1656,1659,1662,1664,1666,1669,1672,1674,1677,1680,1683,1686,1689,1692,1694,1697,1699,1702],{"class":122,"line":380},[120,1617,473],{"class":133},[120,1619,1268],{"class":133},[120,1621,1362],{"class":137},[120,1623,341],{"class":133},[120,1625,1276],{"class":137},[120,1627,1298],{"class":133},[120,1629,1630],{"class":137}," comparing two tables ",[120,1632,1417],{"class":133},[120,1634,1635],{"class":137}," equality, ",[120,1637,730],{"class":133},[120,1639,1640],{"class":287}," `EXCEPT`",[120,1642,1643],{"class":133}," in",[120,1645,1646],{"class":133}," both",[120,1648,1649],{"class":137}," directions rather than ",[120,1651,1652],{"class":287},"`count(*)`",[120,1654,1655],{"class":137}," — counts can ",[120,1657,1658],{"class":133},"match",[120,1660,1661],{"class":133}," while",[120,1663,1229],{"class":137},[120,1665,1405],{"class":133},[120,1667,1668],{"class":137}," contents differ. ",[120,1670,1671],{"class":287},"`(SELECT * FROM A EXCEPT SELECT * FROM B) UNION ALL (SELECT * FROM B EXCEPT SELECT * FROM A)`",[120,1673,1457],{"class":133},[120,1675,1676],{"class":133}," empty",[120,1678,1679],{"class":137}," iff A ",[120,1681,1682],{"class":133},"=",[120,1684,1685],{"class":137}," B (",[120,1687,1688],{"class":133},"as",[120,1690,1691],{"class":137}," multisets ",[120,1693,1538],{"class":133},[120,1695,1696],{"class":137}," you ",[120,1698,730],{"class":133},[120,1700,1701],{"class":287}," `EXCEPT ALL`",[120,1703,377],{"class":137},[120,1705,1706],{"class":122,"line":385},[120,1707,169],{"emptyLinePlaceholder":168},[120,1709,1710],{"class":122,"line":414},[120,1711,1712],{"class":137},"## ⚠️ Edge Cases & Gotchas\n",[120,1714,1715],{"class":122,"line":419},[120,1716,169],{"emptyLinePlaceholder":168},[120,1718,1719,1721,1723,1725,1727,1729,1732,1735,1738,1741,1743,1746,1748,1751,1754,1757,1759,1762,1764,1766,1768,1770,1773,1776,1778,1781,1783,1785],{"class":122,"line":425},[120,1720,473],{"class":133},[120,1722,1268],{"class":133},[120,1724,326],{"class":287},[120,1726,1348],{"class":137},[120,1728,1193],{"class":133},[120,1730,1731],{"class":133}," global**",[120,1733,1734],{"class":137},": it dedups across the combined result, ",[120,1736,1737],{"class":133},"not",[120,1739,1740],{"class":137}," per",[120,1742,473],{"class":133},[120,1744,1745],{"class":137},"input. ",[120,1747,388],{"class":133},[120,1749,1750],{"class":287}," `customers`",[120,1752,1753],{"class":137}," has ",[120,1755,1756],{"class":287},"`'NYC'`",[120,1758,1426],{"class":133},[120,1760,1761],{"class":287}," `suppliers`",[120,1763,1753],{"class":137},[120,1765,1756],{"class":287},[120,1767,593],{"class":137},[120,1769,326],{"class":287},[120,1771,1772],{"class":133}," returns",[120,1774,1775],{"class":137}," one ",[120,1777,1756],{"class":287},[120,1779,1780],{"class":137},"; ",[120,1782,367],{"class":287},[120,1784,1772],{"class":133},[120,1786,1787],{"class":137}," two.\n",[120,1789,1790,1792,1794,1797,1799,1801,1804,1807,1809,1811,1814,1817,1819,1822,1824,1826,1829,1831,1833,1836,1839,1842,1845,1847,1850,1853],{"class":122,"line":430},[120,1791,473],{"class":133},[120,1793,1268],{"class":133},[120,1795,1796],{"class":137},"Column names come ",[120,1798,1411],{"class":133},[120,1800,1229],{"class":137},[120,1802,1803],{"class":133},"first",[120,1805,1806],{"class":137}," input",[120,1808,341],{"class":133},[120,1810,1276],{"class":137},[120,1812,1813],{"class":287},"`SELECT a AS x FROM t1 UNION SELECT b AS y FROM t2`",[120,1815,1816],{"class":137}," — the result column ",[120,1818,1193],{"class":133},[120,1820,1821],{"class":287}," `x`",[120,1823,593],{"class":137},[120,1825,1737],{"class":133},[120,1827,1828],{"class":287}," `y`",[120,1830,1472],{"class":137},[120,1832,388],{"class":133},[120,1834,1835],{"class":137}," you need a specific ",[120,1837,1838],{"class":133},"name",[120,1840,1841],{"class":137},", alias it ",[120,1843,1844],{"class":133},"in",[120,1846,1229],{"class":137},[120,1848,1849],{"class":133},"*first*",[120,1851,1852],{"class":287}," `SELECT`",[120,1854,1855],{"class":137},".\n",[120,1857,1858,1860,1863,1866,1868,1871,1874,1876,1878,1881,1884,1886,1889,1892,1895,1898,1901,1904,1906,1909,1911,1914],{"class":122,"line":436},[120,1859,473],{"class":133},[120,1861,1862],{"class":133}," **Type",[120,1864,1865],{"class":137}," coercion ",[120,1867,1844],{"class":133},[120,1869,1870],{"class":133}," set",[120,1872,1873],{"class":137}," ops",[120,1875,341],{"class":133},[120,1877,1276],{"class":137},[120,1879,1880],{"class":287},"`SELECT 1 UNION SELECT '1'`",[120,1882,1883],{"class":137}," may coerce ",[120,1885,1399],{"class":133},[120,1887,1888],{"class":133}," text",[120,1890,1891],{"class":133}," or",[120,1893,1894],{"class":133}," integer",[120,1896,1897],{"class":137}," depending ",[120,1899,1900],{"class":133},"on",[120,1902,1903],{"class":137}," the engine. PostgreSQL ",[120,1905,1193],{"class":133},[120,1907,1908],{"class":137}," strict",[120,1910,473],{"class":133},[120,1912,1913],{"class":137},"ish (it",[120,1915,1916],{"class":287},"'ll try to coerce, sometimes failing); MySQL is lenient. Keep types consistent across branches.\n",[120,1918,1919,1922,1925,1927,1929,1932,1935],{"class":122,"line":441},[120,1920,1921],{"class":287},"- **`ORDER BY` column names must match the first input**: `ORDER BY` after a set operation references the first input'",[120,1923,1924],{"class":137},"s column names. ",[120,1926,388],{"class":133},[120,1928,1229],{"class":137},[120,1930,1931],{"class":133},"second",[120,1933,1934],{"class":137}," input named the column differently, you can",[120,1936,1937],{"class":287},"'t sort by that name.\n",[120,1939,1940],{"class":122,"line":447},[120,1941,1942],{"class":287},"- **`NULL` comparison in set ops**: set operations treat NULLs as equal for dedup — `(1, NULL)` in both inputs is considered a duplicate and `UNION` keeps one. This differs from `NULL = NULL` being UNKNOWN in `WHERE` — set ops use \"is not distinct from\" semantics.\n",[120,1944,1945],{"class":122,"line":453},[120,1946,1947],{"class":287},"- **`INTERSECT`\u002F`EXCEPT` precedence**: `INTERSECT` binds tighter than `UNION`\u002F`EXCEPT`. `A UNION B INTERSECT C` is `A UNION (B INTERSECT C)`. Use parentheses to make intent explicit.\n",[120,1949,1950,1953,1956,1958,1961],{"class":122,"line":462},[120,1951,1952],{"class":287},"- **Set ops don'",[120,1954,1955],{"class":137},"t preserve order",[120,1957,341],{"class":133},[120,1959,1960],{"class":137},": the inputs",[120,1962,1963],{"class":287},"' `ORDER BY` (if any inside subqueries) is not preserved. The only `ORDER BY` that matters is the one at the top of the whole set operation.\n",[120,1965,1966],{"class":122,"line":467},[120,1967,1968],{"class":287},"- **Large `UNION` can spill**: the dedup sort\u002Fhash needs `work_mem`; if it exceeds that, it spills to disk. For huge `UNION`s, increase `work_mem` or pre-dedup each branch with `DISTINCT` (which may let the planner use an index).\n",[120,1970,1971],{"class":122,"line":488},[120,1972,169],{"emptyLinePlaceholder":168},[120,1974,1975],{"class":122,"line":494},[120,1976,1977],{"class":287},"## 🧠 Spot the Bug\n",[120,1979,1980],{"class":122,"line":500},[120,1981,169],{"emptyLinePlaceholder":168},[120,1983,1984,1987],{"class":122,"line":506},[120,1985,1986],{"class":287},"A developer wants to count how many distinct cities have either a customer or a supplier. This returns a much larger number than expected. What'",[120,1988,1989],{"class":137},"s wrong?\n",[120,1991,1992],{"class":122,"line":511},[120,1993,169],{"emptyLinePlaceholder":168},[120,1995,1996,1998,2000,2002,2004,2006],{"class":122,"line":517},[120,1997,470],{"class":137},[120,1999,473],{"class":133},[120,2001,476],{"class":137},[120,2003,479],{"class":133},[120,2005,482],{"class":287},[120,2007,485],{"class":137},[120,2009,2010],{"class":122,"line":522},[120,2011,491],{"class":287},[120,2013,2014],{"class":122,"line":528},[120,2015,2016],{"class":287},"SELECT COUNT(*) FROM (\n",[120,2018,2019],{"class":122,"line":533},[120,2020,2021],{"class":287},"  SELECT city FROM customers\n",[120,2023,2024],{"class":122,"line":538},[120,2025,2026],{"class":287},"  UNION ALL\n",[120,2028,2029],{"class":122,"line":544},[120,2030,2031],{"class":287},"  SELECT city FROM suppliers\n",[120,2033,2035],{"class":122,"line":2034},49,[120,2036,2037],{"class":287},") all_cities;\n",[14,2039,782],{},[2041,2042,2043,2047,2071,2081,2194,2224],"details",{},[2044,2045,2046],"summary",{},"Answer",[14,2048,2049,2051,2052,2054,2055,2058,2059,2062,2063,2066,2067,2070],{},[52,2050,68],{}," does ",[18,2053,1737],{}," remove duplicates — it concatenates with multiplicity. So ",[52,2056,2057],{},"'NYC'"," appearing 50 times in ",[52,2060,2061],{},"customers"," and 20 times in ",[52,2064,2065],{},"suppliers"," contributes 70 rows, not 1. ",[52,2068,2069],{},"COUNT(*)"," counts all 70, inflating the \"distinct cities\" count dramatically.",[14,2072,2073,2074,2076,2077,2080],{},"The fix: use ",[52,2075,54],{}," (which dedups), or ",[52,2078,2079],{},"COUNT(DISTINCT city)",":",[112,2082,2084],{"className":114,"code":2083,"language":110,"meta":116,"style":116},"-- Option 1: UNION dedups\nSELECT COUNT(*) FROM (\n  SELECT city FROM customers\n  UNION\n  SELECT city FROM suppliers\n) all_cities;\n\n-- Option 2: COUNT DISTINCT over UNION ALL\nSELECT COUNT(DISTINCT city) FROM (\n  SELECT city FROM customers\n  UNION ALL\n  SELECT city FROM suppliers\n) all_cities;\n",[52,2085,2086,2091,2109,2120,2125,2135,2139,2143,2148,2166,2176,2180,2190],{"__ignoreMap":116},[120,2087,2088],{"class":122,"line":123},[120,2089,2090],{"class":126},"-- Option 1: UNION dedups\n",[120,2092,2093,2095,2098,2100,2102,2104,2106],{"class":122,"line":130},[120,2094,134],{"class":133},[120,2096,2097],{"class":373}," COUNT",[120,2099,1102],{"class":137},[120,2101,718],{"class":133},[120,2103,1309],{"class":137},[120,2105,141],{"class":133},[120,2107,2108],{"class":137}," (\n",[120,2110,2111,2114,2116,2118],{"class":122,"line":147},[120,2112,2113],{"class":133},"  SELECT",[120,2115,138],{"class":137},[120,2117,141],{"class":133},[120,2119,144],{"class":137},[120,2121,2122],{"class":122,"line":153},[120,2123,2124],{"class":133},"  UNION\n",[120,2126,2127,2129,2131,2133],{"class":122,"line":165},[120,2128,2113],{"class":133},[120,2130,138],{"class":137},[120,2132,141],{"class":133},[120,2134,630],{"class":137},[120,2136,2137],{"class":122,"line":172},[120,2138,2037],{"class":137},[120,2140,2141],{"class":122,"line":178},[120,2142,169],{"emptyLinePlaceholder":168},[120,2144,2145],{"class":122,"line":189},[120,2146,2147],{"class":126},"-- Option 2: COUNT DISTINCT over UNION ALL\n",[120,2149,2150,2152,2154,2156,2159,2162,2164],{"class":122,"line":195},[120,2151,134],{"class":133},[120,2153,2097],{"class":373},[120,2155,1102],{"class":137},[120,2157,2158],{"class":133},"DISTINCT",[120,2160,2161],{"class":137}," city) ",[120,2163,141],{"class":133},[120,2165,2108],{"class":137},[120,2167,2168,2170,2172,2174],{"class":122,"line":206},[120,2169,2113],{"class":133},[120,2171,138],{"class":137},[120,2173,141],{"class":133},[120,2175,144],{"class":137},[120,2177,2178],{"class":122,"line":211},[120,2179,2026],{"class":133},[120,2181,2182,2184,2186,2188],{"class":122,"line":217},[120,2183,2113],{"class":133},[120,2185,138],{"class":137},[120,2187,141],{"class":133},[120,2189,630],{"class":137},[120,2191,2192],{"class":122,"line":228},[120,2193,2037],{"class":137},[14,2195,294,2196,2198,2199,2201,2202,2205,2206,2208,2209,2211,2212,2215,2216,2218,2219,2221,2222,61],{},[52,2197,54],{}," is cleaner here — it dedups once during the combine, and ",[52,2200,2069],{}," then counts the deduped rows. ",[52,2203,2204],{},"COUNT(DISTINCT)"," over ",[52,2207,68],{}," works but pays both the ",[52,2210,68],{}," concatenation ",[2213,2214,1322],"em",{}," a separate hash-sort for ",[52,2217,2158],{}," — usually slower than ",[52,2220,54],{}," + ",[52,2223,2069],{},[14,2225,2226,1276,2229,2231,2232,2234,2235,2237,2238,2221,2240,61],{},[18,2227,2228],{},"The lesson",[52,2230,68],{}," keeps duplicates; ",[52,2233,54],{}," removes them. When you want \"distinct values across inputs,\" use ",[52,2236,54],{},", not ",[52,2239,68],{},[52,2241,2069],{},[23,2243,2244],{"id":2044},"Summary",[14,2246,2247,2248,563,2250,563,2252,563,2254,2256,2257,2259,2260,2262],{},"You can now combine result sets with ",[52,2249,54],{},[52,2251,68],{},[52,2253,80],{},[52,2255,94],{},", understand the dedup cost and the ",[52,2258,68],{}," performance advantage, handle column compatibility, and emulate ",[52,2261,847],{}," on engines that lack it. Next: window functions — the most powerful analytical feature in SQL.",[2264,2265,2266],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-