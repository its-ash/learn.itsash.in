3,227],{"class":117},[101,1325,1326,1328,1330,1333,1336,1338,1340,1342,1344,1346,1348,1350,1352,1354,1356,1358,1360],{"class":103,"line":121},[101,1327,233],{"class":117},[101,1329,24],{"class":114},[101,1331,1332],{"class":145}," MAX",[101,1334,1335],{"class":117},"(ordered_on) ",[101,1337,27],{"class":114},[101,1339,252],{"class":117},[101,1341,20],{"class":114},[101,1343,257],{"class":145},[101,1345,87],{"class":117},[101,1347,262],{"class":145},[101,1349,265],{"class":114},[101,1351,219],{"class":145},[101,1353,87],{"class":117},[101,1355,272],{"class":145},[101,1357,247],{"class":117},[101,1359,189],{"class":114},[101,1361,1362],{"class":117}," last_order\n",[101,1364,1365,1367],{"class":103,"line":129},[101,1366,27],{"class":114},[101,1368,287],{"class":117},[14,1370,1371,1372,1375],{},"This re-executes the subquery for every customer. For a few hundred customers, fine. For millions, a join with ",[18,1373,1374],{},"GROUP BY"," or a window function (chapter 09) is far faster — the planner can sometimes \"decorrelate\" it into a join, but don't count on it.",[34,1377,1379],{"id":1378},"subqueries-in-from-derived-tables","Subqueries in FROM (Derived Tables)",[14,1381,1382,1383,1194,1385,1388],{},"A subquery in ",[18,1384,27],{},[48,1386,1387],{},"derived table"," — it acts like a temporary, inline view.",[89,1390,1391],{"language":91},[93,1392,1394],{"className":95,"code":1393,"language":91,"meta":97,"style":97},"-- Average spend per customer, then cities whose average customer spends > $100\nSELECT city, AVG(customer_total) AS avg_customer_spend\nFROM (\n  SELECT c.city, c.id, SUM(o.amount) AS customer_total\n  FROM customers c JOIN orders o ON c.id = o.customer_id\n  GROUP BY c.city, c.id\n) per_customer\nGROUP BY city\nHAVING AVG(customer_total) > 100;\n``\n",[18,1395,1396,1401,1419,1426,1469,1500,1520,1525,1532,1548],{"__ignoreMap":97},[101,1397,1398],{"class":103,"line":104},[101,1399,1400],{"class":107},"-- Average spend per customer, then cities whose average customer spends > $100\n",[101,1402,1403,1405,1408,1411,1414,1416],{"class":103,"line":111},[101,1404,24],{"class":114},[101,1406,1407],{"class":117}," city, ",[101,1409,1410],{"class":145},"AVG",[101,1412,1413],{"class":117},"(customer_total) ",[101,1415,189],{"class":114},[101,1417,1418],{"class":117}," avg_customer_spend\n",[101,1420,1421,1423],{"class":103,"line":121},[101,1422,27],{"class":114},[101,1424,1425],{"class":117}," (\n",[101,1427,1428,1431,1433,1435,1438,1440,1443,1445,1447,1449,1452,1454,1457,1459,1462,1464,1466],{"class":103,"line":129},[101,1429,1430],{"class":114},"  SELECT",[101,1432,219],{"class":145},[101,1434,87],{"class":117},[101,1436,1437],{"class":145},"city",[101,1439,21],{"class":117},[101,1441,1442],{"class":145},"c",[101,1444,87],{"class":117},[101,1446,272],{"class":145},[101,1448,21],{"class":117},[101,1450,1451],{"class":145},"SUM",[101,1453,241],{"class":117},[101,1455,1456],{"class":145},"o",[101,1458,87],{"class":117},[101,1460,1461],{"class":145},"amount",[101,1463,247],{"class":117},[101,1465,189],{"class":114},[101,1467,1468],{"class":117}," customer_total\n",[101,1470,1471,1474,1477,1480,1482,1485,1487,1489,1491,1493,1495,1497],{"class":103,"line":157},[101,1472,1473],{"class":114},"  FROM",[101,1475,1476],{"class":117}," customers c ",[101,1478,1479],{"class":114},"JOIN",[101,1481,252],{"class":117},[101,1483,1484],{"class":114},"ON",[101,1486,219],{"class":145},[101,1488,87],{"class":117},[101,1490,272],{"class":145},[101,1492,265],{"class":114},[101,1494,257],{"class":145},[101,1496,87],{"class":117},[101,1498,1499],{"class":145},"customer_id\n",[101,1501,1502,1505,1507,1509,1511,1513,1515,1517],{"class":103,"line":164},[101,1503,1504],{"class":114},"  GROUP BY",[101,1506,219],{"class":145},[101,1508,87],{"class":117},[101,1510,1437],{"class":145},[101,1512,21],{"class":117},[101,1514,1442],{"class":145},[101,1516,87],{"class":117},[101,1518,1519],{"class":145},"id\n",[101,1521,1522],{"class":103,"line":170},[101,1523,1524],{"class":117},") per_customer\n",[101,1526,1527,1529],{"class":103,"line":195},[101,1528,1374],{"class":114},[101,1530,1531],{"class":117}," city\n",[101,1533,1534,1536,1538,1540,1542,1545],{"class":103,"line":203},[101,1535,31],{"class":114},[101,1537,146],{"class":145},[101,1539,1413],{"class":117},[101,1541,137],{"class":114},[101,1543,1544],{"class":145}," 100",[101,1546,1547],{"class":117},";\n",[101,1549,1550],{"class":103,"line":208},[101,1551,359],{"class":358},[14,1553,1554,1555,140,1558,1561],{},"A derived table ",[48,1556,1557],{},"must be aliased",[18,1559,1560],{},"per_customer"," above) — even if you don't reference the alias, the syntax requires it. Columns are referenced via the alias.",[14,1563,1564],{},"Derived tables are the pre-CTE way to break a query into stages. CTEs (chapter 07) are usually clearer, but derived tables can be more performant when you want the planner to inline them (PostgreSQL inlines derived tables aggressively; CTEs were optimization fences before PostgreSQL 12).",[34,1566,1568],{"id":1567},"lateral-correlated-joins-postgresql","LATERAL — Correlated Joins (PostgreSQL)",[14,1570,436,1571,1574,1575,1577],{},[18,1572,1573],{},"LATERAL"," subquery in a join can reference columns from tables earlier in the ",[18,1576,27],{}," clause — like a correlated subquery, but in join position.",[89,1579,1580],{"language":91},[93,1581,1583],{"className":95,"code":1582,"language":91,"meta":97,"style":97},"-- For each customer, their top 3 orders by amount\nSELECT c.name, top.id, top.amount\nFROM customers c\nLEFT JOIN LATERAL (\n  SELECT id, amount\n  FROM orders o\n  WHERE o.customer_id = c.id\n  ORDER BY amount DESC\n  LIMIT 3\n) top ON true;\n",[18,1584,1585,1590,1618,1625,1633,1639,1646,1665,1675,1683],{"__ignoreMap":97},[101,1586,1587],{"class":103,"line":104},[101,1588,1589],{"class":107},"-- For each customer, their top 3 orders by amount\n",[101,1591,1592,1594,1596,1598,1600,1602,1605,1607,1609,1611,1613,1615],{"class":103,"line":111},[101,1593,24],{"class":114},[101,1595,219],{"class":145},[101,1597,87],{"class":117},[101,1599,224],{"class":145},[101,1601,21],{"class":117},[101,1603,1604],{"class":145},"top",[101,1606,87],{"class":117},[101,1608,272],{"class":145},[101,1610,21],{"class":117},[101,1612,1604],{"class":145},[101,1614,87],{"class":117},[101,1616,1617],{"class":145},"amount\n",[101,1619,1620,1622],{"class":103,"line":121},[101,1621,27],{"class":114},[101,1623,1624],{"class":117}," customers c\n",[101,1626,1627,1630],{"class":103,"line":129},[101,1628,1629],{"class":114},"LEFT JOIN",[101,1631,1632],{"class":117}," LATERAL (\n",[101,1634,1635,1637],{"class":103,"line":157},[101,1636,1430],{"class":114},[101,1638,118],{"class":117},[101,1640,1641,1643],{"class":103,"line":164},[101,1642,1473],{"class":114},[101,1644,1645],{"class":117}," orders o\n",[101,1647,1648,1651,1653,1655,1657,1659,1661,1663],{"class":103,"line":170},[101,1649,1650],{"class":114},"  WHERE",[101,1652,257],{"class":145},[101,1654,87],{"class":117},[101,1656,262],{"class":145},[101,1658,265],{"class":114},[101,1660,219],{"class":145},[101,1662,87],{"class":117},[101,1664,1519],{"class":145},[101,1666,1667,1670,1672],{"class":103,"line":195},[101,1668,1669],{"class":114},"  ORDER BY",[101,1671,134],{"class":117},[101,1673,1674],{"class":114},"DESC\n",[101,1676,1677,1680],{"class":103,"line":203},[101,1678,1679],{"class":114},"  LIMIT",[101,1681,1682],{"class":145}," 3\n",[101,1684,1685,1687,1689,1692],{"class":103,"line":208},[101,1686,247],{"class":117},[101,1688,1604],{"class":114},[101,1690,1691],{"class":114}," ON",[101,1693,1694],{"class":117}," true;\n",[14,1696,1697,1699,1700,1703,1704,87],{},[18,1698,1573],{}," is the clean way to do \"top-N per group\" without window functions. The subquery re-evaluates per outer row, and ",[18,1701,1702],{},"LIMIT"," inside makes it a bounded per-row lookup. MySQL 8.0+ and SQLite 3.39+ also support ",[18,1705,1573],{},[34,1707,1709],{"id":1708},"subqueries-vs-joins-when-to-use-which","Subqueries vs Joins — When to Use Which",[14,1711,1712],{},"Most subqueries can be rewritten as joins, and vice versa. Guidelines:",[1714,1715,1716,1730,1742,1752],"ul",{},[45,1717,1718,1721,1722,819,1724,819,1726,1729],{},[48,1719,1720],{},"Semi-joins (\"exists in another table\")",": ",[18,1723,1096],{},[18,1725,424],{},[18,1727,1728],{},"LEFT JOIN ... IS NULL"," — pick by readability and NULL-safety.",[45,1731,1732,1735,1736,1738,1739,1741],{},[48,1733,1734],{},"Scalar lookups",": a correlated subquery in ",[18,1737,24],{}," reads clearly for one value; a join + ",[18,1740,1374],{}," scales better for many.",[45,1743,1744,1747,1748,1751],{},[48,1745,1746],{},"Multi-stage aggregation",": derived tables \u002F CTEs over nested aggregates (which SQL forbids: ",[18,1749,1750],{},"AVG(SUM(x))"," is illegal).",[45,1753,1754,1721,1757,1759],{},[48,1755,1756],{},"Top-N per group",[18,1758,1573],{}," or window functions (chapter 09) — not raw subqueries.",[14,1761,1762,1763,1766],{},"When in doubt, write the join version and the subquery version, run both with ",[18,1764,1765],{},"EXPLAIN ANALYZE",", and compare. Modern planners often transform one into the other, but not always.",[34,1768,1770],{"id":1769},"tips-tricks","💡 Tips & Tricks",[1714,1772,1773,1799,1819,1837,1852],{},[45,1774,1775,1778,1779,474,1781,1783,1784,474,1786,1788,1789,1791,1792,1794,1795,1798],{},[48,1776,1777],{},"Idiom",": prefer ",[18,1780,1096],{},[18,1782,811],{}," over ",[18,1785,424],{},[18,1787,572],{}," for subqueries — ",[18,1790,1096],{}," is NULL-safe (no poisoning), short-circuits on the first match, and the planner can use hash semi\u002Fanti-joins. Reserve ",[18,1793,424],{}," for literal lists (",[18,1796,1797],{},"IN (1, 2, 3)",") where it's unambiguous.",[45,1800,1801,1804,1805,1807,1808,1811,1812,1815,1816,1818],{},[48,1802,1803],{},"Performance",": a correlated subquery in the ",[18,1806,24],{}," list that can't be decorrelated runs ",[59,1809,1810],{},"per outer row"," — for a million-row outer table, that's a million subquery executions. Check ",[18,1813,1814],{},"EXPLAIN"," for \"InitPlan\"\u002F\"SubPlan\" nodes; if you see per-row execution, rewrite as a join + ",[18,1817,1374],{}," or a window function.",[45,1820,1821,1721,1823,1826,1827,1829,1830,1833,1834,1836],{},[48,1822,1777],{},[18,1824,1825],{},"SELECT 1"," in ",[18,1828,1096],{}," is convention, not requirement — ",[18,1831,1832],{},"SELECT *"," works too, but ",[18,1835,1825],{}," signals \"I don't care about the columns\" and avoids confusing readers into thinking the columns matter.",[45,1838,1839,1842,1843,1845,1846,1849,1850,87],{},[48,1840,1841],{},"Debug",": when ",[18,1844,572],{}," returns no rows unexpectedly, run the subquery alone and check for NULLs: ",[18,1847,1848],{},"SELECT customer_id FROM orders WHERE customer_id IS NULL"," — one NULL is all it takes to poison the whole ",[18,1851,572],{},[45,1853,1854,1856,1857,1859,1860,1863,1864,1866],{},[48,1855,1777],{},": use ",[18,1858,1573],{}," for \"top-N per group\" queries — it's more readable than ",[18,1861,1862],{},"ROW_NUMBER() OVER (...) WHERE rn \u003C= N"," and lets the planner use an indexed per-group lookup with ",[18,1865,1702],{},", which can be much faster than sorting the whole partition.",[34,1868,1870],{"id":1869},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1714,1872,1873,1888,1907,1916,1929,1948,1967,1996,2010],{},[45,1874,1875,1880,1881,1884,1885,1887],{},[48,1876,1877,1879],{},[18,1878,572],{}," + NULL = zero rows",": the most dangerous subquery gotcha. ",[18,1882,1883],{},"x NOT IN (1, NULL)"," returns no rows for the entire query. Always use ",[18,1886,811],{}," or filter NULLs.",[45,1889,1890,1721,1893,1896,1897,1900,1901,474,1904,87],{},[48,1891,1892],{},"Scalar subquery returning multiple rows",[18,1894,1895],{},"WHERE amount > (SELECT amount FROM orders WHERE customer_id = 1)"," is a runtime error if customer 1 has more than one order. Aggregate it (",[18,1898,1899],{},"MAX(amount)",") or use ",[18,1902,1903],{},"> ALL(...)",[18,1905,1906],{},"> ANY(...)",[45,1908,1909,1912,1913,1915],{},[48,1910,1911],{},"Correlated subquery re-execution",": a correlated subquery logically runs once per outer row. The planner may decorrelate it into a join, but if it can't (e.g., the subquery has a ",[18,1914,1702],{}," or volatile function), it's a per-row performance trap.",[45,1917,1918,1721,1921,1924,1925,1928],{},[48,1919,1920],{},"Derived table requires an alias",[18,1922,1923],{},"SELECT * FROM (SELECT ...) "," is a syntax error — you must alias it: ",[18,1926,1927],{},"SELECT * FROM (SELECT ...) t",". Forgetting the alias is a common typo.",[45,1930,1931,1721,1938,1941,1942,1944,1945,1947],{},[48,1932,1933,1935,1936],{},[18,1934,1096],{}," and ",[18,1937,1832],{},[18,1939,1940],{},"EXISTS (SELECT * FROM ...)"," works — the columns are ignored. But if the subquery's ",[18,1943,244],{}," references a column the planner can't resolve, it errors. ",[18,1946,1825],{}," avoids any column-resolution surprises.",[45,1949,1950,1721,1956,1959,1960,1963,1964,1966],{},[48,1951,1952,1953,1955],{},"Duplicate rows from ",[18,1954,424],{}," with a join",[18,1957,1958],{},"SELECT c.* FROM customers c JOIN orders o ON c.id IN (...)"," can multiply rows if ",[18,1961,1962],{},"orders"," has multiple matches. ",[18,1965,424],{}," in a join condition is a filter, not a deduplication.",[45,1968,1969,1721,1976,1979,1980,1983,1984,1979,1987,1990,1991,1993,1994,87],{},[48,1970,1971,474,1973,1975],{},[18,1972,818],{},[18,1974,822],{}," with empty subquery",[18,1977,1978],{},"x > ALL (empty set)"," is ",[48,1981,1982],{},"TRUE"," (vacuously — \"greater than every element of nothing\" is true), while ",[18,1985,1986],{},"x > ANY (empty set)",[48,1988,1989],{},"FALSE",". This surprises people: \"no orders exceed the max of an empty set\" returns all rows for ",[18,1992,822],{},", none for ",[18,1995,818],{},[45,1997,1998,1721,2006,2009],{},[48,1999,2000,2001,2003,2004],{},"Subquery in ",[18,2002,24],{}," with no ",[18,2005,27],{},[18,2007,2008],{},"SELECT 1, (SELECT COUNT(*) FROM orders)"," is legal — the outer query has one row, the scalar subquery runs once. Useful for \"return a single row with some counts.\"",[45,2011,2012,1721,2017,2020,2021,2023,2024,2026],{},[48,2013,2014,2016],{},[18,2015,1573],{}," requires the keyword in PostgreSQL",[18,2018,2019],{},"JOIN (subquery referencing outer)"," without ",[18,2022,1573],{}," is a syntax error. MySQL 8.0+ also requires ",[18,2025,1573],{},". SQLite 3.39+ supports it but is more permissive about implicit correlation.",[34,2028,2030],{"id":2029},"spot-the-bug","🧠 Spot the Bug",[14,2032,2033,2034,2037],{},"This query intends to find customers who have ",[48,2035,2036],{},"not"," ordered product #5. It returns zero rows even though several customers haven't ordered product #5. Why?",[89,2039,2040],{"language":91},[93,2041,2043],{"className":95,"code":2042,"language":91,"meta":97,"style":97},"SELECT * FROM customers c\nWHERE c.id NOT IN (\n  SELECT customer_id FROM orders o\n  JOIN order_items oi ON oi.order_id = o.id\n  WHERE oi.product_id = 5\n);\n",[18,2044,2045,2055,2072,2082,2108,2124],{"__ignoreMap":97},[101,2046,2047,2049,2051,2053],{"class":103,"line":104},[101,2048,24],{"class":114},[101,2050,320],{"class":114},[101,2052,323],{"class":114},[101,2054,1624],{"class":117},[101,2056,2057,2059,2061,2063,2065,2068,2070],{"class":103,"line":111},[101,2058,20],{"class":114},[101,2060,219],{"class":145},[101,2062,87],{"class":117},[101,2064,272],{"class":145},[101,2066,2067],{"class":114}," NOT",[101,2069,614],{"class":114},[101,2071,1425],{"class":117},[101,2073,2074,2076,2078,2080],{"class":103,"line":121},[101,2075,1430],{"class":114},[101,2077,621],{"class":117},[101,2079,27],{"class":114},[101,2081,1645],{"class":117},[101,2083,2084,2087,2090,2092,2095,2097,2100,2102,2104,2106],{"class":103,"line":129},[101,2085,2086],{"class":114},"  JOIN",[101,2088,2089],{"class":117}," order_items oi ",[101,2091,1484],{"class":114},[101,2093,2094],{"class":145}," oi",[101,2096,87],{"class":117},[101,2098,2099],{"class":145},"order_id",[101,2101,265],{"class":114},[101,2103,257],{"class":145},[101,2105,87],{"class":117},[101,2107,1519],{"class":145},[101,2109,2110,2112,2114,2116,2119,2121],{"class":103,"line":157},[101,2111,1650],{"class":114},[101,2113,2094],{"class":145},[101,2115,87],{"class":117},[101,2117,2118],{"class":145},"product_id",[101,2120,265],{"class":114},[101,2122,2123],{"class":145}," 5\n",[101,2125,2126],{"class":103,"line":164},[101,2127,353],{"class":117},[2129,2130,2131,2135,2157,2171,2177,2275,2280],"details",{},[2132,2133,2134],"summary",{},"Answer",[14,2136,2137,2138,2141,2142,2145,2146,2149,2150,2153,2154,2156],{},"If any order row joins to an ",[18,2139,2140],{},"order_items"," row with ",[18,2143,2144],{},"product_id = 5"," but ",[18,2147,2148],{},"customer_id IS NULL"," (or if ",[18,2151,2152],{},"orders.customer_id"," is NULL for some matched order), the subquery returns a NULL among its results — and ",[18,2155,572],{}," with a NULL in the list returns zero rows for the entire outer query (the NULL-poisoning trap).",[14,2158,2159,2160,2162,2163,2165,2166,2168,2169,87],{},"Even without NULL ",[18,2161,262],{},"s, there's a second, subtler risk: if ",[18,2164,1962],{}," has rows where ",[18,2167,262],{}," is legitimately NULL (e.g., a guest checkout), and those orders happen to contain product #5, the subquery emits NULL, poisoning ",[18,2170,572],{},[14,2172,2173,2174,2176],{},"The fix — use ",[18,2175,811],{},", which is NULL-safe:",[93,2178,2180],{"className":95,"code":2179,"language":91,"meta":97,"style":97},"SELECT * FROM customers c\nWHERE NOT EXISTS (\n  SELECT 1\n  FROM orders o\n  JOIN order_items oi ON oi.order_id = o.id\n  WHERE o.customer_id = c.id\n    AND oi.product_id = 5\n);\n",[18,2181,2182,2192,2203,2210,2216,2238,2256,2271],{"__ignoreMap":97},[101,2183,2184,2186,2188,2190],{"class":103,"line":104},[101,2185,24],{"class":114},[101,2187,320],{"class":114},[101,2189,323],{"class":114},[101,2191,1624],{"class":117},[101,2193,2194,2196,2198,2201],{"class":103,"line":111},[101,2195,20],{"class":114},[101,2197,2067],{"class":114},[101,2199,2200],{"class":114}," EXISTS",[101,2202,1425],{"class":117},[101,2204,2205,2207],{"class":103,"line":121},[101,2206,1430],{"class":114},[101,2208,2209],{"class":145}," 1\n",[101,2211,2212,2214],{"class":103,"line":129},[101,2213,1473],{"class":114},[101,2215,1645],{"class":117},[101,2217,2218,2220,2222,2224,2226,2228,2230,2232,2234,2236],{"class":103,"line":157},[101,2219,2086],{"class":114},[101,2221,2089],{"class":117},[101,2223,1484],{"class":114},[101,2225,2094],{"class":145},[101,2227,87],{"class":117},[101,2229,2099],{"class":145},[101,2231,265],{"class":114},[101,2233,257],{"class":145},[101,2235,87],{"class":117},[101,2237,1519],{"class":145},[101,2239,2240,2242,2244,2246,2248,2250,2252,2254],{"class":103,"line":164},[101,2241,1650],{"class":114},[101,2243,257],{"class":145},[101,2245,87],{"class":117},[101,2247,262],{"class":145},[101,2249,265],{"class":114},[101,2251,219],{"class":145},[101,2253,87],{"class":117},[101,2255,1519],{"class":145},[101,2257,2258,2261,2263,2265,2267,2269],{"class":103,"line":170},[101,2259,2260],{"class":114},"    AND",[101,2262,2094],{"class":145},[101,2264,87],{"class":117},[101,2266,2118],{"class":145},[101,2268,265],{"class":114},[101,2270,2123],{"class":145},[101,2272,2273],{"class":103,"line":195},[101,2274,353],{"class":117},[14,2276,364,2277,2279],{},[18,2278,811],{}," checks \"no row exists matching this customer and product 5\" — it returns TRUE when the subquery is empty, regardless of NULLs anywhere. It also lets the planner use a hash anti-join.",[14,2281,2282,1721,2285,2287,2288,2290],{},[48,2283,2284],{},"The lesson",[18,2286,572],{}," with a subquery over nullable columns is a latent bug — it works until a NULL appears, then silently returns nothing. Use ",[18,2289,811],{}," for \"not in another table\" semantics.",[34,2292,2293],{"id":2132},"Summary",[14,2295,2296,2297,474,2299,474,2301,474,2303,474,2305,2307,2308,2310],{},"You can now write scalar, row, and table subqueries; use ",[18,2298,424],{},[18,2300,572],{},[18,2302,1096],{},[18,2304,818],{},[18,2306,822],{}," safely (avoiding the NULL-poisoning trap); build derived tables and ",[18,2309,1573],{}," joins; and choose between subqueries and joins based on readability and performance. Next: CTEs, the cleaner way to compose multi-stage queries.",[2312,2313,2314],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}",{"title":97,"searchDepth":111,"depth":111,"links":2316},[2317,2318,2319,2327,2328,2329,2330,2331,2332,2333,2334],{"id":36,"depth":111,"text":37},{"id":72,"depth":111,"text":73},{"id":297,"depth":111,"text":298,"children":2320},[2321,2323,2325],{"id":569,"depth":121,"text":2322},"NOT IN — the NULL trap (dangerous!)",{"id":815,"depth":121,"text":2324},"ANY \u002F ALL",{"id":1213,"depth":121,"text":2326},"EXISTS vs IN — when to use which",{"id":1292,"depth":111,"text":1293},{"id":1378,"depth":111,"text":1379},{"id":1567,"depth":111,"text":1568},{"id":1708,"depth":111,"text":1709},{"id":1769,"depth":111,"text":1770},{"id":1869,"depth":111,"text":1870},{"id":2029,"depth":111,"text":2030},{"id":2132,"depth":111,"text":2293},"A subquery is a query nested inside another query. Subqueries appear in WHERE, SELECT, FROM, and even HAVING. They're the primary way to compose queries before reaching for CTEs (chapter 07) or joins.","md",{},"\u002Fsql\u002F06-subqueries",{"title":5,"description":2335},"sql\u002F06-subqueries","Z9NxTDNciVNDJv1My8dZibu__uIur7dS3JIReQLPwv0",1787401244974]