[{"data":1,"prerenderedAt":2342},["ShallowReactive",2],{"page-\u002Fsql\u002F06-subqueries":3},{"id":4,"title":5,"body":6,"description":2335,"extension":2336,"meta":2337,"navigation":160,"path":2338,"seo":2339,"stem":2340,"__hash__":2341},"content\u002Fsql\u002F06-subqueries.md","06 — Subqueries",{"type":7,"value":8,"toc":2315},"minimark",[9,13,33,38,41,67,70,74,88,288,295,299,302,566,574,579,804,813,823,843,1552,1562,1565,1569,1578,1695,1706,1710,1713,1760,1767,1771,1867,1871,2027,2031,2038,2128,2291,2294,2311],[10,11,5],"h1",{"id":12},"_06-subqueries",[14,15,16,17,21,22,21,25,28,29,32],"p",{},"A subquery is a query nested inside another query. Subqueries appear in ",[18,19,20],"code",{},"WHERE",", ",[18,23,24],{},"SELECT",[18,26,27],{},"FROM",", and even ",[18,30,31],{},"HAVING",". They're the primary way to compose queries before reaching for CTEs (chapter 07) or joins.",[34,35,37],"h2",{"id":36},"subquery-classifications","Subquery Classifications",[14,39,40],{},"Subqueries differ on two axes:",[42,43,44,52],"ol",{},[45,46,47,51],"li",{},[48,49,50],"strong",{},"Return shape",": scalar (one row, one column), row (one row, multiple columns), or table (multiple rows, one or more columns).",[45,53,54,57,58,62,63,66],{},[48,55,56],{},"Correlation",": an ",[59,60,61],"em",{},"uncorrelated"," subquery can run independently of the outer query; a ",[59,64,65],{},"correlated"," subquery references the outer query's columns and re-executes per outer row.",[14,68,69],{},"The classification determines where you can use the subquery and which operators apply.",[34,71,73],{"id":72},"scalar-subqueries","Scalar Subqueries",[14,75,76,77,21,79,21,81,83,84,87],{},"A scalar subquery returns exactly one row and one column. It can appear anywhere a single value is legal — in ",[18,78,24],{},[18,80,20],{},[18,82,31],{},", even in ",[18,85,86],{},"VALUES",".",[89,90,92],"code-wrapper",{"language":91},"sql",[93,94,98],"pre",{"className":95,"code":96,"language":91,"meta":97,"style":97},"language-sql shiki shiki-themes github-light github-dark","-- Orders above the average order amount\nSELECT id, amount\nFROM orders\nWHERE amount > (SELECT AVG(amount) FROM orders);\n\n-- Each order with the overall average for comparison\nSELECT id, amount, (SELECT AVG(amount) FROM orders) AS overall_avg\nFROM orders;\n\n-- A computed column from a scalar subquery\nSELECT c.name,\n       (SELECT COUNT(*) FROM orders o WHERE o.customer_id = c.id) AS order_count\nFROM customers c;\n","",[18,99,100,109,119,127,155,162,168,193,201,206,212,228,280],{"__ignoreMap":97},[101,102,105],"span",{"class":103,"line":104},"line",1,[101,106,108],{"class":107},"sdCPZ","-- Orders above the average order amount\n",[101,110,112,115],{"class":103,"line":111},2,[101,113,24],{"class":114},"svdQ7",[101,116,118],{"class":117},"ssxIu"," id, amount\n",[101,120,122,124],{"class":103,"line":121},3,[101,123,27],{"class":114},[101,125,126],{"class":117}," orders\n",[101,128,130,132,135,138,141,143,147,150,152],{"class":103,"line":129},4,[101,131,20],{"class":114},[101,133,134],{"class":117}," amount ",[101,136,137],{"class":114},">",[101,139,140],{"class":117}," (",[101,142,24],{"class":114},[101,144,146],{"class":145},"snvgF"," AVG",[101,148,149],{"class":117},"(amount) ",[101,151,27],{"class":114},[101,153,154],{"class":117}," orders);\n",[101,156,158],{"class":103,"line":157},5,[101,159,161],{"emptyLinePlaceholder":160},true,"\n",[101,163,165],{"class":103,"line":164},6,[101,166,167],{"class":107},"-- Each order with the overall average for comparison\n",[101,169,171,173,176,178,180,182,184,187,190],{"class":103,"line":170},7,[101,172,24],{"class":114},[101,174,175],{"class":117}," id, amount, (",[101,177,24],{"class":114},[101,179,146],{"class":145},[101,181,149],{"class":117},[101,183,27],{"class":114},[101,185,186],{"class":117}," orders) ",[101,188,189],{"class":114},"AS",[101,191,192],{"class":117}," overall_avg\n",[101,194,196,198],{"class":103,"line":195},8,[101,197,27],{"class":114},[101,199,200],{"class":117}," orders;\n",[101,202,204],{"class":103,"line":203},9,[101,205,161],{"emptyLinePlaceholder":160},[101,207,209],{"class":103,"line":208},10,[101,210,211],{"class":107},"-- A computed column from a scalar subquery\n",[101,213,215,217,220,222,225],{"class":103,"line":214},11,[101,216,24],{"class":114},[101,218,219],{"class":145}," c",[101,221,87],{"class":117},[101,223,224],{"class":145},"name",[101,226,227],{"class":117},",\n",[101,229,231,234,236,239,242,245,248,250,253,255,258,260,263,266,268,270,273,275,277],{"class":103,"line":230},12,[101,232,233],{"class":117},"       (",[101,235,24],{"class":114},[101,237,238],{"class":145}," COUNT",[101,240,241],{"class":117},"(",[101,243,244],{"class":114},"*",[101,246,247],{"class":117},") ",[101,249,27],{"class":114},[101,251,252],{"class":117}," orders o ",[101,254,20],{"class":114},[101,256,257],{"class":145}," o",[101,259,87],{"class":117},[101,261,262],{"class":145},"customer_id",[101,264,265],{"class":114}," =",[101,267,219],{"class":145},[101,269,87],{"class":117},[101,271,272],{"class":145},"id",[101,274,247],{"class":117},[101,276,189],{"class":114},[101,278,279],{"class":117}," order_count\n",[101,281,283,285],{"class":103,"line":282},13,[101,284,27],{"class":114},[101,286,287],{"class":117}," customers c;\n",[14,289,290,291,294],{},"If a scalar subquery returns zero rows, its value is NULL. If it returns more than one row, it's a runtime error (",[18,292,293],{},"ERROR: more than one row returned by a subquery used as an expression",").",[34,296,298],{"id":297},"row-subqueries","Row Subqueries",[14,300,301],{},"A row subquery returns one row with multiple columns. Compare against a row constructor:",[89,303,304],{"language":91},[93,305,307],{"className":95,"code":306,"language":91,"meta":97,"style":97},"-- Orders matching a specific (customer_id, amount) pair\nSELECT * FROM orders\nWHERE (customer_id, amount) = (1, 99.50);\n``\n::\n\nRow comparisons are lexicographic and follow three-valued logic — `(a, b) = (x, y)` is `a = x AND b = y`, so any NULL makes the whole thing UNKNOWN.\n\n## Table Subqueries (IN, ANY, ALL)\n\nA table subquery returns multiple rows. Use it with `IN`, `ANY`\u002F`ALL`, `EXISTS`, or in the `FROM` clause.\n\n### `IN`\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- Customers who have placed at least one order\nSELECT * FROM customers\nWHERE id IN (SELECT customer_id FROM orders);\n``\n",[18,308,309,314,326,354,360,365,369,407,411,428,432,500,504,512,517,537,543,549,555,561],{"__ignoreMap":97},[101,310,311],{"class":103,"line":104},[101,312,313],{"class":107},"-- Orders matching a specific (customer_id, amount) pair\n",[101,315,316,318,321,324],{"class":103,"line":111},[101,317,24],{"class":114},[101,319,320],{"class":114}," *",[101,322,323],{"class":114}," FROM",[101,325,126],{"class":117},[101,327,328,330,333,336,338,341,343,346,348,351],{"class":103,"line":121},[101,329,20],{"class":114},[101,331,332],{"class":117}," (customer_id, amount) ",[101,334,335],{"class":114},"=",[101,337,140],{"class":117},[101,339,340],{"class":145},"1",[101,342,21],{"class":117},[101,344,345],{"class":145},"99",[101,347,87],{"class":117},[101,349,350],{"class":145},"50",[101,352,353],{"class":117},");\n",[101,355,356],{"class":103,"line":129},[101,357,359],{"class":358},"sJ6F3","``\n",[101,361,362],{"class":103,"line":157},[101,363,364],{"class":117},"::\n",[101,366,367],{"class":103,"line":164},[101,368,161],{"emptyLinePlaceholder":160},[101,370,371,374,377,380,383,386,389,392,395,398,401,404],{"class":103,"line":170},[101,372,373],{"class":114},"Row",[101,375,376],{"class":117}," comparisons are lexicographic ",[101,378,379],{"class":114},"and",[101,381,382],{"class":117}," follow three",[101,384,385],{"class":114},"-",[101,387,388],{"class":117},"valued logic — ",[101,390,391],{"class":358},"`(a, b) = (x, y)`",[101,393,394],{"class":114}," is",[101,396,397],{"class":358}," `a = x AND b = y`",[101,399,400],{"class":117},", so any ",[101,402,403],{"class":114},"NULL",[101,405,406],{"class":117}," makes the whole thing UNKNOWN.\n",[101,408,409],{"class":103,"line":195},[101,410,161],{"emptyLinePlaceholder":160},[101,412,413,416,419,422,425],{"class":103,"line":203},[101,414,415],{"class":117},"## ",[101,417,418],{"class":114},"Table",[101,420,421],{"class":117}," Subqueries (",[101,423,424],{"class":114},"IN",[101,426,427],{"class":117},", ANY, ALL)\n",[101,429,430],{"class":103,"line":208},[101,431,161],{"emptyLinePlaceholder":160},[101,433,434,437,440,443,446,449,452,455,458,461,464,467,469,472,475,478,480,483,485,488,491,494,497],{"class":103,"line":214},[101,435,436],{"class":117},"A ",[101,438,439],{"class":114},"table",[101,441,442],{"class":117}," subquery ",[101,444,445],{"class":114},"returns",[101,447,448],{"class":117}," multiple ",[101,450,451],{"class":114},"rows",[101,453,454],{"class":117},". ",[101,456,457],{"class":114},"Use",[101,459,460],{"class":117}," it ",[101,462,463],{"class":114},"with",[101,465,466],{"class":358}," `IN`",[101,468,21],{"class":117},[101,470,471],{"class":358},"`ANY`",[101,473,474],{"class":114},"\u002F",[101,476,477],{"class":358},"`ALL`",[101,479,21],{"class":117},[101,481,482],{"class":358},"`EXISTS`",[101,484,21],{"class":117},[101,486,487],{"class":114},"or",[101,489,490],{"class":114}," in",[101,492,493],{"class":117}," the ",[101,495,496],{"class":358},"`FROM`",[101,498,499],{"class":117}," clause.\n",[101,501,502],{"class":103,"line":230},[101,503,161],{"emptyLinePlaceholder":160},[101,505,506,509],{"class":103,"line":282},[101,507,508],{"class":117},"### ",[101,510,511],{"class":358},"`IN`\n",[101,513,515],{"class":103,"line":514},14,[101,516,161],{"emptyLinePlaceholder":160},[101,518,520,523,525,528,531,534],{"class":103,"line":519},15,[101,521,522],{"class":117},"::code",[101,524,385],{"class":114},[101,526,527],{"class":117},"wrapper{",[101,529,530],{"class":114},"language=",[101,532,533],{"class":358},"\"sql\"",[101,535,536],{"class":117},"}\n",[101,538,540],{"class":103,"line":539},16,[101,541,542],{"class":358},"```sql\n",[101,544,546],{"class":103,"line":545},17,[101,547,548],{"class":358},"-- Customers who have placed at least one order\n",[101,550,552],{"class":103,"line":551},18,[101,553,554],{"class":358},"SELECT * FROM customers\n",[101,556,558],{"class":103,"line":557},19,[101,559,560],{"class":358},"WHERE id IN (SELECT customer_id FROM orders);\n",[101,562,564],{"class":103,"line":563},20,[101,565,359],{"class":358},[567,568,570,573],"h3",{"id":569},"not-in-the-null-trap-dangerous",[18,571,572],{},"NOT IN"," — the NULL trap (dangerous!)",[14,575,576,578],{},[18,577,572],{}," breaks if the subquery can produce NULL:",[89,580,581],{"language":91},[93,582,584],{"className":95,"code":583,"language":91,"meta":97,"style":97},"-- ❌ Returns ZERO rows if any customer_id in the subquery is NULL\nSELECT * FROM customers\nWHERE id NOT IN (SELECT customer_id FROM orders);\n``\n::\n\nWhy: `x NOT IN (a, b, c)` is `x \u003C> a AND x \u003C> b AND x \u003C> c`. If any element is NULL, `x \u003C> NULL` is UNKNOWN, which makes the whole `AND` chain UNKNOWN, which `WHERE` treats as \"not true.\" **One NULL in the subquery poisons the entire `NOT IN`.**\n\nThe fixes:\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- Option 1: filter NULLs in the subquery\nSELECT * FROM customers\nWHERE id NOT IN (SELECT customer_id FROM orders WHERE customer_id IS NOT NULL);\n\n-- Option 2: use NOT EXISTS (immune to NULL, usually faster)\nSELECT * FROM customers c\nWHERE NOT EXISTS (SELECT 1 FROM orders o WHERE o.customer_id = c.id);\n\n-- Option 3: IS DISTINCT FROM (NULL-safe)\nSELECT * FROM customers c\nWHERE c.id IS DISTINCT FROM ALL (SELECT customer_id FROM orders);\n``\n",[18,585,586,591,602,626,630,634,638,714,718,723,727,741,745,750,754,759,763,768,773,778,782,788,793,799],{"__ignoreMap":97},[101,587,588],{"class":103,"line":104},[101,589,590],{"class":107},"-- ❌ Returns ZERO rows if any customer_id in the subquery is NULL\n",[101,592,593,595,597,599],{"class":103,"line":111},[101,594,24],{"class":114},[101,596,320],{"class":114},[101,598,323],{"class":114},[101,600,601],{"class":117}," customers\n",[101,603,604,606,609,612,615,617,619,622,624],{"class":103,"line":121},[101,605,20],{"class":114},[101,607,608],{"class":117}," id ",[101,610,611],{"class":114},"NOT",[101,613,614],{"class":114}," IN",[101,616,140],{"class":117},[101,618,24],{"class":114},[101,620,621],{"class":117}," customer_id ",[101,623,27],{"class":114},[101,625,154],{"class":117},[101,627,628],{"class":103,"line":129},[101,629,359],{"class":358},[101,631,632],{"class":103,"line":157},[101,633,364],{"class":117},[101,635,636],{"class":103,"line":164},[101,637,161],{"emptyLinePlaceholder":160},[101,639,640,643,646,648,651,653,656,659,662,665,667,670,672,675,678,681,684,687,690,693,696,699,701,703,706,709,711],{"class":103,"line":170},[101,641,642],{"class":117},"Why: ",[101,644,645],{"class":358},"`x NOT IN (a, b, c)`",[101,647,394],{"class":114},[101,649,650],{"class":358}," `x \u003C> a AND x \u003C> b AND x \u003C> c`",[101,652,454],{"class":117},[101,654,655],{"class":114},"If",[101,657,658],{"class":117}," any element ",[101,660,661],{"class":114},"is",[101,663,664],{"class":114}," NULL",[101,666,21],{"class":117},[101,668,669],{"class":358},"`x \u003C> NULL`",[101,671,394],{"class":114},[101,673,674],{"class":117}," UNKNOWN, which makes the whole ",[101,676,677],{"class":358},"`AND`",[101,679,680],{"class":117}," chain UNKNOWN, which ",[101,682,683],{"class":358},"`WHERE`",[101,685,686],{"class":117}," treats ",[101,688,689],{"class":114},"as",[101,691,692],{"class":358}," \"not true.\"",[101,694,695],{"class":114}," **",[101,697,698],{"class":117},"One ",[101,700,403],{"class":114},[101,702,490],{"class":114},[101,704,705],{"class":117}," the subquery poisons the entire ",[101,707,708],{"class":358},"`NOT IN`",[101,710,87],{"class":117},[101,712,713],{"class":114},"**\n",[101,715,716],{"class":103,"line":195},[101,717,161],{"emptyLinePlaceholder":160},[101,719,720],{"class":103,"line":203},[101,721,722],{"class":117},"The fixes:\n",[101,724,725],{"class":103,"line":208},[101,726,161],{"emptyLinePlaceholder":160},[101,728,729,731,733,735,737,739],{"class":103,"line":214},[101,730,522],{"class":117},[101,732,385],{"class":114},[101,734,527],{"class":117},[101,736,530],{"class":114},[101,738,533],{"class":358},[101,740,536],{"class":117},[101,742,743],{"class":103,"line":230},[101,744,542],{"class":358},[101,746,747],{"class":103,"line":282},[101,748,749],{"class":358},"-- Option 1: filter NULLs in the subquery\n",[101,751,752],{"class":103,"line":514},[101,753,554],{"class":358},[101,755,756],{"class":103,"line":519},[101,757,758],{"class":358},"WHERE id NOT IN (SELECT customer_id FROM orders WHERE customer_id IS NOT NULL);\n",[101,760,761],{"class":103,"line":539},[101,762,161],{"emptyLinePlaceholder":160},[101,764,765],{"class":103,"line":545},[101,766,767],{"class":358},"-- Option 2: use NOT EXISTS (immune to NULL, usually faster)\n",[101,769,770],{"class":103,"line":551},[101,771,772],{"class":358},"SELECT * FROM customers c\n",[101,774,775],{"class":103,"line":557},[101,776,777],{"class":358},"WHERE NOT EXISTS (SELECT 1 FROM orders o WHERE o.customer_id = c.id);\n",[101,779,780],{"class":103,"line":563},[101,781,161],{"emptyLinePlaceholder":160},[101,783,785],{"class":103,"line":784},21,[101,786,787],{"class":358},"-- Option 3: IS DISTINCT FROM (NULL-safe)\n",[101,789,791],{"class":103,"line":790},22,[101,792,772],{"class":358},[101,794,796],{"class":103,"line":795},23,[101,797,798],{"class":358},"WHERE c.id IS DISTINCT FROM ALL (SELECT customer_id FROM orders);\n",[101,800,802],{"class":103,"line":801},24,[101,803,359],{"class":358},[14,805,806,812],{},[48,807,808,809,87],{},"Prefer ",[18,810,811],{},"NOT EXISTS"," It's NULL-safe and the planner can use a hash anti-join.",[567,814,816,819,820],{"id":815},"any-all",[18,817,818],{},"ANY"," \u002F ",[18,821,822],{},"ALL",[14,824,825,827,828,831,832,835,836,838,839,842],{},[18,826,818],{}," (a.k.a. ",[18,829,830],{},"SOME",") — true if the comparison holds for ",[59,833,834],{},"at least one"," subquery row. ",[18,837,822],{}," — true for ",[59,840,841],{},"every"," row.",[89,844,845,1187,1190,1211,1219,1290,1294,1300,1369,1376,1380,1389],{"language":91},[93,846,848],{"className":95,"code":847,"language":91,"meta":97,"style":97},"-- Orders larger than at least one order from customer 1\nSELECT * FROM orders\nWHERE amount > ANY (SELECT amount FROM orders WHERE customer_id = 1);\n\n-- Orders larger than every order from customer 1 (the max)\nSELECT * FROM orders\nWHERE amount > ALL (SELECT amount FROM orders WHERE customer_id = 1);\n``\n::\n\n`> ANY (...)` is equivalent to `> (SELECT MIN(...) ...)`. `> ALL (...)` is equivalent to `> (SELECT MAX(...) ...)`. The scalar form with `MIN`\u002F`MAX` is often clearer.\n\n### `= ANY` vs `IN`\n\n`= ANY (subquery)` is exactly equivalent to `IN (subquery)`. `IN` is the more common spelling. `ANY`\u002F`ALL` matter for non-equality comparisons (`> ANY`, `\u003C ALL`).\n\n## EXISTS — Semi-Join\n\n`EXISTS` is true if the subquery returns **at least one row** — it doesn't care what the rows contain. By convention, `SELECT 1` is used (the value is irrelevant).\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- Customers who have placed at least one order\nSELECT * FROM customers c\nWHERE EXISTS (SELECT 1 FROM orders o WHERE o.customer_id = c.id);\n\n-- Customers who have NOT placed any order (anti-join)\nSELECT * FROM customers c\nWHERE NOT EXISTS (SELECT 1 FROM orders o WHERE o.customer_id = c.id);\n",[18,849,850,855,865,896,900,905,915,944,948,952,956,1010,1014,1026,1030,1086,1090,1103,1107,1139,1143,1148,1152,1156,1160,1166,1171,1177,1182],{"__ignoreMap":97},[101,851,852],{"class":103,"line":104},[101,853,854],{"class":107},"-- Orders larger than at least one order from customer 1\n",[101,856,857,859,861,863],{"class":103,"line":111},[101,858,24],{"class":114},[101