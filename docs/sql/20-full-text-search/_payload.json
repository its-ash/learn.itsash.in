[{"data":1,"prerenderedAt":1855},["ShallowReactive",2],{"page-\u002Fsql\u002F20-full-text-search":3},{"id":4,"title":5,"body":6,"description":1848,"extension":1849,"meta":1850,"navigation":179,"path":1851,"seo":1852,"stem":1853,"__hash__":1854},"content\u002Fsql\u002F20-full-text-search.md","20 — Full-Text Search",{"type":7,"value":8,"toc":1833},"minimark",[9,13,30,35,41,76,87,91,124,441,447,451,461,744,756,760,765,823,827,930,934,1176,1183,1187,1264,1268,1336,1340,1495,1499,1502,1829],[10,11,5],"h1",{"id":12},"_20-full-text-search",[14,15,16,17,21,22,25,26,29],"p",{},"Full-text search (FTS) finds documents matching a query, ranked by relevance — far more powerful than ",[18,19,20],"code",{},"LIKE"," for natural-language search. PostgreSQL has a built-in FTS engine via ",[18,23,24],{},"tsvector",", ",[18,27,28],{},"tsquery",", and GIN indexes.",[31,32,34],"h2",{"id":33},"why-not-like","Why Not LIKE?",[14,36,37,40],{},[18,38,39],{},"LIKE '%word%'"," has three problems:",[42,43,44,52,70],"ol",{},[45,46,47,51],"li",{},[48,49,50],"strong",{},"Slow"," — leading wildcards defeat B-tree indexes (full table scan).",[45,53,54,57,58,61,62,65,66,69],{},[48,55,56],{},"No linguistic awareness"," — ",[18,59,60],{},"'running'"," doesn't match ",[18,63,64],{},"'run'"," or ",[18,67,68],{},"'ran'",".",[45,71,72,75],{},[48,73,74],{},"No relevance ranking"," — you get matches, but no \"best match first.\"",[14,77,78,79,82,83,86],{},"FTS solves all three: it's indexed (GIN), it stems words (",[18,80,81],{},"running"," → ",[18,84,85],{},"run","), and it ranks results by relevance.",[31,88,90],{"id":89},"tsvector-and-tsquery","tsvector and tsquery",[92,93,94,101],"ul",{},[45,95,96,100],{},[48,97,98],{},[18,99,24],{}," — a document preprocessed into a sorted list of distinct words (lexemes), each with positions. This is the searchable form.",[45,102,103,107,108,111,112,115,116,119,120,123],{},[48,104,105],{},[18,106,28],{}," — a query of lexemes combined with ",[18,109,110],{},"&"," (AND), ",[18,113,114],{},"|"," (OR), ",[18,117,118],{},"!"," (NOT), and ",[18,121,122],{},"\u003C->"," (followed by).",[125,126,128],"code-wrapper",{"language":127},"sql",[129,130,134],"pre",{"className":131,"code":132,"language":127,"meta":133,"style":133},"language-sql shiki shiki-themes github-light github-dark","-- Convert text to a tsvector\nSELECT to_tsvector('english', 'The quick brown fox jumps over the lazy dog');\n--  'brown':3 'dog':9 'fox':4 'jump':5 'lazi':8 'quick':2\n\n-- Convert a query string to a tsquery\nSELECT to_tsquery('english', 'quick & fox');\n--  'quick' & 'fox'\n\n-- Phrase search (words in order, adjacent)\nSELECT phraseto_tsquery('english', 'quick brown fox');\n--  'quick' \u003C-> 'brown' \u003C-> 'fox'\n``\n::\n\nThe English text processor (the \"text search configuration\") lowercases, removes stop words (\"the\", \"over\", \"the\"), and stems (\"jumps\" → \"jump\", \"lazy\" → \"lazi\"). Different configurations exist for many languages (`'english'`, `'spanish'`, `'german'`, etc.).\n\n## The Match Operator: `@@`\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- Does the document match the query?\nSELECT to_tsvector('english', 'The quick brown fox') @@ to_tsquery('english', 'quick & fox');\n--  true\n\nSELECT to_tsvector('english', 'The quick brown fox') @@ to_tsquery('english', 'quick & cat');\n--  false\n``\n","",[18,135,136,145,168,174,181,187,204,210,215,221,238,244,250,256,261,349,354,369,374,395,401,407,413,419,424,430,436],{"__ignoreMap":133},[137,138,141],"span",{"class":139,"line":140},"line",1,[137,142,144],{"class":143},"sdCPZ","-- Convert text to a tsvector\n",[137,146,148,152,156,160,162,165],{"class":139,"line":147},2,[137,149,151],{"class":150},"svdQ7","SELECT",[137,153,155],{"class":154},"ssxIu"," to_tsvector(",[137,157,159],{"class":158},"sJ6F3","'english'",[137,161,25],{"class":154},[137,163,164],{"class":158},"'The quick brown fox jumps over the lazy dog'",[137,166,167],{"class":154},");\n",[137,169,171],{"class":139,"line":170},3,[137,172,173],{"class":143},"--  'brown':3 'dog':9 'fox':4 'jump':5 'lazi':8 'quick':2\n",[137,175,177],{"class":139,"line":176},4,[137,178,180],{"emptyLinePlaceholder":179},true,"\n",[137,182,184],{"class":139,"line":183},5,[137,185,186],{"class":143},"-- Convert a query string to a tsquery\n",[137,188,190,192,195,197,199,202],{"class":139,"line":189},6,[137,191,151],{"class":150},[137,193,194],{"class":154}," to_tsquery(",[137,196,159],{"class":158},[137,198,25],{"class":154},[137,200,201],{"class":158},"'quick & fox'",[137,203,167],{"class":154},[137,205,207],{"class":139,"line":206},7,[137,208,209],{"class":143},"--  'quick' & 'fox'\n",[137,211,213],{"class":139,"line":212},8,[137,214,180],{"emptyLinePlaceholder":179},[137,216,218],{"class":139,"line":217},9,[137,219,220],{"class":143},"-- Phrase search (words in order, adjacent)\n",[137,222,224,226,229,231,233,236],{"class":139,"line":223},10,[137,225,151],{"class":150},[137,227,228],{"class":154}," phraseto_tsquery(",[137,230,159],{"class":158},[137,232,25],{"class":154},[137,234,235],{"class":158},"'quick brown fox'",[137,237,167],{"class":154},[137,239,241],{"class":139,"line":240},11,[137,242,243],{"class":143},"--  'quick' \u003C-> 'brown' \u003C-> 'fox'\n",[137,245,247],{"class":139,"line":246},12,[137,248,249],{"class":158},"``\n",[137,251,253],{"class":139,"line":252},13,[137,254,255],{"class":154},"::\n",[137,257,259],{"class":139,"line":258},14,[137,260,180],{"emptyLinePlaceholder":179},[137,262,264,267,270,273,276,279,282,285,288,290,293,295,297,300,303,306,309,311,314,316,319,321,324,327,330,333,336,338,341,343,346],{"class":139,"line":263},15,[137,265,266],{"class":154},"The English ",[137,268,269],{"class":150},"text",[137,271,272],{"class":154}," processor (the ",[137,274,275],{"class":158},"\"text search configuration\"",[137,277,278],{"class":154},") lowercases, removes ",[137,280,281],{"class":150},"stop",[137,283,284],{"class":154}," words (",[137,286,287],{"class":158},"\"the\"",[137,289,25],{"class":154},[137,291,292],{"class":158},"\"over\"",[137,294,25],{"class":154},[137,296,287],{"class":158},[137,298,299],{"class":154},"), ",[137,301,302],{"class":150},"and",[137,304,305],{"class":154}," stems (",[137,307,308],{"class":158},"\"jumps\"",[137,310,82],{"class":154},[137,312,313],{"class":158},"\"jump\"",[137,315,25],{"class":154},[137,317,318],{"class":158},"\"lazy\"",[137,320,82],{"class":154},[137,322,323],{"class":158},"\"lazi\"",[137,325,326],{"class":154},"). Different configurations exist ",[137,328,329],{"class":150},"for",[137,331,332],{"class":154}," many languages (",[137,334,335],{"class":158},"`'english'`",[137,337,25],{"class":154},[137,339,340],{"class":158},"`'spanish'`",[137,342,25],{"class":154},[137,344,345],{"class":158},"`'german'`",[137,347,348],{"class":154},", etc.).\n",[137,350,352],{"class":139,"line":351},16,[137,353,180],{"emptyLinePlaceholder":179},[137,355,357,360,363,366],{"class":139,"line":356},17,[137,358,359],{"class":154},"## The ",[137,361,362],{"class":150},"Match",[137,364,365],{"class":154}," Operator: ",[137,367,368],{"class":158},"`@@`\n",[137,370,372],{"class":139,"line":371},18,[137,373,180],{"emptyLinePlaceholder":179},[137,375,377,380,383,386,389,392],{"class":139,"line":376},19,[137,378,379],{"class":154},"::code",[137,381,382],{"class":150},"-",[137,384,385],{"class":154},"wrapper{",[137,387,388],{"class":150},"language=",[137,390,391],{"class":158},"\"sql\"",[137,393,394],{"class":154},"}\n",[137,396,398],{"class":139,"line":397},20,[137,399,400],{"class":158},"```sql\n",[137,402,404],{"class":139,"line":403},21,[137,405,406],{"class":158},"-- Does the document match the query?\n",[137,408,410],{"class":139,"line":409},22,[137,411,412],{"class":158},"SELECT to_tsvector('english', 'The quick brown fox') @@ to_tsquery('english', 'quick & fox');\n",[137,414,416],{"class":139,"line":415},23,[137,417,418],{"class":158},"--  true\n",[137,420,422],{"class":139,"line":421},24,[137,423,180],{"emptyLinePlaceholder":179},[137,425,427],{"class":139,"line":426},25,[137,428,429],{"class":158},"SELECT to_tsvector('english', 'The quick brown fox') @@ to_tsquery('english', 'quick & cat');\n",[137,431,433],{"class":139,"line":432},26,[137,434,435],{"class":158},"--  false\n",[137,437,439],{"class":139,"line":438},27,[137,440,249],{"class":158},[14,442,443,446],{},[18,444,445],{},"@@"," returns true if the tsvector contains all the tsquery's lexemes (with the specified boolean\u002Fphrase structure).",[31,448,450],{"id":449},"storing-and-indexing","Storing and Indexing",[14,452,453,454,456,457,460],{},"Store the ",[18,455,24],{}," in a ",[48,458,459],{},"generated column"," so it's always in sync with the source text, and index it with GIN:",[125,462,463],{"language":127},[129,464,466],{"className":131,"code":465,"language":127,"meta":133,"style":133},"CREATE TABLE articles (\n  id BIGSERIAL PRIMARY KEY,\n  title TEXT NOT NULL,\n  body TEXT NOT NULL,\n  -- Generated tsvector combining title (weight A) and body (weight B)\n  search_vec TSVECTOR GENERATED ALWAYS AS (\n    setweight(to_tsvector('english', coalesce(title, '')), 'A') ||\n    setweight(to_tsvector('english', coalesce(body, '')), 'B')\n  ) STORED\n);\n\nCREATE INDEX articles_search_vec_gin ON articles USING gin(search_vec);\n``\n::\n\n`setweight` assigns a weight (A, B, C, D — A is most important) to each lexeme, so title matches rank higher than body matches. The `||` concatenates the two vectors.\n\n### Querying with the index\n\n::code-wrapper{language=\"sql\"}\n```sql\nSELECT id, title, ts_rank(search_vec, query) AS rank\nFROM articles, to_tsquery('english', 'postgres & index') query\nWHERE search_vec @@ query\nORDER BY rank DESC\nLIMIT 10;\n``\n",[18,467,468,483,497,510,521,526,542,573,596,601,605,609,631,635,639,643,675,679,693,697,711,715,720,725,730,735,740],{"__ignoreMap":133},[137,469,470,473,476,480],{"class":139,"line":140},[137,471,472],{"class":150},"CREATE",[137,474,475],{"class":150}," TABLE",[137,477,479],{"class":478},"sIsaT"," articles",[137,481,482],{"class":154}," (\n",[137,484,485,488,491,494],{"class":139,"line":147},[137,486,487],{"class":154},"  id ",[137,489,490],{"class":150},"BIGSERIAL",[137,492,493],{"class":150}," PRIMARY KEY",[137,495,496],{"class":154},",\n",[137,498,499,502,505,508],{"class":139,"line":170},[137,500,501],{"class":154},"  title ",[137,503,504],{"class":150},"TEXT",[137,506,507],{"class":150}," NOT NULL",[137,509,496],{"class":154},[137,511,512,515,517,519],{"class":139,"line":176},[137,513,514],{"class":154},"  body ",[137,516,504],{"class":150},[137,518,507],{"class":150},[137,520,496],{"class":154},[137,522,523],{"class":139,"line":183},[137,524,525],{"class":143},"  -- Generated tsvector combining title (weight A) and body (weight B)\n",[137,527,528,531,534,537,540],{"class":139,"line":189},[137,529,530],{"class":154},"  search_vec TSVECTOR ",[137,532,533],{"class":150},"GENERATED",[137,535,536],{"class":150}," ALWAYS",[137,538,539],{"class":150}," AS",[137,541,482],{"class":154},[137,543,544,547,549,551,555,558,561,564,567,570],{"class":139,"line":206},[137,545,546],{"class":154},"    setweight(to_tsvector(",[137,548,159],{"class":158},[137,550,25],{"class":154},[137,552,554],{"class":553},"snvgF","coalesce",[137,556,557],{"class":154},"(title, ",[137,559,560],{"class":158},"''",[137,562,563],{"class":154},")), ",[137,565,566],{"class":158},"'A'",[137,568,569],{"class":154},") ",[137,571,572],{"class":150},"||\n",[137,574,575,577,579,581,583,586,588,590,593],{"class":139,"line":212},[137,576,546],{"class":154},[137,578,159],{"class":158},[137,580,25],{"class":154},[137,582,554],{"class":553},[137,584,585],{"class":154},"(body, ",[137,587,560],{"class":158},[137,589,563],{"class":154},[137,591,592],{"class":158},"'B'",[137,594,595],{"class":154},")\n",[137,597,598],{"class":139,"line":217},[137,599,600],{"class":154},"  ) STORED\n",[137,602,603],{"class":139,"line":223},[137,604,167],{"class":154},[137,606,607],{"class":139,"line":240},[137,608,180],{"emptyLinePlaceholder":179},[137,610,611,613,616,619,622,625,628],{"class":139,"line":246},[137,612,472],{"class":150},[137,614,615],{"class":150}," INDEX",[137,617,618],{"class":478}," articles_search_vec_gin",[137,620,621],{"class":150}," ON",[137,623,624],{"class":154}," articles ",[137,626,627],{"class":150},"USING",[137,629,630],{"class":154}," gin(search_vec);\n",[137,632,633],{"class":139,"line":252},[137,634,249],{"class":158},[137,636,637],{"class":139,"line":258},[137,638,255],{"class":154},[137,640,641],{"class":139,"line":263},[137,642,180],{"emptyLinePlaceholder":179},[137,644,645,648,651,654,657,660,663,666,669,672],{"class":139,"line":351},[137,646,647],{"class":158},"`setweight`",[137,649,650],{"class":154}," assigns a ",[137,652,653],{"class":150},"weight",[137,655,656],{"class":154}," (A, B, C, D — A ",[137,658,659],{"class":150},"is",[137,661,662],{"class":154}," most important) ",[137,664,665],{"class":150},"to",[137,667,668],{"class":154}," each lexeme, so title matches rank higher than body matches. The ",[137,670,671],{"class":158},"`||`",[137,673,674],{"class":154}," concatenates the two vectors.\n",[137,676,677],{"class":139,"line":356},[137,678,180],{"emptyLinePlaceholder":179},[137,680,681,684,687,690],{"class":139,"line":371},[137,682,683],{"class":154},"### Querying ",[137,685,686],{"class":150},"with",[137,688,689],{"class":154}," the ",[137,691,692],{"class":150},"index\n",[137,694,695],{"class":139,"line":376},[137,696,180],{"emptyLinePlaceholder":179},[137,698,699,701,703,705,707,709],{"class":139,"line":397},[137,700,379],{"class":154},[137,702,382],{"class":150},[137,704,385],{"class":154},[137,706,388],{"class":150},[137,708,391],{"class":158},[137,710,394],{"class":154},[137,712,713],{"class":139,"line":403},[137,714,400],{"class":158},[137,716,717],{"class":139,"line":409},[137,718,719],{"class":158},"SELECT id, title, ts_rank(search_vec, query) AS rank\n",[137,721,722],{"class":139,"line":415},[137,723,724],{"class":158},"FROM articles, to_tsquery('english', 'postgres & index') query\n",[137,726,727],{"class":139,"line":421},[137,728,729],{"class":158},"WHERE search_vec @@ query\n",[137,731,732],{"class":139,"line":426},[137,733,734],{"class":158},"ORDER BY rank DESC\n",[137,736,737],{"class":139,"line":432},[137,738,739],{"class":158},"LIMIT 10;\n",[137,741,742],{"class":139,"line":438},[137,743,249],{"class":158},[14,745,746,749,750,752,753,755],{},[18,747,748],{},"ts_rank"," computes a relevance score (higher = better match). The GIN index accelerates the ",[18,751,445],{}," filter; ",[18,754,748],{}," ranks the survivors.",[31,757,759],{"id":758},"search-features","Search Features",[761,762,764],"h3",{"id":763},"boolean-operators","Boolean operators",[125,766,767],{"language":127},[129,768,770],{"className":131,"code":769,"language":127,"meta":133,"style":133},"to_tsquery('english', 'postgres & index')      -- both terms\nto_tsquery('english', 'postgres | mysql')      -- either term\nto_tsquery('english', 'postgres & !mysql')     -- postgres, not mysql\n",[18,771,772,790,806],{"__ignoreMap":133},[137,773,774,777,779,781,784,787],{"class":139,"line":140},[137,775,776],{"class":154},"to_tsquery(",[137,778,159],{"class":158},[137,780,25],{"class":154},[137,782,783],{"class":158},"'postgres & index'",[137,785,786],{"class":154},")      ",[137,788,789],{"class":143},"-- both terms\n",[137,791,792,794,796,798,801,803],{"class":139,"line":147},[137,793,776],{"class":154},[137,795,159],{"class":158},[137,797,25],{"class":154},[137,799,800],{"class":158},"'postgres | mysql'",[137,802,786],{"class":154},[137,804,805],{"class":143},"-- either term\n",[137,807,808,810,812,814,817,820],{"class":139,"line":170},[137,809,776],{"class":154},[137,811,159],{"class":158},[137,813,25],{"class":154},[137,815,816],{"class":158},"'postgres & !mysql'",[137,818,819],{"class":154},")     ",[137,821,822],{"class":143},"-- postgres, not mysql\n",[761,824,826],{"id":825},"phrase-search","Phrase search",[125,828,829],{"language":127},[129,830,832],{"className":131,"code":831,"language":127,"meta":133,"style":133},"phraseto_tsquery('english', 'full text search')   -- the three words in order, adjacent\n-- 'full' \u003C-> 'text' \u003C-> 'search'\n\n-- Proximity (within N words)\nto_tsquery('english', 'quick \u003C3> fox')   -- 'quick' and 'fox' within 3 positions\n``\n::\n\n### Prefix matching\n\n::code-wrapper{language=\"sql\"}\n```sql\nto_tsquery('english', 'post:*')   -- matches 'postgres', 'posting', 'post', etc.\n``\n",[18,833,834,852,857,861,866,882,886,890,894,899,903,917,921,926],{"__ignoreMap":133},[137,835,836,839,841,843,846,849],{"class":139,"line":140},[137,837,838],{"class":154},"phraseto_tsquery(",[137,840,159],{"class":158},[137,842,25],{"class":154},[137,844,845],{"class":158},"'full text search'",[137,847,848],{"class":154},")   ",[137,850,851],{"class":143},"-- the three words in order, adjacent\n",[137,853,854],{"class":139,"line":147},[137,855,856],{"class":143},"-- 'full' \u003C-> 'text' \u003C-> 'search'\n",[137,858,859],{"class":139,"line":170},[137,860,180],{"emptyLinePlaceholder":179},[137,862,863],{"class":139,"line":176},[137,864,865],{"class":143},"-- Proximity (within N words)\n",[137,867,868,870,872,874,877,879],{"class":139,"line":183},[137,869,776],{"class":154},[137,871,159],{"class":158},[137,873,25],{"class":154},[137,875,876],{"class":158},"'quick \u003C3> fox'",[137,878,848],{"class":154},[137,880,881],{"class":143},"-- 'quick' and 'fox' within 3 positions\n",[137,883,884],{"class":139,"line":189},[137,885,249],{"class":158},[137,887,888],{"class":139,"line":206},[137,889,255],{"class":154},[137,891,892],{"class":139,"line":212},[137,893,180],{"emptyLinePlaceholder":179},[137,895,896],{"class":139,"line":217},[137,897,898],{"class":154},"### Prefix matching\n",[137,900,901],{"class":139,"line":223},[137,902,180],{"emptyLinePlaceholder":179},[137,904,905,907,909,911,913,915],{"class":139,"line":240},[137,906,379],{"class":154},[137,908,382],{"class":150},[137,910,385],{"class":154},[137,912,388],{"class":150},[137,914,391],{"class":158},[137,916,394],{"class":154},[137,918,919],{"class":139,"line":246},[137,920,400],{"class":158},[137,922,923],{"class":139,"line":252},[137,924,925],{"class":158},"to_tsquery('english', 'post:*')   -- matches 'postgres', 'posting', 'post', etc.\n",[137,927,928],{"class":139,"line":258},[137,929,249],{"class":158},[31,931,933],{"id":932},"highlighting","Highlighting",[125,935,936],{"language":127},[129,937,939],{"className":131,"code":938,"language":127,"meta":133,"style":133},"SELECT id, title,\n  ts_headline('english', body, to_tsquery('english', 'postgres'), 'MaxWords=20')\nFROM articles\nWHERE search_vec @@ to_tsquery('english', 'postgres');\n``\n::\n\n`ts_headline` returns a snippet of the body with the matched terms highlighted (by default, `\u003Cb>` tags, configurable).\n\n## Trigrams: Substring Search Without FTS\n\nFor \"substring search\" (`LIKE '%foo%'`) where FTS's stemming\u002Fstop-words aren't appropriate (e.g., product names, codes), use the `pg_trgm` extension:\n\n::code-wrapper{language=\"sql\"}\n```sql\nCREATE EXTENSION pg_trgm;\n\nCREATE INDEX products_name_trgm ON products USING gin(name gin_trgm_ops);\n\n-- Now these use the index:\nSELECT * FROM products WHERE name LIKE '%phone%';\nSELECT * FROM products WHERE name ILIKE '%PHONE%';\nSELECT * FROM products WHERE name % 'iphone';   -- similarity match\n``\n",[18,940,941,948,972,980,996,1000,1004,1008,1043,1047,1058,1062,1112,1116,1130,1134,1139,1143,1148,1152,1157,1162,1167,1172],{"__ignoreMap":133},[137,942,943,945],{"class":139,"line":140},[137,944,151],{"class":150},[137,946,947],{"class":154}," id, title,\n",[137,949,950,953,955,958,960,962,965,967,970],{"class":139,"line":147},[137,951,952],{"class":154},"  ts_headline(",[137,954,159],{"class":158},[137,956,957],{"class":154},", body, to_tsquery(",[137,959,159],{"class":158},[137,961,25],{"class":154},[137,963,964],{"class":158},"'postgres'",[137,966,299],{"class":154},[137,968,969],{"class":158},"'MaxWords=20'",[137,971,595],{"class":154},[137,973,974,977],{"class":139,"line":170},[137,975,976],{"class":150},"FROM",[137,978,979],{"class":154}," articles\n",[137,981,982,985,988,990,992,994],{"class":139,"line":176},[137,983,984],{"class":150},"WHERE",[137,986,987],{"class":154}," search_vec @@ to_tsquery(",[137,989,159],{"class":158},[137,991,25],{"class":154},[137,993,964],{"class":158},[137,995,167],{"class":154},[137,997,998],{"class":139,"line":183},[137,999,249],{"class":158},[137,1001,1002],{"class":139,"line":189},[137,1003,255],{"class":154},[137,1005,1006],{"class":139,"line":206},[137,1007,180],{"emptyLinePlaceholder":179},[137,1009,1010,1013,1016,1019,1021,1023,1026,1029,1032,1035,1037,1040],{"class":139,"line":212},[137,1011,1012],{"class":158},"`ts_headline`",[137,1014,1015],{"class":150}," returns",[137,1017,1018],{"class":154}," a snippet of the body ",[137,1020,686],{"class":150},[137,1022,689],{"class":154},[137,1024,1025],{"class":150},"matched",[137,1027,1028],{"class":154}," terms highlighted (",[137,1030,1031],{"class":150},"by",[137,1033,1034],{"class":150}," default",[137,1036,25],{"class":154},[137,1038,1039],{"class":158},"`\u003Cb>`",[137,1041,1042],{"class":154}," tags, configurable).\n",[137,1044,1045],{"class":139,"line":217},[137,1046,180],{"emptyLinePlaceholder":179},[137,1048,1049,1052,1055],{"class":139,"line":223},[137,1050,1051],{"class":154},"## Trigrams: Substring Search ",[137,1053,1054],{"class":150},"Without",[137,1056,1057],{"class":154}," FTS\n",[137,1059,1060],{"class":139,"line":240},[137,1061,180],{"emptyLinePlaceholder":179},[137,1063,1064,1067,1070,1073,1076,1078,1081,1084,1087,1090,1093,1095,1098,1101,1104,1106,1109],{"class":139,"line":246},[137,1065,1066],{"class":150},"For",[137,1068,1069],{"class":158}," \"substring search\"",[137,1071,1072],{"class":154}," (",[137,1074,1075],{"class":158},"`LIKE '%foo%'`",[137,1077,569],{"class":154},[137,1079,1080],{"class":150},"where",[137,1082,1083],{"class":154}," FTS",[137,1085,1086],{"class":158},"'s stemming\u002Fstop-words aren'",[137,1088,1089],{"class":154},"t appropriate (",[137,1091,1092],{"class":553},"e",[137,1094,69],{"class":154},[137,1096,1097],{"class":553},"g",[137,1099,1100],{"class":154},"., product names, codes), ",[137,1102,1103],{"class":150},"use",[137,1105,689],{"class":154},[137,1107,1108],{"class":158},"`pg_trgm`",[137,1110,1111],{"class":154}," extension:\n",[137,1113,1114],{"class":139,"line":252},[137,1115,180],{"emptyLinePlaceholder":179},[137,1117,1118,1120,1122,1124,1126,1128],{"class":139,"line":258},[137,1119,379],{"class":154},[137,1121,382],{"class":150},[137,1123,385],{"class":154},[137,1125,388],{"class":150},[137,1127,391],{"class":158},[137,1129,394],{"class":154},[137,1131,1132],{"class":139,"line":263},[137,1133,400],{"class":158},[137,1135,1136],{"class":139,"line":351},[137,1137,1138],{"class":158},"CREATE EXTENSION pg_trgm;\n",[137,1140,1141],{"class":139,"line":356},[137,1142,180],{"emptyLinePlaceholder":179},[137,1144,1145],{"class":139,"line":371},[137,1146,1147],{"class":158},"CREATE INDEX products_name_trgm ON products USING gin(name gin_trgm_ops);\n",[137,1149,1150],{"class":139,"line":376},[137,1151,180],{"emptyLinePlaceholder":179},[137,1153,1154],{"class":139,"line":397},[137,1155,1156],{"class":158},"-- Now these use the index:\n",[137,1158,1159],{"class":139,"line":403},[137,1160,1161],{"class":158},"SELECT * FROM products WHERE name LIKE '%phone%';\n",[137,1163,1164],{"class":139,"line":409},[137,1165,1166],{"class":158},"SELECT * FROM products WHERE name ILIKE '%PHONE%';\n",[137,1168,1169],{"class":139,"line":415},[137,1170,1171],{"class":158},"SELECT * FROM products WHERE name % 'iphone';   -- similarity match\n",[137,1173,1174],{"class":139,"line":421},[137,1175,249],{"class":158},[14,1177,1178,1179,1182],{},"Trigrams (3-character substrings) enable fast substring and fuzzy (similarity) matching. Use ",[18,1180,1181],{},"pg_trgm"," for short-text\u002Fsubstring search; use FTS for natural-language document search.",[31,1184,1186],{"id":1185},"choosing-fts-vs-trigrams-vs-like","Choosing: FTS vs Trigrams vs LIKE",[1188,1189,1190,1203],"table",{},[1191,1192,1193],"thead",{},[1194,1195,1196,1200],"tr",{},[1197,1198,1199],"th",{},"Need",[1197,1201,1202],{},"Use",[1204,1205,1206,1221,1230,1241,1248],"tbody",{},[1194,1207,1208,1212],{},[1209,1210,1211],"td",{},"Natural-language documents (articles, descriptions), ranked",[1209,1213,1214,1215,1217,1218,1220],{},"FTS (",[18,1216,24],{},"\u002F",[18,1219,28],{},")",[1194,1222,1223,1226],{},[1209,1224,1225],{},"Substring search on short text (product names, codes)",[1209,1227,1228],{},[18,1229,1181],{},[1194,1231,1232,1238],{},[1209,1233,1234,1235,1220],{},"Exact prefix (",[18,1236,1237],{},"LIKE 'foo%'",[1209,1239,1240],{},"B-tree index",[1194,1242,1243,1246],{},[1209,1244,1245],{},"Simple equality",[1209,1247,1240],{},[1194,1249,1250,1253],{},[1209,1251,1252],{},"Fuzzy\u002Fsimilarity matching",[1209,1254,1255,1072,1257,1260,1261,1220],{},[18,1256,1181],{},[18,1258,1259],{},"%"," operator, ",[18,1262,1263],{},"similarity()",[31,1265,1267],{"id":1266},"tips-tricks","💡 Tips & Tricks",[92,1269,1270,1284,1296,1314,1322],{},[45,1271,1272,1275,1276,456,1278,1072,1280,1283],{},[48,1273,1274],{},"Idiom",": store the ",[18,1277,24],{},[48,1279,459],{},[18,1281,1282],{},"GENERATED ALWAYS AS (...) STORED",") so it's always in sync with the source text — no trigger needed, no stale vectors after direct updates. Index the generated column with GIN.",[45,1285,1286,1288,1289,1292,1293,1295],{},[48,1287,1274],{},": use ",[18,1290,1291],{},"setweight(to_tsvector('english', title), 'A') || setweight(to_tsvector('english', body), 'B')"," to rank title matches above body matches — ",[18,1294,748],{}," incorporates the weights, so a title hit outranks a body hit.",[45,1297,1298,1301,1302,1304,1305,1307,1308,1310,1311,1313],{},[48,1299,1300],{},"Performance",": always GIN-index the ",[18,1303,24],{}," — without it, ",[18,1306,445],{}," scans every document. A GIN index on a ",[18,1309,24],{}," column makes ",[18,1312,445],{}," queries O(matches) instead of O(all documents).",[45,1315,1316,1288,1318,1321],{},[48,1317,1274],{},[18,1319,1320],{},"ts_headline"," to generate search-result snippets with highlighted terms — it's a built-in \"search result preview\" that beats manually substring-slicing the body in application code.",[45,1323,1324,1327,1328,1331,1332,1335],{},[48,1325,1326],{},"Portability",": PostgreSQL FTS is PostgreSQL-specific. MySQL has ",[18,1329,1330],{},"FULLTEXT"," indexes (",[18,1333,1334],{},"MATCH ... AGAINST","). SQLite has FTS5 (a separate virtual table module). The concepts (stemming, ranking, inverted index) are universal; the syntax isn't.",[31,1337,1339],{"id":1338},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[92,1341,1342,1364,1376,1387,1396,1416,1424,1439,1465,1480],{},[45,1343,1344,1347,1348,1351,1352,1355,1356,1359,1360,1363],{},[48,1345,1346],{},"Stop words are removed",": ",[18,1349,1350],{},"to_tsquery('english', 'the & fox')"," drops ",[18,1353,1354],{},"the"," (a stop word), so it's just ",[18,1357,1358],{},"'fox'",". This is usually fine, but ",[18,1361,1362],{},"phraseto_tsquery('the quick brown fox')"," keeps the positions, so phrase search still works.",[45,1365,1366,1347,1369,1372,1373,1375],{},[48,1367,1368],{},"Stemming can over-match",[18,1370,1371],{},"to_tsquery('english', 'run')"," matches \"run\", \"running\", \"runs\", \"ran\" (all stem to \"run\"). Good for search, bad for exact-term queries — use ",[18,1374,20],{}," or trigrams for exact matching.",[45,1377,1378,1383,1384,1386],{},[48,1379,1380,1382],{},[18,1381,748],{}," is not normalized",": it's a sum of weighted frequencies, not a 0–1 score. Don't compare ",[18,1385,748],{}," across different queries; compare within a result set.",[45,1388,1389,1392,1393,1395],{},[48,1390,1391],{},"GIN index size",": a GIN index on a ",[18,1394,24],{}," can be large (it's an inverted index of every lexeme). For huge tables, consider a partial index or periodic reindex.",[45,1397,1398,1347,1401,1404,1405,25,1408,1411,1412,1415],{},[48,1399,1400],{},"Language matters",[18,1402,1403],{},"to_tsvector('english', ...)"," uses English stemming\u002Fstop words. Use the right configuration for your content (",[18,1406,1407],{},"'spanish'",[18,1409,1410],{},"'german'",", etc.) — or ",[18,1413,1414],{},"'simple'"," for no stemming\u002Fstop words (exact word matching).",[45,1417,1418,1423],{},[48,1419,1420,1422],{},[18,1421,1414],{}," configuration",": no stemming, no stop words — treats every word as a literal lexeme. Useful for codes, identifiers, or non-natural-language text.",[45,1425,1426,1431,1432,1217,1435,1438],{},[48,1427,1428,1430],{},[18,1429,24],{}," column must be kept in sync",": if you store it as a regular column (not generated), you need a trigger to update it on ",[18,1433,1434],{},"INSERT",[18,1436,1437],{},"UPDATE",". Generated columns are the modern, maintenance-free way.",[45,1440,1441,1347,1453,1456,1457,1460,1461,1464],{},[48,1442,1443,1446,1447,1450,1451],{},[18,1444,1445],{},"phraseto_tsquery"," vs ",[18,1448,1449],{},"to_tsquery"," with ",[18,1452,122],{},[18,1454,1455],{},"phraseto_tsquery('a b c')"," builds ",[18,1458,1459],{},"'a' \u003C-> 'b' \u003C-> 'c'"," (adjacent in order). ",[18,1462,1463],{},"to_tsquery('a & b & c')"," is just \"all three present, any order.\" Pick based on whether order\u002Fadjacency matters.",[45,1466,1467,1347,1473,1476,1477,1479],{},[48,1468,1469,1470],{},"Prefix matching with ",[18,1471,1472],{},":*",[18,1474,1475],{},"to_tsquery('english', 'post:*')"," matches any lexeme starting with \"post\" — useful for typeahead search. The ",[18,1478,1472],{}," must be on a lexeme, not a phrase.",[45,1481,1482,1347,1485,1488,1489,1491,1492,1494],{},[48,1483,1484],{},"FTS doesn't do fuzzy spelling",[18,1486,1487],{},"to_tsquery('english', 'popstgres')"," won't match \"postgres\" (it's a different lexeme after stemming). For typo tolerance, use ",[18,1490,1181],{},"'s similarity operator (",[18,1493,1259],{},") alongside FTS.",[31,1496,1498],{"id":1497},"spot-the-bug","🧠 Spot the Bug",[14,1500,1501],{},"A developer creates an FTS index on an article body and queries it, but gets no results for a search on \"databases\":",[125,1503,1504,1792,1803,1807],{"language":127},[129,1505,1507],{"className":131,"code":1506,"language":127,"meta":133,"style":133},"CREATE INDEX articles_body_gin ON articles USING gin(to_tsvector('english', body));\n\nSELECT * FROM articles WHERE to_tsvector('english', body) @@ to_tsquery('english', 'database');\n``\n::\n\nThe body contains the word \"databases\". What's the issue?\n\n\u003Cdetails>\n\u003Csummary>Answer\u003C\u002Fsummary>\n\nThis actually *should* work — `to_tsquery('english', 'database')` stems to `'databas'`, and `to_tsvector('english', body)` stems \"databases\" to `'databas'` too, so they match. If it returns no results, the likely cause is that the **index isn't being used and the seq scan is correct but the body genuinely doesn't contain the word** — or there's a type\u002Fconfig mismatch.\n\nBut there's a subtler bug: the index is on `to_tsvector('english', body)`, and the query filters on `to_tsvector('english', body) @@ ...` — the expressions match, so the index *is* usable. The query should work.\n\nThe most common real-world version of this bug: **the developer indexed `to_tsvector('english', body)` but queried with `to_tsvector('simple', body)`** (or vice versa) — a different text search configuration produces different lexemes, so the index (built with `'english'`) can't serve a query built with `'simple'`. Or they indexed the column directly (`gin(body)`) which doesn't work for FTS — you must index the `to_tsvector(...)` expression.\n\nThe robust fix — store the `tsvector` in a generated column and index that, then query the column directly (no expression mismatch possible):\n\n```sql\nALTER TABLE articles ADD COLUMN body_vec TSVECTOR\n  GENERATED ALWAYS AS (to_tsvector('english', body)) STORED;\nCREATE INDEX articles_body_vec_gin ON articles USING gin(body_vec);\nSELECT * FROM articles WHERE body_vec @@ to_tsquery('english', 'database');\n",[18,1508,1509,1532,1536,1566,1570,1574,1578,1592,1596,1601,1606,1610,1668,1672,1690,1694,1741,1745,1750,1754,1758,1763,1773,1778],{"__ignoreMap":133},[137,1510,1511,1513,1515,1518,1520,1522,1524,1527,1529],{"class":139,"line":140},[137,1512,472],{"class":150},[137,1514,615],{"class":150},[137,1516,1517],{"class":478}," articles_body_gin",[137,1519,621],{"class":150},[137,1521,624],{"class":154},[137,1523,627],{"class":150},[137,1525,1526],{"class":154}," gin(to_tsvector(",[137,1528,159],{"class":158},[137,1530,1531],{"class":154},", body));\n",[137,1533,1534],{"class":139,"line":147},[137,1535,180],{"emptyLinePlaceholder":179},[137,1537,1538,1540,1543,1546,1548,1550,1552,1554,1557,1559,1561,1564],{"class":139,"line":170},[137,1539,151],{"class":150},[137,1541,1542],{"class":150}," *",[137,1544,1545],{"class":150}," FROM",[137,1547,624],{"class":154},[137,1549,984],{"class":150},[137,1551,155],{"class":154},[137,1553,159],{"class":158},[137,1555,1556],{"class":154},", body) @@ to_tsquery(",[137,1558,159],{"class":158},[137,1560,25],{"class":154},[137,1562,1563],{"class":158},"'database'",[137,1565,167],{"class":154},[137,1567,1568],{"class":139,"line":176},[137,1569,249],{"class":158},[137,1571,1572],{"class":139,"line":183},[137,1573,255],{"class":154},[137,1575,1576],{"class":139,"line":189},[137,1577,180],{"emptyLinePlaceholder":179},[137,1579,1580,1583,1586,1589],{"class":139,"line":206},[137,1581,1582],{"class":154},"The body contains the word ",[137,1584,1585],{"class":158},"\"databases\"",[137,1587,1588],{"class":154},". What",[137,1590,1591],{"class":158},"'s the issue?\n",[137,1593,1594],{"class":139,"line":212},[137,1595,180],{"emptyLinePlaceholder":179},[137,1597,1598],{"class":139,"line":217},[137,1599,1600],{"class":158},"\u003Cdetails>\n",[137,1602,1603],{"class":139,"line":223},[137,1604,1605],{"class":158},"\u003Csummary>Answer\u003C\u002Fsummary>\n",[137,1607,1608],{"class":139,"line":240},[137,1609,180],{"emptyLinePlaceholder":179},[137,1611,1612,1615,1618,1621,1624,1627,1630,1633,1635,1638,1640,1643,1646,1648,1651,1653,1656,1659,1662,1665],{"class":139,"line":246},[137,1613,1614],{"class":158},"This actually *should* work — `to_tsquery('",[137,1616,1617],{"class":154},"english",[137,1619,1620],{"class":158},"', '",[137,1622,1623],{"class":150},"database",[137,1625,1626],{"class":158},"')` stems to `'",[137,1628,1629],{"class":154},"databas",[137,1631,1632],{"class":158},"'`, and `to_tsvector('",[137,1634,1617],{"class":154},[137,1636,1637],{"class":158},"', body)` stems \"databases\" to `'",[137,1639,1629],{"class":154},[137,1641,1642],{"class":158},"'` too, so they match. If it returns no results, the likely cause is that the **index isn'",[137,1644,1645],{"class":154},"t being used ",[137,1647,302],{"class":150},[137,1649,1650],{"class":154}," the seq scan ",[137,1652,659],{"class":150},[137,1654,1655],{"class":154}," correct but the body genuinely doesn",[137,1657,1658],{"class":158},"'t contain the word** — or there'",[137,1660,1661],{"class":154},"s a ",[137,1663,1664],{"class":150},"type\u002F",[137,1666,1667],{"class":154},"config mismatch.\n",[137,1669,1670],{"class":139,"line":252},[137,1671,180],{"emptyLinePlaceholder":179},[137,1673,1674,1677,1680,1682,1685,1687],{"class":139,"line":258},[137,1675,1676],{"class":154},"But there",[137,1678,1679],{"class":158},"'s a subtler bug: the index is on `to_tsvector('",[137,1681,1617],{"class":154},[137,1683,1684],{"class":158},"', body)`, and the query filters on `to_tsvector('",[137,1686,1617],{"class":154},[137,1688,1689],{"class":158},"', body) @@ ...` — the expressions match, so the index *is* usable. The query should work.\n",[137,1691,1692],{"class":139,"line":263},[137,1693,180],{"emptyLinePlaceholder":179},[137,1695,1696,1699,1701,1704,1707,1710,1712,1715,1718,1720,1723,1726,1729,1732,1735,1738],{"class":139,"line":351},[137,1697,1698],{"class":158},"The most common real-world version of this bug: **the developer indexed `to_tsvector('",[137,1700,1617],{"class":154},[137,1702,1703],{"class":158},"', body)` but queried with `to_tsvector('",[137,1705,1706],{"class":150},"simple",[137,1708,1709],{"class":158},"', body)`** (or vice versa) — a different text search configuration produces different lexemes, so the index (built with `'",[137,1711,1617],{"class":154},[137,1713,1714],{"class":158},"'`) can'",[137,1716,1717],{"class":154},"t serve a query built ",[137,1719,686],{"class":150},[137,1721,1722],{"class":158}," `'simple'`",[137,1724,1725],{"class":154},". ",[137,1727,1728],{"class":150},"Or",[137,1730,1731],{"class":154}," they indexed the column directly (",[137,1733,1734],{"class":158},"`gin(body)`",[137,1736,1737],{"class":154},") which doesn",[137,1739,1740],{"class":158},"'t work for FTS — you must index the `to_tsvector(...)` expression.\n",[137,1742,1743],{"class":139,"line":356},[137,1744,180],{"emptyLinePlaceholder":179},[137,1746,1747],{"class":139,"line":371},[137,1748,1749],{"class":158},"The robust fix — store the `tsvector` in a generated column and index that, then query the column directly (no expression mismatch possible):\n",[137,1751,1752],{"class":139,"line":376},[137,1753,180],{"emptyLinePlaceholder":179},[137,1755,1756],{"class":139,"line":397},[137,1757,400],{"class":158},[137,1759,1760],{"class":139,"line":403},[137,1761,1762],{"class":158},"ALTER TABLE articles ADD COLUMN body_vec TSVECTOR\n",[137,1764,1765,1768,1770],{"class":139,"line":409},[137,1766,1767],{"class":158},"  GENERATED ALWAYS AS (to_tsvector('",[137,1769,1617],{"class":154},[137,1771,1772],{"class":158},"', body)) STORED;\n",[137,1774,1775],{"class":139,"line":415},[137,1776,1777],{"class":158},"CREATE INDEX articles_body_vec_gin ON articles USING gin(body_vec);\n",[137,1779,1780,1783,1785,1787,1789],{"class":139,"line":421},[137,1781,1782],{"class":158},"SELECT * FROM articles WHERE body_vec @@ to_tsquery('",[137,1784,1617],{"class":154},[137,1786,1620],{"class":158},[137,1788,1623],{"class":150},[137,1790,1791],{"class":158},"');\n",[14,1793,255,1794,1797,1798,1802],{},[48,1795,1796],{},"The lesson",": when indexing an expression, the query must use the ",[1799,1800,1801],"em",{},"exact same expression"," (including the text search configuration). Generated columns eliminate this class of bug by naming the expression once and reusing the name.",[31,1804,1806],{"id":1805},"summary","Summary",[14,1808,1809,1810,1217,1812,1217,1814,1816,1817,1819,1820,1822,1823,1825,1826,1828],{},"You can now build full-text search with ",[18,1811,24],{},[18,1813,28],{},[18,1815,445],{},", weight and rank results with ",[18,1818,748],{},", highlight with ",[18,1821,1320],{},", store vectors in generated columns with GIN indexes, and choose between FTS (natural language), ",[18,1824,1181],{}," (substring\u002Ffuzzy), and ",[18,1827,20],{}," (prefix). Next: triggers — running code automatically on data changes.",[1830,1831,1832],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font