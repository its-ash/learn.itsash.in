,{}," are available.",[29,361,362,364,365,47,367,369],{},[44,363,67],{}," — fires once per statement, regardless of how many rows it affected. ",[44,366,259],{},[44,368,263],{}," aren't available (use transition tables, below).",[70,371,372],{"language":72},[74,373,375],{"className":76,"code":374,"language":72,"meta":78,"style":78},"-- Statement-level trigger with transition tables (PostgreSQL 10+)\nCREATE FUNCTION audit_orders() RETURNS trigger AS $$\nBEGIN\n  INSERT INTO audit_log (action, count)\n  SELECT TG_OP, count(*) FROM new_table;   -- or old_table\n  RETURN NULL;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER orders_audit\n  AFTER INSERT OR UPDATE OR DELETE ON orders\n  REFERENCING NEW TABLE AS new_table OLD TABLE AS old_table\n  FOR EACH STATEMENT\n  EXECUTE FUNCTION audit_orders();\n",[44,376,377,382,401,405,419,448,457,463,471,475,484,507,528,537],{"__ignoreMap":78},[82,378,379],{"class":84,"line":85},[82,380,381],{"class":88},"-- Statement-level trigger with transition tables (PostgreSQL 10+)\n",[82,383,384,386,388,391,393,395,397,399],{"class":84,"line":92},[82,385,96],{"class":95},[82,387,99],{"class":95},[82,389,390],{"class":102}," audit_orders",[82,392,107],{"class":106},[82,394,110],{"class":95},[82,396,113],{"class":106},[82,398,116],{"class":95},[82,400,119],{"class":106},[82,402,403],{"class":84,"line":122},[82,404,125],{"class":95},[82,406,407,410,413,416],{"class":84,"line":128},[82,408,409],{"class":95},"  INSERT INTO",[82,411,412],{"class":106}," audit_log (",[82,414,415],{"class":95},"action",[82,417,418],{"class":106},", count)\n",[82,420,421,424,427,430,433,436,439,442,445],{"class":84,"line":153},[82,422,423],{"class":95},"  SELECT",[82,425,426],{"class":106}," TG_OP, ",[82,428,429],{"class":131},"count",[82,431,432],{"class":106},"(",[82,434,435],{"class":95},"*",[82,437,438],{"class":106},") ",[82,440,441],{"class":95},"FROM",[82,443,444],{"class":106}," new_table;   ",[82,446,447],{"class":88},"-- or old_table\n",[82,449,450,452,455]