[{"data":1,"prerenderedAt":2080},["ShallowReactive",2],{"page-\u002Fsql\u002F21-triggers-and-events":3},{"id":4,"title":5,"body":6,"description":16,"extension":2074,"meta":2075,"navigation":186,"path":2076,"seo":2077,"stem":2078,"__hash__":2079},"content\u002Fsql\u002F21-triggers-and-events.md","21 — Triggers & Events",{"type":7,"value":8,"toc":2056},"minimark",[9,13,17,22,25,69,243,265,269,328,343,347,370,547,553,557,605,610,638,643,647,748,752,757,1117,1124,1128,1377,1386,1390,1406,1410,1471,1475,1480,1491,1496,1520,1524,1595,1599,1741,1745,1758,2052],[10,11,5],"h1",{"id":12},"_21-triggers-events",[14,15,16],"p",{},"Triggers run functions automatically when data changes — for audit logs, derived columns, cross-table consistency, and enforcing rules that constraints can't express. They're powerful and dangerous: invisible side effects, performance overhead, and debugging difficulty. Use them judiciously.",[18,19,21],"h2",{"id":20},"trigger-anatomy","Trigger Anatomy",[14,23,24],{},"A trigger has two parts:",[26,27,28,37],"ol",{},[29,30,31,32,36],"li",{},"A ",[33,34,35],"strong",{},"trigger function"," — the code to run (written in PL\u002FpgSQL or another language).",[29,38,31,39,42,43,47,48,47,51,54,55,47,58,61,62,47,65,68],{},[33,40,41],{},"trigger"," — the binding of that function to a table and an event (",[44,45,46],"code",{},"INSERT","\u002F",[44,49,50],{},"UPDATE",[44,52,53],{},"DELETE","), with timing (",[44,56,57],{},"BEFORE",[44,59,60],{},"AFTER",") and granularity (",[44,63,64],{},"FOR EACH ROW",[44,66,67],{},"FOR EACH STATEMENT",").",[70,71,73],"code-wrapper",{"language":72},"sql",[74,75,79],"pre",{"className":76,"code":77,"language":72,"meta":78,"style":78},"language-sql shiki shiki-themes github-light github-dark","-- The function\nCREATE FUNCTION update_modified_at() RETURNS trigger AS $$\nBEGIN\n  NEW.modified_at = now();   -- BEFORE row triggers can modify NEW\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\n-- The trigger\nCREATE TRIGGER touch_modified_at\n  BEFORE UPDATE ON customers\n  FOR EACH ROW\n  EXECUTE FUNCTION update_modified_at();\n","",[44,80,81,90,120,126,151,160,169,181,188,194,205,220,232],{"__ignoreMap":78},[82,83,86],"span",{"class":84,"line":85},"line",1,[82,87,89],{"class":88},"sdCPZ","-- The function\n",[82,91,93,97,100,104,108,111,114,117],{"class":84,"line":92},2,[82,94,96],{"class":95},"svdQ7","CREATE",[82,98,99],{"class":95}," FUNCTION",[82,101,103],{"class":102},"sIsaT"," update_modified_at",[82,105,107],{"class":106},"ssxIu","() ",[82,109,110],{"class":95},"RETURNS",[82,112,113],{"class":106}," trigger ",[82,115,116],{"class":95},"AS",[82,118,119],{"class":106}," $$\n",[82,121,123],{"class":84,"line":122},3,[82,124,125],{"class":95},"BEGIN\n",[82,127,129,133,136,139,142,145,148],{"class":84,"line":128},4,[82,130,132],{"class":131},"snvgF","  NEW",[82,134,135],{"class":106},".",[82,137,138],{"class":131},"modified_at",[82,140,141],{"class":95}," =",[82,143,144],{"class":95}," now",[82,146,147],{"class":106},"();   ",[82,149,150],{"class":88},"-- BEFORE row triggers can modify NEW\n",[82,152,154,157],{"class":84,"line":153},5,[82,155,156],{"class":95},"  RETURN",[82,158,159],{"class":106}," NEW;\n",[82,161,163,166],{"class":84,"line":162},6,[82,164,165],{"class":95},"END",[82,167,168],{"class":106},";\n",[82,170,172,175,178],{"class":84,"line":171},7,[82,173,174],{"class":106},"$$ ",[82,176,177],{"class":95},"LANGUAGE",[82,179,180],{"class":106}," plpgsql;\n",[82,182,184],{"class":84,"line":183},8,[82,185,187],{"emptyLinePlaceholder":186},true,"\n",[82,189,191],{"class":84,"line":190},9,[82,192,193],{"class":88},"-- The trigger\n",[82,195,197,199,202],{"class":84,"line":196},10,[82,198,96],{"class":95},[82,200,201],{"class":95}," TRIGGER",[82,203,204],{"class":102}," touch_modified_at\n",[82,206,208,211,214,217],{"class":84,"line":207},11,[82,209,210],{"class":95},"  BEFORE",[82,212,213],{"class":95}," UPDATE",[82,215,216],{"class":95}," ON",[82,218,219],{"class":106}," customers\n",[82,2