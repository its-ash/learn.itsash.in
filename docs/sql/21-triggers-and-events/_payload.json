2,1069,1070],{"class":853},"  UPDATE orders SET customer_name = NEW.name WHERE customer_id = NEW.id;\n",[82,1072,1074],{"class":84,"line":1073},29,[82,1075,1076],{"class":853},"  RETURN NEW;\n",[82,1078,1080],{"class":84,"line":1079},30,[82,1081,1082],{"class":853},"END;\n",[82,1084,1086],{"class":84,"line":1085},31,[82,1087,1088],{"class":853},"$$ LANGUAGE plpgsql;\n",[82,1090,1092],{"class":84,"line":1091},32,[82,1093,187],{"emptyLinePlaceholder":186},[82,1095,1097],{"class":84,"line":1096},33,[82,1098,1099],{"class":853},"CREATE TRIGGER customers_sync_name\n",[82,1101,1103],{"class":84,"line":1102},34,[82,1104,1105],{"class":853},"  AFTER UPDATE OF name ON customers\n",[82,1107,1109],{"class":84,"line":1108},35,[82,1110,1111],{"class":853},"  FOR EACH ROW EXECUTE FUNCTION sync_customer_name();\n",[82,1113,1115],{"class":84,"line":1114},36,[82,1116,992],{"class":853},[14,1118,1119,1120,1123],{},"Note: ",[33,1121,1122],{},"generated columns"," (chapter 11) are better for single-row derivations. Triggers are for cross-table denormalization where a generated column can't reach.",[753,1125,1127],{"id":1126},"preventing-deletes","Preventing deletes",[70,1129,1130],{"language":72},[74,1131,1133],{"className":76,"code":1132,"language":72,"meta":78,"style":78},"CREATE FUNCTION no_delete_active() RETURNS trigger AS $$\nBEGIN\n  RAISE EXCEPTION 'Cannot delete active customer %', OLD.id;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER block_active_delete\n  BEFORE DELETE ON customers\n  FOR EACH ROW\n  WHEN (OLD.active = true)\n  EXECUTE FUNCTION no_delete_active();\n``\n::\n\nThe `WHEN` clause limits the trigger to rows matching a condition — a filter that avoids running the function for non-matching rows (performance optimization).\n\n## Conditional Triggers (WHEN)\n\n::code-wrapper{language=\"sql\"}\n```sql\n-- Only fire when the name actually changes\nCREATE TRIGGER touch_modified_at\n  BEFORE UPDATE ON customers\n  FOR EACH ROW\n  WHEN (NEW.name IS DISTINCT FROM OLD.name)   -- avoids firing on no-op updates\n  EXECUTE FUNCTION update_modified_at();\n``\n",[44,1134,1135,1154,1158,1176,1182,1190,1194,1203,1213,1221,1240,1249,1253,1257,1261,1307,1311,1321,1325,1339,1343,1348,1353,1358,1363,1368,1373],{"__ignoreMap":78},[82,1136,1137,1139,1141,1144,1146,1148,1150,1152],{"class":84,"line":85},[82,1138,96],{"class":95},[82,1140,99],{"class":95},[82,1142,1143],{"class":102}," no_delete_active",[82,1145,107],{"class":106},[82,1147,110],{"class":95},[82,1149,113],{"class":106},[82,1151,116],{"class":95},[82,1153,119],{"class":106},[82,1155,1156],{"class":84,"line":92},[82,1157,125],{"class":95},[82,1159,1160,1163,1166,1168,1170,1172,1174],{"class":84,"line":122},[82,1161,1162],{"class":106},"  RAISE EXCEPTION ",[82,1164,1165],{"class":853},"'Cannot delete active customer %'",[82,1167,628],{"class":106},[82,1169,263],{"class":131},[82,1171,135],{"class":106},[82,1173,825],{"class":131},[82,1175,168],{"class":106},[82,1177,1178,1180],{"class":84,"line":128},[82,1179,165],{"class":95},[82,1181,168],{"class":106},[82,1183,1184,1186,1188],{"class":84,"line":153},[82,1185,174],{"class":106},[82,1187,177],{"class":95},[82,1189,180],{"class":106},[82,1191,1192],{"class":84,"line":162},[82,1193,187],{"emptyLinePlaceholder":186},[82,1195,1196,1198,1200],{"class":84,"line":171},[82,1197,96],{"class":95},[82,1199,201],{"class":95},[82,1201,1202],{"class":102}," block_active_delete\n",[82,1204,1205,1207,1209,1211],{"class":84,"line":183},[82,1206,210],{"class":95},[82,1208,501],{"class":95},[82,1210,216],{"class":95},[82,1212,219],{"class":106},[82,1214,1215,1217,1219],{"class":84,"line":190},[82,1216,225],{"class":95},[82,1218,228],{"class":106},[82,1220,231],{"class":95},[82,1222,1223,1226,1228,1230,1232,1235,1237],{"class":84,"line":196},[82,1224,1225],{"class":95},"  WHEN",[82,1227,879],{"class":106},[82,1229,263],{"class":131},[82,1231,135],{"class":106},[82,1233,1234],{"class":131},"active",[82,1236,141],{"class":95},[82,1238,1239],{"class":106}," true)\n",[82,1241,1242,1244,1246],{"class":84,"line":207},[82,1243,237],{"class":95},[82,1245,99],{"class":95},[82,1247,1248],{"class":106}," no_delete_active();\n",[82,1250,1251],{"class":84,"line":222},[82,1252,992],{"class":853},[82,1254,1255],{"class":84,"line":234},[82,1256,998],{"class":106},[82,1258,1259],{"class":84,"line":539},[82,1260,187],{"emptyLinePlaceholder":186},[82,1262,1263,1266,1269,1272,1275,1278,1281,1284,1287,1290,1293,1296,1298,1301,1304],{"class":84,"line":942},[82,1264,1265],{"class":106},"The ",[82,1267,1268],{"class":853},"`WHEN`",[82,1270,1271],{"class":106}," clause limits the trigger ",[82,1273,1274],{"class":95},"to",[82,1276,1277],{"class":95}," rows",[82,1279,1280],{"class":106}," matching a condition — a ",[82,1282,1283],{"class":95},"filter",[82,1285,1286],{"class":106}," that avoids running the ",[82,1288,1289],{"class":95},"function",[82,1291,1292],{"class":95}," for",[82,1294,1295],{"class":106}," non",[82,1297,1029],{"class":95},[82,1299,1300],{"class":106},"matching ",[82,1302,1303],{"class":95},"rows",[82,1305,1306],{"class":106}," (performance optimization).\n",[82,1308,1309],{"class":84,"line":952},[82,1310,187],{"emptyLinePlaceholder":186},[82,1312,1313,1316,1319],{"class":84,"line":971},[82,1314,1315],{"class":106},"## Conditional Triggers (",[82,1317,1318],{"class":95},"WHEN",[82,1320,1015],{"class":106},[82,1322,1323],{"class":84,"line":989},[82,1324,187],{"emptyLinePlaceholder":186},[82,1326,1327,1329,1331,1333,1335,1337],{"class":84,"line":995},[82,1328,1026],{"class":106},[82,1330,1029],{"class":95},[82,1332,1032],{"class":106},[82,1334,1035],{"class":95},[82,1336,1038],{"class":853},[82,1338,1041],{"class":106},[82,1340,1341],{"class":84,"line":1001},[82,1342,1047],{"class":853},[82,1344,1345],{"class":84,"line":1006},[82,1346,1347],{"class":853},"-- Only fire when the name actually changes\n",[82,1349,1350],{"class":84,"line":1018},[82,1351,1352],{"class":853},"CREATE TRIGGER touch_modified_at\n",[82,1354,1355],{"class":84,"line":1023},[82,1356,1357],{"class":853},"  BEFORE UPDATE ON customers\n",[82,1359,1360],{"class":84,"line":1044},[82,1361,1362],{"class":853},"  FOR EACH ROW\n",[82,1364,1365],{"class":84,"line":1050},[82,1366,1367],{"class":853},"  WHEN (NEW.name IS DISTINCT FROM OLD.name)   -- avoids firing on no-op updates\n",[82,1369,1370],{"class":84,"line":1056},[82,1371,1372],{"class":853},"  EXECUTE FUNCTION update_modified_at();\n",[82,1374,1375],{"class":84,"line":1062},[82,1376,992],{"class":853},[14,1378,1379,1381,1382,1385],{},[44,1380,1318],{}," is evaluated before the function runs; if false, the function is skipped entirely. Use it to avoid firing on no-op updates (",[44,1383,1384],{},"NEW.x IS DISTINCT FROM OLD.x",") — a major performance win on tables with many columns but few changes.",[18,1387,1389],{"id":1388},"trigger-ordering","Trigger Ordering",[14,1391,1392,1393,1396,1397,628,1400,628,1403,68],{},"Multiple triggers on the same table\u002Fevent fire in ",[33,1394,1395],{},"alphabetical order by name"," (PostgreSQL). This is a fragile ordering — name your triggers with a prefix that sorts the way you want (",[44,1398,1399],{},"01_validate",[44,1401,1402],{},"02_default",[44,1404,1405],{},"03_audit",[18,1407,1409],{"id":1408},"trigger-pitfalls","Trigger Pitfalls",[26,1411,1412,1425,1440,1446,1459,1465],{},[29,1413,1414,1417,1418,1421,1422,1424],{},[33,1415,1416],{},"Invisible side effects"," — a trigger modifies data the application didn't ask for. The application updates ",[44,1419,1420],{},"name","; ",[44,1423,138],{}," changes silently. Debugging \"why did this column change?\" becomes a trigger hunt.",[29,1426,1427,1430,1431,1433,1434,1436,1437,1439],{},[33,1428,1429],{},"Performance"," — a trigger fires per row (for ",[44,1432,64],{},"). A bulk ",[44,1435,50],{}," of a million rows fires the trigger a million times. Use ",[44,1438,67],{}," with transition tables for bulk operations.",[29,1441,1442,1445],{},[33,1443,1444],{},"Cascading triggers"," — a trigger on table A updates table B, which has a trigger that updates table A... infinite recursion (PostgreSQL has a limit, but the behavior is surprising).",[29,1447,1448,1451,1452,1454,1455,1458],{},[33,1449,1450],{},"Silent failures"," — a trigger that returns ",[44,1453,338],{}," in a ",[44,1456,1457],{},"BEFORE INSERT"," silently drops the row. No error, no log — the row just doesn't appear.",[29,1460,1461,1464],{},[33,1462,1463],{},"Replication"," — triggers fire on the source but may or may not fire on replicas (configurable). Logical replication can duplicate effects if triggers fire on both.",[29,1466,1467,1470],{},[33,1468,1469],{},"Testing"," — triggers make \"given these SQL statements, the database should be in this state\" harder to reason about, because the final state includes trigger side effects.",[18,1472,1474],{"id":1473},"when-to-use-triggers-and-when-not","When to Use Triggers (and When Not)",[14,1476,1477],{},[33,1478,1479],{},"Use triggers for:",[348,1481,1482,1485,1488],{},[29,1483,1484],{},"Audit logging (when you can't change the application).",[29,1486,1487],{},"Cross-table consistency that constraints can't express (denormalized columns).",[29,1489,1490],{},"Enforcing rules that span rows\u002Ftables (e.g., \"no delete if referenced in audit_log\").",[14,1492,1493],{},[33,1494,1495],{},"Avoid triggers for:",[348,1497,1498,1501,1504,1507,1517],{},[29,1499,1500],{},"Business logic — put it in the application, where it's testable and visible.",[29,1502,1503],{},"Single-row derivations — use generated columns.",[29,1505,1506],{},"Referential integrity — use foreign keys.",[29,1508,1509,1510,1513,1514,135],{},"Uniqueness — use ",[44,1511,1512],{},"UNIQUE"," constraints or ",[44,1515,1516],{},"EXCLUDE",[29,1518,1519],{},"Anything that could be a constraint — constraints are simpler, visible, and enforced always.",[18,1521,1523],{"id":1522},"tips-tricks","💡 Tips & Tricks",[348,1525,1526,1540,1555,1570,1582],{},[29,1527,1528,1531,1532,1535,1536,1539],{},[33,1529,1530],{},"Idiom",": prefer ",[33,1533,1534],{},"constraints over triggers"," wherever a constraint can express the rule — constraints are visible in the schema, enforced always (even via ",[44,1537,1538],{},"COPY","\u002Fbulk load), and don't have the \"invisible side effect\" problem. Reach for triggers only when no constraint fits (cross-table consistency, audit logging, conditional behavior).",[29,1541,1542,1544,1545,1547,1548,715,1551,1554],{},[33,1543,1530],{},": use a ",[44,1546,1318],{}," clause on row triggers to skip no-op updates — ",[44,1549,1550],{},"WHEN (NEW IS DISTINCT FROM OLD)",[44,1552,1553],{},"WHEN (NEW.col IS DISTINCT FROM OLD.col)"," avoids firing the trigger (and its function's overhead) on updates that don't actually change the relevant columns.",[29,1556,1557,1559,1560,1562,1563,1566,1567,1569],{},[33,1558,1429],{},": use ",[44,1561,67],{}," with transition tables (",[44,1564,1565],{},"REFERENCING NEW TABLE AS ...",") for bulk-audit triggers — one function call per statement instead of per row. A million-row ",[44,1568,50],{}," fires a row trigger a million times; a statement trigger fires once with all changed rows in a temp table.",[29,1571,1572,1574,1575,628,1577,628,1579,1581],{},[33,1573,1530],{},": name triggers with a numeric prefix (",[44,1576,1399],{},[44,1578,1402],{},[44,1580,1405],{},") to control firing order — PostgreSQL fires same-event triggers alphabetically, so a prefix makes the order explicit and stable.",[29,1583,1584,1587,1588,1591,1592,135],{},[33,1585,1586],{},"Debug",": when a column changes unexpectedly, query ",[44,1589,1590],{},"pg_trigger"," to list triggers on the table and check their functions — ",[44,1593,1594],{},"SELECT tgname, tgenabled, pg_get_triggerdef(oid) FROM pg_trigger WHERE tgrelid = 'customers'::regclass;",[18,1596,1598],{"id":1597},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[348,1600,1601,1620,1636,1642,1655,1667,1684,1690,1716,1728],{},[29,1602,1603,1611,1612,47,1614,1616,1617,1619],{},[33,1604,1605,1607,1608,1610],{},[44,1606,57],{}," trigger returning ",[44,1609,338],{}," silently drops the row",": no error, no log — the row just isn't inserted\u002Fupdated\u002Fdeleted. A common source of \"where did my row go?\" debugging. Always return ",[44,1613,259],{},[44,1615,263],{}," from ",[44,1618,57],{}," triggers unless you deliberately want to skip.",[29,1621,1622,1628,1629,1631,1632,1635],{},[33,1623,1624,1625,1627],{},"Triggers fire on ",[44,1626,1538],{}," and bulk loads",": a trigger fires for every row loaded via ",[44,1630,1538],{},", which can be slow. Disable triggers for bulk loads (",[44,1633,1634],{},"ALTER TABLE x DISABLE TRIGGER all; COPY ...; ALTER TABLE x ENABLE TRIGGER all;",") — but this bypasses constraints too (if you have them as triggers).",[29,1637,1638,1641],{},[33,1639,1640],{},"Trigger recursion",": a trigger on A updates B, whose trigger updates A, whose trigger updates B... PostgreSQL limits recursion depth, but the behavior is surprising. Avoid triggers that modify other tables with their own triggers.",[29,1643,1644,1651,1652,1654],{},[33,1645,1646,1648,1649],{},[44,1647,60],{}," triggers can't modify ",[44,1650,259],{},": the row is already written. To transform input, use a ",[44,1653,57],{}," trigger.",[29,1656,1657,1664,1665,68],{},[33,1658,1659,1660,47,1662],{},"Statement-level triggers and ",[44,1661,259],{},[44,1663,263],{},": not available — use transition tables (",[44,1666,1565],{},[29,1668,1669,1675,1676,1678,1679,248,1681,1683],{},[33,1670,1671,1674],{},[44,1672,1673],{},"TRUNCATE"," triggers",": ",[44,1677,1673],{}," is statement-level only (no row-level trigger). ",[44,1680,67],{},[44,1682,1673],{}," is supported.",[29,1685,1686,1689],{},[33,1687,1688],{},"Firing order is alphabetical by name",": not definition order. Rename a trigger and the order changes. Use a numeric prefix for explicit ordering.",[29,1691,1692,1675,1695,1698,1699,741,1702,741,1705,1708,1709,741,1712,1715],{},[33,1693,1694],{},"Disabled triggers",[44,1696,1697],{},"ALTER TABLE x DISABLE TRIGGER name"," (or ",[44,1700,1701],{},"all",[44,1703,1704],{},"user",[44,1706,1707],{},"replica",") suspends a trigger. Replicas have ",[44,1710,1711],{},"ENABLE REPLICA",[44,1713,1714],{},"ENABLE ALWAYS"," modes controlling whether triggers fire on replicas.",[29,1717,1718,1721,1722,1724,1725,1727],{},[33,1719,1720],{},"Trigger functions vs regular functions",": trigger functions return ",[44,1723,41],{}," (not a regular type) and don't take arguments (use ",[44,1726,744],{},"). They're invoked only via triggers, not directly.",[29,1729,1730,1735,1736,47,1738,1740],{},[33,1731,1732,1734],{},[44,1733,1318],{}," clause can't use subqueries or volatile functions",": it must be a simple expression on ",[44,1737,259],{},[44,1739,263],{},". For complex conditions, put the check inside the function.",[18,1742,1744],{"id":1743},"spot-the-bug","🧠 Spot the Bug",[14,1746,1747,1748,1750,1751,1753,1754,1757],{},"A developer adds a trigger to set ",[44,1749,138],{}," on every update, but notices that ",[44,1752,138],{}," changes even when the update didn't actually change any data (",[44,1755,1756],{},"UPDATE customers SET name = name WHERE id = 1","). Why, and how do you fix it?",[70,1759,1760,2006,2019,2030,2033],{"language":72},[74,1761,1763],{"className":76,"code":1762,"language":72,"meta":78,"style":78},"CREATE TRIGGER touch_modified_at\n  BEFORE UPDATE ON customers\n  FOR EACH ROW\n  EXECUTE FUNCTION update_modified_at();\n``\n::\n\n\u003Cdetails>\n\u003Csummary>Answer\u003C\u002Fsummary>\n\nThe trigger fires on every `UPDATE` statement that matches a row, regardless of whether the new values differ from the old values. `UPDATE customers SET name = name WHERE id = 1` is still an `UPDATE` — the row is updated (a new row version is written in MVCC), and the `BEFORE UPDATE` trigger fires, setting `modified_at = now()` even though the data is identical.\n\nThe fix — add a `WHEN` clause that skips the trigger when nothing actually changed:\n\n```sql\nCREATE TRIGGER touch_modified_at\n  BEFORE UPDATE ON customers\n  FOR EACH ROW\n  WHEN (NEW IS DISTINCT FROM OLD)   -- only fire if something actually changed\n  EXECUTE FUNCTION update_modified_at();\n",[44,1764,1765,1773,1783,1791,1799,1803,1807,1811,1822,1842,1846,1951,1955,1977,1981,1985,1989,1993,1997,2002],{"__ignoreMap":78},[82,1766,1767,1769,1771],{"class":84,"line":85},[82,1768,96],{"class":95},[82,1770,201],{"class":95},[82,1772,204],{"class":102},[82,1774,1775,1777,1779,1781],{"class":84,"line":92},[82,1776,210],{"class":95},[82,1778,213],{"class":95},[82,1780,216],{"class":95},[82,1782,219],{"class":106},[82,1784,1785,1787,1789],{"class":84,"line":122},[82,1786,225],{"class":95},[82,1788,228],{"class":106},[82,1790,231],{"class":95},[82,1792,1793,1795,1797],{"class":84,"line":128},[82,1794,237],{"class":95},[82,1796,99],{"class":95},[82,1798,242],{"class":106},[82,1800,1801],{"class":84,"line":153},[82,1802,992],{"class":853},[82,1804,1805],{"class":84,"line":162},[82,1806,998],{"class":106},[82,1808,1809],{"class":84,"line":171},[82,1810,187],{"emptyLinePlaceholder":186},[82,1812,1813,1816,1819],{"class":84,"line":183},[82,1814,1815],{"class":95},"\u003C",[82,1817,1818],{"class":106},"details",[82,1820,1821],{"class":95},">\n",[82,1823,1824,1826,1829,1832,1835,1838,1840],{"class":84,"line":190},[82,1825,1815],{"class":95},[82,1827,1828],{"class":106},"summary",[82,1830,1831],{"class":95},">",[82,1833,1834],{"class":106},"Answer",[82,1836,1837],{"class":95},"\u003C\u002F",[82,1839,1828],{"class":106},[82,1841,1821],{"class":95},[82,1843,1844],{"class":84,"line":196},[82,1845,187],{"emptyLinePlaceholder":186},[82,1847,1848,1851,1854,1857,1860,1863,1866,1869,1872,1875,1878,1881,1884,1886,1888,1891,1894,1897,1899,1902,1904,1906,1909,1911,1914,1916,1919,1922,1925,1928,1931,1934,1937,1940,1943,1946,1948],{"class":84,"line":207},[82,1849,1850],{"class":106},"The trigger fires ",[82,1852,1853],{"class":95},"on",[82,1855,1856],{"class":106}," every ",[82,1858,1859],{"class":853},"`UPDATE`",[82,1861,1862],{"class":95}," statement",[82,1864,1865],{"class":106}," that matches a ",[82,1867,1868],{"class":95},"row",[82,1870,1871],{"class":106},", regardless of whether the new ",[82,1873,1874],{"class":95},"values",[82,1876,1877],{"class":106}," differ ",[82,1879,1880],{"class":95},"from",[82,1882,1883],{"class":106}," the old ",[82,1885,1874],{"class":95},[82,1887,256],{"class":106},[82,1889,1890],{"class":853},"`UPDATE customers SET name = name WHERE id = 1`",[82,1892,1893],{"class":95}," is",[82,1895,1896],{"class":106}," still an ",[82,1898,1859],{"class":853},[82,1900,1901],{"class":106}," — the ",[82,1903,1868],{"class":95},[82,1905,1893],{"class":95},[82,1907,1908],{"class":106}," updated (a new ",[82,1910,1868],{"class":95},[82,1912,1913],{"class":95}," version",[82,1915,1893],{"class":95},[82,1917,1918],{"class":106}," written ",[82,1920,1921],{"class":95},"in",[82,1923,1924],{"class":106}," MVCC), ",[82,1926,1927],{"class":95},"and",[82,1929,1930],{"class":106}," the ",[82,1932,1933],{"class":853},"`BEFORE UPDATE`",[82,1935,1936],{"class":106}," trigger fires, setting ",[82,1938,1939],{"class":853},"`modified_at = now()`",[82,1941,1942],{"class":106}," even though the ",[82,1944,1945],{"class":95},"data",[82,1947,1893],{"class":95},[82,1949,1950],{"class":106}," identical.\n",[82,1952,1953],{"class":84,"line":222},[82,1954,187],{"emptyLinePlaceholder":186},[82,1956,1957,1960,1963,1966,1968,1971,1974],{"class":84,"line":234},[82,1958,1959],{"class":106},"The fix — ",[82,1961,1962],{"class":95},"add",[82,1964,1965],{"class":106}," a ",[82,1967,1268],{"class":853},[82,1969,1970],{"class":106}," clause that skips the trigger ",[82,1972,1973],{"class":95},"when",[82,1975,1976],{"class":106}," nothing actually changed:\n",[82,1978,1979],{"class":84,"line":539},[82,1980,187],{"emptyLinePlaceholder":186},[82,1982,1983],{"class":84,"line":942},[82,1984,1047],{"class":853},[82,1986,1987],{"class":84,"line":952},[82,1988,1352],{"class":853},[82,1990,1991],{"class":84,"line":971},[82,1992,1357],{"class":853},[82,1994,1995],{"class":84,"line":989},[82,1996,1362],{"class":853},[82,1998,1999],{"class":84,"line":995},[82,2000,2001],{"class":853},"  WHEN (NEW IS DISTINCT FROM OLD)   -- only fire if something actually changed\n",[82,2003,2004],{"class":84,"line":1001},[82,2005,1372],{"class":853},[14,2007,998,2008,2011,2012,2015,2016,2018],{},[44,2009,2010],{},"NEW IS DISTINCT FROM OLD"," is false when the new and old rows are identical (it's NULL-safe, unlike ",[44,2013,2014],{},"NEW \u003C> OLD","), so the trigger skips no-op updates. This avoids spurious ",[44,2017,138],{}," bumps and saves the function-call overhead on updates that don't change anything.",[14,2020,2021,1675,2024,2026,2027,2029],{},[33,2022,2023],{},"The lesson",[44,2025,50],{}," fires the trigger even if no columns changed — PostgreSQL writes a new row version regardless (MVCC). Use ",[44,2028,1550],{}," to make \"modified_at\" reflect actual modifications, not statement execution.",[18,2031,2032],{"id":1828},"Summary",[14,2034,2035,2036,47,2038,2040,2041,47,2043,47,2045,2048,2049,2051],{},"You can now create ",[44,2037,57],{},[44,2039,60],{}," row and statement triggers, use ",[44,2042,259],{},[44,2044,263],{},[44,2046,2047],{},"TG_*"," variables, build audit logs and derived-column triggers, optimize with ",[44,2050,1318],{}," clauses and transition tables, and know when to prefer constraints over triggers. Next: stored procedures and functions.",[2053,2054,2055],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4