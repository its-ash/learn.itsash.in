,1590,250,1593,250,1596],{},[112,1589,1137],{},[112,1591,1592],{},"INSERT",[112,1594,1595],{},"UPDATE",[112,1597,1598],{},"DELETE",[339,1600,1601],{},"Read\u002Fwrite rows.",[318,1603,1604,1610,1618],{},[339,1605,1606,1609],{},[23,1607,1608],{},"DCL"," (Data Control)",[339,1611,1612,250,1615],{},[112,1613,1614],{},"GRANT",[112,1616,1617],{},"REVOKE",[339,1619,1620],{},"Permissions.",[318,1622,1623,1629,1643],{},[339,1624,1625,1628],{},[23,1626,1627],{},"TCL"," (Transaction Control)",[339,1630,1631,250,1634,250,1637,250,1640],{},[112,1632,1633],{},"BEGIN",[112,1635,1636],{},"COMMIT",[112,1638,1639],{},"ROLLBACK",[112,1641,1642],{},"SAVEPOINT",[339,1644,1645],{},"Transaction boundaries.",[19,1647,1648,1650],{},[112,1649,1137],{}," is technically DQL (Data Query Language), a subcategory of DML. Most practitioners just call it \"queries.\"",[14,1652,1654],{"id":1653},"how-a-query-executes-conceptually","How a Query Executes (Conceptually)",[19,1656,1657],{},"A SQL statement passes through these logical phases (the physical order differs — the planner reorders):",[1659,1660,1661,1667,1673],"ol",{},[31,1662,1663,1666],{},[23,1664,1665],{},"Parse"," — syntax check, build a parse tree.",[31,1668,1669,1672],{},[23,1670,1671],{},"Plan"," — the optimizer chooses access paths (seq scan vs index), join order, join methods.",[31,1674,1675,1678],{},[23,1676,1677],{},"Execute"," — the executor runs the plan, fetching and combining rows.",[19,1680,785,1681,1684,1685,1687],{},[23,1682,1683],{},"logical evaluation order"," of a ",[112,1686,1137],{}," (per the SQL standard) is:",[102,1689,1691],{"language":1690},"text",[106,1692,1696],{"className":1693,"code":1695,"language":1690,"meta":110},[1694],"language-text","FROM \u002F JOIN   →  WHERE  →  GROUP BY  →  HAVING  →  SELECT  →  DISTINCT  →  ORDER BY  →  LIMIT\n",[112,1697,1695],{"__ignoreMap":110},[19,1699,1700,1701,1704,1705,1707,1708,291,1711,1713,1714,1717,1718,1721,1722,1724],{},"This order explains why you can't reference a column alias in ",[112,1702,1703],{},"WHERE"," (the alias is created in ",[112,1706,1137],{},", which runs ",[38,1709,1710],{},"after",[112,1712,1703],{},") but ",[38,1715,1716],{},"can"," reference it in ",[112,1719,1720],{},"ORDER BY"," (which runs after ",[112,1723,1137],{},").",[102,1726,1727],{"language":104},[106,1728,1730],{"className":108,"code":1729,"language":104,"meta":110,"style":110},"-- ❌ ERROR: column \"total\" does not exist (alias not visible in WHERE)\nSELECT amount * 1.08 AS total\nFROM orders\nWHERE total > 100;\n\n-- ✅ Repeat the expression\nSELECT amount * 1.08 AS total\nFROM orders\nWHERE amount * 1.08 > 100;\n\n-- ✅ Alias IS visible in ORDER BY (runs after SELECT)\nSELECT amount * 1.08 AS total\nFROM orders\nORDER BY total DESC;\n",[112,1731,1732,1737,1761,1769,1784,1788,1793,1811,1817,1838,1842,1847,1865,1871],{"__ignoreMap":110},[115,1733,1734],{"class":117,"line":118},[115,1735,1736],{"class":519},"-- ❌ ERROR: column \"total\" does not exist (alias not visible in WHERE)\n",[115,1738,1739,1741,1744,1747,1750,1752,1755,1758],{"class":117,"line":136},[115,1740,1137],{"class":121},[115,1742,1743],{"class":132}," amount ",[115,1745,1746],{"class":121},"*",[115,1748,1749],{"class":246}," 1",[115,1751,911],{"class":132},[115,1753,1754],{"class":246},"08",[115,1756,1757],{"class":121}," AS",[115,1759,1760],{"class":132}," total\n",[115,1762,1763,1766],{"class":117,"line":151},[115,1764,1765],{"class":121},"FROM",[115,1767,1768],{"class":132}," orders\n",[115,1770,1771,1773,1776,1779,1782],{"class":117,"line":168},[115,1772,1703],{"class":121},[115,1774,1775],{"class":132}," total ",[115,1777,1778],{"class":121},">",[115,1780,1781],{"class":246}," 100",[115,1783,1033],{"class":132},[115,1785,1786],{"class":117,"line":180},[115,1787,190],{"emptyLinePlaceholder":189},[115,1789,1790],{"class":117,"line":186},[115,1791,1792],{"class":519},"-- ✅ Repeat the expression\n",[115,1794,1795,1797,1799,1801,1803,1805,1807,1809],{"class":117,"line":193},[115,1796,1137],{"class":121},[115,1798,1743],{"class":132},[115,1800,1746],{"class":121},[115,1802,1749],{"class":246},[115,1804,911],{"class":132},[115,1806,1754],{"class":246},[115,1808,1757],{"class":121},[115,1810,1760],{"class":132},[115,1812,1813,1815],{"class":117,"line":205},[115,1814,1765],{"class":121},[115,1816,1768],{"class":132},[115,1818,1819,1821,1823,1825,1827,1829,1831,1834,1836],{"class":117,"line":217},[115,1820,1703],{"class":121},[115,1822,1743],{"class":132},[115,1824,1746],{"class":121},[115,1826,1749],{"class":246},[115,1828,911],{"class":132},[115,1830,1754],{"class":246},[115,1832,1833],{"class":121}," >",[115,1835,1781],{"class":246},[115,1837,1033],{"class":132},[115,1839,1840],{"class":117,"line":234},[115,1841,190],{"emptyLinePlaceholder":189},[115,1843,1844],{"class":117,"line":264},[115,1845,1846],{"class":519},"-- ✅ Alias IS visible in ORDER BY (runs after SELECT)\n",[115,1848,1849,1851,1853,1855,1857,1859,1861,1863],{"class":117,"line":282},[115,1850,1137],{"class":121},[115,1852,1743],{"class":132},[115,1854,1746],{"class":121},[115,1856,1749],{"class":246},[115,1858,911],{"class":132},[115,1860,1754],{"class":246},[115,1862,1757],{"class":121},[115,1864,1760],{"class":132},[115,1866,1867,1869],{"class":117,"line":774},[115,1868,1765],{"class":121},[115,1870,1768],{"class":132},[115,1872,1873,1875,1877,1880],{"class":117,"line":1123},[115,1874,1720],{"class":121},[115,1876,1775],{"class":132},[115,1878,1879],{"class":121},"DESC",[115,1881,1033],{"class":132},[14,1883,1885],{"id":1884},"tips-tricks","💡 Tips & Tricks",[28,1887,1888,1906,1918,1932,1952],{},[31,1889,1890,1893,1894,1897,1898,1901,1902,1905],{},[23,1891,1892],{},"Idiom",": always run ",[112,1895,1896],{},"EXPLAIN"," (or ",[112,1899,1900],{},"EXPLAIN ANALYZE",") on a slow query ",[38,1903,1904],{},"before"," adding an index — the plan tells you whether an index would even help, and adding indexes that aren't used just slows down writes.",[31,1907,1908,1911,1912,1914,1915,1917],{},[23,1909,1910],{},"Debug",": in ",[112,1913,525],{},", prefix a query with ",[112,1916,884],{}," (expanded display) when a row is too wide to read in horizontal mode — the vertical layout puts each column on its own line and makes inspecting a single wide row trivial.",[31,1919,1920,1922,1923,1925,1926,1928,1929,1931],{},[23,1921,1892],{},": use ",[112,1924,904],{}," in ",[112,1927,525],{}," to edit your last query in ",[112,1930,910],{}," (vim\u002Fnano\u002FVS Code) — far faster than re-typing a multi-line query that had a typo, and the edited buffer re-executes on save\u002Fquit.",[31,1933,1934,1937,1938,1941,1942,1945,1946,1948,1949,1951],{},[23,1935,1936],{},"Portability",": prefer ",[112,1939,1940],{},"CURRENT_TIMESTAMP"," over ",[112,1943,1944],{},"now()"," in portable SQL — ",[112,1947,1944],{}," is PostgreSQL-specific (though widely supported); ",[112,1950,1940],{}," is ANSI standard.",[31,1953,1954,1957,1958,1961,1962,1965,1966,1969,1970,911],{},[23,1955,1956],{},"Performance",": ",[112,1959,1960],{},"psql -c \"SELECT count(*) FROM big_table\""," can take minutes on a huge table because PostgreSQL's MVCC forces a full scan for ",[112,1963,1964],{},"count(*)"," — use an approximate count from ",[112,1967,1968],{},"pg_class.reltuples"," for a quick estimate: ",[112,1971,1972],{},"SELECT reltuples::bigint FROM pg_class WHERE relname='big_table';",[14,1974,1976],{"id":1975},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[28,1978,1979,2004,2021,2030,2064,2085,2101],{},[31,1980,1981,1984,1985,1988,1989,1991,1992,1995,1996,1999,2000,2003],{},[23,1982,1983],{},"Case sensitivity",": unquoted identifiers in PostgreSQL are folded to lowercase. ",[112,1986,1987],{},"CREATE TABLE Users (...)"," creates a table named ",[112,1990,298],{},"; ",[112,1993,1994],{},"SELECT * FROM Users"," works. But ",[112,1997,1998],{},"CREATE TABLE \"Users\" (...)"," (quoted) creates a literally-cased table that you must ",[38,2001,2002],{},"always"," quote — a common source of \"table does not exist\" errors. Avoid quoted identifiers unless you have a specific reason.",[31,2005,2006,1957,2011,2013,2014,2017,2018,2020],{},[23,2007,2008,2010],{},[112,2009,525],{}," semicolons",[112,2012,525],{}," buffers input until it sees a ",[112,2015,2016],{},";"," (or a backslash command). If nothing happens when you press Enter, you forgot the semicolon — type ",[112,2019,2016],{}," and press Enter to run the buffered statement.",[31,2022,2023,2026,2027,2029],{},[23,2024,2025],{},"SQLite type affinity",": SQLite doesn't strictly enforce column types — it uses \"type affinity\" and will happily store a string in an ",[112,2028,223],{}," column. This masks bugs that PostgreSQL would catch. Use PostgreSQL for learning schema discipline.",[31,2031,2032,1957,2035,250,2038,250,2041,250,2044,250,2046,2049,2050,2052,2053,2055,2056,250,2058,250,2060,2063],{},[23,2033,2034],{},"Keyword conflicts",[112,2036,2037],{},"order",[112,2039,2040],{},"user",[112,2042,2043],{},"group",[112,2045,312],{},[112,2047,2048],{},"select"," are reserved words. Naming a table ",[112,2051,2037],{}," or ",[112,2054,2040],{}," forces you to quote it forever. Use ",[112,2057,290],{},[112,2059,298],{},[112,2061,2062],{},"groups"," instead.",[31,2065,2066,1957,2074,2076,2077,400,2079,2081,2082,2084],{},[23,2067,2068,2070,2071],{},[112,2069,1208],{}," vs ",[112,2072,2073],{},"CREATE DATABASE",[112,2075,2073],{}," cannot run inside a transaction block, so you can't put it in a ",[112,2078,1633],{},[112,2080,1636],{}," script. Use the ",[112,2083,1208],{}," shell command instead, or run it standalone.",[31,2086,2087,1957,2090,2093,2094,2052,2097,2100],{},[23,2088,2089],{},"Connection strings",[112,2091,2092],{},"psql \"postgresql:\u002F\u002Fuser:pass@host:5432\u002Fdbname\""," — the password in the URL is visible in shell history and process lists. Prefer ",[112,2095,2096],{},"~\u002F.pgpass",[112,2098,2099],{},"PGPASSWORD"," env var.",[31,2102,2103,2108,2109,2112,2113,400,2115,2117],{},[23,2104,2105,2107],{},[112,2106,142],{}," is not atomic across rollback",": if a transaction inserts a row and then rolls back, the sequence value is ",[38,2110,2111],{},"not"," returned to the pool — gaps in ",[112,2114,142],{},[112,2116,428],{}," columns are expected and normal, not a bug.",[14,2119,2121],{"id":2120},"spot-the-bug","🧠 Spot the Bug",[19,2123,2124,2125,2127],{},"A developer writes this and is surprised the alias doesn't work in the ",[112,2126,1703],{}," clause:",[102,2129,2130],{"language":104},[106,2131,2133],{"className":108,"code":2132,"language":104,"meta":110,"style":110},"SELECT\n  customer_id,\n  SUM(amount) AS total_spent\nFROM orders\nWHERE total_spent > 100\nGROUP BY customer_id;\n",[112,2134,2135,2140,2145,2159,2165,2177],{"__ignoreMap":110},[115,2136,2137],{"class":117,"line":118},[115,2138,2139],{"class":121},"SELECT\n",[115,2141,2142],{"class":117,"line":136},[115,2143,2144],{"class":132},"  customer_id,\n",[115,2146,2147,2150,2153,2156],{"class":117,"line":151},[115,2148,2149],{"class":246},"  SUM",[115,2151,2152],{"class":132},"(amount) ",[115,2154,2155],{"class":121},"AS",[115,2157,2158],{"class":132}," total_spent\n",[115,2160,2161,2163],{"class":117,"line":168},[115,2162,1765],{"class":121},[115,2164,1768],{"class":132},[115,2166,2167,2169,2172,2174],{"class":117,"line":180},[115,2168,1703],{"class":121},[115,2170,2171],{"class":132}," total_spent ",[115,2173,1778],{"class":121},[115,2175,2176],{"class":246}," 100\n",[115,2178,2179,2182],{"class":117,"line":186},[115,2180,2181],{"class":121},"GROUP BY",[115,2183,2184],{"class":132}," customer_id;\n",[19,2186,2187],{},"What's wrong, and what are the two distinct bugs here?",[2189,2190,2191,2195,2206,2272,2281,2330],"details",{},[2192,2193,2194],"summary",{},"Answer",[19,2196,2197,2198,2201,2202,2205],{},"There are ",[23,2199,2200],{},"two"," bugs, both stemming from the logical evaluation order (",[112,2203,2204],{},"FROM → WHERE → GROUP BY → HAVING → SELECT → ORDER BY → LIMIT","):",[1659,2207,2208,2244],{},[31,2209,2210,1957,2215,2218,2219,2221,2222,291,2224,2226,2227,2229,2230,2232,2233,291,2235,2237,2238,2240,2241,1724],{},[23,2211,2212,2213],{},"Alias in ",[112,2214,1703],{},[112,2216,2217],{},"total_spent"," is defined in the ",[112,2220,1137],{}," clause, which runs ",[38,2223,1710],{},[112,2225,1703],{},". At the time ",[112,2228,1703],{}," is evaluated, ",[112,2231,2217],{}," doesn't exist yet — the column is unknown. Aliases are only visible to clauses that run ",[38,2234,1710],{},[112,2236,1137],{}," (i.e., ",[112,2239,1720],{}," and ",[112,2242,2243],{},"LIMIT",[31,2245,2246,2251,2252,2255,2256,2258,2259,2261,2262,2264,2265,1707,2268,291,2270,911],{},[23,2247,2248,2249],{},"Aggregate in ",[112,2250,1703],{},": even if you replaced the alias with the real expression ",[112,2253,2254],{},"SUM(amount)",", it still fails — aggregates aren't allowed in ",[112,2257,1703],{}," because ",[112,2260,1703],{}," filters rows ",[38,2263,1904],{}," grouping happens. Filtering on an aggregated value is the job of ",[112,2266,2267],{},"HAVING",[38,2269,1710],{},[112,2271,2181],{},[19,2273,2274,2277,2278,2280],{},[23,2275,2276],{},"The fix",": move the aggregate condition to ",[112,2279,2267],{},":",[106,2282,2284],{"className":108,"code":2283,"language":104,"meta":110,"style":110},"SELECT customer_id, SUM(amount) AS total_spent\nFROM orders\nGROUP BY customer_id\nHAVING SUM(amount) > 100;\n",[112,2285,2286,2302,2308,2315],{"__ignoreMap":110},[115,2287,2288,2290,2293,2296,2298,2300],{"class":117,"line":118},[115,2289,1137],{"class":121},[115,2291,2292],{"class":132}," customer_id, ",[115,2294,2295],{"class":246},"SUM",[115,2297,2152],{"class":132},[115,2299,2155],{"class":121},[115,2301,2158],{"class":132},[115,2303,2304,2306],{"class":117,"line":136},[115,2305,1765],{"class":121},[115,2307,1768],{"class":132},[115,2309,2310,2312],{"class":117,"line":151},[115,2311,2181],{"class":121},[115,2313,2314],{"class":132}," customer_id\n",[115,2316,2317,2319,2322,2324,2326,2328],{"class":117,"line":168},[115,2318,2267],{"class":121},[115,2320,2321],{"class":246}," SUM",[115,2323,2152],{"class":132},[115,2325,1778],{"class":121},[115,2327,1781],{"class":246},[115,2329,1033],{"class":132},[19,2331,2332,2333,1957,2336,2338,2339,2342,2343,2338,2345,2348,2349,2351,2352,2354,2355,2357],{},"::\n",[23,2334,2335],{},"The lesson",[112,2337,1703],{}," filters ",[38,2340,2341],{},"input"," rows (before grouping); ",[112,2344,2267],{},[38,2346,2347],{},"output"," groups (after grouping). Use the raw expression in ",[112,2350,2267],{}," — aliases defined in ",[112,2353,1137],{}," aren't visible there either (though PostgreSQL is lenient and accepts the alias in ",[112,2356,2267],{},"; portability-wise, use the full expression).",[14,2359,2361],{"id":2360},"recommended-environment","Recommended Environment",[28,2363,2364,2370,2377,2386],{},[31,2365,2366,2369],{},[23,2367,2368],{},"PostgreSQL 16+"," via Homebrew or Docker for the full feature set.",[31,2371,2372,2376],{},[23,2373,2374],{},[112,2375,525],{}," for the CLI (install it even if you use a GUI — it's the fastest way to run ad-hoc queries).",[31,2378,2379,2052,2382,2385],{},[23,2380,2381],{},"DBeaver",[23,2383,2384],{},"pgAdmin"," if you prefer a GUI for browsing schema.",[31,2387,2388,2391],{},[23,2389,2390],{},"SQLite + DB Browser for SQLite"," for a zero-server portable option.",[14,2393,2394],{"id":2192},"Summary",[19,2396,2397,2398,2400,2401,2240,2403,911],{},"You now have a database running, understand the relational model and SQL dialect landscape, and know the logical evaluation order of a ",[112,2399,1137],{},". Next: writing your first queries with ",[112,2402,1137],{},[112,2404,1703],{},[2406,2407,2408],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--sh