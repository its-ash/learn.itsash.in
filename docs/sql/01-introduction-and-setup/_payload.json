[{"data":1,"prerenderedAt":2437},["ShallowReactive",2],{"page-\u002Fsql\u002F01-introduction-and-setup":3},{"id":4,"title":5,"body":6,"description":110,"extension":2431,"meta":2432,"navigation":189,"path":2433,"seo":2434,"stem":2435,"__hash__":2436},"content\u002Fsql\u002F01-introduction-and-setup.md","01 — Introduction & Setup",{"type":7,"value":8,"toc":2409},"minimark",[9,13,18,27,70,74,81,101,285,304,308,311,460,469,473,478,529,533,585,589,680,684,687,782,789,794,942,1006,1010,1165,1169,1176,1238,1241,1534,1538,1646,1651,1655,1658,1679,1688,1698,1725,1882,1886,1973,1977,2118,2122,2128,2185,2188,2358,2362,2392,2395,2405],[10,11,5],"h1",{"id":12},"_01-introduction-setup",[14,15,17],"h2",{"id":16},"what-is-sql","What Is SQL?",[19,20,21,22,26],"p",{},"SQL (Structured Query Language, pronounced \"S-Q-L\" or \"sequel\") is the standard language for interacting with ",[23,24,25],"strong",{},"relational databases"," — systems that store data in tables of rows and columns with explicit relationships between them. Key characteristics:",[28,29,30,46,52,58,64],"ul",{},[31,32,33,36,37,41,42,45],"li",{},[23,34,35],{},"Declarative"," — you describe ",[38,39,40],"em",{},"what"," data you want, not ",[38,43,44],{},"how"," to fetch it. The query planner chooses the algorithm.",[31,47,48,51],{},[23,49,50],{},"Set-based"," — operations work on entire sets (tables) of rows at once, not one row at a time.",[31,53,54,57],{},[23,55,56],{},"Strongly typed"," — every column has a declared type; the database enforces and coerces.",[31,59,60,63],{},[23,61,62],{},"Transactional"," — grouped operations are atomic, consistent, isolated, and durable (ACID).",[31,65,66,69],{},[23,67,68],{},"Standardized"," — ANSI\u002FISO SQL is a real standard, but every engine extends it. Portability is aspirational, not guaranteed.",[14,71,73],{"id":72},"the-relational-model","The Relational Model",[19,75,76,77,80],{},"Data lives in ",[23,78,79],{},"tables"," (relations). Each table has:",[28,82,83,89,95],{},[31,84,85,88],{},[23,86,87],{},"Columns"," (attributes) — each with a name and a type.",[31,90,91,94],{},[23,92,93],{},"Rows"," (tuples) — each row is one record; a row's set of column values is the tuple.",[31,96,97,100],{},[23,98,99],{},"Keys"," — a primary key uniquely identifies a row; foreign keys reference rows in other tables, expressing relationships.",[102,103,105],"code-wrapper",{"language":104},"sql",[106,107,111],"pre",{"className":108,"code":109,"language":104,"meta":110,"style":110},"language-sql shiki shiki-themes github-light github-dark","CREATE TABLE users (\n  id    SERIAL PRIMARY KEY,\n  email TEXT NOT NULL UNIQUE,\n  name  TEXT NOT NULL\n);\n\nCREATE TABLE orders (\n  id       SERIAL PRIMARY KEY,\n  user_id  INTEGER NOT NULL REFERENCES users(id),\n  total    NUMERIC(10, 2) NOT NULL,\n  placed_at TIMESTAMPTZ DEFAULT now()\n);\n","",[112,113,114,134,149,166,178,184,191,203,215,232,262,280],"code",{"__ignoreMap":110},[115,116,119,123,126,130],"span",{"class":117,"line":118},"line",1,[115,120,122],{"class":121},"svdQ7","CREATE",[115,124,125],{"class":121}," TABLE",[115,127,129],{"class":128},"sIsaT"," users",[115,131,133],{"class":132},"ssxIu"," (\n",[115,135,137,140,143,146],{"class":117,"line":136},2,[115,138,139],{"class":132},"  id    ",[115,141,142],{"class":121},"SERIAL",[115,144,145],{"class":121}," PRIMARY KEY",[115,147,148],{"class":132},",\n",[115,150,152,155,158,161,164],{"class":117,"line":151},3,[115,153,154],{"class":132},"  email ",[115,156,157],{"class":121},"TEXT",[115,159,160],{"class":121}," NOT NULL",[115,162,163],{"class":121}," UNIQUE",[115,165,148],{"class":132},[115,167,169,172,175],{"class":117,"line":168},4,[115,170,171],{"class":121},"  name",[115,173,174],{"class":121},"  TEXT",[115,176,177],{"class":121}," NOT NULL\n",[115,179,181],{"class":117,"line":180},5,[115,182,183],{"class":132},");\n",[115,185,187],{"class":117,"line":186},6,[115,188,190],{"emptyLinePlaceholder":189},true,"\n",[115,192,194,196,198,201],{"class":117,"line":193},7,[115,195,122],{"class":121},[115,197,125],{"class":121},[115,199,200],{"class":128}," orders",[115,202,133],{"class":132},[115,204,206,209,211,213],{"class":117,"line":205},8,[115,207,208],{"class":132},"  id       ",[115,210,142],{"class":121},[115,212,145],{"class":121},[115,214,148],{"class":132},[115,216,218,221,224,226,229],{"class":117,"line":217},9,[115,219,220],{"class":132},"  user_id  ",[115,222,223],{"class":121},"INTEGER",[115,225,160],{"class":121},[115,227,228],{"class":121}," REFERENCES",[115,230,231],{"class":132}," users(id),\n",[115,233,235,238,241,244,248,251,254,257,260],{"class":117,"line":234},10,[115,236,237],{"class":132},"  total    ",[115,239,240],{"class":121},"NUMERIC",[115,242,243],{"class":132},"(",[115,245,247],{"class":246},"snvgF","10",[115,249,250],{"class":132},", ",[115,252,253],{"class":246},"2",[115,255,256],{"class":132},") ",[115,258,259],{"class":121},"NOT NULL",[115,261,148],{"class":132},[115,263,265,268,271,274,277],{"class":117,"line":264},11,[115,266,267],{"class":132},"  placed_at ",[115,269,270],{"class":121},"TIMESTAMPTZ",[115,272,273],{"class":121}," DEFAULT",[115,275,276],{"class":121}," now",[115,278,279],{"class":132},"()\n",[115,281,283],{"class":117,"line":282},12,[115,284,183],{"class":132},[19,286,287,288,291,292,295,296,299,300,303],{},"A row in ",[112,289,290],{},"orders"," ",[38,293,294],{},"relates to"," a row in ",[112,297,298],{},"users"," via ",[112,301,302],{},"user_id",". The relational model's power is composing these relationships in queries (joins) without precomputing them.",[14,305,307],{"id":306},"sql-dialects-matter","SQL Dialects Matter",[19,309,310],{},"The SQL standard is a baseline. Each engine (PostgreSQL, MySQL, SQLite, SQL Server, Oracle) extends and occasionally violates it. Examples of divergence:",[312,313,314,333],"table",{},[315,316,317],"thead",{},[318,319,320,324,327,330],"tr",{},[321,322,323],"th",{},"Feature",[321,325,326],{},"PostgreSQL",[321,328,329],{},"MySQL",[321,331,332],{},"SQLite",[334,335,336,354,370,382,393,410,422,441],"tbody",{},[318,337,338,345,348,351],{},[339,340,341,344],"td",{},[112,342,343],{},"RETURNING"," clause",[339,346,347],{},"✅",[339,349,350],{},"✅ (8.0+)",[339,352,353],{},"❌",[318,355,356,362,364,367],{},[339,357,358,361],{},[112,359,360],{},"JSONB"," type",[339,363,347],{},[339,365,366],{},"❌ (JSON only)",[339,368,369],{},"❌ (TEXT)",[318,371,372,375,377,379],{},[339,373,374],{},"Window functions",[339,376,347],{},[339,378,350],{},[339,380,381],{},"✅ (3.25+)",[318,383,384,387,389,391],{},[339,385,386],{},"Recursive CTEs",[339,388,347],{},[339,390,350],{},[339,392,347],{},[318,394,395,404,406,408],{},[339,396,397,400,401],{},[112,398,399],{},"INTERSECT","\u002F",[112,402,403],{},"EXCEPT",[339,405,347],{},[339,407,350],{},[339,409,347],{},[318,411,412,415,417,420],{},[339,413,414],{},"Materialized views",[339,416,347],{},[339,418,419],{},"❌ (manual)",[339,421,353],{},[318,423,424,430,433,435],{},[339,425,426,429],{},[112,427,428],{},"IDENTITY"," columns",[339,431,432],{},"✅ (10+)",[339,434,347],{},[339,436,437,438],{},"uses ",[112,439,440],{},"AUTOINCREMENT",[318,442,443,446,452,457],{},[339,444,445],{},"Booleans",[339,447,448,449],{},"real ",[112,450,451],{},"BOOLEAN",[339,453,454],{},[112,455,456],{},"TINYINT(1)",[339,458,459],{},"integer 0\u002F1",[19,461,462,463,465,466,468],{},"This course uses ",[23,464,326],{}," syntax as the default (most standard-compliant, most feature-rich open-source engine) and flags dialect differences where they matter. ",[23,467,332],{}," is fine for chapters 01–20 (no server needed); chapters 21–28 benefit from PostgreSQL.",[14,470,472],{"id":471},"installing-postgresql","Installing PostgreSQL",[474,475,477],"h3",{"id":476},"macos-homebrew","macOS (Homebrew)",[102,479,481],{"language":480},"bash",[106,482,485],{"className":483,"code":484,"language":480,"meta":110,"style":110},"language-bash shiki shiki-themes github-light github-dark","brew install postgresql@16\nbrew services start postgresql@16\n\n# Connect to the default database\npsql postgres\n",[112,486,487,499,511,515,521],{"__ignoreMap":110},[115,488,489,492,496],{"class":117,"line":118},[115,490,491],{"class":128},"brew",[115,493,495],{"class":494},"sJ6F3"," install",[115,497,498],{"class":494}," postgresql@16\n",[115,500,501,503,506,509],{"class":117,"line":136},[115,502,491],{"class":128},[115,504,505],{"class":494}," services",[115,507,508],{"class":494}," start",[115,510,498],{"class":494},[115,512,513],{"class":117,"line":151},[115,514,190],{"emptyLinePlaceholder":189},[115,516,517],{"class":117,"line":168},[115,518,520],{"class":519},"sdCPZ","# Connect to the default database\n",[115,522,523,526],{"class":117,"line":180},[115,524,525],{"class":128},"psql",[115,527,528],{"class":494}," postgres\n",[474,530,532],{"id":531},"linux-apt","Linux (apt)",[102,534,535],{"language":480},[106,536,538],{"className":483,"code":537,"language":480,"meta":110,"style":110},"sudo apt install postgresql postgresql-contrib\nsudo systemctl enable --now postgresql\nsudo -u postgres psql\n",[112,539,540,556,572],{"__ignoreMap":110},[115,541,542,545,548,550,553],{"class":117,"line":118},[115,543,544],{"class":128},"sudo",[115,546,547],{"class":494}," apt",[115,549,495],{"class":494},[115,551,552],{"class":494}," postgresql",[115,554,555],{"class":494}," postgresql-contrib\n",[115,557,558,560,563,566,569],{"class":117,"line":136},[115,559,544],{"class":128},[115,561,562],{"class":494}," systemctl",[115,564,565],{"class":494}," enable",[115,567,568],{"class":246}," --now",[115,570,571],{"class":494}," postgresql\n",[115,573,574,576,579,582],{"class":117,"line":151},[115,575,544],{"class":128},[115,577,578],{"class":246}," -u",[115,580,581],{"class":494}," postgres",[115,583,584],{"class":494}," psql\n",[474,586,588],{"id":587},"docker-any-os","Docker (any OS)",[102,590,591],{"language":480},[106,592,594],{"className":483,"code":593,"language":480,"meta":110,"style":110},"docker run --nam