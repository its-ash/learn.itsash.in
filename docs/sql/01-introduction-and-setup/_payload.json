ctice",[115,967,968],{"class":246}," -c",[115,970,971],{"class":494}," \"SELECT now();\"\n",[115,973,974,976,978,980,983,986],{"class":117,"line":136},[115,975,525],{"class":128},[115,977,671],{"class":246},[115,979,965],{"class":494},[115,981,982],{"class":246}," -f",[115,984,985],{"class":494}," setup.sql",[115,987,988],{"class":519},"        # run a SQL file\n",[115,990,991,993,995,997,1000,1003],{"class":117,"line":151},[115,992,525],{"class":128},[115,994,671],{"class":246},[115,996,965],{"class":494},[115,998,999],{"class":121}," \u003C",[115,1001,1002],{"class":494}," dump.sql",[115,1004,1005],{"class":519},"          # restore from dump\n",[14,1007,1009],{"id":1008},"creating-your-first-database","Creating Your First Database",[102,1011,1012],{"language":104},[106,1013,1015],{"className":108,"code":1014,"language":104,"meta":110,"style":110},"-- Create a database\nCREATE DATABASE practice;\n\n-- Connect to it (in psql: \\c practice)\n\n-- Create a table\nCREATE TABLE greetings (\n  id SERIAL PRIMARY KEY,\n  message TEXT NOT NULL\n);\n\n-- Insert a row\nINSERT INTO greetings (message) VALUES ('Hello, SQL!');\n\n-- Query it\nSELECT * FROM greetings;\n--  id |   message\n-- ----+------------\n--   1 | Hello, SQL!\n",[112,1016,1017,1022,1034,1038,1043,1047,1052,1063,1074,1084,1088,1092,1097,1121,1126,1132,1147,1153,1159],{"__ignoreMap":110},[115,1018,1019],{"class":117,"line":118},[115,1020,1021],{"class":519},"-- Create a database\n",[115,1023,1024,1026,1029,1031],{"class":117,"line":136},[115,1025,122],{"class":121},[115,1027,1028],{"class":121}," DATABASE",[115,1030,965],{"class":128},[115,1032,1033],{"class":132},";\n",[115,1035,1036],{"class":117,"line":151},[115,1037,190],{"emptyLinePlaceholder":189},[115,1039,1040],{"class":117,"line":168},[115,1041,1042],{"class":519},"-- Connect to it (in psql: \\c practice)\n",[115,1044,1045],{"class":117,"line":180},[115,1046,190],{"emptyLinePlaceholder":189},[115,1048,1049],{"class":117,"line":186},[115,1050,1051],{"