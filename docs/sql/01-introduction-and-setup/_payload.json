XT NOT NULL,\n  city TEXT\n);\n\nCREATE TABLE orders (\n  id SERIAL PRIMARY KEY,\n  customer_id INTEGER NOT NULL REFERENCES customers(id),\n  amount NUMERIC(10, 2) NOT NULL CHECK (amount >= 0),\n  ordered_on DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nINSERT INTO customers (name, city) VALUES\n  ('Alice', 'NYC'),\n  ('Bob', 'LA'),\n  ('Carol', 'NYC');\n\nINSERT INTO orders (customer_id, amount) VALUES\n  (1, 99.50),\n  (1, 12.00),\n  (2, 450.00),\n  (3, 7.25);\n",[112,1247,1248,1259,1269,1279,1287,1291,1295,1305,1315,1329,1363,1378,1382,1386,1402,1417,1431,1444,1448,1457,1477,1496,1514],{"__ignoreMap":110},[115,1249,1250,1252,1254,1257],{"class":117,"line":118},[115,1251,122],{"class":121},[115,1253,125],{"class":121},[115,1255,1256],{"class":128}," customers",[115,1258,133],{"class":132},[115,1260,1261,1263,1265,1267],{"class":117,"line":136},[115,1262,1067],{"class":132},[115,1264,142],{"class":121},[115,1266,145],{"class":121},[115,1268,148],{"class":132},[115,1270,1271,1273,1275,1277],{"class":117,"line":151},[115,1272,171],{"class":121},[115,1274,1081],{"class":121},[115,1276,160],{"class":121},[115,1278,148],{"class":132},[115,1280,1281,1284],{"class":117,"line":168},[115,1282,1283],{"class":132},"  city ",[115,1285,1286],{"class":121},"TEXT\n",[115,1288,1289],{"class":117,"line":180},[115,1290,183],{"class":132},[115,1292,1293],{"class":117,"line":186},[115,1294,190],{"emptyLinePlaceholder":189},[115,1296,1297,1299,1301,1303],{"class":117,"line":193},[115,1298,122],{"class":121},[115,1300,125],{"class":121},[115,1302,200],{"class":128},[115,1304,133],{"class":132},[115,1306,1307,1309,1311,1313],{"class":117,"line":205},[115,1308,1067],{"class":132},[115,1310,142],{"class":121},[115,1312,145],{"class":121},[115,1314,148],{"class":132},[115,1316,1317,1320,1322,1324,1326],{"class":117,"line":217},[115,1318,1319],{"class":132},"  customer_id ",[115,1321,223],{"class":121},[115,1323,160],{"class":121},[115,1325,228],{"class":121},[115,1327,1328],{"class":132}," cust