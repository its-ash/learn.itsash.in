ables\nsqlite> .quit\n",[112,693,694,699,708,712,717,728,732,737,745,749,754,761,772],{"__ignoreMap":110},[115,695,696],{"class":117,"line":118},[115,697,698],{"class":519},"# macOS\n",[115,700,701,703,705],{"class":117,"line":136},[115,702,491],{"class":128},[115,704,495],{"class":494},[115,706,707],{"class":494}," sqlite\n",[115,709,710],{"class":117,"line":151},[115,711,190],{"emptyLinePlaceholder":189},[115,713,714],{"class":117,"line":168},[115,715,716],{"class":519},"# Linux\n",[115,718,719,721,723,725],{"class":117,"line":180},[115,720,544],{"class":128},[115,722,547],{"class":494},[115,724,495],{"class":494},[115,726,727],{"class":494}," sqlite3\n",[115,729,730],{"class":117,"line":186},[115,731,190],{"emptyLinePlaceholder":189},[115,733,734],{"class":117,"line":193},[115,735,736],{"class":519},"# Verify\n",[115,738,739,742],{"class":117,"line":205},[115,740,741],{"class":128},"sqlite3",[115,743,744],{"class":246}," --version\n",[115,746,747],{"class":117,"line":217},[115,748,190],{"emptyLinePlaceholder":189},[115,750,751],{"class":117,"line":234},[115,752,753],{"class":519},"# Create\u002Fopen a database file\n",[115,755,756,758],{"class":117,"line":264},[115,757,741],{"class":128},[115,759,760],{"class":494}," practice.db\n",[115,762,763,766,769],{"class":117,"line":282},[115,764,765],{"class":128},"sqlite",[115,767,768],{"class":132},"> ",[115,770,771],{"class":494},".tables\n",[115,773,775,777,779],{"class":117,"line":774},13,[115,776,765],{"class":128},[115,778,768],{"class":132},[115,780,781],{"class":494},".quit\n",[14,783,785,786,788],{"id":784},"the-psql-client","The ",[112,787,525],{}," Client",[19,790,791,793],{},[112,792,525],{}," is PostgreSQL's official CLI. Learn it — it's far more powerful than GUI tools for quick work.",[312,795,796,806],{},[315,797,798],{},[318,799,800,803],{},[321,801,802],{},"Command",[321,804,805],{},"Purpose",[334,807,808,818,828,838,848,858,868,878,888,898,912,922,932],{},[318,809,810,815],{},[339,811,812],{},[112,813,