 later (it only affects future inserts).",[202,546,548,550,551],{"id":547},"default-and-null",[33,549,190],{}," and ",[33,552,553],{},"NULL",[14,555,556,558,559,562,563,565,566,568,569,571],{},[33,557,190],{}," applies only when the column is ",[173,560,561],{},"omitted"," from the ",[33,564,529],{}," column list. If you explicitly insert ",[33,567,553],{},", NULL is stored — the default doesn't override an explicit NULL. Add ",[33,570,153],{}," to prevent NULLs.",[18,573,575],{"id":574},"generated-columns","Generated Columns",[14,577,578],{},"A generated column's value is computed from other columns — automatically maintained on insert\u002Fupdate:",[23,580,581],{"language":25},[27,582,584],{"className":29,"code":583,"language":25,"meta":31,"style":31},"CREATE TABLE products (\n  id         BIGSERIAL PRIMARY KEY,\n  price      NUMERIC(10, 2) NOT NULL,\n  qty        INTEGER NOT NULL,\n  total      NUMERIC(10, 2) GENERATED ALWAYS AS (price * qty) STORED\n);\n",[33,585,586,597,607,628,639,674],{"__ignoreMap":31},[36,587,588,590,592,595],{"class":38,"line":39},[36,589,43],{"class":42},[36,591,46],{"class":42},[36,593,594],{"class":49}," products",[36,596,54],{"class":53},[36,598,599,601,603,605],{"class":38,"line":57},[36,600,450],{"class":53},[36,602,63],{"class":42},[36,604,66],{"class":42},[36,606,69],{"class":53},[36,608,609,612,614,616,618,620,622,624,626],{"class":38,"line":72},[36,610,611],{"class":53},"  price      ",[36,613,263],{"class":42},[36,615,266],{"class":53},[36,617,269],{"class":120},[36,619,187],{"class":53},[36,621,274],{"class":120},[36,623,277],{"class":53},[36,625,153],{"class":42},[36,627,69],{"class":53},[36,629,630,633,635,637],{"class":38,"line":89},[36,631,632],{"class":53},"  qty        ",[36,634,108],{"class":42},[36,636,81],{"class":42},[36,638,69],{"class":53},[36,640,641,644,646,648,650,652,654,656,659,662,665,668,671],{"class":38,"line":102},[36,642,643],{"class":53},"  total      ",[36,645,263],{"class":42},[36,647,266],{"class":53},[36,649,269],{"class":120},[36,651,187],{"class":53},[36,653,274],{"class":120},[36,655,277],{"class":53},[36,657,658],{"class":42},"GENERATED",[36,660,661],{"class":42}," ALWAYS",[36,663,664],{"class":42}," AS",[36,666,667],{"class":53}," (price ",[36,669,670],{"class":42},"*",[36,672,673],{"class":53}," qty) STORED\n",[36,675,676],{"class":38,"line":127},[36,677,168],{"class":53},[14,679,680,683,684,687,688,691,692,694,695,698],{},[33,681,682],{},"STORED"," means the value is computed and stored on disk (takes space, fast to read). ",[33,685,686],{},"VIRTUAL"," (not yet in PostgreSQL; supported by MySQL) computes on read. Generated columns can't be directly written to (",[33,689,690],{},"GENERATED ALWAYS"," forbids ",[33,693,529],{},"\u002F",[33,696,697],{},"UPDATE"," of the column).",[14,700,701,702,705],{},"Use cases: precomputed derivations you query often, or a generated expression that matches an index (e.g., ",[33,703,704],{},"lower(email)"," as a generated column with a unique index, for case-insensitive email uniqueness).",[18,707,709],{"id":708},"schemas","Schemas",[14,711,712,713,716],{},"A schema is a namespace within a database — a way to group tables. The default schema is ",[33,714,715],{},"public",".",[23,718,719],{"language":25},[27,720,722],{"className":29,"code":721,"language":25,"meta":31,"style":31},"CREATE SCHEMA billing;\nCREATE TABLE billing.invoices (...);   -- table \"invoices\" in schema \"billing\"\nCREATE TABLE billing.payments (...);\n\n-- Set a search path (like PATH for schemas)\nSET search_path TO billing, public;\nSELECT * FROM invoices;   -- resolves to billing.invoices (first in search_path)\n",[33,723,724,737,751,762,768,773,787],{"__ignoreMap":31},[36,725,726,728,731,734],{"class":38,"line":39},[36,727,43],{"class":42},[36,729,730],{"class":42}," SCHEMA",[36,732,733],{"class":49}," billing",[36,735,736],{"class":53},";\n",[36,738,739,741,743,745,748],{"class":38,"line":57},[36,740,43],{"class":42},[36,742,46],{"class":42},[36,744,733],{"class":49},[36,746,747],{"class":53},".invoices (...);   ",[36,749,750],{"class":237},"-- table \"invoices\" in schema \"billing\"\n",[36,752,753,755,757,759],{"class":38,"line":72},[36,754,43],{"class":42},[36,756,46],{"class":42},[36,758,733],{"class":49},[36,760,761],{"class":53},".payments (...);\n",[36,763,764],{"class":38,"line":89},[36,765,767],{"emptyLinePlaceholder":766},true,"\n",[36,769,770],{"class":38,"line":102},[36,771,772],{"class":237},"-- Set a search path (like PATH for schemas)\n",[36,774,775,778,781,784],{"class":38,"line":127},[36,776,777],{"class":42},"SET",[36,779,780],{"class":53}," search_path ",[36,782,783],{"class":42},"TO",[36,785,786],{"class":53}," billing, public;\n",[36,788,789,792,795,798,801],{"class":38,"line":147},[36,790,791],{"class":42},"SELECT",[36,793,794],{"class":42}," *",[36,796,797],{"class":42}," FROM",[36,799,800],{"class":53}," invoices;   ",[36,802,803],{"class":237},"-- resolves to billing.invoices (first in search_path)\n",[14,805,806,807,810],{},"The ",[33,808,809],{},"search_path"," controls which schemas are consulted for unqualified table names. Use schemas to organize multi-tenant or multi-feature databases without separate database instances.",[202,812,814],{"id":813},"multi-tenant-patterns-with-schemas","Multi-tenant patterns with schemas",[816,817,818,829,845],"ul",{},[819,820,821,824,825,828],"li",{},[173,822,823],{},"Schema-per-tenant",": each tenant gets its own schema (",[33,826,827],{},"tenant_acme.invoices","). Strong isolation, but schema management is heavy and connection count matters.",[819,830,831,837,838,841,842,844],{},[173,832,833,834],{},"Shared schema with ",[33,835,836],{},"tenant_id",": one ",[33,839,840],{},"invoices"," table, every row has ",[33,843,836],{},", enforced by RLS (Row-Level Security, chapter 24). Most common; scales well.",[819,846,847,850],{},[173,848,849],{},"Database-per-tenant",": maximum isolation, highest operational cost. Reserved for strict compliance needs.",[18,852,854],{"id":853},"temporary-tables","Temporary Tables",[23,856,857],{"language":25},[27,858,860],{"className":29,"code":859,"language":25,"meta":31,"style":31},"CREATE TEMP TABLE staging AS\n  SELECT * FROM orders WHERE ordered_on >= '2024-01-01';\n\n-- TEMP tables vanish at session end (or COMMIT, with ON COMMIT DROP)\nCREATE TEMP TABLE scratch (id int, val text) ON COMMIT DROP;\n",[33,861,862,878,903,907,912],{"__ignoreMap":31},[36,863,864,866,869,872,875],{"class":38,"line":39},[36,865,43],{"class":42},[36,867,868],{"class":53}," TEMP ",[36,870,871],{"class":42},"TABLE",[36,873,874],{"class":53}," staging ",[36,876,877],{"class":42},"AS\n",[36,879,880,883,885,887,890,893,896,898,901],{"class":38,"line":57},[36,881,882],{"class":42},"  SELECT",[36,884,794],{"class":42},[36,886,797],{"class":42},[36,888,889],{"class":53}," orders ",[36,891,892],{"class":42},"WHERE",[36,894,895],{"class":53}," ordered_on ",[36,897,117],{"class":42},[36,899,900],{"class":158}," '2024-01-01'",[36,902,736],{"class":53},[36,904,905],{"class":38,"line":72},[36,906,767],{"emptyLinePlaceholder":766},[36,908,909],{"class":38,"line":89},[36,910,911],{"class":237},"-- TEMP tables vanish at session end (or COMMIT, with ON COMMIT DROP)\n",[36,913,914,916,918,920,923,926,929,932,934,937,940,943],{"class":38,"line":102},[36,915,43],{"class":42},[36,917,868],{"class":53},[36,919,871],{"class":42},[36,921,922],{"class":53}," scratch (id ",[36,924,925],{"class":42},"int",[36,927,928],{"class":53},", val ",[36,930,931],{"class":42},"text",[36,933,277],{"class":53},[36,935,936],{"class":42},"ON",[36,938,939],{"class":42}," COMMIT",[36,941,942],{"class":42}," DROP",[36,944,736],{"class":53},[14,946,947,948,951],{},"Temporary tables are session-local — no other session sees them, and they're dropped at session end (or transaction end with ",[33,949,950],{},"ON COMMIT DROP","). They're a scratchpad for multi-step processing without polluting the schema. In PostgreSQL, temp tables aren't autovacuumed by default — analyze them if you load lots of rows.",[18,953,955],{"id":954},"alter-table","ALTER TABLE",[23,957,958],{"language":25},[27,959,961],{"className":29,"code":960,"language":25,"meta":31,"style":31},"-- Add a column (fast — no table rewrite in PostgreSQL 11+ for nullable columns)\nALTER TABLE users ADD COLUMN phone TEXT;\n\n-- Add with default (may rewrite the table to fill existing rows; PG 11+ avoids rewrite for non-volatile defaults)\nALTER TABLE users ADD COLUMN status TEXT NOT NULL DEFAULT 'active';\n\n-- Drop a column (fast in PostgreSQL — marks it dead; physical space reclaimed by VACUUM)\nALTER TABLE users DROP COLUMN metadata;\n\n-- Rename a column\nALTER TABLE users RENAME COLUMN name TO full_name;\n\n-- Change a column type (requires a rewrite — expensive on big tables)\nALTER TABLE users ALTER COLUMN age TYPE BIGINT USING age::bigint;\n\n-- Add a constraint (may scan the table to validate)\nALTER TABLE orders ADD CONSTRAINT positive_amount CHECK (amount >= 0);\n\n-- Add a constraint without holding a long lock (PG 12+)\nALTER TABLE orders ADD CONSTRAINT fk_customer\n  FOREIGN KEY (customer_id) REFERENCES customers(id) NOT VALID;\nALTER TABLE orders VALIDATE CONSTRAINT fk_customer;\n",[33,962,963,968,988,992,997,1025,1029,1034,1048,1052,1058,1076,1081,1087,1118,1123,1129,1155,1160,1166,1182,1202],{"__ignoreMap":31},[36,964,965],{"class":38,"line":39},[36,966,967],{"class":237},"-- Add a column (fast — no table rewrite in PostgreSQL 11+ for nullable columns)\n",[36,969,970,973,975,978,981,984,986],{"class":38,"line":57},[36,971,972],{"class":42},"ALTER",[36,974,46],{"class":42},[36,976,977],{"class":53}," users ",[36,979,980],{"class":42},"ADD",[36,982,983],{"class":53}," COLUMN phone ",[36,985,78],{"class":42},[36,987,736],{"class":53},[36,989,990],{"class":38,"line":72},[36,991,767],{"emptyLinePlaceholder":766},[36,993,994],{"class":38,"line":89},[36,995,996],{"class":237},"-- Add with default (may rewrite the table to fill existing rows