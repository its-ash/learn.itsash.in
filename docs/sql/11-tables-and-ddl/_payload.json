ltiple columns)\n  CONSTRAINT positive_amount CHECK (amount >= 0),\n  CONSTRAINT valid_customer FOREIGN KEY (customer_id)\n    REFERENCES customers(id) ON DELETE CASCADE\n);\n",[33,212,213,224,239,256,282,287,306,319,330],{"__ignoreMap":31},[36,214,215,217,219,222],{"class":38,"line":39},[36,216,43],{"class":42},[36,218,46],{"class":42},[36,220,221],{"class":49}," orders",[36,223,54],{"class":53},[36,225,226,228,230,232,235],{"class":38,"line":57},[36,227,60],{"class":53},[36,229,63],{"class":42},[36,231,66],{"class":42},[36,233,234],{"class":53},",                          ",[36,236,238],{"class":237},"sdCPZ","-- column-level\n",[36,240,241,244,247,250,253],{"class":38,"line":72},[36,242,243],{"class":53},"  customer_id ",[36,245,246],{"class":42},"BIGINT",[36,248,249],{"class":42},"  NOT NULL",[36,251,252],{"class":42}," REFERENCES",[36,254,255],{"class":53}," customers(id),\n",[36,257,258,261,264,267,270,272,275,278,280],{"class":38,"line":89},[36,259,260],{"class":53},"  amount      ",[36,262,263],{"class":42},"NUMERIC",[36,265,266],{"class":53},"(",[36,268,269],{"class":120},"10",[36,271,187],{"class":53},[36,273,274],{"class":120},"2",[36,276,277],{"class":53},") ",[36,279,153],{"class":42},[36,281,69],{"class":53},[36,283,284],{"class":38,"line":102},[36,285,286],{"class":237},"  -- table-level constraints (can span multiple columns)\n",[36,288,289,292,295,297,300,302,304],{"class":38,"line":127},[36,290,291],{"class":42},"  CONSTRAINT",[36,293,294],{"class":53}," positive_amount ",[36,296,196],{"class":42},[36,298,299],{"class":53}," (amount ",[36,301,117],{"class":42},[36,303,121],{"class":120},[36,305,124],{"class":53},[36,307,308,310,313,316],{"class":38,"line":147},[36,309,291],{"class":42},[36,311,312],{"class":53}," valid_customer ",[36,314,315],{"class":42},"FOREIGN KEY",[36,317,318],{"class":53}," (customer_id)\n",[36,320,321,324,327],{"class":38,"line":165},[36,322,323],{"class":42},"    REFERENCES",[36,325,326],{"class":53}," customers(id) ",[36,328,329],{"class":42},"ON DELETE CASCADE\n",[36,331,333],{"class":38,"line":332},9,[36,334,168],{"class":53},[14,336,337,338,187,341,344],{},"Table-level constraints are required for multi-column constraints (e.g., ",[33,339,340],{},"UNIQUE (a, b)",[33,342,343],{},"CHECK (a + b \u003C= 100)",") and let you name them.",[18,346,348],{"id":347},"naming-constraints","Naming Constraints",[14,350,351,352,355,356,359],{},"Named constraints produce readable errors (",[33,353,354],{},"violates foreign key constraint \"valid_customer\"",") and can be dropped by name. Unnamed constraints get auto-generated names like ",[33,357,358],{},"orders_customer_id_fkey"," — workable but less clear.",[23,361,362],{"language":25},[27,363,365],{"className":29,"code":364,"language":25,"meta":31,"style":31},"CREATE TABLE accounts (\n  id    BIGSERIAL,\n  email TEXT,\n  CONSTRAINT accounts_pk PRIMARY KEY (id),\n  CONSTRAINT unique_email UNIQUE (email)\n);\n",[33,366,367,378,387,396,408,420],{"__ignoreMap":31},[36,368,369,371,373,376],{"class":38,"line":39},[36,370,43],{"class":42},[36,372,46],{"class":42},[36,374,375],{"class":49}," accounts",[36,377,54],{"class":53},[36,379,380,383,385],{"class":38,"line":57},[36,381,382],{"class":53},"  id    ",[36,384,63],{"class":42},[36,386,69],{"class":53},[36,388,389,392,394],{"class":38,"line":72},[36,390,391],{"class":53},"  email ",[36,393,78],{"class":42},[36,395,69],{"class":53},[36,397,398,400,403,405],{"class":38,"line":89},[36,399,291],{"class":42},[36,401,402],{"class":53}," accounts_pk ",[36,404,199],{"class":42},[36,406,407],{"class":53}," (id),\n",[36,409,410,412,415,417],{"class":38,"line":102},[36,411,291],{"class":42},[36,413,414],{"class":53}," unique_email ",[36,416,193],{"class":42},[36,418,419],{"class":53}," (email)\n",[36,421,422],{"class":38,"line":127},[36,423,168],{"class":53},[18,425,427],{"id":426},"default-values","DEFAULT Values",[23,429,430],{"language":25},[27,431,433],{"className":29,"code":432,"language":25,"meta":31,"styl