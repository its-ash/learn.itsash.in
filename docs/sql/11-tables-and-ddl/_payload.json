E TABLE LIKE — copy structure\n",[36,1411,1412],{"class":38,"line":1060},[36,1413,767],{"emptyLinePlaceholder":766},[36,1415,1416],{"class":38,"line":1078},[36,1417,1418],{"class":158},"::code-wrapper{language=\"sql\"}\n",[36,1420,1421],{"class":38,"line":1083},[36,1422,1423],{"class":158},"```sql\n",[36,1425,1426],{"class":38,"line":1089},[36,1427,1428],{"class":158},"-- Copy structure (no data)\n",[36,1430,1431],{"class":38,"line":1120},[36,1432,1433],{"class":158},"CREATE TABLE orders_archive (LIKE orders INCLUDING ALL);\n",[36,1435,1436],{"class":38,"line":1125},[36,1437,767],{"emptyLinePlaceholder":766},[36,1439,1440],{"class":38,"line":1131},[36,1441,1442],{"class":158},"-- Copy structure with data\n",[36,1444,1445],{"class":38,"line":1157},[36,1446,1447],{"class":158},"CREATE TABLE orders_2024 AS\n",[36,1449,1450,1453,1456,1459,1462,1464,1466],{"class":38,"line":1162},[36,1451,1452],{"class":158},"  SELECT * FROM orders WHERE ordered_on >= '",[36,1454,1455],{"class":120},"2024",[36,1457,1458],{"class":42},"-",[36,1460,1461],{"class":120},"01",[36,1463,1458],{"class":42},[36,1465,1461],{"class":120},[36,1467,1468],{"class":158},"';\n",[36,1470,1471],{"class":38,"line":1168},[36,1472,1329],{"class":158},[14,1474,1475,1478],{},[33,1476,1477],{},"INCLUDING ALL"," copies defaults, constraints, indexes, and comments. Without it, only column names\u002Ftypes are copied.",[18,1480,1482],{"id":1481},"if-not-exists-if-exists","IF NOT EXISTS \u002F IF EXISTS",[14,1484,1485],{},"Avoid errors when running idempotent scripts:",[23,1487,1488],{"language":25},[27,1489,1491],{"className":29,"code":1490,"language":25,"meta":31,"style":31},"CREATE TABLE IF NOT EXISTS logs (...);\nDROP TABLE IF EXISTS old_logs;\nALTER TABLE IF EXISTS users ADD COLUMN IF NOT EXISTS phone TEXT;\n",[33,1492,1493,1511,1524],{"__ignoreMap":31},[36,1494,1495,1497,1499,1502,1505,1508],{"class":38,"line":39},[36,1496,43],{"class":42},[36,1498,46],{"class":42},[36,1500,1501],{"class":49}," IF",[36,1503,1504],{"class":42}," NOT",[36,1506,1507],{"class":42}," EXISTS",[36,1509,1510],{"class":53}," logs (...);\n",[36,1512,1513,1515,1517,1519,1521],{"class":38,"line":57},[36,1514,1044],{"class":42},[36,1516,46],{"class":42},[36,1518,1501],{"class":42},[36,1520,1507],{"class":42},[36,1522,1523],{"class":53}," old_logs;\n",[36,1525,1526,1528,1530,1532,1534,1536,1538,1540,1543,1545,1547,1550,1552],{"class":38,"line":72},[36,1527,972],{"class":42},[36,1529,46],{"class":42},[36,1531,1501],{"class":42},[36,1533,1507],{"class":42},[36,1535,977],{"class":53},[36,1537,980],{"class":42},[36,1539,1009],{"class":53},[36,1541,1542],{"class":42},"IF",[36,1544,1504],{"class":42},[36,1546,1507],{"class":42},[36,1548,1549],{"class":53}," phone ",[36,1551,78],{"class":42},[36,1553,736],{"class":53},[14,1555,1556],{},"Useful for migrations that may run multiple times.",[18,1558,1560],{"id":1559},"tips-tricks","💡 Tips & Tricks",[816,1562,1563,1576,1598,1618,1639],{},[819,1564,1565,1568,1569,1572,1573,1575],{},[173,1566,1567],{},"Idiom",": name your constraints — ",[33,1570,1571],{},"CONSTRAINT orders_fk_customer FOREIGN KEY ..."," produces readable error messages and lets you drop\u002Freplace by name. Auto-generated names like ",[33,1574,358],{}," work but are brittle across schema changes.",[819,1577,1578,1581,1582,1585,1586,1589,1590,1593,1594,1597],{},[173,1579,1580],{},"Performance",": in PostgreSQL 11+, ",[33,1583,1584],{},"ADD COLUMN ... DEFAULT x"," to a nullable-or-defaulted column is ",[173,1587,1588],{},"metadata-only"," (no table rewrite) if the default is a non-volatile constant — adding ",[33,1591,1592],{},"status TEXT NOT NULL DEFAULT 'active'"," to a billion-row table is instant. But ",[33,1595,1596],{},"ALTER COLUMN ... TYPE"," still rewrites; plan type changes carefully.",[819,1599,1600,1602,1603,1606,1607,1610,1611,1613,1614,1617],{},[173,1601,1567],{},": use ",[33,1604,1605],{},"NOT VALID"," + ",[33,1608,1609],{},"VALIDATE CONSTRAINT"," for adding FK\u002FCHECK constraints to large tables without a long lock — ",[33,1612,1605],{}," skips the existing-row scan (instant), ",[33,1615,1616],{},"VALIDATE"," later scans with only a SHARE UPDATE EXCLUSIVE lock (reads\u002Fwrites continue). Standard for zero-downtime migrations.",[819,1619,1620,1622,1623,1625,1626,1629,1630,1632,1633,1635,1636,1638],{},[173,1621,1567],{},": prefer ",[33,1624,1260],{}," over ",[33,1627,1628],{},"DELETE FROM table"," when emptying a whole table — ",[33,1631,1260],{}," is O(1) (no per-row work, no WAL per row, no trigger firing), while ",[33,1634,1268],{}," is O(N) and bloats the table until VACUUM. Reserve ",[33,1637,1268],{}," for partial removals.",[819,1640,1641,1644,1645,1648,1649,1652,1653,716],{},[173,1642,1643],{},"Portability",": ",[33,1646,1647],{},"CREATE TABLE LIKE INCLUDING ALL"," is PostgreSQL-specific; MySQL has ",[33,1650,1651],{},"LIKE"," (no options); SQLite lacks it. For portable structure copying, generate the DDL from ",[33,1654,1655],{},"information_schema",[18,1657,1659],{"id":1658},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[816,1661,1662,1683,1706,1725,1747,1764,1784,1802,1818,1827],{},[819,1663,1664,1644,1672,1674,1675,1678,1679,1682],{},[173,1665,1666,694,1669,1671],{},[33,1667,1668],{},"SERIAL",[33,1670,63],{}," are not types, they're conveniences",[33,1673,1668],{}," creates a sequence + column default + NOT NULL. The column's actual type is ",[33,1676,1677],{},"integer",". The sequence survives even if you drop the default. Prefer ",[33,1680,1681],{},"GENERATED ... AS IDENTITY"," (standard SQL, PostgreSQL 10+) going forward.",[819,1684,1685,1644,1691,1694,1695,1698,1699,1606,1702,1705],{},[173,1686,1687,1690],{},[33,1688,1689],{},"ADD COLUMN ... DEFAULT"," rewrites on volatile defaults",[33,1692,1693],{},"DEFAULT now()"," or ",[33,1696,1697],{},"DEFAULT gen_random_uuid()"," are volatile and require a table rewrite to fill existing rows — even in PG 11+. Use a nullable column + backfill + ",[33,1700,1701],{},"SET DEFAULT",[33,1703,1704],{},"SET NOT NULL"," for safe rollout.",[819,1707,1708,1713,1714,1716,1717,187,1719,1716,1721,1724],{},[173,1709,1710,1712],{},[33,1711,1596],{}," rewrites",": changing ",[33,1715,925],{}," to ",[33,1718,1115],{},[33,1720,931],{},[33,1722,1723],{},"varchar(10)",", etc. rewrites the table. On large tables, do it in stages (new column, backfill, swap).",[819,1726,1727,1644,1732,1735,1736,1739,1740,1743,1744,1746],{},[173,1728,1729,1731],{},[33,1730,1260],{}," and foreign keys",[33,1733,1734],{},"TRUNCATE orders"," fails if another table has a FK to ",[33,1737,1738],{},"orders"," — use ",[33,1741,1742],{},"CASCADE"," (which truncates the dependent tables too) or truncate the dependent table first. ",[33,1745,1742],{}," is dangerous in production — it can wipe tables you didn't intend.",[819,1748,1749,1644,1754,1756,1757,1759,1760,1763],{},[173,1750,1751,1753],{},[33,1752,1260],{}," and sequences",[33,1755,1260],{}," doesn't reset ",[33,1758,1668],{}," sequences by default — use ",[33,1761,1762],{},"RESTART IDENTITY"," to reset them. Without it, new inserts continue from the last sequence value, creating a gap.",[819,1765,1766,1772,1773,1776,1777,1780,1781,1783],{},[173,1767,1768,1771],{},[33,1769,1770],{},"DROP COLUMN"," doesn't reclaim space immediately",": PostgreSQL marks the column dead (fast) but the physical space is only reclaimed by ",[33,1774,1775],{},"VACUUM FULL"," (or ",[33,1778,1779],{},"pg_repack","). Don't expect disk usage to drop right after ",[33,1782,1770],{}," on a large table.",[819,1785,1786,1789,1790,1793,1794,1797,1798,1801],{},[173,1787,1788],{},"Temp tables and schema search path",": temp tables are created in a special ",[33,1791,1792],{},"pg_temp"," schema that's searched first, so ",[33,1795,1796],{},"CREATE TEMP TABLE users (...)"," shadows a ",[33,1799,1800],{},"public.users"," table for the session — a source of \"why isn't my data persisting\" confusion.",[819,1803,1804,1644,1810,1813,1814,1817],{},[173,1805,1806,1809],{},[33,1807,1808],{},"CREATE TABLE AS"," doesn't copy constraints",[33,1811,1812],{},"CREATE TABLE x AS SELECT ..."," copies columns and data but no PK, FK, UNIQUE, CHECK, or defaults. Add them afterward, or use ",[33,1815,1816],{},"LIKE ... INCLUDING ALL"," for structure.",[819,1819,1820,1644,1823,1826],{},[173,1821,1822],{},"Generated columns can't reference other tables",[33,1824,1825],{},"GENERATED ALWAYS AS (...)"," can only use columns of the same row, not subqueries or other tables. For cross-table derivations, use a view or a trigger.",[819,1828,1829,1644,1835,1838,1839,1843],{},[173,1830,1831,1834],{},[33,1832,1833],{},"IF NOT EXISTS"," masks errors",[33,1836,1837],{},"CREATE TABLE IF NOT EXISTS x (...)"," does nothing (and returns a notice) if the table exists — even if the existing table has ",[1840,1841,1842],"em",{},"different columns",". It's idempotent, not a correctness check. Don't use it to \"ensure\" a schema; use it for migrations that may re-run.",[18,1845,1847],{"id":1846},"spot-the-bug","🧠 Spot the Bug",[14,1849,1850],{},"A team runs this migration on a 500M-row table and the database locks up for 20 minutes:",[23,1852,1853,2211,2218,2234,2237],{"language":25},[27,1854,1856],{"className":29,"code":1855,"language":25,"meta":31,"style":31},"ALTER TABLE events\n  ADD COLUMN processed_at TIMESTAMPTZ NOT NULL DEFAULT '1970-01-01';\n``\n::\n\nWhat went wrong, and how should they have done it?\n\n\u003Cdetails>\n\u003Csummary>Answer\u003C\u002Fsummary>\n\nA non-volatile constant default (`'1970-01-01'`) should be metadata-only in PostgreSQL 11+ — but `NOT NULL` forces a different path. To add a `NOT NULL` column, PostgreSQL must verify no existing row is NULL, which for a column with a default means **filling every existing row** with the default value — a full table rewrite on 500M rows, holding an `ACCESS EXCLUSIVE` lock (no reads or writes) for the duration.\n\nThe fix is a staged, lock-light rollout:\n\n```sql\n-- Step 1: add the column NULLABLE with a default (metadata-only, instant)\nALTER TABLE events ADD COLUMN processed_at TIMESTAMPTZ DEFAULT '1970-01-01';\n\n-- Step 2: backfill any NULLs in batches (no long lock; backfill is a no-op here\n--         since the default already populated new rows, but existing rows pre-default\n--         may have NULL — handle in batches)\nUPDATE events SET processed_at = '1970-01-01' WHERE processed_at IS NULL;\n\n-- Step 3: add NOT NULL with a CHECK constraint NOT VALID (instant — skips existing rows)\nALTER TABLE events ADD CONSTRAINT events_processed_at_not_null\n  CHECK (processed_at IS NOT NULL) NOT VALID;\n\n-- Step 4: validate the constraint (SHARE UPDATE EXCLUSIVE — reads\u002Fwrites continue)\nALTER TABLE events VALIDATE CONSTRAINT events_processed_at_not_null;\n",[33,1857,1858,1867,1886,1890,1894,1898,1909,1913,1924,1944,1948,2109,2113,2129,2133,2137,2142,2147,2151,2156,2161,2166,2171,2176,2182,2188,2194,2199,2205],{"__ignoreMap":31},[36,1859,1860,1862,1864],{"class":38,"line":39},[36,1861,972],{"class":42},[36,1863,46],{"class":42},[36,1865,1866],{"class":53}," events\n",[36,1868,1869,1872,1875,1877,1879,1881,1884],{"class":38,"line":57},[36,1870,1871],{"class":42},"  ADD",[36,1873,1874],{"class":53}," COLUMN processed_at ",[36,1876,133],{"class":42},[36,1878,81],{"class":42},[36,1880,138],{"class":42},[36,1882,1883],{"class":158}," '1970-01-01'",[36,1885,736],{"class":53},[36,1887,1888],{"class":38,"line":72},[36,1889,1329],{"class":158},[36,1891,1892],{"class":38,"line":89},[36,1893,1334],{"class":53},[36,1895,1896],{"class":38,"line":102},[36,1897,767],{"emptyLinePlaceholder":766},[36,1899,1900,1903,1906],{"class":38,"line":127},[36,1901,1902],{"class":53},"What went wrong, ",[36,1904,1905],{"class":42},"and",[36,1907,1908],{"class":53}," how should they have done it?\n",[36,1910,1911],{"class":38,"line":147},[36,1912,767],{"emptyLinePlaceholder":766},[36,1914,1915,1918,1921],{"class":38,"line":165},[36,1916,1917],{"class":42},"\u003C",[36,1919,1920],{"class":53},"details",[36,1922,1923],{"class":42},">\n",[36,1925,1926,1928,1931,1934,1937,1940,1942],{"class":38,"line":332},[36,1927,1917],{"class":42},[36,1929,1930],{"class":53},"summary",[36,1932,1933],{"class":42},">",[36,1935,1936],{"class":53},"Answer",[36,1938,1939],{"class":42},"\u003C\u002F",[36,1941,1930],{"class":53},[36,1943,1923],{"class":42},[36,1945,1946],{"class":38,"line":1054},[36,1947,767],{"emptyLinePlaceholder":766},[36,1949,1950,1953,1955,1958,1961,1963,1966,1969,1971,1974,1976,1979,1982,1985,1988,1991,1994,1997,2000,2003,2006,2009,2011,2014,2017,2020,2023,2025,2028,2031,2034,2037,2040,2042,2044,2047,2049,2052,2055,2058,2061,2063,2066,2069,2072,2075,2078,2081,2084,2087,2090,2093,2095,2098,2101,2104,2106],{"class":38,"line":1060},[36,1951,1952],{"class":53},"A non",[36,1954,1458],{"class":42},[36,1956,1957],{"class":53},"volatile constant ",[36,1959,1960],{"class":42},"default",[36,1962,184],{"class":53},[36,1964,1965],{"class":158},"`'1970-01-01'`",[36,1967,1968],{"class":53},") should be metadata",[36,1970,1458],{"class":42},[36,1972,1973],{"class":53},"only ",[36,1975,1355],{"class":42},[36,1977,1978],{"class":53}," PostgreSQL ",[36,1980,1981],{"class":120},"11",[36,1983,1984],{"class":42},"+",[36,1986,1987],{"class":53}," — but ",[36,1989,1990],{"class":158},"`NOT NULL`",[36,1992,1993],{"class":53}," forces a different ",[36,1995,1996],{"class":42},"path",[36,1998,1999],{"class":53},". ",[36,2001,2002],{"class":42},"To",[36,2004,2005],{"class":42}," add",[36,2007,2008],{"class":53}," a ",[36,2010,1990],{"class":158},[36,2012,2013],{"class":53}," column, PostgreSQL must verify ",[36,2015,2016],{"class":42},"no",[36,2018,2019],{"class":53}," existing ",[36,2021,2022],{"class":42},"row",[36,2024,1346],{"class":42},[36,2026,2027],{"class":42}," NULL",[36,2029,2030],{"class":53},", which ",[36,2032,2033],{"class":42},"for",[36,2035,2036],{"class":53}," a column ",[36,2038,2039],{"class":42},"with",[36,2041,2008],{"class":53},[36,2043,1960],{"class":42},[36,2045,2046],{"class":53}," means ",[36,2048,1361],{"class":42},[36,2050,2051],{"class":53},"filling every existing ",[36,2053,2054],{"class":42},"row**",[36,2056,2057],{"class":42}," with",[36,2059,2060],{"class":53}," the ",[36,2062,1960],{"class":42},[36,2064,2065],{"class":42}," value",[36,2067,2068],{"class":53}," — a full ",[36,2070,2071],{"class":42},"table",[36,2073,2074],{"class":53}," rewrite ",[36,2076,2077],{"class":42},"on",[36,2079,2080],{"class":53}," 500M ",[36,2082,2083],{"class":42},"rows",[36,2085,2086],{"class":53},", holding an ",[36,2088,2089],{"class":158},"`ACCESS EXCLUSIVE`",[36,2091,2092],{"class":53}," lock (",[36,2094,2016],{"class":42},[36,2096,2097],{"class":53}," reads ",[36,2099,2100],{"class":42},"or",[36,2102,2103],{"class":53}," writes) ",[36,2105,2033],{"class":42},[36,2107,2108],{"class":53}," the duration.\n",[36,2110,2111],{"class":38,"line":1078},[36,2112,767],{"emptyLinePlaceholder":766},[36,2114,2115,2118,2121,2124,2126],{"class":38,"line":1083},[36,2116,2117],{"class":53},"The fix ",[36,2119,2120],{"class":42},"is",[36,2122,2123],{"class":53}," a staged, lock",[36,2125,1458],{"class":42},[36,2127,2128],{"class":53},"light rollout:\n",[36,2130,2131],{"class":38,"line":1089},[36,2132,767],{"emptyLinePlaceholder":766},[36,2134,2135],{"class":38,"line":1120},[36,2136,1423],{"class":158},[36,2138,2139],{"class":38,"line":1125},[36,2140,2141],{"class":158},"-- Step 1: add the column NULLABLE with a default (metadata-only, instant)\n",[36,2143,2144],{"class":38,"line":1131},[36,2145,2146],{"class":158},"ALTER TABLE events ADD COLUMN processed_at TIMESTAMPTZ DEFAULT '1970-01-01';\n",[36,2148,2149],{"class":38,"line":1157},[36,2150,767],{"emptyLinePlaceholder":766},[36,2152,2153],{"class":38,"line":1162},[36,2154,2155],{"class":158},"-- Step 2: backfill any NULLs in batches (no long lock; backfill is a no-op here\n",[36,2157,2158],{"class":38,"line":1168},[36,2159,2160],{"class":158},"--         since the default already populated new rows, but existing rows pre-default\n",[36,2162,2163],{"class":38,"line":1184},[36,2164,2165],{"class":158},"--         may have NULL — handle in batches)\n",[36,2167,2168],{"class":38,"line":1204},[36,2169,2170],{"class":158},"UPDATE events SET processed_at = '1970-01-01' WHERE processed_at IS NULL;\n",[36,2172,2174],{"class":38,"line":2173},23,[36,2175,767],{"emptyLinePlaceholder":766},[36,2177,2179],{"class":38,"line":2178},24,[36,2180,2181],{"class":158},"-- Step 3: add NOT NULL with a CHECK constraint NOT VALID (instant — skips existing rows)\n",[36,2183,2185],{"class":38,"line":2184},25,[36,2186,2187],{"class":158},"ALTER TABLE events ADD CONSTRAINT events_processed_at_not_null\n",[36,2189,2191],{"class":38,"line":2190},26,[36,2192,2193],{"class":158},"  CHECK (processed_at IS NOT NULL) NOT VALID;\n",[36,2195,2197],{"class":38,"line":2196},27,[36,2198,767],{"emptyLinePlaceholder":766},[36,2200,2202],{"class":38,"line":2201},28,[36,2203,2204],{"class":158},"-- Step 4: validate the constraint (SHARE UPDATE EXCLUSIVE — reads\u002Fwrites continue)\n",[36,2206,2208],{"class":38,"line":2207},29,[36,2209,2210],{"class":158},"ALTER TABLE events VALIDATE CONSTRAINT events_processed_at_not_null;\n",[14,2212,2213,2214,2217],{},"::\nOr, in PostgreSQL 12+, ",[33,2215,2216],{},"ALTER TABLE ... ADD COLUMN ... NOT NULL DEFAULT x"," is still a rewrite — the safe path is the nullable + backfill + NOT VALID + validate pattern.",[14,2219,2220,1644,2223,2225,2226,2228,2229,1606,2231,2233],{},[173,2221,2222],{},"The lesson",[33,2224,153],{}," on a new column with existing rows requires the table to be rewritten\u002Ffilled, holding an exclusive lock. For zero-downtime migrations, add the column nullable, backfill in batches, then add ",[33,2227,153],{}," via a ",[33,2230,1605],{},[33,2232,1616],{}," constraint.",[18,2235,2236],{"id":1930},"Summary",[14,2238,2239,2240,550,2242,2244],{},"You can now create tables with columns, constraints, defaults, and generated columns; organize them with schemas; use temp tables for scratch work; alter tables safely (knowing which operations rewrite); and choose between ",[33,2241,1268],{},[33,2243,1260],{},". Next: constraints and keys — the rules that keep your data consistent.",[2246,2247,2248],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}",{"title":31,"searchDepth":57,"depth":57,"links":2250},[2251,2254,2255,2259,2260,2263,2264,2267,2268,2269,2270,2271,2272],{"id":20,"depth":57,"text":21,"children":2252},[2253],{"id":204,"depth":72,"text":205},{"id":347,"depth":57,"text":348},{"id":426,"depth":57,"text":427,"children":2256},[2257],{"id":547,"depth":72,"text":2258},"DEFAULT and NULL",{"id":574,"depth":57,"text":575},{"id":708,"depth":57,"text":709,"children":2261},[2262],{"id":813,"depth":72,"text":814},{"id":853,"depth":57,"text":854},{"id":954,"depth":57,"text":955,"children":2265},[2266],{"id":1220,"depth":72,"text":1221},{"id":1259,"depth":57,"text":1260},{"id":1481,"depth":57,"text":1482},{"id":1559,"depth":57,"text":1560},{"id":1658,"depth":57,"text":1659},{"id":1846,"depth":57,"text":1847},{"id":1930,"depth":57,"text":2236},"md",{},"\u002Fsql\u002F11-tables-and-ddl",{"title":5,"description":16},"sql\u002F11-tables-and-ddl","wSjgnM58jIjPJpvUSTwvJHSysMUTsJnKeK3PdE4UH4I",1786943184502]