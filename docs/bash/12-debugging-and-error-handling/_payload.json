434,1435,1438,1439,1441],{},[164,1430,1355],{},": check dependencies with ",[18,1433,841],{}," — ",[18,1436,1437],{},"command -v git &>\u002Fdev\u002Fnull || { echo \"git not found\" >&2; exit 1; }",". Portable (unlike ",[18,1440,845],{},"). Check at script start for required tools.",[23,1443,1445],{"id":1444},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[158,1447,1448,1471,1497,1522,1546,1569,1585,1607,1625,1631],{},[161,1449,1450,1455,1456,1458,1459,1458,1462,1458,1465,1467,1468,1470],{},[164,1451,1452,1454],{},[18,1453,221],{}," doesn't catch everything",": commands in ",[18,1457,250],{},"\u002F",[18,1460,1461],{},"while",[18,1463,1464],{},"&&",[18,1466,877],{}," conditions don't trigger exit. Functions can mask errors (return non-zero → exit unless checked). Use ",[18,1469,221],{}," but don't rely on it blindly.",[161,1472,1473,1480,1481,1483,1484,1486,1487,1489,1490,1492,1493,1496],{},[164,1474,1475,1477,1478],{},[18,1476,221],{}," in pipelines needs ",[18,1479,310],{},": ",[18,1482,196],{}," — without ",[18,1485,310],{},", only ",[18,1488,209],{},"'s status matters. ",[18,1491,205],{}," failing is masked. ",[18,1494,1495],{},"set -o pipefail"," makes any failure propagate.",[161,1498,1499,1480,1505,1508,1509,1511,1512,1514,1515,1458,1518,1521],{},[164,1500,1501,1504],{},[18,1502,1503],{},"set -u"," and default expansions",[18,1506,1507],{},"${var:-default}"," works with ",[18,1510,176],{}," (doesn't error). But ",[18,1513,1157],{}," (unset) errors. Use ",[18,1516,1517],{},":-",[18,1519,1520],{},":+"," for optional vars.",[161,1523,1524,1529,1530,1533,1534,1536,1537,296,1539,1542,1543,1545],{},[164,1525,1526,1528],{},[18,1527,221],{}," and subshells",": a subshell ",[18,1531,1532],{},"(cmd)"," that fails — does the parent exit? With ",[18,1535,168],{},", yes (the subshell's failure propagates). But ",[18,1538,295],{},[18,1540,1541],{},"$(cmd)"," doesn't trigger ",[18,1544,168],{}," (command substitution).",[161,1547,1548,1553,1554,1556,1557,1560,1561,1564,1565,1568],{},[164,1549,1550,1552],{},[18,1551,221],{}," and functions",": a function returning non-zero triggers ",[18,1555,168],{}," ",[199,1558,1559],{},"if called as a simple command",". But ",[18,1562,1563],{},"func || true"," masks it. And ",[18,1566,1567],{},"if func; then"," tests it (no exit). Be careful with functions that \"fail\" intentionally.",[161,1570,1571,1577,1578,1580,1581,1584],{},[164,1572,1573,296,1575],{},[18,1574,507],{},[18,1576,437],{},": gives the line where the failing command is, but if the command is in a function, ",[18,1579,507],{}," is relative to the function. Use ",[18,1582,1583],{},"${BASH_LINENO[0]}"," for the caller's line.",[161,1586,1587,1592,1593,1596,1597,1599,1600,1602,1603,1606],{},[164,1588,1589,1591],{},[18,1590,514],{}," is verbose",": it prints ",[199,1594,1595],{},"every"," command, including expansions. For large scripts, it's noisy. Use ",[18,1598,514],{}," \u002F ",[18,1601,1392],{}," around a section, or ",[18,1604,1605],{},"bash -x"," from the CLI for a full trace.",[161,1608,1609,1614,1615,1617,1618,1620,1621,1624],{},[164,1610,1611,1613],{},[18,1612,437],{}," doesn't fire for all failures",": it fires for command failures (with ",[18,1616,221],{},"), but not for syntax errors (which abort before running) or ",[18,1619,425],{},". ",[18,1622,1623],{},"trap EXIT"," fires on any exit.",[161,1626,1627,1630],{},[164,1628,1629],{},"Exit code 130 (Ctrl-C)",": 128 + 2 (SIGINT). 137 = 128 + 9 (SIGKILL). 143 = 128 + 15 (SIGTERM). Knowing the signal codes helps debug \"why did my script die.\"",[161,1632,1633,1480,1641,1643,1644,1646,1647,1650,1651,1654],{},[164,1634,1635,1637,1638,1640],{},[18,1636,221],{}," with ",[18,1639,306],{}," (no match)",[18,1642,306],{}," returns 1 if no match — with ",[18,1645,221],{},", this exits the script. Use ",[18,1648,1649],{},"grep ... || true"," or ",[18,1652,1653],{},"grep -q ... && ..."," (tested) to avoid.",[23,1656,1658],{"id":1657},"spot-the-bug","🧠 Spot the Bug",[14,1660,1661,1662,1664],{},"A developer enables ",[18,1663,221],{},", but a pipeline failure is missed:",[31,1666,1667],{"language":33},[35,1668,1670],{"className":37,"code":1669,"language":33,"meta":39,"style":39},"set -e\ngrep \"error\" log.txt | head -5\necho \"Done\"\n",[18,1671,1672,1678,1697],{"__ignoreMap":39},[43,1673,1674,1676],{"class":45,"line":46},[43,1675,28],{"class":49},[43,1677,236],{"class":49},[43,1679,1680,1682,1685,1688,1691,1694],{"class":45,"line":59},[43,1681,306],{"class":450},[43,1683,1684],{"class":78}," \"error\"",[43,1686,1687],{"class":78}," log.txt",[43,1689,1690],{"class":249}," |",[43,1692,1693],{"class":450}," head",[43,1695,1696],{"class":49}," -5\n",[43,1698,1699,1701],{"class":45,"line":70},[43,1700,411],{"class":49},[43,1702,1703],{"class":78}," \"Done\"\n",[14,1705,1706,1707,1710,1711,1713],{},"If ",[18,1708,1709],{},"log.txt"," doesn't exist, ",[18,1712,306],{}," fails, but the script continues to \"Done\". Why?",[1715,1716,1717,1721,1748,1754,1788,1803,1809],"details",{},[1718,1719,1720],"summary",{},"Answer",[14,1722,1723,1724,1726,1727,1730,1731,1734,1735,1737,1738,1741,1742,1744,1745,1747],{},"Without ",[18,1725,1495],{},", a pipeline's exit status is the ",[199,1728,1729],{},"last"," command's status. ",[18,1732,1733],{},"grep \"error\" log.txt | head -5"," — if ",[18,1736,306],{}," fails (file not found), but ",[18,1739,1740],{},"head"," succeeds (it got no input but exited 0), the pipeline's status is ",[18,1743,1740],{},"'s (0). ",[18,1746,221],{}," sees 0 (success) and doesn't exit.",[14,1749,1750,1751,1753],{},"The fix — enable ",[18,1752,310],{},":",[35,1755,1757],{"className":37,"code":1756,"language":33,"meta":39,"style":39},"set -eo pipefail\ngrep \"error\" log.txt | head -5\necho \"Done\"\n",[18,1758,1759,1768,1782],{"__ignoreMap":39},[43,1760,1761,1763,1766],{"class":45,"line":46},[43,1762,28],{"class":49},[43,1764,1765],{"class":49}," -eo",[43,1767,128],{"class":78},[43,1769,1770,1772,1774,1776,1778,1780],{"class":45,"line":59},[43,1771,306],{"class":450},[43,1773,1684],{"class":78},[43,1775,1687],{"class":78},[43,1777,1690],{"class":249},[43,1779,1693],{"class":450},[43,1781,1696],{"class":49},[43,1783,1784,1786],{"class":45,"line":70},[43,1785,411],{"class":49},[43,1787,1703],{"class":78},[14,1789,1790,1791,1793,1794,1796,1797,1799,1800,1802],{},"::\nWith ",[18,1792,310],{},", the pipeline fails if ",[199,1795,201],{}," command fails — ",[18,1798,306],{},"'s failure propagates, and ",[18,1801,221],{}," exits before \"Done\".",[14,1804,1805,1806,1808],{},"The full strict mode is ",[18,1807,20],{}," — always use all four for robust scripts.",[14,1810,1811,1814,1815,1817,1818,1434,1820,206,1822,1824,1825,1827,1828,1830],{},[164,1812,1813],{},"The lesson",": without ",[18,1816,310],{},", a pipeline's exit status is only the last command's. ",[18,1819,196],{},[18,1821,205],{},[18,1823,209],{}," succeeds. ",[18,1826,1495],{}," makes any command's failure propagate. Always use ",[18,1829,20],{}," (the full strict mode).",[23,1832,1833],{"id":1718},"Summary",[14,1835,1836,1837,1839,1840,1842,1843,1458,1845,1839,1847,1849,1850,1852,1853,1856,1857,1859,1860,1862,1863,1856,1865,1867,1868,1870,1871,1873],{},"You can use strict mode (",[18,1838,20],{},"), ",[18,1841,514],{}," tracing (with ",[18,1844,566],{},[18,1846,507],{},[18,1848,437],{}," for error logging, ",[18,1851,1623],{}," for cleanup, manual error checks (",[18,1854,1855],{},"if !",", ",[18,1858,877],{},"), logging (to stderr with timestamps), meaningful exit codes, dependency checks (",[18,1861,841],{},"), and debugging techniques (",[18,1864,1186],{},[18,1866,1123],{},", dry-run) — with the ",[18,1869,310],{},"-needed and ",[18,1872,221],{},"-exceptions traps internalized. Next: best practices and idioms.",[1875,1876,1877],"style",{},"html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D