id":701,"depth":59,"text":702},{"id":779,"depth":59,"text":780,"children":1899},[1900,1901,1902,1903],{"id":783,"depth":70,"text":784},{"id":848,"depth":70,"text":849},{"id":941,"depth":70,"text":942},{"id":997,"depth":70,"text":998},{"id":1080,"depth":59,"text":1081,"children":1905},[1906,1908,1910,1911],{"id":1084,"depth":70,"text":1907},"set -x + set -v",{"id":1120,"depth":70,"text":1909},"bashdb (debugger)",{"id":1139,"depth":70,"text":1140},{"id":1190,"depth":70,"text":1191},{"id":1347,"depth":59,"text":1348},{"id":1444,"depth":59,"text":1445},{"id":1657,"depth":59,"text":1658},{"id":1718,"depth":59,"text":1833},"Bash's error handling is minimal by default — commands fail silently, unset variables are empty. set -euo pipefail and careful checks make scripts robust.","md",{},"\u002Fbash\u002F12-debugging-and-error-handling",{"title":5,"description":1916},"bash\u002F12-debugging-and-error-handling","otB3MrCvPADy0rTGraz0QJHF4Xd28Jq6L9ImoO_whKo",1787401237791]