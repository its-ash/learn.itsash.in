9,1682,1683,1686,1687,382],{},[1533,1661,1662,363,1665],{},[33,1663,1664],{},"rm -rf $var",[33,1666,366],{},": ",[33,1669,1670],{},"rm -rf \u002Fsome\u002Fpath"," — if ",[33,1673,366],{}," is empty and unquoted, ",[33,1676,1677],{},"rm -rf \u002Fsome\u002Fpath\u002F *"," (deletes everything in ",[33,1680,1681],{},"\u002Fsome\u002Fpath","). Always quote ",[33,1684,1685],{},"\"$var\""," and check ",[33,1688,1689],{},"[[ -n \"$var\" ]]",[376,1691,1692,1697,1698,1702,1703,1705,1706,1708],{},[1533,1693,1694,1696],{},[33,1695,756],{}," is wrong",": this sends stderr to the ",[1699,1700,1701],"em",{},"old"," stdout (terminal), then stdout to the file — stderr still goes to the terminal. Use ",[33,1704,760],{}," or ",[33,1707,1604],{}," (stderr to the new stdout = file).",[376,1710,1711,1667,1720,1723,1724,1726,1727,1729,1730,1733,1734,1736],{},[1533,1712,1713,1716,1717],{},[33,1714,1715],{},"find -exec ... {} \\;"," vs ",[33,1718,1719],{},"+",[33,1721,1722],{},"\\;"," runs the command once per file (slow for many files); ",[33,1725,1719],{}," batches (faster). Use ",[33,1728,1719],{}," when the command accepts multiple files (",[33,1731,1732],{},"grep",", ",[33,1735,411],{},").",[376,1738,1739,1667,1745,1747,1748,1750,1751,1754,1755,1758],{},[1533,1740,1741,1742,1744],{},"Parsing ",[33,1743,100],{}," is fragile",[33,1746,100],{}," escapes special characters inconsistently. Use ",[33,1749,923],{}," or globs instead. ",[33,1752,1753],{},"for f in *.txt"," is safe (glob expansion); ",[33,1756,1757],{},"for f in $(ls)"," is not.",[376,1760,1761,1667,1768,1771,1772,1775,1776,1779,1780,1783],{},[1533,1762,1763,1357,1765,1767],{},[33,1764,185],{},[33,1766,228],{}," overwrite without warning",[33,1769,1770],{},"cp src dst"," overwrites ",[33,1773,1774],{},"dst"," silently. Use ",[33,1777,1778],{},"cp -i"," (interactive) for safety, or ",[33,1781,1782],{},"cp -n"," (no overwrite).",[376,1785,1786,1794,1795,1797,1798,1801,1802,1805,1806,1809,1810,1813],{},[1533,1787,1788,1789,1357,1791,1793],{},"macOS ",[33,1790,185],{},[33,1792,228],{}," differ from GNU",": BSD ",[33,1796,185],{}," doesn't have some GNU options (",[33,1799,1800],{},"--backup","). Check ",[33,1803,1804],{},"man cp"," on your system. Install GNU coreutils (",[33,1807,1808],{},"brew install coreutils",") for ",[33,1811,1812],{},"gcp"," etc.",[376,1815,1816,1667,1821,1823,1824,1826,1827,1829,1830,1736],{},[1533,1817,1818,1820],{},[33,1819,1490],{}," templates differ",[33,1822,1490],{}," (GNU) vs ",[33,1825,1490],{}," (BSD\u002FmacOS) have different template syntax. ",[33,1828,1490],{}," (no args) works on both (creates a uniquely-named file in ",[33,1831,1832],{},"$TMPDIR",[376,1834,1835,1841,1842,1845,1846,1849,1850,1852],{},[1533,1836,1837,1840],{},[33,1838,1839],{},"trap EXIT"," runs on any exit",": including ",[33,1843,1844],{},"exit",", end of script, ",[33,1847,1848],{},"set -e"," abort, and signals (if trapped). It runs in the exiting shell. Multiple ",[33,1851,1839],{}," overwrite (last one wins); combine cleanup in one function.",[376,1854,1855,1667,1861,1864,1865,1868],{},[1533,1856,1857,1858,1860],{},"Heredoc ",[33,1859,915],{}," strips tabs only (not spaces)",[33,1862,1863],{},"\u003C\u003C-"," allows indented heredocs, but only leading ",[1699,1866,1867],{},"tabs"," are stripped, not spaces. Configure your editor to use tabs for the heredoc indentation.",[376,1870,1871,1878,1879,1882,1883,1886],{},[1533,1872,1873,1372,1875,1877],{},[33,1874,1416],{},[33,1876,1460],{}," on network filesystems",": sizes can be off (block sizes, sparse files). Use ",[33,1880,1881],{},"du -b"," (bytes) or ",[33,1884,1885],{},"stat -c %s file"," (exact bytes) for precision.",[18,1888,1890],{"id":1889},"spot-the-bug","🧠 Spot the Bug",[14,1892,1893],{},"A developer redirects stderr to a file, but errors still appear in the terminal:",[23,1895,1896],{"language":25},[27,1897,1899],{"className":29,"code":1898,"language":25,"meta":31,"style":31},"cmd 2>&1 > output.txt\n",[33,1900,1901],{"__ignoreMap":31},[36,1902,1903,1905,1907,1909],{"class":38,"line":39},[36,1904,605],{"class":99},[36,1906,645],{"class":608},[36,1908,609],{"class":608},[36,1910,1911],{"class":56}," output.txt\n",[14,1913,1914],{},"What's wrong?",[1916,1917,1918,1922,1929,1951,1958,1961,1980,1985,2004,2007,2019,2022],"details",{},[1919,1920,1921],"summary",{},"Answer",[14,1923,1924,1925,1928],{},"The order of redirections matters. ",[33,1926,1927],{},"cmd 2>&1 > output.txt",":",[1930,1931,1932,1942],"ol",{},[376,1933,1934,1937,1938,1941],{},[33,1935,1936],{},"2>&1"," — stderr (fd 2) is redirected to where stdout (fd 1) ",[1699,1939,1940],{},"currently"," points (the terminal).",[376,1943,1944,1947,1948,382],{},[33,1945,1946],{},"> output.txt"," — stdout (fd 1) is redirected to ",[33,1949,1950],{},"output.txt",[14,1952,1953,1954,1957],{},"So stderr goes to the terminal (it was redirected ",[1699,1955,1956],{},"before"," stdout changed), and stdout goes to the file. Errors still appear in the terminal.",[14,1959,1960],{},"The fix — redirect stdout first, then stderr:",[27,1962,1964],{"className":29,"code":1963,"language":25,"meta":31,"style":31},"cmd > output.txt 2>&1   # stdout to file, then stderr to the new stdout (file)\n",[33,1965,1966],{"__ignoreMap":31},[36,1967,1968,1970,1972,1975,1977],{"class":38,"line":39},[36,1969,605],{"class":99},[36,1971,609],{"class":608},[36,1973,1974],{"class":56}," output.txt",[36,1976,645],{"class":608},[36,1978,1979],{"class":46},"   # stdout to file, then stderr to the new stdout (file)\n",[14,1981,1982,1983,1928],{},"::\nOr use Bash's ",[33,1984,1600],{},[27,1986,1988],{"className":29,"code":1987,"language":25,"meta":31,"style":31},"cmd &> output.txt   # both stdout and stderr to file (Bash shorthand)\n",[33,1989,1990],{"__ignoreMap":31},[36,1991,1992,1994,1996,1998,2001],{"class":38,"line":39},[36,1993,605],{"class":99},[36,1995,669],{"class":668},[36,1997,672],{"class":608},[36,1999,2000],{"class":668}," output.txt   ",[36,2002,2003],{"class":46},"# both stdout and stderr to file (Bash shorthand)\n",[14,2005,2006],{},"::\nNow:",[1930,2008,2009,2014],{},[376,2010,2011,2013],{},[33,2012,1946],{}," — stdout (fd 1) → file.",[376,2015,2016,2018],{},[33,2017,1936],{}," — stderr (fd 2) → the current stdout (fd 1), which is now the file.",[14,2020,2021],{},"Both go to the file.",[14,2023,2024,2027,2028,2030,2031,2033,2034,2037,2038,2041],{},[1533,2025,2026],{},"The lesson",": redirections are processed left-to-right. ",[33,2029,1615],{}," makes stderr go to the ",[1699,2032,1701],{}," stdout (terminal) before stdout is redirected. ",[33,2035,2036],{},"> file 2>&1"," (or ",[33,2039,2040],{},"&> file",") redirects stdout first, then stderr follows it to the file. Order matters.",[18,2043,2044],{"id":1919},"Summary",[14,2046,2047,2048,1357,2050,1357,2052,2054,2055,1357,2057,1357,2059,1357,2061,1357,2063,1357,2065,2067,2068,2070,2071,2073,2074,1733,2076,1733,2079,1733,2082,1733,2084,1733,2086,2089,2090,2092,2093,1357,2096,1357,2099,1357,2102,1357,2105,1733,2107,2109,2110,1357,2112,1357,2114,1357,2116,2118,2119,2121,2122,2124,2125,2127],{},"You can navigate (",[33,2049,43],{},[33,2051,53],{},[33,2053,100],{},"), manipulate files (",[33,2056,185],{},[33,2058,228],{},[33,2060,253],{},[33,2062,299],{},[33,2064,322],{},[33,2066,334],{},"), manage permissions (",[33,2069,411],{}," octal\u002Fsymbolic, ",[33,2072,491],{},"), redirect (",[33,2075,672],{},[33,2077,2078],{},">>",[33,2080,2081],{},"2>",[33,2083,1936],{},[33,2085,1600],{},[33,2087,2088],{},"\u003C",", heredocs, here-strings), find files (",[33,2091,923],{}," with ",[33,2094,2095],{},"-name",[33,2097,2098],{},"-type",[33,2100,2101],{},"-mtime",[33,2103,2104],{},"-exec",[33,2106,1249],{},[33,2108,1260],{},"), use ",[33,2111,1416],{},[33,2113,1460],{},[33,2115,1371],{},[33,2117,1375],{},", and create safe temp files (",[33,2120,1490],{}," + ",[33,2123,1520],{},") — with the redirection-order and ",[33,2126,253],{},"-empty-var traps internalized. Next: processes and sig