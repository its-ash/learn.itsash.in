33,1590,709],{}," in a function",[33,1593,790],{}," exits the function (with a status); ",[33,1596,709],{}," exits the script. In a ",[33,1599,532],{},"d file, ",[33,1602,709],{}," would close the caller's shell — use ",[33,1605,790],{},[386,1607,1608,1614,1615,1618],{},[389,1609,1610,1611,1613],{},"Quoting ",[33,1612,994],{}," is always safe",": even when \"unnecessary\" (e.g., ",[33,1616,1617],{},"[[ $var ]]","), quoting is safe. Unquoting is sometimes wrong. Consistency (always quote) is safer than case-by-case reasoning.",[18,1620,1622],{"id":1621},"spot-the-bug","🧠 Spot the Bug",[14,1624,1625],{},"A developer gets the script's directory, but it breaks when the script is called via a symlink:",[23,1627,1628],{"language":25},[27,1629,1631],{"className":29,"code":1630,"language":25,"meta":31,"style":31},"SCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n",[33,1632,1633],{"__ignoreMap":31},[36,1634,1635,1637,1639,1641,1643,1645,1647,1649,1651,1654,1656],{"class":38,"line":39},[36,1636,409],{"class":80},[36,1638,84],{"class":76},[36,1640,87],{"class":56},[36,1642,90],{"class":49},[36,1644,93],{"class":56},[36,1646,97],{"class":96},[36,1648,277],{"class":56},[36,1650,189],{"class":49},[36,1652,1653],{"class":56},"\")\" && ",[36,1655,109],{"class":49},[36,1657,112],{"class":56},[14,1659,1660],{},"What's the issue?",[1662,1663,1664,1668,1696,1708,1736,1742,1899,1906,1932],"details",{},[1665,1666,1667],"summary",{},"Answer",[14,1669,1670,1672,1673,1676,1677,1680,1681,1684,1685,1688,1689,1692,1693,1695],{},[33,1671,189],{}," is the path used to invoke the script — if it's a symlink (",[33,1674,1675],{},"\u002Fusr\u002Flocal\u002Fbin\u002Fmyscript"," → ",[33,1678,1679],{},"\u002Fopt\u002Fmyscript\u002Fscript.sh","), ",[33,1682,1683],{},"dirname \"$0\""," gives ",[33,1686,1687],{},"\u002Fusr\u002Flocal\u002Fbin"," (the symlink's directory), not the real script's directory (",[33,1690,1691],{},"\u002Fopt\u002Fmyscript","). Resources relative to ",[33,1694,409],{}," (config