2202],{},"$(ls *.txt)"," captures it as a string, and ",[33,2205,2206],{},"for file in $files"," (unquoted) word-splits on spaces. A file named ",[33,2209,2210],{},"my file.txt"," becomes two iterations: ",[33,2213,2214],{},"my",[33,2216,2217],{},"file.txt",[372,2219,2220,1940,2226,2228,2229,2231],{},[111,2221,2222,2223,2225],{},"Parsing ",[33,2224,2136],{}," is fragile",[33,2227,2136],{}," escapes special characters (spaces, newlines) inconsistently. Don't parse ",[33,2230,2136],{}," output.",[14,2233,2234,2235,2237],{},"The fix — use a glob directly (no ",[33,2236,2136],{},"):",[27,2239,2241],{"className":29,"code":2240,"language":25,"meta":31,"style":31},"for file in *.txt; do\n    echo \"Processing $file\"\ndone\n",[33,2242,2243,2258,2268],{"__ignoreMap":31},[36,2244,2245,2247,2249,2251,2254,2256],{"class":38,"line":39},[36,2246,301],{"class":46},[36,2248,2151],{"class":42},[36,2250,307],{"class":46},[36,2252,2253],{"class":50}," *.txt",[36,2255,326],{"class":42},[36,2257,700],{"class":46},[36,2259,2260,2262,2264,2266],{"class":38,"line":58},[36,2261,705],{"class":149},[36,2263,2164],{"class":50},[36,2265,260],{"class":42},[36,2267,713],{"class":50},[36,2269,2270],{"class":38,"line":69},[36,2271,719],{"class":46},[14,2273,2274,2275,2278,2279,2281],{},"The glob ",[33,2276,2277],{},"*.txt"," expands to the actual filenames, each as a separate element (even with spaces). No ",[33,2280,2136],{},", no word-splitting.",[14,2283,2284,2285,1958,2288,130,2291,1102],{},"Or, for recursive or complex cases, use ",[33,2286,2287],{},"find",[33,2289,2290],{},"-print0",[33,2292,2293],{},"read -d ''",[27,2295,2297],{"className":29,"code":2296,"language":25,"meta":31,"style":31},"while IFS= read -r -d '' file; do\n    echo \"Processing $file\"\ndone \u003C \u003C(find . -name \"*.txt\" -print0)\n",[33,2298,2299,2327,2337],{"__ignoreMap":31},[36,2300,2301,2304,2307,2309,2312,2314,2317,2320,2323,2325],{"class":38,"line":39},[36,2302,2303],{"class":46},"while",[36,2305,2306],{"class":42}," IFS",[36,2308,47],{"class":46},[36,2310,2311],{"class":149}," read",[36,2313,940],{"class":149},[36,2315,2316],{"class":149}," -d",[36,2318,2319],{"class":50}," ''",[36,2321,2322],{"class":50}," file",[36,2324,326],{"class":42},[36,2326,700],{"class":46},[36,2328,2329,2331,2333,2335],{"class":38,"line":58},[36,2330,705],{"class":149},[36,2332,2164],{"class":50},[36,2334,260],{"class":42},[36,2336,713],{"class":50},[36,2338,2339,2341,2344,2347,2349,2352,2355,2358,2360],{"class":38,"line":69},[36,2340,329],{"class":46},[36,2342,2343],{"class":46}," \u003C",[36,2345,2346],{"class":50}," \u003C(",[36,2348,2287],{"class":513},[36,2350,2351],{"class":50}," . ",[36,2353,2354],{"class":149},"-name",[36,2356,2357],{"class":50}," \"*.txt\" ",[36,2359,2290],{"class":149},[36,2361,567],{"class":50},[14,2363,2364,2366,2367,2369],{},[33,2365,2290],{}," separates filenames with null bytes (the only character not allowed in a filename); ",[33,2368,2293],{}," reads null-delimited. This handles any filename (spaces, newlines, special chars).",[14,2371,2372,2375,2376,2378,2379,2382,2383,2386,2387,2389,2390,2393],{},[111,2373,2374],{},"The lesson",": don't parse ",[33,2377,2136],{}," (fragile, breaks on spaces). Use globs (",[33,2380,2381],{},"for file in *.txt",") or ",[33,2384,2385],{},"find -print0"," + ",[33,2388,2293],{}," for filenames. Always quote ",[33,2391,2392],{},"\"$file\"",". See chapter 04 for more.",[18,2395,2396],{"id":2180},"Summary",[14,2398,2399,2400,2403,2404,396,2406,2409,2410,2412,2413,2415,2416,396,2418,396,2420,396,2423,396,2426,396,2429,2432,2433,396,2435,396,2437,2439,2440,2442,2443,1212,2446,1212,2449,2452,2453,2455],{},"You can assign variables (",[33,2401,2402],{},"name=\"value\"",", no spaces), expand them (",[33,2405,415],{},[33,2407,2408],{},"${var}","), quote correctly (double quotes, always), use \"types\" (",[33,2411,436],{},", arrays, associative arrays, ",[33,2414,922],{},"), parameter expansion (",[33,2417,1030],{},[33,2419,1076],{},[33,2421,2422],{},"${#}",[33,2424,2425],{},"${var:0:3}",[33,2427,2428],{},"${var\u002F\u002Fa\u002Fb}",[33,2430,2431],{},"${var^^}","), special variables (",[33,2434,1399],{},[33,2436,1389],{},[33,2438,1423],{},"), scope (",[33,2441,1626],{},"), and read input (",[33,2444,2445],{},"read -p",[33,2447,2448],{},"-s",[33,2450,2451],{},"-t",") — with the no-spaces-around-",[33,2454,47],{}," and always-quote traps internalized. Next: operators and expansions.",[2457,2458,2459],"style",{},"html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .