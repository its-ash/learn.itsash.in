},"process-inspection","Process Inspection",[28,1161,1162],{"language":30},[32,1163,1165],{"className":34,"code":1164,"language":30,"meta":36,"style":36},"ps aux               # all processes\nps aux | grep bash   # find bash processes\npgrep -f \"script.sh\" # PIDs matching a pattern\npkill -f \"script.sh\" # kill by pattern\npstree -p            # process tree with PIDs\ntop                  # interactive process monitor\nhtop                 # better interactive monitor (install separately)\n",[38,1166,1167,1178,1194,1207,1219,1230,1238],{"__ignoreMap":36},[41,1168,1169,1172,1175],{"class":43,"line":44},[41,1170,1171],{"class":47},"ps",[41,1173,1174],{"class":130}," aux",[41,1176,1177],{"class":51},"               # all processes\n",[41,1179,1180,1182,1184,1186,1188,1191],{"class":43,"line":77},[41,1181,1171],{"class":47},[41,1183,1174],{"class":130},[41,1185,935],{"class":116},[41,1187,941],{"class":47},[41,1189,1190],{"class":130}," bash",[41,1192,1193],{"class":51},"   # find bash processes\n",[41,1195,1196,1199,1201,1204],{"class":43,"line":124},[41,1197,1198],{"class":47},"pgrep",[41,1200,483],{"class":120},[41,1202,1203],{"class":130}," \"script.sh\"",[41,1205,1206],{"class":51}," # PIDs matching a pattern\n",[41,1208,1209,1212,1214,1216],{"class":43,"line":140},[41,1210,1211],{"class":47},"pkill",[41,1213,483],{"class":120},[41,1215,1203],{"class":130},[41,1217,1218],{"class":51}," # kill by pattern\n",[41,1220,1221,1224,1227],{"class":43,"line":157},[41,1222,1223],{"class":47},"pstree",[41,1225,1226],{"class":120}," -p",[41,1228,1229],{"class":51},"            # process tree with PIDs\n",[41,1231,1232,1235],{"class":43,"line":239},[41,1233,1234],{"class":47},"top",[41,1236,1237],{"class":51},"                  # interactive process monitor\n",[41,1239,1240,1243],{"class":43,"line":250},[41,1241,1242],{"class":47},"htop",[41,1244,1245],{"class":51},"                 # better interactive monitor (install separately)\n",[18,1247,1249],{"id":1248},"tips-tricks","💡 Tips & Tricks",[260,1251,1252,1269,1286,1310,1329],{},[263,1253,1254,1257,1258,1261,1262,1264,1265,1268],{},[385,1255,1256],{},"Idiom",": use ",[38,1259,1260],{},"trap 'rm -f \"$tmp\"; cleanup' EXIT"," for cleanup — ",[38,1263,566],{}," is a pseudo-signal that runs on any exit (normal, error with ",[38,1266,1267],{},"set -e",", or signal). Combine all cleanup in one function. Never leave temp files behind.",[263,1270,1271,1257,1273,1275,1276,1278,1279,1282,1283,1285],{},[385,1272,1256],{},[38,1274,242],{}," (SIGTERM) before ",[38,1277,433],{}," (SIGKILL) — SIGTERM can be caught (trap) for graceful shutdown; SIGKILL is immediate (no cleanup). Try ",[38,1280,1281],{},"kill $pid"," first; ",[38,1284,433],{}," only if it hangs.",[263,1287,1288,1257,1290,1292,1293,1295,1296,1298,1299,1301,1302,1304,1305,801,1307,1309],{},[385,1289,1256],{},[38,1291,143],{}," (or ",[38,1294,810],{}," in Bash 5.1+) to wait for background jobs — ",[38,1297,143],{}," (no arg) waits for all; ",[38,1300,797],{}," for a specific one; ",[38,1303,810],{}," for any one (job pools). After ",[38,1306,143],{},[38,1308,165],{}," is the job's exit status.",[263,1311,1312,1257,1314,1317,1318,1321,1322,1325,1326,1328],{},[385,1313,1256],{},[38,1315,1316],{},"xargs -0"," with ",[38,1319,1320],{},"find -print0"," for safe parallel processing — ",[38,1323,1324],{},"find . -name \"*.py\" -print0 | xargs -0 grep \"main\""," handles filenames with spaces. ",[38,1327,1026],{}," runs N processes in parallel.",[263,1330,1331,1257,1333,1335,1336,1339,1340,1343],{},[385,1332,1256],{},[38,1334,1042],{}," for commands that might hang — ",[38,1337,1338],{},"timeout 30 .\u002Fscript.sh"," kills it after 30s (SIGTERM). Use ",[38,1341,1342],{},"-s KILL"," for SIGKILL. Essential for CI\u002FCD and automation.",[18,1345,1347],{"id":1346},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[260,1349,1350,1361,1379,1401,1416,1431,1457,1479,1500,1513],{},[263,1351,1352,1357,1358,1360],{},[385,1353,1354,1356],{},[38,1355,433],{}," can't be caught",": SIGKILL immediately terminates (no trap, no cleanup). Use only as a last resort (process hung, ignoring SIGTERM). Try ",[38,1359,242],{}," (SIGTERM) first.",[263,1362,1363,1366,1367,272,1369,272,1371,1374,1375,1378],{},[385,1364,1365],{},"Background jobs die when the shell exits",": unless ",[38,1368,1108],{},[38,1370,1112],{},[38,1372,1373],{},"setsid"," is used. For scripts that should survive logout, use ",[38,1376,1377],{},"nohup script.sh &"," or a service manager (systemd).",[263,1380,1381,1386,1387,1389,1390,1393,1394,1397,1398,1400],{},[385,1382,1383,1385],{},[38,1384,143],{}," in a subshell",": ",[38,1388,143],{}," only waits for jobs of the ",[860,1391,1392],{},"current"," shell. In a subshell (",[38,1395,1396],{},"(cmd &) ; wait","), the subshell's jobs don't exist after it exits. Run ",[38,1399,143],{}," inside the subshell.",[263,1402,1403,1408,1409,1411,1412,1415],{},[385,1404,1405,1407],{},[38,1406,92],{}," is the last background PID",": but if another command runs in between, ",[38,1410,92],{}," changes. Capture it immediately: ",[38,1413,1414],{},"cmd &; pid=$!",".",[263,1417,1418,1423,1424,1426,1427,1430],{},[385,1419,1420,1422],{},[38,1421,451],{}," in a subshell doesn't affect the parent",": traps are shell-specific. A ",[38,1425,451],{}," in ",[38,1428,1429],{},"( ... )"," doesn't apply to the parent shell.",[263,1432,1433,1440,1441,1443,1444,1446,1447,272,1450,1453,1454,1456],{},[385,1434,1435,1109,1438],{},[38,1436,1437],{},"trap EXIT",[38,1439,1267],{},": on a ",[38,1442,1267],{}," abort, ",[38,1445,566],{}," still runs (the trap fires). But ",[38,1448,1449],{},"INT",[38,1451,1452],{},"TERM"," traps might not (the abort happens before). Combine cleanup in ",[38,1455,566],{}," for reliability.",[263,1458,1459,1386,1464,1467,1468,1471,1472,1475,1476,1415],{},[385,1460,1461,1463],{},[38,1462,242],{}," requires a PID or job spec",[38,1465,1466],{},"kill %1"," (job 1) or ",[38,1469,1470],{},"kill 12345"," (PID). ",[38,1473,1474],{},"kill \"script.sh\""," doesn't work — use ",[38,1477,1478],{},"pkill -f \"script.sh\"",[263,1480,1481,1386,1486,1488,1489,1491,1492,1317,1494,1496,1497,1415],{},[385,1482,1483,1485],{},[38,1484,910],{}," with special chars",[38,1487,910],{}," without ",[38,1490,1030],{}," breaks on spaces\u002Fquotes. Always use ",[38,1493,1030],{},[38,1495,1320],{},". Or use ",[38,1498,1499],{},"find -exec ... {} +",[263,1501,1502,1386,1507,1509,1510,1415],{},[385,1503,1504,1506],{},[38,1505,1042],{}," exit status",[38,1508,1042],{}," returns 124 if the command timed out, or the command's exit status otherwise. Distinguish: ",[38,1511,1512],{},"timeout 30 cmd; status=$?; [[ $status -eq 124 ]] && echo \"timed out\"",[263,1514,1515,1522,1523,1525,1526,1528,1529,1415],{},[385,1516,1517,1519,1520],{},[38,1518,1108],{}," redirects to ",[38,1521,1151],{},": if stdout is a terminal, ",[38,1524,1108],{}," redirects it to ",[38,1527,1151],{}," (and stderr to stdout). Redirect explicitly: ",[38,1530,1531],{},"nohup cmd > out.log 2>&1 &",[18,1533,1535],{"id":1534},"spot-the-bug","🧠 Spot the Bug",[14,1537,1538,1539,1541],{},"A developer runs three jobs in parallel, but ",[38,1540,143],{}," doesn't give the expected exit status:",[28,1543,1544],{"language":30},[32,1545,1547],{"className":34,"code":1546,"language":30,"meta":36,"style":36},".\u002Fjob1.sh &\n.\u002Fjob2.sh &\n.\u002Fjob3.sh &\nwait\necho \"Exit status: $?\"\n",[38,1548,1549,1555,1561,1567,1572],{"__ignoreMap":36},[41,1550,1551,1553],{"class":43,"line":44},[41,1552,699],{"class":47},[41,1554,108],{"class":70},[41,1556,1557,1559],{"class":43,"line":77},[41,1558,706],{"class":47},[41,1560,108],{"class":70},[41,1562,1563,1565],{"class":43,"line":124},[41,1564,713],{"class":47},[41,1566,108],{"class":70},[41,1568,1569],{"class":43,"line":140},[41,1570,1571],{"class":120},"wait\n",[41,1573,1574,1576,1578,1580],{"class":43,"line":157},[41,1575,127],{"class":120},[41,1577,162],{"class":130},[41,1579,165],{"class":120},[41,1581,137],{"class":130},[14,1583,1584,1585,1587],{},"After all jobs finish, ",[38,1586,165],{}," isn't the exit status of any job. Why?",[1589,1590,1591,1595,1611,1617,1813,1816,1960],"details",{},[1592,1593,1594],"summary",{},"Answer",[14,1596,1597,1599,1600,1602,1603,1606,1607,1610],{},[38,1598,143],{}," (no argument) waits for all background jobs to finish, but ",[38,1601,165],{}," after it is the exit status of the ",[860,1604,1605],{},"last"," job that finished (which is non-deterministic — jobs finish in any order). It's not the exit status of a specific job, and it doesn't reflect whether ",[860,1608,1609],{},"all"," jobs succeeded.",[14,1612,1613,1614,1616],{},"The fix — capture each job's PID and ",[38,1615,143],{}," for them individually:",[32,1618,1620],{"className":34,"code":1619,"language":30,"meta":36,"style":36},".\u002Fjob1.sh &\npid1=$!\n.\u002Fjob2.sh &\npid2=$!\n.\u002Fjob3.sh &\npid3=$!\n\nwait \"$pid1\"; status1=$?\nwait \"$pid2\"; status2=$?\nwait \"$pid3\"; status3=$?\n\nif ((status1 == 0 && status2 == 0 && status3 == 0)); then\n    echo \"All succeeded\"\nelse\n    echo \"Some failed: $status1 $status2 $status3\"\n    exit 1\nfi\n",[38,1621,1622,1628,1636,1642,1650,1656,1665,1669,1687,1704,1722,1726,1765,1773,1779,1798,1807],{"__ignoreMap":36},[41,1623,1624,1626],{"class":43,"line":44},[41,1625,699],{"class":47},[41,1627,108],{"class":70},[41,1629,1630,1632,1634],{"class":43,"line":77},[41,1631,743],{"class":70},[41,1633,117],{"class":116},[41,1635,121],{"class":120},[41,1637,1638,1640],{"class":43,"line":124},[41,1639,706],{"class":47},[41,1641,108],{"class":70},[41,1643,1644,1646,1648],{"class":43,"line":140},[41,1645,758],{"class":70},[41,1647,117],{"class":116},[41,1649,121],{"class":120},[41,1651,1652,1654],{"class":43,"line":157},[41,1653,713],{"class":47},[41,1655,108],{"class":70},[41,1657,1658,1661,1663],{"class":43,"line":239},[41,1659,1660],{"class":70},"pid3",[41,1662,117],{"class":116},[41,1664,121],{"class":120},[41,1666,1667],{"c