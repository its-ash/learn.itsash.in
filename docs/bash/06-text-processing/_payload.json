2,36],{}," — ",[18,1665,36],{}," only removes ",[980,1668,982],{}," duplicates. ",[18,1671,1672],{},"sort file | uniq -c | sort -rn"," gives a frequency count (most frequent first). The classic pattern for \"top N\" analysis.",[279,1675,1676,1678,1679,1682],{},[1575,1677,1577],{},": compose pipelines — ",[18,1680,1681],{},"grep ... | awk ... | sort | uniq -c | sort -rn | head"," chains tools (each command's stdout → next's stdin). This is the Unix philosophy: small tools, composed. Prefer pipelines over monolithic scripts.",[57,1684,1686],{"id":1685},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[276,1688,1689,1710,1727,1741,1761,1780,1794,1815,1829,1862],{},[279,1690,1691,1697,1698,1701,1702,1705,1706,1709],{},[1575,1692,1693,1696],{},[18,1694,1695],{},"sed -i"," modifies files in-place (dangerous)",": always test without ",[18,1699,1700],{},"-i"," first, or use ",[18,1703,1704],{},"sed -i.bak"," (creates a backup). On macOS, ",[18,1707,1708],{},"sed -i ''"," (empty string) is required (BSD sed differs from GNU sed).",[279,1711,1712,1717,1718,1720,1721,1723,1724,55],{},[1575,1713,1714,1716],{},[18,1715,36],{}," only removes adjacent duplicates",": ",[18,1719,36],{}," without ",[18,1722,33],{}," first won't dedup non-adjacent lines. Always ",[18,1725,1726],{},"sort | uniq",[279,1728,1729,1717,1734,1736,1737,1740],{},[1575,1730,1731,1733],{},[18,1732,33],{}," is locale-dependent",[18,1735,33],{}," uses the locale's collation (case-insensitive in some locales). Use ",[18,1738,1739],{},"LC_ALL=C sort"," for byte-order (deterministic, faster).",[279,1742,1743,1717,1748,1750,1751,1754,1755,523,1758,55],{},[1575,1744,1745,1747],{},[18,1746,20],{}," regex is line-based",[18,1749,55],{}," doesn't match newlines. For multi-line patterns, use ",[18,1752,1753],{},"grep -z"," (null-delimited) or ",[18,1756,1757],{},"pcregrep",[18,1759,1760],{},"ripgrep",[279,1762,1763,1768,1769,1772,1773,1776,1777,533],{},[1575,1764,1765,1767],{},[18,1766,27],{}," field separator",": default is whitespace (any amount). ",[18,1770,1771],{},"-F','"," for CSV. For multiple separators, ",[18,1774,1775],{},"awk -F'[ ,]'"," (regex). For CSV with quoted fields, use a proper CSV tool (csvkit, ",[18,1778,1779],{},"mlr",[279,1781,1782,1717,1787,1790,1791,1793],{},[1575,1783,1784,1786],{},[18,1785,39],{}," is character-based, not pattern-based",[18,1788,1789],{},"tr 'abc' '123'"," replaces a→1, b→2, c→3. It doesn't replace the string \"abc\". Use ",[18,1792,24],{}," for string\u002Fpattern replacement.",[279,1795,1796,1717,1801,1804,1805,1808,1809,1811,1812,55],{},[1575,1797,1798,1800],{},[18,1799,30],{}," can't handle quoted CSV",[18,1802,1803],{},"cut -d',' -f1"," breaks on fields with commas inside quotes (",[18,1806,1807],{},"\"Smith, John\"","). Use ",[18,1810,27],{}," with a CSV parser or ",[18,1813,1814],{},"csvkit",[279,1816,1817,1717,1822,1824,1825,1828],{},[1575,1818,1819,1821],{},[18,1820,1227],{}," blocks",[18,1823,1227],{}," streams forever. Use in a terminal or with a timeout. In a script, ",[18,1826,1827],{},"tail -n +1 -f file | grep -m1 \"done\""," (stops at first match).",[279,1830,1831,1834,1835,1837,1838,1840,1841,1837,1844,1847,1848,523,1851,1854,1855,1858,1859,1861],{},[1575,1832,1833],{},"macOS sed vs GNU sed",": BSD sed (macOS) differs: ",[18,1836,1708],{}," (not ",[18,1839,1695],{},"), ",[18,1842,1843],{},"sed -E",[18,1845,1846],{},"sed -r","), no ",[18,1849,1850],{},"\\s",[18,1852,1853],{},"\\d"," by default. Install GNU sed (",[18,1856,1857],{},"brew install gnu-sed",") for consistency, or use ",[18,1860,1843],{}," (POSIX ERE, works on both).",[279,1863,1864,1717,1870,1872,1873,1875,1876,1878,1879,1882],{},[1575,1865,1866,1869],{},[18,1867,1868],{},"grep -P"," (PCRE) is GNU-only",[18,1871,1868],{}," (Perl regex) isn't on macOS BSD grep. Use ",[18,1874,312],{}," (ERE, portable) or ",[18,1877,1760],{}," (",[18,1880,1881],{},"rg",") for advanced regex.",[57,1884,1886],{"id":1885},"spot-the-bug","🧠 Spot the Bug",[14,1888,1889,1890,1892],{},