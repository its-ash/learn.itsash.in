44,1746],{},[18,1742,20],{}," tests are in ",[18,1745,1345],{}," files",[18,1748,1749],{},"test\u002Ftest_foo.bats",[18,1751,1584],{}," runs all ",[18,1754,1755],{},"*.bats"," files. A ",[18,1758,1759],{},".sh"," test file is ignored.",[1623,1762,1763,1489,1768,1770,1771,1774],{},[1626,1764,1765,1767],{},[18,1766,299],{}," captures stdout and stderr together",[18,1769,640],{}," has both. For separate capture, use ",[18,1772,1773],{},"run --separate-stderr"," (bats-core 1.5+) or redirect in the command.",[1623,1776,1777,1782,1783,1785],{},[1626,1778,1779,1781],{},[18,1780,435],{}," in a test runs in the test's shell",": functions\u002Fvariables from the sourced file are available. But ",[18,1784,1070],{}," in the sourced file applies to the test (may cause unexpected exits).",[1623,1787,1788,1489,1795,1797,1798,637,1800,1802,1803,650,1806,1809],{},[1626,1789,1790,650,1792,1794],{},[18,1791,955],{},[18,1793,986],{}," per test",[18,1796,955],{}," runs before each ",[18,1799,181],{},[18,1801,986],{}," after. For once-per-file, use ",[18,1804,1805],{},"setup_file",[18,1807,1808],{},"teardown_file"," (bats-core 1.5+).",[1623,1811,1812,1489,1815,1818,1819,1821,1822,1825,1826,1829,1830,1832],{},[1626,1813,1814],{},"Mocking with functions affects the current shell",[18,1816,1817],{},"git() { ... }"," overrides ",[18,1820,120],{}," in the test. ",[18,1823,1824],{},"export -f git"," propagates to subshells. Unset (",[18,1827,1828],{},"unset -f git",") in ",[18,1831,986],{}," to restore.",[1623,1834,1835,1841,1842,1844,1845,1847,1848,1850,1851,1853],{},[1626,1836,1837,647,1839],{},[18,1838,20],{},[18,1840,1070],{},": a failing ",[18,1843,924],{}," in a ",[18,1846,181],{}," causes the test to fail (good). But ",[18,1849,1070],{}," in a sourced file can cause the test to exit unexpectedly. Avoid ",[18,1852,1070],{}," in libraries (use it in scripts).",[1623,1855,1856,1489,1859,1862],{},[1626,1857,1858],{},"TAP output for CI",[18,1860,1861],{},"bats --formatter tap test\u002F"," produces TAP (test anything protocol), which CI systems parse. Default formatter is human-readable.",[1623,1864,1865,1869,1870,1872,1873,1875,1876,1697],{},[1626,1866,1867],{},[18,1868,446],{},": the path to the ",[18,1871,1345],{}," file. Use for ",[18,1874,435],{},"-ing libraries relative to the test: ",[18,1877,1878],{},"source \"$(dirname \"$BATS_TEST_FILENAME\")\u002F..\u002Flib\u002Ffoo.sh\"",[1623,1880,1881,1489,1886,1889,1890,1893,1894,1697],{},[1626,1882,1883,1885],{},[18,1884,20],{}," on macOS",[18,1887,1888],{},"brew install bats-core"," (the npm\u002Fapt versions may be older). ",[18,1891,1892],{},"bats-core"," (the maintained fork) is preferred over the original ",[18,1895,20],{},[1623,1897,1898,1489,1901,1903,1904,1906],{},[1626,1899,1900],{},"Tests don't catch everything",[18,1902,20],{}," tests behavior, but ShellCheck catches static issues (quoting, ",[18,1905,1070],{}," gaps, unquoted vars). Use both.",[27,1908,1910],{"id":1909},"spot-the-bug","🧠 Spot the Bug",[14,1912,1913],{},"A developer tests a function, but the test passes even when the function is broken:",[34,1915,1916],{"language":36},[38,1917,1919],{"className":40,"code":1918,"language":36,"meta":42,"style":42},"@test \"add returns the sum\" {\n    run add 2 3\n    [[ \"$(add 2 3)\" == \"5\" ]]\n}\n",[18,1920,1921,1929,1939,1959],{"__ignoreMap":42},[46,1922,1923,1925,1927],{"class":48,"line":49},[46,1924,181],{"class":59},[46,1926,460],{"class":63},[46,1928,187],{"class":63},[46,1930,1931,1933,1935,1937],{"class":48,"line":56},[46,1932,549],{"class":59},[46,1934,865],{"class":63},[46,1936,402],{"class":81},[46,1938,603],{"class":81},[46,1940,1941,1943,1945,1947,1949,1951,1953,1955,1957],{"class":48,"line":73},[46,1942,219],{"class":137},[46,1944,199],{"class":63},[46,1946,350],{"class":59},[46,1948,402],{"class":81},[46,1950,475],{"class":81},[46,1952,478],{"class":63},[46,1954,230],{"class":195},[46,1956,483],{"class":63},[46,1958,236],{"class":137},[46,1960,1961],{"class":48,"line":91},[46,1962,241],{"class":137},[14,1964,1965],{},"What's wrong with this test?",[1967,1968,1969,1973,2009,2017,2076,2082,2132,2142],"details",{},[1970,1971,1972],"summary",{},"Answer",[14,1974,1975,1976,1979,1980,1984,1985,1987,1988,650,1990,1992,1993,1995,1996,1998,1999,2001,2002,2004,2005,2008],{},"The test calls ",[18,1977,1978],{},"add 2 3"," ",[1981,1982,1983],"em",{},"twice"," — once with ",[18,1986,299],{}," (capturing into ",[18,1989,565],{},[18,1991,640],{},", but not checking them), and once directly in the ",[18,1994,924],{},". The ",[18,1997,299],{}," is wasted (its output isn't checked). If ",[18,2000,350],{}," has a side effect (writing to a file, incrementing a counter), calling it twice causes issues. And if ",[18,2003,350],{}," is broken, the direct ",[18,2006,2007],{},"$(add 2 3)"," would fail, but the test structure is confusing (two calls).",[14,2010,2011,2012,2014,2015,160],{},"The fix — use ",[18,2013,299],{}," and check ",[18,2016,640],{},[38,2018,2020],{"className":40,"code":2019,"language":36,"meta":42,"style":42},"@test \"add returns the sum\" {\n    run add 2 3\n    [[ \"$status\" -eq 0 ]]\n    [[ \"$output\" == \"5\" ]]\n}\n",[18,2021,2022,2030,2040,2056,2072],{"__ignoreMap":42},[46,2023,2024,2026,2028],{"class":48,"line":49},[46,2025,181],{"class":59},[46,2027,460],{"class":63},[46,2029,187],{"class":63},[46,2031,2032,2034,2036,2038],{"class":48,"line":56},[46,2033,549],{"class":59},[46,2035,865],{"class":63},[46,2037,402],{"class":81},[46,2039,603],{"class":81},[46,2041,2042,2044,2046,2048,2050,2052,2054],{"class":48,"line":73},[46,2043,219],{"class":137},[46,2045,222],{"class":63},[46,2047,565],{"class":137},[46,2049,222],{"class":63},[46,2051,285],{"class":195},[46,2053,407],{"class":81},[46,2055,236],{"class":137},[46,2057,2058,2060,2062,2064,2066,2068,2070],{"class":48,"line":91},[46,2059,219],{"class":137},[46,2061,222],{"class":63},[46,2063,640],{"class":137},[46,2065,222],{"class":63},[46,2067,230],{"class":195},[46,2069,483],{"class":63},[46,2071,236],{"class":137},[46,2073,2074],{"class":48,"line":104},[46,2075,241],{"class":137},[14,2077,2078,2079,2081],{},"::\nOr test directly (without ",[18,2080,299],{},"):",[38,2083,2085],{"className":40,"code":2084,"language":36,"meta":42,"style":42},"@test \"add returns the sum\" {\n    result=\"$(add 2 3)\"\n    [[ \"$result\" == \"5\" ]]\n}\n",[18,2086,2087,2095,2112,2128],{"__ignoreMap":42},[46,2088,2089,2091,2093],{"class":48,"line":49},[46,2090,181],{"class":59},[46,2092,460],{"class":63},[46,2094,187],{"class":63},[46,2096,2097,2099,2101,2103,2105,2107,2109],{"class":48,"line":56},[46,2098,192],{"class":137},[46,2100,196],{"class":195},[46,2102,199],{"class":63},[46,2104,350],{"class":59},[46,2106,402],{"class":81},[46,2108,475],{"class":81},[46,2110,2111],{"class":63},")\"\n",[46,2113,2114,2116,2118,2120,2122,2124,2126],{"class":48,"line":73},[46,2115,219],{"class":137},[46,2117,222],{"class":63},[46,2119,225],{"class":137},[46,2121,222],{"class":63},[46,2123,230],{"class":195},[46,2125,483],{"class":63},[46,2127,236],{"class":137},[46,2129,2130],{"class":48,"line":91},[46,2131,241],{"class":137},[14,2133,2134,2135,2137,2138,2141],{},"::\nPick one approach. ",[18,2136,299],{}," is better for testing commands (it captures exit status and output cleanly). Direct ",[18,2139,2140],{},"$(...)"," is fine for pure functions.",[14,2143,2144,2147,2148,2150,2151,2153,2154,650,2156,2158,2159,2162],{},[1626,2145,2146],{},"The lesson",": don't mix ",[18,2149,299],{}," and direct calls in the same test. Use ",[18,2152,299],{}," + check ",[18,2155,565],{},[18,2157,640],{},", OR capture directly (",[18,2160,2161],{},"result=$(...)",") + check. Calling the function twice is wasteful and can cause side-effect bugs.",[27,2164,2165],{"id":1970},"Summary",[14,2167,2168,2169,2171,2172,637,2174,650,2176,650,2178,2180,2181,2171,2183,650,2185,2180,2187,650,2189,2191,2192,2194,2195,367,2197,2199,2200,2202],{},"You can test Bash scripts with ",[18,2170,20],{}," (",[18,2173,