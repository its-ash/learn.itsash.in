80],{},"$str == h*",[18,1682,1683],{},"$str =~ ^[0-9]+$","), and uses ",[18,1686,427],{},[18,1688,185],{}," inside. Reserve ",[18,1691,590],{}," for POSIX ",[18,1694,1695],{},"sh",".",[899,1698,1699,1639,1701,1703,1704,1706,1707,1710],{},[941,1700,1638],{},[18,1702,1208],{}," (not backticks) for command substitution — ",[18,1705,1208],{}," is nestable (",[18,1708,1709],{},"$(echo $(date))",") and readable. Backticks are hard to nest and easy to misread.",[899,1712,1713,1715,1716,1719,1720,1723],{},[941,1714,1638],{},": use brace expansion for generating lists — ",[18,1717,1718],{},"mkdir -p project\u002F{src,lib,test}"," creates 3 dirs; ",[18,1721,1722],{},"echo file{1..3}.txt"," generates filenames. Expanded before other expansions (doesn't need files to exist, unlike globs).",[899,1725,1726,1639,1728,1731,1732,1735,1736,1739,1740,1743,1744,1747],{},[941,1727,1638],{},[18,1729,1730],{},"shopt -s globstar"," for recursive globs (",[18,1733,1734],{},"**\u002F*.py",") and ",[18,1737,1738],{},"shopt -s nullglob"," to make non-matching globs empty (not literal) — avoids bugs where ",[18,1741,1742],{},"*.txt"," is passed literally if no ",[18,1745,1746],{},".txt"," files exist.",[23,1749,1751],{"id":1750},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[896,1753,1754,1764,1780,1810,1831,1845,1862,1875,1898,1922],{},[899,1755,1756,1759,1760,1763],{},[941,1757,1758],{},"Integer division truncates toward zero",": ",[18,1761,1762],{},"(-5 \u002F 2) = -2"," (not -3). For floor division of negatives, adjust manually.",[899,1765,1766,1759,1771,1773,1774,1776,1777,1779],{},[941,1767,1768,1770],{},[18,1769,731],{}," is Bash-only",[18,1772,1676],{}," doesn't work in POSIX ",[18,1775,1695],{},". Use ",[18,1778,590],{}," (with careful quoting) for portable scripts.",[899,1781,1782,1792,1793,1795,1796,1798,1799,1801,1802,1804,1805,1789,1807,1809],{},[941,1783,1784,1786,1787,1789,1790],{},[18,1785,446],{}," vs ",[18,1788,59],{}," in ",[18,1791,590],{},": in ",[18,1794,1676],{},", both work. In ",[18,1797,590],{}," (POSIX), only ",[18,1800,59],{}," is standard (though ",[18,1803,446],{}," works in most shells). Use ",[18,1806,59],{},[18,1808,590],{}," for portability.",[899,1811,1812,1818,1819,1822,1823,1826,1827,1830],{},[941,1813,1814,1815],{},"Regex in ",[18,1816,1817],{},"[[ =~ ]]",": the regex should ",[1458,1820,1821],{},"not"," be quoted (quoting makes it a literal string). Store in a variable: ",[18,1824,1825],{},"re=\"^[0-9]+$\"; [[ $str =~ $re ]]",". ",[18,1828,1829],{},"BASH_REMATCH"," holds the match.",[899,1832,1833,1838,1839,1841,1842,904],{},[941,1834,1835,1837],{},[18,1836,1375],{}," process substitution is Bash-only",": doesn't work in POSIX ",[18,1840,1695],{},". Useful for avoiding temp files (",[18,1843,1844],{},"diff \u003C(sort a) \u003C(sort b)",[899,1846,1847,1759,1850,1852,1853,1855,1856,1858,1859,1861],{},[941,1848,1849],{},"Globs pass literally if no match",[18,1851,1742],{}," with no ",[18,1854,1746],{}," files passes the literal string ",[18,1857,1742],{}," to the command. ",[18,1860,1738],{}," makes it empty.",[899,1863,1864,1759,1867,1870,1871,1874],{},[941,1865,1866],{},"Brace expansion happens before globbing",[18,1868,1869],{},"file{1..3}.txt"," expands to ",[18,1872,1873],{},"file1.txt file2.txt file3.txt",", then each is glob-expanded (if they exist). Brace expansion alone doesn't require files to exist.",[899,1876,1877,1759,1883,1885,1886,1889,1890,1893,1894,1897],{},[941,1878,1879,1882],{},[18,1880,1881],{},"(( ))"," returns exit status",[18,1884,1659],{}," is a command (exit status 0 if true). ",[18,1887,1888],{},"((x = 5))"," is an assignment (exit status 1 if the result is 0, 0 if non-zero — surprising). Use ",[18,1891,1892],{},"((x = 5)) || true"," to avoid ",[18,1895,1896],{},"set -e"," exit if x is 0.",[899,1899,1900,1759,1905,1908,1909,909,1912,1915,1916,1918,1919,1921],{},[941,1901,1902,1904],{},[18,1903,590],{}," spacing",[18,1906,1907],{},"[ $x -gt 5 ]"," — missing spaces around ",[18,1910,1911],{},"[",[18,1913,1914],{},"]"," is a syntax error. ",[18,1917,1911],{}," is a command (alias for ",[18,1920,580],{},"); it needs spaces.",[899,1923,1924,1759,1929,1649,1932,1935,1936,1939,1940,1943,1944,1696],{},[941,1925,1926,1928],{},[18,1927,580],{}," with empty variables",[18,1930,1931],{},"[ $x = \"foo\" ]",[18,1933,1934],{},"x=\"\""," becomes ",[18,1937,1938],{},"[ = \"foo\" ]"," (syntax error). Always quote: ",[18,1941,1942],{},"[ \"$x\" = \"foo\" ]"," or use ",[18,1945,1676],{},[23,1947,1949],{"id":1948},"spot-the-bug","🧠 Spot the Bug",[14,1951,1952],{},"A developer checks if a variable equals a string, but it fails when the variable is empty:",[36,1954,1955],{"language":38},[40,1956,1958],{"className":42,"code":1957,"language":38,"meta":44,"style":44},"x=\"\"\nif [ $x = \"hello\" ]; then\n    echo \"match\"\nfi\n",[18,1959,1960,1969,1985,1992],{"__ignoreMap":44},[48,1961,1962,1964,1966],{"class":50,"line":51},[48,1963,55],{"class":54},[48,1965,59],{"class":58},[48,1967,1968],{"class":62},"\"\"\n",[48,1970,1971,1973,1976,1978,1980,1982],{"class":50,"line":66},[48,1972,605],{"class":58},[48,1974,1975],{"class":54}," [ $x ",[48,1977,59],{"class":58},[48,1979,682],{"class":62},[48,1981,625],{"class":54},[48,1983,1984],{"class":58},"then\n",[48,1986,1987,1989],{"class":50,"line":91},[48,1988,1346],{"class":80},[48,1990,1991],{"class":62}," \"match\"\n",[48,1993,1994],{"class":50,"line":106},[48,1995,638],{"class":58},[14,1997,1998],{},"What's wrong?",[2000,2001,2002,2006,2032,2038,2116,2137],"details",{},[2003,2004,2005],"summary",{},"Answer",[14,2007,2008,2009,2011,2012,2015,2016,2018,2019,2022,2023,2025,2026,2028,2029,1696],{},"When ",[18,2010,1934],{}," (empty), ",[18,2013,2014],{},"[ $x = \"hello\" ]"," (unquoted ",[18,2017,614],{},") expands to ",[18,2020,2021],{},"[ = \"hello\" ]"," — the ",[18,2024,1911],{}," command sees ",[18,2027,59],{}," as its first argument, which is a syntax error: ",[18,2030,2031],{},"bash: [: =: unary operator expected",[14,2033,2034,2035,2037],{},"The fix — quote the variable (or use ",[18,2036,1676],{},"):",[40,2039,2041],{"className":42,"code":2040,"language":38,"meta":44,"style":44},"# Option 1: quote\nif [ \"$x\" = \"hello\" ]; then\n    echo \"match\"\nfi\n# \"$x\" expands to \"\" (empty string), so [ \"\" = \"hello\" ] — valid, false.\n\n# Option 2: use [[ ]] (safer, no quoting needed)\nif [[ $x == \"hello\" ]]; then\n    echo \"match\"\nfi\n",[18,2042,2043,2048,2068,2074,2078,2083,2087,2092,2106,2112],{"__ignoreMap":44},[48,2044,2045],{"class":50,"line":51},[48,2046,2047],{"class":87},"# Option 1: quote\n",[48,2049,2050,2052,2054,2056,2058,2060,2062,2064,2066],{"class":50,"line":66},[48,2051,605],{"class":58},[48,2053,608],{"class":54},[48,2055,611],{"class":62},[48,2057,614],{"class":54},[48,2059,611],{"class":62},[48,2061,679],{"class":58},[48,2063,682],{"class":62},[48,2065,625],{"class":54},[48,2067,1984],{"class":58},[48,2069,2070,2072],{"class":50,"line":91},[48,2071,1346],{"class":80},[48,2073,1991],{"class":62},[48,2075,2076],{"class":50,"line":106},[48,2077,638],{"class":58},[48,2079,2080],{"class":50,"line":119},[48,2081,2082],{"class":87},"# \"$x\" expands to \"\" (empty string), so [ \"\" = \"hello\" ] — valid, false.\n",[48,2084,2085],{"class":50,"line":136},[48,2086,140],{"emptyLinePlaceholder":139},[48,2088,2089],{"class":50,"line":143},[48,2090,2091],{"class":87},"# Option 2: use [[ ]] (safer, no quoting needed)\n",[48,2093,2094,2096,2098,2100,2102,2104],{"class":50,"line":149},[48,2095,605],{"class":58},[48,2097,746],{"class":54},[48,2099,446],{"class":58},[48,2101,682],{"class":62},[48,2103,754],{"class":54},[48,2105,1984],{"class":58},[48,2107,2108,2110],{"class":50,"line":172},[48,2109,1346],{"class":80},[48,2111,1991],{"class":62},[48,2113,2114],{"class":50,"line":197},[48,2115,638],{"class":58},[14,2117,2118,2119,2122,2123,2126,2127,2130,2131,2133,2134,2136],{},"::\nWith quotes, ",[18,2120,2121],{},"\"$x\""," becomes an empty string ",[18,2124,2125],{},"\"\"",", so ",[18,2128,2129],{},"[ \"\" = \"hello\" ]"," is a valid test (false). With ",[18,2132,1676],{},", word-splitting doesn't happen, so ",[18,2135,614],{}," (empty) is safe without quotes.",[14,2138,2139,1792,2142,2144,2145,2147,2148,2150,2151,2153,2154,946],{},[941,2140,2141],{},"The lesson",[18,2143,590],{}," (POSIX test), always quote variables: ",[18,2146,2121],{},". An unquoted empty variable disappears, causing syntax errors (",[18,2149,2021],{},"). ",[18,2152,731],{}," (Bash) is safer — no word-splitting, no quoting required. Prefer ",[18,2155,1676],{},[23,2157,2158],{"id":2003},"Summary",[14,2160,2161,2162,2164,2165,2167,2168,393,2170,393,2172,2174,2175,2177,2178,2180,2181,2183,2184,2186,2187,2189,2190,2192,2193,2195,2196,2189,2198,2189,2201,2189,2204,1649,2206,2209,2210,2213,2214,2216],{},"You can use arithmetic (",[18,2163,33],{}," for evaluation, ",[18,2166,249],{}," for expansion, ",[18,2169,374],{},[18,2171,396],{},[18,2173,407],{},"), tests (",[18,2176,731],{}," preferred, file\u002Fstring\u002Finteger tests, regex ",[18,2179,849],{},"), command substitution (",[18,2182,1208],{},"), process substitution (",[18,2185,1375],{},"), brace expansion (",[18,2188,1451],{},", ",[18,2191,1455],{},"), tilde (",[18,2194,423],{},"), and globs (",[18,2197,390],{},[18,2199,2200],{},"?",[18,2202,2203],{},"[0-9]",[18,2205,374],{},[18,2207,2208],{},"globstar",") — with the ",[18,2211,2212],{},"[[","-over-",[18,2215,1911],{}," and empty-variable trap internalized. Next: control flow.",[2218,2219,2220],"style",{},"html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shi