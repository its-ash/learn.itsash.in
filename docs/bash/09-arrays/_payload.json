43,1444,1445,1465,1483,1506,1529],"ul",{},[1446,1447,1448,1451,1452,1454,1455,1457,1458,1460,1461,1464],"li",{},[444,1449,1450],{},"Idiom",": use ",[33,1453,449],{}," (quoted) to expand\u002Fiterate array elements — it preserves each element as a separate item, even with spaces. ",[33,1456,457],{}," joins into one string; unquoted ",[33,1459,453],{}," word-splits. Always quote ",[33,1462,1463],{},"[@]",".",[1446,1466,1467,1451,1469,1472,1473,1475,1476,1479,1480,1482],{},[444,1468,1450],{},[33,1470,1471],{},"mapfile -t lines \u003C file"," (Bash 4+) to read a file into an array — each line is an element, ",[33,1474,1178],{}," strips the newline. Cleaner than ",[33,1477,1478],{},"while read"," for loading all lines. Use ",[33,1481,1478],{}," for streaming (large files).",[1446,1484,1485,1451,1487,1490,1491,1494,1495,1498,1499,1501,1502,1505],{},[444,1486,1450],{},[33,1488,1489],{},"declare -A"," (Bash 4+) for key-value data — ",[33,1492,1493],{},"declare -A ages; ages[Alice]=30",". ",[33,1496,1497],{},"${!arr[@]}"," gets keys, ",[33,1500,453],{}," gets values, ",[33,1503,1504],{},"[[ -v arr[key] ]]"," checks existence. Avoids parallel indexed arrays.",[1446,1507,1508,1451,1510,1513,1514,1517,1518,1521,1522,1525,1526,1464],{},[444,1509,1450],{},[33,1511,1512],{},"IFS=',' read -ra arr \u003C\u003C\u003C \"$str\""," to split a string into an array — ",[33,1515,1516],{},"IFS=','"," sets the delimiter, ",[33,1519,1520],{},"-a"," reads into an array, ",[33,1523,1524],{},"\u003C\u003C\u003C"," provides the string. Cleaner than ",[33,1527,1528],{},"tr ... read",[1446,1530,1531,1451,1533,1536,1537,1540],{},[444,1532,1450],{},[33,1534,1535],{},"unset 'arr[i]'"," (quoted) to remove an element — the quotes prevent globbing if the index is a pattern. Note: this leaves a gap (the array isn't reindexed). Use ",[33,1538,1539],{},"arr=(\"${arr[@]}\")"," to reindex if needed.",[18,1542,1544],{"id":1543},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1443,1546,1547,1566,1580,1601,1613,1629,1646,1659,1680,1702],{},[1446,1548,1549,1556,1557,1559,1560,1563,1564,1464],{},[444,1550,1551,1553,1554],{},[33,1552,449],{}," vs ",[33,1555,457],{},": ",[33,1558,1463],{}," (quoted) preserves each element as a separate arg (use for iteration\u002Fpassing); ",[33,1561,1562],{},"[*]"," (quoted) joins into one string (IFS-joined). Without quotes, both word-split. Always use ",[33,1565,449],{},[1446,1567,1568,1573,1574,1577,1578,1464],{},[444,1569,1570,1572],{},[33,1571,1535],{}," leaves a gap",": the array isn't reindexed. ",[33,1575,1576],{},"${#arr[@]}"," (count) excludes the gap, but indices aren't contiguous. Reindex: ",[33,1579,1539],{},[1446,1581,1582,1588,1589,1592,1593,1596,1597,1600],{},[444,1583,1584,1587],{},[33,1585,1586],{},"\"${arr[@]: -1}\""," (last element)",": note the space before ",[33,1590,1591],{},"-1"," (Bash parses ",[33,1594,1595],{},"${arr[@]:-1}"," as a default expansion). Or use ",[33,1598,1599],{},"${arr[-1]}"," (Bash 4.3+).",[1446,1602,1603,1556,1606,1608,1609,1612],{},[444,1604,1605],{},"Associative arrays need Bash 4+",[33,1607,1489],{}," doesn't work in Bash 3.2 (macOS default). Install Bash 5 (",[33,1610,1611],{},"brew install bash",") or use parallel indexed arrays.",[1446,1614,1615,1620,1621,1624,1625,1628],{},[444,1616,1617,1619],{},[33,1618,1504],{}," checks existence (Bash 4.2+)",": for associative arrays, ",[33,1622,1623],{},"[[ -v ages[Alice] ]]"," is true if the key exists (even if the value is empty). ",[33,1626,1627],{},"[[ -n \"${ages[Alice]}\" ]]"," is false for an empty value.",[1446,1630,1631,1634,1635,861,1638,1641,1642,1645],{},[444,1632,1633],{},"Arrays aren't nested",": Bash has no 2D arrays. Use a naming convention (",[33,1636,1637],{},"arr_0",[33,1639,1640],{},"arr_1",") or string encoding (",[33,1643,1644],{},"\"a:b:c\"","). Or use a real language for complex data.",[1446,1647,1648,1556,1653,1655,1656,1658],{},[444,1649,1650,1652],{},[33,1651,1174],{}," strips newlines",[33,1654,1178],{}," removes the trailing newline from each line. Without ",[33,1657,1178],{},", lines include the newline (usually not wanted).",[1446,1660,1661,1556,1666,1669,1670,1672,1673,1676,1677,1464],{},[444,1662,1663,1665],{},[33,1664,881],{}," in a pipeline runs in a subshell",[33,1667,1668],{},"echo \"a b c\" | read -a arr"," — ",[33,1671,1339],{}," is set in the subshell, lost after. Use ",[33,1674,1675],{},"read -a arr \u003C\u003C\u003C \"a b c\""," (here-string) or ",[33,1678,1679],{},"echo \"a b c\" | { read -a arr; echo \"${arr[@]}\"; }",[1446,1681,1682,1556,1692,1694,1695,1697,1698,1701],{},[444,1683,1684,1687,1688,1691],{},[33,1685,1686],{},"arr+=(\"x\")"," appends; ",[33,1689,1690],{},"arr+=\"x\""," doesn't do what you think",[33,1693,1686],{}," appends an element; ",[33,1696,1690],{}," (string +=) appends to the first element (Bash quirk). Use ",[33,1699,1700],{},"+=(\"x\")"," for appending.",[1446,1703,1704,1709,1710,1713,1714,1494,1716,1719,1720,1464],{},[444,1705,1706,1707],{},"Quoting ",[33,1708,1535],{},": the quotes prevent globbing if ",[33,1711,1712],{},"i"," is a pattern like ",[33,1715,132],{},[33,1717,1718],{},"unset arr[*]"," might glob-expand. Always quote: ",[33,1721,1535],{},[18,1723,1725],{"id":1724},"spot-the-bug","🧠 Spot the Bug",[14,1727,1728],{},"A developer iterates an array of filenames, but files with spaces are split:",[23,1730,1731],{"language":25},[27,1732,1734],{"className":29,"code":1733,"language":25,"meta":31,"style":31},"files=(\"my file.txt\" \"other file.txt\" \"third.txt\")\nfor file in $files; do\n    echo \"Processing $file\"\ndone\n",[33,1735,1736,1755,1768,1779],{"__ignoreMap":31},[36,1737,1738,1740,1742,1744,1747,1750,1753],{"class":38,"line":39},[36,1739,1144],{"class":42},[36,1741,47],{"class":46},[36,1743,50],{"class":42},[36,1745,1746],{"class":53},"\"my file.txt\"",[36,1748,1749],{"class":53}," \"other file.txt\"",[36,1751,1752],{"class":53}," \"third.txt\"",[36,1754,63],{"class":42},[36,1756,1757,1759,1761,1763,1766],{"class":38,"line":66},[36,1758,339],{"class":46},[36,1760,1137],{"class":42},[36,1762,345],{"class":46},[36,1764,1765],{"class":42}," $files; ",[36,1767,361],{"class":46},[36,1769,1770,1772,1775,1777],{"class":38,"line":85},[36,1771,366],{"class":69},[36,1773,1774],{"class":53}," \"Processing ",[36,1776,1163],{"class":42},[36,1778,375],{"class":53},[36,1780,1781],{"class":38,"line":100},[36,1782,380],{"class":46},[14,1784,1785],{},"What's wrong?",[1787,1788,1789,1793,1822,1829,1886,1901],"details",{},[1790,1791,1792],"summary",{},"Answer",[14,1794,1795,1798,1799,1802,1803,1807,1808,1811,1812,861,1815,1818,1819,1821],{},[33,1796,1797],{},"for file in $files"," (unquoted ",[33,1800,1801],{},"$files",") expands to only the ",[1804,1805,1806],"em",{},"first"," element (",[33,1809,1810],{},"my file.txt","), and then word-splits it on spaces — so the loop iterates ",[33,1813,1814],{},"my",[33,1816,1817],{},"file.txt"," (two iterations, each a word). The other array elements are ignored (unquoted ",[33,1820,1801],{}," is the first element only, word-split).",[14,1823,1824,1825,1828],{},"The fix — use ",[33,1826,1827],{},"\"${files[@]}\""," (quoted):",[27,1830,1832],{"className":29,"code":1831,"language":25,"meta":31,"style":31},"files=(\"my file.txt\" \"other file.txt\" \"third.txt\")\nfor file in \"${files[@]}\"; do\n    echo \"Processing $file\"\ndone\n",[33,1833,1834,1850,1872,1882],{"__ignoreMap":31},[36,1835,1836,1838,1840,1842,1844,1846,1848],{"class":38,"line":39},[36,1837,1144],{"class":42},[36,1839,47],{"class":46},[36,1841,50],{"class":42},[36,1843,1746],{"class":53},[36,1845,1749],{"class":53},[36,1847,1752],{"class":53},[36,1849,63],{"class":42},[36,1851,1852,1854,1856,1858,1860,1862,1864,1866,1868,1870],{"class":38,"line":66},[36,1853,339],{"class":46},[36,1855,1137],{"class":42},[36,1857,345],{"class":46},[36,1859,73],{"class":53},[36,1861,1144],{"class":42},[36,1863,109],{"class":53},[36,1865,112],{"class":46},[36,1867,115],{"class":53},[36,1869,358],{"class":42},[36,1871,361],{"class":46},[36,1873,1874,1876,1878,1880],{"class":38,"line":85},[36,1875,366],{"class":69},[36,1877,1774],{"class":53},[36,1879,1163],{"class":42},[36,1881,375],{"class":53},[36,1883,1884],{"class":38,"line":100},[36,1885,380],{"class":46},[14,1887,1888,1889,1891,1892,861,1894,861,1897,1900],{},"::\n",[33,1890,1827],{}," expands to all elements, each as a separate item (preserving spaces). The loop iterates ",[33,1893,1810],{},[33,1895,1896],{},"other file.txt",[33,1898,1899],{},"third.txt"," (three iterations, each a full filename).",[14,1902,1903,1556,1906,1909,1910,1913,1914,1916],{},[444,1904,1905],{},"The lesson",[33,1907,1908],{},"for x in $arr"," (unquoted) is wrong — it expands only the first element and word-splits it. Always use ",[33,1911,1912],{},"for x in \"${arr[@]}\""," (quoted ",[33,1915,1463],{},") to iterate all elements, each preserved as a separate item (even with spaces).",[18,1918,1919],{"id":1790},"Summary",[14,1921,1922,1923,1925,1926,1929,1930,1932,1933,861,1935,1937,1938,1940,1941,1943,1944,1946,1947,1949,1950,1952],{},"You can use indexed arrays (create, access, append, unset, iterate with ",[33,1924,449],{},", slice ",[33,1927,1928],{},"${arr[@]:1:2}","), associative arrays (",[33,1931,1489],{},", keys ",[33,1934,1497],{},[33,1936,1504],{},"), ",[33,1939,881],{}," (split into array), ",[33,1942,1174],{}," (read file into array), and convert between strings and arrays (",[33,1945,1512],{},") — with the always-quote-",[33,1948,1463],{}," and ",[33,1951,240],{},"-leaves-gap traps internalized. Next: string manipulation.",[1954,1955,1956],"style",{},"html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github