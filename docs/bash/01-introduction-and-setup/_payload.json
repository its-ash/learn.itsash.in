[{"data":1,"prerenderedAt":1165},["ShallowReactive",2],{"page-\u002Fbash\u002F01-introduction-and-setup":3},{"id":4,"title":5,"body":6,"description":16,"extension":1159,"meta":1160,"navigation":399,"path":1161,"seo":1162,"stem":1163,"__hash__":1164},"content\u002Fbash\u002F01-introduction-and-setup.md","01 — Introduction & Setup",{"type":7,"value":8,"toc":1137},"minimark",[9,13,17,22,69,73,99,103,110,142,147,177,180,194,202,227,230,255,264,311,330,334,337,351,369,373,458,484,487,511,515,537,543,547,587,591,600,633,635,648,655,659,669,683,687,690,700,704,800,804,984,988,991,1010,1013,1112,1115,1133],[10,11,5],"h1",{"id":12},"_01-introduction-setup",[14,15,16],"p",{},"Bash (Bourne Again Shell) is the standard shell on most Linux and macOS systems. It's both a command interpreter (interactive) and a scripting language (automating tasks).",[18,19,21],"h2",{"id":20},"why-bash","Why Bash?",[23,24,25,33,39,63],"ul",{},[26,27,28,32],"li",{},[29,30,31],"strong",{},"Everywhere"," — pre-installed on Linux, macOS, and WSL on Windows.",[26,34,35,38],{},[29,36,37],{},"Automation"," — glue commands, scripts, cron jobs, CI\u002FCD.",[26,40,41,44,45,49,50,49,53,49,56,49,59,62],{},[29,42,43],{},"Pipelines"," — combine small tools (",[46,47,48],"code",{},"grep",", ",[46,51,52],{},"sed",[46,54,55],{},"awk",[46,57,58],{},"sort",[46,60,61],{},"uniq",") into powerful pipelines.",[26,64,65,68],{},[29,66,67],{},"System administration"," — manage files, processes, services.",[18,70,72],{"id":71},"the-terminal-vs-scripts","The Terminal vs Scripts",[23,74,75,81],{},[26,76,77,80],{},[29,78,79],{},"Interactive"," — type commands in the terminal, get immediate output.",[26,82,83,86,87,90,91,94,95,98],{},[29,84,85],{},"Script"," — a file (",[46,88,89],{},".sh",") with a sequence of commands, run with ",[46,92,93],{},"bash script.sh"," or ",[46,96,97],{},".\u002Fscript.sh",".",[18,100,102],{"id":101},"your-first-script","Your First Script",[14,104,105,106,109],{},"Create ",[46,107,108],{},"hello.sh",":",[111,112,114],"code-wrapper",{"language":113},"bash",[115,116,120],"pre",{"className":117,"code":118,"language":113,"meta":119,"style":119},"language-bash shiki shiki-themes github-light github-dark","#!\u002Fusr\u002Fbin\u002Fenv bash\necho \"Hello, Bash!\"\n","",[46,121,122,131],{"__ignoreMap":119},[123,124,127],"span",{"class":125,"line":126},"line",1,[123,128,130],{"class":129},"sdCPZ","#!\u002Fusr\u002Fbin\u002Fenv bash\n",[123,132,134,138],{"class":125,"line":133},2,[123,135,137],{"class":136},"snvgF","echo",[123,139,141],{"class":140},"sJ6F3"," \"Hello, Bash!\"\n",[143,144,146],"h3",{"id":145},"run-it","Run it",[111,148,149],{"language":113},[115,150,152],{"className":117,"code":151,"language":113,"meta":119,"style":119},"chmod +x hello.sh   # make executable\n.\u002Fhello.sh          # run\n",[46,153,154,169],{"__ignoreMap":119},[123,155,156,160,163,166],{"class":125,"line":126},[123,157,159],{"class":158},"sIsaT","chmod",[123,161,162],{"class":140}," +x",[123,164,165],{"class":140}," hello.sh",[123,167,168],{"class":129},"   # make executable\n",[123,170,171,174],{"class":125,"line":133},[123,172,173],{"class":158},".\u002Fhello.sh",[123,175,176],{"class":129},"          # run\n",[14,178,179],{},"Or without making it executable:",[111,181,182],{"language":113},[115,183,185],{"className":117,"code":184,"language":113,"meta":119,"style":119},"bash hello.sh\n",[46,186,187],{"__ignoreMap":119},[123,188,189,191],{"class":125,"line":126},[123,190,113],{"class":158},[123,192,193],{"class":140}," hello.sh\n",[18,195,197,198,201],{"id":196},"the-shebang","The Shebang (",[46,199,200],{},"#!",")",[14,203,204,205,208,209,212,213,215,216,219,220,222,223,226],{},"The first line ",[46,206,207],{},"#!\u002Fusr\u002Fbin\u002Fenv bash"," is the ",[29,210,211],{},"shebang"," — it tells the system which interpreter to use. ",[46,214,207],{}," is preferred over ",[46,217,218],{},"#!\u002Fbin\u002Fbash"," (finds ",[46,221,113],{}," via the ",[46,224,225],{},"PATH",", more portable).",[14,228,229],{},"Common shebangs:",[23,231,232,237,243,249],{},[26,233,234,236],{},[46,235,207],{}," — Bash script.",[26,238,239,242],{},[46,240,241],{},"#!\u002Fusr\u002Fbin\u002Fenv sh"," — POSIX shell (more portable, fewer features).",[26,244,245,248],{},[46,246,247],{},"#!\u002Fusr\u002Fbin\u002Fenv python3"," — Python script.",[26,250,251,254],{},[46,252,253],{},"#!\u002Fusr\u002Fbin\u002Fenv node"," — Node.js script.",[18,256,258,260,261],{"id":257},"echo-and-printf",[46,259,137],{}," and ",[46,262,263],{},"printf",[111,265,266],{"language":113},[115,267,269],{"className":117,"code":268,"language":113,"meta":119,"style":119},"echo \"Hello\"           # Hello (with newline)\necho -n \"No newline\"   # no trailing newline\nprintf \"%s is %d\\n\" \"Alice\" 30   # formatted (like C printf)\n",[46,270,271,281,294],{"__ignoreMap":119},[123,272,273,275,278],{"class":125,"line":126},[123,274,137],{"class":136},[123,276,277],{"class":140}," \"Hello\"",[123,279,280],{"class":129},"           # Hello (with newline)\n",[123,282,283,285,288,291],{"class":125,"line":133},[123,284,137],{"class":136},[123,286,287],{"class":136}," -n",[123,289,290],{"class":140}," \"No newline\"",[123,292,293],{"class":129},"   # no trailing newline\n",[123,295,297,299,302,305,308],{"class":125,"line":296},3,[123,298,263],{"class":136},[123,300,301],{"class":140}," \"%s is %d\\n\"",[123,303,304],{"class":140}," \"Alice\"",[123,306,307],{"class":136}," 30",[123,309,310],{"class":129},"   # formatted (like C printf)\n",[14,312,313,315,316,318,319,322,323,326,327,329],{},[46,314,263],{}," is more portable and supports formatting. ",[46,317,137],{}," behavior varies between shells (especially with ",[46,320,321],{},"-e","\u002F",[46,324,325],{},"-n","); ",[46,328,263],{}," is consistent.",[18,331,333],{"id":332},"which-bash","Which Bash?",[14,335,336],{},"Check your Bash version:",[111,338,339],{"language":113},[115,340,342],{"className":117,"code":341,"language":113,"meta":119,"style":119},"bash --version\n",[46,343,344],{"__ignoreMap":119},[123,345,346,348],{"class":125,"line":126},[123,347,113],{"class":158},[123,349,350],{"class":136}," --version\n",[14,352,353,354,357,358,361,362,365,366,98],{},"Bash 4.0+ (2009) added associative arrays, ",[46,355,356],{},"coproc",", etc. Bash 5.0+ (2019) added ",[46,359,360],{},"--"," handling, ",[46,363,364],{},"${var@operator}",". macOS ships Bash 3.2 (due to licensing — GPLv3). On macOS, install Bash 5 via Homebrew: ",[46,367,368],{},"brew install bash",[18,370,372],{"id":371},"a-slightly-bigger-script","A Slightly Bigger Script",[111,374,375],{"language":113},[115,376,378],{"className":117,"code":377,"language":113,"meta":119,"style":119},"#!\u002Fusr\u002Fbin\u002Fenv bash\nset -euo pipefail\n\nname=\"${1:-World}\"\necho \"Hello, $name!\"\necho \"Today is $(date +%A)\"\n",[46,379,380,384,395,401,430,444],{"__ignoreMap":119},[123,381,382],{"class":125,"line":126},[123,383,130],{"class":129},[123,385,386,389,392],{"class":125,"line":133},[123,387,388],{"class":136},"set",[123,390,391],{"class":136}," -euo",[123,393,394],{"class":140}," pipefail\n",[123,396,397],{"class":125,"line":296},[123,398,400],{"emptyLinePlaceholder":399},true,"\n",[123,402,404,408,412,415,418,421,424,427],{"class":125,"line":403},4,[123,405,407],{"class":406},"ssxIu","name",[123,409,411],{"class":410},"svdQ7","=",[123,413,414],{"class":140},"\"",[123,416,417],{"class":136},"${1",[123,419,420],{"class":410},":-",[123,422,423],{"class":406},"World",[123,425,426],{"class":136},"}",[123,428,429],{"class":140},"\"\n",[123,431,433,435,438,441],{"class":125,"line":432},5,[123,434,137],{"class":136},[123,436,437],{"class":140}," \"Hello, ",[123,439,440],{"class":406},"$name",[123,442,443],{"class":140},"!\"\n",[123,445,447,449,452,455],{"class":125,"line":446},6,[123,448,137],{"class":136},[123,450,451],{"class":140}," \"Today is $(",[123,453,454],{"class":158},"date",[123,456,457],{"class":140}," +%A)\"\n",[23,459,460,466,475],{},[26,461,462,465],{},[46,463,464],{},"set -euo pipefail"," — enable strict mode (chapter 18).",[26,467,468,471,472,474],{},[46,469,470],{},"\"${1:-World}\""," — the first argument, defaulting to ",[46,473,423],{}," if not provided.",[26,476,477,480,481,483],{},[46,478,479],{},"$(date +%A)"," — command substitution (runs ",[46,482,454],{},", inserts output).",[14,485,486],{},"Run it:",[111,488,489],{"language":113},[115,490,492],{"className":117,"code":491,"language":113,"meta":119,"style":119},".\u002Fhello.sh Alice\n# Hello, Alice!\n# Today is Monday\n",[46,493,494,501,506],{"__ignoreMap":119},[123,495,496,498],{"class":125,"line":126},[123,497,173],{"class":158},[123,499,500],{"class":140}," Alice\n",[123,502,503],{"class":125,"line":133},[123,504,505],{"class":129},"# Hello, Alice!\n",[123,507,508],{"class":125,"line":296},[123,509,510],{"class":129},"# Today is Monday\n",[18,512,514],{"id":513},"comments","Comments",[111,516,517],{"language":113},[115,518,520],{"className":117,"code":519,"language":113,"meta":119,"style":119},"# This is a comment\necho \"hi\"   # inline comment\n",[46,521,522,527],{"__ignoreMap":119},[123,523,524],{"class":125,"line":126},[123,525,526],{"class":129},"# This is a comment\n",[123,528,529,531,534],{"class":125,"line":133},[123,530,137],{"class":136},[123,532,533],{"class":140}," \"hi\"",[123,535,536],{"class":129},"   # inline comment\n",[14,538,539,542],{},[46,540,541],{},"#"," starts a comment (to the end of the line). There are no block comments in Bash.",[18,544,546],{"id":545},"getting-help","Getting Help",[23,548,549,555,568,581],{},[26,550,551,554],{},[46,552,553],{},"man bash"," — the Bash manual (long but comprehensive).",[26,556,557,560,561,49,564,567],{},[46,558,559],{},"man \u003Ccommand>"," — a command's manual (",[46,562,563],{},"man grep",[46,565,566],{},"man sed",").",[26,569,570,573,574,577,578,98],{},[46,571,572],{},"tldr \u003Ccommand>"," — concise examples (",[46,575,576],{},"tldr grep","), install via ",[46,579,580],{},"npm install -g tldr",[26,582,583,586],{},[46,584,585],{},"command --help"," — brief help for most commands.",[18,588,590],{"id":589},"shellcheck","ShellCheck",[14,592,593,599],{},[594,595,590],"a",{"href":596,"rel":597},"https:\u002F\u002Fwww.shellcheck.net",[598],"nofollow"," is a linter for Bash — catches common bugs and suggests improvements. Install it:",[111,601,602],{"language":113},[115,603,605],{"className":117,"code":604,"language":113,"meta":119,"style":119},"brew install shellcheck           # macOS\napt install shellcheck            # Debian\u002FUbuntu\n",[46,606,607,621],{"__ignoreMap":119},[123,608,609,612,615,618],{"class":125,"line":126},[123,610,611],{"class":158},"brew",[123,613,614],{"class":140}," install",[123,616,617],{"class":140}," shellcheck",[123,619,620],{"class":129},"           # macOS\n",[123,622,623,626,628,630],{"class":125,"line":133},[123,624,625],{"class":158},"apt",[123,627,614],{"class":140},[123,629,617],{"class":140},[123,631,632],{"class":129},"            # Debian\u002FUbuntu\n",[14,634,486],{},[111,636,637],{"language":113},[115,638,640],{"className":117,"code":639,"language":113,"meta":119,"style":119},"shellcheck hello.sh\n",[46,641,642],{"__ignoreMap":119},[123,643,644,646],{"class":125,"line":126},[123,645,589],{"class":158},[123,647,193],{"class":140},[14,649,650,651,654],{},"Use it on every script — it catches quoting issues, ",[46,652,653],{},"set -e"," gaps, unquoted variables, and many footguns. VS Code has a ShellCheck extension.",[18,656,658],{"id":657},"vs-code","VS Code",[14,660,661,662,665,666,668],{},"Install the ",[29,663,664],{},"Shell Script"," extension (built-in) and ",[29,667,589],{}," (timonwong.shellcheck). They provide:",[23,670,671,674,677,680],{},[26,672,673],{},"Syntax highlighting.",[26,675,676],{},"Linting (ShellCheck).",[26,678,679],{},"Snippets.",[26,681,682],{},"\"ShellCheck: Fix all\" for auto-fixes.",[18,684,686],{"id":685},"project-structure","Project Structure",[14,688,689],{},"Bash scripts are usually standalone files, but for a larger project:",[111,691,693],{"language":692},"text",[115,694,698],{"className":695,"code":697,"language":692,"meta":119},[696],"language-text","my_project\u002F\n├── bin\u002F\n│   └── my_script.sh        # main entry point\n├── lib\u002F\n│   └── utils.sh            # sourced library\n├── test\u002F\n│   └── test_utils.sh       # tests (using bats, etc.)\n├── README.md\n",[46,699,697],{"__ignoreMap":119},[18,701,703],{"id":702},"tips-tricks","💡 Tips & Tricks",[23,705,706,721,729,753,777],{},[26,707,708,711,712,714,715,717,718,720],{},[29,709,710],{},"Idiom",": always start scripts with ",[46,713,207],{}," (shebang) and ",[46,716,464],{}," (strict mode) — the shebang makes it executable directly (",[46,719,97],{},"), strict mode catches errors early (exit on error, error on undefined var, fail on pipe failure). See chapter 18.",[26,722,723,725,726,728],{},[29,724,710],{},": use ShellCheck on every script — it catches quoting issues, unquoted variables, ",[46,727,653],{}," gaps, and many common Bash footguns. Install the VS Code extension for real-time linting.",[26,730,731,733,734,736,737,739,740,743,744,746,747,749,750,752],{},[29,732,710],{},": use ",[46,735,207],{}," (not ",[46,738,218],{},") — ",[46,741,742],{},"env"," finds ",[46,745,113],{}," via ",[46,748,225],{},", more portable across systems where Bash is in different locations. ",[46,751,218],{}," assumes a specific path.",[26,754,755,733,757,759,760,762,763,766,767,769,770,322,772,774,775,329],{},[29,756,710],{},[46,758,263],{}," over ",[46,761,137],{}," for formatting and portability — ",[46,764,765],{},"printf \"%s is %d\\n\" \"Alice\" 30"," formats reliably. ",[46,768,137],{},"'s behavior with ",[46,771,321],{},[46,773,325],{}," varies between shells; ",[46,776,263],{},[26,778,779,733,781,260,783,785,786,789,790,793,794,796,797,799],{},[29,780,710],{},[46,782,559],{},[46,784,572],{}," for reference — ",[46,787,788],{},"man"," is comprehensive, ",[46,791,792],{},"tldr"," is concise examples. Install ",[46,795,792],{}," (",[46,798,580],{},") for quick lookups.",[18,801,803],{"id":802},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[23,805,806,826,850,869,887,903,924,946],{},[26,807,808,811,812,815,816,819,820,822,823,825],{},[29,809,810],{},"macOS ships Bash 3.2",": due to GPLv3 licensing, macOS's default ",[46,813,814],{},"\u002Fbin\u002Fbash"," is 3.2 (2007). No associative arrays, no ",[46,817,818],{},"mapfile",", etc. Install Bash 5 via ",[46,821,368],{},", use ",[46,824,207],{}," to find it.",[26,827,828,834,835,49,838,840,841,843,844,846,847,849],{},[29,829,830,833],{},[46,831,832],{},"echo -e"," is not portable",": in POSIX ",[46,836,837],{},"sh",[46,839,832],{}," prints ",[46,842,321],{}," literally. Use ",[46,845,263],{}," for escape sequences. ",[46,848,832],{}," works in Bash but not all shells.",[26,851,852,859,860,862,863,865,866,868],{},[29,853,854,856,857],{},[46,855,97],{}," vs ",[46,858,93],{},": ",[46,861,97],{}," uses the shebang's interpreter (and needs execute permission). ",[46,864,93],{}," explicitly uses ",[46,867,113],{}," (no execute permission needed, shebang ignored).",[26,870,871,859,874,876,877,880,881,883,884,886],{},[29,872,873],{},"Execute permission",[46,875,97],{}," needs ",[46,878,879],{},"chmod +x",". ",[46,882,93],{}," doesn't. For scripts you run often, ",[46,885,879],{}," once.",[26,888,889,859,892,895,896,899,900,98],{},[29,890,891],{},"Spaces in filenames",[46,893,894],{},"\"my file.txt\""," (quoted) works; ",[46,897,898],{},"my file.txt"," (unquoted) is two args. Always quote variables: ",[46,901,902],{},"\"$file\"",[26,904,905,908,909,912,913,916,917,739,920,923],{},[29,906,907],{},"CRLF line endings break scripts",": Windows line endings (",[46,910,911],{},"\\r\\n",") cause ",[46,914,915],{},"bash: .\u002Fscript.sh: \u002Fusr\u002Fbin\u002Fenv: bad interpreter: No such file or directory",". Use LF (",[46,918,919],{},"\\n",[46,921,922],{},"dos2unix script.sh"," or configure your editor.",[26,925,926,931,932,322,935,322,938,941,942,945],{},[29,927,928,930],{},[46,929,653],{}," doesn't catch everything",": commands in ",[46,933,934],{},"if",[46,936,937],{},"&&",[46,939,940],{},"||"," conditions don't trigger exit. Pipes fail only with ",[46,943,944],{},"set -o pipefail",". See chapter 18.",[26,947,948,859,962,876,965,968,969,971,972,975,976,979,980,983],{},[29,949,950,953,954,957,958,961],{},[46,951,952],{},"$0"," is the script name, ",[46,955,956],{},"$1","…",[46,959,960],{},"$9"," are args",[46,963,964],{},"$10",[46,966,967],{},"${10}"," (or it's ",[46,970,956],{}," followed by ",[46,973,974],{},"0","). ",[46,977,978],{},"$@"," is all args, ",[46,981,982],{},"$#"," is the count.",[18,985,987],{"id":986},"spot-the-bug","🧠 Spot the Bug",[14,989,990],{},"A developer writes a script, but the shebang line causes an error:",[111,992,993],{"language":113},[115,994,996],{"className":117,"code":995,"language":113,"meta":119,"style":119},"#! \u002Fusr\u002Fbin\u002Fenv bash\necho \"Hello\"\n",[46,997,998,1003],{"__ignoreMap":119},[123,999,1000],{"class":125,"line":126},[123,1001,1002],{"class":129},"#! \u002Fusr\u002Fbin\u002Fenv bash\n",[123,1004,1005,1007],{"class":125,"line":133},[123,1006,137],{"class":136},[123,1008,1009],{"class":140}," \"Hello\"\n",[14,1011,1012],{},"What's wrong?",[1014,1015,1016,1020,1030,1062,1068,1098,1101],"details",{},[1017,1018,1019],"summary",{},"Answer",[14,1021,1022,1023,1026,1027,1029],{},"Actually, ",[46,1024,1025],{},"#! \u002Fusr\u002Fbin\u002Fenv bash"," (with a space after ",[46,1028,200],{},") works on most systems — the space is allowed. So this isn't the bug.",[14,1031,1032,1033,859,1036,1038,1039,1042,1043,1046,1047,1050,1051,1054,1055,1058,1059,98],{},"The common shebang bug is a ",[29,1034,1035],{},"typo or wrong path",[46,1037,218],{}," on a system where Bash is in ",[46,1040,1041],{},"\u002Fusr\u002Fbin\u002Fbash"," (or vice versa). Or ",[46,1044,1045],{},"#!\u002Fusr\u002Fbin\u002Fenv bashx"," (typo). Or ",[29,1048,1049],{},"CRLF line endings"," (Windows), which make the shebang ",[46,1052,1053],{},"#!\u002Fusr\u002Fbin\u002Fenv bash\\r"," — the ",[46,1056,1057],{},"\\r"," becomes part of the interpreter name, and the system can't find ",[46,1060,1061],{},"bash\\r",[14,1063,1064,1065,1067],{},"If the error is ",[46,1066,915],{},", the cause is almost always CRLF line endings. Fix with:",[115,1069,1071],{"className":117,"code":1070,"language":113,"meta":119,"style":119},"dos2unix script.sh\n# or\nsed -i 's\u002F\\r$\u002F\u002F' script.sh\n",[46,1072,1073,1081,1086],{"__ignoreMap":119},[123,1074,1075,1078],{"class":125,"line":126},[123,1076,1077],{"class":158},"dos2unix",[123,1079,1080],{"class":140}," script.sh\n",[123,1082,1083],{"class":125,"line":133},[123,1084,1085],{"class":129},"# or\n",[123,1087,1088,1090,1093,1096],{"class":125,"line":296},[123,1089,52],{"class":158},[123,1091,1092],{"class":136}," -i",[123,1094,1095],{"class":140}," 's\u002F\\r$\u002F\u002F'",[123,1097,1080],{"class":140},[14,1099,1100],{},"::\nConfigure your editor (VS Code: bottom-right \"CRLF\" → \"LF\") to use LF for Bash scripts.",[14,1102,1103,1106,1107,1109,1110,98],{},[29,1104,1105],{},"The lesson",": shebang errors are usually (1) wrong interpreter path (use ",[46,1108,207],{}," for portability), (2) typos, or (3) CRLF line endings (Windows). Use LF line endings and ",[46,1111,207],{},[18,1113,1114],{"id":1017},"Summary",[14,1116,1117,1118,1120,1121,322,1123,1125,1126,1129,1130,1132],{},"You installed\u002Fverified Bash, wrote and ran a script (shebang, ",[46,1119,879],{},"), used ",[46,1122,137],{},[46,1124,263],{},", comments, and command substitution (",[46,1127,1128],{},"$(...)","). You know about Bash versions (macOS 3.2), ShellCheck (the linter), and the project structure — with the CRLF and ",[46,1131,832],{}," portability traps noted. Next: variables and data types.",[1134,1135,1136],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}",{"title":119,"searchDepth":133,"depth":133,"links":1138},[1139,1140,1141,1144,1146,1148,1149,1150,1151,1152,1153,1154,1155,1156,1157,1158],{"id":20,"depth":133,"text":21},{"id":71,"depth":133,"text":72},{"id":101,"depth":133,"text":102,"children":1142},[1143],{"id":145,"depth":296,"text":146},{"id":196,"depth":133,"text":1145},"The Shebang (#!)",{"id":257,"depth":133,"text":1147},"echo and printf",{"id":332,"depth":133,"text":333},{"id":371,"depth":133,"text":37