 silently. Use ",[38,953,954],{},"checked_*",[38,956,957],{},"wrapping_*"," or ",[38,960,961],{},"saturating_*"," when it matters.",[892,964,965,967,968,971],{},[18,966,950],{}," — if both values are constants, overflow is a ",[18,969,970],{},"compile error",", not a panic.",[892,973,974,897,977,979],{},[18,975,976],{},"Assertions",[38,978,684],{}," does nothing in release builds.",[892,981,982,897,985,988,989,992,993,996],{},[18,983,984],{},"Portability",[38,986,987],{},"usize"," is 64-bit on most PCs but 32-bit on ",[38,990,991],{},"wasm32",". ",[38,994,995],{},"usize::MAX"," differs per target.",[892,998,999,1002,1003,502],{},[18,1000,1001],{},"Cache"," — after a toolchain upgrade, strange build errors are often fixed by ",[38,1004,1005],{},"cargo clean",[23,1007,1009],{"id":1008},"spot-the-bug","🧠 Spot the Bug",[14,1011,1012,1013,1016,1017,1020],{},"CI runs ",[38,1014,1015],{},"cargo test",", then ships ",[38,1018,1019],{},"cargo build --release",". Tests pass, but production shows wrong totals. Why?",[28,1022,1023],{"language":141},[32,1024,1026],{"className":145,"code":1025,"language":141,"meta":36,"style":36},"fn add_points(total: u32, delta: u32) -> u32 {\n    total + delta\n}\n",[38,1027,1028,1061,1071],{"__ignoreMap":36},[41,1029,1030,1032,1035,1038,1040,1043,1046,1048,1050,1053,1056,1058],{"class":43,"line":44},[41,1031,153],{"class":68},[41,1033,1034],{"class":47}," add_points",[41,1036,1037],{"class":159},"(total",[41,1039,385],{"class":68},[41,1041,1042],{"class":47}," u32",[41,1044,1045],{"class":159},", delta",[41,1047,385],{"class":68},[41,1049,1042],{"class":47},[41,1051,1052],{"class":159},") ",[41,1054,1055],{"class":68},"->",[41,1057,1042],{"class":47},[41,1059,1060],{"class":159}," {\n",[41,1062,1063,1066,1068],{"class":43,"line":75},[41,1064,1065],{"class":159},"    total ",[41,1067,412],{"class":68},[41,1069,1070],{"class":159}," delta\n",[41,1072,1073],{"class":43,"line":82},[41,1074,319],{"class":159},[1076,1077,1078,1082,1099,1102,1159],"details",{},[1079,1080,1081],"summary",{},"Answer",[14,1083,1084,1086,1087,1090,1091,1094,1095,1098],{},[38,1085,1015],{}," uses the ",[18,1088,1089],{},"debug"," profile, where overflow panics. The shipped binary uses ",[18,1092,1093],{},"release",", where ",[38,1096,1097],{},"total + delta"," silently wraps to a small number. The tests never ran the code the way production runs it.",[14,1100,1101],{},"Fix: make the behavior explicit so it is the same in every profile:",[28,1103,1104],{"language":141},[32,1105,1107],{"className":145,"code":1106,"language":141,"meta":36,"style":36},"fn add_points(total: u32, delta: u32) -> Option\u003Cu32> {\n    total.checked_add(delta)\n}\n",[38,1108,1109,1143,1155],{"__ignoreMap":36},[41,1110,1111,1113,1115,1117,1119,1121,1123,1125,1127,1129,1131,1134,1137,1140],{"class":43,"line":44},[41,1112,153],{"class":68},[41,1114,1034],{"class":47},[41,1116,1037],{"class":159},[41,1118,385],{"class":68},[41,1120,1042],{"class":47},[41,1122,1045],{"class":159},[41,1124,385],{"class":68},[41,1126,1042],{"class":47},[41,1128,1052],{"class":159},[41,1130,1055],{"class":68},[41,1132,1133],{"class":47}," Option",[41,1135,1136],{"class":159},"\u003C",[41,1138,1139],{"class":47},"u32",[41,1141,1142],{"class":159},"> {\n",[41,1144,1145,1148,1150,1152],{"class":43,"line":75},[41,1146,1147],{"class":159},"    total",[41,1149,502],{"class":68},[41,1151,640],{"class":47},[41,1153,1154],{"class":159},"(delta)\n",[41,1156,1157],{"class":43,"line":82},[41,1158,319],{"class":159},[14,1160,1161,1162,502],{},"Or test the release profile too: ",[38,1163,1164],{},"cargo test --release",[23,1166,1167],{"id":1079},"Summary",[14,1169,1170,1171,1173],{},"Rust moves safety checks to compile time. Learn the difference between debug and release builds early — overflow and ",[38,1172,684],{}," behave differently in each.",[14,1175,1176],{},"Next: Hello World & Cargo.",[1178,1179,1180],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C