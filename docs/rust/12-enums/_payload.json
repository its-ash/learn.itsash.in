[{"data":1,"prerenderedAt":572},["ShallowReactive",2],{"page-\u002Frust\u002F12-enums":3},{"id":4,"title":5,"body":6,"description":16,"extension":565,"meta":566,"navigation":567,"path":568,"seo":569,"stem":570,"__hash__":571},"content\u002Frust\u002F12-enums.md","12 — Enums (Algebraic Data Types)",{"type":7,"value":8,"toc":539},"minimark",[9,13,17,22,33,41,45,51,79,82,88,95,101,116,122,129,135,138,142,148,151,155,161,168,175,181,198,202,223,229,233,239,250,254,260,270,276,279,283,286,292,309,322,326,329,335,341,345,351,354,358,467,473,479,488,492,495,501,512,516,536],[10,11,5],"h1",{"id":12},"_12-enums-algebraic-data-types",[14,15,16],"p",{},"Enums are Rust's killer feature for modeling domain choices. Each variant can carry data of a different shape — they're algebraic data types (ADTs), more like F# discriminated unions than C enums.",[18,19,21],"h2",{"id":20},"basic-enum","Basic Enum",[23,24,30],"pre",{"className":25,"code":27,"language":28,"meta":29},[26],"language-rust","enum IpAddr {\n    V4(u8, u8, u8, u8),\n    V6(String),\n}\n\nlet v4 = IpAddr::V4(127, 0, 0, 1);\nlet v6 = IpAddr::V6(String::from(\"::1\"));\n","rust","",[31,32,27],"code",{"__ignoreMap":29},[14,34,35,36,40],{},"Each variant is a constructor; the enum value is ",[37,38,39],"em",{},"exactly one"," of them.",[18,42,44],{"id":43},"variants-with-named-fields","Variants with Named Fields",[23,46,49],{"className":47,"code":48,"language":28,"meta":29},[26],"enum Message {\n    Quit,\n    Move { x: i32, y: i32 },\n    Write(String),\n    ChangeColor(i32, i32, i32),\n}\n",[31,50,48],{"__ignoreMap":29},[52,53,54,61,67,73],"ul",{},[55,56,57,60],"li",{},[31,58,59],{},"Quit"," — unit variant (no data).",[55,62,63,66],{},[31,64,65],{},"Move"," — struct-like variant.",[55,68,69,72],{},[31,70,71],{},"Write"," — tuple-like variant.",[55,74,75,78],{},[31,76,77],{},"ChangeColor"," — tuple-like with multiple fields.",[14,80,81],{},"Pattern matching destructures them:",[23,83,86],{"className":84,"code":85,"language":28,"meta":29},[26],"match msg {\n    Message::Quit => {},\n    Message::Move { x, y } => println!(\"{x},{y}\"),\n    Message::Write(s) => println!(\"{s}\"),\n    Message::ChangeColor(r, g, b) => println!(\"{r},{g},{b}\"),\n}\n",[31,87,85],{"__ignoreMap":29},[18,89,91,94],{"id":90},"optiont-the-null-replacement",[31,92,93],{},"Option\u003CT>"," — The Null Replacement",[23,96,99],{"className":97,"code":98,"language":28,"meta":29},[26],"enum Option\u003CT> {\n    Some(T),\n    None,\n}\n",[31,100,98],{"__ignoreMap":29},[14,102,103,104,108,109,111,112,115],{},"There is ",[105,106,107],"strong",{},"no null"," in Rust. Use ",[31,110,93],{}," when a value may be absent. The compiler forces you to handle ",[31,113,114],{},"None",".",[23,117,120],{"className":118,"code":119,"language":28,"meta":29},[26],"let v: Option\u003Ci32> = Some(5);\nlet none: Option\u003Ci32> = None;\nmatch v { Some(x) => println!(\"{x}\"), None => println!(\"none\") }\nlet unwrapped = v.unwrap_or(0);\n",[31,121,119],{"__ignoreMap":29},[18,123,125,128],{"id":124},"resultt-e-error-handling-primitive",[31,126,127],{},"Result\u003CT, E>"," — Error Handling Primitive",[23,130,133],{"className":131,"code":132,"language":28,"meta":29},[26],"enum Result\u003CT, E> {\n    Ok(T),\n    Err(E),\n}\n",[31,134,132],{"__ignoreMap":29},[14,136,137],{},"The basis of Rust error handling. See Error Handling chapter.",[18,139,141],{"id":140},"methods-on-enums","Methods on Enums",[23,143,146],{"className":144,"code":145,"language":28,"meta":29},[26],"impl Message {\n    fn call(&self) {\n        \u002F\u002F dispatch on self\n    }\n}\n",[31,147,145],{"__ignoreMap":29},[14,149,150],{},"Enums can have methods, just like structs.",[18,152,154],{"id":153},"enums-with-generic-parameters","Enums with Generic Parameters",[23,156,159],{"className":157,"code":158,"language":28,"meta":29},[26],"enum Either\u003CL, R> {\n    Left(L),\n    Right(R),\n}\n\nenum Tree\u003CT> {\n    Leaf,\n    Node(Box\u003CTree\u003CT>>, T, Box\u003CTree\u003CT>>),\n}\n",[31,160,158],{"__ignoreMap":29},[14,162,163,164,167],{},"Recursive enums need indirection (",[31,165,166],{},"Box",") because the compiler needs to know the size — direct self-recursion would be infinitely sized.",[18,169,171,174],{"id":170},"derive-for-enums",[31,172,173],{},"#[derive]"," for Enums",[23,176,179],{"className":177,"code":178,"language":28,"meta":29},[26],"#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\nenum Color { Red, Green, Blue }\n",[31,180,178],{"__ignoreMap":29},[14,182,183,186,187,190,191,193,194,197],{},[31,184,185],{},"Copy"," only works if ",[105,188,189],{},"every"," variant's data is ",[31,192,185],{}," (e.g., no ",[31,195,196],{},"String",").",[18,199,201],{"id":200},"match-exhaustiveness","Match Exhaustiveness",[14,203,204,207,208,211,212,215,216,218,219,222],{},[31,205,206],{},"match"," must cover every variant. Use ",[31,209,210],{},"_"," for \"everything else\". For ",[31,213,214],{},"#[non_exhaustive]"," enums from external crates, ",[31,217,210],{}," is ",[37,220,221],{},"required"," even if you cover all current variants (upstream may add more).",[23,224,227],{"className":225,"code":226,"language":28,"meta":29},[26],"#[non_exhaustive]\npub enum Event { Login, Logout }\n\u002F\u002F External crate must write `_ => ...` arm.\n",[31,228,226],{"__ignoreMap":29},[18,230,232],{"id":231},"field-access-on-tuple-variants","Field-Access on Tuple Variants",[23,234,237],{"className":235,"code":236,"language":28,"meta":29},[26],"let m = Message::Write(\"hi\".into());\nlet s = m.0;  \u002F\u002F ERROR: cannot access field — must pattern match\n",[31,238,236],{"__ignoreMap":29},[14,240,241,242,245,246,249],{},"Tuple-variant fields aren't accessible via ",[31,243,244],{},".0"," — you must destructure with ",[31,247,248],{},"let Message::Write(s) = m;",". (Some newer nightly features relax this.)",[18,251,253],{"id":252},"pattern-matching-patterns","Pattern Matching Patterns",[23,255,258],{"className":256,"code":257,"language":28,"meta":29},[26],"match opt {\n    Some(0) => \"zero\",\n    Some(1..=9) => \"small\",\n    Some(n) if n > 1000 => \"big\",     \u002F\u002F guard\n    Some(_) => \"other\",\n    None => \"none\",\n}\n\n\u002F\u002F binding with @\nmatch n {\n    0..=9 => \"digit\",\n    x @ 10..=99 => \"two digits: {x}\",\n    _ => \"big\",\n}\n\n\u002F\u002F or-patterns\nmatch c {\n    'a' | 'e' | 'i' | 'o' | 'u' => \"vowel\",\n    _ => \"consonant\",\n}\n",[31,259,257],{"__ignoreMap":29},[18,261,263,266,267],{"id":262},"if-let-and-while-let",[31,264,265],{},"if let"," and ",[31,268,269],{},"while let",[23,271,274],{"className":272,"code":273,"language":28,"meta":29},[26],"if let Some(x) = opt { println!(\"{x}\"); }\nwhile let Some(x) = iter.next() { \u002F* ... *\u002F }\n",[31,275,273],{"__ignoreMap":29},[14,277,278],{},"Short for \"match one pattern and ignore the rest\". Use when you only care about one case.",[18,280,282],{"id":281},"enum-memory-layout","Enum Memory Layout",[14,284,285],{},"Enums store a discriminant (tag) plus enough space for the largest variant's payload:",[23,287,290],{"className":288,"code":289,"language":28,"meta":29},[26],"enum E {\n    A,\n    B(i64),\n    C([u8; 16]),\n}\n\u002F\u002F size = max(payload size) + discriminant (often optimized)\n",[31,291,289],{"__ignoreMap":29},[14,293,294,295,298,299,302,303,306,307,197],{},"The compiler performs ",[105,296,297],{},"niche optimization",": if a variant is impossible to overlap with another, it can drop the discriminant. Classic case: ",[31,300,301],{},"Option\u003C&T>"," is the same size as ",[31,304,305],{},"&T"," (null pointer is reserved for ",[31,308,114],{},[14,310,311,314,315,314,318,321],{},[31,312,313],{},"Option\u003CNonNull\u003CT>>",", ",[31,316,317],{},"Option\u003CBox\u003CT>>",[31,319,320],{},"Option\u003C&mut T>"," are all pointer-sized.",[18,323,325],{"id":324},"state-machines","State Machines",[14,327,328],{},"Enums are perfect for state machines:",[23,330,333],{"className":331,"code":332,"language":28,"meta":29},[26],"enum Conn {\n    Idle,\n    Connecting(std::time::Instant),\n    Connected { addr: String, since: std::time::Instant },\n    Error(String),\n}\n",[31,334,332],{"__ignoreMap":29},[14,336,337,338,115],{},"Each state carries the data relevant to it. Transitions are explicit functions returning a new ",[31,339,340],{},"Conn",[18,342,344],{"id":343},"variants-as-constructors","Variants as Constructors",[23,346,349],{"className":347,"code":348,"language":28,"meta":29},[26],"let f: fn(String) -> Message = Message::Write;\n",[31,350,348],{"__ignoreMap":29},[14,352,353],{},"Each variant acts as a function. Useful for higher-order code.",[18,355,357],{"id":356},"edge-cases-pitfalls","Edge Cases & Pitfalls",[52,359,360,375,387,397,413,425,442,455],{},[55,361,362,367,368,371,372,115],{},[105,363,364,365],{},"Recursive enums without ",[31,366,166],{},": ",[31,369,370],{},"enum Bad { Node(Bad) }"," — infinite size, compile error. Use ",[31,373,374],{},"Box\u003CBad>",[55,376,377,367,380,383,384,115],{},[105,378,379],{},"Variant equality",[31,381,382],{},"Option::Some(5) == Option::Some(5)"," works only if ",[31,385,386],{},"T: PartialEq",[55,388,389,394,395,115],{},[105,390,391,393],{},[31,392,185],{}," enums",": only if all payloads are ",[31,396,185],{},[55,398,399,405,406,409,410,197],{},[105,400,401,404],{},[31,402,403],{},"Default"," for enums",": not derivable for enums (no obvious default). You can ",[31,407,408],{},"impl Default"," manually — convention is \"smallest\u002Fzero\" variant (e.g., ",[31,411,412],{},"Option::None",[55,414,415,420,421,424],{},[105,416,417],{},[31,418,419],{},"#[repr(C)]",": gives C-style layout with explicit discriminant (size depends on largest discriminant). Use ",[31,422,423],{},"#[repr(C, u8)]"," etc. to fix discriminant width.",[55,426,427,367,430,433,434,437,438,441],{},[105,428,429],{},"Comparing variants",[31,431,432],{},"PartialOrd","\u002F",[31,435,436],{},"Ord"," compares by ",[105,439,440],{},"declaration order"," of variants, then by payload.",[55,443,444,450,451,454],{},[105,445,446,449],{},[31,447,448],{},"is_x()"," methods",": idiom is to write ",[31,452,453],{},"matches!(self, Self::X)"," or a helper method rather than exposing internal representation.",[55,456,457,367,463,466],{},[105,458,459,462],{},[31,460,461],{},"matches!"," macro",[31,464,465],{},"if matches!(opt, Some(0)) { }"," — concise single-pattern check.",[18,468,470,472],{"id":469},"matches-macro",[31,471,461],{}," Macro",[23,474,477],{"className":475,"code":476,"language":28,"meta":29},[26],"let ok = matches!(result, Ok(_));\nlet small = matches!(n, 0..=9);\n",[31,478,476],{"__ignoreMap":29},[14,480,481,482,484,485,115],{},"Like a tiny ",[31,483,206],{}," returning ",[31,486,487],{},"bool",[18,489,491],{"id":490},"typestate-pattern-advanced","Typestate Pattern (advanced)",[14,493,494],{},"Use type params to encode states:",[23,496,499],{"className":497,"code":498,"language":28,"meta":29},[26],"struct Builder\u003CT>(PhantomData\u003CT>);\nstruct Unconfigured;\nstruct Configured;\nimpl Builder\u003CUnconfigured> {\n    fn configure(self) -> Builder\u003CConfigured> { Builder(PhantomData) }\n}\nimpl Builder\u003CConfigured> {\n    fn build(self) -> Product { \u002F* ... *\u002F }\n}\n",[31,500,498],{"__ignoreMap":29},[14,502,503,504,507,508,511],{},"Calling ",[31,505,506],{},"build"," on an ",[31,509,510],{},"Unconfigured"," builder is a compile-time error. Encode invariants in the type system.",[18,513,515],{"id":514},"summary","Summary",[14,517,518,519,521,522,433,525,528,529,532,533,535],{},"Enums are sum types: each value is one variant (with optional data). Combined with ",[31,520,206],{},", they form Rust's modeling backbone. ",[31,523,524],{},"Option",[31,526,527],{},"Result"," are the canonical examples. Niche optimization makes them memory-efficient. Pattern matching with guards, or-patterns, ",[31,530,531],{},"@","-bindings, and ",[31,534,461],{}," give you expressive dispatch.",[14,537,538],{},"Next: Pattern Matching — a deep dive.",{"title":29,"searchDepth":540,"depth":540,"links":541},2,[542,543,544,546,548,549,550,552,553,554,555,557,558,559,560,561,563,564],{"id":20,"depth":540,"text":21},{"id":43,"depth":540,"text":44},{"id":90,"depth":540,"text":545},"Option\u003CT> — The Null Replacement",{"id":124,"depth":540,"text":547},"Result\u003CT, E> — Error Handling Primitive",{"id":140,"depth":540,"text":141},{"id":153,"depth":540,"text":154},{"id":170,"depth":540,"text":551},"#[derive] for Enums",{"id":200,"depth":540,"text":201},{"id":231,"depth":540,"text":232},{"id":252,"depth":540,"text":253},{"id":262,"depth":540,"text":556},"if let and while let",{"id":281,"depth":540,"text":282},{"id":324,"depth":540,"text":325},{"id":343,"depth":540,"text":344},{"id":356,"depth":540,"text":357},{"id":469,"depth":540,"text":562},"matches! Macro",{"id":490,"depth":540,"text":491},{"id":514,"depth":540,"text":515},"md",{},true,"\u002Frust\u002F12-enums",{"title":5,"description":16},"rust\u002F12-enums","wKdHYaa1OJW7DGrDx5ZXwNa5zQWk--STxVp_U38sGX8",1785934755596]