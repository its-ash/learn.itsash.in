",[32,982,983,986],{"class":34,"line":57},[32,984,985],{"class":53},"serde = ",[32,987,988],{"class":66},"\"1.0\"\n",[32,990,991],{"class":34,"line":73},[32,992,739],{"emptyLinePlaceholder":738},[32,994,995],{"class":34,"line":214},[32,996,997],{"class":38},"# git\n",[32,999,1000,1003,1006,1009,1012],{"class":34,"line":239},[32,1001,1002],{"class":53},"my_crate = { git = ",[32,1004,1005],{"class":66},"\"https:\u002F\u002Fgithub.com\u002Fuser\u002Fcrate\"",[32,1007,1008],{"class":53},", branch = ",[32,1010,1011],{"class":66},"\"dev\"",[32,1013,1014],{"class":53}," }\n",[32,1016,1017,1020,1023,1026,1029],{"class":34,"line":255},[32,1018,1019],{"class":53},"my_crate2 = { git = ",[32,1021,1022],{"class":66},"\"...\"",[32,1024,1025],{"class":53},", tag = ",[32,1027,1028],{"class":66},"\"v1.2.3\"",[32,1030,1014],{"class":53},[32,1032,1033,1036,1038,1041,1044],{"class":34,"line":270},[32,1034,1035],{"class":53},"my_crate3 = { git = ",[32,1037,1022],{"class":66},[32,1039,1040],{"class":53},", rev = ",[32,1042,1043],{"class":66},"\"abc123\"",[32,1045,1014],{"class":53},[32,1047,1048],{"class":34,"line":286},[32,1049,739],{"emptyLinePlaceholder":738},[32,1051,1052],{"class":34,"line":310},[32,1053,1054],{"class":38},"# path (local)\n",[32,1056,1057,1060,1063],{"class":34,"line":333},[32,1058,1059],{"class":53},"my_local = { path = ",[32,1061,1062],{"class":66},"\"..\u002Fmy_local\"",[32,1064,1014],{"class":53},[32,1066,1067],{"class":34,"line":357},[32,1068,739],{"emptyLinePlaceholder":738},[32,1070,1071],{"class":34,"line":373},[32,1072,1073],{"class":38},"# optional dependency behind a feature\n",[32,1075,1076,1079,1081,1084,1087],{"class":34,"line":783},[32,1077,1078],{"class":53},"extra = { version = ",[32,1080,756],{"class":66},[32,1082,1083],{"class":53},", optional = ",[32,1085,1086],{"class":178},"true",[32,1088,1014],{"class":53},[14,1090,1091],{"id":887},"Features",[78,1093,1094,1095,1098],{},"Features enable ",[139,1096,1097],{},"conditional compilation",". Avoid exposing features of dependencies (this causes \"feature unification\" surprises). Use direct deps + optional features instead.",[19,1100,1101],{"language":21},[23,1102,1104],{"className":25,"code":1103,"language":21,"meta":27,"style":27},"#[cfg(feature = \"json\")]\nmod json;\n",[29,1105,1106,1119],{"__ignoreMap":27},[32,1107,1108,1111,1113,1116],{"class":34,"line":35},[32,1109,1110],{"class":53},"#[cfg(feature ",[32,1112,160],{"class":45},[32,1114,1115],{"class":66}," \"json\"",[32,1117,1118],{"class":53},")]\n",[32,1120,1121,1124,1127],{"class":34,"line":42},[32,1122,1123],{"class":45},"mod",[32,1125,1126],{"class":49}," json",[32,1128,166],{"class":53},[14,1130,1132],{"id":1131},"cargolock",[29,1133,1134],{},"Cargo.lock",[478,1136,1137,1140,1151],{},[481,1138,1139],{},"Pin exact versions resolved for your dependency graph.",[481,1141,1142,1143,1146,1147,1150],{},"Always commit for ",[139,1144,1145],{},"binaries",". For ",[139,1148,1149],{},"libraries"," the official recommendation is also to commit it, but it's commonly gitignored.",[481,1152,1153,1156,1157,1160],{},[29,1154,1155],{},"cargo update"," bumps within semver-compatible range; ",[29,1158,1159],{},"cargo update -p serde --precise 1.0.150"," pins a single crate.",[14,1162,1164],{"id":1163},"workspaces","Workspaces",[78,1166,1167,1168,1171],{},"When multiple crates share a workspace, dependency versions unify and ",[29,1169,1170],{},"target\u002F"," is shared:",[19,1173,1174],{"language":644},[23,1175,1177],{"className":647,"code":1176,"language":644,"meta":27,"style":27},"# Cargo.toml (workspace root)\n[workspace]\nmembers = [\"crates\u002F*\", \"app\"]\n\n[workspace.dependencies]\nserde = \"1.0\"\n",[29,1178,1179,1184,1193,1208,1212,1225],{"__ignoreMap":27},[32,1180,1181],{"class":34,"line":35},[32,1182,1183],{"class":38},"# Cargo.toml (workspace root)\n",[32,1185,1186,1188,1191],{"class":34,"line":42},[32,1187,655],{"class":53},[32,1189,1190],{"class":49},"workspace",[32,1192,661],{"class":53},[32,1194,1195,1198,1201,1203,1206],{"class":34,"line":57},[32,1196,1197],{"class":53},"members = [",[32,1199,1200],{"class":66},"\"crates\u002F*\"",[32,1202,296],{"class":53},[32,1204,1205],{"class":66},"\"app\"",[32,1207,661],{"class":53},[32,1209,1210],{"class":34,"line":73},[32,1211,739],{"emptyLinePlaceholder":738},[32,1213,1214,1216,1218,1221,1223],{"class":34,"line":214},[32,1215,655],{"class":53},[32,1217,1190],{"class":49},[32,1219,1220],{"class":53},".",[32,1222,746],{"class":49},[32,1224,661],{"class":53},[32,1226,1227,1229],{"class":34,"line":239},[32,1228,985],{"class":53},[32,1230,988],{"class":66},[78,1232,1233,1234,1220],{},"Members then reference with ",[29,1235,1236],{},"serde.workspace = true",[14,1238,1240],{"id":1239},"tips-tricks","💡 Tips & Tricks",[478,1242,1243,1252,1272,1288,1308,1321],{},[481,1244,1245,1247,1248,1251],{},[139,1246,413],{},": ",[29,1249,1250],{},"rustc --explain E0382"," (or any error code from a compiler message) prints a detailed explanation with examples, straight from the compiler — faster than searching online for a common error code.",[481,1253,1254,1257,1258,1261,1262,1265,1266,1268,1269,1271],{},[139,1255,1256],{},"Idiom",": use ",[29,1259,1260],{},"println!(\"{name:?}\")"," (Debug) while prototyping and switch to ",[29,1263,1264],{},"println!(\"{name}\")"," (Display) once a type has a hand-written ",[29,1267,405],{}," impl — reaching for ",[29,1270,409],{}," everywhere works but produces developer-facing, not user-facing, output.",[481,1273,1274,1276,1277,1280,1281,1283,1284,1287],{},[139,1275,1256],{},": set ",[29,1278,1279],{},"publish = false"," in ",[29,1282,640],{}," immediately for any project that isn't meant for crates.io — it costs nothing and prevents an accidental ",[29,1285,1286],{},"cargo publish"," months later when you've forgotten the project was never meant to be public.",[481,1289,1290,1247,1292,1295,1296,1299,1300,1304,1305,1307],{},[139,1291,413],{},[29,1293,1294],{},"cargo run -- --flag value"," — everything after the bare ",[29,1297,1298],{},"--"," is passed to ",[1301,1302,1303],"em",{},"your"," binary's argv, not interpreted by Cargo; forgetting the ",[29,1306,1298],{}," is a common reason \"my CLI flag doesn't work\" during local testing.",[481,1309,1310,1312,1313,1316,1317,1320],{},[139,1311,1256],{},": pin dependencies with ",[29,1314,1315],{},"\"=\""," only when you have a specific reason (a known-broken later version, reproducibility requirements) — the default caret (",[29,1318,1319],{},"^",") requirement is usually right, since it allows patch\u002Fminor updates that are supposed to be backward compatible under semver.",[481,1322,1323,1247,1326,1329,1330,1332,1333,1336,1337,296,1340,296,1343,1346],{},[139,1324,1325],{},"Performance",[29,1327,1328],{},"cargo new","'s default ",[29,1331,640],{}," doesn't set a release profile — for anything beyond a quick script, add ",[29,1334,1335],{},"[profile.release]"," tuning (",[29,1338,1339],{},"lto",[29,1341,1342],{},"codegen-units",[29,1344,1345],{},"strip",") once you're past the prototyping stage, since the untouched defaults favor compile speed over runtime performance.",[14,1348,1350],{"id":1349},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[478,1352,1353,1373,1390,1408,1422,1431],{},[481,1354,1355,1361,1362,1365,1366,1369,1370,1220],{},[139,1356,1357,1358],{},"Binaries from ",[29,1359,1360],{},"src\u002Fbin\u002F*.rs",": each ",[29,1363,1364],{},".rs"," file in ",[29,1367,1368],{},"src\u002Fbin\u002F"," becomes a separate binary target automatically. Run with ",[29,1371,1372],{},"cargo run --bin extra",[481,1374,1375,1247,1383,1386,1387,1220],{},[139,1376,1377,1380,1381],{},[29,1378,1379],{},"cargo run"," passes args after ",[29,1382,1298],{},[29,1384,1385],{},"cargo run -- --flag"," runs your binary with ",[29,1388,1389],{},"--flag",[481,1391,1392,1399,1400,1403,1404,1407],{},[139,1393,1394,1395,1398],{},"Multiple ",[29,1396,1397],{},"[[bin]]"," targets"," can share a ",[29,1401,1402],{},"src\u002Flib.rs"," for logic and have thin ",[29,1405,1406],{},"src\u002Fbin\u002F*"," shells.",[481,1409,1410,1247,1415,1418,1419,1421],{},[139,1411,1412,1414],{},[29,1413,83],{}," error codes",[29,1416,1417],{},"E0382"," etc. Search ",[29,1420,1250],{}," or online for detailed explanations.",[481,1423,1424,1247,1427,1430],{},[139,1425,1426],{},"Build scripts",[29,1428,1429],{},"build.rs"," runs before compilation; use for linking C libs, generating code at build time.",[481,1432,1433,1247,1439,296,1442,1445,1446,1220],{},[139,1434,1435,1438],{},[29,1436,1437],{},"CARGO_*"," env vars",[29,1440,1441],{},"CARGO_PKG_VERSION",[29,1443,1444],{},"CARGO_MANIFEST_DIR",", etc., useful in build scripts and via ",[29,1447,1448],{},"env!",[14,1450,1452],{"id":1451},"reading-compiler-errors","Reading Compiler Errors",[78,1454,1455,1456,1459],{},"Rust errors are structured: the message, an ",[29,1457,1458],{},"-->"," pointing at the code, and often a help\u002Fnote. Multi-error cascades are common — fix the first error, then re-run; later ones often vanish.",[14,1461,1463],{"id":1462},"spot-the-bug","🧠 Spot the Bug",[78,1465,1466,1467,1470],{},"Why does ",[29,1468,1469],{},"cargo build"," succeed for one teammate and fail with a totally different error for another, on the exact same commit?",[19,1472,1473],{"language":644},[23,1474,1476],{"className":647,"code":1475,"language":644,"meta":27,"style":27},"[dependencies]\nsome_lib = \"1.2\"\n",[29,1477,1478,1486],{"__ignoreMap":27},[32,1479,1480,1482,1484],{"class":34,"line":35},[32,1481,655],{"class":53},[32,1483,746],{"class":49},[32,1485,661],{"class":53},[32,1487,1488,1491],{"class":34,"line":42},[32,1489,1490],{"class":53},"some_lib = ",[32,1492,1493],{"class":66},"\"1.2\"\n",[1495,1496,1497,1501,1547,1553],"details",{},[1498,1499,1500],"summary",{},"Answer",[78,1502,1503,1504,1506,1507,1510,1511,1514,1515,1517,1518,1520,1521,1524,1525,1528,1529,1532,1533,1536,1537,1540,1541,1543,1544,1546],{},"The most common cause: one teammate has a ",[29,1505,1134],{}," committed and checked out (or previously generated) that pins ",[29,1508,1509],{},"some_lib"," to, say, ",[29,1512,1513],{},"1.2.3",", while the other teammate either deleted their ",[29,1516,1134],{},", is building a fresh checkout without one, or ran ",[29,1519,1155],{}," locally — resolving ",[29,1522,1523],{},"\"1.2\""," (which means ",[29,1526,1527],{},"^1.2",", i.e., ",[29,1530,1531],{},">=1.2.0, \u003C2.0.0",") to a newer version like ",[29,1534,1535],{},"1.5.0"," that was published after the first teammate last locked their dependencies. Cargo.toml's version requirement is a ",[1301,1538,1539],{},"range",", not a pin — the actual, exact version used for any given build is determined by ",[29,1542,1134],{},", and if that file is missing, out of date, or excluded from version control, two people (or two CI runs, or a local build vs. a Docker build) can silently resolve to different concrete versions of ",[29,1545,1509],{},", one of which may have introduced a breaking change or bug despite being \"semver compatible\" in theory.",[78,1548,1549,1550,1552],{},"This is precisely why the chapter's guidance is to always commit ",[29,1551,1134],{}," for binaries (and, per current official guidance, for libraries too): it's the only thing that guarantees everyone — teammates, CI, and production builds — resolves the exact same dependency graph.",[78,1554,1555,1247,1558,1560,1561,1563,1564,1566,1567,1570],{},[139,1556,1557],{},"The lesson",[29,1559,640],{}," version requirements describe an acceptable ",[1301,1562,1539],{},"; only ",[29,1565,1134],{}," pins the ",[1301,1568,1569],{},"exact"," versions actually used — an uncommitted or stale lock file means \"works on my machine\" can be literally true and still not mean what you think it means.",[14,1572,1573],{"id":1498},"Summary",[78,1575,1576],{},"You can scaffold, build, run, format, lint, and document a project. Next: the type system starts with variables and mutability.",[1578,1579,1580],"style",