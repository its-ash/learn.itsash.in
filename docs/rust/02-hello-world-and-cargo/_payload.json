[{"data":1,"prerenderedAt":506},["ShallowReactive",2],{"page-\u002Frust\u002F02-hello-world-and-cargo":3},{"id":4,"title":5,"body":6,"description":25,"extension":499,"meta":500,"navigation":501,"path":502,"seo":503,"stem":504,"__hash__":505},"content\u002Frust\u002F02-hello-world-and-cargo.md","02 — Hello World & Cargo Deep Dive",{"type":7,"value":8,"toc":475},"minimark",[9,13,18,29,37,45,57,64,78,84,89,139,146,152,174,180,191,202,208,215,223,227,269,273,279,283,290,296,302,328,332,339,345,352,356,457,461,468,472],[10,11,5],"h1",{"id":12},"_02-hello-world-cargo-deep-dive",[14,15,17],"h2",{"id":16},"the-minimal-program","The Minimal Program",[19,20,26],"pre",{"className":21,"code":23,"language":24,"meta":25},[22],"language-rust","\u002F\u002F src\u002Fmain.rs\nfn main() {\n    println!(\"Hello, world!\");\n}\n","rust","",[27,28,23],"code",{"__ignoreMap":25},[30,31,32,33,36],"p",{},"Compile and run directly with ",[27,34,35],{},"rustc",":",[19,38,43],{"className":39,"code":41,"language":42,"meta":25},[40],"language-bash","rustc src\u002Fmain.rs && .\u002Fmain      # produces .\u002Fmain (or main.exe)\n","bash",[27,44,41],{"__ignoreMap":25},[30,46,47,49,50,53,54,56],{},[27,48,35],{}," is the compiler. In practice you use ",[27,51,52],{},"cargo"," instead, but understanding ",[27,55,35],{}," helps you read compiler errors.",[14,58,60,63],{"id":59},"println-is-a-macro-not-a-function",[27,61,62],{},"println!"," is a Macro, Not a Function",[30,65,66,68,69,72,73,77],{},[27,67,62],{}," ends with ",[27,70,71],{},"!"," because it's a ",[74,75,76],"strong",{},"macro",". It can't be a function because it validates format strings at compile time and takes a variadic number of arguments.",[19,79,82],{"className":80,"code":81,"language":24,"meta":25},[22],"let name = \"Ada\";\nlet age = 36;\nprintln!(\"{name} is {age}\");            \u002F\u002F implicit named args (edition 2021+)\nprintln!(\"{0} is {1}\", name, age);      \u002F\u002F positional\nprintln!(\"{name} is {age}\", name=name, age=age); \u002F\u002F explicit named\nprintln!(\"{name:>10}\");                  \u002F\u002F right-align width 10\nprintln!(\"{name:^10}\");                  \u002F\u002F center\nprintln!(\"{age:0>5}\");                   \u002F\u002F zero-padded: 00036\nprintln!(\"{age:#x}\", 255u32);            \u002F\u002F hex with 0x prefix -> 0xff\nprintln!(\"{:b}\", 10u8);                  \u002F\u002F binary -> 1010\nprintln!(\"{:e}\", 12345.678f64);          \u002F\u002F scientific\nprintln!(\"{:#?}\", some_struct);          \u002F\u002F pretty-print debug\nprintln!(\"{:>10.2}\", 3.14159);           \u002F\u002F width 10, 2 decimals\n",[27,83,81],{"__ignoreMap":25},[85,86,88],"h3",{"id":87},"format-trait-hierarchy","Format Trait Hierarchy",[30,90,91,94,95,98,99,102,103,106,107,110,111,106,113,116,117,116,120,116,123,116,126,116,129,132,133,135,136,138],{},[27,92,93],{},"{}"," uses the ",[27,96,97],{},"Display"," trait; ",[27,100,101],{},"{:?}"," uses ",[27,104,105],{},"Debug","; ",[27,108,109],{},"{:#?}"," is pretty ",[27,112,105],{},[27,114,115],{},"{o}",", ",[27,118,119],{},"{x}",[27,121,122],{},"{X}",[27,124,125],{},"{b}",[27,127,128],{},"{e}",[27,130,131],{},"{E}"," select integer\u002Ffloat formatting. You implement ",[27,134,97],{}," manually for user-facing output; ",[27,137,105],{}," can be derived.",[14,140,142,143],{"id":141},"anatomy-of-main","Anatomy of ",[27,144,145],{},"main",[19,147,150],{"className":148,"code":149,"language":24,"meta":25},[22],"fn main() {\n    \u002F\u002F program entry point\n}\n",[27,151,149],{"__ignoreMap":25},[153,154,155,165],"ul",{},[156,157,158,160,161,164],"li",{},[27,159,145],{}," never takes arguments and never returns a value (returns unit ",[27,162,163],{},"()",").",[156,166,167,168,171,172,36],{},"To exit with a code, use ",[27,169,170],{},"std::process::exit(code)"," (skips destructors!) or return from ",[27,173,145],{},[19,175,178],{"className":176,"code":177,"language":24,"meta":25},[22],"fn main() -> std::process::ExitCode {\n    std::process::ExitCode::SUCCESS\n}\n",[27,179,177],{"__ignoreMap":25},[30,181,182,183,186,187,190],{},"(Stable ",[27,184,185],{},"ExitCode"," and ",[27,188,189],{},"Termination"," trait are available since 1.61.)",[14,192,194,195,198,199],{"id":193},"cargo-new-vs-init","Cargo: ",[27,196,197],{},"new"," vs ",[27,200,201],{},"init",[19,203,206],{"className":204,"code":205,"language":42,"meta":25},[40],"cargo new my_app          # creates new directory with a binary project\ncargo new my_lib --lib    # library project (lib.rs, no main)\ncargo init                # scaffolds in the current directory (existing git repo preserved)\ncargo init --name custom_name\n",[27,207,205],{"__ignoreMap":25},[14,209,211,214],{"id":210},"cargotoml-anatomy",[27,212,213],{},"Cargo.toml"," Anatomy",[19,216,221],{"className":217,"code":219,"language":220,"meta":25},[218],"language-toml","[package]\nname = \"my_app\"\nversion = \"0.1.0\"\nedition = \"2021\"\nauthors = [\"You \u003Cyou@example.com>\"]\nlicense = \"MIT OR Apache-2.0\"\ndescription = \"...\"\nrust-version = \"1.75\"          # MSRV\npublish = false                 # don't accidentally publish to crates.io\n\n[dependencies]\nserde = { version = \"1.0\", features = [\"derive\"] }\ntokio = { version = \"1\", features = [\"full\"] }\nrand = \"0.8\"\n\n[dev-dependencies]\npretty_assertions = \"1\"        # only for tests\u002Fbenches\n\n[build-dependencies]\nanyhow = \"1\"                   # for build.rs\n\n[[bin]]\nname = \"my_app\"\npath = \"src\u002Fmain.rs\"\n\n[features]\ndefault = [\"json\"]\njson = [\"serde\"]\n","toml",[27,222,219],{"__ignoreMap":25},[85,224,226],{"id":225},"version-requirement-syntax","Version Requirement Syntax",[153,228,229,243,249,257,263],{},[156,230,231,234,235,238,239,242],{},[27,232,233],{},"\"1.0\""," → ",[27,236,237],{},"^1.0"," → compatible up to ",[27,240,241],{},"\u003C2.0.0"," (caret, default)",[156,244,245,248],{},[27,246,247],{},"\"=1.0.0\""," → exact",[156,250,251,234,254],{},[27,252,253],{},"\"~1.0.0\"",[27,255,256],{},">=1.0.0, \u003C1.1.0",[156,258,259,262],{},[27,260,261],{},"\">=1.0, \u003C2.0\""," → explicit range",[156,264,265,268],{},[27,266,267],{},"\"*\""," → any (avoid)",[14,270,272],{"id":271},"dependency-sources","Dependency Sources",[19,274,277],{"className":275,"code":276,"language":220,"meta":25},[218],"[dependencies]\n# crates.io\nserde = \"1.0\"\n\n# git\nmy_crate = { git = \"https:\u002F\u002Fgithub.com\u002Fuser\u002Fcrate\", branch = \"dev\" }\nmy_crate2 = { git = \"...\", tag = \"v1.2.3\" }\nmy_crate3 = { git = \"...\", rev = \"abc123\" }\n\n# path (local)\nmy_local = { path = \"..\u002Fmy_local\" }\n\n# optional dependency behind a feature\nextra = { version = \"1.0\", optional = true }\n",[27,278,276],{"__ignoreMap":25},[14,280,282],{"id":281},"features","Features",[30,284,285,286,289],{},"Features enable ",[74,287,288],{},"conditional compilation",". Avoid exposing features of dependencies (this causes \"feature unification\" surprises). Use direct deps + optional features instead.",[19,291,294],{"className":292,"code":293,"language":24,"meta":25},[22],"#[cfg(feature = \"json\")]\nmod json;\n",[27,295,293],{"__ignoreMap":25},[14,297,299],{"id":298},"cargolock",[27,300,301],{},"Cargo.lock",[153,303,304,307,318],{},[156,305,306],{},"Pin exact versions resolved for your dependency graph.",[156,308,309,310,313,314,317],{},"Always commit for ",[74,311,312],{},"binaries",". For ",[74,315,316],{},"libraries"," the official recommendation is also to commit it, but it's commonly gitignored.",[156,319,320,323,324,327],{},[27,321,322],{},"cargo update"," bumps within semver-compatible range; ",[27,325,326],{},"cargo update -p serde --precise 1.0.150"," pins a single crate.",[14,329,331],{"id":330},"workspaces","Workspaces",[30,333,334,335,338],{},"When multiple crates share a workspace, dependency versions unify and ",[27,336,337],{},"target\u002F"," is shared:",[19,340,343],{"className":341,"code":342,"language":220,"meta":25},[218],"# Cargo.toml (workspace root)\n[workspace]\nmembers = [\"crates\u002F*\", \"app\"]\n\n[workspace.dependencies]\nserde = \"1.0\"\n",[27,344,342],{"__ignoreMap":25},[30,346,347,348,351],{},"Members then reference with ",[27,349,350],{},"serde.workspace = true",".",[14,353,355],{"id":354},"edge-cases","Edge Cases",[153,357,358,378,397,415,430,439],{},[156,359,360,366,367,370,371,374,375,351],{},[74,361,362,363],{},"Binaries from ",[27,364,365],{},"src\u002Fbin\u002F*.rs",": each ",[27,368,369],{},".rs"," file in ",[27,372,373],{},"src\u002Fbin\u002F"," becomes a separate binary target automatically. Run with ",[27,376,377],{},"cargo run --bin extra",[156,379,380,389,390,393,394,351],{},[74,381,382,385,386],{},[27,383,384],{},"cargo run"," passes args after ",[27,387,388],{},"--",": ",[27,391,392],{},"cargo run -- --flag"," runs your binary with ",[27,395,396],{},"--flag",[156,398,399,406,407,410,411,414],{},[74,400,401,402,405],{},"Multiple ",[27,403,404],{},"[[bin]]"," targets"," can share a ",[27,408,409],{},"src\u002Flib.rs"," for logic and have thin ",[27,412,413],{},"src\u002Fbin\u002F*"," shells.",[156,416,417,389,422,425,426,429],{},[74,418,419,421],{},[27,420,35],{}," error codes",[27,423,424],{},"E0382"," etc. Search ",[27,427,428],{},"rustc --explain E0382"," or online for detailed explanations.",[156,431,432,389,435,438],{},[74,433,434],{},"Build scripts",[27,436,437],{},"build.rs"," runs before compilation; use for linking C libs, generating code at build time.",[156,440,441,389,447,116,450,453,454,351],{},[74,442,443,446],{},[27,444,445],{},"CARGO_*"," env vars",[27,448,449],{},"CARGO_PKG_VERSION",[27,451,452],{},"CARGO_MANIFEST_DIR",", etc., useful in build scripts and via ",[27,455,456],{},"env!",[14,458,460],{"id":459},"reading-compiler-errors","Reading Compiler Errors",[30,462,463,464,467],{},"Rust errors are structured: the message, an ",[27,465,466],{},"-->"," pointing at the code, and often a help\u002Fnote. Multi-error cascades are common — fix the first error, then re-run; later ones often vanish.",[14,469,471],{"id":470},"summary","Summary",[30,473,474],{},"You can scaffold, build, run, format, lint, and document a project. Next: the type system starts with variables and mutability.",{"title":25,"searchDepth":476,"depth":476,"links":477},2,[478,479,484,486,488,492,493,494,495,496,497,498],{"id":16,"depth":476,"text":17},{"id":59,"depth":476,"text":480,"children":481},"println! is a Macro, Not a Function",[482],{"id":87,"depth":483,"text":88},3,{"id":141,"depth":476,"text":485},"Anatomy of main",{"id":193,"depth":476,"text":487},"Cargo: new vs init",{"id":210,"depth":476,"text":489,"children":490},"Cargo.toml Anatomy",[491],{"id":225,"depth":483,"text":226},{"id":271,"depth":476,"text":272},{"id":281,"depth":476,"text":282},{"id":298,"depth":476,"text":301},{"id":330,"depth":476,"text":331},{"id":354,"depth":476,"text":355},{"id":459,"depth":476,"text":460},{"id":470,"depth":476,"text":471},"md",{},true,"\u002Frust\u002F02-hello-world-and-cargo",{"title":5,"description":25},"rust\u002F02-hello-world-and-cargo","zotiGtLP8a-v0d1SMGEp30WWyNqvlIM-3_lWO6aH_4M",1785934755594]