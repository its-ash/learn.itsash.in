[{"data":1,"prerenderedAt":837},["ShallowReactive",2],{"page-\u002Frust\u002F24-macros":3},{"id":4,"title":5,"body":6,"description":16,"extension":830,"meta":831,"navigation":832,"path":833,"seo":834,"stem":835,"__hash__":836},"content\u002Frust\u002F24-macros.md","24 — Macros",{"type":7,"value":8,"toc":796},"minimark",[9,13,17,39,44,74,81,87,97,102,176,184,190,194,200,211,215,237,241,244,250,255,261,267,271,277,281,287,294,303,308,314,323,327,443,447,454,487,491,499,507,519,525,528,534,538,544,546,552,556,562,566,572,575,579,613,617,623,626,630,727,732,740,743,747,750,764,767,771,793],[10,11,5],"h1",{"id":12},"_24-macros",[14,15,16],"p",{},"Macros generate code at compile time. Rust has two kinds:",[18,19,20,33],"ol",{},[21,22,23,27,28,32],"li",{},[24,25,26],"strong",{},"Declarative macros"," (",[29,30,31],"code",{},"macro_rules!","): pattern-matching code generators.",[21,34,35,38],{},[24,36,37],{},"Procedural macros",": real Rust functions that consume\u002Fproduce token streams (custom derive, attribute, function-like).",[40,41,43],"h2",{"id":42},"why-macros","Why Macros?",[45,46,47,58,61,64],"ul",{},[21,48,49,50,53,54,57],{},"Variadic arguments (",[29,51,52],{},"println!",", ",[29,55,56],{},"vec!",").",[21,59,60],{},"Compile-time string interpolation (format strings are checked).",[21,62,63],{},"Reducing boilerplate (derive macros).",[21,65,66,67,70,71,57],{},"DSLs (",[29,68,69],{},"html!"," in ",[29,72,73],{},"yew",[14,75,76,77,80],{},"Macros run ",[24,78,79],{},"before"," the type checker — they expand into AST, which is then type-checked.",[40,82,84,85],{"id":83},"declarative-macros-macro_rules","Declarative Macros: ",[29,86,31],{},[88,89,95],"pre",{"className":90,"code":92,"language":93,"meta":94},[91],"language-rust","macro_rules! vec_of {\n    ($($x:expr),*) => {{\n        let mut v = Vec::new();\n        $( v.push($x); )*\n        v\n    }};\n}\n\nlet v = vec_of!(1, 2, 3);\n","rust","",[29,96,92],{"__ignoreMap":94},[98,99,101],"h3",{"id":100},"macro-syntax","Macro Syntax",[45,103,104,110,155,169],{},[21,105,106,109],{},[29,107,108],{},"$name",": a \"metavariable\".",[21,111,112,53,115,53,118,53,121,53,124,53,127,53,130,53,133,53,136,53,139,53,142,53,145,53,148,53,151,154],{},[29,113,114],{},":expr",[29,116,117],{},":ident",[29,119,120],{},":ty",[29,122,123],{},":tt",[29,125,126],{},":item",[29,128,129],{},":pat",[29,131,132],{},":stmt",[29,134,135],{},":literal",[29,137,138],{},":vis",[29,140,141],{},":lifetime",[29,143,144],{},":block",[29,146,147],{},":path",[29,149,150],{},":meta",[29,152,153],{},":expr_2021"," — fragment types.",[21,156,157,160,161,164,165,168],{},[29,158,159],{},"$(...)*"," repeats zero or more; ",[29,162,163],{},"$(...)+"," repeats one or more; ",[29,166,167],{},"$(...)?"," optional.",[21,170,171,172,175],{},"Multiple arms separated by ",[29,173,174],{},";",", first match wins (top to bottom).",[98,177,179,180,183],{"id":178},"example-a-hashmap-macro","Example: a ",[29,181,182],{},"hashmap!"," macro",[88,185,188],{"className":186,"code":187,"language":93,"meta":94},[91],"macro_rules! hashmap {\n    ($( $key:expr => $val:expr ),* $(,)?) => {{\n        let mut m = std::collections::HashMap::new();\n        $(\n            m.insert($key, $val);\n        )*\n        m\n    }};\n}\nlet m = hashmap!(\"a\" => 1, \"b\" => 2);\n",[29,189,187],{"__ignoreMap":94},[98,191,193],{"id":192},"repetition-specifiers","Repetition Specifiers",[88,195,198],{"className":196,"code":197,"language":93,"meta":94},[91],"macro_rules! sum {\n    ($($x:expr),*) => { 0 $(+ $x)* };\n    ($first:expr $(, $rest:expr)*) => { $first $(+ $rest)* };\n}\n",[29,199,197],{"__ignoreMap":94},[14,201,202,203,206,207,210],{},"Two arms handle empty\u002Fone\u002Fmany. The first arm matches the empty case (sum of nothing = 0). The ",[29,204,205],{},"$(+ $x)*"," expands to ",[29,208,209],{},"+ $x"," repeated.",[98,212,214],{"id":213},"fragment-capturing-and-follow-rules","Fragment Capturing and Follow Rules",[14,216,217,218,220,221,224,225,220,227,229,230,232,233,236],{},"Each fragment type has rules about what can follow it (because the parser is ambiguous otherwise). E.g., ",[29,219,114],{}," followed by ",[29,222,223],{},"=>"," is OK, but ",[29,226,114],{},[29,228,174],{}," is not (because ",[29,231,174],{}," could be part of the expression). Common workaround: use ",[29,234,235],{},"$(,)?"," for trailing commas.",[98,238,240],{"id":239},"hygiene","Hygiene",[14,242,243],{},"Macro-introduced identifiers don't collide with caller identifiers:",[88,245,248],{"className":246,"code":247,"language":93,"meta":94},[91],"macro_rules! swap {\n    ($a:expr, $b:expr) => {\n        let tmp = $a;     \u002F\u002F 'tmp' is hygienic — won't clash with caller's tmp\n        $a = $b;\n        $b = tmp;\n    };\n}\nlet mut a = 1; let mut b = 2;\nswap!(a, b);\n",[29,249,247],{"__ignoreMap":94},[98,251,253],{"id":252},"macro_export",[29,254,252],{},[88,256,259],{"className":257,"code":258,"language":93,"meta":94},[91],"#[macro_export]\nmacro_rules! my_macro {\n    ($x:expr) => { \u002F* ... *\u002F };\n}\n",[29,260,258],{"__ignoreMap":94},[14,262,263,266],{},[29,264,265],{},"#[macro_export]"," makes the macro available crate-wide and externally (placed at crate root, regardless of where it's defined).",[98,268,270],{"id":269},"re-exporting","Re-Exporting",[88,272,275],{"className":273,"code":274,"language":93,"meta":94},[91],"pub use crate::my_macro;\n",[29,276,274],{"__ignoreMap":94},[98,278,280],{"id":279},"importing","Importing",[88,282,285],{"className":283,"code":284,"language":93,"meta":94},[91],"use my_crate::my_macro;\n",[29,286,284],{"__ignoreMap":94},[14,288,289,290,293],{},"In edition 2018+, macros are imported via ",[29,291,292],{},"use"," like any item.",[40,295,297,299,300,302],{"id":296},"vec-and-println-internals",[29,298,56],{}," and ",[29,301,52],{}," Internals",[14,304,305,307],{},[29,306,56],{}," matches several patterns:",[88,309,312],{"className":310,"code":311,"language":93,"meta":94},[91],"macro_rules! vec {\n    () => ($crate::Vec::new());\n    ($elem:expr; $n:expr) => ($crate::vec::from_elem($elem, $n));\n    ($($x:expr),+ $(,)?) => ([$($x),+].into_iter().collect());\n}\n",[29,313,311],{"__ignoreMap":94},[14,315,316,318,319,322],{},[29,317,52],{}," parses the format string and expands into ",[29,320,321],{},"std::io::_print(format_args!(...))",". Format args are validated at compile time.",[40,324,326],{"id":325},"common-built-in-macros","Common Built-in Macros",[45,328,329,351,358,372,386,409,429,437],{},[21,330,331,53,333,53,336,53,339,53,342,53,345,53,348],{},[29,332,52],{},[29,334,335],{},"eprintln!",[29,337,338],{},"print!",[29,340,341],{},"eprint!",[29,343,344],{},"format!",[29,346,347],{},"write!",[29,349,350],{},"writeln!",[21,352,353,53,355],{},[29,354,56],{},[29,356,357],{},"format_args!",[21,359,360,53,363,53,366,53,369],{},[29,361,362],{},"panic!",[29,364,365],{},"unreachable!",[29,367,368],{},"todo!",[29,370,371],{},"unimplemented!",[21,373,374,53,377,53,380,53,383],{},[29,375,376],{},"assert!",[29,378,379],{},"assert_eq!",[29,381,382],{},"assert_ne!",[29,384,385],{},"debug_assert!",[21,387,388,53,391,53,394,53,397,53,400,53,403,53,406],{},[29,389,390],{},"matches!",[29,392,393],{},"cfg!",[29,395,396],{},"env!",[29,398,399],{},"option_env!",[29,401,402],{},"include!",[29,404,405],{},"include_str!",[29,407,408],{},"include_bytes!",[21,410,411,53,414,53,417,53,420,53,423,53,426],{},[29,412,413],{},"concat!",[29,415,416],{},"stringify!",[29,418,419],{},"file!",[29,421,422],{},"line!",[29,424,425],{},"column!",[29,427,428],{},"module_path!",[21,430,431,53,434],{},[29,432,433],{},"cfg",[29,435,436],{},"cfg_attr",[21,438,439,53,441],{},[29,440,347],{},[29,442,350],{},[40,444,446],{"id":445},"procedural-macros","Procedural Macros",[14,448,449,450,453],{},"Procedural macros run real Rust code (a separate crate of type ",[29,451,452],{},"proc-macro = true","). Three flavors:",[18,455,456,470,479],{},[21,457,458,461,462,465,466,469],{},[24,459,460],{},"Function-like"," (custom ",[29,463,464],{},"macro!"," syntax): ",[29,467,468],{},"custom_macro!(...)",".",[21,471,472,475,476,469],{},[24,473,474],{},"Derive",": ",[29,477,478],{},"#[derive(MyTrait)]",[21,480,481,475,484,469],{},[24,482,483],{},"Attribute",[29,485,486],{},"#[my_attr]",[98,488,490],{"id":489},"setup","Setup",[88,492,497],{"className":493,"code":495,"language":496},[494],"language-text","my_crate\u002F\n├── Cargo.toml           # the user-facing crate\n└── my_crate_derive\u002F     # the proc-macro crate\n    └── Cargo.toml       # [lib] proc-macro = true\n","text",[29,498,495],{"__ignoreMap":94},[14,500,501,502,70,504,469],{},"Proc-macro crates must be separate and have ",[29,503,452],{},[29,505,506],{},"[lib]",[98,508,510,511,514,515,518],{"id":509},"function-like-example-using-synquote","Function-Like Example (using ",[29,512,513],{},"syn","\u002F",[29,516,517],{},"quote",")",[88,520,523],{"className":521,"code":522,"language":93,"meta":94},[91],"\u002F\u002F my_crate_derive\u002Fsrc\u002Flib.rs\nuse proc_macro::TokenStream;\nuse quote::quote;\nuse syn::{parse_macro_input, ItemStruct};\n\n#[proc_macro]\npub fn make_hello(_item: TokenStream) -> TokenStream {\n    \"fn hello() { println!(\\\"hi\\\"); }\".parse().unwrap()\n}\n",[29,524,522],{"__ignoreMap":94},[14,526,527],{},"Usage:",[88,529,532],{"className":530,"code":531,"language":93,"meta":94},[91],"use my_crate_derive::make_hello;\nmake_hello!();\nhello();\n",[29,533,531],{"__ignoreMap":94},[98,535,537],{"id":536},"derive-example","Derive Example",[88,539,542],{"className":540,"code":541,"language":93,"meta":94},[91],"#[proc_macro_derive(Hello)]\npub fn derive_hello(input: TokenStream) -> TokenStream {\n    let input = parse_macro_input!(input as ItemStruct);\n    let name = &input.ident;\n    let expanded = quote! {\n        impl #name {\n            fn hello() { println!(\"Hello from {}\", stringify!(#name)); }\n        }\n    };\n    expanded.into()\n}\n",[29,543,541],{"__ignoreMap":94},[14,545,527],{},[88,547,550],{"className":548,"code":549,"language":93,"meta":94},[91],"#[derive(Hello)]\nstruct Foo;\nFoo::hello();\n",[29,551,549],{"__ignoreMap":94},[98,553,555],{"id":554},"derive-with-helper-attributes","Derive with Helper Attributes",[88,557,560],{"className":558,"code":559,"language":93,"meta":94},[91],"#[proc_macro_derive(Hello, attributes(hello_name))]\npub fn derive_hello(input: TokenStream) -> TokenStream { \u002F* ... *\u002F }\n\n\u002F\u002F user:\n#[derive(Hello)]\n#[hello_name = \"Bar\"]\nstruct Foo;\n",[29,561,559],{"__ignoreMap":94},[98,563,565],{"id":564},"attribute-macros","Attribute Macros",[88,567,570],{"className":568,"code":569,"language":93,"meta":94},[91],"#[proc_macro_attribute]\npub fn log_calls(attr: TokenStream, item: TokenStream) -> TokenStream { \u002F* ... *\u002F }\n",[29,571,569],{"__ignoreMap":94},[14,573,574],{},"Receives both the attribute arguments and the item being annotated.",[98,576,578],{"id":577},"helper-crates","Helper Crates",[45,580,581,586,595,601,607],{},[21,582,583,585],{},[29,584,513],{},": parse Rust syntax.",[21,587,588,590,591,594],{},[29,589,517],{},": build TokenStreams with ",[29,592,593],{},"quote!"," macro.",[21,596,597,600],{},[29,598,599],{},"proc-macro2",": works with stable Rust (proc_macro types are unstable-only).",[21,602,603,606],{},[29,604,605],{},"darling",": ergonomic derive attribute parsing.",[21,608,609,612],{},[29,610,611],{},"proc-macro-error",": better error reporting.",[40,614,616],{"id":615},"built-in-derives","Built-in Derives",[88,618,621],{"className":619,"code":620,"language":93,"meta":94},[91],"#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]\nstruct Foo { \u002F* ... *\u002F }\n",[29,622,620],{"__ignoreMap":94},[14,624,625],{},"These are built into the compiler.",[40,627,629],{"id":628},"macro-pitfalls","Macro Pitfalls",[45,631,632,638,644,656,667,680,690,699,710,719],{},[21,633,634,637],{},[24,635,636],{},"Order of arms",": declarative macros match top-to-bottom. Specific patterns must come before general ones.",[21,639,640,643],{},[24,641,642],{},"Hygiene surprises",": macro-introduced variables are isolated; sometimes you want unhygienic behavior (rare).",[21,645,646,475,649,651,652,655],{},[24,647,648],{},"Expression vs statement fragments",[29,650,114],{}," captures the whole expression and double-evaluates if used multiple times. Use a ",[29,653,654],{},"let"," binding inside the macro to evaluate once.",[21,657,658,475,661,663,664,57],{},[24,659,660],{},"Recursion",[29,662,31],{}," recursion is limited (default 64 deep; can be raised via ",[29,665,666],{},"#![recursion_limit = \"256\"]",[21,668,669,475,672,675,676,679],{},[24,670,671],{},"Debugging macros",[29,673,674],{},"cargo expand"," (install with ",[29,677,678],{},"cargo install cargo-expand",") shows the expanded code.",[21,681,682,685,686,689],{},[24,683,684],{},"Compile time",": heavy macros (especially proc-macros like ",[29,687,688],{},"serde",") slow compilation.",[21,691,692,698],{},[24,693,694,697],{},[29,695,696],{},"proc-macro"," crate isolation",": a proc-macro crate can't export anything else; it's a separate compilation unit.",[21,700,701,475,704,706,707,709],{},[24,702,703],{},"Span info",[29,705,593],{},"'s default spans can produce confusing errors. Use ",[29,708,513],{},"'s spans carefully.",[21,711,712,718],{},[24,713,714,715],{},"Macro in ",[29,716,717],{},"pub use",": ensure you re-export macros from a top-level module.",[21,720,721,726],{},[24,722,723,725],{},[29,724,265],{}," placement",": places the macro at the crate root regardless of where it's defined.",[40,728,730],{"id":729},"cargo-expand",[29,731,674],{},[88,733,738],{"className":734,"code":736,"language":737,"meta":94},[735],"language-bash","cargo install cargo-expand\ncargo expand\n","bash",[29,739,736],{"__ignoreMap":94},[14,741,742],{},"Prints the post-macro-expansion source. Invaluable for debugging declarative and proc-macros.",[40,744,746],{"id":745},"when-to-use-a-macro-vs-a-function","When to Use a Macro vs a Function",[14,748,749],{},"Use a macro when:",[45,751,752,755,758,761],{},[21,753,754],{},"You need variadic arguments.",[21,756,757],{},"You need to take types as arguments.",[21,759,760],{},"You need to generate code based on structure (e.g., derive).",[21,762,763],{},"You need compile-time string parsing (format strings).",[14,765,766],{},"Otherwise, use a function (simpler, easier to debug, type-checks better).",[40,768,770],{"id":769},"summary","Summary",[45,772,773,779,785,790],{},[21,774,775,776,778],{},"Declarative macros (",[29,777,31],{},") pattern-match and emit code; hygiene prevents name collisions.",[21,780,781,782,784],{},"Proc-macros (separate ",[29,783,452],{}," crate) write real code: derive, attribute, function-like.",[21,786,787,789],{},[29,788,674],{}," is essential for debugging.",[21,791,792],{},"Use macros sparingly — they're powerful but add compile-time cost and complexity.",[14,794,795],{},"Next: Unsafe Rust.",{"title":94,"searchDepth":797,"depth":797,"links":798},2,[799,800,813,815,816,825,826,827,828,829],{"id":42,"depth":797,"text":43},{"id":83,"depth":797,"text":801,"children":802},"Declarative Macros: macro_rules!",[803,805,807,808,809,810,811,812],{"id":100,"depth":804,"text":101},3,{"id":178,"depth":804,"text":806},"Example: a hashmap! macro",{"id":192,"depth":804,"text":193},{"id":213,"depth":804,"text":214},{"id":239,"depth":804,"text":240},{"id":252,"depth":804,"text":252},{"id":269,"depth":804,"text":270},{"id":279,"depth":804,"text":280},{"id":296,"depth":797,"text":814},"vec! and println! Internals",{"id":325,"depth":797,"text":326},{"id":445,"depth":797,"text":446,"children":817},[818,819,821,822,823,824],{"id":489,"depth":804,"text":490},{"id":509,"depth":804,"text":820},"Function-Like Example (using syn\u002Fquote)",{"id":536,"depth":804,"text":537},{"id":554,"depth":804,"text":555},{"id":564,"depth":804,"text":565},{"id":577,"depth":804,"text":578},{"id":615,"depth":797,"text":616},{"id":628,"depth":797,"text":629},{"id":729,"depth":797,"text":674},{"id":745,"depth":797,"text":746},{"id":769,"depth":797,"text":770},"md",{},true,"\u002Frust\u002F24-macros",{"title":5,"description":16},"rust\u002F24-macros","5Mmmkm6YbZqh5shpiC6X2zTfZuP7QUOcDL6Sqeou_gg",1785934755598]