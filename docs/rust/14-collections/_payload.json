[{"data":1,"prerenderedAt":897},["ShallowReactive",2],{"page-\u002Frust\u002F14-collections":3},{"id":4,"title":5,"body":6,"description":41,"extension":890,"meta":891,"navigation":892,"path":893,"seo":894,"stem":895,"__hash__":896},"content\u002Frust\u002F14-collections.md","14 — Collections (Vec, String, HashMap, and more)",{"type":7,"value":8,"toc":848},"minimark",[9,26,34,44,49,59,81,87,91,97,101,107,111,117,121,127,131,137,141,234,240,246,250,259,265,274,337,341,347,351,357,361,367,370,447,456,462,482,489,492,498,502,508,522,525,580,589,595,602,608,611,618,635,642,648,658,664,668,729,733,825,829,845],[10,11,13,14,18,19,18,22,25],"h1",{"id":12},"_14-collections-vec-string-hashmap-and-more","14 — Collections (",[15,16,17],"code",{},"Vec",", ",[15,20,21],{},"String",[15,23,24],{},"HashMap",", and more)",[27,28,30,33],"h2",{"id":29},"vect-the-growable-array",[15,31,32],{},"Vec\u003CT>"," — The Growable Array",[35,36,42],"pre",{"className":37,"code":39,"language":40,"meta":41},[38],"language-rust","let mut v: Vec\u003Ci32> = Vec::new();\nv.push(1);\nv.push(2);\nlet v2 = vec![1, 2, 3];          \u002F\u002F macro shortcut\nlet v3 = vec![0; 5];              \u002F\u002F [0, 0, 0, 0, 0]\n","rust","",[15,43,39],{"__ignoreMap":41},[45,46,48],"h3",{"id":47},"memory-model","Memory Model",[50,51,52,54,55,58],"p",{},[15,53,17],{}," is ",[15,56,57],{},"(ptr, len, capacity)",":",[60,61,62,69,75],"ul",{},[63,64,65,68],"li",{},[15,66,67],{},"ptr"," → heap allocation",[63,70,71,74],{},[15,72,73],{},"len"," → number of elements currently stored",[63,76,77,80],{},[15,78,79],{},"capacity"," → allocated space; pushing beyond doubles capacity (amortized O(1))",[35,82,85],{"className":83,"code":84,"language":40,"meta":41},[38],"let mut v = Vec::with_capacity(100);   \u002F\u002F pre-allocate for perf\nv.push(1);\nprintln!(\"{:?}\", v.capacity());\n",[15,86,84],{"__ignoreMap":41},[45,88,90],{"id":89},"indexing-slicing","Indexing & Slicing",[35,92,95],{"className":93,"code":94,"language":40,"meta":41},[38],"v[0];            \u002F\u002F panics on OOB\nv.get(0);        \u002F\u002F Option\u003C&T> — safe\n&v[1..3];        \u002F\u002F slice, panics on OOB\nv.get(1..3);     \u002F\u002F Option\u003C&[T]>\n",[15,96,94],{"__ignoreMap":41},[45,98,100],{"id":99},"iteration","Iteration",[35,102,105],{"className":103,"code":104,"language":40,"meta":41},[38],"for x in &v { \u002F* x: &i32 *\u002F }\nfor x in &mut v { \u002F* x: &mut i32 *\u002F }\nfor x in v { \u002F* consumes v, x: i32 *\u002F }   \u002F\u002F ownership move\nv.iter();        \u002F\u002F iterator over &T\nv.iter_mut();    \u002F\u002F over &mut T\nv.into_iter();   \u002F\u002F consumes v, yields T (or &T for &Vec)\n",[15,106,104],{"__ignoreMap":41},[45,108,110],{"id":109},"insert-remove-swap","Insert \u002F Remove \u002F Swap",[35,112,115],{"className":113,"code":114,"language":40,"meta":41},[38],"v.insert(0, 99);   \u002F\u002F O(n) — shifts\nv.remove(0);       \u002F\u002F O(n)\nv.swap_remove(0);  \u002F\u002F O(1) — reorders\nv.pop();           \u002F\u002F Option\u003CT>\nv.clear();\nv.truncate(2);\nv.retain(|x| *x > 0);   \u002F\u002F filter in place\nv.drain(1..3);          \u002F\u002F removes range, returns iterator\n",[15,116,114],{"__ignoreMap":41},[45,118,120],{"id":119},"capacity-management","Capacity Management",[35,122,125],{"className":123,"code":124,"language":40,"meta":41},[38],"v.shrink_to_fit();\nv.reserve(10);\nv.reserve_exact(10);\n",[15,126,124],{"__ignoreMap":41},[45,128,130],{"id":129},"sorting-searching","Sorting & Searching",[35,132,135],{"className":133,"code":134,"language":40,"meta":41},[38],"v.sort();\nv.sort_by(|a, b| b.cmp(a));\nv.sort_by_key(|x| x.abs());\nv.sort_unstable_by_key(|x| *x);    \u002F\u002F faster, non-stable\nv.dedup();                        \u002F\u002F remove consecutive duplicates (after sort)\nv.binary_search(&5);              \u002F\u002F Option\u003Cusize> on sorted vec\n",[15,136,134],{"__ignoreMap":41},[45,138,140],{"id":139},"edge-cases","Edge Cases",[60,142,143,156,164,177,185,199,215,226],{},[63,144,145,151,152,155],{},[146,147,148],"strong",{},[15,149,150],{},"v.push(v[0])",": borrow error (mutable borrow while reading). Copy first: ",[15,153,154],{},"let x = v[0]; v.push(x);",".",[63,157,158,163],{},[146,159,160],{},[15,161,162],{},"Vec::with_capacity(0)",": valid; first push triggers alloc.",[63,165,166,172,173,176],{},[146,167,168,169,171],{},"Empty ",[15,170,17],{}," is non-null",": ",[15,174,175],{},"Vec::new()"," doesn't allocate; capacity 0.",[63,178,179,184],{},[146,180,181],{},[15,182,183],{},"Vec\u003COption\u003CT>>",": not niche-optimized; uses full space.",[63,186,187,190,191,194,195,198],{},[146,188,189],{},"ZST elements",": a ",[15,192,193],{},"Vec\u003C()>"," has ",[15,196,197],{},"capacity = usize::MAX","; never actually allocates.",[63,200,201,207,208,211,212,155],{},[146,202,203,206],{},[15,204,205],{},"vec![]"," macro"," is hygienic — supports any ",[15,209,210],{},"T: Clone"," for ",[15,213,214],{},"vec![v; n]",[63,216,217,222,223,155],{},[146,218,219],{},[15,220,221],{},"Vec::leak",": leak into ",[15,224,225],{},"&'static mut [T]",[63,227,228,233],{},[146,229,230],{},[15,231,232],{},"Vec::spare_capacity_mut"," for unsafe manual writes.",[27,235,237,239],{"id":236},"string-owned-utf-8-string",[15,238,21],{}," — Owned UTF-8 String",[35,241,244],{"className":242,"code":243,"language":40,"meta":41},[38],"let s = String::new();\nlet s = String::from(\"hi\");\nlet s: String = \"hi\".to_string();\nlet s: String = \"hi\".to_owned();\ns.push_str(\" world\");\ns.push('!');\ns.replace(\"hi\", \"bye\");\ns.to_lowercase();\ns.split(' ').collect::\u003CVec\u003C_>>();\n",[15,245,243],{"__ignoreMap":41},[45,247,249],{"id":248},"utf-8-invariant","UTF-8 Invariant",[50,251,252,254,255,258],{},[15,253,21],{}," is a ",[15,256,257],{},"Vec\u003Cu8>"," with the invariant that bytes are valid UTF-8. You can't push arbitrary bytes:",[35,260,263],{"className":261,"code":262,"language":40,"meta":41},[38],"let bytes = vec![0xffu8];\n\u002F\u002F String::from_utf8(bytes).unwrap();  \u002F\u002F ERROR: invalid UTF-8\nString::from_utf8(bytes).unwrap_err(); \u002F\u002F ok\nString::from_utf8_lossy(&[0xffu8, b'h']);  \u002F\u002F \"�h\"\n",[15,264,262],{"__ignoreMap":41},[45,266,268,270,271],{"id":267},"string-vs-str",[15,269,21],{}," vs ",[15,272,273],{},"&str",[275,276,277,292],"table",{},[278,279,280],"thead",{},[281,282,283,288],"tr",{},[284,285,286],"th",{},[15,287,21],{},[284,289,290],{},[15,291,273],{},[293,294,295,304,312,323],"tbody",{},[281,296,297,301],{},[298,299,300],"td",{},"Owned, growable",[298,302,303],{},"Borrowed view",[281,305,306,309],{},[298,307,308],{},"Heap",[298,310,311],{},"Heap\u002Fstack\u002Fstatic",[281,313,314,320],{},[298,315,316,319],{},[15,317,318],{},"mut"," to grow",[298,321,322],{},"Read-only",[281,324,325,331],{},[298,326,327,328,330],{},"Can convert to ",[15,329,273],{}," freely",[298,332,333,334,336],{},"Can be obtained from ",[15,335,21],{}," cheaply",[45,338,340],{"id":339},"common-conversions","Common Conversions",[35,342,345],{"className":343,"code":344,"language":40,"meta":41},[38],"let s: String = String::from(\"hi\");\nlet r: &str = &s;\nlet r: &str = s.as_str();\nlet owned: String = r.to_string();\nlet bytes: Vec\u003Cu8> = s.into_bytes();\nlet s: String = String::from_utf8(bytes).unwrap();\nlet s: String = unsafe { String::from_utf8_unchecked(bytes) };   \u002F\u002F fast, dangerous\n",[15,346,344],{"__ignoreMap":41},[45,348,350],{"id":349},"byte-oriented-operations","Byte-Oriented Operations",[35,352,355],{"className":353,"code":354,"language":40,"meta":41},[38],"let s = \"hello\";\nfor b in s.bytes() { \u002F* u8 *\u002F }\nfor c in s.chars() { \u002F* char *\u002F }\nfor (i, c) in s.char_indices() { \u002F* (byte_offset, char) *\u002F }\ns.as_bytes();      \u002F\u002F &[u8]\n",[15,356,354],{"__ignoreMap":41},[45,358,360],{"id":359},"concatenation","Concatenation",[35,362,365],{"className":363,"code":364,"language":40,"meta":41},[38],"let s = String::from(\"a\") + \"b\" + \"c\";   \u002F\u002F + takes String by value, &str args\nlet s = [\"a\", \"b\", \"c\"].concat();\nlet s = format!(\"{}-{}\", \"a\", \"b\");\nlet s: String = \"a\".to_string() + \"b\";\n",[15,366,364],{"__ignoreMap":41},[45,368,140],{"id":369},"edge-cases-1",[60,371,372,392,400,408,425],{},[63,373,374,380,381,383,384,387,388,391],{},[146,375,376,379],{},[15,377,378],{},"s[0]"," panics",": there's no byte indexing of ",[15,382,21],{},". Use ",[15,385,386],{},"s.as_bytes()[0]"," for bytes, ",[15,389,390],{},"s.chars().nth(0)"," for chars.",[63,393,394,399],{},[146,395,396,379],{},[15,397,398],{},"s[1..4]"," if not on char boundary.",[63,401,402,407],{},[146,403,404],{},[15,405,406],{},"String::remove(i)",": byte-indexed; must be on char boundary.",[63,409,410,416,417,420,421,424],{},[146,411,412,415],{},[15,413,414],{},"split('\\n')"," doesn't include trailing empty",": use ",[15,418,419],{},"split_terminator","\u002F",[15,422,423],{},"split_inclusive"," for variations.",[63,426,427,440,441,443,444,155],{},[146,428,429,432,433,436,437],{},[15,430,431],{},"lines()"," splits on ",[15,434,435],{},"\\n"," and ",[15,438,439],{},"\\r\\n",", but ",[15,442,414],{}," doesn't strip ",[15,445,446],{},"\\r",[27,448,450,436,453],{"id":449},"hashmapk-v-and-btreemapk-v",[15,451,452],{},"HashMap\u003CK, V>",[15,454,455],{},"BTreeMap\u003CK, V>",[35,457,460],{"className":458,"code":459,"language":40,"meta":41},[38],"use std::collections::HashMap;\nlet mut m: HashMap\u003CString, i32> = HashMap::new();\nm.insert(\"a\".into(), 1);\nm.entry(\"b\".into()).or_insert(2);\nm.entry(\"a\".into()).and_modify(|v| *v += 1).or_insert(0);\nlet v = m.get(\"a\");          \u002F\u002F Option\u003C&i32>\nlet v = m.get_key_value(\"a\");\nm.remove(\"a\");\nfor (k, v) in &m { \u002F* ... *\u002F }\n",[15,461,459],{"__ignoreMap":41},[60,463,464,476],{},[63,465,466,468,469,420,472,475],{},[15,467,24],{}," uses hashing (SipHash by default, secure but slower; use ",[15,470,471],{},"FxHashMap",[15,473,474],{},"AHashMap"," for perf).",[63,477,478,481],{},[15,479,480],{},"BTreeMap"," keeps keys sorted (binary tree), iteration is ordered, lookups are O(log n) vs HashMap's amortized O(1).",[45,483,485,488],{"id":484},"entry-api",[15,486,487],{},"entry"," API",[50,490,491],{},"The idiomatic way to \"insert if absent, else modify\":",[35,493,496],{"className":494,"code":495,"language":40,"meta":41},[38],"m.entry(key).or_insert_with(|| expensive_default());\n*m.entry(key).or_insert(0) += 1;\n",[15,497,495],{"__ignoreMap":41},[45,499,501],{"id":500},"custom-keys","Custom Keys",[35,503,506],{"className":504,"code":505,"language":40,"meta":41},[38],"#[derive(Hash, Eq, PartialEq)]\nstruct MyKey { \u002F* ... *\u002F }\n",[15,507,505],{"__ignoreMap":41},[50,509,510,512,513,516,517,512,519,155],{},[15,511,24],{}," requires ",[15,514,515],{},"Hash + Eq",". ",[15,518,480],{},[15,520,521],{},"Ord",[45,523,140],{"id":524},"edge-cases-2",[60,526,527,540,548,560,569],{},[63,528,529,532,533,535,536,420,538,155],{},[146,530,531],{},"Float keys",": not ",[15,534,515],{}," (NaN), so can't be in ",[15,537,24],{},[15,539,480],{},[63,541,542,547],{},[146,543,544,546],{},[15,545,24],{}," iteration order is random"," per run (uses random seed). Don't rely on order.",[63,549,550,555,556,559],{},[146,551,552],{},[15,553,554],{},"BTreeMap::range",": efficient range queries (",[15,557,558],{},"m.range('a'..='z')",").",[63,561,562,172,565,568],{},[146,563,564],{},"Capacity",[15,566,567],{},"HashMap::with_capacity"," pre-allocates.",[63,570,571,576,577,155],{},[146,572,573],{},[15,574,575],{},"mem::take(&mut map[key])",": extract a value, replacing with ",[15,578,579],{},"Default",[27,581,583,436,586],{"id":582},"hashset-and-btreeset",[15,584,585],{},"HashSet",[15,587,588],{},"BTreeSet",[35,590,593],{"className":591,"code":592,"language":40,"meta":41},[38],"use std::collections::HashSet;\nlet mut s: HashSet\u003Ci32> = HashSet::new();\ns.insert(1);\ns.contains(&1);\ns.remove(&1);\ns.intersection(&other).collect::\u003CHashSet\u003C_>>();\ns.union(&other);\ns.difference(&other);\ns.symmetric_difference(&other);\ns.is_subset(&other);\ns.is_disjoint(&other);\n",[15,594,592],{"__ignoreMap":41},[27,596,598,601],{"id":597},"vecdequet-double-ended-queue",[15,599,600],{},"VecDeque\u003CT>"," — Double-Ended Queue",[35,603,606],{"className":604,"code":605,"language":40,"meta":41},[38],"use std::collections::VecDeque;\nlet mut dq: VecDeque\u003Ci32> = VecDeque::new();\ndq.push_back(1); dq.push_front(0);\ndq.pop_back(); dq.pop_front();\n",[15,607,605],{"__ignoreMap":41},[50,609,610],{},"Ring buffer; O(1) push\u002Fpop on both ends.",[27,612,614,617],{"id":613},"linkedlistt-rarely-needed",[15,615,616],{},"LinkedList\u003CT>"," — Rarely Needed",[50,619,620,623,624,627,628,631,632,155],{},[15,621,622],{},"std::collections::LinkedList"," is a doubly-linked list. Almost always the wrong choice — use ",[15,625,626],{},"VecDeque"," instead. Linked lists are cache-unfriendly; their only advantage is O(1) splicing, which Rust's ",[15,629,630],{},"LinkedList"," supports via ",[15,633,634],{},"append",[27,636,638,641],{"id":637},"binaryheapt-max-heap",[15,639,640],{},"BinaryHeap\u003CT>"," — Max-Heap",[35,643,646],{"className":644,"code":645,"language":40,"meta":41},[38],"use std::collections::BinaryHeap;\nlet mut h = BinaryHeap::new();\nh.push(5); h.push(1); h.push(10);\nh.pop();     \u002F\u002F 10\n",[15,647,645],{"__ignoreMap":41},[50,649,650,651,654,655,58],{},"For a min-heap, wrap with ",[15,652,653],{},"Reverse"," or ",[15,656,657],{},"std::cmp::Reverse",[35,659,662],{"className":660,"code":661,"language":40,"meta":41},[38],"let mut h: BinaryHeap\u003Cstd::cmp::Reverse\u003Ci32>> = BinaryHeap::new();\nh.push(std::cmp::Reverse(5));\n",[15,663,661],{"__ignoreMap":41},[27,665,667],{"id":666},"other-useful-collections-std-crates","Other Useful Collections (std + crates)",[60,669,670,678,687,699,705,711,717,723],{},[63,671,672,18,674,18,676],{},[15,673,626],{},[15,675,585],{},[15,677,588],{},[63,679,680,683,684],{},[15,681,682],{},"IndexMap"," (preserves insertion order) — crate ",[15,685,686],{},"indexmap",[63,688,689,420,691,694,695,698],{},[15,690,471],{},[15,692,693],{},"FxHashSet"," — crate ",[15,696,697],{},"fxhash",", fast non-crypto hash",[63,700,701,704],{},[15,702,703],{},"ahash::AHashMap"," — fast non-crypto hash",[63,706,707,710],{},[15,708,709],{},"smallvec::SmallVec"," — inline storage, avoids heap for small sizes",[63,712,713,716],{},[15,714,715],{},"arrayvec::ArrayVec"," — stack-only, fixed capacity",[63,718,719,722],{},[15,720,721],{},"bytes::Bytes"," — cheap clone byte buffers (network\u002FIO)",[63,724,725,728],{},[15,726,727],{},"ropey"," — large text manipulation (Rope data structure)",[27,730,732],{"id":731},"choosing-a-collection","Choosing a Collection",[275,734,735,745],{},[278,736,737],{},[281,738,739,742],{},[284,740,741],{},"You want",[284,743,744],{},"Use",[293,746,747,756,765,774,783,792,802,816],{},[281,748,749,752],{},[298,750,751],{},"Sequence, push\u002Fpop back",[298,753,754],{},[15,755,17],{},[281,757,758,761],{},[298,759,760],{},"Sequence, both ends",[298,762,763],{},[15,764,626],{},[281,766,767,770],{},[298,768,769],{},"Map with arbitrary keys",[298,771,772],{},[15,773,24],{},[281,775,776,779],{},[298,777,778],{},"Map with sorted keys \u002F ranges",[298,780,781],{},[15,782,480],{},[281,784,785,788],{},[298,786,787],{},"Unique elements",[298,789,790],{},[15,791,585],{},[281,793,794,797],{},[298,795,796],{},"Priority queue",[298,798,799],{},[15,800,801],{},"BinaryHeap",[281,803,804,807],{},[298,805,806],{},"Small, known max size",[298,808,809,812,813],{},[15,810,811],{},"ArrayVec"," \u002F ",[15,814,815],{},"SmallVec",[281,817,818,821],{},[298,819,820],{},"Often-cloned byte buffer",[298,822,823],{},[15,824,721],{},[27,826,828],{"id":827},"summary","Summary",[50,830,831,833,834,836,837,420,839,841,842,844],{},[15,832,17],{}," is the workhorse — understand its memory model (capacity doubling, amortized O(1)). ",[15,835,21],{}," is UTF-8-aware; never confuse bytes with chars. ",[15,838,24],{},[15,840,480],{}," are the map workhorses; the ",[15,843,487],{}," API is idiomatic. Pick the right collection for the access pattern.",[50,846,847],{},"Next: Iterators and combinators — the functional side of Rust.",{"title":41,"searchDepth":849,"depth":849,"links":850},2,[851,862,872,879,881,883,885,887,888,889],{"id":29,"depth":849,"text":852,"children":853},"Vec\u003CT> — The Growable Array",[854,856,857,858,859,860,861],{"id":47,"depth":855,"text":48},3,{"id":89,"depth":855,"text":90},{"id":99,"depth":855,"text":100},{"id":109,"depth":855,"text":110},{"id":119,"depth":855,"text":120},{"id":129,"depth":855,"text":130},{"id":139,"depth":855,"text":140},{"id":236,"depth":849,"text":863,"children":864},"String — Owned UTF-8 String",[865,866,868,869,870,871],{"id":248,"depth":855,"text":249},{"id":267,"depth":855,"text":867},"String vs &str",{"id":339,"depth":855,"text":340},{"id":349,"depth":855,"text":350},{"id":359,"depth":855,"text":360},{"id":369,"depth":855,"text":140},{"id":449,"depth":849,"text":873,"children":874},"HashMap\u003CK, V> and BTreeMap\u003CK, V>",[875,877,878],{"id":484,"depth":855,"text":876},"entry API",{"id":500,"depth":855,"text":501},{"id":524,"depth":855,"text":140},{"id":582,"depth":849,"text":880},"HashSet and BTreeSet",{"id":597,"depth":849,"text":882},"VecDeque\u003CT> — Double-Ended Queue",{"id":613,"depth":849,"text":884},"LinkedList\u003CT> — Rarely Needed",{"id":637,"depth":849,"text":886},"BinaryHeap\u003CT> — Max-Heap",{"id":666,"depth":849,"text":667},{"id":731,"depth":849,"text":732},{"id":827,"depth":849,"text":828},"md",{},true,"\u002Frust\u002F14-collections",{"title":5,"description":41},"rust\u002F14-collections","lraKW6YZ1Bx4GcHZDRngFhkkx-xnIFyNJqi7SKZPqHI",1785935255230]