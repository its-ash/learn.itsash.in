[{"data":1,"prerenderedAt":1021},["ShallowReactive",2],{"page-\u002Frust\u002F25-unsafe-rust":3},{"id":4,"title":5,"body":6,"description":1013,"extension":1014,"meta":1015,"navigation":1016,"path":1017,"seo":1018,"stem":1019,"__hash__":1020},"content\u002Frust\u002F25-unsafe-rust.md","25 — Unsafe Rust",{"type":7,"value":8,"toc":967},"minimark",[9,13,26,70,77,84,94,105,111,123,127,133,163,168,181,185,191,200,206,215,221,227,239,245,250,256,266,270,276,282,289,295,312,319,325,345,349,355,364,368,381,401,408,413,421,424,428,482,488,492,495,501,508,516,524,528,534,558,562,566,572,578,584,590,597,603,614,633,637,643,651,657,666,701,705,814,820,889,893,925,934,938,964],[10,11,5],"h1",{"id":12},"_25-unsafe-rust",[14,15,16,20,21,25],"p",{},[17,18,19],"code",{},"unsafe"," lets you do things the compiler can't verify. It doesn't turn off the borrow checker — it adds five ",[22,23,24],"strong",{},"superpowers",":",[27,28,29,41,47,60,67],"ol",{},[30,31,32,33,36,37,40],"li",{},"Dereference raw pointers (",[17,34,35],{},"*const T",", ",[17,38,39],{},"*mut T",").",[30,42,43,44,46],{},"Call ",[17,45,19],{}," functions (including FFI).",[30,48,49,50,52,53,56,57,40],{},"Implement ",[17,51,19],{}," traits (e.g., ",[17,54,55],{},"Send","\u002F",[17,58,59],{},"Sync",[30,61,62,63,66],{},"Access\u002Fmutate ",[17,64,65],{},"static mut"," globals.",[30,68,69],{},"Access union fields.",[14,71,72,73,76],{},"The rest of Rust still applies (borrowing, types, lifetimes). Unsafe is a contract: ",[22,74,75],{},"you"," prove soundness; the compiler trusts you.",[78,79,81,83],"h2",{"id":80},"unsafe-blocks",[17,82,19],{}," Blocks",[85,86,92],"pre",{"className":87,"code":89,"language":90,"meta":91},[88],"language-rust","let p: *const i32 = &5;\nunsafe {\n    println!(\"{}\", *p);\n}\n","rust","",[17,93,89],{"__ignoreMap":91},[14,95,96,99,100,102,103,40],{},[17,97,98],{},"unsafe fn"," is a function whose body requires unsafe — calling it from safe code is allowed only in an ",[17,101,19],{}," block (or ",[17,104,98],{},[85,106,109],{"className":107,"code":108,"language":90,"meta":91},[88],"unsafe fn dangerous() {}\nunsafe { dangerous(); }   \u002F\u002F OK\n",[17,110,108],{"__ignoreMap":91},[14,112,113,114,116,117,119,120,122],{},"In edition 2024+, calling ",[17,115,98],{}," inside ",[17,118,98],{}," also requires an explicit ",[17,121,19],{}," block (no longer implicit).",[78,124,126],{"id":125},"raw-pointers","Raw Pointers",[85,128,131],{"className":129,"code":130,"language":90,"meta":91},[88],"let x = 5;\nlet p1: *const i32 = &x;        \u002F\u002F implicit coercion\nlet p2: *mut i32 = &mut x as *mut i32;\n\nunsafe { println!(\"{} {}\", *p1, *p2); }\n",[17,132,130],{"__ignoreMap":91},[134,135,136,144,150,155],"ul",{},[30,137,138,140,141,143],{},[17,139,35],{}," (read-only) and ",[17,142,39],{}," (writable).",[30,145,146,147,149],{},"Can be created from any reference, even outside ",[17,148,19],{},".",[30,151,152,153,149],{},"Dereferencing requires ",[17,154,19],{},[30,156,157,158,56,160,162],{},"Not ",[17,159,55],{},[17,161,59],{}," by default.",[164,165,167],"h3",{"id":166},"validity-invariants","Validity Invariants",[14,169,170,171,173,174,177,178,149],{},"Reading a ",[17,172,35],{}," requires the pointer to point to a valid ",[17,175,176],{},"T"," (properly initialized, properly aligned). Dereferencing an uninitialized or misaligned pointer is ",[22,179,180],{},"undefined behavior (UB)",[78,182,184],{"id":183},"ffi","FFI",[85,186,189],{"className":187,"code":188,"language":90,"meta":91},[88],"extern \"C\" {\n    fn abs(x: i32) -> i32;\n}\n\nfn main() {\n    unsafe { println!(\"{}\", abs(-5)); }\n}\n",[17,190,188],{"__ignoreMap":91},[14,192,193,194,196,197,25],{},"Calling C functions requires ",[17,195,19],{},". Functions can be marked ",[17,198,199],{},"extern \"C\"",[85,201,204],{"className":202,"code":203,"language":90,"meta":91},[88],"#[no_mangle]\npub extern \"C\" fn add(a: i32, b: i32) -> i32 { a + b }\n",[17,205,203],{"__ignoreMap":91},[14,207,208,211,212,214],{},[17,209,210],{},"#[no_mangle]"," preserves the symbol name for C to call. ",[17,213,199],{}," sets the ABI.",[78,216,218,220],{"id":217},"unsafe-traits",[17,219,19],{}," Traits",[85,222,225],{"className":223,"code":224,"language":90,"meta":91},[88],"unsafe trait TrustedIter {}\nunsafe impl TrustedIter for std::slice::Iter\u003C'static, u8> {}\n",[17,226,224],{"__ignoreMap":91},[14,228,229,231,232,234,235,238],{},[17,230,55],{}," and ",[17,233,59],{}," are unsafe traits; the compiler auto-derives them, but you can opt in via ",[17,236,237],{},"unsafe impl"," if you've verified thread-safety.",[85,240,243],{"className":241,"code":242,"language":90,"meta":91},[88],"struct MyType(*mut u8);\nunsafe impl Send for MyType {}     \u002F\u002F we promise the pointer is safe to move to another thread\n",[17,244,242],{"__ignoreMap":91},[78,246,248],{"id":247},"static-mut",[17,249,65],{},[85,251,254],{"className":252,"code":253,"language":90,"meta":91},[88],"static mut COUNTER: u32 = 0;\n\nfn incr() {\n    unsafe { COUNTER += 1; }\n}\n",[17,255,253],{"__ignoreMap":91},[134,257,258,263],{},[30,259,260,261,149],{},"Reading\u002Fwriting requires ",[17,262,19],{},[30,264,265],{},"No synchronization — use atomics instead.",[78,267,269],{"id":268},"unions","Unions",[85,271,274],{"className":272,"code":273,"language":90,"meta":91},[88],"union Value {\n    int_val: i32,\n    float_val: f32,\n}\n\nlet v = Value { int_val: 5 };\nunsafe { println!(\"{}\", v.float_val); }   \u002F\u002F ⚠️ UB if int_val was the active field\n",[17,275,273],{"__ignoreMap":91},[14,277,278,279,281],{},"Unions overlap memory; reading the inactive field is UB. Reading requires ",[17,280,19],{},". Useful for FFI\u002FC interop; otherwise use enums.",[78,283,285,288],{"id":284},"maybeuninitt-uninitialized-memory",[17,286,287],{},"MaybeUninit\u003CT>"," — Uninitialized Memory",[85,290,293],{"className":291,"code":292,"language":90,"meta":91},[88],"use std::mem::MaybeUninit;\n\nlet mut mu: MaybeUninit\u003CVec\u003Cu8>> = MaybeUninit::uninit();\nunsafe { mu.write(Vec::new()); }\nlet v: Vec\u003Cu8> = unsafe { mu.assume_init() };\n",[17,294,292],{"__ignoreMap":91},[14,296,297,299,300,304,305,307,308,311],{},[17,298,287],{}," is the safe way to ",[301,302,303],"em",{},"hold"," uninitialized memory; reading it requires ",[17,306,19],{},". The standard alternative to uninitialized ",[17,309,310],{},"mem::uninitialized"," (deprecated).",[78,313,315,318],{"id":314},"manuallydropt-suppress-drop",[17,316,317],{},"ManuallyDrop\u003CT>"," — Suppress Drop",[85,320,323],{"className":321,"code":322,"language":90,"meta":91},[88],"use std::mem::ManuallyDrop;\nlet s = ManuallyDrop::new(String::from(\"hi\"));\n\u002F\u002F s's destructor won't run; manual cleanup needed\nunsafe { drop(ManuallyDrop::into_inner(s)) };   \u002F\u002F no, into_inner extracts\n",[17,324,322],{"__ignoreMap":91},[14,326,327,329,330,332,333,336,337,340,341,344],{},[17,328,317],{}," wraps a ",[17,331,176],{}," and disables its ",[17,334,335],{},"Drop",". Use ",[17,338,339],{},"ManuallyDrop::into_inner"," to recover the value, or ",[17,342,343],{},"unsafe { ManuallyDrop::take(&mut md) }"," to extract without dropping.",[78,346,348],{"id":347},"splitting-borrows-safely","Splitting Borrows Safely",[85,350,353],{"className":351,"code":352,"language":90,"meta":91},[88],"let mut v = vec![1, 2, 3, 4];\nlet slice: &mut [i32] = &mut v[..];\nlet (left, right) = slice.split_at_mut(2);\n\u002F\u002F left = &mut [1, 2], right = &mut [3, 4]\n",[17,354,352],{"__ignoreMap":91},[14,356,357,360,361,363],{},[17,358,359],{},"split_at_mut"," is internally ",[17,362,19],{}," because the compiler can't prove disjointness, but it's a safe API.",[78,365,367],{"id":366},"unsafe-code-soundness","Unsafe Code Soundness",[14,369,370,371,373,374,377,378,380],{},"A piece of ",[17,372,19],{}," code is ",[22,375,376],{},"sound"," if safe code can't trigger UB through its public API. Writing sound ",[17,379,19],{}," requires:",[134,382,383,386,392,395],{},[30,384,385],{},"Reasoning about aliasing, alignment, lifetimes, initialization, thread-safety.",[30,387,388,389,40],{},"Documenting invariants (",[17,390,391],{},"\u002F\u002F SAFETY: ...",[30,393,394],{},"Considering all possible inputs.",[30,396,397,398,400],{},"Not leaking ",[17,399,19],{}," to safe callers.",[14,402,403,404,407],{},"Miri (",[17,405,406],{},"cargo +nightly miri test",") is a tool that detects UB in unsafe code at runtime — use it.",[78,409,411],{"id":410},"miri",[17,412,410],{},[85,414,419],{"className":415,"code":417,"language":418,"meta":91},[416],"language-bash","rustup +nightly component add miri\ncargo +nightly miri test\n","bash",[17,420,417],{"__ignoreMap":91},[14,422,423],{},"Miri interprets your code and catches many UB forms (invalid pointer arithmetic, unaligned access, data races in some cases, use of uninitialized memory). Doesn't catch all bugs but catches many.",[78,425,427],{"id":426},"common-sources-of-ub","Common Sources of UB",[134,429,430,433,436,439,442,447,450,456,462,472],{},[30,431,432],{},"Dereferencing a NULL, dangling, or misaligned pointer.",[30,434,435],{},"Reading uninitialized memory as a typed value.",[30,437,438],{},"Reading a union's inactive field.",[30,440,441],{},"Data races (concurrent reads + writes to the same memory without synchronization).",[30,443,444,445,40],{},"Mutating immutable data (via ",[17,446,19],{},[30,448,449],{},"Calling a function with the wrong ABI.",[30,451,452,453,455],{},"Violating the ",[17,454,335],{}," ordering or skipping destructors of owned data.",[30,457,458,459,461],{},"Integer overflow in ",[17,460,19],{}," (e.g., pointer arithmetic that wraps).",[30,463,464,465,468,469,40],{},"Unwinding across FFI boundaries (set ",[17,466,467],{},"panic = \"abort\""," or use ",[17,470,471],{},"catch_unwind",[30,473,474,475,478,479,40],{},"Constructing invalid enum values (e.g., transmuting a number to ",[17,476,477],{},"Option\u003CNonNull\u003CT>>"," that creates ",[17,480,481],{},"Some(null)",[78,483,485,487],{"id":484},"unsafe-patterns",[17,486,19],{}," Patterns",[164,489,491],{"id":490},"safe-abstractions-over-unsafe","Safe Abstractions over Unsafe",[14,493,494],{},"The idiomatic way: expose a safe API, do the unsafe internally:",[85,496,499],{"className":497,"code":498,"language":90,"meta":91},[88],"pub fn first_byte(s: &str) -> u8 {\n    let ptr = s.as_ptr();\n    unsafe { *ptr }   \u002F\u002F SAFETY: ptr is valid (s is a valid &str)\n}\n",[17,500,498],{"__ignoreMap":91},[14,502,503,504,507],{},"Comment with ",[17,505,506],{},"\u002F\u002F SAFETY:"," explaining why each unsafe operation is sound.",[164,509,511,56,514],{"id":510},"unsafe-impl-sendsync",[17,512,513],{},"unsafe impl Send",[17,515,59],{},[14,517,518,519,56,521,523],{},"Only when you've verified the type can be safely transferred\u002Fshared across threads. Usually because the inner is ",[17,520,55],{},[17,522,59],{}," via raw pointer you control.",[164,525,527],{"id":526},"reusing-raw-memory","Reusing Raw Memory",[85,529,532],{"className":530,"code":531,"language":90,"meta":91},[88],"let mut buf: Vec\u003Cu8> = Vec::with_capacity(100);\nlet ptr = buf.as_mut_ptr() as *mut u64;\nunsafe { *ptr = 5; }   \u002F\u002F ⚠️ requires valid alignment and within capacity\n",[17,533,531],{"__ignoreMap":91},[14,535,536,539,540,36,543,546,547,550,551,554,555,149],{},[17,537,538],{},"Vec\u003Cu8>"," allocations are aligned to ",[17,541,542],{},"u8",[22,544,545],{},"not"," ",[17,548,549],{},"u64",". To get a properly-aligned buffer, use ",[17,552,553],{},"Vec\u003Cu64>"," directly or ",[17,556,557],{},"alloc::alloc_aligned",[78,559,561],{"id":560},"ffi-patterns","FFI Patterns",[164,563,565],{"id":564},"owning-foreign-memory","Owning Foreign Memory",[85,567,570],{"className":568,"code":569,"language":90,"meta":91},[88],"struct Buffer(*mut u8, usize);\nimpl Drop for Buffer {\n    fn drop(&mut self) {\n        unsafe { free(self.0) }\n    }\n}\nunsafe impl Send for Buffer {}\n",[17,571,569],{"__ignoreMap":91},[14,573,574,575,577],{},"RAII: the constructor allocates, ",[17,576,335],{}," deallocates.",[164,579,581,583],{"id":580},"extern-c-block-with-variadics",[17,582,199],{}," Block with Variadics",[85,585,588],{"className":586,"code":587,"language":90,"meta":91},[88],"extern \"C\" {\n    fn printf(fmt: *const u8, ...) -> i32;\n}\n",[17,589,587],{"__ignoreMap":91},[164,591,593,596],{"id":592},"link-attributes",[17,594,595],{},"link"," Attributes",[85,598,601],{"className":599,"code":600,"language":90,"meta":91},[88],"#[link(name = \"crypto\")]\nextern \"C\" {\n    fn sha256(input: *const u8, len: usize) -> *mut u8;\n}\n",[17,602,600],{"__ignoreMap":91},[78,604,606,36,608,36,611],{"id":605},"no_mangle-export_name-link_name",[17,607,210],{},[17,609,610],{},"#[export_name]",[17,612,613],{},"#[link_name]",[134,615,616,621,627],{},[30,617,618,620],{},[17,619,210],{},": keep the function's name as-is in the symbol table.",[30,622,623,626],{},[17,624,625],{},"#[export_name = \"foo\"]",": rename the exported symbol.",[30,628,629,632],{},[17,630,631],{},"#[link_name = \"...\"]",": rename the symbol you're linking against.",[78,634,636],{"id":635},"bindgen","Bindgen",[14,638,639,640,642],{},"Use ",[17,641,635],{}," to auto-generate Rust FFI bindings from C headers:",[85,644,649],{"className":645,"code":647,"language":648,"meta":91},[646],"language-toml","[build-dependencies]\nbindgen = \"0.69\"\n","toml",[17,650,647],{"__ignoreMap":91},[85,652,655],{"className":653,"code":654,"language":90,"meta":91},[88],"\u002F\u002F build.rs\nfn main() {\n    let bindings = bindgen::Builder::default()\n        .header(\"wrapper.h\")\n        .generate().unwrap();\n    bindings.write_to_file(\"src\u002Fbindings.rs\").unwrap();\n}\n",[17,656,654],{"__ignoreMap":91},[78,658,660,662,663],{"id":659},"extern-c-vs-extern-rust",[17,661,199],{}," vs ",[17,664,665],{},"extern \"Rust\"",[14,667,668,669,671,672,674,675,36,678,681,682,684,685,688,689,36,692,36,695,36,698,149],{},"The default ABI is ",[17,670,665],{}," (not stable to name explicitly until 1.86+). C ABI is ",[17,673,199],{},". Other ABIs: ",[17,676,677],{},"stdcall",[17,679,680],{},"system"," (Windows: ",[17,683,677],{}," on x86, ",[17,686,687],{},"C"," on x64), ",[17,690,691],{},"aapcs",[17,693,694],{},"fastcall",[17,696,697],{},"win64",[17,699,700],{},"sysv64",[78,702,704],{"id":703},"edge-cases","Edge Cases",[134,706,707,721,732,740,748,761,773,795],{},[30,708,709,714,715,718,719,149],{},[22,710,711,713],{},[17,712,19],{}," doesn't disable the borrow checker",": you still can't have aliasing ",[17,716,717],{},"&mut T"," even with ",[17,720,19],{},[30,722,723,728,729,731],{},[22,724,725,727],{},[17,726,98],{}," body has implicit unsafe in pre-2024 editions",": 2024 changes this — explicit ",[17,730,19],{}," blocks required inside.",[30,733,734,739],{},[22,735,736],{},[17,737,738],{},"std::mem::transmute",": reinterprets bytes as another type. Extremely dangerous (size\u002Fvalidity\u002Falignment). Avoid; use specific methods.",[30,741,742,747],{},[22,743,744],{},[17,745,746],{},"std::mem::transmute_copy",": reads bytes from one place as another type — also very dangerous.",[30,749,750,757,758,149],{},[22,751,752,231,754],{},[17,753,19],{},[17,755,756],{},"async",": async unsafe functions are unstable; you can wrap blocking unsafe calls in ",[17,759,760],{},"spawn_blocking",[30,762,763,768,769,772],{},[22,764,765,767],{},[17,766,65],{}," races",": undetectable by ",[17,770,771],{},"cargo test"," in many cases; use atomics.",[30,774,775,785,786,788,789,791,792,149],{},[22,776,777,56,780,231,783],{},[17,778,779],{},"Cell",[17,781,782],{},"RefCell",[17,784,55],{},": not ",[17,787,59],{},", but they are ",[17,790,55],{}," if ",[17,793,794],{},"T: Send",[30,796,797,802,803,806,807,809,810,813],{},[22,798,799,800],{},"Pin and ",[17,801,19],{},": implementing your own ",[17,804,805],{},"Future"," requires ",[17,808,19],{}," because of ",[17,811,812],{},"Pin"," invariants.",[78,815,817,819],{"id":816},"unsafe-anti-patterns",[17,818,19],{}," Anti-Patterns",[134,821,822,837,846,861,876],{},[30,823,824,829,830,833,834,836],{},[22,825,826],{},[17,827,828],{},"unsafe impl Send for Rc\u003CT>",": ",[17,831,832],{},"Rc"," has a non-atomic refcount; making it ",[17,835,55],{}," causes data races.",[30,838,839,845],{},[22,840,841,842,844],{},"Bare ",[17,843,39],{}," in public API",": exposes raw pointer semantics; wrap in a safe abstraction.",[30,847,848,854,855,56,858,149],{},[22,849,850,853],{},[17,851,852],{},"transmute"," for type conversions",": use ",[17,856,857],{},"From",[17,859,860],{},"TryFrom",[30,862,863,871,872,875],{},[22,864,865,867,868],{},[17,866,98],{}," returning ",[17,869,870],{},"&'static T"," without ",[17,873,874],{},"'static"," input: usually lies.",[30,877,878,829,881,884,885,888],{},[22,879,880],{},"Assuming pointer alignment",[17,882,883],{},"&[u8]"," is aligned to 1; casting to ",[17,886,887],{},"&u64"," is UB unless you check.",[78,890,892],{"id":891},"when-to-use-unsafe","When to Use Unsafe",[134,894,895,898,911,914,917],{},[30,896,897],{},"FFI to C.",[30,899,900,901,36,904,36,907,910],{},"Implementing low-level collections (",[17,902,903],{},"Vec",[17,905,906],{},"HashMap",[17,908,909],{},"VecDeque"," internals).",[30,912,913],{},"Performance-critical code that can't be expressed safely (rare; usually the compiler is fine).",[30,915,916],{},"Interfacing with the OS (syscalls).",[30,918,919,920,56,922,924],{},"Implementing ",[17,921,55],{},[17,923,59],{}," for a wrapper you control.",[14,926,927,928,336,931,933],{},"Most Rust code is ",[22,929,930],{},"fully safe",[17,932,19],{}," sparingly; confine it to small, well-reviewed modules.",[78,935,937],{"id":936},"summary","Summary",[14,939,940,942,943,946,947,949,950,953,954,56,957,960,961,963],{},[17,941,19],{}," gives you five superpowers; the rest of Rust still applies. Aim for ",[22,944,945],{},"safe abstractions",": do the unsafe internally, expose a safe API, document ",[17,948,506],{}," invariants. Use ",[17,951,952],{},"Miri"," to catch UB. ",[17,955,956],{},"MaybeUninit",[17,958,959],{},"ManuallyDrop"," are safer than the legacy uninitialized-memory APIs. Confine ",[17,962,19],{}," to small audited surfaces.",[14,965,966],{},"Next: FFI deep dive.",{"title":91,"searchDepth":968,"depth":968,"links":969},2,[970,972,976,977,979,980,981,983,985,986,987,988,989,996,1003,1005,1006,1008,1009,1011,1012],{"id":80,"depth":968,"text":971},"unsafe Blocks",{"id":125,"depth":968,"text":126,"children":973},[974],{"id":166,"depth":975,"text":167},3,{"id":183,"depth":968,"text":184},{"id":217,"depth":968,"text":978},"unsafe Traits",{"id":247,"depth":968,"text":65},{"id":268,"depth":968,"text":269},{"id":284,"depth":968,"text":982},"MaybeUninit\u003CT> — Uninitialized Memory",{"id":314,"depth":968,"text":984},"ManuallyDrop\u003CT> — Suppress Drop",{"id":347,"depth":968,"text":348},{"id":366,"depth":968,"text":367},{"id":410,"depth":968,"text":410},{"id":426,"depth":968,"text":427},{"id":484,"depth":968,"text":990,"children":991},"unsafe Patterns",[992,993,995],{"id":490,"depth":975,"text":491},{"id":510,"depth":975,"text":994},"unsafe impl Send\u002FSync",{"id":526,"depth":975,"text":527},{"id":560,"depth":968,"text":561,"children":997},[998,999,1001],{"id":564,"depth":975,"text":565},{"id":580,"depth":975,"text":1000},"extern \"C\" Block with Variadics",{"id":592,"depth":975,"text":1002},"link Attributes",{"id":605,"depth":968,"text":1004},"#[no_mangle], #[export_name], #[link_name]",{"id":635,"depth":968,"text":636},{"id":659,"depth":968,"text":1007},"extern \"C\" vs extern \"Rust\"",{"id":703,"depth":968,"text":704},{"id":816,"depth":968,"text":1010},"unsafe Anti-Patterns",{"id":891,"depth":968,"text":892},{"id":936,"depth":968,"text":937},"unsafe lets you do things the compiler can't verify. It doesn't turn off the borrow checker — it adds five superpowers:","md",{},true,"\u002Frust\u002F25-unsafe-rust",{"title":5,"description":1013},"rust\u002F25-unsafe-rust","e8HANNgyX2nv9TPO-GlrnH-cJ3LWZq2ALqIV2tHsAcc",1785935255232]