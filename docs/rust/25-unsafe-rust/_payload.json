},"fn main() {\n    let v = vec![1, 2, 3];\n    let third = unsafe { *v.get_unchecked(2) };   \u002F\u002F no bounds check\n    println!(\"{third}\");                          \u002F\u002F 3\n    \u002F\u002F unsafe { *v.get_unchecked(10) };           \u002F\u002F UB — not a panic, reads random memory\n}\n",[17,542,543,551,582,617,632,640],{"__ignoreMap":120},[124,544,545,547,549],{"class":126,"line":127},[124,546,131],{"class":130},[124,548,135],{"class":134},[124,550,139],{"class":138},[124,552,553,555,558,560,563,566,569,571,574,576,579],{"class":126,"line":142},[124,554,145],{"class":130},[124,556,557],{"class":138}," v ",[124,559,154],{"class":130},[124,561,562],{"class":134}," vec!",[124,564,565],{"class":138},"[",[124,567,568],{"class":157},"1",[124,570,48],{"class":138},[124,572,573],{"class":157},"2",[124,575,48],{"class":138},[124,577,578],{"class":157},"3",[124,580,581],{"class":138},"];\n",[124,583,584,586,589,591,594,597,599,602,604,607,609,611,614],{"class":126,"line":164},[124,585,145],{"class":130},[124,587,588],{"class":138}," third ",[124,590,154],{"class":130},[124,592,593],{"class":130}," unsafe",[124,595,596],{"class":138}," { ",[124,598,281],{"class":130},[124,600,601],{"class":138},"v",[124,603,96],{"class":130},[124,605,606],{"class":134},"get_unchecked",[124,608,272],{"class":138},[124,610,573],{"class":157},[124,612,613],{"class":138},") };   ",[124,615,616],{"class":192},"\u002F\u002F no bounds check\n",[124,618,619,621,623,626,629],{"class":126,"line":196},[124,620,356],{"class":134},[124,622,272],{"class":138},[124,624,625],{"class":275},"\"{third}\"",[124,627,628],{"class":138},");                          ",[124,630,631],{"class":192},"\u002F\u002F 3\n",[124,633,634,637],{"class":126,"line":224},[124,635,636],{"class":192},"    \u002F\u002F unsafe { *v.get_unchecked(10) };",[124,638,639],{"class":192},"           \u002F\u002F UB — not a panic, reads random memory\n",[124,641,642],{"class":126,"line":231},[124,643,299],{"class":138},[14