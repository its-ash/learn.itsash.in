[{"data":1,"prerenderedAt":1875},["ShallowReactive",2],{"page-\u002Frust\u002F25-unsafe-rust":3},{"id":4,"title":5,"body":6,"description":1868,"extension":1869,"meta":1870,"navigation":227,"path":1871,"seo":1872,"stem":1873,"__hash__":1874},"content\u002Frust\u002F25-unsafe-rust.md","25 — Unsafe Rust",{"type":7,"value":8,"toc":1852},"minimark",[9,13,33,38,87,97,101,111,300,303,445,451,529,532,536,644,659,663,673,999,1019,1024,1161,1166,1260,1274,1281,1393,1404,1408,1476,1480,1537,1541,1699,1833,1836,1845,1848],[10,11,5],"h1",{"id":12},"_25-unsafe-rust",[14,15,16,20,21,23,24,28,29,32],"p",{},[17,18,19],"code",{},"unsafe"," lets you do five things the compiler can't check. Inside an ",[17,22,19],{}," block ",[25,26,27],"strong",{},"you"," promise the rules are kept. If you break them, the result is ",[25,30,31],{},"undefined behavior (UB)",": anything can happen, including \"seems to work\".",[34,35,37],"h2",{"id":36},"the-five-unsafe-abilities","The Five Unsafe Abilities",[39,40,41,53,60,66,80],"ol",{},[42,43,44,45,48,49,52],"li",{},"Dereference a raw pointer (",[17,46,47],{},"*const T",", ",[17,50,51],{},"*mut T",")",[42,54,55,56,59],{},"Call an ",[17,57,58],{},"unsafe fn"," (including C functions)",[42,61,62,63],{},"Read or write a ",[17,64,65],{},"static mut",[42,67,68,69,72,73,76,77,52],{},"Implement an ",[17,70,71],{},"unsafe trait"," (like ",[17,74,75],{},"Send","\u002F",[17,78,79],{},"Sync",[42,81,82,83,86],{},"Read a ",[17,84,85],{},"union"," field",[14,88,89,90,93,94,96],{},"That's all. Everything else — borrow checking, type checking, bounds checks on ",[17,91,92],{},"v[i]"," — still works inside ",[17,95,19],{},".",[34,98,100],{"id":99},"raw-pointers","Raw Pointers",[14,102,103,106,107,110],{},[25,104,105],{},"Tricky",": making a raw pointer is safe; ",[25,108,109],{},"using"," it is not:",[112,113,115],"code-wrapper",{"language":114},"rust",[116,117,121],"pre",{"className":118,"code":119,"language":114,"meta":120,"style":120},"language-rust shiki shiki-th