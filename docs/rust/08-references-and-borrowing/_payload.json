},[36,491,493],{"className":38,"code":492,"language":34,"meta":40,"style":40},"let mut v = vec![1, 2, 3];\nlet r = &v;\nprintln!(\"{r}\");      \u002F\u002F last use of r\nv.push(4);           \u002F\u002F OK — r no longer used\n",[28,494,495,521,533,548],{"__ignoreMap":40},[44,496,497,499,501,503,505,507,509,511,513,515,517,519],{"class":46,"line":47},[44,498,102],{"class":50},[44,500,257],{"class":50},[44,502,375],{"class":58},[44,504,108],{"class":50},[44,506,380],{"class":54},[44,508,383],{"class":58},[44,510,387],{"class":386},[44,512,390],{"class":58},[44,514,393],{"class":386},[44,516,390],{"class":58},[44,518,398],{"class":386},[44,520,401],{"class":58},[44,522,523,525,527,529,531],{"class":46,"line":92},[44,524,102],{"class":50},[44,526,408],{"class":58},[44,528,108],{"class":50},[44,530,65],{"class":50},[44,532,415],{"class":58},[44,534,535,537,539,542,545],{"class":46,"line":99},[44,536,157],{"class":54},[44,538,120],{"class":58},[44,540,541],{"class":123},"\"{r}\"",[44,543,544],{"class":58},");      ",[44,546,547],{"class":150},"\u002F\u002F last use of r\n",[44,549,550,553,555,557,559,561,564],{"class":46,"line":130},[44,551,552],{"class":58},"v",[44,554,83],{"class":50},[44,556,238],{"class":54},[44,558,120],{"class":58},[44,560,475],{"class":386},[44,562,563],{"class":58},");           ",[44,565,566],{"class":150},"\u002F\u002F OK — r no longer used\n",[14,568,569],{},"Without NLL this would error. With NLL it compiles.",[23,571,573],{"id":572},"tips-tricks","💡 Tips & Tricks",[170,575,576,586,599,615,632,652],{},[173,577,578,581,582,585],{},[18,579,580],{},"Debug",": when the borrow checker rejects code you're sure is fine, add explicit ",[28,583,584],{},"{ }"," blocks around each borrow's intended lifetime — this often reveals exactly where NLL's \"last use\" inference disagrees with your mental model, before you touch a single type.",[173,587,588,591,592,595,596,598],{},[18,589,590],{},"Idiom",": prefer reborrowing (",[28,593,594],{},"&mut *r",") over passing the original ",[28,597,207],{}," by value into a helper you'll need again afterward — reborrowing keeps the original reference alive (just temporarily inactive) instead of moving it away permanently.",[173,600,601,603,604,390,607,610,611,614],{},[18,602,590],{},": split borrows on distinct struct fields (",[28,605,606],{},"&mut s.x",[28,608,609],{},"&mut s.y",") instead of taking one ",[28,612,613],{},"&mut s"," and threading it through — the compiler can see field-level disjointness but not disjointness hidden behind a single struct-wide borrow.",[173,616,617,619,620,623,624,627,628,631],{},[18,618,580],{},": ",[28,621,622],{},"cargo build --edition 2021"," (or checking your ",[28,625,626],{},"Cargo.toml","'s ",[28,629,630],{},"edition"," key) matters for borrow-checker behavior — NLL and 2021 disjoint closure captures relax rules that were errors under the 2015\u002F2018 borrow checker, so an old edition can reject code a newer one accepts.",[173,633,634,619,637,640,641,644,645,640,648,651],{},[18,635,636],{},"Performance",[28,638,639],{},"&[T]","\u002F",[28,642,643],{},"&str"," function parameters cost nothing over ",[28,646,647],{},"&Vec\u003CT>",[28,649,650],{},"&String"," at runtime (both are effectively a pointer+length) but accept a strictly wider range of callers — there's no tradeoff, only upside, to preferring the slice form.",[173,653,654,619,657,325,660,663,664,640,666,668,669,671],{},[18,655,656],{},"Clippy",[28,658,659],{},"clippy::needless_borrow",[28,661,662],{},"clippy::ptr_arg"," catch the ",[28,665,647],{},[28,667,650],{}," anti-pattern and redundant ",[28,670,144],{}," automatically — worth enabling even in early-stage code.",[23,673,675],{"id":674},"reference-scope-edge-cases","Reference Scope Edge Cases",[32,677,678],{"language":34},[36,679,681],{"className":38,"code":680,"language":34,"meta":40,"style":40},"let mut v = vec![1, 2, 3];\nlet r = &v;\nlet r2 = &v;          \u002F\u002F multiple shared OK\nv.push(4);            \u002F\u