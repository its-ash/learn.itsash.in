,[48,572,138],{"class":54},[48,574,324],{"class":54},[48,576,577],{"class":62}," s;\n",[48,579,580,583],{"class":50,"line":111},[48,581,582],{"class":87},"    \u002F\u002F let r2 = &mut s;",[48,584,585],{"class":87},"    \u002F\u002F error[E0499]: cannot borrow `s` as mutable more than once at a time\n",[48,587,588,591,593,595,597,600],{"class":50,"line":118},[48,589,590],{"class":62},"    r1",[48,592,25],{"class":54},[48,594,338],{"class":58},[48,596,150],{"class":62},[48,598,599],{"class":153},"'b'",[48,601,157],{"class":62},[48,603,604],{"class":50,"line":129},[48,605,108],{"class":62},[14,607,608,611,612,615],{},[18,609,610],{},"Why",": if two parts of the code could change the same data at once, one could invalidate memory the other is still using (for example, a ",[32,613,614],{},"Vec"," reallocating while someone holds a pointer into it).",[27,617,619],{"id":618},"borrows-end-at-last-use","Borrows End at Last Use",[14,621,622,623,626],{},"A borrow lasts until the ",[18,624,625],{},"last time it is used",", not until the end of the block:",[36,628,629],{"language":38},[40,630,632],{"className":42,"code":631,"language":38,"meta":44,"style":44},"fn main() {\n    let mut s = String::from(\"hi\");\n    let r = &s;\n    println!(\"{r}\");     \u002F\u002F last use of r → the borrow ends here\n    s.push('!');         \u002F\u002F fine\n    println!(\"{s}\");     \u002F\u002F hi!\n}\n",[32,633,634,642,664,676,691,708,720],{"__ignoreMap":44},[48,635,636,638,640],{"class":50,"line":51},[48,637,55],{"class":54},[48,639,123],{"class":58},[48,641,126],{"class":62},[48,643,644,646,648,650,652,654,656,658,660,662],{"class":50,"line":91},[48,645,132],{"class":54},[48,647,368],{"class":54},[48,649,135],{"class":62},[48,651,138],{"class":54},[48,653,141],{"class":58},[48,655,144],{"class":54},[48,657,147],{"class":58},[48,659,150],{"class":62},[48,661,240],{"class":153},[48,663,157],{"class":62},[48,665,666,668,670,672,674],{"class":50,"line":105},[48,667,132],{"class":54},[4