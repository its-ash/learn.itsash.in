[{"data":1,"prerenderedAt":535},["ShallowReactive",2],{"page-\u002Frust\u002F08-references-and-borrowing":3},{"id":4,"title":5,"body":6,"description":527,"extension":528,"meta":529,"navigation":530,"path":531,"seo":532,"stem":533,"__hash__":534},"content\u002Frust\u002F08-references-and-borrowing.md","08 — References & Borrowing",{"type":7,"value":8,"toc":499},"minimark",[9,13,22,31,41,73,80,86,114,118,139,146,152,156,162,168,171,175,181,193,197,203,206,212,216,219,225,228,232,238,245,249,257,263,273,290,296,303,309,315,335,345,351,360,364,422,429,435,444,450,453,463,473,477,496],[10,11,5],"h1",{"id":12},"_08-references-borrowing",[14,15,16,17,21],"p",{},"Ownership is heavy. ",[18,19,20],"strong",{},"References"," let you use a value without taking ownership.",[23,24,26,27],"h2",{"id":25},"shared-references-t","Shared References ",[28,29,30],"code",{},"&T",[32,33,39],"pre",{"className":34,"code":36,"language":37,"meta":38},[35],"language-rust","fn len(s: &String) -> usize { s.len() }\n\nlet s = String::from(\"hi\");\nlet l = len(&s);     \u002F\u002F borrow — s still owned by caller\nprintln!(\"{s} {l}\"); \u002F\u002F OK\n","rust","",[28,40,36],{"__ignoreMap":38},[42,43,44,54,64],"ul",{},[45,46,47,49,50,53],"li",{},[28,48,30],{}," is a ",[18,51,52],{},"shared, immutable"," borrow.",[45,55,56,57,60,61,63],{},"You can have ",[18,58,59],{},"any number"," of simultaneous ",[28,62,30],{}," to the same value.",[45,65,66,68,69,72],{},[28,67,30],{}," is ",[28,70,71],{},"Copy"," (the reference itself can be copied).",[23,74,76,77],{"id":75},"mutable-references-mut-t","Mutable References ",[28,78,79],{},"&mut T",[32,81,84],{"className":82,"code":83,"language":37,"meta":38},[35],"fn push(s: &mut String) { s.push('!'); }\n\nlet mut s = String::from(\"hi\");\npush(&mut s);\nprintln!(\"{s}\");   \u002F\u002F \"hi!\"\n",[28,85,83],{"__ignoreMap":38},[42,87,88,96,105],{},[45,89,90,92,93,53],{},[28,91,79],{}," is an ",[18,94,95],{},"exclusive",[45,97,56,98,101,102,104],{},[18,99,100],{},"exactly one"," active ",[28,103,79],{}," at a time.",[45,106,107,108,110,111,113],{},"You cannot mix ",[28,109,30],{}," and ",[28,112,79],{}," to the same data while both are alive.",[23,115,117],{"id":116},"the-borrow-rules","The Borrow Rules",[119,120,121,128],"blockquote",{},[14,122,123,124,127],{},"At any given time, you can have ",[18,125,126],{},"either",":",[42,129,130,136],{},[45,131,132,133],{},"One mutable reference, ",[18,134,135],{},"or",[45,137,138],{},"Any number of immutable references.",[14,140,141,142,145],{},"These rules are checked at compile time. Violations produce ",[28,143,144],{},"E0502"," (aliased mutable borrow) and similar.",[32,147,150],{"className":148,"code":149,"language":37,"meta":38},[35],"let mut v = vec![1, 2, 3];\nlet r = &v;\nlet r2 = &v;          \u002F\u002F OK — multiple shared\nprintln!(\"{r} {r2}\");\nlet m = &mut v;       \u002F\u002F OK — shared refs ended above (NLL)\nm.push(4);\n",[28,151,149],{"__ignoreMap":38},[23,153,155],{"id":154},"non-lexical-lifetimes-nll","Non-Lexical Lifetimes (NLL)",[14,157,158,159,127],{},"Pre-2018, references were valid until the end of their lexical scope. NLL shrinks a reference's lifetime to its ",[18,160,161],{},"last use",[32,163,166],{"className":164,"code":165,"language":37,"meta":38},[35],"let mut v = vec![1, 2, 3];\nlet r = &v;\nprintln!(\"{r}\");      \u002F\u002F last use of r\nv.push(4);           \u002F\u002F OK — r no longer used\n",[28,167,165],{"__ignoreMap":38},[14,169,170],{},"Without NLL this would error. With NLL it compiles.",[23,172,174],{"id":173},"reference-scope-edge-cases","Reference Scope Edge Cases",[32,176,179],{"className":177,"code":178,"language":37,"meta":38},[35],"let mut v = vec![1, 2, 3];\nlet r = &v;\nlet r2 = &v;          \u002F\u002F multiple shared OK\nv.push(4);            \u002F\u002F ERROR: cannot borrow v as mutable because r\u002Fr2 alive\nprintln!(\"{r} {r2}\");\n",[28,180,178],{"__ignoreMap":38},[14,182,183,184,188,189,192],{},"Here the mutable borrow happens ",[185,186,187],"em",{},"before"," the last use of ",[28,190,191],{},"r",", so it's rejected.",[23,194,196],{"id":195},"reborrowing","Reborrowing",[32,198,201],{"className":199,"code":200,"language":37,"meta":38},[35],"let mut s = String::from(\"hi\");\nlet r1: &mut String = &mut s;\nlet r2: &mut String = &mut *r1;    \u002F\u002F reborrow — r1 temporarily inactive\nr2.push('!');\n\u002F\u002F r1 still inactive until r2 dies\nr1.push('!');                       \u002F\u002F OK now\n",[28,202,200],{"__ignoreMap":38},[14,204,205],{},"Reborrowing is the mechanism by which you can chain mutable references through function calls:",[32,207,210],{"className":208,"code":209,"language":37,"meta":38},[35],"fn push_all(dst: &mut Vec\u003Ci32>, src: &[i32]) {\n    for &x in src { dst.push(x); }   \u002F\u002F dst reborrows each call\n}\n",[28,211,209],{"__ignoreMap":38},[23,213,215],{"id":214},"lifetimes-of-references-preview","Lifetimes of References (preview)",[14,217,218],{},"The compiler tracks lifetimes. A function returning a reference must tie its output lifetime to an input:",[32,220,223],{"className":221,"code":222,"language":37,"meta":38},[35],"fn longest\u003C'a>(x: &'a str, y: &'a str) -> &'a str {\n    if x.len() > y.len() { x } else { y }\n}\n",[28,224,222],{"__ignoreMap":38},[14,226,227],{},"See the Lifetimes chapter for full details.",[23,229,231],{"id":230},"dangling-references-impossible","Dangling References — Impossible",[32,233,236],{"className":234,"code":235,"language":37,"meta":38},[35],"let r;\n{\n    let s = String::from(\"hi\");\n    r = &s;            \u002F\u002F ERROR: s does not live long enough\n}\nprintln!(\"{r}\");\n",[28,237,235],{"__ignoreMap":38},[14,239,240,241,244],{},"The borrow checker rejects code that could produce a dangling reference. This is ",[185,242,243],{},"the"," guarantee that prevents use-after-free in safe Rust.",[23,246,248],{"id":247},"reference-coercion","Reference Coercion",[14,250,251,253,254,256],{},[28,252,79],{}," coerces to ",[28,255,30],{}," when needed:",[32,258,261],{"className":259,"code":260,"language":37,"meta":38},[35],"fn len(s: &String) -> usize { s.len() }\nlet mut s = String::from(\"hi\");\nlet l = len(&mut s);     \u002F\u002F &mut String coerces to &String\n",[28,262,260],{"__ignoreMap":38},[23,264,266,269,270],{"id":265},"str-vs-string",[28,267,268],{},"&str"," vs ",[28,271,272],{},"&String",[14,274,275,277,278,280,281,283,284,286,287,289],{},[28,276,272],{}," auto-derefs to ",[28,279,268],{},". Idiomatic API: take ",[28,282,268],{}," (more general; accepts ",[28,285,272],{},", ",[28,288,268],{},", string literals).",[32,291,294],{"className":292,"code":293,"language":37,"meta":38},[35],"fn greet(name: &str) { println!(\"hi {name}\"); }\ngreet(\"Ada\");              \u002F\u002F &str\ngreet(&String::from(\"Ada\"));   \u002F\u002F &String coerces to &str\n",[28,295,293],{"__ignoreMap":38},[23,297,299,302],{"id":298},"deref-coercion",[28,300,301],{},"Deref"," Coercion",[14,304,305,306,308],{},"Types implementing ",[28,307,301],{}," allow chained deref coercions:",[32,310,313],{"className":311,"code":312,"language":37,"meta":38},[35],"let s = String::from(\"hi\");\nlet r: &str = &s;          \u002F\u002F &String -> &str via Deref\nlet b = Box::new(String::from(\"hi\"));\nlet r: &str = &b;          \u002F\u002F &Box\u003CString> -> &String -> &str\n",[28,314,312],{"__ignoreMap":38},[14,316,317,318,286,321,286,324,286,327,330,331,334],{},"This is how ",[28,319,320],{},"Box",[28,322,323],{},"Rc",[28,325,326],{},"String",[28,328,329],{},"Vec"," all play nicely with ",[28,332,333],{},"&","-APIs.",[23,336,338,341,342],{"id":337},"as_ref-as_mut",[28,339,340],{},"as_ref"," \u002F ",[28,343,344],{},"as_mut",[32,346,349],{"className":347,"code":348,"language":37,"meta":38},[35],"let s = String::from(\"hi\");\nlet r: &str = s.as_ref();   \u002F\u002F explicit AsRef coercion\n",[28,350,348],{"__ignoreMap":38},[14,352,353,110,356,359],{},[28,354,355],{},"AsRef\u003CT>",[28,357,358],{},"AsMut\u003CT>"," allow flexible type-erased borrowing.",[23,361,363],{"id":362},"mutable-reference-footguns","Mutable Reference Footguns",[42,365,366,387,396],{},[45,367,368,375,376,68,379,382,383,386],{},[18,369,370,371,374],{},"Two ",[28,372,373],{},"&mut"," to overlapping memory",": ",[28,377,378],{},"let (a, b) = (&mut v[0], &mut v[1]);",[185,380,381],{},"OK"," (non-overlapping), but ",[28,384,385],{},"let (a, b) = (&mut v[0], &mut v[0]);"," is a compile error.",[45,388,389,375,392,395],{},[18,390,391],{},"Splitting borrows of a struct",[28,393,394],{},"let (a, b) = (&mut s.x, &mut s.y);"," is allowed (non-overlapping fields).",[45,397,398,401,402,405,406,409,410,413,414,417,418,421],{},[18,399,400],{},"Borrowing through a method",": if ",[28,403,404],{},"vec.push(x)"," mutably borrows ",[28,407,408],{},"vec",", you can't also ",[28,411,412],{},"&vec[0]"," simultaneously. The classic ",[28,415,416],{},"v.push(v[0])"," error — copy first: ",[28,419,420],{},"let x = v[0]; v.push(x);",".",[23,423,425,426],{"id":424},"common-error-cannot-borrow-as-mutable-as-it-is-not-declared-as-mut","Common Error: ",[28,427,428],{},"cannot borrow ... as mutable, as it is not declared as mut",[32,430,433],{"className":431,"code":432,"language":37,"meta":38},[35],"let s = String::from(\"hi\");\nlet r = &mut s;    \u002F\u002F ERROR: s is not mut\n",[28,434,432],{"__ignoreMap":38},[14,436,437,438,441,442,421],{},"The variable itself must be ",[28,439,440],{},"mut"," to allow ",[28,443,373],{},[23,445,425,447],{"id":446},"common-error-cannot-borrow-as-mutable-because-it-is-also-borrowed-as-immutable",[28,448,449],{},"cannot borrow ... as mutable ... because it is also borrowed as immutable",[14,451,452],{},"Fix by reordering so the immutable borrow ends before the mutable borrow (NLL), or by cloning, or by restructuring.",[23,454,456,110,459,462],{"id":455},"ref-and-refmut-interior-mutability",[28,457,458],{},"Ref",[28,460,461],{},"RefMut"," (Interior Mutability)",[14,464,465,468,469,472],{},[28,466,467],{},"std::cell::RefCell"," provides ",[185,470,471],{},"runtime-checked"," borrow rules (single mutable xor multiple immutable), enabling interior mutability behind an immutable reference. Covered in Interior Mutability chapter.",[23,474,476],{"id":475},"summary","Summary",[42,478,479,487,490,493],{},[45,480,481,483,484,486],{},[28,482,30],{}," = shared, many at once; ",[28,485,79],{}," = exclusive, one at a time.",[45,488,489],{},"NLL makes references live only as long as needed.",[45,491,492],{},"Borrowing lets you write APIs that don't steal ownership.",[45,494,495],{},"Dangling references are impossible in safe Rust.",[14,497,498],{},"Next: Slices — borrowed views into contiguous data.",{"title":38,"searchDepth":500,"depth":500,"links":501},2,[502,504,506,507,508,509,510,511,512,513,515,517,519,520,522,524,526],{"id":25,"depth":500,"text":503},"Shared References &T",{"id":75,"depth":500,"text":505},"Mutable References &mut T",{"id":116,"depth":500,"text":117},{"id":154,"depth":500,"text":155},{"id":173,"depth":500,"text":174},{"id":195,"depth":500,"text":196},{"id":214,"depth":500,"text":215},{"id":230,"depth":500,"text":231},{"id":247,"depth":500,"text":248},{"id":265,"depth":500,"text":514},"&str vs &String",{"id":298,"depth":500,"text":516},"Deref Coercion",{"id":337,"depth":500,"text":518},"as_ref \u002F as_mut",{"id":362,"depth":500,"text":363},{"id":424,"depth":500,"text":521},"Common Error: cannot borrow ... as mutable, as it is not declared as mut",{"id":446,"depth":500,"text":523},"Common Error: cannot borrow ... as mutable ... because it is also borrowed as immutable",{"id":455,"depth":500,"text":525},"Ref and RefMut (Interior Mutability)",{"id":475,"depth":500,"text":476},"Ownership is heavy. References let you use a value without taking ownership.","md",{},true,"\u002Frust\u002F08-references-and-borrowing",{"title":5,"description":527},"rust\u002F08-references-and-borrowing","0tSisRkmTTEG0ylQdgZ_URFKTDjMF4EbTQ1BFzbxQ7g",1785934122318]