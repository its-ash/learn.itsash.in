[{"data":1,"prerenderedAt":970},["ShallowReactive",2],{"page-\u002Frust\u002F35-exercises-and-projects":3},{"id":4,"title":5,"body":6,"description":16,"extension":963,"meta":964,"navigation":965,"path":966,"seo":967,"stem":968,"__hash__":969},"content\u002Frust\u002F35-exercises-and-projects.md","35 — Mastery Exercises & Project Ideas",{"type":7,"value":8,"toc":925},"minimark",[9,13,17,22,25,48,52,57,65,69,79,97,101,127,131,148,152,167,171,175,185,189,200,204,211,219,225,238,242,256,260,264,267,273,279,283,289,293,304,308,315,319,328,332,352,356,360,425,429,502,506,606,610,613,672,684,688,720,724,756,760,763,891,894,898,901,919,922],[10,11,5],"h1",{"id":12},"_35-mastery-exercises-project-ideas",[14,15,16],"p",{},"Reading is the first step; building is where you become a pro. This chapter gives you exercises and projects calibrated to internalize everything.",[18,19,21],"h2",{"id":20},"how-to-use-this-chapter","How to Use This Chapter",[14,23,24],{},"Each section has:",[26,27,28,36,42],"ul",{},[29,30,31,35],"li",{},[32,33,34],"strong",{},"Exercises",": small, focused tasks to test specific concepts.",[29,37,38,41],{},[32,39,40],{},"Projects",": end-to-end builds.",[29,43,44,47],{},[32,45,46],{},"Solutions",": don't look until you've tried for 30 minutes.",[18,49,51],{"id":50},"beginner-exercises","Beginner Exercises",[53,54,56],"h3",{"id":55},"_1-fizzbuzz-with-iterators","1. FizzBuzz with Iterators",[14,58,59,60,64],{},"Implement FizzBuzz for 1..=100 using iterators and ",[61,62,63],"code",{},"collect::\u003CVec\u003CString>>()",".",[53,66,68],{"id":67},"_2-stack-with-generics","2. Stack with Generics",[70,71,77],"pre",{"className":72,"code":74,"language":75,"meta":76},[73],"language-rust","struct Stack\u003CT> { \u002F* ... *\u002F }\nimpl\u003CT> Stack\u003CT> {\n    fn new() -> Self;\n    fn push(&mut self, v: T);\n    fn pop(&mut self) -> Option\u003CT>;\n    fn peek(&self) -> Option\u003C&T>;\n    fn len(&self) -> usize;\n    fn is_empty(&self) -> bool;\n}\n","rust","",[61,78,74],{"__ignoreMap":76},[14,80,81,82,85,86,89,90,93,94,64],{},"Use ",[61,83,84],{},"Vec\u003CT>"," internally. Implement ",[61,87,88],{},"IntoIterator"," for owned, ",[61,91,92],{},"&",", and ",[61,95,96],{},"&mut",[53,98,100],{"id":99},"_3-result-combinators","3. Result Combinators",[14,102,103,104,107,108,111,112,115,116,119,120,123,124,64],{},"Write ",[61,105,106],{},"parse_csv(s: &str) -> Result\u003CVec\u003CVec\u003Ci32>>, AppError>"," using ",[61,109,110],{},"?"," and ",[61,113,114],{},"split","\u002F",[61,117,118],{},"parse",". Define ",[61,121,122],{},"AppError"," with ",[61,125,126],{},"thiserror",[53,128,130],{"id":129},"_4-linked-list-the-hard-way","4. Linked List (the Hard Way)",[14,132,133,134,137,138,141,142,141,145,64],{},"Implement a singly linked list using ",[61,135,136],{},"Box\u003CNode\u003CT>>",". Then implement ",[61,139,140],{},"Iter",", ",[61,143,144],{},"IterMut",[61,146,147],{},"IntoIter",[53,149,151],{"id":150},"_5-cli-calculator","5. CLI Calculator",[14,153,154,155,158,159,162,163,166],{},"Take ",[61,156,157],{},"+ 2 3"," or ",[61,160,161],{},"* 4 5"," from argv, print the result. Use ",[61,164,165],{},"clap"," if you want a challenge.",[18,168,170],{"id":169},"intermediate-exercises","Intermediate Exercises",[53,172,174],{"id":173},"_6-json-parser","6. JSON Parser",[14,176,177,178,158,181,184],{},"Hand-write a JSON parser using ",[61,179,180],{},"nom",[61,182,183],{},"pest",". Cover objects, arrays, strings (with escapes), numbers, booleans, null.",[53,186,188],{"id":187},"_7-async-file-watcher","7. Async File Watcher",[14,190,191,192,195,196,199],{},"Watch a directory for changes using ",[61,193,194],{},"notify"," (crate), print events. Use ",[61,197,198],{},"tokio::select!"," with a Ctrl-C handler for clean shutdown.",[53,201,203],{"id":202},"_8-concurrent-counter-with-channels","8. Concurrent Counter with Channels",[14,205,206,207,210],{},"10 threads, each sending numbers to a single aggregator thread via ",[61,208,209],{},"mpsc",". Print the final sum.",[53,212,214,215,218],{"id":213},"_9-custom-iterator-for-fibonacci","9. Custom ",[61,216,217],{},"Iterator"," for Fibonacci",[70,220,223],{"className":221,"code":222,"language":75,"meta":76},[73],"struct Fib { a: u64, b: u64 }\nimpl Iterator for Fib {\n    type Item = u64;\n    fn next(&mut self) -> Option\u003Cu64> { \u002F* ... *\u002F }\n}\n",[61,224,222],{"__ignoreMap":76},[14,226,227,228,141,231,141,234,237],{},"Add ",[61,229,230],{},".map",[61,232,233],{},".filter",[61,235,236],{},".take"," chains.",[53,239,241],{"id":240},"_10-type-state-builder","10. Type-State Builder",[14,243,244,245,248,249,141,252,255],{},"A ",[61,246,247],{},"RequestBuilder\u003CMethod, Path, Body>"," with states ",[61,250,251],{},"Unset",[61,253,254],{},"Set",". Methods only available in valid states.",[18,257,259],{"id":258},"advanced-exercises","Advanced Exercises",[53,261,263],{"id":262},"_11-custom-trait-object","11. Custom Trait Object",[14,265,266],{},"Implement your own dispatch table:",[70,268,271],{"className":269,"code":270,"language":75,"meta":76},[73],"struct VTable { size: usize, drop: unsafe fn(*mut u8), display: unsafe fn(*const u8, &mut Formatter) -> Result }\n",[61,272,270],{"__ignoreMap":76},[14,274,275,276,64],{},"Compare with ",[61,277,278],{},"Box\u003Cdyn Display>",[53,280,282],{"id":281},"_12-lock-free-queue","12. Lock-Free Queue",[14,284,285,286,64],{},"Implement a bounded MPSC queue using atomics. Benchmark against ",[61,287,288],{},"crossbeam-channel",[53,290,292],{"id":291},"_13-memory-pool","13. Memory Pool",[14,294,295,296,299,300,303],{},"Implement an arena allocator (bump allocation). Use ",[61,297,298],{},"bumpalo"," as a reference. Add ",[61,301,302],{},"Drop"," to free the arena.",[53,305,307],{"id":306},"_14-async-stream","14. Async Stream",[14,309,310,311,314],{},"Implement a ",[61,312,313],{},"Stream"," that yields lines from a file asynchronously, with backpressure.",[53,316,318],{"id":317},"_15-custom-allocator","15. Custom Allocator",[14,320,310,321,324,325,64],{},[61,322,323],{},"GlobalAlloc"," that tracks allocations and prints them. Use it as ",[61,326,327],{},"#[global_allocator]",[53,329,331],{"id":330},"_16-ffi-wrapper","16. FFI Wrapper",[14,333,334,335,338,339,342,343,115,346,349,350,64],{},"Wrap ",[61,336,337],{},"sqlite3"," via ",[61,340,341],{},"bindgen",". Expose a safe ",[61,344,345],{},"Database",[61,347,348],{},"Statement"," API with ",[61,351,302],{},[18,353,355],{"id":354},"project-ideas","Project Ideas",[53,357,359],{"id":358},"beginner","Beginner",[361,362,363,388,403,413],"ol",{},[29,364,365,368,369,141,372,141,375,141,378,381,382,384,385,64],{},[32,366,367],{},"CLI todo app",": ",[61,370,371],{},"add",[61,373,374],{},"list",[61,376,377],{},"done",[61,379,380],{},"remove",". JSON storage. Use ",[61,383,165],{}," + ",[61,386,387],{},"serde",[29,389,390,393,394,384,397,158,400,64],{},[32,391,392],{},"HTTP file server",": serve a directory; ",[61,395,396],{},"tokio",[61,398,399],{},"hyper",[61,401,402],{},"axum",[29,404,405,408,409,115,411,64],{},[32,406,407],{},"Markdown to HTML",": minimal converter; learn ",[61,410,180],{},[61,412,183],{},[29,414,415,418,419,115,422,64],{},[32,416,417],{},"Word frequency counter",": from a file, print top 10. Use ",[61,420,421],{},"HashMap",[61,423,424],{},"BTreeMap",[53,426,428],{"id":427},"intermediate","Intermediate",[361,430,432,441,455,466,481,493],{"start":431},5,[29,433,434,437,438,440],{},[32,435,436],{},"Chat server",": TCP + ",[61,439,198],{},". Broadcast to all connected clients.",[29,442,443,368,446,384,448,115,451,454],{},[32,444,445],{},"URL shortener",[61,447,402],{},[61,449,450],{},"redis",[61,452,453],{},"DashMap",". Persistent storage.",[29,456,457,460,461,384,463,64],{},[32,458,459],{},"Mini Redis",": implement a subset of Redis protocol. ",[61,462,396],{},[61,464,465],{},"bytes",[29,467,468,368,471,384,474,115,477,480],{},[32,469,470],{},"Web scraper",[61,472,473],{},"reqwest",[61,475,476],{},"select",[61,478,479],{},"scraper",". Polite rate limiting.",[29,482,483,368,486,489,490,64],{},[32,484,485],{},"Image processor",[61,487,488],{},"image"," crate, batch resize with ",[61,491,492],{},"rayon",[29,494,495,498,499,64],{},[32,496,497],{},"Database migration tool",": schema versioning, SQL execution via ",[61,500,501],{},"sqlx",[53,503,505],{"id":504},"advanced","Advanced",[361,507,509,518,528,537,543,560,566,576,582,595],{"start":508},11,[29,510,511,514,515,517],{},[32,512,513],{},"Async ORM",": derive macro for table mapping; ",[61,516,501],{},"; compile-time queries.",[29,519,520,523,524,527],{},[32,521,522],{},"Game engine",": ECS with ",[61,525,526],{},"bevy","; render sprites; basic physics.",[29,529,530,368,533,536],{},[32,531,532],{},"TLS proxy",[61,534,535],{},"tokio-rustls","; terminate TLS and forward plain TCP.",[29,538,539,542],{},[32,540,541],{},"Bittorrent client",": piece assembly, peer protocol, async I\u002FO.",[29,544,545,368,548,551,552,555,556,559],{},[32,546,547],{},"Operating system kernel",[61,549,550],{},"no_std","; ",[61,553,554],{}," bootloader","; serial driver; minimal shell. (",[61,557,558],{},"blog_os"," tutorial.)",[29,561,562,565],{},[32,563,564],{},"Database engine",": B+tree storage, WAL, MVCC. Hard but illuminating.",[29,567,568,571,572,575],{},[32,569,570],{},"Compiler",": parse a small language; lower to LLVM IR via ",[61,573,574],{},"inkwell"," or to Cranelift.",[29,577,578,581],{},[32,579,580],{},"Static site generator",": markdown → HTML, templates, RSS, syntax highlighting.",[29,583,584,587,588,141,591,594],{},[32,585,586],{},"WASM image editor",": client-side, ",[61,589,590],{},"wasm-bindgen",[61,592,593],{},"Canvas"," API.",[29,596,597,600,601,603,604,64],{},[32,598,599],{},"Realtime multiplayer game server",": WebSocket + ",[61,602,402],{},"; per-room state with ",[61,605,453],{},[18,607,609],{"id":608},"reading-code-to-mastery","Reading Code to Mastery",[14,611,612],{},"Read source of:",[26,614,615,621,626,635,643,650,655,661,666],{},[29,616,617,620],{},[61,618,619],{},"std"," (slice\u002Fiter\u002Fvec modules).",[29,622,623,625],{},[61,624,396],{}," (scheduler, channels).",[29,627,628,630,631,634],{},[61,629,387],{}," (derive macros — ",[61,632,633],{},"serde_derive",").",[29,636,637,639,640,634],{},[61,638,402],{}," (routing, middleware via ",[61,641,642],{},"tower",[29,644,645,647,648,634],{},[61,646,473],{}," (HTTP client on ",[61,649,399],{},[29,651,652,654],{},[61,653,501],{}," (compile-time SQL checking via macros).",[29,656,657,660],{},[61,658,659],{},"crossbeam"," (epoch-based memory reclamation).",[29,662,663,665],{},[61,664,526],{}," (ECS, scheduling, renderer).",[29,667,668,671],{},[61,669,670],{},"regex"," (DFA construction, Unicode tables).",[14,673,674,675,141,678,141,681,64],{},"The standard library is the best Rust code you can read. Start with ",[61,676,677],{},"alloc::vec",[61,679,680],{},"core::iter",[61,682,683],{},"core::slice",[18,685,687],{"id":686},"practice-sites","Practice Sites",[26,689,690,696,702,708,714],{},[29,691,692,695],{},[32,693,694],{},"Rustlings",": small exercises for each concept.",[29,697,698,701],{},[32,699,700],{},"Exercism Rust track",": mentor-reviewed exercises.",[29,703,704,707],{},[32,705,706],{},"Advent of Code",": annual puzzles, perfect for Rust.",[29,709,710,713],{},[32,711,712],{},"LeetCode Rust",": algos.",[29,715,716,719],{},[32,717,718],{},"Rosetta Code Rust",": idiomatic translations.",[18,721,723],{"id":722},"open-source-contribution","Open Source Contribution",[26,725,726,732,738,744,750],{},[29,727,728,731],{},[61,729,730],{},"rust-lang\u002Frust",": good-first-issue labels; tough but rewarding.",[29,733,734,737],{},[61,735,736],{},"tokio-rs\u002F*",": tokio ecosystem.",[29,739,740,743],{},[61,741,742],{},"serde-rs\u002F*",": serde, serde_json.",[29,745,746,749],{},[61,747,748],{},"bevyengine\u002Fbevy",": game engine.",[29,751,752,755],{},[61,753,754],{},"rust-cli\u002F*",": CLI tool templates.",[18,757,759],{"id":758},"mastery-self-check","Mastery Self-Check",[14,761,762],{},"Can you confidently:",[26,764,765,768,779,786,796,805,815,851,865,872,885],{},[29,766,767],{},"Explain ownership without using the word \"borrow\"? (Use \"one owner, moved on assignment, dropped on scope-end\".)",[29,769,770,771,774,775,778],{},"Predict whether ",[61,772,773],{},"&'static"," is required for a thread closure? (Yes if it borrows stack data — use ",[61,776,777],{},"move",".)",[29,780,781,782,785],{},"Read ",[61,783,784],{},"for\u003C'a> Fn(&'a str) -> &'a str"," and explain it? (HRTB; the closure works for any lifetime.)",[29,787,788,789,111,792,795],{},"Implement a trait for both ",[61,790,791],{},"&T",[61,793,794],{},"&mut T","? (Avoid; usually one suffices.)",[29,797,798,799,801,802,778],{},"Implement ",[61,800,217],{}," for your own type? (Just ",[61,803,804],{},"next()",[29,806,807,808,810,811,814],{},"Explain why ",[61,809,794],{}," is invariant in ",[61,812,813],{},"T","? (Otherwise you could swap in shorter-lived data.)",[29,816,817,818,141,821,141,824,141,827,141,830,833,834,836,837,551,839,842,843,845,846,848,849,778],{},"Choose between ",[61,819,820],{},"Rc",[61,822,823],{},"Arc",[61,825,826],{},"Cell",[61,828,829],{},"RefCell",[61,831,832],{},"Mutex","? (Single-thread shared\u002Fclone: ",[61,835,820],{},"; multi-thread: ",[61,838,823],{},[61,840,841],{},"Copy"," interior: ",[61,844,826],{},"; mut interior single-thread: ",[61,847,829],{},"; mut interior multi-thread: ",[61,850,832],{},[29,852,853,854,857,858,861,862,864],{},"Read a ",[61,855,856],{},"Pin\u003C&mut T>"," and know what ",[61,859,860],{},"!Unpin"," implies? (Can't safely move the ",[61,863,813],{}," after pinning.)",[29,866,867,868,871],{},"Reason about variance of your custom smart pointer? (Pick ",[61,869,870],{},"PhantomData"," accordingly.)",[29,873,874,875,878,879,115,882,778],{},"Write a ",[61,876,877],{},"proc_macro_derive","? (Use ",[61,880,881],{},"syn",[61,883,884],{},"quote",[29,886,781,887,890],{},[61,888,889],{},"unsafe { *ptr }"," and verify the safety invariants? (Alignment, initialization, aliasing, lifetime.)",[14,892,893],{},"If you can do all of the above without consulting docs, you're a pro Rust developer.",[18,895,897],{"id":896},"final-words","Final Words",[14,899,900],{},"Rust has a steep learning curve but pays dividends. The compiler is strict but kind: errors are messages, not crashes. Once you internalize ownership, lifetimes, and the trait system, the rest is vocabulary.",[14,902,903,904,906,907,910,911,914,915,918],{},"Build things. Break things. Read the stdlib. Read ",[61,905,396],{},". Run ",[61,908,909],{},"cargo expand"," on macros. Run ",[61,912,913],{},"Miri"," on unsafe. Profile with ",[61,916,917],{},"samply",". Contribute to open source.",[14,920,921],{},"Welcome to being a Rust developer.",[14,923,924],{},"🦀",{"title":76,"searchDepth":926,"depth":926,"links":927},2,[928,929,937,945,953,958,959,960,961,962],{"id":20,"depth":926,"text":21},{"id":50,"depth":926,"text":51,"children":930},[931,933,934,935,936],{"id":55,"depth":932,"text":56},3,{"id":67,"depth":932,"text":68},{"id":99,"depth":932,"text":100},{"id":129,"depth":932,"text":130},{"id":150,"depth":932,"text":151},{"id":169,"depth":926,"text":170,"children":938},[939,940,941,942,944],{"id":173,"depth":932,"text":174},{"id":187,"depth":932,"text":188},{"id":202,"depth":932,"text":203},{"id":213,"depth":932,"text":943},"9. Custom Iterator for Fibonacci",{"id":240,"depth":932,"text":241},{"id":258,"depth":926,"text":259,"children":946},[947,948,949,950,951,952],{"id":262,"depth":932,"text":263},{"id":281,"depth":932,"text":282},{"id":291,"depth":932,"text":292},{"id":306,"depth":932,"text":307},{"id":317,"depth":932,"text":318},{"id":330,"depth":932,"text":331},{"id":354,"depth":926,"text":355,"children":954},[955,956,957],{"id":358,"depth":932,"text":359},{"id":427,"depth":932,"text":428},{"id":504,"depth":932,"text":505},{"id":608,"depth":926,"text":609},{"id":686,"depth":926,"text