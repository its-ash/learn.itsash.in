[{"data":1,"prerenderedAt":636},["ShallowReactive",2],{"page-\u002Frust\u002F21-testing":3},{"id":4,"title":5,"body":6,"description":628,"extension":629,"meta":630,"navigation":631,"path":632,"seo":633,"stem":634,"__hash__":635},"content\u002Frust\u002F21-testing.md","21 — Testing in Rust",{"type":7,"value":8,"toc":601},"minimark",[9,13,22,27,62,66,76,115,119,127,131,139,145,160,165,171,178,182,188,206,212,218,222,228,246,250,256,278,284,290,295,301,308,312,318,328,332,338,344,348,358,364,368,373,379,383,403,407,505,509,515,522,526,532,538,551,560,564,598],[10,11,5],"h1",{"id":12},"_21-testing-in-rust",[14,15,16,17,21],"p",{},"Rust's testing is built into the language and ",[18,19,20],"code",{},"cargo",". There are three layers: unit tests, integration tests, and documentation tests.",[23,24,26],"h2",{"id":25},"test-categories","Test Categories",[28,29,30,42,52],"ol",{},[31,32,33,37,38,41],"li",{},[34,35,36],"strong",{},"Unit tests",": live inside the source, in ",[18,39,40],{},"#[cfg(test)] mod tests",". Test private items.",[31,43,44,47,48,51],{},[34,45,46],{},"Integration tests",": live in ",[18,49,50],{},"tests\u002F"," as separate crates. Test public API.",[31,53,54,57,58,61],{},[34,55,56],{},"Doc tests",": code in ",[18,59,60],{},"\u002F\u002F\u002F"," doc comments, run as examples.",[23,63,65],{"id":64},"writing-a-unit-test","Writing a Unit Test",[67,68,74],"pre",{"className":69,"code":71,"language":72,"meta":73},[70],"language-rust","pub fn add(a: i32, b: i32) -> i32 { a + b }\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn adds_two() {\n        assert_eq!(add(2, 2), 4);\n    }\n\n    #[test]\n    #[should_panic(expected = \"negative\")]\n    fn rejects_negative() {\n        panic!(\"negative not allowed\");\n    }\n\n    #[test]\n    fn returns_result() -> Result\u003C(), String> {\n        if add(2, 2) == 4 { Ok(()) } else { Err(String::from(\"bad\")) }\n    }\n}\n","rust","",[18,75,71],{"__ignoreMap":73},[77,78,79,85,98,104],"ul",{},[31,80,81,84],{},[18,82,83],{},"#[test]"," marks a test function.",[31,86,87,90,91,90,94,97],{},[18,88,89],{},"assert!",", ",[18,92,93],{},"assert_eq!",[18,95,96],{},"assert_ne!",".",[31,99,100,103],{},[18,101,102],{},"#[should_panic(expected = \"...\")]"," for panic tests.",[31,105,106,107,110,111,114],{},"Returning ",[18,108,109],{},"Result\u003C(), E: Debug>"," is allowed — ",[18,112,113],{},"Err"," fails the test.",[23,116,118],{"id":117},"running-tests","Running Tests",[67,120,125],{"className":121,"code":123,"language":124,"meta":73},[122],"language-bash","cargo test                 # all tests\ncargo test add             # filter by name substring\ncargo test --lib           # only lib unit tests\ncargo test --test integration   # only specific integration test\ncargo test -- --nocapture  # show println! output\ncargo test -- --test-threads=4\ncargo test --release       # tests in release mode\ncargo test -- --ignored    # run #[ignore] tests\n","bash",[18,126,123],{"__ignoreMap":73},[23,128,130],{"id":129},"integration-tests","Integration Tests",[67,132,137],{"className":133,"code":135,"language":136},[134],"language-text","tests\u002F\n└── integration_test.rs\n","text",[18,138,135],{"__ignoreMap":73},[67,140,143],{"className":141,"code":142,"language":72,"meta":73},[70],"use my_crate::add;\n\n#[test]\nfn integration_add() {\n    assert_eq!(add(2, 3), 5);\n}\n",[18,144,142],{"__ignoreMap":73},[77,146,147,154],{},[31,148,149,150,153],{},"Separate crate; can only use ",[18,151,152],{},"pub"," API.",[31,155,156,157,159],{},"Multiple files in ",[18,158,50],{}," become separate test binaries.",[161,162,164],"h3",{"id":163},"common-setup-module","Common Setup Module",[67,166,169],{"className":167,"code":168,"language":136},[134],"tests\u002F\n├── common\u002F\n│   └── mod.rs          # NOT a test file\n└── integration_test.rs   # use mod common;\n",[18,170,168],{"__ignoreMap":73},[14,172,173,174,177],{},"Files in ",[18,175,176],{},"tests\u002Fcommon\u002F"," (without a top-level test fn) are helpers, not test binaries.",[23,179,181],{"id":180},"doc-tests","Doc Tests",[67,183,186],{"className":184,"code":185,"language":72,"meta":73},[70],"\u002F\u002F\u002F Adds two numbers.\n\u002F\u002F\u002F\n\u002F\u002F\u002F # Examples\n\u002F\u002F\u002F\n\u002F\u002F\u002F ```\n\u002F\u002F\u002F use my_crate::add;\n\u002F\u002F\u002F assert_eq!(add(2, 2), 4);\n\u002F\u002F\u002F ```\npub fn add(a: i32, b: i32) -> i32 { a + b }\n",[18,187,185],{"__ignoreMap":73},[77,189,190,196,199],{},[31,191,192,193,97],{},"Compiled and run by ",[18,194,195],{},"cargo test",[31,197,198],{},"Must compile as a separate binary.",[31,200,201,202,205],{},"Hidden imports via ",[18,203,204],{},"#",":",[67,207,210],{"className":208,"code":209,"language":72,"meta":73},[70],"\u002F\u002F\u002F ```\n\u002F\u002F\u002F # use my_crate::add;\n\u002F\u002F\u002F assert_eq!(add(2, 2), 4);\n\u002F\u002F\u002F ```\n",[18,211,209],{"__ignoreMap":73},[14,213,214,215,217],{},"The ",[18,216,204],{}," line is hidden from rendered docs but included when testing.",[161,219,221],{"id":220},"skipping-doc-tests","Skipping Doc Tests",[67,223,226],{"className":224,"code":225,"language":136,"meta":73},[134],"\u002F\u002F\u002F ```no_run\n\u002F\u002F\u002F loop { \u002F* don't actually run *\u002F }\n\u002F\u002F\u002F ```\n\u002F\u002F\u002F\n\u002F\u002F\u002F ```ignore\n\u002F\u002F\u002F let x = todo!();\n\u002F\u002F\u002F ```\n",[18,227,225],{"__ignoreMap":73},[14,229,230,233,234,237,238,241,242,245],{},[18,231,232],{},"no_run"," compiles but doesn't execute. ",[18,235,236],{},"ignore"," skips compilation. ",[18,239,240],{},"compile_fail"," asserts the snippet fails to compile (negative tests). ",[18,243,244],{},"rust,no_run"," etc. customize.",[23,247,249],{"id":248},"assertions-cheat-sheet","Assertions Cheat Sheet",[67,251,254],{"className":252,"code":253,"language":72,"meta":73},[70],"assert!(cond);\nassert!(cond, \"custom message {x}\");\nassert_eq!(a, b);\nassert_eq!(a, b, \"msg\");\nassert_ne!(a, b);\ndebug_assert!(cond);          \u002F\u002F only in debug builds\ndebug_assert_eq!(a, b);\n",[18,255,253],{"__ignoreMap":73},[14,257,258,259,262,263,266,267,270,271,274,275,277],{},"For ",[18,260,261],{},"Result","-returning assertions, use the ",[18,264,265],{},"matches"," style or ",[18,268,269],{},".unwrap()","\u002F",[18,272,273],{},"?"," with ",[18,276,261],{},"-returning tests.",[23,279,281],{"id":280},"should_panic",[18,282,283],{},"#[should_panic]",[67,285,288],{"className":286,"code":287,"language":72,"meta":73},[70],"#[test]\n#[should_panic]\nfn panics() { panic!(); }\n\n#[test]\n#[should_panic(expected = \"exact substring\")]\nfn panics_specifically() { panic!(\"exact substring here\"); }\n",[18,289,287],{"__ignoreMap":73},[23,291,292],{"id":236},[18,293,294],{},"#[ignore]",[67,296,299],{"className":297,"code":298,"language":72,"meta":73},[70],"#[test]\n#[ignore = \"slow, run manually\"]\nfn slow_test() { \u002F* ... *\u002F }\n",[18,300,298],{"__ignoreMap":73},[14,302,303,304,307],{},"Skipped unless ",[18,305,306],{},"--ignored"," is passed.",[23,309,311],{"id":310},"asynchronous-tests","Asynchronous Tests",[67,313,316],{"className":314,"code":315,"language":72,"meta":73},[70],"#[tokio::test]\nasync fn async_test() {\n    let v = async_fn().await;\n    assert_eq!(v, 5);\n}\n",[18,317,315],{"__ignoreMap":73},[14,319,320,321,90,324,327],{},"Use the runtime's test attribute (",[18,322,323],{},"tokio::test",[18,325,326],{},"async_std::test",").",[23,329,331],{"id":330},"benchmark-tests-unstable","Benchmark Tests (unstable)",[67,333,336],{"className":334,"code":335,"language":72,"meta":73},[70],"\u002F\u002F requires nightly or use the `criterion` crate\n#![feature(test)]\nextern crate test;\nuse test::Bencher;\n\n#[bench]\nfn bench_add(b: &mut Bencher) {\n    b.iter(|| add(test::black_box(2), test::black_box(2)));\n}\n",[18,337,335],{"__ignoreMap":73},[14,339,340,343],{},[18,341,342],{},"criterion"," is the de facto stable benchmarking tool.",[23,345,347],{"id":346},"property-based-testing","Property-Based Testing",[14,349,350,351,354,355,205],{},"Use ",[18,352,353],{},"proptest"," or ",[18,356,357],{},"quickcheck",[67,359,362],{"className":360,"code":361,"language":72,"meta":73},[70],"proptest! {\n    #[test]\n    fn add_commutative(a in -1000i32..1000, b in -1000i32..1000) {\n        proptest::prop_assert_eq!(add(a, b), add(b, a));\n    }\n}\n",[18,363,361],{"__ignoreMap":73},[23,365,367],{"id":366},"snapshot-testing","Snapshot Testing",[14,369,350,370,205],{},[18,371,372],{},"insta",[67,374,377],{"className":375,"code":376,"language":72,"meta":73},[70],"#[test]\nfn snapshot() {\n    let v = render();\n    insta::assert_snapshot!(v);\n}\n",[18,378,376],{"__ignoreMap":73},[23,380,382],{"id":381},"test-organization-tips","Test Organization Tips",[77,384,385,391,394,397],{},[31,386,387,388,390],{},"Unit tests inside ",[18,389,40],{}," so they don't bloat the production binary.",[31,392,393],{},"Don't test private functions if you can test them through the public API.",[31,395,396],{},"Test edge cases: empty, boundary, max\u002Fmin, overflow, unicode, concurrency.",[31,398,350,399,402],{},[18,400,401],{},"mockall"," or hand-rolled traits for dependency injection.",[23,404,406],{"id":405},"common-pitfalls","Common Pitfalls",[77,408,409,417,429,449,458,467,480,495],{},[31,410,411,416],{},[34,412,413],{},[18,414,415],{},"#[should_panic(expected = ...)]"," is a substring match, not regex\u002Fexact.",[31,418,419,424,425,428],{},[34,420,421,423],{},[18,422,195],{}," runs in parallel by default",": shared files \u002F ports can race. Use ",[18,426,427],{},"--test-threads=1"," or unique tempdirs.",[31,430,431,438,439,441,442,270,445,448],{},[34,432,433,434,437],{},"Tests in ",[18,435,436],{},"bin\u002F"," files",": put ",[18,440,40],{}," in ",[18,443,444],{},"main.rs",[18,446,447],{},"bin\u002Fx.rs"," too.",[31,450,451,454,455,327],{},[34,452,453],{},"Doc tests slow",": many crates skip them in CI for speed (",[18,456,457],{},"cargo test --lib --bins --tests",[31,459,460,466],{},[34,461,462,465],{},[18,463,464],{},"unwrap()"," in tests is fine",": tests aren't production code; panicking is OK.",[31,468,469,472,473,476,477,97],{},[34,470,471],{},"Floating point equality",": use ",[18,474,475],{},"approx"," crate or ",[18,478,479],{},"assert!((a - b).abs() \u003C EPS)",[31,481,482,472,487,490,491,494],{},[34,483,484,486],{},[18,485,195],{}," shows only failures by default",[18,488,489],{},"--nocapture"," to see ",[18,492,493],{},"println!"," output even on success.",[31,496,497,500,501,504],{},[34,498,499],{},"Time-sensitive tests",": inject a ",[18,502,503],{},"Clock"," trait for deterministic tests.",[23,506,508],{"id":507},"coverage","Coverage",[67,510,513],{"className":511,"code":512,"language":124,"meta":73},[122],"cargo install cargo-tarpaulin\ncargo tarpaulin\n",[18,514,512],{"__ignoreMap":73},[14,516,517,518,521],{},"Or ",[18,519,520],{},"cargo-llvm-cov"," for source-based coverage.",[23,523,525],{"id":524},"fuzzing","Fuzzing",[14,527,350,528,531],{},[18,529,530],{},"cargo-fuzz"," (libFuzzer-based) for finding panics\u002FUB:",[67,533,536],{"className":534,"code":535,"language":124,"meta":73},[122],"cargo install cargo-fuzz\ncargo fuzz add parse_target\n# edit fuzz\u002Ffuzz_targets\u002Fparse_target.rs\ncargo fuzz run parse_target\n",[18,537,535],{"__ignoreMap":73},[23,539,541,544,545,548,549],{"id":540},"test-traits-debug-for-assert_eq",[18,542,543],{},"Test Traits",": ",[18,546,547],{},"Debug"," for ",[18,550,93],{},[14,552,553,555,556,559],{},[18,554,93],{}," requires ",[18,557,558],{},"T: PartialEq + Debug",". If you see \"the trait Debug is not implemented,\" derive it.",[23,561,563],{"id":562},"summary","Summary",[14,565,566,567,570,571,573,574,270,576,270,578,270,580,582,583,585,586,588,589,270,591,270,593,270,595,597],{},"Tests live alongside code (",[18,568,569],{},"#[cfg(test)]","), in ",[18,572,50],{}," for integration, and in doc comments for doc tests. Use ",[18,575,89],{},[18,577,93],{},[18,579,280],{},[18,581,294],{},". Run with ",[18,584,195],{},". Use ",[18,587,323],{}," for async. Use ",[18,590,353],{},[18,592,372],{},[18,594,342],{},[18,596,530],{}," for advanced testing.",[14,599,600],{},"Next: Concurrency, threads, and the message-passing vs shared-state story.",{"title":73,"searchDepth":602,"depth":602,"links":603},2,[604,605,606,607,611,614,615,616,617,618,619,620,621,622,623,624,625,627],{"id":25,"depth":602,"text":26},{"id":64,"depth":602,"text":65},{"id":117,"depth":602,"text":118},{"id":129,"depth":602,"text":130,"children":608},[609],{"id":163,"depth":610,"text":164},3,{"id":180,"depth":602,"text":181,"children":612},[613],{"id":220,"depth":610,"text":221},{"id":248,"depth":602,"text":249},{"id":280,"depth":602,"text":283},{"id":236,"depth":602,"text":294},{"id":310,"depth":602,"text":311},{"id":330,"depth":602,"text":331},{"id":346,"depth":602,"text":347},{"id":366,"depth":602,"text":367},{"id":381,"depth":602,"text":382},{"id":405,"depth":602,"text":406},{"id":507,"depth":602,"text":508},{"id":524,"depth":602,"text":525},{"id":540,"depth":602,"text":626},"Test Traits: Debug for assert_eq!",{"id":562,"depth":602,"text":563},"Rust's testing is built into the language and cargo. There are three layers: unit tests, integration tests, and documentation tests.","md",{},true,"\u002Frust\u002F21-testing",{"title":5,"description":628},"rust\u002F21-testing","xj_YPMZ6GkmmN5jpGKJOjQ2BCVfBAu81yb0iX7fpqac",1785935255231]