[{"data":1,"prerenderedAt":896},["ShallowReactive",2],{"page-\u002Frust\u002F26-ffi":3},{"id":4,"title":5,"body":6,"description":16,"extension":889,"meta":890,"navigation":891,"path":892,"seo":893,"stem":894,"__hash__":895},"content\u002Frust\u002F26-ffi.md","26 — FFI (Foreign Function Interface)",{"type":7,"value":8,"toc":849},"minimark",[9,13,17,22,33,53,58,69,75,81,87,94,100,108,114,120,124,127,133,143,147,153,171,174,180,216,220,226,234,243,249,272,282,285,291,309,313,319,328,332,343,347,362,366,372,397,401,408,414,420,424,430,441,445,448,466,472,476,480,486,493,501,507,512,516,522,528,534,541,547,553,558,564,567,604,610,614,620,630,636,640,733,737,814,818,846],[10,11,5],"h1",{"id":12},"_26-ffi-foreign-function-interface",[14,15,16],"p",{},"Rust talks to C — and through C, to almost every other language. This chapter covers calling C from Rust, Rust from C, and the supporting ecosystem.",[18,19,21],"h2",{"id":20},"calling-c-from-rust","Calling C from Rust",[23,24,30],"pre",{"className":25,"code":27,"language":28,"meta":29},[26],"language-rust","extern \"C\" {\n    fn abs(x: i32) -> i32;\n}\n\nfn main() {\n    let x = unsafe { abs(-5) };\n    println!(\"{x}\");\n}\n","rust","",[31,32,27],"code",{"__ignoreMap":29},[34,35,36,43,50],"ul",{},[37,38,39,42],"li",{},[31,40,41],{},"extern \"C\""," declares a foreign function with the C ABI.",[37,44,45,46,49],{},"Calling requires ",[31,47,48],{},"unsafe"," (the compiler can't verify the signature or memory safety).",[37,51,52],{},"The linker resolves the symbol at link time.",[54,55,57],"h3",{"id":56},"linking","Linking",[14,59,60,61,64,65,68],{},"Add the C library to ",[31,62,63],{},"Cargo.toml"," via ",[31,66,67],{},"build.rs",":",[23,70,73],{"className":71,"code":72,"language":28,"meta":29},[26],"\u002F\u002F build.rs\nfn main() {\n    println!(\"cargo:rustc-link-lib=c\");\n}\n",[31,74,72],{"__ignoreMap":29},[14,76,77,78,68],{},"Or use ",[31,79,80],{},"#[link(name = \"mylib\")]",[23,82,85],{"className":83,"code":84,"language":28,"meta":29},[26],"#[link(name = \"mylib\")]\nextern \"C\" {\n    fn my_func(x: i32) -> i32;\n}\n",[31,86,84],{"__ignoreMap":29},[54,88,90,93],{"id":89},"bindgen-for-auto-binding",[31,91,92],{},"bindgen"," for Auto-Binding",[14,95,96,97,99],{},"Hand-writing extern blocks is error-prone. ",[31,98,92],{}," generates Rust bindings from C headers:",[23,101,106],{"className":102,"code":104,"language":105,"meta":29},[103],"language-toml","# Cargo.toml\n[build-dependencies]\nbindgen = \"0.69\"\n","toml",[31,107,104],{"__ignoreMap":29},[23,109,112],{"className":110,"code":111,"language":28,"meta":29},[26],"\u002F\u002F build.rs\nuse std::env;\nuse std::path::PathBuf;\n\nfn main() {\n    let bindings = bindgen::Builder::default()\n        .header(\"wrapper.h\")\n        .parse_callbacks(Box::new(bindgen::CargoCallbacks::new()))\n        .generate()\n        .expect(\"Unable to generate bindings\");\n\n    let out_path = PathBuf::from(env::var(\"OUT_DIR\").unwrap());\n    bindings.write_to_file(out_path.join(\"bindings.rs\")).unwrap();\n}\n",[31,113,111],{"__ignoreMap":29},[23,115,118],{"className":116,"code":117,"language":28,"meta":29},[26],"\u002F\u002F src\u002Flib.rs\ninclude!(concat!(env!(\"OUT_DIR\"), \"\u002Fbindings.rs\"));\n",[31,119,117],{"__ignoreMap":29},[54,121,123],{"id":122},"wrapping-in-safe-apis","Wrapping in Safe APIs",[14,125,126],{},"Raw FFI bindings are unsafe. Wrap them:",[23,128,131],{"className":129,"code":130,"language":28,"meta":29},[26],"mod sys {\n    extern \"C\" {\n        pub fn strlen(s: *const u8) -> usize;\n    }\n}\n\npub fn strlen(s: &CStr) -> usize {\n    unsafe { sys::strlen(s.as_ptr()) }\n}\n",[31,132,130],{"__ignoreMap":29},[14,134,135,138,139,142],{},[31,136,137],{},"CStr","\u002F",[31,140,141],{},"CString"," are the safe wrappers around C's null-terminated strings.",[18,144,146],{"id":145},"calling-rust-from-c","Calling Rust from C",[23,148,151],{"className":149,"code":150,"language":28,"meta":29},[26],"#[no_mangle]\npub extern \"C\" fn add(a: i32, b: i32) -> i32 {\n    a + b\n}\n",[31,152,150],{"__ignoreMap":29},[34,154,155,165],{},[37,156,157,160,161,164],{},[31,158,159],{},"#[no_mangle]",": keep the symbol name exactly ",[31,162,163],{},"add"," (don't mangle).",[37,166,167,170],{},[31,168,169],{},"pub extern \"C\"",": export with C ABI.",[14,172,173],{},"Build as a static or dynamic library:",[23,175,178],{"className":176,"code":177,"language":105,"meta":29},[103],"[lib]\ncrate-type = [\"staticlib\", \"cdylib\", \"rlib\"]\n",[31,179,177],{"__ignoreMap":29},[34,181,182,195,210],{},[37,183,184,187,188,138,191,194],{},[31,185,186],{},"staticlib",": ",[31,189,190],{},".a",[31,192,193],{},".lib"," static archive.",[37,196,197,187,200,138,203,138,206,209],{},[31,198,199],{},"cdylib",[31,201,202],{},".so",[31,204,205],{},".dylib",[31,207,208],{},".dll"," dynamic library.",[37,211,212,215],{},[31,213,214],{},"rlib",": Rust-specific (for other Rust crates).",[54,217,219],{"id":218},"c-header","C Header",[14,221,222,223,68],{},"Generate a header for C consumers with ",[31,224,225],{},"cbindgen",[23,227,232],{"className":228,"code":230,"language":231,"meta":29},[229],"language-bash","cargo install cbindgen\ncbindgen --crate my_lib --output my_lib.h\n","bash",[31,233,230],{"__ignoreMap":29},[18,235,237,238,240,241],{"id":236},"c-strings-cstring-and-cstr","C Strings: ",[31,239,141],{}," and ",[31,242,137],{},[23,244,247],{"className":245,"code":246,"language":28,"meta":29},[26],"use std::ffi::{CString, CStr};\n\nlet c_string = CString::new(\"hello\").unwrap();\nlet ptr: *const u8 = c_string.as_ptr();    \u002F\u002F null-terminated\nlet cstr = unsafe { CStr::from_ptr(ptr) };\nlet rust_str = cstr.to_str().unwrap();\n",[31,248,246],{"__ignoreMap":29},[34,250,251,260],{},[37,252,253,255,256,259],{},[31,254,141],{},": owned, null-terminated; can't contain interior NUL bytes (constructor returns ",[31,257,258],{},"Result",").",[37,261,262,264,265,268,269,271],{},[31,263,137],{},": borrowed, null-terminated; from ",[31,266,267],{},"from_ptr"," (unsafe) or by deref of ",[31,270,141],{},".",[18,273,275,276,240,279],{"id":274},"os-strings-osstring-and-osstr","OS Strings: ",[31,277,278],{},"OsString",[31,280,281],{},"OsStr",[14,283,284],{},"For platform-native strings (file paths, env):",[23,286,289],{"className":287,"code":288,"language":28,"meta":29},[26],"use std::ffi::OsString;\nlet s: OsString = std::env::args_os().next().unwrap();\n",[31,290,288],{"__ignoreMap":29},[34,292,293,300],{},[37,294,295,138,297,299],{},[31,296,278],{},[31,298,281],{}," are the OS-native string equivalents.",[37,301,302,138,305,308],{},[31,303,304],{},"PathBuf",[31,306,307],{},"Path"," are wrappers for path semantics (cross-platform).",[18,310,312],{"id":311},"memory-ownership-across-ffi","Memory Ownership Across FFI",[23,314,317],{"className":315,"code":316,"language":28,"meta":29},[26],"\u002F\u002F Rust allocates, C frees\n#[no_mangle]\npub extern \"C\" fn make_string() -> *mut u8 {\n    let s = CString::new(\"hello\").unwrap();\n    s.into_raw()      \u002F\u002F leaks ownership to C\n}\n\n\u002F\u002F C frees via this\n#[no_mangle]\npub extern \"C\" fn free_string(ptr: *mut u8) {\n    unsafe { let _ = CString::from_raw(ptr); }\n}\n",[31,318,316],{"__ignoreMap":29},[14,320,321,138,324,327],{},[31,322,323],{},"CString::into_raw",[31,325,326],{},"from_raw"," are the standard pattern for handing Rust strings to C and getting them back.",[54,329,331],{"id":330},"c-allocates-rust-frees","C allocates, Rust frees",[14,333,334,335,338,339,342],{},"If C allocates with ",[31,336,337],{},"malloc",", Rust must call ",[31,340,341],{},"free"," (or the equivalent), not Rust's allocator. Provide a destructor function on the C side.",[54,344,346],{"id":345},"common-pitfall-mismatched-allocators","Common Pitfall: Mismatched Allocators",[14,348,349,350,138,353,356,357,138,359,361],{},"Rust's ",[31,351,352],{},"Vec::push",[31,354,355],{},"String::push"," use Rust's allocator. C's ",[31,358,337],{},[31,360,341],{}," use the C library. Mixing them is UB. Always free with the allocator that allocated.",[18,363,365],{"id":364},"structs-across-ffi","Structs Across FFI",[23,367,370],{"className":368,"code":369,"language":28,"meta":29},[26],"#[repr(C)]\nstruct Point {\n    x: f64,\n    y: f64,\n}\n\n#[no_mangle]\npub extern \"C\" fn translate(p: Point, dx: f64, dy: f64) -> Point {\n    Point { x: p.x + dx, y: p.y + dy }\n}\n",[31,371,369],{"__ignoreMap":29},[34,373,374,380,383],{},[37,375,376,379],{},[31,377,378],{},"#[repr(C)]"," forces C-compatible layout (no Rust-specific reordering).",[37,381,382],{},"Field order matters and matches C's.",[37,384,385,386,138,389,392,393,396],{},"Avoid ",[31,387,388],{},"Box\u003CT>",[31,390,391],{},"Vec\u003CT>"," in ",[31,394,395],{},"repr(C)"," structs (Rust-specific layout).",[54,398,400],{"id":399},"opaque-types","Opaque Types",[14,402,403,404,407],{},"When C uses an opaque pointer (",[31,405,406],{},"typedef struct Foo Foo;","), use a zero-sized ZST:",[23,409,412],{"className":410,"code":411,"language":28,"meta":29},[26],"#[repr(C)]\npub struct Foo { _private: [u8; 0] }\n\nextern \"C\" {\n    pub fn foo_new() -> *mut Foo;\n    pub fn foo_free(f: *mut Foo);\n}\n",[31,413,411],{"__ignoreMap":29},[14,415,416,419],{},[31,417,418],{},"[u8; 0]"," is the convention for opaque types.",[18,421,423],{"id":422},"function-pointers","Function Pointers",[23,425,428],{"className":426,"code":427,"language":28,"meta":29},[26],"#[repr(C)]\nstruct Callbacks {\n    on_event: Option\u003Cextern \"C\" fn(data: *mut u8)>,\n}\n\nextern \"C\" fn my_callback(data: *mut u8) {\n    let s = unsafe { CStr::from_ptr(data as *const i8) };\n    println!(\"event: {:?}\", s);\n}\n",[31,429,427],{"__ignoreMap":29},[14,431,432,433,436,437,440],{},"C callbacks into Rust: store as ",[31,434,435],{},"Option\u003Cextern \"C\" fn(...)>",", pass ",[31,438,439],{},"my_callback as extern \"C\" fn(...)",", handle the user-data void pointer.",[18,442,444],{"id":443},"panic-across-ffi-ub","Panic Across FFI — UB",[14,446,447],{},"Unwinding across an FFI boundary is UB. Solutions:",[34,449,450,459],{},[37,451,452,453,392,456,458],{},"Set ",[31,454,455],{},"panic = \"abort\"",[31,457,63],{}," (kills the process on panic).",[37,460,461,462,465],{},"Use ",[31,463,464],{},"std::panic::catch_unwind"," at the boundary and convert to a C error code.",[23,467,470],{"className":468,"code":469,"language":28,"meta":29},[26],"#[no_mangle]\npub extern \"C\" fn safe_call() -> i32 {\n    match std::panic::catch_unwind(|| risky_fn()) {\n        Ok(_) => 0,\n        Err(_) => -1,\n    }\n}\n",[31,471,469],{"__ignoreMap":29},[18,473,475],{"id":474},"calling-other-languages","Calling Other Languages",[54,477,479],{"id":478},"python-pyo3","Python (PyO3)",[23,481,484],{"className":482,"code":483,"language":28,"meta":29},[26],"use pyo3::prelude::*;\n\n#[pyfunction]\nfn add(a: i64, b: i64) -> i64 { a + b }\n\n#[pymodule]\nfn my_module(_py: Python, m: &PyModule) -> PyResult\u003C()> {\n    m.add_function(wrap_pyfunction!(add, m)?)?;\n    Ok(())\n}\n",[31,485,483],{"__ignoreMap":29},[14,487,488,489,492],{},"Build with ",[31,490,491],{},"maturin develop",". PyO3 handles Python ABI.",[54,494,496,497,500],{"id":495},"nodejs-napi-rs","Node.js (",[31,498,499],{},"napi-rs",")",[23,502,505],{"className":503,"code":504,"language":28,"meta":29},[26],"#[napi]\npub fn add(a: i32, b: i32) -> i32 { a + b }\n",[31,506,504],{"__ignoreMap":29},[14,508,488,509,271],{},[31,510,511],{},"napi build",[54,513,515],{"id":514},"webassembly","WebAssembly",[23,517,520],{"className":518,"code":519,"language":231,"meta":29},[229],"rustup target add wasm32-unknown-unknown\ncargo build --target wasm32-unknown-unknown --release\n",[31,521,519],{"__ignoreMap":29},[14,523,524,525,68],{},"For JS interop, use ",[31,526,527],{},"wasm-bindgen",[23,529,532],{"className":530,"code":531,"language":28,"meta":29},[26],"use wasm_bindgen::prelude::*;\n\n#[wasm_bindgen]\npub fn add(a: i32, b: i32) -> i32 { a + b }\n",[31,533,531],{"__ignoreMap":29},[54,535,537,538,500],{"id":536},"c-cxx","C++ (",[31,539,540],{},"cxx",[14,542,543,544,546],{},"The ",[31,545,540],{}," crate provides safe bidirectional FFI:",[23,548,551],{"className":549,"code":550,"language":28,"meta":29},[26],"#[cxx::bridge]\nmod ffi {\n    extern \"C++\" {\n        include!(\"mylib.h\");\n        fn cpp_func(x: i32) -> i32;\n    }\n}\n",[31,552,550],{"__ignoreMap":29},[14,554,555,557],{},[31,556,540],{}," generates both sides; types are restricted to a safe subset.",[18,559,561,563],{"id":560},"extern-c-and-abis",[31,562,41],{}," and ABIs",[14,565,566],{},"Common ABIs:",[34,568,569,575,581,594],{},[37,570,571,574],{},[31,572,573],{},"\"C\""," — System V \u002F cdecl depending on platform.",[37,576,577,580],{},[31,578,579],{},"\"stdcall\""," — Windows x32.",[37,582,583,586,587,590,591,593],{},[31,584,585],{},"\"system\""," — ",[31,588,589],{},"stdcall"," on Win32, ",[31,592,573],{}," on Win64.",[37,595,596,599,600,603],{},[31,597,598],{},"\"win64\"",", ",[31,601,602],{},"\"sysv64\""," — explicit x64\u002FSysV.",[14,605,606,607,609],{},"Mismatched ABIs cause subtle corruption. Use ",[31,608,92],{}," to get them right.",[18,611,613],{"id":612},"build-scripts-for-ffi","Build Scripts for FFI",[23,615,618],{"className":616,"code":617,"language":28,"meta":29},[26],"\u002F\u002F build.rs\nfn main() {\n    cc::Build::new()\n        .file(\"src\u002Fc_code.c\")\n        .compile(\"my_c_code\");\n    println!(\"cargo:rerun-if-changed=src\u002Fc_code.c\");\n}\n",[31,619,617],{"__ignoreMap":29},[14,621,622,625,626,629],{},[31,623,624],{},"cc"," crate compiles C\u002FC++ as part of ",[31,627,628],{},"cargo build",". Add it as a build dependency:",[23,631,634],{"className":632,"code":633,"language":105,"meta":29},[103],"[build-dependencies]\ncc = \"1.0\"\n",[31,635,633],{"__ignoreMap":29},[18,637,639],{"id":638},"common-pitfalls","Common Pitfalls",[34,641,642,649,657,669,675,683,696,705,711,720],{},[37,643,644,648],{},[645,646,647],"strong",{},"Mismatched allocators",": UB; always free with the originating allocator.",[37,650,651,654,655,271],{},[645,652,653],{},"Wrong ABI",": silent corruption; use ",[31,656,92],{},[37,658,659,662,663,666,667,271],{},[645,660,661],{},"Unwinding across FFI",": UB; use ",[31,664,665],{},"catch_unwind"," or ",[31,668,455],{},[37,670,671,674],{},[645,672,673],{},"Returning references to stack data",": classic UB; return owned or pass buffers in.",[37,676,677,682],{},[645,678,679,681],{},[31,680,378],{}," missing",": Rust may reorder fields; mismatch with C struct.",[37,684,685,688,689,691,692,695],{},[645,686,687],{},"Nullable function pointers",": use ",[31,690,435],{}," so the ",[31,693,694],{},"None"," variant is a null pointer.",[37,697,698,701,702,704],{},[645,699,700],{},"Variadic FFI",": only ",[31,703,41],{}," functions can be variadic.",[37,706,707,710],{},[645,708,709],{},"Thread-local state",": FFI calls into Rust from C threads don't have Rust's thread-local set up.",[37,712,713,716,717,719],{},[645,714,715],{},"String encoding",": C strings are NUL-terminated byte arrays; Rust strings are UTF-8. ",[31,718,281],{}," for paths.",[37,721,722,727,728,138,731,271],{},[645,723,724,726],{},[31,725,388],{}," across FFI",": not stable layout; use raw pointers explicitly with ",[31,729,730],{},"Box::into_raw",[31,732,326],{},[18,734,736],{"id":735},"useful-crates","Useful Crates",[34,738,739,744,749,756,761,767,772,777,783,799],{},[37,740,741,743],{},[31,742,92],{},": auto-generate Rust bindings from C.",[37,745,746,748],{},[31,747,225],{},": generate C headers from Rust.",[37,750,751,753,754,271],{},[31,752,624],{},": compile C\u002FC++ in ",[31,755,67],{},[37,757,758,760],{},[31,759,540],{},": safe C++ interop.",[37,762,763,766],{},[31,764,765],{},"pyo3",": Python bindings.",[37,768,769,771],{},[31,770,499],{},": Node.js bindings.",[37,773,774,776],{},[31,775,527],{},": JS\u002FWebAssembly bindings.",[37,778,779,782],{},[31,780,781],{},"jni",": Java\u002FJVM bindings.",[37,784,785,788,789,599,792,599,795,798],{},[31,786,787],{},"libc",": raw C types and constants (",[31,790,791],{},"c_int",[31,793,794],{},"c_char",[31,796,797],{},"size_t",", etc.).",[37,800,801,599,804,599,807,138,810,813],{},[31,802,803],{},"raw-cpuid",[31,805,806],{},"nix",[31,808,809],{},"winapi",[31,811,812],{},"windows-sys",": OS bindings.",[18,815,817],{"id":816},"summary","Summary",[14,819,820,822,823,826,827,829,830,138,832,138,834,836,837,138,839,138,841,138,843,845],{},[31,821,41],{}," declares FFI. ",[31,824,825],{},"#[no_mangle] pub extern \"C\" fn"," exports Rust to C. ",[31,828,378],{}," controls struct layout. Use ",[31,831,92],{},[31,833,225],{},[31,835,540],{}," for safe interop. Memory ownership must match allocators. Panics must not cross FFI. ",[31,838,141],{},[31,840,137],{},[31,842,278],{},[31,844,281],{}," for string interop. Wrap unsafe bindings in safe abstractions.",[14,847,848],{},"Next: Attributes and conditional compilation.",{"title":29,"searchDepth":850,"depth":850,"links":851},2,[852,859,862,864,866,870,873,874,875,883,885,886,887,888],{"id":20,"depth":850,"text":21,"children":853},[854,856,858],{"id":56,"depth":855,"text":57},3,{"id":89,"depth":855,"text":857},"bindgen for Auto-Binding",{"id":122,"depth":855,"text":123},{"id":145,"depth":850,"text":146,"children":860},[861],{"id":218,"depth":855,"text":219},{"id":236,"depth":850,"text":863},"C Strings: CString and CStr",{"id":274,"depth":850,"text":865},"OS Strings: OsString and OsStr",{"id":311,"depth":850,"text":312,"children":867},[868,869],{"id":330,"depth":855,"text":331},{"id":345,"depth":855,"text":346},{"id":364,"depth":850,"text":365,"children":871},[872],{"id":399,"depth":855,"text":400},{"id":422,"depth":850,"text":423},{"id":443,"depth":850,"text":444},{"id":474,"depth":850,"text":475,"children":876},[877,878,880,881],{"id":478,"depth":855,"text":479},{"id":495,"depth":855,"text":879},"Node.js (napi-rs)",{"id":514,"depth":855,"text":515},{"id":536,"depth":855,"text":882},"C++ (cxx)",{"id":560,"depth":850,"text":884},"extern \"C\" and ABIs",{"id":612,"depth":850,"text":613},{"id":638,"depth":850,"text":639},{"id":735,"depth":850,"text":736},{"id":816,"depth":850,"text":817},"md",{},true,"\u002Frust\u002F26-ffi",{"title":5,"description":16},"rust\u002F26-ffi","VxJv4AO9q9ydPLDC1sELBVpznBuyD6nIfTPbsqqjcDY",1785934963043]