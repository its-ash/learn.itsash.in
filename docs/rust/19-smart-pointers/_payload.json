[{"data":1,"prerenderedAt":1065},["ShallowReactive",2],{"page-\u002Frust\u002F19-smart-pointers":3},{"id":4,"title":5,"body":6,"description":16,"extension":1058,"meta":1059,"navigation":1060,"path":1061,"seo":1062,"stem":1063,"__hash__":1064},"content\u002Frust\u002F19-smart-pointers.md","19 — Smart Pointers & Memory Management",{"type":7,"value":8,"toc":1009},"minimark",[9,13,17,26,36,52,60,86,92,99,105,108,115,121,162,169,178,184,188,194,200,207,213,235,244,265,269,275,285,289,301,307,314,320,350,357,363,394,404,411,420,426,454,458,476,490,496,510,517,523,529,535,542,552,558,564,577,590,594,801,805,818,824,828,848,852,930,934,969,973,1006],[10,11,5],"h1",{"id":12},"_19-smart-pointers-memory-management",[14,15,16],"p",{},"Smart pointers own data and provide extra behavior beyond references. They're the bridge between Rust's ownership model and dynamic data structures.",[18,19,21,25],"h2",{"id":20},"boxt-heap-allocation",[22,23,24],"code",{},"Box\u003CT>"," — Heap Allocation",[27,28,34],"pre",{"className":29,"code":31,"language":32,"meta":33},[30],"language-rust","let b = Box::new(5);\nlet s = Box::new(String::from(\"hi\"));\n","rust","",[22,35,31],{"__ignoreMap":33},[37,38,39,43,46],"ul",{},[40,41,42],"li",{},"Allocates on the heap; owned.",[40,44,45],{},"Single owner; dropped when out of scope.",[40,47,48,49,51],{},"Sized: ",[22,50,24],{}," has the size of a pointer.",[53,54,56,57],"h3",{"id":55},"when-you-need-box","When You Need ",[22,58,59],{},"Box",[37,61,62,65,68,75],{},[40,63,64],{},"Recursive types (linked structures need indirection to have a finite size).",[40,66,67],{},"Large data you don't want to copy on the stack.",[40,69,70,71,74],{},"Trait objects (",[22,72,73],{},"Box\u003Cdyn Trait>",") — unsized types need a wide pointer.",[40,76,77,78,81,82,85],{},"Sending owned data to a thread (",[22,79,80],{},"Box::new"," makes it ",[22,83,84],{},"'static",").",[27,87,90],{"className":88,"code":89,"language":32,"meta":33},[30],"enum List {\n    Cons(i32, Box\u003CList>),   \u002F\u002F recursive — needs Box\n    Nil,\n}\n",[22,91,89],{"__ignoreMap":33},[53,93,95,98],{"id":94},"boxleak-permanent-reference",[22,96,97],{},"Box::leak"," — Permanent Reference",[27,100,103],{"className":101,"code":102,"language":32,"meta":33},[30],"let leaked: &'static mut [u8] = Box::leak(vec![1, 2, 3].into_boxed_slice());\n",[22,104,102],{"__ignoreMap":33},[14,106,107],{},"Leaks forever; useful for one-time configs but a real memory leak.",[18,109,111,114],{"id":110},"rct-reference-counted-single-threaded",[22,112,113],{},"Rc\u003CT>"," — Reference Counted (single-threaded)",[27,116,119],{"className":117,"code":118,"language":32,"meta":33},[30],"use std::rc::Rc;\nlet a = Rc::new(String::from(\"hi\"));\nlet b = Rc::clone(&a);    \u002F\u002F increments refcount, doesn't copy\nlet c = a.clone();         \u002F\u002F same\n\u002F\u002F a, b, c all share the same String\n",[22,120,118],{"__ignoreMap":33},[37,122,123,131,134,148,151],{},[40,124,125,126,130],{},"Multiple owners in a ",[127,128,129],"strong",{},"single thread",".",[40,132,133],{},"Atomic increment\u002Fdecrement of a refcount.",[40,135,136,137,140,141,144,145,85],{},"Not ",[22,138,139],{},"Send","\u002F",[22,142,143],{},"Sync"," (uses non-atomic counters; cheaper than ",[22,146,147],{},"Arc",[40,149,150],{},"When the count hits 0, the value is dropped.",[40,152,153,154,157,158,161],{},"Use ",[22,155,156],{},"Rc::clone(&rc)"," (idiomatic) — don't use ",[22,159,160],{},"rc.clone()"," (looks like a deep clone).",[53,163,165,168],{"id":164},"rc-doesnt-allow-mutation",[22,166,167],{},"Rc"," Doesn't Allow Mutation",[14,170,171,173,174,177],{},[22,172,113],{}," gives shared read access. To mutate shared state, wrap in ",[22,175,176],{},"RefCell",":",[27,179,182],{"className":180,"code":181,"language":32,"meta":33},[30],"let shared = Rc::new(RefCell::new(vec![1, 2, 3]));\nshared.borrow_mut().push(4);\n",[22,183,181],{"__ignoreMap":33},[53,185,187],{"id":186},"weak-references","Weak References",[27,189,192],{"className":190,"code":191,"language":32,"meta":33},[30],"use std::rc::{Rc, Weak};\nlet strong = Rc::new(5);\nlet weak: Weak\u003Ci32> = Rc::downgrade(&strong);\nif let Some(v) = weak.upgrade() { \u002F* ... *\u002F }\n",[22,193,191],{"__ignoreMap":33},[14,195,196,199],{},[22,197,198],{},"Weak"," doesn't count toward ownership; avoids cycles. Crucial for parent\u002Fchild links (e.g., GUI trees, linked structures).",[18,201,203,206],{"id":202},"arct-atomic-reference-counted-thread-safe",[22,204,205],{},"Arc\u003CT>"," — Atomic Reference Counted (thread-safe)",[27,208,211],{"className":209,"code":210,"language":32,"meta":33},[30],"use std::sync::Arc;\nlet a = Arc::new(vec![1, 2, 3]);\nlet b = Arc::clone(&a);\nstd::thread::spawn(move || println!(\"{:?}\", b));\n",[22,212,210],{"__ignoreMap":33},[37,214,215,221,232],{},[40,216,217,218,220],{},"Thread-safe version of ",[22,219,167],{}," (atomic ops, slower).",[40,222,223,225,226,228,229,130],{},[22,224,139],{}," and ",[22,227,143],{}," if ",[22,230,231],{},"T: Send + Sync",[40,233,234],{},"Idiomatic for sharing across threads.",[53,236,238,239,241,242],{"id":237},"when-rc-vs-arc","When ",[22,240,167],{}," vs ",[22,243,147],{},[37,245,246,252,257],{},[40,247,248,249,251],{},"Single-threaded: ",[22,250,167],{}," (faster, simpler).",[40,253,254,255,130],{},"Multi-threaded: ",[22,256,147],{},[40,258,259,260,262,263,130],{},"Never use ",[22,261,167],{}," across threads — the compiler forbids it via ",[22,264,139],{},[18,266,268],{"id":267},"cycles-and-memory-leaks","Cycles and Memory Leaks",[27,270,273],{"className":271,"code":272,"language":32,"meta":33},[30],"let a = Rc::new(RefCell::new(None));\nlet b = Rc::new(RefCell::new(None));\n*a.borrow_mut() = Some(Rc::clone(&b));\n*b.borrow_mut() = Some(Rc::clone(&a));    \u002F\u002F CYCLE: refcount never hits 0\n",[22,274,272],{"__ignoreMap":33},[14,276,277,140,279,281,282,284],{},[22,278,167],{},[22,280,147],{}," cycles leak. Use ",[22,283,198],{}," for back-references. Rust can't prevent this; design matters.",[18,286,288],{"id":287},"interior-mutability-pattern","Interior Mutability Pattern",[14,290,291,140,293,295,296,140,298,177],{},[22,292,167],{},[22,294,147],{}," give shared ownership but no mutation. Wrap the inner in ",[22,297,176],{},[22,299,300],{},"Mutex",[27,302,305],{"className":303,"code":304,"language":32,"meta":33},[30],"\u002F\u002F single-threaded\nlet shared = Rc::new(RefCell::new(0));\n*shared.borrow_mut() += 1;\n\n\u002F\u002F multi-threaded\nlet shared = Arc::new(Mutex::new(0));\n*shared.lock().unwrap() += 1;\n",[22,306,304],{"__ignoreMap":33},[18,308,310,313],{"id":309},"cellt-copy-type-interior-mutability",[22,311,312],{},"Cell\u003CT>"," — Copy-Type Interior Mutability",[27,315,318],{"className":316,"code":317,"language":32,"meta":33},[30],"use std::cell::Cell;\nlet c = Cell::new(5);\nc.set(10);\nlet v = c.get();          \u002F\u002F requires T: Copy\n",[22,319,317],{"__ignoreMap":33},[37,321,322,329,332,345],{},[40,323,324,325,328],{},"Zero-cost interior mutability for ",[22,326,327],{},"Copy"," types.",[40,330,331],{},"No borrow checking (just stores the value).",[40,333,334,335,338,339,140,342,85],{},"Cannot get a ",[22,336,337],{},"&T"," out (only ",[22,340,341],{},"get",[22,343,344],{},"set",[40,346,347,348,328],{},"Use for simple flags, counters, small ",[22,349,327],{},[18,351,353,356],{"id":352},"refcellt-borrow-checked-interior-mutability",[22,354,355],{},"RefCell\u003CT>"," — Borrow-Checked Interior Mutability",[27,358,361],{"className":359,"code":360,"language":32,"meta":33},[30],"use std::cell::RefCell;\nlet c = RefCell::new(vec![1, 2, 3]);\nc.borrow_mut().push(4);\nlet r = c.borrow();      \u002F\u002F immutable borrow\nprintln!(\"{:?}\", r);\n",[22,362,360],{"__ignoreMap":33},[37,364,365,379,388],{},[40,366,367,368,371,372,225,375,378],{},"Moves borrow checking to ",[127,369,370],{},"runtime",": ",[22,373,374],{},"borrow()",[22,376,377],{},"borrow_mut()"," track active borrows.",[40,380,381,382,384,385,387],{},"Multiple ",[22,383,374],{}," OK; one ",[22,386,377],{}," exclusive.",[40,389,390,393],{},[127,391,392],{},"Panics"," on borrow violation: \"already borrowed\" \u002F \"already mutably borrowed\".",[53,395,397,400,401],{"id":396},"try_borrow-try_borrow_mut",[22,398,399],{},"try_borrow"," \u002F ",[22,402,403],{},"try_borrow_mut",[14,405,406,407,410],{},"Non-panicking variants returning ",[22,408,409],{},"Result",". Useful when you might encounter a borrow conflict gracefully.",[18,412,414,225,417],{"id":413},"mutext-and-rwlockt",[22,415,416],{},"Mutex\u003CT>",[22,418,419],{},"RwLock\u003CT>",[27,421,424],{"className":422,"code":423,"language":32,"meta":33},[30],"use std::sync::Mutex;\nlet m = Mutex::new(0);\nlet guard = m.lock().unwrap();\n*guard += 1;\n\u002F\u002F guard drops here, unlocking\n\nuse std::sync::RwLock;\nlet rw = RwLock::new(0);\n{\n    let r1 = rw.read().unwrap();\n    let r2 = rw.read().unwrap();   \u002F\u002F multiple readers OK\n}\n{\n    let mut w = rw.write().unwrap();  \u002F\u002F exclusive writer\n    *w += 1;\n}\n",[22,425,423],{"__ignoreMap":33},[37,427,428,433,439,448],{},[40,429,430,432],{},[22,431,300],{},": one accessor at a time.",[40,434,435,438],{},[22,436,437],{},"RwLock",": many readers or one writer.",[40,440,441,442,444,445,130],{},"Locks return ",[22,443,409],{}," because a poisoned lock (holder panicked) returns ",[22,446,447],{},"Err",[40,449,450,453],{},[22,451,452],{},"Lock"," guards auto-unlock on drop (RAII).",[53,455,457],{"id":456},"poison","Poison",[14,459,460,461,464,465,467,468,471,472,475],{},"If a thread panics while holding a lock, the lock becomes \"poisoned\"; subsequent ",[22,462,463],{},".lock()"," returns ",[22,466,447],{},". This signals possibly-corrupted state. Recover with ",[22,469,470],{},"into_inner()"," if you're sure, or use ",[22,473,474],{},"lock().unwrap()"," to propagate the panic.",[18,477,479,482,483,482,486,489],{"id":478},"once-oncelock-lazylock-initialization",[22,480,481],{},"Once",", ",[22,484,485],{},"OnceLock",[22,487,488],{},"LazyLock"," — Initialization",[27,491,494],{"className":492,"code":493,"language":32,"meta":33},[30],"use std::sync::OnceLock;\nstatic CONFIG: OnceLock\u003CConfig> = OnceLock::new();\nlet c = CONFIG.get_or_init(|| Config::load());\n\n\u002F\u002F 1.80+: LazyLock\nuse std::sync::LazyLock;\nstatic DB: LazyLock\u003CDb> = LazyLock::new(|| Db::open());\nlet _ = &*DB;     \u002F\u002F initialized on first access\n",[22,495,493],{"__ignoreMap":33},[14,497,498,499,501,502,505,506,509],{},"Pre-",[22,500,488],{}," you'd use the ",[22,503,504],{},"once_cell"," or ",[22,507,508],{},"lazy_static"," crates. Modern std has you covered.",[18,511,513,516],{"id":512},"cowt-clone-on-write",[22,514,515],{},"Cow\u003CT>"," — Clone-on-Write",[27,518,521],{"className":519,"code":520,"language":32,"meta":33},[30],"use std::borrow::Cow;\nfn greet(name: Cow\u003Cstr>) {\n    println!(\"{name}\");\n}\ngreet(\"literal\".into());           \u002F\u002F borrowed\ngreet(String::from(\"owned\").into()); \u002F\u002F owned\n",[22,522,520],{"__ignoreMap":33},[14,524,525,528],{},[22,526,527],{},"Cow\u003C'a, B>"," is either borrowed or owned — lets you write APIs that accept either, deferring the clone until mutation.",[27,530,533],{"className":531,"code":532,"language":32,"meta":33},[30],"let mut c: Cow\u003Cstr> = Cow::Borrowed(\"hi\");\nc.to_mut().push('!');     \u002F\u002F clones once, now owned\n",[22,534,532],{"__ignoreMap":33},[18,536,538,541],{"id":537},"pint-pinned-pointers",[22,539,540],{},"Pin\u003CT>"," — Pinned Pointers",[14,543,544,547,548,551],{},[22,545,546],{},"Pin"," guarantees a value won't be moved in memory after pinning. Essential for self-referential data (e.g., async futures holding references across ",[22,549,550],{},".await"," points):",[27,553,556],{"className":554,"code":555,"language":32,"meta":33},[30],"let mut fut = async { 5 };\nlet pinned = Pin::new(&mut fut);\n",[22,557,555],{"__ignoreMap":33},[14,559,560,561,563],{},"You usually don't write ",[22,562,546],{}," by hand — async\u002Fawait generates it. The Pin chapter (Async) covers the details.",[18,565,567,482,570,482,573,576],{"id":566},"nonnullt-mut-t-const-t-unsafe",[22,568,569],{},"NonNull\u003CT>",[22,571,572],{},"*mut T",[22,574,575],{},"*const T"," (Unsafe)",[14,578,579,580,583,584,586,587,589],{},"Raw pointers, no automatic lifetime tracking; only usable in ",[22,581,582],{},"unsafe"," blocks. ",[22,585,569],{}," is non-null ",[22,588,572],{}," and is covariant. Used in collections\u002FFFI. See Unsafe chapter.",[18,591,593],{"id":592},"smart-pointer-cheat-sheet","Smart Pointer Cheat Sheet",[595,596,597,619],"table",{},[598,599,600],"thead",{},[601,602,603,607,610,613,616],"tr",{},[604,605,606],"th",{},"Type",[604,608,609],{},"Ownership",[604,611,612],{},"Mutability",[604,614,615],{},"Thread-safe",[604,617,618],{},"Use",[620,621,622,648,668,688,708,724,740,756,778],"tbody",{},[601,623,624,629,632,639,645],{},[625,626,627],"td",{},[22,628,24],{},[625,630,631],{},"Single",[625,633,634,635,638],{},"direct (",[22,636,637],{},"mut",")",[625,640,641,642],{},"if ",[22,643,644],{},"T: Send",[625,646,647],{},"Heap, recursion",[601,649,650,654,657,662,665],{},[625,651,652],{},[22,653,113],{},[625,655,656],{},"Shared",[625,658,659,660],{},"via ",[22,661,176],{},[625,663,664],{},"NO",[625,666,667],{},"Graphs, trees",[601,669,670,674,676,682,685],{},[625,671,672],{},[22,673,205],{},[625,675,656],{},[625,677,659,678,140,680],{},[22,679,300],{},[22,681,437],{},[625,683,684],{},"YES",[625,686,687],{},"Cross-thread share",[601,689,690,694,696,701,703],{},[625,691,692],{},[22,693,312],{},[625,695,631],{},[625,697,698],{},[22,699,700],{},"set\u002Fget",[625,702,664],{},[625,704,705,707],{},[22,706,327],{}," flags",[601,709,710,714,716,719,721],{},[625,711,712],{},[22,713,355],{},[625,715,631],{},[625,717,718],{},"runtime borrow",[625,720,664],{},[625,722,723],{},"Single-thread mut share",[601,725,726,730,732,735,737],{},[625,727,728],{},[22,729,416],{},[625,731,631],{},[625,733,734],{},"lock",[625,736,684],{},[625,738,739],{},"Cross-thread mut share",[601,741,742,746,748,751,753],{},[625,743,744],{},[22,745,419],{},[625,747,631],{},[625,749,750],{},"read\u002Fwrite lock",[625,752,684],{},[625,754,755],{},"Read-heavy share",[601,757,758,762,765,770,775],{},[625,759,760],{},[22,761,527],{},[625,763,764],{},"Either",[625,766,767],{},[22,768,769],{},"to_mut",[625,771,641,772],{},[22,773,774],{},"B: Send",[625,776,777],{},"Borrowed-or-owned",[601,779,780,785,788,793,798],{},[625,781,782],{},[22,783,784],{},"Pin\u003CP>",[625,786,787],{},"(wrapper)",[625,789,659,790],{},[22,791,792],{},"DerefMut",[625,794,641,795],{},[22,796,797],{},"P: Send",[625,799,800],{},"Self-referential",[18,802,804],{"id":803},"deref-and-derefmut","Deref and DerefMut",[14,806,807,808,140,811,813,814,817],{},"Smart pointers implement ",[22,809,810],{},"Deref",[22,812,792],{}," to enable ",[22,815,816],{},"&","-coercions and method forwarding:",[27,819,822],{"className":820,"code":821,"language":32,"meta":33},[30],"let b = Box::new(String::from(\"hi\"));\nb.push('!');              \u002F\u002F Box\u003CString> derefs to String, which derefs to str\nlet s: &str = &b;          \u002F\u002F &Box\u003CString> -> &String -> &str\n",[22,823,821],{"__ignoreMap":33},[18,825,827],{"id":826},"drop-order-for-smart-pointers","Drop Order for Smart Pointers",[37,829,830,839],{},[40,831,832,140,834,140,836,838],{},[22,833,59],{},[22,835,167],{},[22,837,147],{}," drop their contents when refcount hits 0.",[40,840,841,140,844,847],{},[22,842,843],{},"MutexGuard",[22,845,846],{},"RwLockReadGuard"," release the lock on drop — keep guards short-scoped.",[18,849,851],{"id":850},"common-pitfalls","Common Pitfalls",[37,853,854,865,876,882,888,902,913,922],{},[40,855,856,371,861,864],{},[127,857,858,860],{},[22,859,167],{}," across threads",[22,862,863],{},"Rc: !Send",", compile error.",[40,866,867,875],{},[127,868,869,241,872],{},[22,870,871],{},"Arc\u003CMutex\u003CT>>",[22,873,874],{},"Mutex\u003CArc\u003CT>>",": the former mutates shared data; the latter replaces the entire shared pointer atomically.",[40,877,878,881],{},[127,879,880],{},"Lock granularity",": too coarse = contention; too fine = deadlocks.",[40,883,884,887],{},[127,885,886],{},"Deadlock",": lock ordering must be consistent across threads. Acquire locks in a fixed order.",[40,889,890,898,899,901],{},[127,891,892,241,895],{},[22,893,894],{},"Rc::clone",[22,896,897],{},"Clone::clone",": same; ",[22,900,156],{}," makes it obvious it's cheap.",[40,903,904,912],{},[127,905,906,464,909],{},[22,907,908],{},"Weak::upgrade",[22,910,911],{},"Option",": handle the case where the value was dropped.",[40,914,915,921],{},[127,916,917,920],{},[22,918,919],{},"RefCell::borrow_mut"," panic",": can happen in complex call graphs; structure borrows to release before re-borrowing.",[40,923,924,929],{},[127,925,926],{},[22,927,928],{},"Mutex::lock().unwrap()",": panics on poison. Consider graceful recovery.",[18,931,933],{"id":932},"memory-layout-of-smart-pointers","Memory Layout of Smart Pointers",[37,935,936,941,952,962],{},[40,937,938,940],{},[22,939,24],{},": a single pointer.",[40,942,943,140,945,947,948,951],{},[22,944,113],{},[22,946,205],{},": pointer to a heap-allocated ",[22,949,950],{},"{ strong_count, weak_count, value }"," block.",[40,953,954,140,956,958,959,961],{},[22,955,312],{},[22,957,355],{},": in-place storage; ",[22,960,176],{}," adds a borrow-state field.",[40,963,964,140,966,968],{},[22,965,416],{},[22,967,419],{},": in-place storage + OS synchronization primitives.",[18,970,972],{"id":971},"summary","Summary",[14,974,975,977,978,140,980,982,983,140,986,140,988,140,990,992,993,996,997,999,1000,1002,1003,1005],{},[22,976,59],{}," = single-owner heap. ",[22,979,167],{},[22,981,147],{}," = shared ownership. ",[22,984,985],{},"Cell",[22,987,176],{},[22,989,300],{},[22,991,437],{}," = interior mutability. ",[22,994,995],{},