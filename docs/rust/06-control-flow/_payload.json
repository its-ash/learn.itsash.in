 x in &mut v",": the mutable borrow prevents pushing\u002Fpopping during iteration.",[204,1812,1813,980,1816,1819,1820,1823],{},[208,1814,1815],{},"Match on references and deref coercion",[18,1817,1818],{},"match &opt { Some(x) => ... }"," doesn't auto-deref; you need ",[18,1821,1822],{},"match opt.as_ref() { Some(x) => ... }"," for references inside the pattern.",[204,1825,1826,980,1829,1316,1832,1835],{},[208,1827,1828],{},"Binding in guards",[18,1830,1831],{},"if let Some(x) = opt { if x > 10 { } }",[18,1833,1834],{},"if let Some(x) = opt, x > 10 { }"," (let chains, unstable) — use explicit if\u002Felse for clarity.",[204,1837,1838,980,1843,1846,1847,1849,1850,1852,1853,234],{},[208,1839,1840,1842],{},[18,1841,824],{}," with or-patterns and different captures",[18,1844,1845],{},"Some(x) | None => ..."," captures ",[18,1848,229],{}," only if the first arm matches; ",[18,1851,1446],{}," arm can't use ",[18,1854,229],{},[204,1856,1857,1863,1864,1866,1867,1870],{},[208,1858,1661,1859,1316,1861],{},[18,1860,1531],{},[18,1862,1539],{},": both are infinite, but ",[18,1865,283],{}," is idiomatic and slightly more efficient (compiler recognizes it as an infinite loop). Use ",[18,1868,1869],{},"loop { ... break; }"," for controlled early exits.",[14,1872,1874],{"id":1873},"spot-the-bug","🧠 Spot the Bug",[287,1876,1877],{},"What's wrong with this \"find the first even number, or -1\" function?",[23,1879,1880],{"language":25},[27,1881,1883],{"className":29,"code":1882,"language":25,"meta":31,"style":31},"fn first_even(nums: &[i32]) -> i32 {\n    let mut result = -1;\n    for &n in nums {\n        if n % 2 == 0 {\n            result = n;\n            break;\n        }\n    }\n    result\n}\n\nfn main() {\n    let result = 'search: loop {\n        let nums = [3, 5, 7, 8, 9];\n        for &n in &nums {\n            if n % 2 == 0 {\n                break 'search n;\n            }\n        }\n        break 'search -1;\n    };\n    println!(\"{result}\");\n}\n",[18,1884,1885,1912,