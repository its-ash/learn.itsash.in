[{"data":1,"prerenderedAt":571},["ShallowReactive",2],{"page-\u002Frust\u002F06-control-flow":3},{"id":4,"title":5,"body":6,"description":29,"extension":564,"meta":565,"navigation":566,"path":567,"seo":568,"stem":569,"__hash__":570},"content\u002Frust\u002F06-control-flow.md","06 — Control Flow",{"type":7,"value":8,"toc":537},"minimark",[9,13,22,32,73,79,84,95,101,106,112,126,131,137,143,150,156,168,173,176,182,234,238,244,251,257,263,269,275,284,302,308,314,341,345,489,498,504,514,518],[10,11,5],"h1",{"id":12},"_06-control-flow",[14,15,17,21],"h2",{"id":16},"if-expressions",[18,19,20],"code",{},"if"," Expressions",[23,24,30],"pre",{"className":25,"code":27,"language":28,"meta":29},[26],"language-rust","let n = 5;\nif n > 0 {\n    println!(\"positive\");\n} else if n \u003C 0 {\n    println!(\"negative\");\n} else {\n    println!(\"zero\");\n}\n\nlet sign = if n > 0 { 1 } else { -1 };   \u002F\u002F if is an expression\n","rust","",[18,31,27],{"__ignoreMap":29},[33,34,35,48,67],"ul",{},[36,37,38,39,43,44,47],"li",{},"Branches must return the ",[40,41,42],"strong",{},"same type"," (or ",[18,45,46],{},"!",").",[36,49,50,51,54,55,58,59,62,63,66],{},"The condition must be a ",[18,52,53],{},"bool"," — no truthy integers, no ",[18,56,57],{},"if x { }"," where ",[18,60,61],{},"x"," is ",[18,64,65],{},"i32",".",[36,68,69,72],{},[18,70,71],{},"if let"," combines pattern match + branch.",[23,74,77],{"className":75,"code":76,"language":28,"meta":29},[26],"if let Some(v) = opt {\n    println!(\"{v}\");\n}\n",[18,78,76],{"__ignoreMap":29},[14,80,82],{"id":81},"loop",[18,83,81],{},[85,86,87,88,91,92,94],"p",{},"Infinite loop until ",[18,89,90],{},"break",". ",[18,93,90],{}," can return a value:",[23,96,99],{"className":97,"code":98,"language":28,"meta":29},[26],"let mut i = 0;\nlet result = loop {\n    if i == 10 { break i * 2; }\n    i += 1;\n};\n",[18,100,98],{"__ignoreMap":29},[102,103,105],"h3",{"id":104},"labeled-loops","Labeled Loops",[23,107,110],{"className":108,"code":109,"language":28,"meta":29},[26],"'outer: for i in 0..3 {\n    for j in 0..3 {\n        if i == j { continue 'outer; }\n        if i + j > 3 { break 'outer; }\n        println!(\"{i},{j}\");\n    }\n}\n",[18,111,109],{"__ignoreMap":29},[85,113,114,115,91,118,121,122,125],{},"Labels start with ",[18,116,117],{},"'",[18,119,120],{},"break 'label"," and ",[18,123,124],{},"continue 'label"," control the outer loop.",[14,127,129],{"id":128},"while",[18,130,128],{},[23,132,135],{"className":133,"code":134,"language":28,"meta":29},[26],"let mut n = 5;\nwhile n > 0 {\n    n -= 1;\n}\n\nwhile let Some(x) = stack.pop() {\n    println!(\"{x}\");\n}\n",[18,136,134],{"__ignoreMap":29},[85,138,139,142],{},[18,140,141],{},"while let"," repeatedly matches; exits when pattern fails.",[14,144,146,149],{"id":145},"for-iterator-based",[18,147,148],{},"for"," (Iterator Based)",[23,151,154],{"className":152,"code":153,"language":28,"meta":29},[26],"for i in 0..5 { print!(\"{i} \"); }        \u002F\u002F 0 1 2 3 4\nfor i in 0..=5 { print!(\"{i} \"); }       \u002F\u002F inclusive 0..5\nfor c in \"abc\".chars() { print!(\"{c}\"); }\nfor b in &[1, 2, 3] { print!(\"{b} \"); }   \u002F\u002F borrows\nfor v in vec![1, 2, 3] { print!(\"{v} \"); } \u002F\u002F consumes\n",[18,155,153],{"__ignoreMap":29},[85,157,158,160,161,164,165,167],{},[18,159,148],{}," consumes an ",[18,162,163],{},"IntoIterator",". Arrays implement ",[18,166,163],{}," (by value) since edition 2021.",[14,169,171],{"id":170},"match",[18,172,170],{},[85,174,175],{},"Exhaustive pattern matching. Powerful and central to Rust:",[23,177,180],{"className":178,"code":179,"language":28,"meta":29},[26],"match x {\n    0 => \"zero\",\n    1 | 2 => \"small\",\n    3..=9 => \"medium\",\n    n if n \u003C 100 => \"big\",     \u002F\u002F match guard\n    _ => \"huge\",\n};\n",[18,181,179],{"__ignoreMap":29},[33,183,184,191,194,197,203,214,224],{},[36,185,186,187,190],{},"Must be exhaustive; ",[18,188,189],{},"_"," is the wildcard.",[36,192,193],{},"Arms evaluate to a single common type.",[36,195,196],{},"Order matters; first matching arm wins.",[36,198,199,200,66],{},"Multiple patterns with ",[18,201,202],{},"|",[36,204,205,206,209,210,213],{},"Ranges with ",[18,207,208],{},"..="," (only for ",[18,211,212],{},"char"," and numeric types).",[36,215,216,219,220,223],{},[40,217,218],{},"Match guards"," (",[18,221,222],{},"if cond",") enable extra conditions but can prevent exhaustiveness analysis.",[36,225,226,227,230,231,66],{},"Binding with ",[18,228,229],{},"@",": ",[18,232,233],{},"Some(n @ 1..=10) => n",[102,235,237],{"id":236},"binding-modes-2021-edition","Binding Modes (2021 edition)",[23,239,242],{"className":240,"code":241,"language":28,"meta":29},[26],"match &opt {\n    Some(x) => println!(\"{x}\"),   \u002F\u002F x: &i32 — auto-ref\n    None => {}\n}\n",[18,243,241],{"__ignoreMap":29},[85,245,246,247,250],{},"The 2021 edition \"default binding modes\" let you avoid writing ",[18,248,249],{},"&"," everywhere; the compiler inserts references as needed. This can be subtle — see the Patterns chapter.",[14,252,254,256],{"id":253},"match-on-references",[18,255,170],{}," on References",[23,258,261],{"className":259,"code":260,"language":28,"meta":29},[26],"match &s {\n    &\"yes\" => 1,\n    _ => 0,\n}\n\u002F\u002F or pattern-match by value of &str (Copy):\nmatch s.as_str() {\n    \"yes\" => 1,\n    _ => 0,\n}\n",[18,262,260],{"__ignoreMap":29},[14,264,266,267],{"id":265},"destructuring-in-match","Destructuring in ",[18,268,170],{},[23,270,273],{"className":271,"code":272,"language":28,"meta":29},[26],"enum Shape { Circle(f64), Square(f64), Rect(f64, f64) }\nmatch shape {\n    Shape::Circle(r) => 3.14 * r * r,\n    Shape::Square(s) => s * s,\n    Shape::Rect(a, b) if a == b => a * a,    \u002F\u002F guard: catch squares\n    Shape::Rect(a, b) => a * b,\n}\n",[18,274,272],{"__ignoreMap":29},[14,276,278,279,281,282],{"id":277},"returning-from-match-vs-break","Returning from ",[18,280,170],{}," vs ",[18,283,90],{},[85,285,286,288,289,292,293,292,295,298,299,66],{},[18,287,170],{}," is an expression. To short-circuit, use ",[18,290,291],{},"return",", ",[18,294,90],{},[18,296,297],{},"?",", or ",[18,300,301],{},"continue",[14,303,305,307],{"id":304},"operator-error-propagation",[18,306,297],{}," Operator (Error Propagation)",[23,309,312],{"className":310,"code":311,"language":28,"meta":29},[26],"fn parse_and_double(s: &str) -> Result\u003Ci32, ParseIntError> {\n    let n: i32 = s.parse()?;\n    Ok(n * 2)\n}\n",[18,313,311],{"__ignoreMap":29},[85,315,316,318,319,43,322,325,326,329,330,333,334,336,337,340],{},[18,317,297],{}," returns early from the function on ",[18,320,321],{},"Err",[18,323,324],{},"None"," with ",[18,327,328],{},"Option","). Works on anything implementing ",[18,331,332],{},"Try"," (stabilized for ",[18,335,328],{},"\u002F",[18,338,339],{},"Result","). See Error Handling chapter.",[14,342,344],{"id":343},"control-flow-edge-cases","Control-Flow Edge Cases",[33,346,347,362,376,390,401,415,423,440,450,467],{},[36,348,349,358,359,361],{},[40,350,351,353,354,357],{},[18,352,20],{}," returning ",[18,355,356],{},"()"," vs value",": forgetting the trailing expr in one arm gives ",[18,360,356],{}," and a type mismatch error.",[36,363,364,369,370,372,373,375],{},[40,365,366,368],{},[18,367,90],{}," value type",": every ",[18,371,90],{}," in the same ",[18,374,81],{}," must return the same type.",[36,377,378,384,385,387,388,66],{},[40,379,380,62,382],{},[18,381,301],{},[18,383,356],{},": can't use ",[18,386,301],{}," to return a value from a ",[18,389,81],{},[36,391,392,397,398,66],{},[40,393,394,396],{},[18,395,148],{}," consumes the iterator",": can't easily get the index — use ",[18,399,400],{},".enumerate()",[36,402,403,230,409,411,412,414],{},[40,404,405,281,407],{},[18,406,141],{},[18,408,71],{},[18,410,128],{}," loops; ",[18,413,20],{}," runs once.",[36,416,417,422],{},[40,418,419,421],{},[18,420,170],{}," arm trailing comma",": optional but idiomatic.",[36,424,425,431,432,435,436,439],{},[40,426,427,428,430],{},"Empty ",[18,429,170],{}," on a non-exhaustive enum"," across crates requires ",[18,433,434],{},"_ => unreachable!()"," because adding variants is a non-breaking change for the upstream crate (unless ",[18,437,438],{},"#[non_exhaustive]"," rules apply).",[36,441,442,446,447,449],{},[40,443,444],{},[18,445,438],{}," on an enum forces downstream code to include a ",[18,448,189],{}," arm even if all current variants are matched (future-proofing).",[36,451,452,230,455,292,458,461,462,121,464,466],{},[40,453,454],{},"Short-circuit evaluation",[18,456,457],{},"&&",[18,459,460],{},"||"," short-circuit. ",[18,463,249],{},[18,465,202],{}," are bitwise and don't.",[36,468,469,475,476,336,478,481,482,336,485,488],{},[40,470,471,472],{},"No ternary ",[18,473,474],{},"?:",": use ",[18,477,20],{},[18,479,480],{},"else"," expressions, or ",[18,483,484],{},".then()",[18,486,487],{},".unwrap_or()"," on bools.",[14,490,492,494,495],{"id":491},"if-let-chains-unstable-let-else",[18,493,71],{}," chains (unstable) \u002F ",[18,496,497],{},"let-else",[23,499,502],{"className":500,"code":501,"language":28,"meta":29},[26],"let Some(x) = opt else { return; };\n",[18,503,501],{"__ignoreMap":29},[85,505,506,508,509,511,512,66],{},[18,507,497],{}," is the idiomatic early-return form. For multiple conditions, use nested ",[18,510,497],{}," or a ",[18,513,170],{},[14,515,517],{"id":516},"summary","Summary",[85,519,520,336,522,336,524,336,526,336,528,530,531,533,534,536],{},[18,521,20],{},[18,523,128],{},[18,525,148],{},[18,527,81],{},[18,529,170],{}," are all expressions. ",[18,532,170],{}," is exhaustive and central. ",[18,535,297],{}," propagates errors. Labels disambiguate nested loops. Next: the famous Ownership model.",{"title":29,"searchDepth":538,"depth":538,"links":539},2,[540,542,546,547,549,552,554,556,558,560,561,563],{"id":16,"depth":538,"text":541},"if Expressions",{"id":81,"depth":538,"text":81,"children":543},[544],{"id