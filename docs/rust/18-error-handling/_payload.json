[{"data":1,"prerenderedAt":842},["ShallowReactive",2],{"page-\u002Frust\u002F18-error-handling":3},{"id":4,"title":5,"body":6,"description":834,"extension":835,"meta":836,"navigation":837,"path":838,"seo":839,"stem":840,"__hash__":841},"content\u002Frust\u002F18-error-handling.md","18 — Error Handling",{"type":7,"value":8,"toc":792},"minimark",[9,13,35,43,53,60,66,73,79,85,93,99,105,110,116,126,135,141,149,158,166,172,181,185,191,208,215,221,249,253,257,263,270,276,296,303,309,315,322,328,337,341,366,373,377,408,417,423,429,435,439,445,452,458,468,475,481,489,493,499,508,514,520,524,711,715,758,762,789],[10,11,5],"h1",{"id":12},"_18-error-handling",[14,15,16,17,21,22,26,27,30,31,34],"p",{},"Rust's error handling is a defining strength. There's no exceptions, no ",[18,19,20],"code",{},"null",". Errors are ",[23,24,25],"strong",{},"values"," (",[18,28,29],{},"Result","\u002F",[18,32,33],{},"Option",") and the type system forces you to handle them.",[36,37,39,42],"h2",{"id":38},"optiont-absence",[18,40,41],{},"Option\u003CT>"," — Absence",[44,45,51],"pre",{"className":46,"code":48,"language":49,"meta":50},[47],"language-rust","enum Option\u003CT> { Some(T), None }\n","rust","",[18,52,48],{"__ignoreMap":50},[14,54,55,56,59],{},"Use when a value is logically absent. The compiler forces you to handle ",[18,57,58],{},"None",":",[44,61,64],{"className":62,"code":63,"language":49,"meta":50},[47],"let v: Option\u003Ci32> = Some(5);\nlet s = match v { Some(x) => x.to_string(), None => String::from(\"none\") };\n",[18,65,63],{"__ignoreMap":50},[36,67,69,72],{"id":68},"resultt-e-recoverable-errors",[18,70,71],{},"Result\u003CT, E>"," — Recoverable Errors",[44,74,77],{"className":75,"code":76,"language":49,"meta":50},[47],"enum Result\u003CT, E> { Ok(T), Err(E) }\n",[18,78,76],{"__ignoreMap":50},[44,80,83],{"className":81,"code":82,"language":49,"meta":50},[47],"fn parse(s: &str) -> Result\u003Ci32, std::num::ParseIntError> {\n    s.parse()\n}\nmatch parse(\"42\") {\n    Ok(n) => println!(\"{n}\"),\n    Err(e) => println!(\"err: {e}\"),\n}\n",[18,84,82],{"__ignoreMap":50},[36,86,88,89,92],{"id":87},"the-operator","The ",[18,90,91],{},"?"," Operator",[14,94,95,96,59],{},"Short-circuits on error, propagating ",[18,97,98],{},"Err",[44,100,103],{"className":101,"code":102,"language":49,"meta":50},[47],"fn parse_and_double(s: &str) -> Result\u003Ci32, std::num::ParseIntError> {\n    let n: i32 = s.parse()?;     \u002F\u002F returns Err on failure\n    Ok(n * 2)\n}\n",[18,104,102],{"__ignoreMap":50},[14,106,107,109],{},[18,108,91],{}," desugars roughly to:",[44,111,114],{"className":112,"code":113,"language":49,"meta":50},[47],"match expr {\n    Ok(v) => v,\n    Err(e) => return Err(e.into()),\n}\n",[18,115,113],{"__ignoreMap":50},[14,117,118,119,122,123,125],{},"It uses ",[18,120,121],{},"From"," to convert errors, so you can mix error types if they implement ",[18,124,121],{},".",[127,128,130,132,133],"h3",{"id":129},"on-option",[18,131,91],{}," on ",[18,134,33],{},[44,136,139],{"className":137,"code":138,"language":49,"meta":50},[47],"fn first_char(s: &str) -> Option\u003Cchar> {\n    s.chars().next()?\n}\n",[18,140,138],{"__ignoreMap":50},[14,142,143,144,146,147,125],{},"Returns ",[18,145,58],{}," if the inner is ",[18,148,58],{},[127,150,152,154,155],{"id":151},"in-main",[18,153,91],{}," in ",[18,156,157],{},"main",[14,159,160,161,163,164,59],{},"Since Rust 1.56, ",[18,162,157],{}," can return ",[18,165,29],{},[44,167,170],{"className":168,"code":169,"language":49,"meta":50},[47],"fn main() -> Result\u003C(), Box\u003Cdyn std::error::Error>> {\n    let n: i32 = std::env::args().nth(1).unwrap().parse()?;\n    println!(\"{n}\");\n    Ok(())\n}\n",[18,171,169],{"__ignoreMap":50},[14,173,174,175,177,178,180],{},"If ",[18,176,157],{}," returns ",[18,179,98],{},", the program exits with code 1 and prints the error.",[36,182,184],{"id":183},"recovering-values","Recovering Values",[44,186,189],{"className":187,"code":188,"language":49,"meta":50},[47],"let v = opt.unwrap();          \u002F\u002F panics on None\nlet v = opt.expect(\"msg\");      \u002F\u002F panics with custom msg\nlet v = opt.unwrap_or(default);\nlet v = opt.unwrap_or_default();\nlet v = opt.unwrap_or_else(|| expensive());\nlet v = opt.map(|x| x + 1);   \u002F\u002F Option\u003COption\u003C...>> sometimes\nlet v = opt.and_then(|x| Some(x + 1));   \u002F\u002F flatten\nlet v = opt.or(Some(0));\nlet v = opt.or_else(|| Some(0));\nlet v = opt.get_or_insert(0);\nlet v = opt.take();             \u002F\u002F leaves None in opt\n",[18,190,188],{"__ignoreMap":50},[14,192,193,194,196,197,200,201,200,204,207],{},"Same combinator suite exists for ",[18,195,29],{}," (with ",[18,198,199],{},"map_err",", ",[18,202,203],{},"map",[18,205,206],{},"and_then",", etc.).",[36,209,88,211,214],{"id":210},"the-stderrorerror-trait",[18,212,213],{},"std::error::Error"," Trait",[44,216,219],{"className":217,"code":218,"language":49,"meta":50},[47],"pub trait Error: Debug + Display {\n    fn source(&self) -> Option\u003C&(dyn Error + 'static)> { None }\n}\n",[18,220,218],{"__ignoreMap":50},[14,222,223,224,227,228,231,232,234,235,237,238,30,241,244,245,248],{},"A type implementing ",[18,225,226],{},"Error"," can be used with ",[18,229,230],{},"Result\u003C_, MyError>",", chained with ",[18,233,91],{}," (via ",[18,236,121],{},"), and printed with ",[18,239,240],{},"{:?}",[18,242,243],{},"{}",". The ",[18,246,247],{},"source"," method gives an error chain.",[36,250,252],{"id":251},"defining-your-own-error-type","Defining Your Own Error Type",[127,254,256],{"id":255},"the-manual-way","The Manual Way",[44,258,261],{"className":259,"code":260,"language":49,"meta":50},[47],"#[derive(Debug)]\nenum AppError {\n    Io(std::io::Error),\n    Parse(std::num::ParseIntError),\n    Custom(String),\n}\n\nimpl std::fmt::Display for AppError {\n    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {\n        match self {\n            AppError::Io(e) => write!(f, \"io: {e}\"),\n            AppError::Parse(e) => write!(f, \"parse: {e}\"),\n            AppError::Custom(s) => write!(f, \"{s}\"),\n        }\n    }\n}\n\nimpl std::error::Error for AppError {\n    fn source(&self) -> Option\u003C&(dyn std::error::Error + 'static)> {\n        match self {\n            AppError::Io(e) => Some(e),\n            AppError::Parse(e) => Some(e),\n            AppError::Custom(_) => None,\n        }\n    }\n}\n\nimpl From\u003Cstd::io::Error> for AppError { fn from(e: std::io::Error) -> Self { AppError::Io(e) } }\nimpl From\u003Cstd::num::ParseIntError> for AppError { fn from(e: std::num::ParseIntError) -> Self { AppError::Parse(e) } }\n",[18,262,260],{"__ignoreMap":50},[127,264,88,266,269],{"id":265},"the-thiserror-crate-idiomatic",[18,267,268],{},"thiserror"," Crate (idiomatic)",[44,271,274],{"className":272,"code":273,"language":49,"meta":50},[47],"use thiserror::Error;\n\n#[derive(Debug, Error)]\nenum AppError {\n    #[error(\"io: {0}\")]\n    Io(#[from] std::io::Error),\n    #[error(\"parse: {0}\")]\n    Parse(#[from] std::num::ParseIntError),\n    #[error(\"{0}\")]\n    Custom(String),\n}\n",[18,275,273],{"__ignoreMap":50},[14,277,278,281,282,284,285,288,289,292,293,295],{},[18,279,280],{},"#[from]"," generates the ",[18,283,121],{}," impl. ",[18,286,287],{},"#[error]"," generates ",[18,290,291],{},"Display",". Use ",[18,294,268],{}," for libraries.",[127,297,88,299,302],{"id":298},"the-anyhow-crate-applications",[18,300,301],{},"anyhow"," Crate (applications)",[44,304,307],{"className":305,"code":306,"language":49,"meta":50},[47],"use anyhow::{Context, Result};\n\nfn read_config(path: &str) -> Result\u003CConfig> {\n    let s = std::fs::read_to_string(path).with_context(|| format!(\"read {path}\"))?;\n    Ok(parse(&s)?)\n}\n",[18,308,306],{"__ignoreMap":50},[14,310,311,314],{},[18,312,313],{},"anyhow::Error"," is a boxed trait object with backtraces and context. Perfect for application code where you just want errors to bubble up with context.",[36,316,318,321],{"id":317},"panic-unrecoverable",[18,319,320],{},"panic!"," — Unrecoverable",[44,323,326],{"className":324,"code":325,"language":49,"meta":50},[47],"panic!(\"cannot continue\");\nunreachable!(\"documented unreachable\");\nunimplemented!(\"todo\");\ntodo!(\"later\");\nassert!(x > 0);\nassert_eq!(a, b);\nassert_ne!(a, b);\ndebug_assert!(x > 0);   \u002F\u002F only in debug builds\n",[18,327,325],{"__ignoreMap":50},[14,329,330,332,333,336],{},[18,331,320],{}," is for invariants: \"this state should never happen.\" It unwinds the stack (calling destructors) unless ",[18,334,335],{},"panic = \"abort\""," is set in the profile.",[36,338,340],{"id":339},"unwinding-vs-aborting","Unwinding vs Aborting",[342,343,344,355],"ul",{},[345,346,347,350,351,354],"li",{},[23,348,349],{},"Unwind"," (default): cleans up via ",[18,352,353],{},"Drop",", then exits the thread\u002Fprocess.",[345,356,357,26,360,154,362,365],{},[23,358,359],{},"Abort",[18,361,335],{},[18,363,364],{},"Cargo.toml","): immediate process exit, smaller binary, faster panic, but no cleanup.",[14,367,368,369,372],{},"Catch a panic with ",[18,370,371],{},"std::panic::catch_unwind"," (rare; mostly for FFI).",[36,374,376],{"id":375},"result-vs-panic-heuristics","Result vs panic — Heuristics",[342,378,379,388,397,403],{},[345,380,381,383,384,387],{},[18,382,29],{}," for ",[23,385,386],{},"expected"," failure (file not found, parse error).",[345,389,390,383,393,396],{},[18,391,392],{},"panic",[23,394,395],{},"violated invariants"," (index out of bounds, unreachable code, internal corruption).",[345,398,399,400,402],{},"Returning ",[18,401,33],{}," for \"logically absent\" (looking up a key).",[345,404,399,405,407],{},[18,406,29],{}," for \"operation failed\".",[36,409,411,413,414,416],{"id":410},"option-and-result-conversion",[18,412,33],{}," and ",[18,415,29],{}," Conversion",[44,418,421],{"className":419,"code":420,"language":49,"meta":50},[47],"opt.ok_or(ErrorKind::Missing)?;\nres.ok()?;                    \u002F\u002F discards Err, returns None on Err\nres.err()?;                   \u002F\u002F discards Ok\nres.ok().filter(|x| *x > 0);\nopt.ok_or_else(|| ErrorKind::Missing)?;\n",[18,422,420],{"__ignoreMap":50},[36,424,426,428],{"id":425},"result-combinators",[18,427,29],{}," Combinators",[44,430,433],{"className":431,"code":432,"language":49,"meta":50},[47],"let r: Result\u003Ci32, E> = Ok(5);\nr.map(|x| x + 1);\nr.map_err(|e| OtherError(e));\nr.and_then(|x| Ok(x + 1));\nr.or(Ok(0));\nr.or_else(|_| Ok(0));\nr.unwrap_or(0);\nr.unwrap_or_default();\nr.unwrap_or_else(|_| 0);\nr.is_ok();\nr.is_err();\nr.ok();          \u002F\u002F Option\u003CT>\nr.err();          \u002F\u002F Option\u003CE>\nr.as_ref();\nr.as_mut();\nr.transpose();    \u002F\u002F Option\u003CResult\u003CT, E>> -> Result\u003COption\u003CT>, E>\n",[18,434,432],{"__ignoreMap":50},[36,436,438],{"id":437},"multiple-errors","Multiple Errors",[44,440,443],{"className":441,"code":442,"language":49,"meta":50},[47],"fn parse_two(s1: &str, s2: &str) -> Result\u003C(i32, i32), ParseIntError> {\n    let a: i32 = s1.parse()?;\n    let b: i32 = s2.parse()?;\n    Ok((a, b))\n}\n",[18,444,442],{"__ignoreMap":50},[14,446,447,448,451],{},"For independent errors you want to accumulate (not short-circuit), use ",[18,449,450],{},"itertools::process_results"," or roll your own.",[36,453,455,457],{"id":454},"result-with-multiple-variants",[18,456,29],{}," with Multiple Variants",[14,459,460,461,464,465,467],{},"Use ",[18,462,463],{},"Result\u003CT, MyErrorEnum>"," and a custom error enum (see ",[18,466,268],{}," above).",[36,469,471,474],{"id":470},"boxdyn-error-as-catchall",[18,472,473],{},"Box\u003Cdyn Error>"," as Catchall",[44,476,479],{"className":477,"code":478,"language":49,"meta":50},[47],"fn foo() -> Result\u003Ci32, Box\u003Cdyn std::error::Error>> {\n    let n: i32 = \"x\".parse()?;     \u002F\u002F works for any Error type\n    let f = std::fs::File::open(\"x\")?;\n    Ok(n)\n}\n",[18,480,478],{"__ignoreMap":50},[14,482,483,485,486,488],{},[18,484,473],{}," accepts any error via ",[18,487,91],{},". Loses static type info; ok for prototypes.",[36,490,492],{"id":491},"error-chaining","Error Chaining",[44,494,497],{"className":495,"code":496,"language":49,"meta":50},[47],"return Err(MyError::New).context(\"while processing X\"));\n",[18,498,496],{"__ignoreMap":50},[14,500,501,503,504,507],{},[18,502,301],{},"'s ",[18,505,506],{},"Context"," trait adds messages:",[44,509,512],{"className":510,"code":511,"language":49,"meta":50},[47],"std::fs::read_to_string(path).context(\"read config\")?;\n",[18,513,511],{"__ignoreMap":50},[14,515,516,517,125],{},"The error chain shows: \"read config\" → original ",[18,518,519],{},"io::Error",[36,521,523],{"id":522},"edge-cases-pitfalls","Edge Cases & Pitfalls",[342,525,526,542,554,564,581,589,609,623,635,646,668,685,699],{},[345,527,528,534,535,537,538,541],{},[23,529,530,533],{},[18,531,532],{},"unwrap()"," in production",": panic on bad input. Use ",[18,536,91],{}," or ",[18,539,540],{},"match"," instead.",[345,543,544,553],{},[23,545,546,549,550],{},[18,547,548],{},"expect()"," is better than ",[18,551,552],{},"unwrap",": a custom message helps debugging.",[345,555,556,559,560,563],{},[23,557,558],{},"Panic across FFI",": undefined behavior — use ",[18,561,562],{},"catch_unwind"," at the FFI boundary.",[345,565,566,572,573,575,576,503,578,580],{},[23,567,568,413,570],{},[18,569,91],{},[18,571,121],{},": when mixing error types, ensure ",[18,574,121],{}," impls exist; ",[18,577,268],{},[18,579,280],{}," is the easy way.",[345,582,583,586,587,125],{},[23,584,585],{},"Panic in destructors",": aborts; avoid panicking in ",[18,588,353],{},[345,590,591,601,602,604,605,608],{},[23,592,593,132,595,597,598,600],{},[18,594,91],{},[18,596,33],{}," returns from ",[18,599,33],{},"-returning functions only",": ",[18,603,91],{}," requires ",[18,606,607],{},"Try",", and the return type must match.",[345,610,611,622],{},[23,612,613,604,615,618,619],{},[18,614,213],{},[18,616,617],{},"Send + Sync"," to box as ",[18,620,621],{},"Box\u003Cdyn Error + Send + Sync>"," — useful for thread-safe error storage.",[345,624,625,601,628,631,632,634],{},[23,626,627],{},"Backtraces",[18,629,630],{},"std::backtrace::Backtrace"," (1.65+) gives you a backtrace at error construction; ",[18,633,301],{}," integrates with it.",[345,636,637,645],{},[23,638,639,30,642],{},[18,640,641],{},"Result::into_ok",[18,643,644],{},"into_err"," consume without checking — useful only when you're sure.",[345,647,648,601,656,200,659,200,662,200,665,125],{},[23,649,650,652,653,655],{},[18,651,29],{}," vs ",[18,654,33],{}," interop",[18,657,658],{},"Option::ok_or",[18,660,661],{},"Option::ok_or_else",[18,663,664],{},"Result::ok",[18,666,667],{},"Result::err",[345,669,670,673,674,677,678,681,682,125],{},[23,671,672],{},"Panicking in a thread",": kills the thread but not the process. Use ",[18,675,676],{},"JoinHandle"," to detect; the panic becomes ",[18,679,680],{},"Box\u003Cdyn Any + Send>"," from ",[18,683,684],{},"join",[345,686,687,695,696,125],{},[23,688,689,691,692],{},[18,690,71],{}," where ",[18,693,694],{},"T == E",": the compiler can't infer which arm you mean — annotate or use ",[18,697,698],{},".map_err",[345,700,701,707,708,710],{},[23,702,703,704],{},"Custom error type without ",[18,705,706],{},"Debug",": required by ",[18,709,226],{}," trait; derive it.",[36,712,714],{"id":713},"idioms-cheat-sheet","Idioms Cheat Sheet",[342,716,717,722,727,733,738,743,748],{},[345,718,460,719,721],{},[18,720,91],{}," to propagate.",[345,723,724,725,125],{},"Define one error enum per crate with ",[18,726,268],{},[345,728,460,729,732],{},[18,730,731],{},"anyhow::Result"," in application code (binary crates).",[345,734,460,735,737],{},[18,736,29],{}," in library APIs.",[345,739,460,740,742],{},[18,741,33],{}," only when absence is normal, not \"operation failed\".",[345,744,745,747],{},[18,746,320],{}," for invariants, never for input validation in public APIs.",[345,749,750,753,754,757],{},[18,751,752],{},"assert!"," for tests; ",[18,755,756],{},"debug_assert!"," for invariants you don't want in release.",[36,759,761],{"id":760},"summary","Summary",[14,763,764,765,200,767,769,770,772,773,775,776,778,779,781,782,784,785,163,787,125],{},"Errors are values, handled via ",[18,766,91],{},[18,768,540],{},", and combinators. ",[18,771,33],{}," = absence, ",[18,774,29],{}," = failure. ",[18,777,268],{}," for libraries, ",[18,780,301],{}," for apps. ",[18,783,320],{}," for invariants only. ",[18,786,157],{},[18,788,29],{},[14,790,791],{},"Next: Memory management — smart pointers and interior mutability.",{"title":50,"searchDepth":793,"depth":793,"links":794},2,[795,797,799,807,808,810,817,819,820,821,823,825,826,828,830,831,832,833],{"id":38,"depth":793,"text":796},"Option\u003CT> — Absence",{"id":68,"depth":793,"text":798},"Result\u003CT, E> — Recoverable Errors",{"id":87,"depth":793,"text":800,"children":801},"The ? Operator",[802,805],{"id":129,"depth":803,"text":804},3,"? on Option",{"id":151,"depth":803,"text":806},"? in main",{"id":183,"depth":793,"text":184},{"id":210,"depth":793,"text":809},"The std::error::Error Trait",{"id":251,"depth":793,"text":252,"children":811},[812,813,815],{"id":255,"depth":803,"text":256},{"id":265,"depth":803,"text":814},"The thiserror Crate (idiomatic)",{"id":298,"depth":803,"text":816},"The anyhow Crate (applications)",{"id":317,"depth":793,"text":818},"panic! — Unrecoverable",{"id":339,"depth":793,"text":340},{"id":375,"depth":793,"text":376},{"id":410,"depth":793,"text":822},"Option and Result Conversion",{"id":425,"depth":793,"text":824},"Result Combinators",{"id":437,"depth":793,"text":438},{"id":454,"depth":793,"text":827},"Result with Multiple Variants",{"id":470,"depth":793,"text":829},"Box\u003Cdyn Error> as Catchall",{"id":491,"depth":793,"text":492},{"id":522,"depth":793,"text":523},{"id":713,"depth":793,"text":714},{"id":760,"depth":793,"text":761},"Rust's error handling is a defining strength. There's no exceptions, no null. Errors are values (Result\u002FOption) and the type system forces you to handle them.","md",{},true,"\u002Frust\u002F18-error-handling",{"title":5,"description":834},"rust\u002F18-error-handling","ArAxbTcKknbKzyOEnwqcpSw6DEqonq9RGs68LZtHOAo",1785935255231]