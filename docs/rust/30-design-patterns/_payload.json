[{"data":1,"prerenderedAt":2623},["ShallowReactive",2],{"page-\u002Frust\u002F30-design-patterns":3},{"id":4,"title":5,"body":6,"description":16,"extension":2617,"meta":2618,"navigation":96,"path":2619,"seo":2620,"stem":2621,"__hash__":2622},"content\u002Frust\u002F30-design-patterns.md","30 — Design Patterns in Rust",{"type":7,"value":8,"toc":2603},"minimark",[9,13,17,22,25,474,497,501,504,966,981,985,992,1303,1309,1313,1324,1506,1522,1526,1529,1730,1737,1748,1933,1948,1952,1955,2095,2099,2155,2159,2209,2213,2440,2587,2590,2596,2599],[10,11,5],"h1",{"id":12},"_30-design-patterns-in-rust",[14,15,16],"p",{},"Rust's ownership and type system change which patterns are useful. The common ones below are small, and each one turns a class of runtime bugs into compile errors.",[18,19,21],"h2",{"id":20},"builder","Builder",[14,23,24],{},"Rust has no default or named arguments. A builder gives you both:",[26,27,29],"code-wrapper",{"language":28},"rust",[30,31,35],"pre",{"className":32,"code":33,"language":28,"meta":34,"style":34},"language-rust shiki shiki-themes github-light github-dark","#[derive(Debug)]\nstruct Request { url: String, timeout: u32, retries: u32 }\n\nstruct RequestBuilder { url: String, timeout: u32, retries: u32 }\n\nimpl RequestBuilder {\n    fn new(url: &str) -> Self {                       \u002F\u002F REQUIRED values go in new()\n        Self { url: url.into(), timeout: 30, retries: 0 }\n    }\n    fn timeout(mut self, t: u32) -> Self { self.timeout = t; self }   \u002F\u002F optional values\n    fn retries(mut self, r: u32) -> Self { self.retries = r; self }\n    fn build(self) -> Request {\n        Request { url: self.url, timeout: self.timeout, retries: self.retries }\n    }\n}\n\nfn main() {\n    let r = RequestBuilder::new(\"https:\u002F\u002Fx.io\").retries(3).build();\n    println!(\"{r:?}\");   \u002F\u002F Request { url: \"https:\u002F\u002Fx.io\", timeout: 30, retries: 3 }\n}\n","",[36,37,38,54,91,98,126,131,142,179,215,221,276,321,341,376,381