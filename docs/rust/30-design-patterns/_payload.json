6],{"class":45},[14,475,476,480,481,484,485,488,489,492,493,496],{},[477,478,479],"strong",{},"Tricky",": if required fields are ",[36,482,483],{},"Option","s filled by setters, forgetting one only fails ",[477,486,487],{},"at run time"," inside ",[36,490,491],{},"build()",". Put required values in ",[36,494,495],{},"new()"," and the compiler enforces them.",[18,498,500],{"id":499},"newtype-smart-constructor","Newtype + Smart Constructor",[14,502,503],{},"Validate once, then trust the type everywhere:",[26,505,506],{"language":28},[30,507,509],{"className":32,"code":508,"language":28,"meta":34,"style":34},"mod email {\n    #[derive(Debug)]\n    pub struct Email(String);          \u002F\u002F private field — the only way in is parse()\n\n    impl Email {\n        pub fn parse(s: &str) -> Result\u003CEmail, String> {\n            let s = s.trim();\n            if s.contains('@') && !s.starts_with('@') && !s.ends_with('@') {\n                Ok(Email(s.to_lowercase()))\n            } else {\n                Err(format!(\"invalid email: {s:?}\"))\n            }\n        }\n        pub fn as_str(&self) -> &str { &self.0 }\n    }\n}\n\nuse email::Email;\n\nfn send_welcome(to: &Email) {          \u002F\u002F can't be called with an unchecked String\n    println!(\"sending to {}\", to.as_str());\n}\n\nfn main() {\n    let e = Email::parse(\" Ada@Example.com \").unwrap();\n    send_welcome(&e);                   \u002F\u002F sending to ada@example.com\n    println!(\"{}\", Email::parse(\"@nope\").is_err());   \u002F\u002F true\n    \u002F\u002F let fake = Email(\"x\".into());    \u002F\u002F error[E0603]: tuple struct constructor `Email` is private\n}\n",[36,510,511,521,530,552,556,565,606,626,683,702,712,730,735,740,777,781,785,789,803,807,829,850,855,860,869,900,916,952,961],{"__ignoreMap":34},[39,512,513,516,519],{"class":41,"line":42},[39,514,515],{"class":59},"mod",[39,517,518],{"class":49}," email",[39,520,141],{"class":45},[39,522,523,526,528],{"class":41,"line":56},[