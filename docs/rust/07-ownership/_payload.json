[{"data":1,"prerenderedAt":532},["ShallowReactive",2],{"page-\u002Frust\u002F07-ownership":3},{"id":4,"title":5,"body":6,"description":524,"extension":525,"meta":526,"navigation":527,"path":528,"seo":529,"stem":530,"__hash__":531},"content\u002Frust\u002F07-ownership.md","07 — Ownership (The Heart of Rust)",{"type":7,"value":8,"toc":500},"minimark",[9,13,22,27,57,61,85,95,108,115,121,148,164,170,174,180,186,192,196,202,205,209,216,222,236,245,260,264,270,273,277,339,346,353,359,362,371,382,386,389,409,416,422,442,451,457,460,464,492],[10,11,5],"h1",{"id":12},"_07-ownership-the-heart-of-rust",[14,15,16,17,21],"p",{},"Ownership is ",[18,19,20],"strong",{},"the"," defining feature of Rust. Every other memory-safety guarantee flows from these rules.",[23,24,26],"h2",{"id":25},"the-three-rules","The Three Rules",[28,29,30,38,45],"ol",{},[31,32,33,34,37],"li",{},"Each value has exactly one ",[18,35,36],{},"owner"," (a variable).",[31,39,40,41,44],{},"When the owner goes out of scope, the value is ",[18,42,43],{},"dropped"," (its destructor runs).",[31,46,47,48,51,52,56],{},"Assigning or passing a value ",[18,49,50],{},"moves"," it (for non-",[53,54,55],"code",{},"Copy"," types) — the old binding becomes invalid.",[23,58,60],{"id":59},"stack-vs-heap","Stack vs Heap",[62,63,64,71],"ul",{},[31,65,66,67,70],{},"Stack: fast, LIFO, fixed-size values (integers, ",[53,68,69],{},"bool",", fixed arrays, pointers).",[31,72,73,74,77,78,77,81,84],{},"Heap: dynamic, slower, runtime-allocated (",[53,75,76],{},"Box",", ",[53,79,80],{},"Vec",[53,82,83],{},"String","). Ownership primarily concerns heap data.",[86,87,93],"pre",{"className":88,"code":90,"language":91,"meta":92},[89],"language-rust","let s1 = String::from(\"hi\");   \u002F\u002F heap allocation\nlet s2 = s1;                    \u002F\u002F MOVE — s1 is now invalid\n\u002F\u002F println!(\"{s1}\");            \u002F\u002F ERROR: borrow of moved value\n","rust","",[53,94,90],{"__ignoreMap":92},[14,96,97,99,100,103,104,107],{},[53,98,83],{}," is ",[53,101,102],{},"{ ptr, len, capacity }"," (stack) pointing to heap bytes. A move copies the stack header and ",[18,105,106],{},"invalidates the old binding"," so you can't have two owners trying to free the same heap memory.",[23,109,111,112,114],{"id":110},"the-copy-trait","The ",[53,113,55],{}," Trait",[14,116,117,118,120],{},"Types whose bits can be trivially copied without invalidating the source are ",[53,119,55],{},":",[62,122,123,126,132,141],{},[31,124,125],{},"All integer\u002Ffloat\u002Fbool\u002Fchar types.",[31,127,128,129,131],{},"Tuples\u002Farrays of ",[53,130,55],{}," types.",[31,133,134,137,138,140],{},[53,135,136],{},"&T"," (shared references are ",[53,139,55],{},").",[31,142,143,144,147],{},"Function pointers ",[53,145,146],{},"fn(...)",".",[14,149,150,151,153,154,77,156,77,158,77,160,163],{},"Non-",[53,152,55],{}," types (heap-ish): ",[53,155,83],{},[53,157,80],{},[53,159,76],{},[53,161,162],{},"HashMap",", any type with a destructor or that owns a resource.",[86,165,168],{"className":166,"code":167,"language":91,"meta":92},[89],"let a = 5;\nlet b = a;            \u002F\u002F i32 is Copy — a is still valid\nprintln!(\"{a} {b}\");  \u002F\u002F fine\n",[53,169,167],{"__ignoreMap":92},[23,171,173],{"id":172},"move-semantics-in-functions","Move Semantics in Functions",[86,175,178],{"className":176,"code":177,"language":91,"meta":92},[89],"fn take(s: String) { println!(\"{s}\"); }\n\nlet s = String::from(\"hi\");\ntake(s);\n\u002F\u002F s is now invalid — moved into the function\n",[53,179,177],{"__ignoreMap":92},[14,181,182,183,120],{},"To keep ownership, pass by reference or ",[53,184,185],{},"clone()",[86,187,190],{"className":188,"code":189,"language":91,"meta":92},[89],"take(s.clone());      \u002F\u002F s still owned here\ntake(&s);             \u002F\u002F pass reference (covered in References chapter)\n",[53,191,189],{"__ignoreMap":92},[23,193,195],{"id":194},"returning-ownership","Returning Ownership",[86,197,200],{"className":198,"code":199,"language":91,"meta":92},[89],"fn make() -> String { String::from(\"hi\") }\nlet s = make();       \u002F\u002F ownership moves to caller\n",[53,201,199],{"__ignoreMap":92},[14,203,204],{},"Returning transfers ownership out without a copy. This is the Rust idiom for \"constructing\" data.",[23,206,208],{"id":207},"drop-order","Drop Order",[14,210,211,212,215],{},"Destructors run in ",[18,213,214],{},"reverse declaration order"," within a scope:",[86,217,220],{"className":218,"code":219,"language":91,"meta":92},[89],"{\n    let a = String::from(\"a\");\n    let b = String::from(\"b\");\n    \u002F\u002F b drops, then a drops\n}\n",[53,221,219],{"__ignoreMap":92},[14,223,224,227,228,231,232,235],{},[53,225,226],{},"Drop"," trait's ",[53,229,230],{},"drop(&mut self)"," is the destructor. You usually don't call it manually — use ",[53,233,234],{},"std::mem::drop(value)"," to drop early.",[23,237,239,241,242,244],{"id":238},"drop-and-copy-are-mutually-exclusive",[53,240,226],{}," and ",[53,243,55],{}," are Mutually Exclusive",[14,246,247,248,250,251,253,254,256,257,259],{},"A type with a custom ",[53,249,226],{}," cannot be ",[53,252,55],{}," (you can't derive both). ",[53,255,55],{}," means \"duplicate bits\"; ",[53,258,226],{}," means \"do something on cleanup\" — duplicating would risk double-cleanup.",[23,261,263],{"id":262},"partial-moves","Partial Moves",[86,265,268],{"className":266,"code":267,"language":91,"meta":92},[89],"struct Person { name: String, age: u32 }\nlet p = Person { name: \"Ada\".into(), age: 36 };\nlet n = p.name;       \u002F\u002F partial move — p.name is moved, p.age still valid\n\u002F\u002F println!(\"{}\", p); \u002F\u002F ERROR: p partially moved\nprintln!(\"{}\", p.age); \u002F\u002F OK — only name was moved\n",[53,269,267],{"__ignoreMap":92},[14,271,272],{},"You can still access non-moved fields after a partial move.",[23,274,276],{"id":275},"move-footguns","Move Footguns",[62,278,279,296,311,324],{},[31,280,281,284,285,288,289,292,293,295],{},[18,282,283],{},"Closure captures",": ",[53,286,287],{},"|| use_s(s)"," moves ",[53,290,291],{},"s"," into the closure if ",[53,294,291],{}," is consumed inside.",[31,297,298,310],{},[18,299,300,302,303,305,306,309],{},[53,301,80],{},"\u002F",[53,304,83],{}," in ",[53,307,308],{},"match"," arms",": moving a value out in one arm invalidates it in others; the compiler ensures all paths move or none do.",[31,312,313,316,317,320,321,323],{},[18,314,315],{},"Field reorder \u002F re-init",": after a partial move, you can reassign the moved field (",[53,318,319],{},"p.name = \"Bob\".into();",") to make ",[53,322,14],{}," whole again.",[31,325,326,284,332,335,336,338],{},[18,327,328,331],{},[53,329,330],{},"mut"," binding of a moved value",[53,333,334],{},"let mut s = String::new(); let t = s; s = String::from(\"x\");"," — re-binding is fine; ",[53,337,291],{}," was invalid between the move and reassignment.",[23,340,342,345],{"id":341},"drop-order-in-structs",[53,343,344],{},"drop"," Order in Structs",[14,347,348,349,352],{},"Struct fields drop in ",[18,350,351],{},"declaration order"," (NOT reverse), per RFC 1857. This is a common surprise:",[86,354,357],{"className":355,"code":356,"language":91,"meta":92},[89],"struct A { \u002F* ... *\u002F }\nimpl Drop for A { fn drop(&mut self) { println!(\"A dropped\"); } }\n\nstruct Pair { first: A, second: A }\n\u002F\u002F when a Pair is dropped: first drops, then second\n",[53,358,356],{"__ignoreMap":92},[14,360,361],{},"Tuple fields drop in order 0, 1, 2, ...",[23,363,365,241,368],{"id":364},"manuallydrop-and-maybeuninit",[53,366,367],{},"ManuallyDrop",[53,369,370],{},"MaybeUninit",[14,372,373,374,377,378,381],{},"For unsafe manual memory management, use ",[53,375,376],{},"std::mem::ManuallyDrop"," to prevent auto-drop, or ",[53,379,380],{},"std::mem::MaybeUninit"," for uninitialized memory. These are advanced; covered in the Unsafe chapter.",[23,383,385],{"id":384},"why-ownership-is-unique","Why Ownership Is Unique",[14,387,388],{},"Languages choose between:",[62,390,391,397,403],{},[31,392,393,396],{},[18,394,395],{},"GC"," (Java, Go, Python): runtime cost, pause times.",[31,398,399,402],{},[18,400,401],{},"Manual management"," (C, C++): use-after-free, double-free, leaks.",[31,404,405,408],{},[18,406,407],{},"Ownership"," (Rust): compile-time rules, zero runtime cost, but you learn the borrow checker.",[23,410,412,413],{"id":411},"common-error-cannot-move-out-of","Common Error: ",[53,414,415],{},"cannot move out of ...",[86,417,420],{"className":418,"code":419,"language":91,"meta":92},[89],"let v = vec![String::from(\"a\"), String::from(\"b\")];\nlet first = v[0];   \u002F\u002F ERROR: cannot move out of index of Vec\n",[53,421,419],{"__ignoreMap":92},[14,423,424,425,428,429,431,432,435,436,435,439,147],{},"Indexing returns a reference (",[53,426,427],{},"&String","); moving out would leave the ",[53,430,80],{}," in an invalid state. Use ",[53,433,434],{},"v.into_iter().next()"," or ",[53,437,438],{},"mem::take(&mut v[0])",[53,440,441],{},"v.remove(0)",[23,443,445,241,448],{"id":444},"memtake-and-memreplace",[53,446,447],{},"mem::take",[53,449,450],{},"mem::replace",[86,452,455],{"className":453,"code":454,"language":91,"meta":92},[89],"use std::mem;\nlet mut s = String::from(\"hi\");\nlet taken = mem::take(&mut s);  \u002F\u002F s becomes default (empty String), taken gets \"hi\"\nlet prev = mem::replace(&mut s, \"bye\".into());  \u002F\u002F s = \"bye\", prev = \"\"\n",[53,456,454],{"__ignoreMap":92},[14,458,459],{},"These let you extract values from behind a mutable reference without invalidating the container.",[23,461,463],{"id":462},"summary","Summary",[62,465,466,469,477,484],{},[31,467,468],{},"Each value has one owner; scope-end drops it.",[31,470,150,471,473,474,476],{},[53,472,55],{}," types move on assignment\u002Fpass; ",[53,475,55],{}," types duplicate.",[31,478,479,481,482,147],{},[53,480,226],{}," is a destructor; can't be combined with ",[53,483,55],{},[31,485,486,487,77,489,491],{},"Partial moves, ",[53,488,447],{},[53,490,450],{}," let you surgically move things around.",[14,493,494,495,499],{},"Next: References and Borrowing — ",[496,497,498],"em",{},"using"," a value without owning it.",{"title":92,"searchDepth":501,"depth":501,"links":502},2,[503,504,505,507,508,509,510,512,513,514,516,518,519,521,523],{"id":25,"depth":501,"text":26},{"id":59,"depth":501,"text":60},{"id":110,"depth":501,"text":506},"The Copy Trait",{"id":172,"depth":501,"text":173},{"id":194,"depth":501,"text":195},{"id":207,"depth":501,"text":208},{"id":238,"depth":501,"text":511},"Drop and Copy are Mutually Exclusive",{"id":262,"depth":501,"text":263},{"id":275,"depth":501,"text":276},{"id":341,"depth":501,"text":515},"drop Order in Structs",{"id":364,"depth":501,"text":517},"ManuallyDrop and MaybeUninit",{"id":384,"depth":501,"text":385},{"id":411,"depth":501,"text":520},"Common Error: cannot move out of ...",{"id":444,"depth":501,"text":522},"mem::take and mem::replace",{"id":462,"depth":501,"text":463},"Ownership is the defining feature of Rust. Every other memory-safety guarantee flows from these rules.","md",{},true,"\u002Frust\u002F07-ownership",{"title":5,"description":524},"rust\u002F07-ownership","gl6RdZEKrYYujxEP4IDT4Uup1jke76xULSkcmWGJueM",1785934963039]