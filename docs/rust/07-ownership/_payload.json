[{"data":1,"prerenderedAt":2239},["ShallowReactive",2],{"page-\u002Frust\u002F07-ownership":3},{"id":4,"title":5,"body":6,"description":16,"extension":2233,"meta":2234,"navigation":138,"path":2235,"seo":2236,"stem":2237,"__hash__":2238},"content\u002Frust\u002F07-ownership.md","07 — Ownership",{"type":7,"value":8,"toc":2220},"minimark",[9,13,17,43,48,210,231,249,387,397,482,489,493,669,678,799,806,810,913,931,935,943,1119,1128,1240,1244,1393,1397,1582,1593,1597,1662,1666,1751,1755,1758,1916,1994,1998,2001,2165,2193,2196,2213,2216],[10,11,5],"h1",{"id":12},"_07-ownership",[14,15,16],"p",{},"Ownership is how Rust frees memory without a garbage collector. Three rules:",[18,19,20,29,36],"ol",{},[21,22,23,24,28],"li",{},"Every value has exactly ",[25,26,27],"strong",{},"one owner",".",[21,30,31,32,35],{},"When the owner goes out of scope, the value is ",[25,33,34],{},"dropped"," (freed).",[21,37,38,39,42],{},"Ownership can be ",[25,40,41],{},"moved"," to another variable or function.",[44,45,47],"h2",{"id":46},"move-vs-copy","Move vs Copy",[49,50,52],"code-wrapper",{"language":51},"rust",[53,54,58],"pre",{"className":55,"code":56,"language":51,"meta":57,"style":57},"language-rust shiki shiki-themes github-light github-dark","fn main() {\n    let a = 5;\n    let b = a;              \u002F\u002F i32 is Copy → a is copied\n    println!(\"{a} {b}\");    \u002F\u002F 5 5\n\n    let s1 = String::from(\"hi\");\n    let s2 = s1;            \u002F\u002F String is NOT Copy → ownership MOVES to s2\n    \u002F\u002F println!(\"{s1}\");    \u002F\u002F error[E0382]: borrow of moved value: `s1`\n    println!(\"{s2}\");\n}\n","",[59,60,61,78,97,114,133,140,167,183,192,204],"code",{"__ignoreMap":57},[62,63,66,70,74],"span",{"class":64,"line":65},"line",1,[62,67,69],{"class":68},"svdQ7","fn",[62,71,73],{"class":72},"sIsaT"," main",[62,75,77],{"class":76},"ssxIu","() {\n",[62,79,81,84,87,90,94],{"class":64,"line":80},2,[62,82,83],{"class":68},"    let",[62,85,86],{"class":76}," a ",[62,88,89],{"class":68},"=",[62,91,93],{"class":92},"snvgF"," 5",[62,95,96],{"class":76},";\n",[62,98,100,102,105,107,110],{"class":64,"line":99},3,[62,101,83],{"class":68},[62,103,104],{"class":76}," b ",[62,106,89],{"class":68},[62,108,109],{"class":76}," a;              ",[62,111,113],{"class":112},"sdCPZ","\u002F\u002F i32 is Copy → a is copied\n",[62,115,117,120,123,127,130],{"class":64,"line":116},4,[62,118,119],{"class":72},"    println!",[62,121,122],{"class":76},"(",[62,124,126],{"class":125},"sJ6F3","\"{a} {b}\"",[62,128,129],{"class":76},");    ",[62,131,132],{"class":112},"\u002F\u002F 5 5\n",[62,134,136],{"class":64,"line":135},5,[62,137,139],{"emptyLinePlaceholder":138},true,"\n",[62,141,143,145,148,150,153,156,159,161,164],{"class":64,"line":142},6,[62,144,83],{"class":68},[62,146,147],{"class":76}," s1 ",[62,149,89],{"class":68},[62,151,152],{"class":72}," String",[62,154,155],{"class":68},"::",[62,157,158],{"class":72},"from",[62,160,122],{"class":76},[62,162,163],{"class":125},"\"hi\"",[62,165,166],{"class":76},");\n",[62,168,170,172,175,177,180],{"class":64,"line":169},7,[62,171,83],{"class":68},[62,173,174],{"class":76}," s2 ",[62,176,89],{"class":68},[62,178,179],{"class":76}," s1;            ",[62,181,182],{"class":112},"\u002F\u002F String is NOT Copy → ownership MOVES to s2\n",[62,184,186,189],{"class":64,"line":185},8,[62,187,188],{"class":112},"    \u002F\u002F println!(\"{s1}\");",[62,190,191],{"class":112},"    \u002F\u002F error[E0382]: borrow of moved value: `s1`\n",[62,193,195,197,199,202],{"class":64,"line":194},9,[62,196,119],{"class":72},[62,198,122],{"class":76},[62,200,201],{"class":125},"\"{s2}\"",[62,203,166],{"class":76},[62,205,207],{"class":64,"line":206},10,[62,208,209],{"class":76},"}\n",[14,211,212,215,216,219,220,223,224,227,228,230],{},[25,213,214],{},"Why",": a ",[59,217,218],{},"String"," is a small header (pointer, length, capacity) pointing at heap memory. If both ",[59,221,222],{},"s1"," and ",[59,225,226],{},"s2"," owned it, both would free it at the end — a double free. Moving makes ",[59,229,222],{}," unusable instead.",[14,232,233,236,237,240,241,244,245,248],{},[25,234,235],{},"Copy types",": integers, floats, ",[59,238,239],{},"bool",", ",[59,242,243],{},"char",", shared references ",[59,246,247],{},"&T",", and tuples\u002Farrays made only of Copy types.",[49,250,251],{"language":51},[53,252,254],{"className":55,"code":253,"language":51,"meta":57,"style":57},"fn main() {\n    let t = (1, 2.0, 'c');\n    let u = t;                     \u002F\u002F all parts are Copy → the tuple is Copy\n    println!(\"{t:?} {u:?}\");\n\n    let s = String::from(\"hi\");\n    let r = &s;\n    let r2 = r;                    \u002F\u002F &String is Copy — copying a reference, not the String\n    println!(\"{r} {r2}\");\n}\n",[59,255,256,264,291,306,317,321,342,357,372,383],{"__ignoreMap":57},[62,257,258,260,262],{"class":64,"line":65},[62,259,69],{"class":68},[62,261,73],{"class":72},[62,263,77],{"class":76},[62,265,266,268,271,273,276,279,281,284,286,289],{"class":64,"line":80},[62,267,83],{"class":68},[62,269,270],{"class":76}," t ",[62,272,89],{"class":68},[62,274,275],{"class":76}," (",[62,277,278],{"class":92},"1",[62,280,240],{"class":76},[62,282,283],{"class":92},"2.0",[62,285,240],{"class":76},[62,287,288],{"class":125},"'c'",[62,290,166],{"class":76},[62,292,293,295,298,300,303],{"class":64,"line":99},[62,294,83],{"class":68},[62,296,297],{"class":76}," u ",[62,299,89],{"class":68},[62,301,302],{"class":76}," t;                     ",[62,304,305],{"class":112},"\u002F\u002F all parts are Copy → the tuple is Copy\n",[62,307,308,310,312,315],{"class":64,"line":116},[62,309,119],{"class":72},[62,311,122],{"class":76},[62,313,314],{"class":125},"\"{t:?} {u:?}\"",[62,316,166],{"class":76},[62,318,319],{"class":64,"line":135},[62,320,139],{"emptyLinePlaceholder":138},[62,322,323,325,328,330,332,334,336,338,340],{"class":64,"line":142},[62,324,83],{"class":68},[62,326,327],{"class":76}," s ",[62