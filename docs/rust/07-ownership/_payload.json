",[53,220,55],{}," types (heap-ish): ",[53,223,83],{},[53,225,80],{},[53,227,76],{},[53,229,230],{},"HashMap",", any type with a destructor or that owns a resource.",[86,233,234],{"language":88},[91,235,237],{"className":93,"code":236,"language":88,"meta":95,"style":95},"let a = 5;\nlet b = a;            \u002F\u002F i32 is Copy — a is still valid\nprintln!(\"{a} {b}\");  \u002F\u002F fine\n",[53,238,239,255,270],{"__ignoreMap":95},[99,240,241,243,246,248,252],{"class":101,"line":102},[99,242,106],{"class":105},[99,244,245],{"class":109}," a ",[99,247,113],{"class":105},[99,249,251],{"class":250},"snvgF"," 5",[99,253,254],{"class":109},";\n",[99,256,257,259,262,264,267],{"class":101,"line":140},[99,258,106],{"class":105},[99,260,261],{"class":109}," b ",[99,263,113],{"class":105},[99,265,266],{"class":109}," a;            ",[99,268,269],{"class":136},"\u002F\u002F i32 is Copy — a is still valid\n",[99,271,272,275,277,280,283],{"class":101,"line":156},[99,273,274],{"class":116},"println!",[99,276,126],{"class":109},[99,278,279],{"class":129},"\"{a} {b}\"",[99,281,282],{"class":109},");  ",[99,284,285],{"class":136},"\u002F\u002F fine\n",[23,287,289],{"id":288},"move-semantics-in-functions","Move Semantics in Functions",[86,291,292],{"language":88},[91,293,295],{"className":93,"code":294,"language":88,"meta":95,"style":95},"fn take(s: String) { println!(\"{s}\"); }\n\nlet s = String::from(\"hi\");\ntake(s);\n\u002F\u002F s is now invalid — moved into the function\n",[53,296,297,325,331,353,362],{"__ignoreMap":95},[99,298,299,302,305,308,310,312,315,317,319,322],{"class":101,"line":102},[99,300,301],{"class":105},"fn",[99,303,304],{"class":116}," take",[99,306,307],{"class":109},"(s",[99,309,188],{"class":105},[99,311,117],{"class":116},[99,313,314],{"class":109},") { ",[99,316,274],{"class":116},[99,318,126],{"class":109},[99,320,321],{"class":129},"\"{s}\"",[99,323,324],{"class":109},"); }\n",[99,326,327],{"class":101,"line":140},[99,328,330],{"emptyLinePlaceholder":