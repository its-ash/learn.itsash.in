ass":68},[62,445,411],{"class":72},[62,447,414],{"class":76},[62,449,417],{"class":68},[62,451,452],{"class":92}," 1",[62,454,455],{"class":76}," };\n",[62,457,458,460,462,464,467],{"class":64,"line":135},[62,459,83],{"class":68},[62,461,104],{"class":76},[62,463,89],{"class":68},[62,465,466],{"class":76}," a;                  ",[62,468,469],{"class":112},"\u002F\u002F moved\n",[62,471,472,475],{"class":64,"line":142},[62,473,474],{"class":112},"    \u002F\u002F println!(\"{}\", a.x);",[62,476,477],{"class":112},"     \u002F\u002F error[E0382]: borrow of moved value: `a`\n",[62,479,480],{"class":64,"line":169},[62,481,209],{"class":76},[14,483,484,485,488],{},"Add ",[59,486,487],{},"#[derive(Clone, Copy)]"," to opt in (only possible when all fields are Copy).",[44,490,492],{"id":491},"moving-into-functions","Moving Into Functions",[49,494,495],{"language":51},[53,496,498],{"className":55,"code":497,"language":51,"meta":57,"style":57},"fn take(s: String) -> usize {\n    s.len()\n}                               \u002F\u002F s is dropped here\n\nfn take_and_give_back(s: String) -> String {\n    s                           \u002F\u002F ownership returned to the caller\n}\n\nfn main() {\n    let s = String::from(\"hello\");\n    let s = take_and_give_back(s);   \u002F\u002F moved out, then back in\n    println!(\"{}\", take(s));         \u002F\u002F 5\n    \u002F\u002F println!(\"{s}\");              \u002F\u002F error — moved into take()\n}\n",[59,499,500,526,539,547,551,572,580,584,588,596,617,634,655,664],{"__ignoreMap":57},[62,501,502,504,507,510,512,514,517,520,523],{"class":64,"line":65},[62,503,69],{"class":68},[62,505,506],{"class":72}," take",[62,508,509],{"class":76},"(s",[62,511,417],{"class":68},[62,513,152],{"class":72},[62,515,516],{"class":76},") ",[62,518,519],{"class":68},"->",[62,521,522],{"class":72}," usize",[62,524,525],{"class":76}," {\n",[62,527,528,531,533,536],{"class":64,"line":80},[62,529,530],{"class":76},"    s",[62,532,28],{"class":68},[62,5