pes.",[32,336,338],{"id":337},"common-lints","Common Lints",[37,340,341,361,372,380,388],{},[40,342,343,45,346,45,349,45,352,45,355,45,358],{},[18,344,345],{},"unused",[18,347,348],{},"dead_code",[18,350,351],{},"unused_variables",[18,353,354],{},"unused_imports",[18,356,357],{},"unused_mut",[18,359,360],{},"unused_assignments",[40,362,363,45,366,45,369],{},[18,364,365],{},"non_snake_case",[18,367,368],{},"non_camel_case_types",[18,370,371],{},"non_upper_case_globals",[40,373,374,45,377],{},[18,375,376],{},"missing_docs",[18,378,379],{},"missing_debug_implementations",[40,381,382,45,385],{},[18,383,384],{},"unsafe_code",[18,386,387],{},"unused_unsafe",[40,389,390,45,393,45,396,399],{},[18,391,392],{},"clippy::all",[18,394,395],{},"clippy::pedantic",[18,397,398],{},"clippy::nursery"," (Clippy lint groups)",[32,401,403],{"id":402},"clippy","Clippy",[104,405,408],{"className":406,"code":407,"language":109,"meta":110},[107],"#![warn(clippy::all, clippy::pedantic)]\n#![allow(clippy::module_inception)]\n",[18,409,407],{"__ignoreMap":110},[14,411,412,413,416],{},"Configure in ",[18,414,415],{},"Cargo.toml"," or source.",[27,418,420],{"id":419},"non_exhaustive",[18,421,422],{},"#[non_exhaustive]",[104,424,427],{"className":425,"code":426,"language":109,"meta":110},[107],"#[non_exhaustive]\npub enum Event { Login, Logout }\n\n#[non_exhaustive]\npub struct Config { pub host: String }\n",[18,428,426],{"__ignoreMap":110},[37,430,431,442],{},[40,432,433,434,437,438,441],{},"External crates must include a ",[18,435,436],{},"_ => ..."," arm (enum) or use ",[18,439,440],{},"..Default::default()","\u002Fconstructor (struct).",[40,443,444],{},"Allows adding variants\u002Ffields in non-breaking minor releases.",[27,446,448],{"id":447},"must_use",[18,449,450],{},"#[must_use]",[104,452,455],{"className":453,"code":454,"language":109,"meta":110},[107],"#[must_use = \"the result indicates success\"]\npub fn try_connect() -> bool { \u002F* ... *\u002F }\n",[18,456,454],{"__ignoreMap":110},[14,458,459],{},"Warns if the return value is ignored. Applied to Result, Option by default.",[27,461,463],{"id":462},"deprecated",[18,464,465],{},"#[deprecated]",[104,467,470],{"className":468,"code":469,"language":109,"meta":110},[107],"#[deprecated(since = \"1.2\", note = \"use new_fn instead\")]\npub fn old_fn() {}\n\n#[deprecated(since = \"1.2\", replacement = \"new_fn\")]\npub fn old_fn2() {}\n",[18,471,469],{"__ignoreMap":110},[14,473,474],{},"Emits a warning when used.",[27,476,478,481],{"id":477},"doc-attributes",[18,479,480],{},"#[doc]"," Attributes",[104,483,486],{"className":484,"code":485,"language":109,"meta":110},[107],"\u002F\u002F\u002F Docs.\n#[doc = \"Inline docs string\"]\nfn f() {}\n\n#[doc(hidden)]        \u002F\u002F hide from docs\npub mod internal;\n\n#[doc(alias = \"other_name\")]   \u002F\u002F search alias\npub fn f2() {}\n\n#![doc(html_root_url = \"https:\u002F\u002Fdocs.rs\u002Fmy_crate\u002F1.0\")]\n",[18,487,485],{"__ignoreMap":110},[27,489,491],{"id":490},"inner-vs-outer-attributes","Inner vs Outer Attributes",[104,493,496],{"className":494,"code":495,"language":109,"meta":110},[107],"#![allow(dead_code)]   \u002F\u002F inner — applies to crate\u002Fmodule\n\n#[allow(dead_code)]    \u002F\u002F outer — applies to following item\nfn foo() {}\n\nmod m {\n    #![allow(dead_code)]   \u002F\u002F inner — applies to module m\n    fn bar() {}\n}\n",[18,497,495],{"__ignoreMap":110},[14,499,500,501,505],{},"Inner attributes go ",[502,503,504],"em",{},"inside"," the item's braces; outer attributes go before it.",[27,507,509,512],{"id":508},"path-for-module-files",[18,510,511],{},"#[path]"," for Module Files",[104,514,517],{"className":515,"code":516,"language":109,"meta":110},[107],"#[path = \"other\u002Fpath.rs\"]\nmod my_mod;\n",[18,518,516],{"__ignoreMap":110},[14,520,521],{},"Overrides the default file lookup.",[27,523,525],{"id":524},"link",[18,526,527],{},"#[link]",[104,529,532],{"className":530,"code":531,"language":109,"meta":110},[107],"#[link(name = \"crypto\", kind = \"static\")]\nextern \"C\" { \u002F* ... *\u002F }\n",[18,533,531],{"__ignoreMap":110},[14,535,536,539,540,45,543,45,546,549,550,139],{},[18,537,538],{},"kind",": ",[18,541,542],{},"static",[18,544,545],{},"dylib",[18,547,548],{},"framework"," (macOS). Default is ",[18,551,545],{},[27,553,555,45,558],{"id":554},"link_section-used",[18,556,557],{},"#[link_section]",[18,559,560],{},"#[used]",[104,562,565],{"className":563,"code":564,"language":109,"meta":110},[107],"#[link_section = \".custom\"]\n#[used]\nstatic DATA: [u8; 4] = [0, 1, 2, 3];\n",[18,566,564],{"__ignoreMap":110},[14,568,569,571,572,574],{},[18,570,560],{}," prevents the compiler from optimizing away the symbol. ",[18,573,557],{}," places it in a custom section (advanced\u002Fembedded).",[27,576,578],{"id":577},"target_feature",[18,579,580],{},"#[target_feature]",[104,582,585],{"className":583,"code":584,"language":109,"meta":110},[107],"#[target_feature(enable = \"avx2\")]\nunsafe fn avx2_func() {}\n",[18,586,584],{"__ignoreMap":110},[14,588,589,590,593],{},"Enables CPU features for a specific function. Requires ",[18,591,592],{},"unsafe"," (calling on a CPU without the feature is UB).",[104,595,598],{"className":596,"code":597,"language":109,"meta":110},[107],"#[target_feature(enable = \"avx2\")]\n#[cfg(target_arch = \"x86_64\")]\nunsafe fn fast() {}\n\nif is_x86_feature_detected!(\"avx2\") {\n    unsafe { fast(); }\n}\n",[18,599,597],{"__ignoreMap":110},[27,601,603,45,605],{"id":602},"cold-inline",[18,604,91],{},[18,606,79],{},[104,608,611],{"className":609,"code":610,"language":109,"meta":110},[107],"#[cold]\nfn error_path() {}     \u002F\u002F hint: rare path\n",[18,612,610],{"__ignoreMap":110},[27,614,616],{"id":615},"track_caller",[18,617,97],{},[104,619,622],{"className":620,"code":621,"language":109,"meta":110},[107],"#[track_caller]\nfn caller() -> &'static Location {\n    Location::caller()\n}\n",[18,623,621],{"__ignoreMap":110},[14,625,626],{},"Captures the source location of the call site; useful for panic messages and assertion helpers.",[27,628,630],{"id":629},"automatically_derived",[18,631,632],{},"#[automatically_derived]",[14,634,635,636,638],{},"Applied by ",[18,637,254],{}," to prevent lints from firing on generated code.",[27,640,642,645],{"id":641},"repr-layout",[18,643,644],{},"#[repr(...)]"," (Layout)",[104,647,650],{"className":648,"code":649,"language":109,"meta":110},[107],"#[repr(C)]              \u002F\u002F C-compatible layout\n#[repr(transparent)]    \u002F\u002F same layout as a single field\n#[repr(packed)]         \u002F\u002F no padding\n#[repr(packed(1))]      \u002F\u002F explicit alignment\n#[repr(align(16))]      \u002F\u002F force alignment\n#[repr(C, u8)]           \u002F\u002F C layout + explicit enum discriminant width\n",[18,651,649],{"__ignoreMap":110},[27,653,655],{"id":654},"panic_handler",[18,656,657],{},"#[panic_handler]",[14,659,660,661,664],{},"In ",[18,662,663],{},"no_std"," environments:",[104,666,669],{"className":667,"code":668,"language":109,"meta":110},[107],"#[panic_handler]\nfn panic(_: &PanicInfo) -> ! { loop {} }\n",[18,670,668],{"__ignoreMap":110},[14,672,673],{},"Defines the panic behavior for a custom target.",[27,675,677],{"id":676},"global_allocator",[18,678,679],{},"#[global_allocator]",[104,681,684],{"className":682,"code":683,"language":109,"meta":110},[107],"use std::alloc::{GlobalAlloc, Layout};\n\nstruct MyAlloc;\nunsafe impl GlobalAlloc for MyAlloc {\n    unsafe fn alloc(&self, layout: Layout) -> *mut u8 { \u002F* ... *\u002F }\n    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) { \u002F* ... *\u002F }\n}\n\n#[global_allocator]\nstatic A: MyAlloc = MyAlloc;\n",[18,685,683],{"__ignoreMap":110},[14,687,688,689,298],{},"Replace Rust's default allocator (e.g., for ",[18,690,691],{},"jemalloc",[27,693,695,698,699],{"id":694},"no_std-and-no_std",[18,696,697],{},"#[no_std]"," and ",[18,700,701],{},"#![no_std]",[104,703,706],{"className":704,"code":705,"language":109,"meta":110},[107],"#![no_std]\n",[18,707,705],{"__ignoreMap":110},[14,709,710,711,714,715,718,719,722],{},"Disables ",[18,712,713],{},"std",", only ",[18,716,717],{},"core"," (+ optional ",[18,720,721],{},"alloc",") available. For embedded\u002Fwasm\u002Fkernels.",[27,724,726],{"id":725},"edition-related-attributes","Edition-Related Attributes",[37,728,729,735],{},[40,730,731,734],{},[18,732,733],{},"#![feature(...)]"," (nightly only)",[40,736,737,740],{},[18,738,739],{},"#![allow(...)]"," for transition warnings between editions.",[27,742,744],{"id":743},"feature-attributes","Feature Attributes",[104,746,749],{"className":747,"code":748,"language":109,"meta":110},[107],"#![feature(async_fn_traits)]   \u002F\u002F nightly\n",[18,750,748],{"__ignoreMap":110},[14,752,753,754,139],{},"Unstable features require nightly + explicit ",[18,755,756],{},"#![feature]",[27,758,760],{"id":759},"common-pitfalls","Common Pitfalls",[37,762,763,778,790,805,812,820,835,846],{},[40,764,765,539,769,771,772,45,775,777],{},[766,767,768],"strong",{},"Inner vs outer",[18,770,24],{}," (inner) inside braces\u002F",[18,773,774],{},"mod",[18,776,20],{}," (outer) before items.",[40,779,780,785,786,789],{},[766,781,782,784],{},[18,783,210],{}," doesn't type-check dead branches",": actually it does — both branches are type-checked. Use ",[18,787,788],{},"cfg_if!"," macro or modular code to fully isolate.",[40,791,792,798,799,241,801,804],{},[766,793,794,797],{},[18,795,796],{},"#[cfg_attr]"," placement",": same as ",[18,800,210],{},[18,802,803],{},"#[derive]"," placement.",[40,806,807,811],{},[766,808,809],{},[18,810,422],{}," can't be applied to local types (only exported across crates).",[40,813,814,819],{},[766,815,816,818],{},[18,817,450],{}," on a type"," warns when the value is dropped unused.",[40,821,822,539,828,831,832,834],{},[766,823,824,827],{},[18,825,826],{},"#[allow]"," ignores lints in nested scopes",[18,829,830],{},"#[deny]"," in an inner scope overrides ",[18,833,826],{}," from the outer.",[40,836,837,842,843,845],{},[766,838,839],{},[18,840,841],{},"#[forbid]"," is sticky: an inner ",[18,844,826],{}," triggers a \"forbid overridden by allow\" error.",[40,847,848,851,852,855],{},[766,849,850],{},"Attribute parsing",": some attributes take ",[18,853,854],{},"key = \"value\"",", others take bare tokens; check the docs.",[27,857,859,228],{"id":858},"cfg_if-macro",[18,860,788],{},[104,862,865],{"className":863,"code":864,"language":109,"meta":110},[107],"cfg_if::cfg_if! {\n    if #[cfg(unix)] {\n        fn posix_api() {}\n    } else if #[cfg(windows)] {\n        fn win_api() {}\n    } else {\n        fn other_api() {}\n    }\n}\n",[18,866,864],{"__ignoreMap":110},[14,868,869,870,872],{},"Cleaner than stacked ",[18,871,210],{}," attributes.",[27,874,876],{"id":875},"summary","Summary",[14,878,879,881,882,884,885,241,887,241,889,891,892,894,895,241,897,899,900,903,904,241,906,908],{},[18,880,210],{}," controls what compiles; ",[18,883,803],{}," auto-implements traits; ",[18,886,826],{},[18,888,830],{},[18,890,841],{}," tune lints; ",[18,893,422],{}," future-proofs APIs; ",[18,896,450],{},[18,898,465],{}," drive correctness; ",[18,901,902],{},"#[repr(C)]"," controls layout; ",[18,905,679],{},[18,907,657],{}," customize the runtime.",[14,910,911],{},"Next: Cargo features and release engineering.",{"title":110,"searchDepth":913,"depth":913,"links":914},2,[915,926,928,929,933,934,935,936,938,939,941,942,944,945,947,948,949,951,952,953,955,956,957,958,960],{"id":29,"depth":913,"text":30,"children":916},[917,919,920,921,923,924],{"id":34,"depth":918,"text":35},3,{"id":71,"depth":918,"text":72},{"id":101,"depth":918,"text":102},{"id":115,"depth":918,"text":922},"cfg Predicates",{"id":186,"depth":918,"text":186},{"id":207,"depth":918,"text":925},"#[cfg] on Modules",{"id":223,"depth":913,"text":927},"Compile-Time cfg! Macro",{"id":251,"depth":913,"text":254},{"id":301,"depth":913,"text":302,"children":930},[931,932],{"id":337,"depth":918,"text