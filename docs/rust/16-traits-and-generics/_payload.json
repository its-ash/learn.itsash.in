ic",[41,2307,173],{"class":47},[41,2309,2282],{"class":51},[41,2311,465],{"class":47},[41,2313,2314],{"class":51},"Sealed",[41,2316,215],{"class":55},[41,2318,890],{"class":138},[41,2320,178],{"class":55},[14,2322,2323,2324,2326,2327,2330],{},"Downstream types can't implement ",[38,2325,2314],{},", so they can't implement ",[38,2328,2329],{},"Public",". Used by std and many crates for forward compatibility.",[23,2332,2334],{"id":2333},"edge-cases-pitfalls","Edge Cases & Pitfalls",[239,2336,2337,2347,2360,2370,2376,2391,2403,2411,2419,2425],{},[242,2338,2339,2342,2343,2346],{},[18,2340,2341],{},"Orphan rule",": can't implement external trait for external type. Use the ",[18,2344,2345],{},"newtype pattern"," to wrap and implement.",[242,2348,2349,2354,2355,2357,2358,129],{},[18,2350,2351,2353],{},[38,2352,376],{}," returns break object safety",": traits returning ",[38,2356,376],{}," can't be made into ",[38,2359,356],{},[242,2361,2362,2365,2366,2369],{},[18,2363,2364],{},"Method resolution",": when multiple traits provide the same method name, you must write ",[38,2367,2368],{},"Trait::method(&self)"," or use UFCS.",[242,2371,2372,2375],{},[18,2373,2374],{},"Conflicting impls",": blanket impls can cause \"conflicting implementations\" errors; design carefully.",[242,2377,2378,2385,2386,2388,2389,129],{},[18,2379,2380,2382,2383],{},[38,2381,408],{}," vs ",[38,2384,1115],{},": ",[38,2387,1115],{}," is a marker requiring reflexivity; floats lack ",[38,2390,1115],{},[242,2392,2393,2396,2397,2400,2401,129],{},[18,2394,2395],{},"Trait objects can't have generic methods"," at runtime: ",[38,2398,2399],{},"fn dyn_call\u003CT>(&self, x: T)"," is forbidden on ",[38,2402,356],{},[242,2404,2405,2410],{},[18,2406,2407,2409],{},[38,2408,846],{}," in argument position"," is sugar for a generic — not a way to accept trait objects.",[242,2412,2413,2418],{},[18,2414,2415,2417],{},[38,2416,395],{}," bound on a method"," excludes it from the vtable — useful for \"static-only\" methods on an object-safe trait.",[242,2420,2421,2424],{},[18,2422,2423],{},"Generic method on trait object"," is impossible — workaround is to expose concrete variants.",[242,2426,2427,2385,2430,2433],{},[18,2428,2429],{},"Lifetime bounds on traits",[38,2431,2432],{},"trait Foo\u003C'a>"," requires the impl to specify a lifetime; used when methods borrow from inputs.",[23,2435,2437],{"id":2436},"summary","Summary",[14,2439,2440,2441,2443,2444,2446,2447,124,2449,402,2451,2453,2454,2456,2457,2459],{},"Traits define behavior; generics parametrize code; ",[38,2442,846],{}," is sugar for both. Use trait bounds to require capabilities. Object safety decides whether you can use ",[38,2445,356],{},". Implement ",[38,2448,1160],{},[38,2450,415],{},[38,2452,418],{},", and ",[38,2455,1148],{}," for ergonomics. Avoid abusing ",[38,2458,1779],{},". Sealed traits give you stable APIs.",[14,2461,2462],{},"Next: Lifetimes in generics + the deeper type-system chapter.",[2464,2465,2466],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default