[{"data":1,"prerenderedAt":950},["ShallowReactive",2],{"page-\u002Frust\u002F16-traits-and-generics":3},{"id":4,"title":5,"body":6,"description":942,"extension":943,"meta":944,"navigation":945,"path":946,"seo":947,"stem":948,"__hash__":949},"content\u002Frust\u002F16-traits-and-generics.md","16 — Traits and Generics",{"type":7,"value":8,"toc":909},"minimark",[9,13,22,27,38,59,63,69,88,92,95,124,148,154,158,163,169,183,187,193,197,203,209,215,219,225,229,235,261,265,506,514,520,535,545,552,558,578,582,588,630,636,642,658,667,672,678,685,689,695,698,702,708,711,715,721,724,728,734,738,752,756,759,765,776,780,880,884,906],[10,11,5],"h1",{"id":12},"_16-traits-and-generics",[14,15,16,17,21],"p",{},"Traits are Rust's answer to interfaces\u002Ftypeclasses — they define ",[18,19,20],"strong",{},"shared behavior",". Generics parametrize code over types. Together they're the foundation of Rust's abstraction.",[23,24,26],"h2",{"id":25},"defining-and-implementing-traits","Defining and Implementing Traits",[28,29,35],"pre",{"className":30,"code":32,"language":33,"meta":34},[31],"language-rust","trait Greet {\n    fn say_hi(&self) -> String;\n    fn say_loud(&self) -> String {\n        format!(\"{}!!!\", self.say_hi())    \u002F\u002F default method body\n    }\n}\n\nstruct User { name: String }\nimpl Greet for User {\n    fn say_hi(&self) -> String { format!(\"hi {}\", self.name) }\n}\n","rust","",[36,37,32],"code",{"__ignoreMap":34},[39,40,41,45,48],"ul",{},[42,43,44],"li",{},"Default methods can be overridden.",[42,46,47],{},"Implementations are explicit (no automatic interface implementation like Java).",[42,49,50,51,54,55,58],{},"You can implement a trait for a type only if either the trait or the type is ",[18,52,53],{},"local"," to your crate (the ",[18,56,57],{},"orphan rule",") — prevents conflicting impls across crates.",[23,60,62],{"id":61},"trait-objects-vs-static-dispatch","Trait Objects vs Static Dispatch",[28,64,67],{"className":65,"code":66,"language":33,"meta":34},[31],"fn print_all\u003CT: Greet>(items: &[T]) { \u002F* monomorphized per T *\u002F }\nfn print_dyn(items: &[Box\u003Cdyn Greet>]) { \u002F* dynamic dispatch *\u002F }\n",[36,68,66],{"__ignoreMap":34},[39,70,71,78],{},[42,72,73,74,77],{},"Generics + trait bounds = ",[18,75,76],{},"static dispatch"," (inlined, zero-cost, code duplication per type).",[42,79,80,83,84,87],{},[36,81,82],{},"dyn Trait"," = ",[18,85,86],{},"dynamic dispatch"," via vtable (one copy, indirect call, slightly slower, enables heterogeneous collections).",[23,89,91],{"id":90},"trait-object-requirements-object-safety","Trait Object Requirements (Object Safety)",[14,93,94],{},"A trait is object-safe iff:",[39,96,97,104,107,118],{},[42,98,99,100,103],{},"No associated functions \u002F methods returning ",[36,101,102],{},"Self"," (by value).",[42,105,106],{},"No generics in methods.",[42,108,109,110,113,114,117],{},"All methods take ",[36,111,112],{},"self"," by reference (or have ",[36,115,116],{},"where Self: Sized",").",[42,119,120,123],{},[36,121,122],{},"Self: Sized"," super-bound disqualifies.",[14,125,126,129,130,129,133,136,137,140,141,140,144,147],{},[36,127,128],{},"Clone","\u002F",[36,131,132],{},"Iterator",[36,134,135],{},"PartialEq"," aren't object-safe. ",[36,138,139],{},"Greet",", ",[36,142,143],{},"Display",[36,145,146],{},"Debug"," are.",[28,149,152],{"className":150,"code":151,"language":33,"meta":34},[31],"let v: Vec\u003CBox\u003Cdyn Greet>> = vec![Box::new(User { name: \"a\".into() })];\n",[36,153,151],{"__ignoreMap":34},[23,155,157],{"id":156},"default-type-parameters-and-associated-types","Default Type Parameters and Associated Types",[159,160,162],"h3",{"id":161},"generics-vs-associated-types","Generics vs Associated Types",[28,164,167],{"className":165,"code":166,"language":33,"meta":34},[31],"\u002F\u002F Generic trait — caller picks T:\ntrait Container\u003CT> { fn item(&self) -> &T; }\n\n\u002F\u002F Associated type — impl picks the type:\ntrait Container { type Item; fn item(&self) -> &Self::Item; }\n",[36,168,166],{"__ignoreMap":34},[14,170,171,172,175,176,179,180,117],{},"Use associated types when each type has ",[18,173,174],{},"one"," natural inner type (e.g., ",[36,177,178],{},"Iterator::Item","). Use generics when the type can carry multiple variants (e.g., ",[36,181,182],{},"From\u003CT>",[159,184,186],{"id":185},"default-associated-type","Default Associated Type",[28,188,191],{"className":189,"code":190,"language":33,"meta":34},[31],"trait Rng { type Output = u64; fn next(&self) -> Self::Output; }\n",[36,192,190],{"__ignoreMap":34},[23,194,196],{"id":195},"trait-bounds","Trait Bounds",[28,198,201],{"className":199,"code":200,"language":33,"meta":34},[31],"fn max\u003CT: PartialOrd + Copy>(a: T, b: T) -> T { if a > b { a } else { b } }\n\nfn sum_all\u003CT>(items: &[T]) -> T\nwhere\n    T: Sum + Copy,\n{\n    items.iter().copied().sum()\n}\n",[36,202,200],{"__ignoreMap":34},[14,204,205,208],{},[36,206,207],{},"where"," clauses are more readable for long bounds and enable more expressiveness (bounds on associated types, lifetimes).",[23,210,212],{"id":211},"impl-trait",[36,213,214],{},"impl Trait",[159,216,218],{"id":217},"in-argument-position","In argument position",[28,220,223],{"className":221,"code":222,"language":33,"meta":34},[31],"fn print(it: impl Iterator\u003CItem = i32>) { \u002F* ... *\u002F }\n\u002F\u002F equivalent to:\nfn print\u003CT: Iterator\u003CItem = i32>>(it: T) { \u002F* ... *\u002F }\n",[36,224,222],{"__ignoreMap":34},[159,226,228],{"id":227},"in-return-position","In return position",[28,230,233],{"className":231,"code":232,"language":33,"meta":34},[31],"fn counter() -> impl Iterator\u003CItem = u32> {\n    (0..5).map(|x| x * 2)\n}\n",[36,234,232],{"__ignoreMap":34},[39,236,237,245,251,254],{},[42,238,239,240,244],{},"Returns ",[241,242,243],"em",{},"some"," concrete type that implements the trait — the actual type is hidden from the caller.",[42,246,247,248,117],{},"Cannot be conditional (no ",[36,249,250],{},"if cond { type A } else { type B }",[42,252,253],{},"Each return-site must use a single concrete type.",[42,255,256,257,260],{},"For returning different types, use ",[36,258,259],{},"Box\u003Cdyn Trait>"," or trait objects.",[23,262,264],{"id":263},"common-standard-traits","Common Standard Traits",[266,267,268,281],"table",{},[269,270,271],"thead",{},[272,273,274,278],"tr",{},[275,276,277],"th",{},"Trait",[275,279,280],{},"Purpose",[282,283,284,298,310,322,334,347,357,369,388,401,410,429,444,454,464,477,490],"tbody",{},[272,285,286,291],{},[287,288,289],"td",{},[36,290,143],{},[287,292,293,294,297],{},"User-facing string (",[36,295,296],{},"{}",")",[272,299,300,304],{},[287,301,302],{},[36,303,146],{},[287,305,306,307,297],{},"Developer string (",[36,308,309],{},"{:?}",[272,311,312,319],{},[287,313,314,140,316],{},[36,315,128],{},[36,317,318],{},"Copy",[287,320,321],{},"Duplication",[272,323,324,331],{},[287,325,326,140,328],{},[36,327,135],{},[36,329,330],{},"Eq",[287,332,333],{},"Equality",[272,335,336,344],{},[287,337,338,140,341],{},[36,339,340],{},"PartialOrd",[36,342,343],{},"Ord",[287,345,346],{},"Ordering",[272,348,349,354],{},[287,350,351],{},[36,352,353],{},"Hash",[287,355,356],{},"Hashing",[272,358,359,364],{},[287,360,361],{},[36,362,363],{},"Default",[287,365,366],{},[36,367,368],{},"Default::default()",[272,370,371,385],{},[287,372,373,140,376,140,379,140,382],{},[36,374,375],{},"From",[36,377,378],{},"Into",[36,380,381],{},"TryFrom",[36,383,384],{},"TryInto",[287,386,387],{},"Conversions",[272,389,390,398],{},[287,391,392,140,395],{},[36,393,394],{},"AsRef",[36,396,397],{},"AsMut",[287,399,400],{},"Cheap borrows",[272,402,403,407],{},[287,404,405],{},[36,406,132],{},[287,408,409],{},"Iteration",[272,411,412,426],{},[287,413,414,140,417,140,420,140,423],{},[36,415,416],{},"Add",[36,418,419],{},"Sub",[36,421,422],{},"Mul",[36,424,425],{},"Div",[287,427,428],{},"Operator overloading",[272,430,431,439],{},[287,432,433,140,436],{},[36,434,435],{},"Index",[36,437,438],{},"IndexMut",[287,440,441],{},[36,442,443],{},"[]",[272,445,446,451],{},[287,447,448],{},[36,449,450],{},"Drop",[287,452,453],{},"Destructor",[272,455,456,461],{},[287,457,458],{},[36,459,460],{},"Sized",[287,462,463],{},"Has a known size",[272,465,466,474],{},[287,467,468,140,471],{},[36,469,470],{},"Send",[36,472,473],{},"Sync",[287,475,476],{},"Thread safety (auto)",[272,478,479,487],{},[287,480,481,140,484],{},[36,482,483],{},"Unpin",[36,485,486],{},"Pin",[287,488,489],{},"Async\u002Fpinning",[272,491,492,503],{},[287,493,494,140,497,140,500],{},[36,495,496],{},"Fn",[36,498,499],{},"FnMut",[36,501,502],{},"FnOnce",[287,504,505],{},"Closures",[23,507,509,511,512],{"id":508},"from-and-into",[36,510,375],{}," and ",[36,513,378],{},[28,515,518],{"className":516,"code":517,"language":33,"meta":34},[31],"impl From\u003Ci32> for My { fn from(x: i32) -> Self { \u002F* ... *\u002F } }\nlet m: My = 5i32.into();\n",[36,519,517],{"__ignoreMap":34},[14,521,522,523,525,526,528,529,531,532,534],{},"Implementing ",[36,524,375],{}," automatically gives you ",[36,527,378],{},". Idiomatic: implement ",[36,530,375],{},", never ",[36,533,378],{}," directly.",[14,536,537,540,541,544],{},[36,538,539],{},"FromStr"," is the parsing version (",[36,542,543],{},"str::parse()"," uses it).",[23,546,548,511,550],{"id":547},"asref-and-asmut",[36,549,394],{},[36,551,397],{},[28,553,556],{"className":554,"code":555,"language":33,"meta":34},[31],"fn open\u003CP: AsRef\u003CPath>>(path: P) { let p = path.as_ref(); \u002F* p: &Path *\u002F }\nopen(\"file.txt\");           \u002F\u002F &str: AsRef\u003CPath>\nopen(Path::new(\"f\"));       \u002F\u002F &Path: AsRef\u003CPath>\nopen(String::from(\"f\"));    \u002F\u002F String: AsRef\u003CPath>\n",[36,557,555],{"__ignoreMap":34},[14,559,560,561,564,565,140,568,140,571,140,574,577],{},"Multi-source APIs use ",[36,562,563],{},"AsRef\u003CT>"," to accept ",[36,566,567],{},"&str",[36,569,570],{},"String",[36,572,573],{},"&Path",[36,575,576],{},"&OsStr",", etc.",[23,579,581],{"id":580},"operator-overloading","Operator Overloading",[28,583,586],{"className":584,"code":585,"language":33,"meta":34},[31],"use std::ops::Add;\nstruct Vec2 { x: f64, y: f64 }\nimpl Add for Vec2 {\n    type Output = Vec2;\n    fn add(self, rhs: Vec2) -> Vec2 { Vec2 { x: self.x + rhs.x, y: self.y + rhs.y } }\n}\nlet v = Vec2 { x: 1.0, y: 0.0 } + Vec2 { x: 0.0, y: 1.0 };\n",[36,587,585],{"__ignoreMap":34},[14,589,590,591,140,593,140,595,140,597,140,599,140,602,140,605,140,607,140,609,140,612,140,615,140,618,140,621,140,624,140,627,577],{},"You can overload ",[36,592,416],{},[36,594,419],{},[36,596,422],{},[36,598,425],{},[36,600,601],{},"Rem",[36,603,604],{},"Neg",[36,606,435],{},[36,608,438],{},[36,610,611],{},"Deref",[36,613,614],{},"DerefMut",[36,616,617],{},"BitAnd",[36,619,620],{},"BitOr",[36,622,623],{},"Shl",[36,625,626],{},"Shr",[36,628,629],{},"Fn*",[23,631,633,635],{"id":632},"deref-coercion",[36,634,611],{}," Coercion",[28,637,640],{"className":638,"code":639,"language":33,"meta":34},[31],"impl Deref for My { type Target = Inner; fn deref(&self) -> &Inner { &self.inner } }\nlet m = My { inner: Inner { x: 5 } };\nlet x = m.x;     \u002F\u002F m.x works via Deref coercion\n",[36,641,639],{"__ignoreMap":34},[14,643,644,140,647,140,650,653,654,657],{},[36,645,646],{},"String: Deref\u003CTarget = str>",[36,648,649],{},"Vec\u003CT>: Deref\u003CTarget = [T]>",[36,651,652],{},"Box\u003CT>: Deref\u003CTarget = T>",". This enables method\u002Ffield forwarding and ",[36,655,656],{},"&","-coercions.",[14,659,660,663,664,666],{},[18,661,662],{},"Don't"," abuse ",[36,665,611],{}," for inheritance — it's a memory-layout mechanism, not a modeling tool.",[23,668,670],{"id":669},"drop",[36,671,450],{},[28,673,676],{"className":674,"code":675,"language":33,"meta":34},[31],"impl Drop for File {\n    fn drop(&mut self) {\n        \u002F\u002F close file, free resources\n    }\n}\n",[36,677,675],{"__ignoreMap":34},[14,679,680,681,684],{},"Runs automatically at scope end. Don't call directly — use ",[36,682,683],{},"std::mem::drop(value)"," to drop early.",[23,686,688],{"id":687},"supertraits","Supertraits",[28,690,693],{"className":691,"code":692,"language":33,"meta":34},[31],"trait Pretty: Debug { fn pretty(&self) { \u002F* can use {:?} *\u002F } }\n",[36,694,692],{"__ignoreMap":34},[14,696,697],{},"A supertrait bound means \"any type implementing Pretty must also implement Debug\".",[23,699,701],{"id":700},"trait-composition","Trait Composition",[28,703,706],{"className":704,"code":705,"language":33,"meta":34},[31],"trait Read: io::Read + BufRead {}\nimpl\u003CT: io::Read + BufRead> Read for T {}\n",[36,707,705],{"__ignoreMap":34},[14,709,710],{},"Blanket impl gives any type with both underlying traits the composite trait.",[23,712,714],{"id":713},"blanket-implementations","Blanket Implementations",[28,716,719],{"className":717,"code":718,"language":33,"meta":34},[31],"impl\u003CT: Display> ToString for T {\n    fn to_string(&self) -> String { \u002F* ... *\u002F }\n}\n",[36,720,718],{"__ignoreMap":34},[14,722,723],{},"A blanket impl covers all matching types. Powerful but can lock out other impls (orphan-rule implications).",[23,725,727],{"id":726},"traits-with-const-generics","Traits with Const Generics",[28,729,732],{"className":730,"code":731,"language":33,"meta":34},[31],"trait Bytes\u003Cconst N: usize> { fn data(&self) -> [u8; N]; }\n",[36,733,731],{"__ignoreMap":34},[23,735,737],{"id":736},"marker-traits","Marker Traits",[14,739,740,741,140,743,140,745,140,747,140,749,751],{},"Zero-method traits that tag types: ",[36,742,460],{},[36,744,470],{},[36,746,473],{},[36,748,483],{},[36,750,318],{},". Some are auto-traits (compiler-implemented when possible).",[23,753,755],{"id":754},"sealed-traits","Sealed Traits",[14,757,758],{},"To prevent downstream impls while still exposing a stable API:",[28,760,763],{"className":761,"code":762,"language":33,"meta":34},[31],"mod private { pub trait Sealed {} }\npub trait Public: private::Sealed { \u002F* ... *\u002F }\n",[36,764,762],{"__ignoreMap":34},[14,766,767,768,771,772,775],{},"Downstream types can't implement ",[36,769,770],{},"Sealed",", so they can't implement ",[36,773,774],{},"Public",". Used by std and many crates for forward compatibility.",[23,777,779],{"id":778},"edge-cases-pitfalls","Edge Cases & Pitfalls",[39,781,782,792,806,816,822,837,849,857,865,871],{},[42,783,784,787,788,791],{},[18,785,786],{},"Orphan rule",": can't implement external trait for external type. Use the ",[18,789,790],{},"newtype pattern"," to wrap and implement.",[42,793,794,799,800,802,803,805],{},[18,795,796,798],{},[36,797,102],{}," returns break object safety",": traits returning ",[36,801,102],{}," can't be made into ",[36,804,82],{},".",[42,807,808,811,812,815],{},[18,809,810],{},"Method resolution",": when multiple traits provide the same method name, you must write ",[36,813,814],{},"Trait::method(&self)"," or use UFCS.",[42,817,818,821],{},[18,819,820],{},"Conflicting impls",": blanket impls can cause \"conflicting implementations\" errors; design carefully.",[42,823,824,831,832,834,835,805],{},[18,825,826,828,829],{},[36,827,135],{}," vs ",[36,830,330],{},": ",[36,833,330],{}," is a marker requiring reflexivity; floats lack ",[36,836,330],{},[42,838,839,842,843,846,847,805],{},[18,840,841],{},"Trait objects can't have generic methods"," at runtime: ",[36,844,845],{},"fn dyn_call\u003CT>(&self, x: T)"," is forbidden on ",[36,848,82],{},[42,850,851,856],{},[18,852,853,855],{},[36,854,214],{}," in argument position"," is sugar for a generic — not a way to accept trait objects.",[42,858,859,864],{},[18,860,861,863],{},[36,862,122],{}," bound on a method"," excludes it from the vtable — useful for \"static-only\" methods on an object-safe trait.",[42,866,867,870],{},[18,868,869],{},"Generic method on trait object"," is impossible — workaround is to expose concrete variants.",[42,872,873,831,876,879],{},[18,874,875],{},"Lifetime bounds on traits",[36,877,878],{},"trait Foo\u003C'a>"," requires the impl to specify a lifetime; used when methods borrow from inputs.",[23,881,883],{"id":882},"summary","Summary",[14,885,886,887,889,890,892,893,140,895,129,897,899,900,902,903,905],{},"Traits define behavior; generics parametrize code; ",[36,888,214],{}," is sugar for both. Use trait bounds to require capabilities. Object safety decides whether you can use ",[36,891,82],{},". Implement ",[36,894,375],{},[36,896,143],{},[36,898,146],{},", and ",[36,901,363],{}," for ergonomics. Avoid abusing ",[36,904,611],{},". Sealed traits give you stable APIs.",[14,907,908],{},"Next: Lifetimes in generics + the deeper type-system chapter.",{"title":34,"searchDepth":910,"depth":910,"links":911},2,[912,913,914,915,920,921,925,926,928,930,931,933,934,935,936,937,938,939,940,941],{"id":25,"depth":910,"text":26},{"id":61,"depth":910,"text":62},{"id":90,"depth":910,"text":91},{"id":156,"depth":910,"text":157,"children":916},[917,919],{"id":161,"depth":918,"text":162},3,{"id":185,"depth":918,"text":186},{"id":195,"depth":910,"text":196},{"id":211,"depth":910,"text":214,"children":922},[923,924],{"id":217,"depth":918,"text":218},{"id":227,"depth":918,"text":228},{"id":263,"depth":910,"text":264},{"id":508,"depth":910,"text":927},"From and Into",{"id":547,"depth":910,"text":929},"AsRef and AsMut",{"id":580,"depth":910,"text":581},{"id":632,"depth":910,"text":932},"Deref Coercion",{"id":669,"depth":910,"text":450},{"id":687,"depth":910,"text":688},{"id":700,"depth":910,"text":701},{"id":713,"depth":910,"text":714},{"id":726,"depth":910,"text":727},{"id":736,"depth":910,"text":737},{"id":754,"depth":910,"text":755},{"id":778,"depth":910,"text":779},{"id":882,"depth":910,"text":883},"Traits are Rust's answer to interfaces\u002Ftypeclasses — they define shared behavior. Generics parametrize code over types. Together they're the foundation of Rust's abstraction.","md",{},true,"\u002Frust\u002F16-traits-and-generics",{"title":5,"description":942},"rust\u002F16-traits-and-generics","UVqqF3XNgqTcN2hdSik9REMj818mAdK5myin4goBihE",1785934755597]