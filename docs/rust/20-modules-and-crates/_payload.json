30}," b }\n",[109,1334,1335],{"class":111,"line":134},[109,1336,954],{"emptyLinePlaceholder":953},[109,1338,1339],{"class":111,"line":145},[109,1340,1341],{"class":130},"#[cfg(test)]\n",[109,1343,1344,1346,1349],{"class":111,"line":159},[109,1345,123],{"class":122},[109,1347,1348],{"class":126}," tests",[109,1350,142],{"class":130},[109,1352,1353,1356,1358,1360],{"class":111,"line":171},[109,1354,1355],{"class":122},"    use",[109,1357,402],{"class":333},[109,1359,454],{"class":122},[109,1361,131],{"class":130},[109,1363,1364],{"class":111,"line":968},[109,1365,1366],{"class":130},"    #[test]\n",[109,1368,1369,1372,1375,1378,1381,1383,1386,1388,1391,1393,1396,1399,1402],{"class":111,"line":976},[109,1370,1371],{"class":122},"    fn",[109,1373,1374],{"class":126}," test_add",[109,1376,1377],{"class":130},"() { ",[109,1379,1380],{"class":126},"assert_eq!",[109,1382,652],{"class":130},[109,1384,1385],{"class":126},"add",[109,1387,652],{"class":130},[109,1389,1390],{"class":333},"1",[109,1392,337],{"class":130},[109,1394,1395],{"class":333},"2",[109,1397,1398],{"class":130},"), ",[109,1400,1401],{"class":333},"3",[109,1403,1404],{"class":130},"); }\n",[109,1406,1408],{"class":111,"line":1407},9,[109,1409,174],{"class":130},[14,1411,1412,1413,1416],{},"Integration tests live in ",[34,1414,1415],{},"tests\u002F"," as separate crate:",[97,1418,1419],{"language":195},[101,1420,1423],{"className":1421,"code":1422,"language":195,"meta":105},[199],"tests\u002F\n└── integration.rs\n",[34,1424,1422],{"__ignoreMap":105},[18,1426,1428],{"id":1427},"tips-tricks","💡 Tips & Tricks",[23,1430,1431,1445,1466,1477,1485,1499],{},[26,1432,1433,1436,1437,1440,1441,1444],{},[29,1434,1435],{},"Idiom",": expose a ",[34,1438,1439],{},"pub mod prelude { pub use ...; }"," module for crates with many commonly-used types — it gives consumers a one-line ",[34,1442,1443],{},"use my_crate::prelude::*;"," without forcing a broad glob import of your entire public API.",[26,1446,1447,1450,1451,1454,1455,1458,1459,47,1462,1465],{},[29,1448,1449],{},"Debug",": ",[34,1452,1453],{},"cargo modules generate tree"," (via ",[34,1456,1457],{},"cargo install cargo-modules",") prints your crate's actual module hierarchy as a tree — useful for spotting an accidental ",[34,1460,1461],{},"mod.rs",[34,1463,1464],{},"module.rs"," duplicate or a module nested deeper than intended.",[26,1467,1468,1470,1471,1473,1474,1476],{},[29,1469,1435],{},": use ",[34,1472,878],{}," liberally for anything shared between your own modules but not meant for external consumers — it documents intent precisely, unlike ",[34,1475,503],{}," (too open) or private (too restrictive for cross-module internal use).",[26,1478,1479,1481,1482,1484],{},[29,1480,1449],{},": \"private type in public interface\" errors point at real API design problems, not just visibility — if a public function needs to return a private type, either make the type ",[34,1483,503],{}," deliberately or restructure so the function returns a public trait\u002Fwrapper instead.",[26,1486,1487,1489,1490,1492,1493,1495,1496,1498],{},[29,1488,1435],{},": keep re-exports (",[34,1491,485],{},") in one clearly-named place (often ",[34,1494,50],{}," or a dedicated ",[34,1497,451],{}," module) rather than scattered across many files — it gives you a single file to scan when auditing exactly what your crate's public surface looks like.",[26,1500,1501,1450,1503,1506,1507,1510,1511,1513],{},[29,1502,1449],{},[34,1504,1505],{},"cargo doc --open"," is a fast way to sanity-check what's ",[84,1508,1509],{},"actually"," publicly visible from outside your crate — rustdoc only shows ",[34,1512,503],{}," items reachable from the crate root, so it's an accurate mirror of what consumers see, unlike scanning source files by eye.",[18,1515,1517],{"id":1516},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[23,1519,1520,1536,1544,1556,1564,1577,1585,1593],{},[26,1521,1522,1527,1528,1531,1532,1535],{},[29,1523,1524,1526],{},[34,1525,503],{}," doesn't propagate to ancestors",": a ",[34,1529,1530],{},"pub mod"," is public ",[84,1533,1534],{},"if its parent is also accessible",". Privacy is layered.",[26,1537,1538,1543],{},[29,1539,1540,1542],{},[34,1541,485],{}," ambiguity",": re-exporting two items with the same name into the same scope is an error.",[26,1545,1546,1450,1549,843,1552,1555],{},[29,1547,1548],{},"Module path and item name conflicts",[34,1550,1551],{},"mod foo;",[34,1553,1554],{},"use crate::foo;"," are different things.",[26,1557,1558,1563],{},[29,1559,1560],{},[34,1561,1562],{},"#[non_exhaustive]"," prevents exhaustive construction outside the crate.",[26,1565,1566,1572,1573,1576],{},[29,1567,1568,1569,1571],{},"Private items in ",[34,1570,503],{}," functions",": a public function can't have private types in its signature (e.g., ",[34,1574,1575],{},"pub fn get() -> PrivateType"," is an error — leaks private type).",[26,1578,1579,1584],{},[29,1580,1581],{},[34,1582,1583],{},"extern crate self as foo;",": lets you refer to your own crate by name (rare).",[26,1586,1587,1592],{},[29,1588,1589,1590],{},"Hidden ",[34,1591,1461],{},": still works but is discouraged; the new layout is cleaner.",[26,1594,1595,1600,1601,1603],{},[29,1596,1597,1599],{},[34,1598,485],{}," for preludes",": many crates expose ",[34,1602,1439],{}," for one-line imports.",[18,1605,1607],{"id":1606},"spot-the-bug","🧠 Spot the Bug",[14,1609,1610,1611,1614],{},"Why does this fail to compile, given that ",[34,1612,1613],{},"Config"," is clearly used successfully inside the crate?",[97,1616,1617],{"language":99},[101,1618,1620],{"className":103,"code":1619,"language":99,"meta":105,"style":105},"mod settings {\n    struct Config {\n        pub host: String,\n    }\n\n    impl Config {\n        pub fn new(host: &str) -> Self {\n            Config { host: host.to_string() }\n        }\n    }\n}\n\npub fn load_config() -> settings::Config {\n    settings::Config::new(\"localhost\")\n}\n",[34,1621,1622,1631,1641,1655,1660,1664,1673,1702,1722,1727,173