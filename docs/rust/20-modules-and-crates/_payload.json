xpose a ",[34,1175,1176],{},"pub mod prelude { pub use ...; }"," module for crates with many commonly-used types — it gives consumers a one-line ",[34,1179,1180],{},"use my_crate::prelude::*;"," without forcing a broad glob import of your entire public API.",[26,1183,1184,1187,1188,1191,1192,1195,1196,47,1199,1202],{},[29,1185,1186],{},"Debug",": ",[34,1189,1190],{},"cargo modules generate tree"," (via ",[34,1193,1194],{},"cargo install cargo-modules",") prints your crate's actual module hierarchy as a tree — useful for spotting an accidental ",[34,1197,1198],{},"mod.rs",[34,1200,1201],{},"module.rs"," duplicate or a module nested deeper than intended.",[26,1204,1205,1207,1208,1211,1212,1214],{},[29,1206,1172],{},": use ",[34,1209,1210],{},"pub(crate)"," liberally for anything shared between your own modules but not meant for external consumers — it documents intent precisely, unlike ",[34,1213,410],{}," (too open) or private (too restrictive for cross-module internal use).",[26,1216,1217,1219,1220,1222],{},[29,1218,1186],{},": \"private type in public interface\" errors point at real API design problems, not just visibility — if a public function needs to return a private type, either make the type ",[34,1221,410],{}," deliberately or restructure so the function returns a public trait\u002Fwrapper instead.",[26,1224,1225,1227,1228,1230,1231,1233,1234,1236],{},[29,1226,1172],{},": keep re-exports (",[34,1229,392],{},") in one clearly-named place (often ",[34,1232,50],{}," or a dedicated ",[34,1235,358],{}," module) rather than scattered across many files — it gives you a single file to scan when auditing exactly what your crate's public surface looks like.",[26,1238,1239,1187,1241,1244,1245,1249,1250,1252],{},[29,1240,1186],{},[34,1242,1243],{},"cargo doc --open"," is a fast way to sanity-check what's ",[1246,1247,1248],"em",{},"actually"," publicly visible from outside your crate — rustdoc only shows ",[34,1251,410],{}," items reachable from the crate root, so it's an accurate mirror of what consumers see, unlike scanning source files by eye.",[18,1254,1256],{"id":1255},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[23,1258,1259,1275,1283,1295,1303,1316,1324,1332],{},[26,1260,1261,1266,1267,1270,1271,1274],{},[29,1262,1263,1265],{},[34,1264,410],{}," doesn't propagate to ancestors",": a ",[34,1268,1269],{},"pub mod"," is public ",[1246,1272,1273],{},"if its parent is also accessible",". Privacy is layered.",[26,1276,1277,1282],{},[29,1278,1279,1281],{},[34,1280,392],{}," ambiguity",": re-exporting two items with the same name into the same scope is an error.",[26,1284,1285,1187,1288,721,1291,1294],{},[29,1286,1287],{},"Module path and item name conflicts",[34,1289,1290],{},"mod foo;",[34,1292,1293],{},"use crate::foo;"," are different things.",[26,1296,1297,1302],{},[29,1298,1299],{},[34,1300,1301],{},"#[non_exhaustive]"," prevents exhaustive construction outside the crate.",[26,1304,1305,1311,1312,1315],{},[29,1306,1307,1308,1310],{},"Private items in ",[34,1309,410],{}," functions",": a public function can't have private types in its signature (e.g., ",[34,1313,1314],{},"pub fn get() -> PrivateType"," is an error — leaks private type).",[26,1317,1318,1323],{},[29,1319,1320],{},[34,1321,1322],{},"extern crate self as foo;",": lets you refer to your own crate by name (rare).",[26,1325,1326,1331],{},[29,1327,1328,1329],{},"Hidden ",[34,1330,1198],{},": still works but is discouraged; the new layout is cleaner.",[26,1333,1334,1339,1340,1342],{},[29,1335,1336,1338],{},[34,1337,392],{}," for preludes",": many crates expose ",[34,1341,1176],{}," for one-line imports.",[18,1344,1346],{"id":1345},"spot-the-bug","🧠 Spot the Bug",[14,1348,1349,1350,1353],{},"Why does this fail to compile, given that ",[34,1351,1352],{},"Config"," is clearly used successfully inside the crate?",[72,1355,1356],{"language":74},[76,1357,1359],{"className":78,"code":1358,"language":74,"meta":80,"style":80},"mod settings {\n    struct Config {\n        pub host: String,\n    }\n\n    impl Config {\n        pub fn new(host: &str) -> Self {\n            Config { host: host.to_string() }\n        }\n    }\n}\n\npub fn load_config() -> settings::Config {\n    settings::Config::new(\"localhost\")\n}\n",[34,1360,1361,1370,1380,1394,1399,1403,1412,1441,1461,1466,1471,1476,1481,1504,1527],{"__ignoreMap":80},[84,1362,1363,1365,1368],{"class":86,"line":87},[84,1364,98],{"class":97},[84,1366,1367],{"class":101}," settings",[84,1369,117],{"class":105},[84,1371,1372,1375,1378],{"class":86,"line":94},[84,1373,1374],{"class":97},"    struct",[84,1376,1377],{"class":101}," Config",[84,1379,117],{"class":105},[84,1381,1382,1385,1388,1390,1392],{"class":86,"line":109},[84,1383,1384],{"class":97},"        pub",[84,1386,1387],{"class":105}," host",[84,1389,653],{"class":97},[84,1391,656],{"class":101},[84,1393,659],{"class":105},[84,1395,1396],{"class":86,"line":120},[84,1397,1398],{"class":105},"    }\n",[84,1400,1401],{"class":86,"line":134},[84,1402,790],{"emptyLinePlaceholder":789},[84,1404,1405,1408,1410],{"class":86,"line":146},[84,1406,1407],{"class":97},"    impl",[84,1409,1377],{"class":101},[84,1411,117],{"class":105},[84,1413,1414,1416,1418,1421,1424,1426,1429,1432,1434,1436,1439],{"class":86,"line":798},[84,1415,1384],{"class":97},[84,1417,532],{"class":97},[84,1419,1420],{"class":101}," new",[84,1422,1423],{"class":105},"(host",[84,1425,653],{"class":97},[84,1427,1428],{"class":97}," &",[84,1430,1431],{"class":101},"str",[84,1433,567],{"class":105},[84,1435,1058],{"class":97},[84,1437,1438],{"class":239}," Self",[84,1440,117],{"class":105},[84,1442,1443,1446,1449,1451,1453,1455,1458],{"class":86,"line":804},[84,1444,1445],{"class":101},"            Config",[84,1447,1448],{"class":105}," { host",[84,1450,653],{"class":97},[84,1452,1387],{"class":105},[84,1454,814],{"class":97},[84,1456,1457],{"class":101},"to_string",[84,1459,1460],{"class":105},"() }\n",[84,1462,1463],{"class":86,"line":1144},[84,1464,1465],{"class":105},"        }\n",[84,1467,1469],{"class":86,"line":1468},10,[84,1470,1398],{"class":105},[84,1472,1474],{"class":86,"line":1473},11,[84,1475,149],{"class":105},[84,1477,1479],{"class":86,"line":1478},12,[84,1480,790],{"emptyLinePlaceholder":789},[84,1482,1484,1486,1488,1491,1494,1496,1498,1500,1502],{"class":86,"line":1483},13,[84,1485,410],{"class":97},[84,1487,532],{"class":97},[84,1489,1490],{"class":101}," load_config",[84,1492,1493],{"class":105},"() ",[84,1495,1058],{"class":97},[84,1497,1367],{"class":101},[84,1499,210],{"class":97},[84,1501,1352],{"class":101},[84,1503,117],{"class":105},[84,1505,1507,1510,1512,1514,1516,1519,1521,1524],{"class":86,"line":1506},14,[84,1508,1509],{"class":101},"    settings",[84,1511,210],{"class":97},[84,1513,1352],{"class":101},[84,1515,210],{"class":97},[84,1517,1518],{"class":101},"new",[84,1520,562],{"class":105},[84,1522,1523],{"class":999},"\"localhost\"",[84,1525,1526],{"class":105},")\n",[84,1528,1530],{"class":86,"line":1529},15,[84,1531,149],{"class":105},[1533,1534,1535,1539,1545,1595,1601,1651],"details",{},[1536,1537,1538],"summary",{},"Answer",[14,1540,1541,1544],{},[34,1542,1543],{},"error[E0446]: private type \\","settings::Config` in public interface`.",[14,1546,1547,1548,1550,1551,1553,1554,1557,1558,1561,1562,1565,1566,1569,1570,1572,1573,1575,1576,1578,1579,1582,1583,1586,1587,1590,1591,1594],{},"The ",[34,1549,1352],{}," struct itself is declared without ",[34,1552,410],{}," (",[34,1555,1556],{},"struct Config",", not ",[34,1559,1560],{},"pub struct Config",") — it's private to the ",[34,1563,1564],{},"settings"," module, even though its ",[34,1567,1568],{},"host"," field and ",[34,1571,1518],{}," associated function are marked ",[34,1574,410],{},". Marking members ",[34,1577,410],{}," doesn't make the ",[1246,1580,1581],{},"containing type"," public; visibility is checked at every level independently. The function ",[34,1584,1585],{},"load_config"," is declared ",[34,1588,1589],{},"pub fn load_config() -> settings::Config",", which means any external crate calling it would receive a value of type ",[34,1592,1593],{},"settings::Config"," — but that type is private, so external code couldn't even name it, store it in a variable with an explicit type, or reference it in their own function signatures. Rust refuses to compile this contradiction: a public function cannot expose a private type in its signature, because doing so would create a type that callers can receive but can't meaningfully use or refer to.",[14,1596,1597,1598,1600],{},"The fix is to make the struct itself ",[34,1599,410],{}," (in addition to whichever fields\u002Fmethods should be public):",[72,1602,1603],{"language":74},[76,1604,1606],{"className":78,"code":1605,"language":74,"meta":80,"style":80},"mod settings {\n    pub struct Config {\n        pub host: String,\n    }\n    \u002F\u002F ...\n}\n",[34,1607,1608,1616,1626,1638,1642,1647],{"__ignoreMap":80},[84,1609,1610,1612,1614],{"class":86,"line":87},[84,1611,98],{"class":97},[84,1613,1367],{"class":101},[84,1615,117],{"class":105},[84,1617,1618,1620,1622,1624],{"class":86,"line":94},[84,1619,123],{"class":97},[84,1621,638],{"class":97},[84,1623,1377],{"class":101},[84,1625,117],{"class":105},[84,1627,1628,1630,1632,1634,1636],{"class":86,"line":109},[84,1629,1384],{"class":97},[84,1631,1387],{"class":105},[84,1633,653],{"class":97},[84,1635,656],{"class":101},[84,1637,659],{"class":105},[84,1639,1640],{"class":86,"line":120},[84,1641,1398],{"class":105},[84,1643,1644],{"class":86,"line":134},[84,1645,1646],{"class":90},"    \u002F\u002F ...\n",[84,1648,1649],{"class":86,"line":146},[84,1650,149],{"class":105},[14,1652,1653,1187,1656,1658],{},[29,1654,1655],{},"The lesson",[34,1657,410],{}," on a struct's fields or methods does not make the struct type itself public — a public function cannot return (or accept) a type that is private, and each level of visibility (module, type, field, method) is checked independently.",[18,1660,1662],{"id":1661},"best-practices","Best Practices",[23,1664,1665,1668,1671,1677,1683,1689],{},[26,1666,1667],{},"One responsibility per module.",[26,1669,1670],{},"Hide internals; expose minimal API.",[26,1672,1673,1674,1676],{},"Use ",[34,1675,392],{}," to flatten the surface.",[26,1678,1679,1680,51],{},"Test files live alongside source (",[34,1681,1682],{},"#[cfg(test)] mod tests",[26,1684,1685,1686,51],{},"Re-export crates you wrap so users don't need direct deps (",[34,1687,1688],{},"pub use serde;",[26,1690,1691],{},"Don't go too deep — 3 levels is usually enough.",[18,1693,1694],{"id":1536},"Summary",[14,1696,1697,1698,1700,1701,1703,1704,47,1706,47,1708,1710,1711,1713],{},"Modules organize code; ",[34,1699,410],{}," controls visibility; ",[34,1702,192],{}," brings items into scope; ",[34,1705,447],{},[34,1707,452],{},[34,1709,240],{}," form absolute\u002Frelative paths; ",[34,1712,392],{}," re-exports flatten APIs. Files and modules are connected but distinct — the 2018 edition simplified the file\u002Fmodule mapping.",[14,1715,1716],{},"Next: Cargo features, build scripts, and release engineering.",[1718,1719,1720],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-deco