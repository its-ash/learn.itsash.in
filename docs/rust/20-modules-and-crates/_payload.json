[{"data":1,"prerenderedAt":627},["ShallowReactive",2],{"page-\u002Frust\u002F20-modules-and-crates":3},{"id":4,"title":5,"body":6,"description":16,"extension":620,"meta":621,"navigation":622,"path":623,"seo":624,"stem":625,"__hash__":626},"content\u002Frust\u002F20-modules-and-crates.md","20 — Modules, Crates, Packages & Paths",{"type":7,"value":8,"toc":587},"minimark",[9,13,17,22,67,71,81,95,99,107,116,123,129,134,140,143,150,156,159,173,193,199,203,209,212,218,221,225,232,236,265,269,275,284,292,296,304,311,315,321,327,337,341,347,361,365,374,380,387,391,395,401,405,411,415,421,428,434,438,528,532,561,565,584],[10,11,5],"h1",{"id":12},"_20-modules-crates-packages-paths",[14,15,16],"p",{},"Rust's module system controls visibility, organization, and namespacing.",[18,19,21],"h2",{"id":20},"definitions","Definitions",[23,24,25,38,52,58],"ul",{},[26,27,28,32,33,37],"li",{},[29,30,31],"strong",{},"Package",": a Cargo project (a ",[34,35,36],"code",{},"Cargo.toml"," + one or more crates).",[26,39,40,43,44,47,48,51],{},[29,41,42],{},"Crate",": a compilation unit (binary or library). Root file (",[34,45,46],{},"main.rs","\u002F",[34,49,50],{},"lib.rs",").",[26,53,54,57],{},[29,55,56],{},"Module",": a named scope inside a crate. Controls visibility.",[26,59,60,63,64,51],{},[29,61,62],{},"Path",": how you reference an item (",[34,65,66],{},"crate::foo::bar",[18,68,70],{"id":69},"module-declaration","Module Declaration",[72,73,79],"pre",{"className":74,"code":76,"language":77,"meta":78},[75],"language-rust","\u002F\u002F src\u002Flib.rs\nmod network;\nmod ui {\n    pub mod window;\n    pub mod button;\n}\n","rust","",[34,80,76],{"__ignoreMap":78},[14,82,83,86,87,90,91,94],{},[34,84,85],{},"mod network;"," looks for ",[34,88,89],{},"network.rs"," or ",[34,92,93],{},"network\u002Fmod.rs"," (legacy) and includes it as a submodule.",[18,96,98],{"id":97},"file-layout-conventions-2018","File Layout Conventions (2018+)",[72,100,105],{"className":101,"code":103,"language":104},[102],"language-text","src\u002F\n├── lib.rs            \u002F\u002F crate root: `pub mod ...`\n├── main.rs\n├── network.rs        \u002F\u002F corresponds to `mod network;`\n└── network\u002F\n    └── server.rs     \u002F\u002F corresponds to `mod server;` *inside* network.rs\n","text",[34,106,103],{"__ignoreMap":78},[14,108,109,110,112,113,115],{},"The 2018 edition prefers ",[34,111,89],{}," over ",[34,114,93],{},". Don't mix the two for the same module.",[18,117,119,122],{"id":118},"use-importing",[34,120,121],{},"use"," — Importing",[72,124,127],{"className":125,"code":126,"language":77,"meta":78},[75],"use std::collections::HashMap;\nuse std::io::{self, Read, Write};   \u002F\u002F bring multiple items\nuse std::io::Read as IoRead;        \u002F\u002F alias\nuse crate::network::server;          \u002F\u002F absolute path from crate root\nuse super::sibling;                  \u002F\u002F one module up\nuse self::inner;                     \u002F\u002F current module\n",[34,128,126],{"__ignoreMap":78},[130,131,133],"h3",{"id":132},"glob-imports","Glob Imports",[72,135,138],{"className":136,"code":137,"language":77,"meta":78},[75],"use std::io::prelude::*;            \u002F\u002F rare; usually too broad\nuse crate::network::*;               \u002F\u002F bring all public items\n",[34,139,137],{"__ignoreMap":78},[14,141,142],{},"Avoid glob imports except for preludes.",[18,144,146,149],{"id":145},"pub-use-re-exports",[34,147,148],{},"pub use"," — Re-exports",[72,151,154],{"className":152,"code":153,"language":77,"meta":78},[75],"\u002F\u002F lib.rs\npub mod api;\npub use api::Client;   \u002F\u002F re-export so users can `use my_crate::Client`\n",[34,155,153],{"__ignoreMap":78},[14,157,158],{},"Re-export is the standard way to flatten the public API and hide internal structure.",[18,160,162,163,166,167,166,170],{"id":161},"paths-and-crate-self-super","Paths and ",[34,164,165],{},"crate",", ",[34,168,169],{},"self",[34,171,172],{},"super",[23,174,175,181,187],{},[26,176,177,180],{},[34,178,179],{},"crate::"," — absolute from crate root.",[26,182,183,186],{},[34,184,185],{},"self::"," — current module.",[26,188,189,192],{},[34,190,191],{},"super::"," — parent module.",[72,194,197],{"className":195,"code":196,"language":77,"meta":78},[75],"\u002F\u002F in src\u002Fnetwork\u002Fserver.rs\nuse super::connection;     \u002F\u002F src\u002Fnetwork\u002Fconnection.rs\nuse crate::network::connection;   \u002F\u002F same, explicit\n",[34,198,196],{"__ignoreMap":78},[18,200,202],{"id":201},"visibility","Visibility",[72,204,207],{"className":205,"code":206,"language":77,"meta":78},[75],"pub fn public_fn() {}            \u002F\u002F visible everywhere\nfn private_fn() {}                \u002F\u002F visible only in this module\npub(crate) fn internal() {}       \u002F\u002F visible within this crate only\npub(super) fn for_parent() {}     \u002F\u002F visible in parent module\npub(in path) fn scoped() {}       \u002F\u002F visible in a specific module path\n",[34,208,206],{"__ignoreMap":78},[14,210,211],{},"Fields and variants have their own visibility:",[72,213,216],{"className":214,"code":215,"language":77,"meta":78},[75],"pub struct User {\n    pub name: String,\n    email: String,       \u002F\u002F private — only this module can construct\u002Fmodify\n}\n",[34,217,215],{"__ignoreMap":78},[14,219,220],{},"Enums' variants inherit the enum's visibility by default; you can override per-variant.",[18,222,224],{"id":223},"struct-visibility","Struct Visibility",[14,226,227,228,231],{},"A struct can be ",[34,229,230],{},"pub"," but have private fields — external code can't construct it with literal syntax or access private fields, but can use it via methods. This is how newtypes preserve invariants.",[18,233,235],{"id":234},"module-path-items","Module Path Items",[23,237,238,241,244,247,250,255],{},[26,239,240],{},"Modules",[26,242,243],{},"Functions",[26,245,246],{},"Structs\u002FEnums\u002FTypes",[26,248,249],{},"Constants\u002FStatics",[26,251,252,254],{},[34,253,121],{}," statements",[26,256,257,258,261,262,264],{},"Macros (via ",[34,259,260],{},"macro_rules!"," and ",[34,263,148],{},")",[18,266,268],{"id":267},"submodules-and-privacy","Submodules and Privacy",[14,270,271,272,274],{},"A child module can access anything in its parent (privacy is per-module-tree, with ",[34,273,230],{}," opening it up). Children can use private items of parents and ancestors.",[18,276,278,280,281],{"id":277},"pub-items-and-dochidden",[34,279,230],{}," Items and ",[34,282,283],{},"#[doc(hidden)]",[14,285,286,288,289,291],{},[34,287,283],{}," hides an item from docs while keeping it ",[34,290,230],{}," (used for internal macros or re-exports you don't want users to call directly).",[18,293,295],{"id":294},"crates-within-a-package","Crates Within a Package",[72,297,302],{"className":298,"code":300,"language":301,"meta":78},[299],"language-toml","# Cargo.toml\n[lib]\nname = \"my_lib\"\npath = \"src\u002Flib.rs\"\n\n[[bin]]\nname = \"my_app\"\npath = \"src\u002Fmain.rs\"\n","toml",[34,303,300],{"__ignoreMap":78},[14,305,306,307,310],{},"A package can have many binaries and at most one library. Binaries can use the library via ",[34,308,309],{},"use my_lib::...",".",[18,312,314],{"id":313},"external-crates","External Crates",[72,316,319],{"className":317,"code":318,"language":301,"meta":78},[299],"# Cargo.toml\n[dependencies]\nserde = \"1.0\"\n",[34,320,318],{"__ignoreMap":78},[72,322,325],{"className":323,"code":324,"language":77,"meta":78},[75],"use serde::Serialize;     \u002F\u002F external crates are in the extern prelude\n",[34,326,324],{"__ignoreMap":78},[14,328,329,330,333,334,336],{},"In edition 2018+, you don't need ",[34,331,332],{},"extern crate serde;"," — ",[34,335,121],{}," finds it.",[18,338,340],{"id":339},"workspaces","Workspaces",[72,342,345],{"className":343,"code":344,"language":301,"meta":78},[299],"# Cargo.toml\n[workspace]\nmembers = [\"crates\u002Fapi\", \"crates\u002Fcli\", \"crates\u002Fcore\"]\n",[34,346,344],{"__ignoreMap":78},[14,348,349,350,353,354,261,357,360],{},"Members can depend on each other via ",[34,351,352],{},"path = \"..\u002Fcore\"",". Shared ",[34,355,356],{},"Cargo.lock",[34,358,359],{},"target\u002F"," directory.",[18,362,364],{"id":363},"macros-across-modules","Macros Across Modules",[14,366,367,369,370,373],{},[34,368,260],{}," macros need ",[34,371,372],{},"#[macro_export]"," to be used outside their defining module:",[72,375,378],{"className":376,"code":377,"language":77,"meta":78},[75],"#[macro_export]\nmacro_rules! my_macro { \u002F* ... *\u002F }\n",[34,379,377],{"__ignoreMap":78},[14,381,382,383,386],{},"They're exported at the crate root. Use ",[34,384,385],{},"pub use my_macro;"," to re-export.",[18,388,390],{"id":389},"module-organization-patterns","Module Organization Patterns",[130,392,394],{"id":393},"library-binaries","Library + Binaries",[72,396,399],{"className":397,"code":398,"language":104},[102],"my_project\u002F\n├── Cargo.toml\n├── src\u002F\n│   ├── lib.rs       # public API\n│   └── bin\u002F\n│       ├── server.rs\n│       └── client.rs\n",[34,400,398],{"__ignoreMap":78},[130,402,404],{"id":403},"feature-gated-modules","Feature-Gated Modules",[72,406,409],{"className":407,"code":408,"language":77,"meta":78},[75],"#[cfg(feature = \"json\")]\npub mod json;\n",[34,410,408],{"__ignoreMap":78},[130,412,414],{"id":413},"tests-inline-and-separate","Tests Inline and Separate",[72,416,419],{"className":417,"code":418,"language":77,"meta":78},[75],"\u002F\u002F src\u002Flib.rs\npub fn add(a: i32, b: i32) -> i32 { a + b }\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    #[test]\n    fn test_add() { assert_eq!(add(1, 2), 3); }\n}\n",[34,420,418],{"__ignoreMap":78},[14,422,423,424,427],{},"Integration tests live in ",[34,425,426],{},"tests\u002F"," as separate crate:",[72,429,432],{"className":430,"code":431,"language":104},[102],"tests\u002F\n└── integration.rs\n",[34,433,431],{"__ignoreMap":78},[18,435,437],{"id":436},"edge-cases","Edge Cases",[23,439,440,457,465,478,486,499,507,516],{},[26,441,442,447,448,451,452,456],{},[29,443,444,446],{},[34,445,230],{}," doesn't propagate to ancestors",": a ",[34,449,450],{},"pub mod"," is public ",[453,454,455],"em",{},"if its parent is also accessible",". Privacy is layered.",[26,458,459,464],{},[29,460,461,463],{},[34,462,148],{}," ambiguity",": re-exporting two items with the same name into the same scope is an error.",[26,466,467,470,471,261,474,477],{},[29,468,469],{},"Module path and item name conflicts",": ",[34,472,473],{},"mod foo;",[34,475,476],{},"use crate::foo;"," are different things.",[26,479,480,485],{},[29,481,482],{},[34,483,484],{},"#[non_exhaustive]"," prevents exhaustive construction outside the crate.",[26,487,488,494,495,498],{},[29,489,490,491,493],{},"Private items in ",[34,492,230],{}," functions",": a public function can't have private types in its signature (e.g., ",[34,496,497],{},"pub fn get() -> PrivateType"," is an error — leaks private type).",[26,500,501,506],{},[29,502,503],{},[34,504,505],{},"extern crate self as foo;",": lets you refer to your own crate by name (rare).",[26,508,509,515],{},[29,510,511,512],{},"Hidden ",[34,513,514],{},"mod.rs",": still works but is discouraged; the new layout is cleaner.",[26,517,518,523,524,527],{},[29,519,520,522],{},[34,521,148],{}," for preludes",": many crates expose ",[34,525,526],{},"pub mod prelude { pub use ...; }"," for one-line imports.",[18,529,531],{"id":530},"best-practices","Best Practices",[23,533,534,537,540,546,552,558],{},[26,535,536],{},"One responsibility per module.",[26,538,539],{},"Hide internals; expose minimal API.",[26,541,542,543,545],{},"Use ",[34,544,148],{}," to flatten the surface.",[26,547,548,549,51],{},"Test files live alongside source (",[34,550,551],{},"#[cfg(test)] mod tests",[26,553,554,555,51],{},"Re-export crates you wrap so users don't need direct deps (",[34,556,557],{},"pub use serde;",[26,559,560],{},"Don't go too deep — 3 levels is usually enough.",[18,562,564],{"id":563},"summary","Summary",[14,566,567,568,570,571,573,574,47,576,47,578,580,581,583],{},"Modules organize code; ",[34,569,230],{}," controls visibility; ",[34,572,121],{}," brings items into scope; ",[34,575,165],{},[34,577,172],{},[34,579,169],{}," form absolute\u002Frelative paths; ",[34,582,148],{}," re-exports flatten APIs. Files and modules are connected but distinct — the 2018 edition simplified the file\u002Fmodule mapping.",[14,585,586],{},"Next: Cargo features, build scripts, and release engineering.",{"title":78,"searchDepth":588,"depth":588,"links":589},2,[590,591,592,593,598,600,602,603,604,605,606,608,609,610,611,612,617,618,619],{"id":20,"depth":588,"text":21},{"id":69,"depth":588,"text":70},{"id":97,"depth":588,"text":98},{"id":118,"depth":588,"text":594,"children":595},"use — Importing",[596],{"id":132,"depth":597,"text":133},3,{"id":145,"depth":588,"text":599},"pub use — Re-exports",{"id":161,"depth":588,"text":601},"Paths and crate, self, super",{"id":201,"depth":588,"text":202},{"id":223,"depth":588,"text":224},{"id":234,"depth":588,"text":235},{"id":267,"depth":588,"text":268},{"id":277,"depth":588,"text":607},"pub Items and #[doc(hidden)]",{"id":294,"depth":588,"text":295},{"id":313,"depth":588,"text":314},{"id":339,"depth":588,"text":340},{"id":363,"depth":588,"text":364},{"id":389,"depth":588,"text":390,"children":613},[614,615,616],{"id":393,"depth":597,"text":394},{"id":403,"depth":597,"text":404},{"id":413,"depth":597,"text":414},{"id":436,"depth":588,"text":437},{"id":530,"depth":588,"text":531},{"id":563,"depth":588,"text":564},"md",{},true,"\u002Frust\u002F20-modules-and-crates",{"title":5,"description":16},"rust\u002F20-modules-and-crates","3n6C6ryI6hx1vWvPJ6ga0coTN4w7TQq70J9bCSw7dC0",1785934122320]