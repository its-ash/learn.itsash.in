[34,1269,410],{}," deliberately or restructure so the function returns a public trait\u002Fwrapper instead.",[26,1272,1273,1275,1276,1278,1279,1281,1282,1284],{},[29,1274,1220],{},": keep re-exports (",[34,1277,392],{},") in one clearly-named place (often ",[34,1280,50],{}," or a dedicated ",[34,1283,358],{}," module) rather than scattered across many files — it gives you a single file to scan when auditing exactly what your crate's public surface looks like.",[26,1286,1287,1235,1289,1292,1293,1297,1298,1300],{},[29,1288,1234],{},[34,1290,1291],{},"cargo doc --open"," is a fast way to sanity-check what's ",[1294,1295,1296],"em",{},"actually"," publicly visible from outside your crate — rustdoc only shows ",[34,1299,410],{}," items reachable from the crate root, so it's an accurate mirror of what consumers see, unlike scanning source files by eye.",[18,1302,1304],{"id":1303},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[23,1306,1307,1323,1331,1343,1351,1364,1372,1380],{},[26,1308,1309,1314,1315,1318,1319,1322],{},[29,1310,1311,1313],{},[34,1312,410],{}," doesn't propagate to ancestors",": a ",[34,1316,1317],{},"pub mod"," is public ",[1294,1320,1321],{},"if its parent is also accessible",". Privacy is layered.",[26,1324,1325,1330],{},[29,1326,1327,1329],{},[34,1328,392],{}," ambiguity",": re-exporting two items with the same name into the same scope is an error.",[26,1332,1333,1235,1336,721,1339,1342],{},[29,1334,1335],{},"Module path and item name conflicts",[34,1337,1338],{},"mod foo;",[34,1340,1341],{},"use crate::foo;"," are different things.",[26,1344,1345,1350],{},[29,1346,1347],{},[34,1348,1349],{},"#[non_exhaustive]"," prevents exhaustive construction outside the crate.",[26,1352,1353,1359,1360,1363],{},[29,1354,1355,1356,1358],{},"Private items in ",[34,1357,410],{}," functions",": a public function can't have private types in its signature (e.g., ",[34,1361,1362],{},"pub fn get() -> PrivateType"," is an error — leaks private type).",[26,1365,1366,1371],{},[29,1367,1368],{},[34,1369,1370],{},"extern crate self as foo;",": lets you refer to your own crate by name (rare).",[26,1373,1374,1379],{},[29,1375,1376,1377],{},"Hidden ",[34,1378,1246],{},": still works but is discouraged; the new layout is cleaner.",[26,1381,1382,1387,1388,1390],{},[29,1383,1384,1386],{},[34,1385,392],{}," for preludes",": many crates expose ",[34,1389,1224],{}," for one-line imports.",[18,1392,1394],{"id":1393},"spot-the-bug","🧠 Spot the Bug",[14,1396,1397,1398,1401],{},"Why does this fail to compile, given that ",[34,1399,1400],{},"Config"," is clearly used successfully inside the crate?",[72,1403,1404],{"language":74},[76,1405,1407],{"className":78,"code":1406,"language":74,"meta":80,"style":80},"mod settings {\n    struct Config {\n        pub host: String,\n    }\n\n    impl Config {\n        pub fn new(host: &str) -> Self {\n            Config { host: host.to_string() }\n        }\n    }\n}\n\npub fn load_config() -> settings::Config {\n    settings::Config::new(\"localhost\")\n}\n",[34,1408,1409,1418,1428,1442,1447,1451,1460,1489,1509,1514,1519,1524,1529,1552,1575],{"__ignoreMap":80},[84,1410,1411,1413,1416],{"class":86,"line":87},[84,1412,98],{"class":97},[84,1414,1415],{"class":101}," settings",[84,1417,117],{"class":105},[84,1419,1420,1423,1426],{"class":86,"line":94},[84,1421,1422],{"class":97},"    struct",[84,1424,1425],{"class":101}," Config",[84,1427,117],{"class":105},[84,1429,1430,1433,1436,1438,1440],{"class":86,"line":109},[84,1431,1432],{"class":97},"        pub",[84,1434,1435],{"class":105}," host",[84,1437,653],{"class":97},[84,1439,656],{"class":101},[84,1441,659],{"class":105},[84,1443,1444],{"class":86,"line":120},[84,1445,1446],{"class":105},"    }\n",[84,1448,1449],{"class":86,"line":134},[84,1450,803],{"emptyLinePlaceholder":802},[84,1452,1453,1456,1458],{"class":86,"line":146},[84,1454,1455],{"class":97},"    impl",[84,1457,1425],{"class":101},[84,1459,117],{"class":105},[84,1461,1462,1464,1466,1469,1472,1474,1477