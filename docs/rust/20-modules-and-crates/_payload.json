ace`.",[14,1594,1595,1596,1598,1599,1601,1602,1605,1606,1609,1610,1613,1614,1617,1618,1620,1621,1623,1624,1626,1627,1630,1631,1634,1635,1638,1639,1642],{},"The ",[34,1597,1400],{}," struct itself is declared without ",[34,1600,410],{}," (",[34,1603,1604],{},"struct Config",", not ",[34,1607,1608],{},"pub struct Config",") — it's private to the ",[34,1611,1612],{},"settings"," module, even though its ",[34,1615,1616],{},"host"," field and ",[34,1619,1566],{}," associated function are marked ",[34,1622,410],{},". Marking members ",[34,1625,410],{}," doesn't make the ",[1294,1628,1629],{},"containing type"," public; visibility is checked at every level independently. The function ",[34,1632,1633],{},"load_config"," is declared ",[34,1636,1637],{},"pub fn load_config() -> settings::Config",", which means any external crate calling it would receive a value of type ",[34,1640,1641],{},"settings::Config"," — but that type is private, so external code couldn't even name it, store it in a variable with an explicit type, or reference it in their own function signatures. Rust refuses to compile this contradiction: a public function cannot expose a private type in its signature, because doing so would create a type that callers can receive but can't meaningfully use or refer to.",[14,1644,1645,1646,1648],{},"The fix is to make the struct itself ",[34,1647,410],{}," (in addition to whichever fields\u002Fmethods should be public):",[72,1650,1651],{"language":74},[76,1652,1654],{"className":78,"code":1653,"language":74,"meta":80,"style":80},"mod settings {\n    pub struct Config {\n        pub host: String,\n    }\n    \u002F\u002F ...\n}\n",[34,1655,1656,1664,1674,1686,1690,1695],{"__ignoreMap":80},[84,1657,1658,1660,1662],{"class":86,"line":87},[84,1659,98],{"class":97},[84,1661,1415],{"class":101},[84,1663,117],{"class":105},[84,1665,1666,1668,1670,1672],{"class":86,"line":94},[84,1667,123],{"class":97},[84,1669,638],{"class":97},[84,1671,1425],{"class":101},[84,1673,117],{"class":105},[84,1675,1676,1678,1680,1682,1684],{"class":86,"line":109},[84,1677,1432],{"class":97},[84,1679,1435],{"class":105},[84,1681,653],{"class":97},[84,1683,656],{"class":101},[84,1685,659],{"class":105},[84,1687,1688],{"class":86,"line":120},[84,1689,1446],{"class":105},[84,1691,1692],{"class":86,"line":134},[84,1693,1694],{"class":90},"    \u002F\u002F ...\n",[84,1696,1697],{"class":86,"line":146},[84,1698,149],{"class":105},[14,1700,1701,1235,1704,1706],{},[29,1702,1703],{},"The lesson",[34,1705,410],{}," on a struct's fields or methods does not make the struct type itself public — a public function cannot return (or accept) a type that is private, and each level of visibility (module, type, field, method) is checked independently.",[18,1708,1710],{"id":1709},"best-practices","Best Practices",[23,1712,1713,1716,1719,1725,1731,1737],{},[26,1714,1715],{},"One responsibility per module.",[26,1717,1718],{},"Hide internals; expose minimal API.",[26,1720,1721,1722,1724],{},"Use ",[34,1723,392],{}," to flatten the surface.",[26,1726,1727,1728,51],{},"Test files live alongside source (",[34,1729,1730],{},"#[cfg(test)] mod tests",[26,1732,1733,1734,51],{},"Re-export crates you wrap so users don't need direct deps (",[34,1735,1736],{},"pub use serde;",[26,1738,1739],{},"Don't go too deep — 3 levels is usually enough.",[18,1741,1742],{"id":1584},"Summary",[14,1744,1745,1746,1748,1749,1751,1752,47,1754,47,1756,1758,1759,1761],{},"Modules organize code; ",[34,1747,410],{}," controls visibility; ",[34,1750,192],{}," brings items into scope; ",[34,1753,447],{},[34,1755,452],{},[34,1757,240],{}," form absolute\u002Frelative paths; ",[34,1760,392],{}," re-exports flatten APIs. Files and modules are connected but distinct — the 2018 edition simplified the file\u002Fmodule mapping.",[14,1763,1764],{},"Next: Cargo features, build scripts, and release engineering.",[1766,1767,1768],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-gith