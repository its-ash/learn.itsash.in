[{"data":1,"prerenderedAt":608},["ShallowReactive",2],{"page-\u002Frust\u002F13-pattern-matching":3},{"id":4,"title":5,"body":6,"description":16,"extension":601,"meta":602,"navigation":603,"path":604,"seo":605,"stem":606,"__hash__":607},"content\u002Frust\u002F13-pattern-matching.md","13 — Pattern Matching (Deep Dive)",{"type":7,"value":8,"toc":565},"minimark",[9,13,17,22,66,76,80,85,91,98,101,105,111,118,125,131,134,140,147,153,164,168,174,178,184,188,194,198,204,213,217,223,227,233,243,250,256,261,265,271,283,293,296,302,305,311,316,322,330,334,341,345,351,357,364,370,377,381,493,499,534,538,552],[10,11,5],"h1",{"id":12},"_13-pattern-matching-deep-dive",[14,15,16],"p",{},"Pattern matching is Rust's most expressive control-flow construct. This chapter covers every pattern form, the binding rules, and the gotchas.",[18,19,21],"h2",{"id":20},"where-patterns-appear","Where Patterns Appear",[23,24,25,33,42,48,53,56],"ul",{},[26,27,28,32],"li",{},[29,30,31],"code",{},"match"," arms",[26,34,35,38,39],{},[29,36,37],{},"if let"," \u002F ",[29,40,41],{},"while let",[26,43,44,47],{},[29,45,46],{},"let"," declarations (destructure)",[26,49,50],{},[29,51,52],{},"let-else",[26,54,55],{},"Function parameters (limited)",[26,57,58,61,62,65],{},[29,59,60],{},"for","\u002F",[29,63,64],{},"while"," loops (destructure each item)",[67,68,74],"pre",{"className":69,"code":71,"language":72,"meta":73},[70],"language-rust","let (a, b) = (1, 2);\nfn first((a, _): (i32, i32)) -> i32 { a }\nfor (i, v) in vec.iter().enumerate() { \u002F* ... *\u002F }\n","rust","",[29,75,71],{"__ignoreMap":73},[18,77,79],{"id":78},"pattern-forms","Pattern Forms",[81,82,84],"h3",{"id":83},"literals","Literals",[67,86,89],{"className":87,"code":88,"language":72,"meta":73},[70],"match x { 0 => \"zero\", 1 => \"one\", _ => \"many\" }\nmatch c { 'a'..='z' | 'A'..='Z' => \"letter\", _ => \"other\" }\n",[29,90,88],{"__ignoreMap":73},[81,92,94,95],{"id":93},"wildcards-_","Wildcards ",[29,96,97],{},"_",[14,99,100],{},"Matches anything, doesn't bind. Use to ignore.",[81,102,104],{"id":103},"variables","Variables",[67,106,109],{"className":107,"code":108,"language":72,"meta":73},[70],"match opt {\n    Some(x) => println!(\"{x}\"),   \u002F\u002F binds x\n    None => {},\n}\n",[29,110,108],{"__ignoreMap":73},[14,112,113,114,117],{},"A bare identifier binds the value. ",[29,115,116],{},"_x"," also binds but signals \"intentionally unused\" (suppresses warnings).",[81,119,121,122],{"id":120},"or-patterns","Or-Patterns ",[29,123,124],{},"|",[67,126,129],{"className":127,"code":128,"language":72,"meta":73},[70],"match x {\n    1 | 2 | 3 => \"small\",\n    4 | 5 | 6 => \"medium\",\n    _ => \"big\",\n}\n",[29,130,128],{"__ignoreMap":73},[14,132,133],{},"Can bind in all alternatives with the same name (or-pattern binding, edition 2021+):",[67,135,138],{"className":136,"code":137,"language":72,"meta":73},[70],"let (Ok(n) | Err(n)) = result.map(|n| n + 1).map_err(|e| 0);\n",[29,139,137],{"__ignoreMap":73},[81,141,143,144],{"id":142},"ranges","Ranges ",[29,145,146],{},"..=",[67,148,151],{"className":149,"code":150,"language":72,"meta":73},[70],"match x {\n    0..=9 => \"digit\",\n    10..=99 => \"tens\",\n    100.. => \"big\",     \u002F\u002F open-ended (unstable on stable for match arms in some forms)\n}\n",[29,152,150],{"__ignoreMap":73},[14,154,155,156,159,160,163],{},"Ranges work for ",[29,157,158],{},"char"," and numeric types. Use ",[29,161,162],{},".."," for exclusive range in slice patterns.",[81,165,167],{"id":166},"destructuring-structs","Destructuring Structs",[67,169,172],{"className":170,"code":171,"language":72,"meta":73},[70],"struct P { x: i32, y: i32 }\nmatch p {\n    P { x, y } => println!(\"{x},{y}\"),     \u002F\u002F shorthand\n    P { x: a, y: b } => println!(\"{a},{b}\"),\n    P { x, .. } => println!(\"only x\"),     \u002F\u002F ignore rest\n}\n",[29,173,171],{"__ignoreMap":73},[81,175,177],{"id":176},"destructuring-tuples","Destructuring Tuples",[67,179,182],{"className":180,"code":181,"language":72,"meta":73},[70],"match t {\n    (0, _) => \"first zero\",\n    (a, b) if a \u003C b => \"ascending\",\n    _ => \"other\",\n}\nlet (x, ..) = (1, 2, 3);    \u002F\u002F first element only\nlet (.., z) = (1, 2, 3);    \u002F\u002F last element only\n",[29,183,181],{"__ignoreMap":73},[81,185,187],{"id":186},"destructuring-enums","Destructuring Enums",[67,189,192],{"className":190,"code":191,"language":72,"meta":73},[70],"match e {\n    Message::Quit => {},\n    Message::Move { x: 0, y } => println!(\"zero-x, y={y}\"),\n    Message::Move { x, y } => println!(\"{x},{y}\"),\n    Message::Write(s) if s.is_empty() => \"empty\",\n    Message::Write(s) => s,\n    Message::ChangeColor(r, g, b) => println!(\"{r},{g},{b}\"),\n}\n",[29,193,191],{"__ignoreMap":73},[81,195,197],{"id":196},"slice-patterns","Slice Patterns",[67,199,202],{"className":200,"code":201,"language":72,"meta":73},[70],"match slice {\n    [] => \"empty\",\n    [a] => \"one: {a}\",\n    [a, b] => \"two: {a},{b}\",\n    [first, .., last] => \"first={first} last={last}\",   \u002F\u002F subslice pattern\n    [a, b, c @ ..] => println!(\"{a}, {b}, rest={:?}\", c),\n}\n",[29,203,201],{"__ignoreMap":73},[14,205,206,208,209,212],{},[29,207,162],{}," in slice patterns matches the middle (any length). Limited stable support; ",[29,210,211],{},"c @ .."," binds the subslice.",[81,214,216],{"id":215},"reference-patterns","Reference Patterns",[67,218,221],{"className":219,"code":220,"language":72,"meta":73},[70],"match &x {\n    &0 => \"ref to zero\",      \u002F\u002F matches &0\n    0 => \"deref zero\",         \u002F\u002F auto-deref (binding mode)\n}\nlet &y = &5;                  \u002F\u002F matches the reference, y is i32 (Copy)\nlet ref r = x;               \u002F\u002F r: &i32 — borrow pattern\nlet mut z = 0;\nmatch z {\n    ref mut r => *r += 1,    \u002F\u002F r: &mut i32\n}\n",[29,222,220],{"__ignoreMap":73},[81,224,226],{"id":225},"binding-modes-2021","Binding Modes (2021)",[67,228,231],{"className":229,"code":230,"language":72,"meta":73},[70],"match &opt {\n    Some(x) => println!(\"{x}\"),   \u002F\u002F x: &i32 — auto-ref\n    None => {}\n}\nmatch &mut opt {\n    Some(x) => *x += 1,           \u002F\u002F x: &mut i32\n    None => {}\n}\n",[29,232,230],{"__ignoreMap":73},[14,234,235,236,61,239,242],{},"The 2021 edition simplified this — you no longer sprinkle ",[29,237,238],{},"&",[29,240,241],{},"&mut"," everywhere. The compiler inserts references as needed based on what you match against.",[81,244,246,249],{"id":245},"bindings",[29,247,248],{},"@"," Bindings",[67,251,254],{"className":252,"code":253,"language":72,"meta":73},[70],"match n {\n    x @ 0..=9 => \"small: {x}\",\n    x @ (10..=99) => \"medium: {x}\",\n    _ => \"big\",\n}\n",[29,255,253],{"__ignoreMap":73},[14,257,258,260],{},[29,259,248],{}," binds the value while also constraining it with a pattern.",[81,262,264],{"id":263},"match-guards","Match Guards",[67,266,269],{"className":267,"code":268,"language":72,"meta":73},[70],"match opt {\n    Some(x) if x > 0 => \"positive\",\n    Some(_) => \"non-positive\",\n    None => \"none\",\n}\n",[29,270,268],{"__ignoreMap":73},[14,272,273,274,278,279,282],{},"Guards let you add boolean conditions. They ",[275,276,277],"em",{},"can"," prevent exhaustiveness checking — the compiler considers guards potentially false even for matched patterns, so you often need ",[29,280,281],{},"_ =>"," arms.",[18,284,286,289,290],{"id":285},"ref-and-ref-mut",[29,287,288],{},"ref"," and ",[29,291,292],{},"ref mut",[14,294,295],{},"Old-school (pre-2021) way to borrow in patterns:",[67,297,300],{"className":298,"code":299,"language":72,"meta":73},[70],"match opt {\n    Some(ref x) => ...,    \u002F\u002F x: &i32\n    None => ...,\n}\n",[29,301,299],{"__ignoreMap":73},[14,303,304],{},"Still useful when the default binding mode doesn't fit (e.g., matching by value where you want a ref to one field). Modern Rust mostly auto-borrows.",[18,306,308,309],{"id":307},"destructuring-with","Destructuring with ",[29,310,162],{},[14,312,313,315],{},[29,314,162],{}," ignores remaining fields\u002Felements:",[67,317,320],{"className":318,"code":319,"language":72,"meta":73},[70],"let P { x, .. } = p;     \u002F\u002F ignore y\nlet (a, .., z) = tuple;  \u002F\u002F ignore middle\n",[29,321,319],{"__ignoreMap":73},[14,323,324,326,327,329],{},[29,325,162],{}," can appear once in a struct pattern and once in a tuple\u002Fslice pattern. Multiple ",[29,328,162],{}," is an error.",[18,331,333],{"id":332},"patterns-dont-allow-expressions","Patterns Don't Allow Expressions",[14,335,336,337,340],{},"You can't write ",[29,338,339],{},"Some(x + 1)"," as a pattern. Guards exist for that. Patterns are structural; conditions go in guards.",[18,342,344],{"id":343},"exhaustiveness","Exhaustiveness",[67,346,349],{"className":347,"code":348,"language":72,"meta":73},[70],"fn classify(c: Color) -> &'static str {\n    match c {\n        Color::Red => \"red\",\n        \u002F\u002F ERROR if missing Green\u002FBlue\n    }\n}\n",[29,350,348],{"__ignoreMap":73},[14,352,353,354,356],{},"The compiler lists the missing patterns. Add ",[29,355,97],{}," if you genuinely don't care, but be explicit when you can — exhaustiveness is a feature.",[18,358,360,363],{"id":359},"matches-macro",[29,361,362],{},"matches!"," Macro",[67,365,368],{"className":366,"code":367,"language":72,"meta":73},[70],"let is_some = matches!(opt, Some(_));\nlet in_range = matches!(n, 0..=9 | 100..=199);\n",[29,369,367],{"__ignoreMap":73},[14,371,372,373,376],{},"Concise one-arm matcher returning ",[29,374,375],{},"bool",".",[18,378,380],{"id":379},"common-pitfalls","Common Pitfalls",[23,382,383,398,413,427,436,457,471,480],{},[26,384,385,389,390,393,394,397],{},[386,387,388],"strong",{},"Variable shadowing in pattern",": ",[29,391,392],{},"match x { Some(x) => x, None => 0 }"," — the inner ",[29,395,396],{},"x"," shadows the outer; usually what you want, but easy to misread.",[26,399,400,389,407,409,410,412],{},[386,401,402,404,405],{},[29,403,97],{}," vs ",[29,406,116],{},[29,408,97],{}," doesn't bind (drops the value), ",[29,411,116],{}," binds (must be used or it warns).",[26,414,415,418,419,422,423,426],{},[386,416,417],{},"Binding mode surprises",": when matching ",[29,420,421],{},"&Option\u003Ci32>",", the bound variable is ",[29,424,425],{},"&i32",". The compiler prints the inferred type — read the error carefully.",[26,428,429,432,433,435],{},[386,430,431],{},"Match guard + exhaustiveness",": guards make the compiler treat arms as non-exhaustive. Always have a final ",[29,434,97],{}," or cover every variant.",[26,437,438,441,442,445,446,449,450,452,453,456],{},[386,439,440],{},"Move-out in pattern",": matching ",[29,443,444],{},"Some(s)"," on a ",[29,447,448],{},"String","-carrying enum by value moves the ",[29,451,448],{},"; matching ",[29,454,455],{},"&Some(s)"," borrows it.",[26,458,459,389,462,464,465,467,468,470],{},[386,460,461],{},"Range patterns need contiguous types",[29,463,146],{}," works for ",[29,466,158],{}," and integers; ",[29,469,448],{}," can't be range-matched.",[26,472,473,389,476,479],{},[386,474,475],{},"Nested patterns",[29,477,478],{},"Some((Ok(x), _))"," is valid; patterns nest arbitrarily.",[26,481,482,389,485,488,489,492],{},[386,483,484],{},"Tuple struct variants",[29,486,487],{},"Message::Move { x, y }"," (struct form) vs ",[29,490,491],{},"Message::Write(s)"," (tuple form) — must use the form matching the variant.",[18,494,496,498],{"id":495},"let-patterns-and-refutability",[29,497,46],{}," Patterns and Refutability",[23,500,501,519,526],{},[26,502,503,506,507,510,511,514,515,518],{},[29,504,505],{},"let PATTERN = expr"," requires PATTERN to be ",[386,508,509],{},"irrefutable"," (always matches): ",[29,512,513],{},"let (a, b) = tuple"," is fine; ",[29,516,517],{},"let Some(x) = opt"," is an error (refutable).",[26,520,521,289,523,525],{},[29,522,37],{},[29,524,41],{}," accept refutable patterns.",[26,527,528,530,531,376],{},[29,529,52],{}," bridges: ",[29,532,533],{},"let Some(x) = opt else { return; };",[18,535,537],{"id":536},"summary","Summary",[14,539,540,541,543,544,61,546,548,549,551],{},"Patterns are structural, support literals, ranges, or-patterns, destructuring, ",[29,542,248],{}," bindings, and guards. The 2021 binding modes reduced noise. Exhaustiveness is enforced. ",[29,545,288],{},[29,547,292],{}," are escape hatches for older patterns. ",[29,550,362],{}," is a tiny match for booleans.",[14,553,554,555,558,559,558,561,564],{},"Next: Collections (",[29,556,557],{},"Vec",", ",[29,560,448],{},[29,562,563],{},"HashMap",", etc.).",{"title":73,"searchDepth":566,"depth":566,"links":567},2,[568,569,589,591,593,594,595,597,598,600],{"id":20,"depth":566,"text":21},{"id":78,"depth":566,"text":79,"children":570},[571,573,575,576,578,580,581,582,583,584,585,586,588],{"id":83,"depth":572,"text":84},3,{"id":93,"depth":572,"text":574},"Wildcards _",{"id":103,"depth":572,"text":104},{"id":120,"depth":572,"text":577},"Or-Patterns |",{"id":142,"depth":572,"text":579},"Ranges ..=",{"id":166,"depth":572,"text":167},{"id":176,"depth":572,"text":177},{"id":186,"depth":572,"text":187},{"id":196,"depth":572,"text":197},{"id":215,"depth":572,"text":216},{"id":225,"depth":572,"text":226},{"id":245,"depth":572,"text":587},"@ Bindings",{"id":263,"depth":572,"text":264},{"id":285,"depth":566,"text":590},"ref and ref mut",{"id":307,"depth":566,"text":592},"Destructuring with ..",{"id":332,"depth":566,"text":333},{"id":343,"depth":566,"text":344},{"id":359,"depth":566,"text":596},"matches! Macro",{"id":379,"depth":566,"text":380},{"id":495,"depth":566,"text":599},"let Patterns and Refutability",{"id":536,"depth":566,"text":537},"md",{},true,"\u002Frust\u002F13-pattern-matching",{"title":5,"description":16},"rust\u002F13-pattern-matching","vv3yEEFlzJhmqyI6UYVKF4B9c8cnPUPBHam7w97aHRw",1785934122319]