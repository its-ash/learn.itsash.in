[{"data":1,"prerenderedAt":795},["ShallowReactive",2],{"page-\u002Frust\u002F04-data-types":3},{"id":4,"title":5,"body":6,"description":148,"extension":788,"meta":789,"navigation":790,"path":791,"seo":792,"stem":793,"__hash__":794},"content\u002Frust\u002F04-data-types.md","04 — Data Types",{"type":7,"value":8,"toc":761},"minimark",[9,13,18,23,141,151,156,199,205,209,227,233,260,264,290,298,307,313,350,354,358,361,367,402,406,409,415,447,457,460,464,485,491,495,501,516,523,541,547,551,557,560,564,570,573,579,584,590,606,610,751,755],[10,11,5],"h1",{"id":12},"_04-data-types",[14,15,17],"h2",{"id":16},"scalar-types","Scalar Types",[19,20,22],"h3",{"id":21},"integers","Integers",[24,25,26,42],"table",{},[27,28,29],"thead",{},[30,31,32,36,39],"tr",{},[33,34,35],"th",{},"Type",[33,37,38],{},"Bits",[33,40,41],{},"Signed\u002FUnsigned",[43,44,45,64,79,95,110,125],"tbody",{},[30,46,47,58,61],{},[48,49,50,54,55],"td",{},[51,52,53],"code",{},"i8"," ",[51,56,57],{},"u8",[48,59,60],{},"8",[48,62,63],{},"signed\u002Funsigned",[30,65,66,74,77],{},[48,67,68,54,71],{},[51,69,70],{},"i16",[51,72,73],{},"u16",[48,75,76],{},"16",[48,78],{},[30,80,81,89,92],{},[48,82,83,54,86],{},[51,84,85],{},"i32",[51,87,88],{},"u32",[48,90,91],{},"32",[48,93,94],{},"(default integer)",[30,96,97,105,108],{},[48,98,99,54,102],{},[51,100,101],{},"i64",[51,103,104],{},"u64",[48,106,107],{},"64",[48,109],{},[30,111,112,120,123],{},[48,113,114,54,117],{},[51,115,116],{},"i128",[51,118,119],{},"u128",[48,121,122],{},"128",[48,124],{},[30,126,127,135,138],{},[48,128,129,54,132],{},[51,130,131],{},"isize",[51,133,134],{},"usize",[48,136,137],{},"ptr-width (platform)",[48,139,140],{},"index\u002Fsizes",[142,143,149],"pre",{"className":144,"code":146,"language":147,"meta":148},[145],"language-rust","let a: i32 = -5;\nlet b: u8 = 255;\nlet hex = 0xff;\nlet oct = 0o17;\nlet bin = 0b1010;\nlet byte = b'A';        \u002F\u002F u8 from byte literal -> 65\nlet big = 1_000_000;    \u002F\u002F underscores for readability\n","rust","",[51,150,146],{"__ignoreMap":148},[152,153,155],"h4",{"id":154},"integer-overflow","Integer Overflow",[157,158,159,168,174],"ul",{},[160,161,162,163,167],"li",{},"In ",[164,165,166],"strong",{},"debug"," builds: overflow panics.",[160,169,162,170,173],{},[164,171,172],{},"release"," builds: wraps silently (two's complement).",[160,175,176,177,180,181,184,185,188,189,184,192,188,195,198],{},"Explicit methods: ",[51,178,179],{},"wrapping_add",", ",[51,182,183],{},"checked_add"," (returns ",[51,186,187],{},"Option","), ",[51,190,191],{},"overflowing_add",[51,193,194],{},"(value, overflowed)",[51,196,197],{},"saturating_add",".",[142,200,203],{"className":201,"code":202,"language":147,"meta":148},[145],"let (val, ovf) = 255u8.overflowing_add(1); \u002F\u002F (0, true)\nlet safe = 255u8.checked_add(1);          \u002F\u002F None\nlet sat = 255u8.saturating_add(1);        \u002F\u002F 255\nlet wrap = 255u8.wrapping_add(1);         \u002F\u002F 0\n",[51,204,202],{"__ignoreMap":148},[19,206,208],{"id":207},"floats","Floats",[210,211,212,180,215,218,219,222,223,226],"p",{},[51,213,214],{},"f32",[51,216,217],{},"f64"," (default). IEEE 754. No ",[51,220,221],{},"f16","\u002F",[51,224,225],{},"f128"," in std.",[142,228,231],{"className":229,"code":230,"language":147,"meta":148},[145],"let f = 2.0;        \u002F\u002F f64\nlet g: f32 = 3.0;\nlet inf = f64::INFINITY;\nlet nan = f64::NAN;\nnan == nan          \u002F\u002F false! NaN never equals itself\nnan.is_nan()        \u002F\u002F true\n",[51,232,230],{"__ignoreMap":148},[210,234,235,236,239,240,243,244,247,248,251,252,255,256,259],{},"Floats implement ",[51,237,238],{},"PartialOrd"," (not ",[51,241,242],{},"Ord",") because NaN has no total ordering. ",[51,245,246],{},"f64::NAN.partial_cmp(&f64::NAN)"," returns ",[51,249,250],{},"None",". Sorting floats requires ",[51,253,254],{},"sort_by(|a, b| a.partial_cmp(b).unwrap_or(Ordering::Equal))"," or ",[51,257,258],{},"total_cmp"," (1.62+, gives total ordering).",[19,261,263],{"id":262},"booleans","Booleans",[210,265,266,269,270,222,273,276,277,280,281,284,285,289],{},[51,267,268],{},"bool",", values ",[51,271,272],{},"true",[51,274,275],{},"false",", one byte. Cast with ",[51,278,279],{},"as"," to integer: ",[51,282,283],{},"true as u8 == 1",". Booleans are ",[286,287,288],"em",{},"not"," integers (no implicit conversion in conditions or arithmetic).",[19,291,293,294,297],{"id":292},"characters-char","Characters (",[51,295,296],{},"char",")",[210,299,300,302,303,306],{},[51,301,296],{}," is a ",[164,304,305],{},"4-byte Unicode scalar value"," (not UTF-8 bytes, not a byte):",[142,308,311],{"className":309,"code":310,"language":147,"meta":148},[145],"let c = 'z';\nlet emoji = '🦀';\nlet heart = '\\u{2764}';\n",[51,312,310],{"__ignoreMap":148},[157,314,315,330,336],{},[160,316,317,320,321,324,325,327,328,198],{},[51,318,319],{},"'A'"," vs ",[51,322,323],{},"b'A'",": the first is ",[51,326,296],{}," (4 bytes), the second is ",[51,329,57],{},[160,331,332,333,335],{},"Surrogates (D800–DFFF) are not valid ",[51,334,296],{},"s.",[160,337,338,339,342,343,345,346,349],{},"Iterating ",[51,340,341],{},"&str"," yields ",[51,344,296],{},"s (decodes UTF-8); indexing ",[51,347,348],{},"s[0]"," panics (UTF-8 bytes don't align with chars).",[14,351,353],{"id":352},"compound-types","Compound Types",[19,355,357],{"id":356},"tuples","Tuples",[210,359,360],{},"Fixed-length, heterogeneous:",[142,362,365],{"className":363,"code":364,"language":147,"meta":148},[145],"let t: (i32, f64, &str) = (1, 2.0, \"three\");\nlet (a, b, c) = t;          \u002F\u002F destructuring\nlet first = t.0;\nlet unit: () = ();           \u002F\u002F unit type, zero-sized\n",[51,366,364],{"__ignoreMap":148},[157,368,369,375,386],{},[160,370,371,372,198],{},"Single-element tuple: ",[51,373,374],{},"(x,)",[160,376,377,378,381,382,385],{},"The empty tuple ",[51,379,380],{},"()"," is the unit type (represents \"no meaningful value\", e.g., ",[51,383,384],{},"main","'s return type).",[160,387,388,391,392,394,395,397,398,401],{},[51,389,390],{},"0","-tuple ",[51,393,380],{}," is inhabited by exactly one value ",[51,396,380],{},". Useful as a ",[51,399,400],{},"HashMap"," value when you want a set.",[19,403,405],{"id":404},"arrays","Arrays",[210,407,408],{},"Fixed length, same type, stack-allocated:",[142,410,413],{"className":411,"code":412,"language":147,"meta":148},[145],"let arr: [i32; 3] = [1, 2, 3];\nlet zeros = [0; 100];        \u002F\u002F 100 zeros\nlet first = arr[0];\nlet slice = &arr[1..3];\n",[51,414,412],{"__ignoreMap":148},[157,416,417,427,434,440],{},[160,418,419,420,423,424,198],{},"Length is part of the type: ",[51,421,422],{},"[i32; 3]"," != ",[51,425,426],{},"[i32; 4]",[160,428,429,430,433],{},"Out-of-bounds indexing ",[164,431,432],{},"panics"," at runtime with bounds checking.",[160,435,436,439],{},[51,437,438],{},"arr.len()"," is a compile-time constant for arrays.",[160,441,442,443,446],{},"Arrays implement ",[51,444,445],{},"IntoIterator"," since edition 2021 (by value).",[19,448,450,451,180,454,297],{"id":449},"slices-t-mut-t","Slices (",[51,452,453],{},"&[T]",[51,455,456],{},"&mut [T]",[210,458,459],{},"Dynamically-sized view into a contiguous sequence (covered in the Slices chapter). The fat-pointer representation: (pointer, length).",[14,461,463],{"id":462},"strings-preview","Strings (preview)",[157,465,466,471,477],{},[160,467,468,470],{},[51,469,341],{}," — borrowed string slice, UTF-8, immutable view, fat pointer (ptr+len).",[160,472,473,476],{},[51,474,475],{},"String"," — owned, growable UTF-8 string (heap).",[160,478,479,320,482,484],{},[51,480,481],{},"&[u8]",[51,483,341],{},": bytes vs decoded text.",[142,486,489],{"className":487,"code":488,"language":147,"meta":148},[145],"let s: &str = \"hello\";\nlet owned: String = String::from(\"hello\");\nlet bytes: &[u8] = b\"hello\";        \u002F\u002F &[u8; 5] \u002F &[u8]\n",[51,490,488],{"__ignoreMap":148},[14,492,494],{"id":493},"function-types","Function Types",[142,496,499],{"className":497,"code":498,"language":147,"meta":148},[145],"fn add(a: i32, b: i32) -> i32 { a + b }\nlet f: fn(i32, i32) -> i32 = add;\n",[51,500,498],{"__ignoreMap":148},[210,502,503,504,507,508,511,512,515],{},"Function pointers (",[51,505,506],{},"fn(...) -> ...",") are zero-sized, ",[51,509,510],{},"Copy",", and implement ",[51,513,514],{},"Fn",". Closures have unnameable types (see Closures chapter).",[14,517,519,520,297],{"id":518},"never-type","Never Type (",[51,521,522],{},"!",[210,524,525,527,528,180,531,180,534,537,538,540],{},[51,526,522],{}," is the never type (diverges). Functions like ",[51,529,530],{},"panic!",[51,532,533],{},"loop {}",[51,535,536],{},"std::process::exit"," return ",[51,539,522],{},". It coerces to any type:",[142,542,545],{"className":543,"code":544,"language":147,"meta":148},[145],"let x: i32 = match opt {\n    Some(v) => v,\n    None => panic!(\"missing\"),   \u002F\u002F ! coerces to i32\n};\n",[51,546,544],{"__ignoreMap":148},[14,548,550],{"id":549},"type-aliases","Type Aliases",[142,552,555],{"className":553,"code":554,"language":147,"meta":148},[145],"type Kilometers = i32;\ntype IntPair = (i32, i32);\n",[51,556,554],{"__ignoreMap":148},[210,558,559],{},"Aliases are purely nominal — no new type, no methods, just a shorthand.",[14,561,563],{"id":562},"newtype-pattern-real-distinct-type","Newtype Pattern (real distinct type)",[142,565,568],{"className":566,"code":567,"language":147,"meta":148},[145],"struct Kilometers(i32);\nstruct Miles(i32);\n\u002F\u002F Kilometers and Miles are different types — no accidental mixing\n",[51,569,567],{"__ignoreMap":148},[210,571,572],{},"This is the idiomatic way to prevent unit confusion.",[14,574,576,577,297],{"id":575},"casting-as","Casting (",[51,578,279],{},[210,580,581,583],{},[51,582,279],{}," is a coarse numeric conversion (truncates, may wrap):",[142,585,588],{"className":586,"code":587,"language":147,"meta":148},[145],"let a = 1_000_000_000u32 as u8;     \u002F\u002F truncates -> 192 (low byte)\nlet f = 3.9_f32 as i32;             \u002F\u002F truncates toward zero -> 3\nlet b = true as u8;                 \u002F\u002F 1\nlet p = 42 as *const i32;\n",[51,589,587],{"__ignoreMap":148},[210,591,592,593,222,596,222,599,222,602,605],{},"Use ",[51,594,595],{},"From",[51,597,598],{},"Into",[51,600,601],{},"TryFrom",[51,603,604],{},"TryInto"," for safe, explicit conversions.",[14,607,609],{"id":608},"edge-cases","Edge Cases",[157,611,612,629,639,660,685,702,716,729,740],{},[160,613,614,617,618,621,622,624,625,628],{},[164,615,616],{},"Default int",": ",[51,619,620],{},"let x = 1;"," → ",[51,623,85],{},". In a ",[51,626,627],{},"match"," arm that returns an integer, the inferred type can leak across arms.",[160,630,631,617,634,621,637,198],{},[164,632,633],{},"Default float",[51,635,636],{},"let x = 1.0;",[51,638,217],{},[160,640,641,617,644,647,648,650,651,653,654,184,657,659],{},[164,642,643],{},"Char to int",[51,645,646],{},"'A' as u32"," → 65 (Unicode code point). ",[51,649,88],{}," to ",[51,652,296],{}," needs ",[51,655,656],{},"char::from_u32",[51,658,187],{},", since not all u32 are valid chars).",[160,661,662,617,668,671,672,675,676,678,679,681,682,684],{},[164,663,664,667],{},[51,665,666],{},"Vec"," of arrays",[51,669,670],{},"vec![[0; 3]; 4]"," works; ",[51,673,674],{},"vec![[1,2,3]; 4]"," requires ",[51,677,510],{}," (arrays of ",[51,680,510],{}," are ",[51,683,510],{},").",[160,686,687,617,690,180,692,180,695,697,698,701],{},[164,688,689],{},"Zero-sized types (ZSTs)",[51,691,380],{},[51,693,694],{},"struct Empty;",[51,696,694],{}," occupy 0 bytes; ",[51,699,700],{},"Vec\u003C()>"," is effectively a counter.",[160,703,704,710,711,222,713,715],{},[164,705,706,222,708],{},[51,707,131],{},[51,709,134],{}," change with platform — don't rely on width in serialized data; use ",[51,712,101],{},[51,714,104],{}," explicitly.",[160,717,718,617,721,724,725,728],{},[164,719,720],{},"Integer literals overflow in source",[51,722,723],{},"let x: u8 = 255;"," is fine, but ",[51,726,727],{},"let x: u8 = 256;"," is a compile error.",[160,730,731,736,737,739],{},[164,732,733,735],{},[51,734,296],{}," size",": always 4 bytes even for ASCII; for ASCII use ",[51,738,57],{}," if memory matters.",[160,741,742,750],{},[164,743,744,746,747],{},[51,745,279],{}," with ",[51,748,749],{},"f64::NAN as i32"," → 0 (platform-defined, not reliable).",[14,752,754],{"id":753},"summary","Summary",[210,756,757,758,760],{},"You know the primitives, integers\u002Foverflow, floats\u002FNaN, tuples, arrays, and the distinction between ",[51,759,296],{}," and bytes. Next: functions.",{"title":148,"searchDepth":762,"depth":762,"links":763},2,[764,772,778,779,780,782,783,784,786,787],{"id":16,"depth":762,"text":17,"children":765},[766,768,769,770],{"id":21,"depth":767,"text":22},3,{"id":207,"depth":767,"text":208},{"id":262,"depth":767,"text":263},{"id":292,"depth":767,"text":771},"Characters (char)",{"id":352,"depth":762,"text":353,"children":773},[774,775,776],{"id":356,"depth":767,"text":357},{"id":404,"depth":767,"text":405},{"id":449,"depth":767,"text":777},"Slices (&[T], &mut [T])",{"id":462,"depth":762,"text":463},{"id":493,"depth":762,"text":494},{"id":518,"depth":762,"text":781},"Never Type (!)",{"id":549,"depth":762,"text":550},{"id":562,"depth":762,"text":563},{"id":575,"depth":762,"text":785},"Casting (as)",{"id":608,"depth":762,"text":609},{"id":753,"depth":762,"text":754},"md",{},true,"\u002Frust\u002F04-data-types",{"title":5,"description":148},"rust\u002F04-data-types","RAixSW-_DOpeDb7gA4oLO5bqvFNJYSj5hMhBHw3Unxs",1785935255228]