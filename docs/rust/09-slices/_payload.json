[{"data":1,"prerenderedAt":482},["ShallowReactive",2],{"page-\u002Frust\u002F09-slices":3},{"id":4,"title":5,"body":6,"description":474,"extension":475,"meta":476,"navigation":477,"path":478,"seo":479,"stem":480,"__hash__":481},"content\u002Frust\u002F09-slices.md","09 — Slices",{"type":7,"value":8,"toc":455},"minimark",[9,13,22,27,38,57,64,69,75,79,129,135,146,152,163,169,173,179,188,207,211,217,220,224,230,236,240,246,265,269,278,284,289,298,304,310,314,412,416,422,426,452],[10,11,5],"h1",{"id":12},"_09-slices",[14,15,16,17,21],"p",{},"A slice is a ",[18,19,20],"strong",{},"borrowed view"," into a contiguous sequence of elements. It's the most common way to pass \"a chunk of data\" without taking ownership.",[23,24,26],"h2",{"id":25},"the-slice-type","The Slice Type",[28,29,35],"pre",{"className":30,"code":32,"language":33,"meta":34},[31],"language-rust","let arr = [1, 2, 3, 4, 5];\nlet s: &[i32] = &arr;          \u002F\u002F slice of the whole array\nlet part: &[i32] = &arr[1..4]; \u002F\u002F [2, 3, 4]\n","rust","",[36,37,32],"code",{"__ignoreMap":34},[14,39,40,41,44,45,48,49,52,53,56],{},"A slice ",[36,42,43],{},"&[T]"," is a ",[18,46,47],{},"fat pointer",": ",[36,50,51],{},"(pointer, length)",". Two ",[36,54,55],{},"usize"," worth of data on the stack. No ownership of the underlying elements.",[23,58,60,61],{"id":59},"string-slices-str","String Slices ",[36,62,63],{},"&str",[14,65,66,68],{},[36,67,63],{}," is a slice of UTF-8 bytes — same fat-pointer layout but with the UTF-8 invariant:",[28,70,73],{"className":71,"code":72,"language":33,"meta":34},[31],"let s = String::from(\"hello, world\");\nlet hello: &str = &s[0..5];     \u002F\u002F \"hello\"\nlet world: &s[7..12];            \u002F\u002F \"world\"\nlet whole: &str = &s[..];        \u002F\u002F whole string\n",[36,74,72],{"__ignoreMap":34},[23,76,78],{"id":77},"indexing-rules","Indexing Rules",[80,81,82,106,112,119],"ul",{},[83,84,85,88,89,92,93,88,96,92,99,88,102,105],"li",{},[36,86,87],{},"..n"," = ",[36,90,91],{},"0..n","; ",[36,94,95],{},"n..",[36,97,98],{},"n..len",[36,100,101],{},"..",[36,103,104],{},"0..len",".",[83,107,108,111],{},[36,109,110],{},"..=k"," is inclusive.",[83,113,114,115,118],{},"Out-of-bounds slicing ",[18,116,117],{},"panics"," at runtime.",[83,120,121,122,125,126,128],{},"Slicing on a ",[18,123,124],{},"non-char boundary"," in a ",[36,127,63],{}," panics:",[28,130,133],{"className":131,"code":132,"language":33,"meta":34},[31],"let s = \"hi🦀\";  \u002F\u002F '🦀' is 4 bytes\nlet bad = &s[2..4];   \u002F\u002F PANIC: byte index 2 is not a char boundary\n",[36,134,132],{"__ignoreMap":34},[14,136,137,138,141,142,145],{},"To slice by char, use ",[36,139,140],{},".chars()"," \u002F ",[36,143,144],{},".char_indices()",":",[28,147,150],{"className":148,"code":149,"language":33,"meta":34},[31],"let first_char_str: &str = s.split(0).next().unwrap();\n",[36,151,149],{"__ignoreMap":34},[14,153,154,155,158,159,162],{},"Wait — ",[36,156,157],{},"str::split"," splits on a pattern. Use ",[36,160,161],{},"char_indices"," for safety:",[28,164,167],{"className":165,"code":166,"language":33,"meta":34},[31],"let bytes_to = s.char_indices().nth(1).map(|(i, _)| i).unwrap();\nlet first: &str = &s[..bytes_to];\n",[36,168,166],{"__ignoreMap":34},[23,170,172],{"id":171},"creating-slices","Creating Slices",[28,174,177],{"className":175,"code":176,"language":33,"meta":34},[31],"\u002F\u002F From Vec\nlet v = vec![1, 2, 3];\nlet s = &v[..];\nlet s = v.as_slice();\n\n\u002F\u002F From array\nlet a = [1, 2, 3];\nlet s = &a[..];\n\n\u002F\u002F From String\nlet st = String::from(\"hi\");\nlet s: &str = &st[..];\nlet s: &str = st.as_str();\n\n\u002F\u002F From raw parts (unsafe)\nlet s: &[u8] = unsafe { std::slice::from_raw_parts(ptr, len) };\n",[36,178,176],{"__ignoreMap":34},[23,180,182,184,185],{"id":181},"t-vs-t-n",[36,183,43],{}," vs ",[36,186,187],{},"&[T; N]",[80,189,190,195,200],{},[83,191,192,194],{},[36,193,43],{}," is the slice type (dynamically sized).",[83,196,197,199],{},[36,198,187],{}," is a reference to a fixed-size array (size known at compile time).",[83,201,202,204,205,105],{},[36,203,187],{}," coerces to ",[36,206,43],{},[23,208,210],{"id":209},"mutable-slices","Mutable Slices",[28,212,215],{"className":213,"code":214,"language":33,"meta":34},[31],"let mut v = vec![1, 2, 3];\nlet s: &mut [i32] = &mut v[..];\ns[0] = 99;\n",[36,216,214],{"__ignoreMap":34},[14,218,219],{},"One mutable slice at a time (borrow rules still apply).",[23,221,223],{"id":222},"splitting-slices","Splitting Slices",[28,225,228],{"className":226,"code":227,"language":33,"meta":34},[31],"let (left, right) = s.split_first();   \u002F\u002F Option\u003C(&T, &[T])>\nlet (mut_left, mut_right) = s.split_at_mut(2);   \u002F\u002F (&mut [T], &mut [T])\n",[36,229,227],{"__ignoreMap":34},[14,231,232,235],{},[36,233,234],{},"split_at_mut"," is the canonical way to get two non-overlapping mutable subslices — the compiler can't otherwise prove disjointness.",[23,237,239],{"id":238},"iteration","Iteration",[28,241,244],{"className":242,"code":243,"language":33,"meta":34},[31],"for x in &arr { \u002F* x: &i32 *\u002F }\nfor x in &mut arr { \u002F* x: &mut i32 *\u002F }\nfor x in arr { \u002F* x: i32 — consumes (Copy ok) *\u002F }\n",[36,245,243],{"__ignoreMap":34},[14,247,248,250,251,254,255,258,259,141,262,105],{},[36,249,43],{}," and ",[36,252,253],{},"&mut [T]"," implement ",[36,256,257],{},"IntoIterator"," yielding ",[36,260,261],{},"&T",[36,263,264],{},"&mut T",[23,266,268],{"id":267},"why-slices-matter-for-apis","Why Slices Matter for APIs",[14,270,271,272,274,275,145],{},"Take ",[36,273,43],{}," not ",[36,276,277],{},"&Vec\u003CT>",[28,279,282],{"className":280,"code":281,"language":33,"meta":34},[31],"fn sum(nums: &[i32]) -> i32 {\n    nums.iter().sum()\n}\nsum(&vec![1, 2, 3]);\nsum(&[1, 2, 3]);\nsum(&arr);            \u002F\u002F works for arrays too\n",[36,283,281],{"__ignoreMap":34},[14,285,286,288],{},[36,287,43],{}," is the most general borrowed form.",[23,290,292,184,294,297],{"id":291},"str-vs-string-api-choice",[36,293,63],{},[36,295,296],{},"String"," API Choice",[28,299,302],{"className":300,"code":301,"language":33,"meta":34},[31],"fn print(s: &str) { println!(\"{s}\"); }\nprint(\"literal\");          \u002F\u002F &str\nprint(&owned_string);      \u002F\u002F &String -> &str\nprint(&substring);         \u002F\u002F &str\n",[36,303,301],{"__ignoreMap":34},[14,305,306,307,309],{},"Always prefer ",[36,308,63],{}," in function parameters unless you need to grow the string.",[23,311,313],{"id":312},"edge-cases","Edge Cases",[80,315,316,325,334,352,364,374,385],{},[83,317,318,48,321,324],{},[18,319,320],{},"Empty slice",[36,322,323],{},"&arr[0..0]"," is valid, length 0; never panics.",[83,326,327,48,330,333],{},[18,328,329],{},"Slicing past end",[36,331,332],{},"&v[..v.len() + 1]"," panics.",[83,335,336,344,345,141,348,351],{},[18,337,338,141,341],{},[36,339,340],{},"slice.get(i)",[36,342,343],{},"slice.get_mut(i)",": returns ",[36,346,347],{},"Option\u003C&T>",[36,349,350],{},"Option\u003C&mut T>"," — non-panicking indexing.",[83,353,354,359,360,363],{},[18,355,356],{},[36,357,358],{},"slice.get_unchecked(i)",": unsafe — skips bounds check (only correct when you've proven ",[36,361,362],{},"i \u003C len",").",[83,365,366,369,370,373],{},[18,367,368],{},"Range patterns",": limited; stable Rust allows ",[36,371,372],{},"[a, b, ..]"," only in limited forms.",[83,375,376,381,382,105],{},[18,377,378],{},[36,379,380],{},"Vec::drain",": takes a range, removes and returns an iterator — modifies the ",[36,383,384],{},"Vec",[83,386,387,390,391,394,395,397,398,400,401,404,405,408,409,363],{},[18,388,389],{},"String slicing pitfall",": indexing ",[36,392,393],{},"s[i]"," is intentionally not allowed for ",[36,396,296],{},"\u002F",[36,399,63],{}," because UTF-8 byte indexing is meaningless. Use ",[36,402,403],{},"s.chars().nth(i)"," or ",[36,406,407],{},"s.as_bytes()[i]"," (returns ",[36,410,411],{},"u8",[23,413,415],{"id":414},"slice-methods-cheat-sheet","Slice Methods Cheat Sheet",[28,417,420],{"className":418,"code":419,"language":33,"meta":34},[31],"s.len();\ns.is_empty();\ns.first();             \u002F\u002F Option\u003C&T>\ns.last();\ns.split_first();       \u002F\u002F Option\u003C(&T, &[T])>\ns.iter() \u002F s.iter_mut();\ns.windows(2);          \u002F\u002F sliding windows\ns.chunks(3);           \u002F\u002F non-overlapping chunks\ns.chunks_exact(3);\ns.split(|x| *x == 0);\ns.splitn(2, |x| *x == 0);\ns.contains(&3);\ns.starts_with(&[1, 2]);\ns.ends_with(&[4, 5]);\ns.iter().position(|x| *x == 3);\ns.binary_search(&3);\ns.sort();\ns.sort_by(|a, b| b.cmp(a));\ns.sort_by_key(|x| x.abs());\ns.reverse();\ns.rotate_left(1);\ns.copy_within(0..3, 5);\ns.fill(0);\n",[36,421,419],{"__ignoreMap":34},[23,423,425],{"id":424},"summary","Summary",[80,427,428,431,439,447],{},[83,429,430],{},"Slices are borrowed, fat-pointer views into contiguous data.",[83,432,433,435,436,438],{},[36,434,63],{}," is a UTF-8 slice; ",[36,437,43],{}," is a generic slice.",[83,440,441,442,141,444,446],{},"Use ",[36,443,43],{},[36,445,63],{}," in APIs for maximum generality.",[83,448,449,450,105],{},"Split at mutable boundaries with ",[36,451,234],{},[14,453,454],{},"Next: Lifetimes — the borrow checker's vocabulary.",{"title":34,"searchDepth":456,"depth":456,"links":457},2,[458,459,461,462,463,465,466,467,468,469,471,472,473],{"id":25,"depth":456,"text":26},{"id":59,"depth":456,"text":460},"String Slices &str",{"id":77,"depth":456,"text":78},{"id":171,"depth":456,"text":172},{"id":181,"depth":456,"text":464},"&[T] vs &[T; N]",{"id":209,"depth":456,"text":210},{"id":222,"depth":456,"text":223},{"id":238,"depth":456,"text":239},{"id":267,"depth":456,"text":268},{"id":291,"depth":456,"text":470},"&str vs String API Choice",{"id":312,"depth":456,"text":313},{"id":414,"depth":456,"text":415},{"id":424,"depth":456,"text":425},"A slice is a borrowed view into a contiguous sequence of elements. It's the most common way to pass \"a chunk of data\" without taking ownership.","md",{},true,"\u002Frust\u002F09-slices",{"title":5,"description":474},"rust\u002F09-slices","1R8fuiHDUpQ-fyd-6eSrHqc5lkTIAkwu-dlN3gKRYYE",1785934755595]