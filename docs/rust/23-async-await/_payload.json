[{"data":1,"prerenderedAt":822},["ShallowReactive",2],{"page-\u002Frust\u002F23-async-await":3},{"id":4,"title":5,"body":6,"description":814,"extension":815,"meta":816,"navigation":817,"path":818,"seo":819,"stem":820,"__hash__":821},"content\u002Frust\u002F23-async-await.md","23 — Async \u002F Await",{"type":7,"value":8,"toc":779},"minimark",[9,13,22,27,38,49,54,60,66,70,76,86,90,97,129,135,145,149,155,180,184,190,200,206,214,220,238,248,251,257,262,268,274,277,281,323,327,333,344,350,353,359,370,374,380,397,401,417,423,429,434,437,443,446,453,459,479,483,494,498,509,513,519,536,540,548,554,557,563,569,578,584,590,593,597,714,718,743,747,776],[10,11,5],"h1",{"id":12},"_23-async-await",[14,15,16,17,21],"p",{},"Async lets you write concurrent code that looks sequential. Rust's async is ",[18,19,20],"strong",{},"zero-cost"," — futures are state machines compiled by the compiler.",[23,24,26],"h2",{"id":25},"async-functions","Async Functions",[28,29,35],"pre",{"className":30,"code":32,"language":33,"meta":34},[31],"language-rust","async fn fetch(url: &str) -> String {\n    \u002F\u002F ... await something ...\n    String::from(\"data\")\n}\n","rust","",[36,37,32],"code",{"__ignoreMap":34},[14,39,40,41,44,45,48],{},"Calling ",[36,42,43],{},"fetch(...)"," returns a ",[18,46,47],{},"future",", not a value. The body doesn't run until the future is polled.",[23,50,52],{"id":51},"await",[36,53,51],{},[28,55,58],{"className":56,"code":57,"language":33,"meta":34},[31],"let s = fetch(\"https:\u002F\u002Fx\").await;\n",[36,59,57],{"__ignoreMap":34},[14,61,62,65],{},[36,63,64],{},".await"," yields control to the executor if the future is pending. The current task is suspended and later resumed.",[23,67,69],{"id":68},"async-is-lazy","Async Is Lazy",[28,71,74],{"className":72,"code":73,"language":33,"meta":34},[31],"let f = async { println!(\"hi\"); };\n\u002F\u002F nothing happens yet\nf.await;   \u002F\u002F body runs now\n",[36,75,73],{"__ignoreMap":34},[14,77,78,79,81,82,85],{},"You must ",[36,80,64],{}," (or ",[36,83,84],{},"spawn",") a future for it to make progress.",[23,87,89],{"id":88},"runtimes","Runtimes",[14,91,92,93,96],{},"Rust ships ",[18,94,95],{},"no built-in async runtime"," — you choose one:",[98,99,100,107,113,119],"ul",{},[101,102,103,106],"li",{},[36,104,105],{},"tokio",": most popular, multi-threaded scheduler, mature ecosystem.",[101,108,109,112],{},[36,110,111],{},"async-std",": mirrors std API, single-threaded by default.",[101,114,115,118],{},[36,116,117],{},"smol",": small, simple.",[101,120,121,124,125,128],{},[36,122,123],{},"embassy",": embedded (",[36,126,127],{},"no_std",").",[28,130,133],{"className":131,"code":132,"language":33,"meta":34},[31],"#[tokio::main]\nasync fn main() {\n    println!(\"hello from tokio\");\n}\n",[36,134,132],{"__ignoreMap":34},[14,136,137,140,141,144],{},[36,138,139],{},"tokio::main"," builds a runtime and runs your async ",[36,142,143],{},"main",".",[23,146,148],{"id":147},"spawning-tasks","Spawning Tasks",[28,150,153],{"className":151,"code":152,"language":33,"meta":34},[31],"#[tokio::main]\nasync fn main() {\n    let h = tokio::spawn(async {\n        5\n    });\n    let n: i32 = h.await.unwrap();\n    println!(\"{n}\");\n}\n",[36,154,152],{"__ignoreMap":34},[98,156,157,165,171],{},[101,158,159,44,162,144],{},[36,160,161],{},"tokio::spawn",[36,163,164],{},"JoinHandle\u003CT>",[101,166,167,168,144],{},"Spawned tasks must be ",[36,169,170],{},"Send + 'static",[101,172,173,175,176,179],{},[36,174,64],{}," on the handle gives ",[36,177,178],{},"Result\u003CT, JoinError>"," (panic propagates).",[23,181,183],{"id":182},"futures","Futures",[28,185,188],{"className":186,"code":187,"language":33,"meta":34},[31],"trait Future {\n    type Output;\n    fn poll(self: Pin\u003C&mut Self>, cx: &mut Context) -> Poll\u003CSelf::Output>;\n}\n\nenum Poll\u003CT> { Ready(T), Pending }\n",[36,189,187],{"__ignoreMap":34},[14,191,192,193,196,197,199],{},"You rarely implement ",[36,194,195],{},"Future"," manually. Async functions desugar to anonymous ",[36,198,195],{},"-implementing state machines.",[23,201,203],{"id":202},"pin",[36,204,205],{},"Pin",[14,207,208,210,211,213],{},[36,209,205],{}," guarantees a value won't be moved in memory. Required because self-referential futures (which reference their own stack across ",[36,212,64],{},") would break if moved.",[28,215,218],{"className":216,"code":217,"language":33,"meta":34},[31],"let mut fut = async { 5 };\nlet pinned: Pin\u003C&mut _> = Pin::new(&mut fut);\n",[36,219,217],{"__ignoreMap":34},[14,221,222,223,225,226,229,230,233,234,237],{},"You mostly encounter ",[36,224,205],{}," in trait signatures and APIs (e.g., ",[36,227,228],{},"Future::poll","). The ",[36,231,232],{},"pin-utils"," or ",[36,235,236],{},"Box::pin"," handle the common cases.",[23,239,241,244,245],{"id":240},"boxdyn-future-and-pinboxdyn-future",[36,242,243],{},"Box\u003Cdyn Future>"," and ",[36,246,247],{},"Pin\u003CBox\u003Cdyn Future>>",[14,249,250],{},"Because futures have unique unnameable types, storing them in collections or returning them generically requires boxing:",[28,252,255],{"className":253,"code":254,"language":33,"meta":34},[31],"fn make_fut() -> Pin\u003CBox\u003Cdyn Future\u003COutput = i32> + Send>> {\n    Box::pin(async { 5 })\n}\n",[36,256,254],{"__ignoreMap":34},[14,258,259,261],{},[36,260,247],{}," is the trait-object form of a future.",[23,263,265],{"id":264},"impl-future",[36,266,267],{},"impl Future",[28,269,272],{"className":270,"code":271,"language":33,"meta":34},[31],"fn make_fut() -> impl Future\u003COutput = i32> {\n    async { 5 }\n}\n",[36,273,271],{"__ignoreMap":34},[14,275,276],{},"Returns a concrete future type, hidden. Single type per return site.",[23,278,280],{"id":279},"common-async-crates","Common Async Crates",[98,282,283,288,293,299,305,311,317],{},[101,284,285,287],{},[36,286,105],{}," — runtime, I\u002FO, networking, synchronization.",[101,289,290,292],{},[36,291,182],{}," — combinators, streams, sinks.",[101,294,295,298],{},[36,296,297],{},"async-trait"," — async functions in traits (until native support stabilizes; partial in 1.75+).",[101,300,301,304],{},[36,302,303],{},"reqwest"," — HTTP client.",[101,306,307,310],{},[36,308,309],{},"hyper"," — HTTP server\u002Fclient.",[101,312,313,316],{},[36,314,315],{},"sqlx"," — async DB.",[101,318,319,322],{},[36,320,321],{},"axum"," — web framework (tokio-based).",[23,324,326],{"id":325},"async-io","Async IO",[28,328,331],{"className":329,"code":330,"language":33,"meta":34},[31],"use tokio::fs;\n#[tokio::main]\nasync fn main() -> std::io::Result\u003C()> {\n    let s = fs::read_to_string(\"file.txt\").await?;\n    println!(\"{s}\");\n    Ok(())\n}\n",[36,332,330],{"__ignoreMap":34},[14,334,335,336,339,340,343],{},"Async ",[36,337,338],{},"read","\u002F",[36,341,342],{},"write"," yield when the syscall would block. The runtime parks the task and wakes it when the OS signals readiness.",[23,345,347],{"id":346},"tokioselect",[36,348,349],{},"tokio::select!",[14,351,352],{},"Race multiple futures, take the first to complete:",[28,354,357],{"className":355,"code":356,"language":33,"meta":34},[31],"tokio::select! {\n    v = first_future() => println!(\"first: {v}\"),\n    _ = tokio::time::sleep(Duration::from_secs(1)) => println!(\"timeout\"),\n}\n",[36,358,356],{"__ignoreMap":34},[14,360,361,362,365,366,369],{},"Unselected branches are dropped. Use ",[36,363,364],{},"biased"," for ordering, or branch with ",[36,367,368],{},"&mut"," futures to reuse them.",[23,371,373],{"id":372},"streams-async-iterators","Streams (Async Iterators)",[28,375,378],{"className":376,"code":377,"language":33,"meta":34},[31],"use futures::stream::{self, StreamExt};\n\nlet mut s = stream::iter(vec![1, 2, 3]).map(|x| x * 2);\nwhile let Some(v) = s.next().await {\n    println!(\"{v}\");\n}\n",[36,379,377],{"__ignoreMap":34},[14,381,382,385,386,389,390,339,393,396],{},[36,383,384],{},"StreamExt::next().await"," is the async equivalent of ",[36,387,388],{},"Iterator::next()",". ",[36,391,392],{},"try_stream",[36,394,395],{},"tokio_stream"," for building streams.",[23,398,400],{"id":399},"channels","Channels",[14,402,403,406,407,406,410,406,413,416],{},[36,404,405],{},"tokio::sync::mpsc",", ",[36,408,409],{},"tokio::sync::broadcast",[36,411,412],{},"tokio::sync::oneshot",[36,414,415],{},"tokio::sync::watch",":",[28,418,421],{"className":419,"code":420,"language":33,"meta":34},[31],"let (tx, mut rx) = tokio::sync::mpsc::channel(100);\ntokio::spawn(async move {\n    tx.send(5).await.unwrap();\n});\nlet v = rx.recv().await;\n",[36,422,420],{"__ignoreMap":34},[14,424,425,426,428],{},"Async channels ",[36,427,64],{}," on send\u002Frecv instead of blocking.",[23,430,432],{"id":431},"spawn_blocking",[36,433,431],{},[14,435,436],{},"For CPU-bound work or blocking syscalls inside async code:",[28,438,441],{"className":439,"code":440,"language":33,"meta":34},[31],"let v = tokio::task::spawn_blocking(|| {\n    cpu_heavy_computation()\n}).await.unwrap();\n",[36,442,440],{"__ignoreMap":34},[14,444,445],{},"Offloads work to a separate thread pool so the async executor isn't blocked.",[23,447,449,450,452],{"id":448},"holding-locks-across-await-pitfall","Holding Locks Across ",[36,451,64],{}," — Pitfall",[28,454,457],{"className":455,"code":456,"language":33,"meta":34},[31],"\u002F\u002F BAD: holding std Mutex across await can deadlock \u002F block executor\nlet guard = std_mutex.lock().unwrap();\nsome_async().await;     \u002F\u002F ⚠️ guard held\n\u002F\u002F GOOD:\nlet val = {\n    let g = std_mutex.lock().unwrap();\n    g.clone()\n};\nsome_async(val).await;\n\n\u002F\u002F OR use tokio's async Mutex:\nlet guard = tokio_mutex.lock().await;\nsome_async().await;\n",[36,458,456],{"__ignoreMap":34},[14,460,461,464,465,469,470,472,473,475,476,144],{},[36,462,463],{},"std::sync::Mutex"," is fine ",[466,467,468],"em",{},"within"," an async function if released before ",[36,471,64],{},". For locks held across ",[36,474,64],{},", use ",[36,477,478],{},"tokio::sync::Mutex",[23,480,482],{"id":481},"canceling-futures","Canceling Futures",[14,484,485,486,489,490,493],{},"Dropping a future cancels it. The ",[36,487,488],{},"select!"," drop semantics mean unselected branches are canceled. Use ",[36,491,492],{},"CancellationToken"," for cooperative cancellation.",[23,495,497],{"id":496},"backpressure","Backpressure",[14,499,500,501,504,505,508],{},"Use bounded channels (",[36,502,503],{},"mpsc::channel(n)","). ",[36,506,507],{},".send().await"," blocks when full, naturally propagating backpressure to producers.",[23,510,512],{"id":511},"async-traits-175","Async Traits (1.75+)",[28,514,517],{"className":515,"code":516,"language":33,"meta":34},[31],"trait Service {\n    async fn call(&self, req: Request) -> Response;\n}\n",[36,518,516],{"__ignoreMap":34},[14,520,521,522,525,526,529,530,532,533,535],{},"Native async traits stabilized in 1.75 with limitations (no ",[36,523,524],{},"dyn"," dispatch without ",[36,527,528],{},"#[async_trait]"," crate, no recursion in some cases). For full features including ",[36,531,524],{},", use the ",[36,534,297],{}," crate.",[23,537,539],{"id":538},"common-patterns","Common Patterns",[541,542,544,545],"h3",{"id":543},"concurrency-with-join","Concurrency with ",[36,546,547],{},"join!",[28,549,552],{"className":550,"code":551,"language":33,"meta":34},[31],"let (a, b, c) = tokio::join!(fa(), fb(), fc());\n",[36,553,551],{"__ignoreMap":34},[14,555,556],{},"Runs all three concurrently, waits for all, returns a tuple.",[541,558,544,560],{"id":559},"concurrency-with-try_join",[36,561,562],{},"try_join!",[28,564,567],{"className":565,"code":566,"language":33,"meta":34},[31],"let (a, b) = tokio::try_join!(fa(), fb())?;\n",[36,568,566],{"__ignoreMap":34},[14,570,571,572,574,575,144],{},"Like ",[36,573,547],{}," but short-circuits on ",[36,576,577],{},"Err",[541,579,581],{"id":580},"futuresunordered",[36,582,583],{},"FuturesUnordered",[28,585,588],{"className":586,"code":587,"language":33,"meta":34},[31],"use futures::stream::FuturesUnordered;\nlet mut futs = FuturesUnordered::new();\nfuts.push(fa());\nfuts.push(fb());\nwhile let Some(r) = futs.next().await { \u002F* ... *\u002F }\n",[36,589,587],{"__ignoreMap":34},[14,591,592],{},"Spawn N futures, await results as they complete (unordered).",[23,594,596],{"id":595},"common-pitfalls","Common Pitfalls",[98,598,599,615,623,632,645,667,675,688,700],{},[101,600,601,610,611,233,613,144],{},[18,602,603,605,606,609],{},[36,604,64],{}," in a ",[36,607,608],{},"for"," loop over a sync iterator",": fine; just don't accidentally serialize tasks you wanted to run concurrently — use ",[36,612,547],{},[36,614,84],{},[101,616,617,622],{},[18,618,619,620],{},"Forgetting to ",[36,621,51],{},": the future is created but never runs — silent bug.",[101,624,625,631],{},[18,626,627,630],{},[36,628,629],{},"async fn"," in a trait"," still has rough edges; check current support.",[101,633,634,637,638,244,641,644],{},[18,635,636],{},"Runtime-locked I\u002FO",": mixing ",[36,639,640],{},"tokio::fs",[36,642,643],{},"async-std::fs"," is fine functionally but wasteful; pick one runtime's I\u002FO.",[101,646,647,653,654,656,657,659,660,663,664,666],{},[18,648,649,652],{},[36,650,651],{},"Send"," futures",": futures that hold non-",[36,655,651],{}," types across ",[36,658,64],{}," are ",[36,661,662],{},"!Send"," and can't be ",[36,665,161],{},"ed.",[101,668,669,672,673,144],{},[18,670,671],{},"Long-running blocking code in async",": blocks the executor. Use ",[36,674,431],{},[101,676,677,683,684,687],{},[18,678,679,680,682],{},"Memory leaks with ",[36,681,488],{}," loops",": each iteration may allocate. Use ",[36,685,686],{},"pin_mut!"," or pinned variables.",[101,689,690,695,696,699],{},[18,691,692,694],{},[36,693,139],{}," flavor",": ",[36,697,698],{},"#[tokio::main(flavor = \"current_thread\")]"," is single-threaded (less overhead). Default is multi-threaded.",[101,701,702,708,709,711,712,144],{},[18,703,704,707],{},[36,705,706],{},"Drop"," cancels futures",": a future dropped mid-",[36,710,51],{}," is silently canceled; resources are cleaned up via ",[36,713,706],{},[23,715,717],{"id":716},"when-to-use-async","When to Use Async",[98,719,720,723,726,732],{},[101,721,722],{},"Many concurrent I\u002FO-bound tasks (HTTP servers, proxies, scrapers).",[101,724,725],{},"Latency-sensitive workloads with lots of waiting.",[101,727,728,729,144],{},"Avoid for CPU-bound work — use threads or ",[36,730,731],{},"rayon",[101,733,734,735,737,738,740,741,128],{},"Avoid in ",[36,736,127],{},"\u002Fembedded unless using a ",[36,739,127],{},"-friendly runtime (",[36,742,123],{},[23,744,746],{"id":745},"summary","Summary",[14,748,749,750,752,753,755,756,758,759,761,762,339,764,766,767,769,770,772,773,775],{},"Async is lazy (futures are polled); runtimes drive them. ",[36,751,105],{}," is the dominant runtime. ",[36,754,51],{}," yields control; ",[36,757,84],{}," schedules tasks. ",[36,760,488],{}," races; ",[36,763,547],{},[36,765,562],{}," runs concurrently. Use async-aware channels and locks. Beware holding ",[36,768,463],{}," across ",[36,771,64],{},". Use ",[36,774,431],{}," for CPU work or blocking calls.",[14,777,778],{},"Next: Macros — code that writes code.",{"title":34,"searchDepth":780,"depth":780,"links":781},2,[782,783,784,785,786,787,788,789,791,792,793,794,795,796,797,798,800,801,802,803,811,812,813],{"id":25,"depth":780,"text":26},{"id":51,"depth":780,"text":51},{"id":68,"depth":780,"text":69},{"id":88,"depth":780,"text":89},{"id":147,"depth":780,"text":148},{"id":182,"depth":780,"text":183},{"id":202,"depth":780,"text":205},{"id":240,"depth":780,"text":790},"Box\u003Cdyn Future> and Pin\u003CBox\u003Cdyn Future>>",{"id":264,"depth":780,"text":267},{"id":279,"depth":780,"text":280},{"id":325,"depth":780,"text":326},{"id":346,"depth":780,"text":349},{"id":372,"depth":780,"text":373},{"id":399,"depth":780,"text":400},{"id":431,"depth":780,"text":431},{"id":448,"depth":780,"text":799},"Holding Locks Across .await — Pitfall",{"id":481,"depth":780,"text":482},{"id":496,"depth":780,"text":497},{"id":511,"depth":780,"text":512},{"id":538,"depth":780,"text":539,"children":804},[805,808,810],{"id":543,"depth":806,"text":807},3,"Concurrency with join!",{"id":559,"depth":806,"text":809},"Concurrency with try_join!",{"id":580,"depth":806,"text":583},{"id":595,"depth":780,"text":596},{"id":716,"depth":780,"text":717},{"id":745,"depth":780,"text":746},"Async lets you write concurrent code that looks sequential. Rust's async is zero-cost — futures are state machines compiled by the compiler.","md",{},true,"\u002Frust\u002F23-async-await",{"title":5,"description":814},"rust\u002F23-async-await","IiBldr5YM-nmjZESo61RiAuSxeeLDh_acJt7BUTff5w",1785935255232]