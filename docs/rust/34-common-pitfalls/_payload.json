[{"data":1,"prerenderedAt":1072},["ShallowReactive",2],{"page-\u002Frust\u002F34-common-pitfalls":3},{"id":4,"title":5,"body":6,"description":16,"extension":1065,"meta":1066,"navigation":1067,"path":1068,"seo":1069,"stem":1070,"__hash__":1071},"content\u002Frust\u002F34-common-pitfalls.md","34 — Common Pitfalls & Idiomatic Fixes",{"type":7,"value":8,"toc":978},"minimark",[9,13,17,22,27,38,42,48,55,59,65,68,72,75,83,87,93,99,103,109,117,120,126,140,151,157,181,189,195,204,208,214,221,229,235,243,249,257,263,273,277,283,293,297,303,314,322,327,333,340,353,365,371,378,384,391,397,408,420,431,447,457,463,470,478,484,490,500,507,513,521,527,536,544,550,559,570,576,579,587,593,603,610,616,625,638,655,663,669,676,682,689,695,705,713,721,735,745,752,762,781,789,797,803,811,822,828,839,847,856,860,863,869,879,883,890,897,904,908,975],[10,11,5],"h1",{"id":12},"_34-common-pitfalls-idiomatic-fixes",[14,15,16],"p",{},"A checklist of mistakes every Rust developer makes — and the idiomatic fix for each.",[18,19,21],"h2",{"id":20},"_1-fighting-the-borrow-checker","1. Fighting the Borrow Checker",[23,24,26],"h3",{"id":25},"symptom-cannot-borrow-as-mutable-because-it-is-also-borrowed-as-immutable","Symptom: \"cannot borrow as mutable because it is also borrowed as immutable\"",[28,29,35],"pre",{"className":30,"code":32,"language":33,"meta":34},[31],"language-rust","\u002F\u002F Bad\nlet mut v = vec![1, 2, 3];\nlet r = &v[0];\nv.push(4);          \u002F\u002F ERROR\nprintln!(\"{r}\");\n\n\u002F\u002F Fix: end the borrow first\nlet r = &v[0];\nprintln!(\"{r}\");\nv.push(4);\n\n\u002F\u002F Fix: copy out\nlet r = v[0];       \u002F\u002F i32 is Copy\nv.push(4);\n\n\u002F\u002F Fix: clone\nlet r = v[0].clone();\nv.push(4);\n","rust","",[36,37,32],"code",{"__ignoreMap":34},[23,39,41],{"id":40},"symptom-cannot-borrow-as-mutable-as-it-is-not-declared-as-mut","Symptom: \"cannot borrow as mutable, as it is not declared as mut\"",[28,43,46],{"className":44,"code":45,"language":33,"meta":34},[31],"let s = String::from(\"hi\");\nlet r = &mut s;     \u002F\u002F ERROR\n",[36,47,45],{"__ignoreMap":34},[14,49,50,51,54],{},"Fix: ",[36,52,53],{},"let mut s = String::from(\"hi\");",".",[23,56,58],{"id":57},"symptom-borrowed-value-does-not-live-long-enough","Symptom: \"borrowed value does not live long enough\"",[28,60,63],{"className":61,"code":62,"language":33,"meta":34},[31],"\u002F\u002F Bad\nfn bad() -> &str { let s = String::from(\"hi\"); &s }\n\n\u002F\u002F Fix: return owned\nfn good() -> String { String::from(\"hi\") }\n",[36,64,62],{"__ignoreMap":34},[14,66,67],{},"Returning a reference to a local is impossible. Return owned, or accept the data as input.",[23,69,71],{"id":70},"symptom-returns-a-value-referencing-data-owned-by-the-current-function","Symptom: \"returns a value referencing data owned by the current function\"",[14,73,74],{},"Same as above. Return owned, or restructure so the data lives outside the function.",[18,76,78,79,82],{"id":77},"_2-move-closure-footguns","2. ",[36,80,81],{},"move"," Closure Footguns",[23,84,86],{"id":85},"symptom-closure-captures-too-much","Symptom: closure captures too much",[28,88,91],{"className":89,"code":90,"language":33,"meta":34},[31],"let v = vec![1, 2, 3];\nlet n = 5;\nlet f = move || { println!(\"{n}\"); };   \u002F\u002F moves n, doesn't need v\n\u002F\u002F v still owned — but if closure captured v, v would be gone\n",[36,92,90],{"__ignoreMap":34},[14,94,95,96,98],{},"Edition 2021 captures only used variables, but ",[36,97,81],{}," still moves all of them.",[23,100,102],{"id":101},"symptom-lifetime-issues-with-thread-closure","Symptom: lifetime issues with thread closure",[28,104,107],{"className":105,"code":106,"language":33,"meta":34},[31],"let s = String::from(\"hi\");\nstd::thread::spawn(|| println!(\"{s}\"));    \u002F\u002F ERROR: 'static required\n\u002F\u002F Fix\nstd::thread::spawn(move || println!(\"{s}\"));\n\u002F\u002F or clone\n",[36,108,106],{"__ignoreMap":34},[18,110,112,113,116],{"id":111},"_3-clone-everywhere","3. ",[36,114,115],{},"clone()"," Everywhere",[14,118,119],{},"Cloning is fine when necessary but often signals a design issue:",[28,121,124],{"className":122,"code":123,"language":33,"meta":34},[31],"\u002F\u002F Smelly\nfn process(s: String) { \u002F* ... *\u002F }\nlet s = String::from(\"hi\");\nprocess(s.clone());\nprocess(s.clone());\n\n\u002F\u002F Better: borrow\nfn process(s: &str) { \u002F* ... *\u002F }\nprocess(&s);\nprocess(&s);\n",[36,125,123],{"__ignoreMap":34},[14,127,128,129,132,133,132,136,139],{},"Borrow by ",[36,130,131],{},"&str","\u002F",[36,134,135],{},"&[T]",[36,137,138],{},"&Path"," when you don't need ownership.",[18,141,143,144,132,147,150],{"id":142},"_4-unwrapexpect-in-production","4. ",[36,145,146],{},"unwrap()",[36,148,149],{},"expect()"," in Production",[28,152,155],{"className":153,"code":154,"language":33,"meta":34},[31],"\u002F\u002F Bad\nfn parse(s: &str) -> i32 { s.parse().unwrap() }\n\n\u002F\u002F Good\nfn parse(s: &str) -> Result\u003Ci32, ParseIntError> { s.parse() }\n\u002F\u002F or\nfn parse_or_default(s: &str) -> i32 { s.parse().unwrap_or(0) }\n",[36,156,154],{"__ignoreMap":34},[14,158,159,162,163,132,166,169,170,173,174,173,177,180],{},[36,160,161],{},"unwrap"," panics on ",[36,164,165],{},"None",[36,167,168],{},"Err",". Use ",[36,171,172],{},"?",", ",[36,175,176],{},"unwrap_or",[36,178,179],{},"unwrap_or_default",", or explicit match.",[18,182,184,185,188],{"id":183},"_5-treating-result-like-exceptions","5. Treating ",[36,186,187],{},"Result"," Like Exceptions",[28,190,193],{"className":191,"code":192,"language":33,"meta":34},[31],"\u002F\u002F Smelly\nfn process() {\n    let a: i32 = \"x\".parse().unwrap();\n    let b: i32 = \"y\".parse().unwrap();\n    \u002F\u002F ...\n}\n\n\u002F\u002F Idiomatic\nfn process() -> Result\u003C(), AppError> {\n    let a: i32 = \"x\".parse()?;\n    let b: i32 = \"y\".parse()?;\n    Ok(())\n}\n",[36,194,192],{"__ignoreMap":34},[14,196,197,198,200,201,203],{},"Propagate with ",[36,199,172],{},". Don't ",[36,202,161],{}," in non-test paths.",[18,205,207],{"id":206},"_6-mutable-global-state","6. Mutable Global State",[28,209,212],{"className":210,"code":211,"language":33,"meta":34},[31],"\u002F\u002F Smelly\nstatic mut COUNTER: u32 = 0;\nfn incr() { unsafe { COUNTER += 1; } }\n\n\u002F\u002F Idiomatic\nuse std::sync::atomic::{AtomicUsize, Ordering};\nstatic COUNTER: AtomicUsize = AtomicUsize::new(0);\nfn incr() { COUNTER.fetch_add(1, Ordering::Relaxed); }\n",[36,213,211],{"__ignoreMap":34},[14,215,216,217,220],{},"Atomics or ",[36,218,219],{},"Arc\u003CMutex\u003CT>>"," are safe and testable.",[18,222,224,225,228],{"id":223},"_7-vecvect-for-matrices","7. ",[36,226,227],{},"Vec\u003CVec\u003CT>>"," for Matrices",[28,230,233],{"className":231,"code":232,"language":33,"meta":34},[31],"\u002F\u002F Smelly: cache-unfriendly\nlet m: Vec\u003CVec\u003Cf32>> = vec![vec![0.0; 100]; 100];\n\n\u002F\u002F Better: flat layout\nlet m: Vec\u003Cf32> = vec![0.0; 100 * 100];\nfn at(m: &[f32], x: usize, y: usize, w: usize) -> f32 { m[y * w + x] }\n",[36,234,232],{"__ignoreMap":34},[18,236,238,239,242],{"id":237},"_8-vecu8-repeated-reallocations","8. ",[36,240,241],{},"Vec\u003Cu8>"," Repeated Reallocations",[28,244,247],{"className":245,"code":246,"language":33,"meta":34},[31],"\u002F\u002F Smelly\nlet mut v = Vec::new();\nfor _ in 0..1000 { v.push(0u8); }    \u002F\u002F regrows ~10 times\n\n\u002F\u002F Better\nlet mut v = Vec::with_capacity(1000);\nfor _ in 0..1000 { v.push(0u8); }\n\u002F\u002F or\nlet v = vec![0u8; 1000];\n",[36,248,246],{"__ignoreMap":34},[18,250,252,253,256],{"id":251},"_9-string-for-static-text","9. ",[36,254,255],{},"String"," for Static Text",[28,258,261],{"className":259,"code":260,"language":33,"meta":34},[31],"\u002F\u002F Smelly\nfn label() -> String { String::from(\"OK\") }\n\n\u002F\u002F Better\nfn label() -> &'static str { \"OK\" }\n",[36,262,260],{"__ignoreMap":34},[14,264,265,266,269,270,272],{},"Return ",[36,267,268],{},"&'static str"," for compile-time constants; ",[36,271,255],{}," only when constructed.",[18,274,276],{"id":275},"_10-indexing-out-of-bounds","10. Indexing Out of Bounds",[28,278,281],{"className":279,"code":280,"language":33,"meta":34},[31],"\u002F\u002F Panics\nlet v = vec![1, 2, 3];\nlet x = v[5];\n\n\u002F\u002F Safe\nlet x = v.get(5).copied().unwrap_or(0);\n",[36,282,280],{"__ignoreMap":34},[14,284,285,286,132,289,292],{},"Use ",[36,287,288],{},"get",[36,290,291],{},"get_mut"," when bounds are uncertain.",[18,294,296],{"id":295},"_11-string-indexing-confusion","11. String Indexing Confusion",[28,298,301],{"className":299,"code":300,"language":33,"meta":34},[31],"let s = \"héllo\";\nlet c = s[0];       \u002F\u002F ERROR: String can't be indexed by integer\nlet b = s.as_bytes()[0];    \u002F\u002F u8, byte\nlet c = s.chars().nth(0);   \u002F\u002F Option\u003Cchar>\n",[36,302,300],{"__ignoreMap":34},[14,304,305,306,309,310,313],{},"UTF-8 strings don't support byte indexing semantically. Iterate ",[36,307,308],{},"chars()"," for code points, ",[36,311,312],{},"bytes()"," for bytes.",[18,315,317,318,321],{"id":316},"_12-using-deref-for-inheritance","12. Using ",[36,319,320],{},"Deref"," for Inheritance",[14,323,324,326],{},[36,325,320],{}," is for smart pointers, not modeling. Misuse leads to confusing method resolution:",[28,328,331],{"className":329,"code":330,"language":33,"meta":34},[31],"\u002F\u002F Smelly\nstruct A { \u002F* ... *\u002F }\nstruct B(A);   \u002F\u002F hope to \"inherit\" A's methods\nimpl Deref for B { type Target = A; fn deref(&self) -> &A { &self.0 } }\n\u002F\u002F B.method_of_a() works, but it's misleading\n\n\u002F\u002F Better: explicit delegation\nimpl B {\n    fn method_of_a(&self) { self.0.method_of_a(); }\n}\n",[36,332,330],{"__ignoreMap":34},[18,334,336,337],{"id":335},"_13-unsafe-impl-send-for-rct","13. ",[36,338,339],{},"unsafe impl Send for Rc\u003CT>",[14,341,342,345,346,349,350,54],{},[36,343,344],{},"Rc","'s refcount is non-atomic; making it ",[36,347,348],{},"Send"," causes data races. Use ",[36,351,352],{},"Arc",[18,354,356,357,360,361,364],{"id":355},"_14-vecclone-where-rcclone-would-do","14. ",[36,358,359],{},"Vec::clone()"," Where ",[36,362,363],{},"Rc::clone"," Would Do",[28,366,369],{"className":367,"code":368,"language":33,"meta":34},[31],"\u002F\u002F Smelly: deep clones the whole vec\nlet v = vec![1, 2, 3];\nlet v2 = v.clone();\n\n\u002F\u002F If sharing read-only data\nlet v = Rc::new(vec![1, 2, 3]);\nlet v2 = Rc::clone(&v);    \u002F\u002F just bumps refcount\n",[36,370,368],{"__ignoreMap":34},[18,372,374,375],{"id":373},"_15-locking-across-await","15. Locking Across ",[36,376,377],{},".await",[28,379,382],{"className":380,"code":381,"language":33,"meta":34},[31],"\u002F\u002F Smelly: holding std::sync::Mutex across await\nlet m = std::sync::Mutex::new(0);\nlet g = m.lock().unwrap();\nsome_async().await;     \u002F\u002F ⚠️ held during await\ndrop(g);\n\n\u002F\u002F Better: drop before await\nlet v = { let g = m.lock().unwrap(); *g };\nsome_async(v).await;\n\n\u002F\u002F Or use tokio's async Mutex\nlet m = tokio::sync::Mutex::new(0);\nlet mut g = m.lock().await;\nsome_async(&mut *g).await;\n",[36,383,381],{"__ignoreMap":34},[18,385,387,388,390],{"id":386},"_16-forgetting-move-in-async-blocks","16. Forgetting ",[36,389,81],{}," in Async Blocks",[28,392,395],{"className":393,"code":394,"language":33,"meta":34},[31],"let v = vec![1, 2, 3];\nlet f = async { println!(\"{:?}\", v); };   \u002F\u002F borrows v\n\u002F\u002F f must outlive v — if returned\u002Fspawned, error\nlet f = async move { println!(\"{:?}\", v); };   \u002F\u002F moves v\n",[36,396,394],{"__ignoreMap":34},[18,398,400,401,404,405],{"id":399},"_17-arcclone-vs-cloneclone","17. ",[36,402,403],{},"Arc::clone"," vs ",[36,406,407],{},"Clone::clone",[14,409,410,413,414,417,418,54],{},[36,411,412],{},"Arc::clone(&arc)"," is identical to ",[36,415,416],{},"arc.clone()"," but signals \"this is cheap, just refcount\". Use ",[36,419,403],{},[18,421,423,424,404,427,430],{"id":422},"_18-if-vs-match-for-two-path","18. ",[36,425,426],{},"if",[36,428,429],{},"match"," for Two-Path",[14,432,433,436,437,439,440,443,444,446],{},[36,434,435],{},"if cond { } else { }"," is fine for booleans; ",[36,438,429],{}," is better for enum dispatch. Don't ",[36,441,442],{},"if let"," when a full ",[36,445,429],{}," is clearer.",[18,448,450,451,453,454],{"id":449},"_19-unwrap-on-lock","19. ",[36,452,146],{}," on ",[36,455,456],{},"lock()",[28,458,461],{"className":459,"code":460,"language":33,"meta":34},[31],"let g = m.lock().unwrap();    \u002F\u002F panics on poison\n",[36,462,460],{"__ignoreMap":34},[14,464,465,466,469],{},"In production, decide a poison policy: ",[36,467,468],{},".lock().unwrap_or_else(|e| e.into_inner())"," to recover the data despite a panic.",[18,471,473,474,477],{"id":472},"_20-boxdyn-trait-where-generic-works","20. ",[36,475,476],{},"Box\u003Cdyn Trait>"," Where Generic Works",[28,479,482],{"className":480,"code":481,"language":33,"meta":34},[31],"\u002F\u002F Smelly: dyn for a single type\nfn process(items: Vec\u003CBox\u003Cdyn Process>>) { \u002F* ... *\u002F }\n\n\u002F\u002F Better: generic, monomorphizes\nfn process\u003CT: Process>(items: Vec\u003CT>) { \u002F* ... *\u002F }\n",[36,483,481],{"__ignoreMap":34},[14,485,486,489],{},[36,487,488],{},"dyn"," is for heterogeneous collections or when binary size matters.",[18,491,493,494,496,497],{"id":492},"_21-vecu8-from-read_to_end","21. ",[36,495,241],{}," from ",[36,498,499],{},"read_to_end",[14,501,502,503,506],{},"If you know the size, ",[36,504,505],{},"Vec::with_capacity",":",[28,508,511],{"className":509,"code":510,"language":33,"meta":34},[31],"let mut v = Vec::with_capacity(1024);\nfile.read_to_end(&mut v)?;\n",[36,512,510],{"__ignoreMap":34},[18,514,516,517,520],{"id":515},"_22-format-in-hot-loops","22. ",[36,518,519],{},"format!"," in Hot Loops",[28,522,525],{"className":523,"code":524,"language":33,"meta":34},[31],"\u002F\u002F Smelly\nfor x in items { log::info!(\"{}\", format!(\"{:?}\", x)); }\n\n\u002F\u002F Better\nfor x in items { log::info!(\"{:?}\", x); }\n",[36,526,524],{"__ignoreMap":34},[14,528,529,531,532,535],{},[36,530,519],{}," allocates. Use ",[36,533,534],{},"write!"," into a reused buffer if you must build a string in a loop.",[18,537,539,540,543],{"id":538},"_23-returning-from-blocks-by-accident","23. Returning ",[36,541,542],{},"()"," From Blocks by Accident",[28,545,548],{"className":546,"code":547,"language":33,"meta":34},[31],"\u002F\u002F Bad\nfn foo() -> i32 {\n    let x = 5;\n    x + 1;     \u002F\u002F ; — block returns ()!\n}\n\n\u002F\u002F Good\nfn foo() -> i32 {\n    let x = 5;\n    x + 1       \u002F\u002F no semicolon — returns 6\n}\n",[36,549,547],{"__ignoreMap":34},[14,551,552,553,556,557,54],{},"A trailing ",[36,554,555],{},";"," turns an expression into a statement returning ",[36,558,542],{},[18,560,562,563,565,566,569],{"id":561},"_24-match-without-_-when-all-cases-matter","24. ",[36,564,429],{}," Without ",[36,567,568],{},"_"," When All Cases Matter",[28,571,574],{"className":572,"code":573,"language":33,"meta":34},[31],"\u002F\u002F Bad: silently breaks when a new variant is added\nmatch color {\n    Color::Red => 1,\n    _ => 0,    \u002F\u002F catches future variants\n}\n\n\u002F\u002F Better (until you've thought about it)\nmatch color {\n    Color::Red => 1,\n    Color::Green => 0,\n    Color::Blue => 0,\n}\n",[36,575,573],{"__ignoreMap":34},[14,577,578],{},"Let exhaustiveness drive you to handle new variants.",[18,580,582,583,586],{"id":581},"_25-mut-you-dont-need","25. ",[36,584,585],{},"mut"," You Don't Need",[28,588,591],{"className":589,"code":590,"language":33,"meta":34},[31],"let mut x = 5;\nlet y = x + 1;     \u002F\u002F x never mutates — warning: unused mut\n",[36,592,590],{"__ignoreMap":34},[14,594,595,596,598,599,602],{},"Remove ",[36,597,585],{}," or prefix ",[36,600,601],{},"_x"," if intentional.",[18,604,606,607],{"id":605},"_26-unreachable-unreachable","26. Unreachable ",[36,608,609],{},"unreachable!",[28,611,614],{"className":612,"code":613,"language":33,"meta":34},[31],"match opt {\n    Some(_) => 1,\n    None => unreachable!(),   \u002F\u002F will panic if someone passes None\n}\n",[36,615,613],{"__ignoreMap":34},[14,617,618,619,621,622,624],{},"If the API allows ",[36,620,165],{},", handle it. Reserve ",[36,623,609],{}," for truly impossible states.",[18,626,628,629,404,632,404,635],{"id":627},"_27-stringfrom-vs-to_string-vs-into","27. ",[36,630,631],{},"String::from",[36,633,634],{},".to_string()",[36,636,637],{},".into()",[14,639,640,641,643,644,647,648,651,652,654],{},"All three work for ",[36,642,255],{},". ",[36,645,646],{},"into()"," is shortest, ",[36,649,650],{},"to_string()"," reads clearly, ",[36,653,631],{}," is explicit. Pick one and be consistent.",[18,656,658,659,662],{"id":657},"_28-vect-parameters","28. ",[36,660,661],{},"&Vec\u003CT>"," Parameters",[28,664,667],{"className":665,"code":666,"language":33,"meta":34},[31],"\u002F\u002F Smelly: forces caller to have a Vec\nfn sum(v: &Vec\u003Ci32>) -> i32 { v.iter().sum() }\n\n\u002F\u002F Better: accepts slices, arrays, Vec\nfn sum(v: &[i32]) -> i32 { v.iter().sum() }\n",[36,668,666],{"__ignoreMap":34},[18,670,672,673,662],{"id":671},"_29-string-parameters","29. ",[36,674,675],{},"&String",[28,677,680],{"className":678,"code":679,"language":33,"meta":34},[31],"\u002F\u002F Smelly\nfn greet(s: &String) { \u002F* ... *\u002F }\n\n\u002F\u002F Better\nfn greet(s: &str) { \u002F* ... *\u002F }\n\u002F\u002F accepts String, &str, literals\n",[36,681,679],{"__ignoreMap":34},[18,683,685,686],{"id":684},"_30-if-xis_ok-xunwrap","30. ",[36,687,688],{},"if x.is_ok() { x.unwrap() }",[28,690,693],{"className":691,"code":692,"language":33,"meta":34},[31],"\u002F\u002F Smelly\nif let Ok(v) = result { \u002F* use v *\u002F }\n\n\u002F\u002F Idiomatic\nlet v = result?;\n\u002F\u002F or\nmatch result { Ok(v) => \u002F* use v *\u002F, Err(e) => \u002F* handle *\u002F }\n",[36,694,692],{"__ignoreMap":34},[18,696,698,699,404,702],{"id":697},"_31-vecnone-n-vs-vec0-n","31. ",[36,700,701],{},"vec![None; n]",[36,703,704],{},"vec![0; n]",[14,706,707,709,710,712],{},[36,708,701],{}," works but takes 8 bytes\u002Felement on 64-bit. If you have a \"default\" sentinel, use ",[36,711,704],{}," for cache efficiency.",[18,714,716,717,720],{"id":715},"_32-hashmap-iteration-order","32. ",[36,718,719],{},"HashMap"," Iteration Order",[14,722,723,724,726,727,730,731,734],{},"Don't depend on iteration order of ",[36,725,719],{}," — it's randomized per run. Use ",[36,728,729],{},"BTreeMap"," for ordered, or ",[36,732,733],{},"IndexMap"," for insertion order.",[18,736,738,739,404,742],{"id":737},"_33-stringnew-vs-stringwith_capacity","33. ",[36,740,741],{},"String::new()",[36,743,744],{},"String::with_capacity",[14,746,747,748,751],{},"If you'll push N chars, ",[36,749,750],{},"with_capacity(N)"," avoids regrow.",[18,753,755,756,404,759],{"id":754},"_34-stringfrom_utf8_lossy-vs-from_utf8","34. ",[36,757,758],{},"String::from_utf8_lossy",[36,760,761],{},"from_utf8",[14,763,764,766,767,769,770,773,774,777,778,780],{},[36,765,761],{}," returns ",[36,768,187],{},"; ",[36,771,772],{},"from_utf8_lossy"," always returns a ",[36,775,776],{},"Cow"," with replacement chars. Use ",[36,779,761],{}," if invalid UTF-8 is an error.",[18,782,784,785,788],{"id":783},"_35-forgetting-must_use-types","35. Forgetting ",[36,786,787],{},"#[must_use]"," Types",[14,790,791,173,793,796],{},[36,792,187],{},[36,794,795],{},"Option"," warn by default. For your types:",[28,798,801],{"className":799,"code":800,"language":33,"meta":34},[31],"#[must_use]\npub struct Handle { \u002F* ... *\u002F }\n",[36,802,800],{"__ignoreMap":34},[18,804,806,807,810],{"id":805},"_36-as-casts","36. ",[36,808,809],{},"as"," Casts",[14,812,813,815,816,132,819,506],{},[36,814,809],{}," is unchecked and may truncate. Use ",[36,817,818],{},"TryFrom",[36,820,821],{},"TryInto",[28,823,826],{"className":824,"code":825,"language":33,"meta":34},[31],"\u002F\u002F Risky\nlet n: u8 = 1000u32 as u8;     \u002F\u002F 232, silently\n\n\u002F\u002F Safe\nlet n: u8 = 1000u32.try_into().unwrap_or(u8::MAX);\n",[36,827,825],{"__ignoreMap":34},[18,829,831,832,835,836],{"id":830},"_37-cargo-build-in-ci-without-locked","37. ",[36,833,834],{},"cargo build"," in CI Without ",[36,837,838],{},"--locked",[28,840,845],{"className":841,"code":843,"language":844,"meta":34},[842],"language-yaml","- run: cargo build --locked --release\n","yaml",[36,846,843],{"__ignoreMap":34},[14,848,849,851,852,855],{},[36,850,838],{}," ensures ",[36,853,854],{},"Cargo.lock"," is honored (reproducible builds).",[18,857,859],{"id":858},"_38-ignoring-clippy","38. Ignoring Clippy",[14,861,862],{},"Treat Clippy warnings as errors in CI:",[28,864,867],{"className":865,"code":866,"language":844,"meta":34},[842],"- run: cargo clippy --all-targets -- -D warnings\n",[36,868,866],{"__ignoreMap":34},[14,870,871,872,173,875,878],{},"Many lints catch real bugs (e.g., ",[36,873,874],{},"clippy::needless_collect",[36,876,877],{},"clippy::mem_forget",").",[18,880,882],{"id":881},"_39-doc-tests-breaking-on-rust-version","39. Doc Tests Breaking on Rust Version",[14,884,885,886,889],{},"Pin a MSRV; CI runs ",[36,887,888],{},"cargo +1.75 test"," to catch regressions.",[18,891,893,894,896],{"id":892},"_40-arcmutext-for-single-threaded-code","40. ",[36,895,219],{}," for Single-Threaded Code",[14,898,899,900,903],{},"If you're not actually going multi-threaded, plain ",[36,901,902],{},"Rc\u003CRefCell\u003CT>>"," is cheaper. Match the abstraction to the actual concurrency.",[18,905,907],{"id":906},"summary","Summary",[909,910,911,915,922,932,937,943,949,957,965],"ul",{},[912,913,914],"li",{},"Borrow, don't clone, when you don't need ownership.",[912,916,917,919,920,54],{},[36,918,172],{}," over ",[36,921,161],{},[912,923,924,132,926,919,928,132,930,54],{},[36,925,131],{},[36,