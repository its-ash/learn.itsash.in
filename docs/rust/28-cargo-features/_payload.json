[{"data":1,"prerenderedAt":869},["ShallowReactive",2],{"page-\u002Frust\u002F28-cargo-features":3},{"id":4,"title":5,"body":6,"description":16,"extension":862,"meta":863,"navigation":864,"path":865,"seo":866,"stem":867,"__hash__":868},"content\u002Frust\u002F28-cargo-features.md","28 — Cargo Features & Release Engineering",{"type":7,"value":8,"toc":825},"minimark",[9,13,17,22,33,38,60,64,70,77,81,89,97,101,121,140,144,147,151,189,193,199,204,207,213,223,227,274,282,288,291,312,342,353,360,366,378,382,386,420,424,454,458,495,499,529,533,561,565,571,585,589,603,607,615,629,633,639,646,652,658,662,696,700,706,710,716,719,725,729,804,808,822],[10,11,5],"h1",{"id":12},"_28-cargo-features-release-engineering",[14,15,16],"p",{},"Cargo features are the standard mechanism for conditional compilation. Combined with profiles and CI, they form the release engineering story.",[18,19,21],"h2",{"id":20},"defining-features","Defining Features",[23,24,30],"pre",{"className":25,"code":27,"language":28,"meta":29},[26],"language-toml","# Cargo.toml\n[features]\ndefault = [\"json\", \"csv\"]\njson = [\"dep:serde_json\"]          # optional dependency 'serde_json'\ncsv = [\"dep:csv\"]\nfull = [\"json\", \"csv\", \"yaml\"]\nyaml = []\n","toml","",[31,32,27],"code",{"__ignoreMap":29},[34,35,37],"h3",{"id":36},"feature-syntax-160","Feature Syntax (1.60+)",[39,40,41,48,54],"ul",{},[42,43,44,47],"li",{},[31,45,46],{},"dep:crate_name"," — enables an optional dependency without exposing a feature of the same name.",[42,49,50,53],{},[31,51,52],{},"dep_crate\u002Ffeature"," — enables a specific feature of a dependency.",[42,55,56,59],{},[31,57,58],{},"?dep_crate\u002Ffeature"," — only enables the dep's feature if it's already enabled by someone else.",[34,61,63],{"id":62},"optional-dependencies","Optional Dependencies",[23,65,68],{"className":66,"code":67,"language":28,"meta":29},[26],"[dependencies]\nserde_json = { version = \"1.0\", optional = true }\n",[31,69,67],{"__ignoreMap":29},[14,71,72,73,76],{},"Optional deps implicitly create a feature of the same name (unless ",[31,74,75],{},"dep:"," is used).",[18,78,80],{"id":79},"using-features","Using Features",[23,82,87],{"className":83,"code":85,"language":86,"meta":29},[84],"language-rust","#[cfg(feature = \"json\")]\nmod json;\n\n#[cfg(feature = \"json\")]\npub use json::parse_json;\n","rust",[31,88,85],{"__ignoreMap":29},[23,90,95],{"className":91,"code":93,"language":94,"meta":29},[92],"language-bash","cargo build --no-default-features\ncargo build --features json,yaml\ncargo build --all-features\n","bash",[31,96,93],{"__ignoreMap":29},[18,98,100],{"id":99},"feature-unification","Feature Unification",[14,102,103,104,107,108,112,113,116,117,120],{},"Cargo unifies features across the dependency graph: if any crate enables ",[31,105,106],{},"serde\u002Fderive",", ",[109,110,111],"em",{},"every"," user of ",[31,114,115],{},"serde"," gets ",[31,118,119],{},"derive"," on. Design features accordingly:",[39,122,123,130,133],{},[42,124,125,129],{},[126,127,128],"strong",{},"Don't"," expose \"private\" features that change behavior of your crate depending on who else in the graph enabled them.",[42,131,132],{},"Use additive features (more code enabled), not subtractive.",[42,134,135,136,139],{},"Avoid ",[31,137,138],{},"default-features = false"," on transitive deps unless you understand the consequences.",[34,141,143],{"id":142},"additive-only-rule","Additive-Only Rule",[14,145,146],{},"Features should be strictly additive: enabling a feature adds capabilities, never removes them. If you need mutually-exclusive features, consider splitting crates.",[18,148,150],{"id":149},"common-feature-pitfalls","Common Feature Pitfalls",[39,152,153,166,172,180],{},[42,154,155,158,159,162,163,165],{},[126,156,157],{},"Exposing transitive features",": ",[31,160,161],{},"[\"serde\u002Fderive\"]"," from your crate forces all downstream users to also enable ",[31,164,106],{},".",[42,167,168,171],{},[126,169,170],{},"Cargo feature unification surprise",": if a dep is also enabled by another crate with extra features, you get them all.",[42,173,174,179],{},[126,175,176,178],{},[31,177,138],{}," on transitive deps",": hard to reason about; usually wrong.",[42,181,182,185,186,188],{},[126,183,184],{},"Negation",": features can't disable features. The only \"negation\" is ",[31,187,138],{}," when depending on a crate.",[18,190,192],{"id":191},"build-profiles","Build Profiles",[23,194,197],{"className":195,"code":196,"language":28,"meta":29},[26],"[profile.dev]\nopt-level = 0\ndebug = true\nincremental = true\noverflow-checks = true\n\n[profile.release]\nopt-level = 3\ndebug = false\nlto = \"fat\"               # or \"thin\", or true\u002Ffalse\ncodegen-units = 1          # best optimization, slower compile\npanic = \"unwind\"           # or \"abort\"\nstrip = \"symbols\"\nopt-level = \"z\"            # optimize for size (vs \"s\" or numeric 0-3)\n\n[profile.release.package.\"*\"]\nopt-level = 2              # dependencies at lower opt level for faster compile\n\n[profile.bench]\ninherits = \"release\"\ndebug = true\n\n[profile.dist]\ninherits = \"release\"\nlto = \"thin\"\n",[31,198,196],{"__ignoreMap":29},[34,200,202],{"id":201},"inherits",[31,203,201],{},[14,205,206],{},"Custom profiles can inherit from existing ones:",[23,208,211],{"className":209,"code":210,"language":28,"meta":29},[26],"[profile.profiling]\ninherits = \"release\"\ndebug = true\n",[31,212,210],{"__ignoreMap":29},[14,214,215,216,219,220,165],{},"Build with ",[31,217,218],{},"cargo build --profile profiling",". Output goes to ",[31,221,222],{},"target\u002Fprofiling",[34,224,226],{"id":225},"profile-pitfalls","Profile Pitfalls",[39,228,229,238,246,258],{},[42,230,231,237],{},[126,232,233,236],{},[31,234,235],{},"lto = \"fat\""," dramatically slows compile"," but produces smaller\u002Ffaster binaries. Use only in release.",[42,239,240,245],{},[126,241,242],{},[31,243,244],{},"codegen-units = 1"," is best for performance, slowest to compile.",[42,247,248,253,254,257],{},[126,249,250],{},[31,251,252],{},"panic = \"abort\""," breaks some code that relies on unwinding (and on catching panics via ",[31,255,256],{},"catch_unwind",").",[42,259,260,265,266,269,270,273],{},[126,261,262],{},[31,263,264],{},"opt-level = \"z\""," optimizes for binary size; ",[31,267,268],{},"\"s\""," for size + some speed; ",[31,271,272],{},"3"," for max speed.",[18,275,277,278,281],{"id":276},"build-scripts-buildrs","Build Scripts (",[31,279,280],{},"build.rs",")",[23,283,286],{"className":284,"code":285,"language":86,"meta":29},[84],"\u002F\u002F build.rs\nfn main() {\n    println!(\"cargo:rustc-env=MY_VAR=value\");\n    println!(\"cargo:rerun-if-changed=some_file.txt\");\n    println!(\"cargo:rustc-link-lib=mylib\");\n    println!(\"cargo:rustc-link-search=vendor\u002Flib\");\n}\n",[31,287,285],{"__ignoreMap":29},[14,289,290],{},"Use for:",[39,292,293,300,303,309],{},[42,294,295,296,299],{},"Compiling C code (",[31,297,298],{},"cc"," crate).",[42,301,302],{},"Generating code (e.g., protobuf, SQL).",[42,304,305,306,165],{},"Setting env vars for ",[31,307,308],{},"env!()",[42,310,311],{},"Link configuration.",[14,313,314,315,107,318,107,321,107,324,107,327,107,330,107,333,107,336,107,339,165],{},"Read env vars set by Cargo: ",[31,316,317],{},"CARGO_PKG_VERSION",[31,319,320],{},"CARGO_MANIFEST_DIR",[31,322,323],{},"OUT_DIR",[31,325,326],{},"TARGET",[31,328,329],{},"HOST",[31,331,332],{},"OPT_LEVEL",[31,334,335],{},"PROFILE",[31,337,338],{},"DEBUG",[31,340,341],{},"NUM_JOBS",[14,343,344,345,348,349,352],{},"Use ",[31,346,347],{},"env!(\"VAR\")"," or ",[31,350,351],{},"option_env!(\"VAR\")"," in code to read build-time env vars.",[18,354,356,359],{"id":355},"links-key",[31,357,358],{},"links"," Key",[23,361,364],{"className":362,"code":363,"language":28,"meta":29},[26],"[links]\nfoo = \"1.0\"\n",[31,365,363],{"__ignoreMap":29},[14,367,368,370,371,374,375,377],{},[31,369,358],{}," declares that the crate links to a native library named ",[31,372,373],{},"foo",". Prevents two crates from both linking to ",[31,376,373],{}," with conflicting build scripts.",[18,379,381],{"id":380},"release-checklist","Release Checklist",[34,383,385],{"id":384},"code-quality","Code Quality",[39,387,388,393,402,408,414],{},[42,389,390],{},[31,391,392],{},"cargo fmt -- --check",[42,394,395,398,399,281],{},[31,396,397],{},"cargo clippy -- -D warnings"," (and ",[31,400,401],{},"--all-targets",[42,403,404,407],{},[31,405,406],{},"cargo deny check"," (licenses, advisories, bans)",[42,409,410,413],{},[31,411,412],{},"cargo audit"," (RustSec advisories)",[42,415,416,419],{},[31,417,418],{},"cargo machete"," (unused deps)",[34,421,423],{"id":422},"testing","Testing",[39,425,426,431,437,442,448],{},[42,427,428],{},[31,429,430],{},"cargo test --all-features",[42,432,433,436],{},[31,434,435],{},"cargo test --no-default-features"," (smoke)",[42,438,439],{},[31,440,441],{},"cargo test --workspace",[42,443,444,445],{},"Doc tests: ",[31,446,447],{},"cargo test --doc",[42,449,450,451],{},"Cross-compile: ",[31,452,453],{},"cargo build --target x86_64-unknown-linux-musl",[34,455,457],{"id":456},"performance","Performance",[39,459,460,470,482],{},[42,461,462,463,466,467],{},"Benchmarks: ",[31,464,465],{},"cargo bench"," (nightly) or ",[31,468,469],{},"criterion",[42,471,472,473,107,476,107,479],{},"Profile with ",[31,474,475],{},"cargo flamegraph",[31,477,478],{},"perf",[31,480,481],{},"samply",[42,483,484,485,107,488,491,492],{},"Check binary size: ",[31,486,487],{},"cargo bloat",[31,489,490],{},"cargo build --release"," then ",[31,493,494],{},"ls -lh",[34,496,498],{"id":497},"binary","Binary",[39,500,501,507,513,519],{},[42,502,503,504],{},"Strip symbols: ",[31,505,506],{},"strip = \"symbols\"",[42,508,509,510,512],{},"LTO: ",[31,511,235],{}," for final",[42,514,515,516,518],{},"Consider ",[31,517,252],{}," if you don't need unwinding",[42,520,521,522,107,524,107,526],{},"For size-critical: ",[31,523,264],{},[31,525,244],{},[31,527,528],{},"lto = true",[34,530,532],{"id":531},"versioning","Versioning",[39,534,535,541,551],{},[42,536,537,538],{},"Semver: ",[31,539,540],{},"MAJOR.MINOR.PATCH",[42,542,344,543,546,547,550],{},[31,544,545],{},"cargo release"," (",[31,548,549],{},"cargo install cargo-release",") to bump, tag, publish.",[42,552,553,554,557,558,165],{},"Set ",[31,555,556],{},"rust-version"," (MSRV) in ",[31,559,560],{},"Cargo.toml",[34,562,564],{"id":563},"publishing","Publishing",[23,566,569],{"className":567,"code":568,"language":94,"meta":29},[92],"cargo login \u003Ctoken>\ncargo publish --dry-run\ncargo publish\n",[31,570,568],{"__ignoreMap":29},[39,572,573,576,582],{},[42,574,575],{},"Crates.io is the public registry.",[42,577,578,581],{},[31,579,580],{},"publish = false"," to prevent accidental publication.",[42,583,584],{},"Documentation is auto-built on docs.rs.",[34,586,588],{"id":587},"changelog","Changelog",[14,590,344,591,107,593,596,597,600,601,165],{},[31,592,545],{},[31,594,595],{},"git-cliff",", or ",[31,598,599],{},"changesets"," to generate from commits\u002FPRs. Conventional Commits format works well with ",[31,602,595],{},[18,604,606],{"id":605},"ci-github-actions","CI (GitHub Actions)",[23,608,613],{"className":609,"code":611,"language":612,"meta":29},[610],"language-yaml","name: CI\non: [push, pull_request]\njobs:\n  test:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        rust: [stable, beta, nightly]\n        os: [ubuntu-latest, windows-latest, macos-latest]\n    steps:\n      - uses: actions\u002Fcheckout@v4\n      - uses: dtolnay\u002Frust-toolchain@master\n        with: { toolchain: ${{ matrix.rust }}, components: clippy, rustfmt }\n      - run: cargo fmt -- --check\n      - run: cargo clippy --all-targets -- -D warnings\n      - run: cargo test --all-features\n      - run: cargo doc --no-deps\n","yaml",[31,614,611],{"__ignoreMap":29},[14,616,617,618,107,621,624,625,628],{},"Add ",[31,619,620],{},"cargo-deny",[31,622,623],{},"cargo-audit"," for security. Use ",[31,626,627],{},"cargo nextest run"," for faster test execution.",[18,630,632],{"id":631},"cross-compilation","Cross-Compilation",[23,634,637],{"className":635,"code":636,"language":94,"meta":29},[92],"rustup target add x86_64-unknown-linux-musl\ncargo build --target x86_64-unknown-linux-musl\n",[31,638,636],{"__ignoreMap":29},[14,640,641,642,645],{},"For cross-platform, ",[31,643,644],{},"cross"," (Docker-based) is the easiest:",[23,647,650],{"className":648,"code":649,"language":94,"meta":29},[92],"cargo install cross\ncross build --target aarch64-unknown-linux-gnu\n",[31,651,649],{"__ignoreMap":29},[14,653,654,657],{},[31,655,656],{},"cargo-zigbuild"," uses Zig as a cross-linker (good for musl and Windows targets from Linux).",[18,659,661],{"id":660},"binary-distribution","Binary Distribution",[39,663,664,671,685],{},[42,665,666,667,670],{},"Static linking with ",[31,668,669],{},"musl"," for portable Linux binaries.",[42,672,673,674,677,678,681,682,165],{},"Universal binaries on macOS: build for both ",[31,675,676],{},"x86_64-apple-darwin"," and ",[31,679,680],{},"aarch64-apple-darwin",", combine with ",[31,683,684],{},"lipo",[42,686,687,688,691,692,695],{},"Windows: ",[31,689,690],{},"cargo build --target x86_64-pc-windows-gnu"," for portable static binaries (or use ",[31,693,694],{},"cargo-wix"," for MSI installers).",[18,697,699],{"id":698},"workspace-releases","Workspace Releases",[14,701,702,703,705],{},"For multi-crate workspaces, ",[31,704,545],{}," handles inter-crate version bumps and dependency updates.",[18,707,709],{"id":708},"msrv","MSRV",[23,711,714],{"className":712,"code":713,"language":28,"meta":29},[26],"[package]\nrust-version = \"1.75\"\n",[31,715,713],{"__ignoreMap":29},[14,717,718],{},"CI must test with that version:",[23,720,723],{"className":721,"code":722,"language":612,"meta":29},[610],"- run: rustup install 1.75\n- run: rustup override set 1.75\n- run: cargo build\n",[31,724,722],{"__ignoreMap":29},[18,726,728],{"id":727},"edge-cases","Edge Cases",[39,730,731,748,760,771,783,792],{},[42,732,733,736,737,740,741,743,744,747],{},[126,734,735],{},"Feature unification breaking builds",": if your crate's ",[31,738,739],{},"cfg(feature = \"x\")"," only makes sense with another crate's feature, you can't express that without ",[31,742,75],{},"\u002F",[31,745,746],{},"?dep\u002Ffeat"," syntax.",[42,749,750,755,756,759],{},[126,751,752,753],{},"Optional dep without ",[31,754,75],{}," creates an implicit feature of the same name; sometimes you want this (so users can ",[31,757,758],{},"features = [\"serde_json\"]","), sometimes you don't.",[42,761,762,767,768,165],{},[126,763,764],{},[31,765,766],{},"cargo build --features \"\""," is sometimes needed to override ",[31,769,770],{},"default-features",[42,772,773,778,779,782],{},[126,774,775,777],{},[31,776,280],{}," and feature interaction",": read ",[31,780,781],{},"CARGO_FEATURE_*"," env vars in build scripts.",[42,784,785,788,789,791],{},[126,786,787],{},"Profile inheritance",": a custom profile that doesn't ",[31,790,201],{}," from another starts empty (potentially wrong optimization).",[42,793,794,798,799,348,801,803],{},[126,795,796],{},[31,797,264],{}," can be slower at runtime than ",[31,800,268],{},[31,802,272],{}," despite smaller binaries.",[18,805,807],{"id":806},"summary","Summary",[14,809,810,811,677,813,815,816,818,819,821],{},"Features are additive conditional-compilation flags. Design them additive-only. Use ",[31,812,75],{},[31,814,746],{}," for clean dep\u002Ffeature separation. Profiles control optimization and binary properties. ",[31,817,280],{}," enables codegen and linking. CI should run fmt\u002Fclippy\u002Ftest\u002Fdoc and cross-compile. Use ",[31,820,545],{}," for versioning and publishing. Set and test the MSRV.",[14,823,824],{},"Next: The deeper type system — variance, HRTBs, and tricky generics.",{"title":29,"searchDepth":826,"depth":826,"links":827},2,[828,833,834,837,838,842,844,846,855,856,857,858,859,860,861],{"id":20,"depth":826,"text":21,"children":829},[830,832],{"id":36,"depth":831,"text":37},3,{"id":62,"depth":831,"text":63},{"id":79,"depth":826,"text":80},{"id":99,"depth":826,"text":100,"children":835},[836],{"id":142,"depth":831,"text":143},{"id":149,"depth":826,"text":150},{"id":191,"depth":826,"text":192,"children":839},[840,841],{"id":201,"depth":831,"text":201},{"id":225,"depth":831,"text":226},{"id":276,"depth":826,"text":843},"Build Scripts (build.rs)",{"id":355,"depth":826,"text":845},"links Key",{"id":380,"depth":826,"text":381,"children":847},[848,849,850,851,852,853,854],{"id":384,"depth":831,"text":385},{"id":422,"depth":831,"text":423},{"id":456,"depth":831,"text":457},{"id":497,"depth":831,"text":498},{"id":531,"depth":831,"text":532},{"id":563,"depth":831,"text":564},{"id":587,"depth":831,"text":588},{"id":605,"depth":826,"text":606},{"id":631,"depth":826,"text":632},{"id":660,"depth":826,"text":661},{"id":698,"depth":826,"text":699},{"id":708,"depth":826,"text":709},{"id":727,"depth":826,"text":728},{"id":806,"depth":826,"text":807},"md",{},true,"\u002Frust\u002F28-cargo-features",{"title":5,"description":16},"rust\u002F28-cargo-features","tfhUA4l_UirIeSuZ-SZcD0UcwP7Ifg-UpqxJFL0s_58",1785935255233]