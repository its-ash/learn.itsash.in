[{"data":1,"prerenderedAt":2152},["ShallowReactive",2],{"page-\u002Frust\u002F31-performance":3},{"id":4,"title":5,"body":6,"description":2145,"extension":2146,"meta":2147,"navigation":174,"path":2148,"seo":2149,"stem":2150,"__hash__":2151},"content\u002Frust\u002F31-performance.md","31 — Performance",{"type":7,"value":8,"toc":2133},"minimark",[9,13,22,27,71,74,110,120,319,326,515,519,522,856,860,865,1070,1088,1092,1409,1413,1426,1572,1576,1636,1639,1671,1675,1750,1754,1810,1814,1950,1953,2115,2118,2126,2129],[10,11,5],"h1",{"id":12},"_31-performance",[14,15,16,17,21],"p",{},"Rust is fast by default, but the biggest wins still come from ",[18,19,20],"strong",{},"measuring"," and picking the right data structure — not from clever tricks.",[23,24,26],"h2",{"id":25},"rule-1-measure-in-release-mode","Rule 1: Measure in Release Mode",[28,29,31],"code-wrapper",{"language":30},"bash",[32,33,37],"pre",{"className":34,"code":35,"language":30,"meta":36,"style":36},"language-bash shiki shiki-themes github-light github-dark","cargo run             # debug: no optimizations — often 10–100× slower\ncargo run --release   # optimized — the only numbers that matter\n","",[38,39,40,57],"code",{"__ignoreMap":36},[41,42,45,49,53],"span",{"class":43,"line":44},"line",1,[41,46,48],{"class":47},"sIsaT","cargo",[41,50,52],{"class":51},"sJ6F3"," run",[41,54,56],{"class":55},"sdCPZ","             # debug: no optimizations — often 10–100× slower\n",[41,58,60,62,64,68],{"class":43,"line":59},2,[41,61,48],{"class":47},[41,63,52],{"class":51},[41,65,67],{"class":66},"snvgF"," --release",[41,69,70],{"class":55},"   # optimized — the only numbers that matter\n",[14,72,73],{},"The same summing loop (100 million additions), measured:",[75,76,77,90],"table",{},[78,79,80],"thead",{},[81,82,83,87],"tr",{},[84,85,86],"th",{},"Build",[84,88,89],{},"Time",[91,92,93,102],"tbody",{},[81,94,95,99],{},[96,97,98],"td",{},"debug",[96,100,101],{},"~540 ms",[81,103,104,107],{},[96,105,106],{},"release",[96,108,109],{},"~0 ms — the optimizer computed the answer without running the loop",[14,111,112,115,116,119],{},[18,113,114],{},"Tricky",": that second number is a lie in the other direction. If the result isn't used, the compiler may delete the work. Use ",[38,117,118],{},"std::hint::black_box"," when timing:",[28,121,123],{"language":122},"rust",[32,124,127],{"className":125,"code":126,"language":122,"meta":36,"style":36},"language-rust shiki shiki-themes github-light github-dark","use std::hint::black_box;\nuse std::time::Instant;\n\nfn main() {\n    let t = Instant::now();\n    let mut sum = 0u64;\n    for i in 0..100_000_000u64 {\n        sum = black_box(sum + i);      \u002F\u002F \"pretend this value is used\" — stops the optimizer cheating\n    }\n    println!(\"{:?} {sum}\", t.elapsed());   \u002F\u002F a real ~280ms, not 0\n}\n",[38,128,129,150,169,176,188,211,232,257,280,286,313],{"__ignoreMap":36},[41,130,131,135,138,141,144,146],{"class":43,"line":44},[41,132,134],{"class":133},"svdQ7","use",[41,136,137],{"class":47}," std",[41,139,140],{"class":133},"::",[41,142,143],{"class":47},"hint",[41,145,140],{"class":133},[41,147,149],{"class":148},"ssxIu","black_box;\n",[41,151,152,154,156,158,161,163,166],{"class":43,"line":59},[41,153,134],{"class":133},[41,155,137],{"class":47},[41,157,140],{"class":133},[41,159,160],{"class":47},"time",[41,162,140],{"class":133},[41,164,165],{"class":47},"Instant",[41,167,168],{"class":148},";\n",[41,170,172],{"class":43,"line":171},3,[41,173,175],{"emptyLinePlaceholder":174},true,"\n",[41,177,179,182,185],{"class":43,"line":178},4,[41,180,181],{"class":133},"fn",[41,183,184],{"class":47}," main",[41,186,187],{"class":148},"() {\n",[41,189,191,194,197,200,203,205,208],{"class":43,"line":190},5,[41,192,193],{"class":133},"    let",[41,195,196],{"class":148}," t ",[41,198,199],{"class":133},"=",[41,201,202],{"class":47}," Instant",[41,204,140],{"class":133},[41,206,207],{"class":47},"now",[41,209,210],{"class":148},"();\n",[41,212,21