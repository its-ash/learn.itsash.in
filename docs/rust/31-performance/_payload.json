[{"data":1,"prerenderedAt":1002},["ShallowReactive",2],{"page-\u002Frust\u002F31-performance":3},{"id":4,"title":5,"body":6,"description":16,"extension":995,"meta":996,"navigation":997,"path":998,"seo":999,"stem":1000,"__hash__":1001},"content\u002Frust\u002F31-performance.md","31 — Performance, Profiling & Optimization",{"type":7,"value":8,"toc":932},"minimark",[9,13,17,22,45,49,58,68,74,81,87,97,101,104,110,114,121,129,132,138,143,149,152,159,165,176,179,183,187,193,202,214,225,229,232,236,255,263,266,270,297,312,318,325,333,339,346,350,371,379,385,388,392,406,410,416,424,430,441,447,450,454,460,468,474,478,484,487,491,501,509,512,516,522,532,539,584,588,591,597,604,610,616,619,623,629,632,636,813,817,840,847,860,864,895,899,929],[10,11,5],"h1",{"id":12},"_31-performance-profiling-optimization",[14,15,16],"p",{},"Rust gives you C-level performance by default, but you can still write slow Rust. This chapter covers how to find and fix bottlenecks.",[18,19,21],"h2",{"id":20},"mindset","Mindset",[23,24,25,33,39],"ol",{},[26,27,28,32],"li",{},[29,30,31],"strong",{},"Don't optimize prematurely."," Write clear code; profile; optimize hot spots.",[26,34,35,38],{},[29,36,37],{},"Measure, measure, measure."," Intuition is often wrong.",[26,40,41,44],{},[29,42,43],{},"Iterate."," One change at a time; re-measure each time.",[18,46,48],{"id":47},"benchmarking","Benchmarking",[50,51,53,57],"h3",{"id":52},"cargo-bench-nightly",[54,55,56],"code",{},"cargo bench"," (nightly)",[59,60,66],"pre",{"className":61,"code":63,"language":64,"meta":65},[62],"language-rust","#![feature(test)]\nextern crate test;\nuse test::Bencher;\n\n#[bench]\nfn bench_add(b: &mut Bencher) {\n    b.iter(|| test::black_box(2) + test::black_box(2));\n}\n","rust","",[54,67,63],{"__ignoreMap":65},[14,69,70,73],{},[54,71,72],{},"black_box"," prevents the optimizer from constant-folding.",[50,75,77,80],{"id":76},"criterion-stable-recommended",[54,78,79],{},"criterion"," (stable, recommended)",[59,82,85],{"className":83,"code":84,"language":64,"meta":65},[62],"use criterion::{criterion_group, criterion_main, Criterion};\n\nfn bench_fib(c: &mut Criterion) {\n    c.bench_function(\"fib 20\", |b| b.iter(|| fib(black_box(20))));\n}\n\ncriterion_group!(benches, bench_fib);\ncriterion_main!(benches);\n",[54,86,84],{"__ignoreMap":65},[14,88,89,90,93,94,96],{},"In ",[54,91,92],{},"benches\u002Fmy_bench.rs",". Run with ",[54,95,56],{},". Criterion provides statistics, regressions, and HTML reports.",[50,98,100],{"id":99},"custom-benchmarks","Custom Benchmarks",[14,102,103],{},"For ad-hoc timing:",[59,105,108],{"className":106,"code":107,"language":64,"meta":65},[62],"let start = std::time::Instant::now();\nwork();\nlet elapsed = start.elapsed();\n",[54,109,107],{"__ignoreMap":65},[18,111,113],{"id":112},"profiling","Profiling",[50,115,117,120],{"id":116},"perf-linux",[54,118,119],{},"perf"," (Linux)",[59,122,127],{"className":123,"code":125,"language":126,"meta":65},[124],"language-bash","cargo build --release\nperf record -g .\u002Ftarget\u002Frelease\u002Fmy_app\nperf report\n","bash",[54,128,125],{"__ignoreMap":65},[14,130,131],{},"For flamegraphs:",[59,133,136],{"className":134,"code":135,"language":126,"meta":65},[124],"cargo install flamegraph\ncargo flamegraph\n",[54,137,135],{"__ignoreMap":65},[50,139,141],{"id":140},"samply",[54,142,140],{},[59,144,147],{"className":145,"code":146,"language":126,"meta":65},[124],"cargo install samply\nsamply record .\u002Ftarget\u002Frelease\u002Fmy_app\n",[54,148,146],{"__ignoreMap":65},[14,150,151],{},"Samply gives a web UI with call trees and source-level annotations.",[50,153,155,158],{"id":154},"instruments-macos",[54,156,157],{},"Instruments"," (macOS)",[59,160,163],{"className":161,"code":162,"language":126,"meta":65},[124],"xcrun xctrace record --template \"Time Profiler\" --launch .\u002Ftarget\u002Frelease\u002Fmy_app\n",[54,164,162],{"__ignoreMap":65},[50,166,168,171,172,175],{"id":167},"dtrace-vtune-advanced",[54,169,170],{},"dtrace",", ",[54,173,174],{},"vtune"," (advanced)",[14,177,178],{},"For deeper hardware analysis (cache misses, branch mispredicts).",[18,180,182],{"id":181},"optimization-techniques","Optimization Techniques",[50,184,186],{"id":185},"_1-avoid-unnecessary-allocation","1. Avoid Unnecessary Allocation",[59,188,191],{"className":189,"code":190,"language":64,"meta":65},[62],"\u002F\u002F Bad: allocates per call\nfn process(items: &[u8]) -> Vec\u003Cu8> { items.iter().map(|x| x + 1).collect() }\n\n\u002F\u002F Good: caller provides buffer\nfn process_into(items: &[u8], out: &mut [u8]) {\n    for (i, x) in items.iter().enumerate() { out[i] = x + 1; }\n}\n",[54,192,190],{"__ignoreMap":65},[14,194,195,171,198,201],{},[54,196,197],{},"String::with_capacity",[54,199,200],{},"Vec::with_capacity"," to avoid regrowth.",[50,203,205,206,209,210,213],{"id":204},"_2-use-t-str-in-apis","2. Use ",[54,207,208],{},"&[T]"," \u002F ",[54,211,212],{},"&str"," in APIs",[14,215,216,217,220,221,224],{},"Don't take ",[54,218,219],{},"&Vec\u003CT>"," or ",[54,222,223],{},"&String"," — they impose ownership and lose the more general slice form. Slices are flexible and equally fast.",[50,226,228],{"id":227},"_3-choose-iterators-over-explicit-loops-sometimes","3. Choose Iterators Over Explicit Loops (Sometimes)",[14,230,231],{},"Iterators often compile to tighter loops because the compiler can reason about them. But for very tight inner loops, the explicit form sometimes wins (or with manual SIMD). Profile both.",[50,233,235],{"id":234},"_4-box-large-struct-fields","4. Box Large Struct Fields",[14,237,238,239,242,243,246,247,250,251,254],{},"A struct with a large ",[54,240,241],{},"Vec"," field still has its ",[54,244,245],{},"(ptr, len, cap)"," header inline (24 bytes), but a large ",[54,248,249],{},"[u8; 1024]"," field makes the struct huge. Use ",[54,252,253],{},"Box\u003C[u8; 1024]>"," for large fixed-size data to keep the struct small (good for cache and copying).",[50,256,258,259,262],{"id":257},"_5-avoid-boxdyn-trait-in-hot-paths","5. Avoid ",[54,260,261],{},"Box\u003Cdyn Trait>"," in Hot Paths",[14,264,265],{},"Vtable indirection is ~few ns but kills inlining. Genericize hot paths.",[50,267,269],{"id":268},"_6-cache-locality","6. Cache Locality",[271,272,273,284,294],"ul",{},[26,274,275,276,279,280,283],{},"Flat ",[54,277,278],{},"Vec\u003CT>"," over ",[54,281,282],{},"Vec\u003CVec\u003CT>>",".",[26,285,286,289,290,293],{},[54,287,288],{},"ArrayVec","\u002F",[54,291,292],{},"SmallVec"," for inline storage.",[26,295,296],{},"Structure-of-arrays over array-of-structures for SIMD-friendly access.",[50,298,300,301,304,305,289,308,311],{"id":299},"_7-simd-via-stdsimd-nightly-or-widepulp-stable","7. SIMD via ",[54,302,303],{},"std::simd"," (nightly) or ",[54,306,307],{},"wide",[54,309,310],{},"pulp"," (stable)",[59,313,316],{"className":314,"code":315,"language":64,"meta":65},[62],"#![feature(portable_simd)]\nuse std::simd::f32x4;\nlet a = f32x4::from_array([1.0, 2.0, 3.0, 4.0]);\nlet b = f32x4::from_array([5.0, 6.0, 7.0, 8.0]);\nlet c = a + b;\n",[54,317,315],{"__ignoreMap":65},[14,319,320,321,324],{},"For auto-vectorization, write iterator chains and let LLVM do it; check with ",[54,322,323],{},"cargo asm"," or Godbolt.",[50,326,328,329,332],{"id":327},"_8-inline-selectively","8. ",[54,330,331],{},"#[inline]"," Selectively",[59,334,337],{"className":335,"code":336,"language":64,"meta":65},[62],"#[inline]\nfn small() -> u32 { \u002F* ... *\u002F }\n\n#[inline(always)]\nfn tiny() -> u32 { \u002F* ... *\u002F }\n",[54,338,336],{"__ignoreMap":65},[14,340,341,342,345],{},"Don't ",[54,343,344],{},"#[inline(always)]"," everywhere — it bloats code and hurts i-cache.",[50,347,349],{"id":348},"_9-avoid-heap-allocations-in-hot-loops","9. Avoid Heap Allocations in Hot Loops",[271,351,352,358,365],{},[26,353,354,355,283],{},"Reuse buffers via ",[54,356,357],{},"&mut Vec",[26,359,360,361,364],{},"Use ",[54,362,363],{},"arrayvec::ArrayVec"," for fixed-size buffers.",[26,366,360,367,370],{},[54,368,369],{},"smallvec::SmallVec"," for small-but-may-grow.",[50,372,374,375,378],{"id":373},"_10-use-mut-t-for-in-place-mutation","10. Use ",[54,376,377],{},"&mut [T]"," for In-Place Mutation",[59,380,383],{"className":381,"code":382,"language":64,"meta":65},[62],"fn sum_of_squares(v: &mut [i32]) {\n    for x in v.iter_mut() { *x = *x * *x; }\n}\n",[54,384,382],{"__ignoreMap":65},[14,386,387],{},"Avoids allocation; cache-friendly.",[50,389,391],{"id":390},"_11-lock-granularity","11. Lock Granularity",[271,393,394,400,403],{},[26,395,396,399],{},[54,397,398],{},"RwLock"," for read-heavy.",[26,401,402],{},"Shard locks across N buckets for parallel writes.",[26,404,405],{},"Lock-free via atomics when possible.",[50,407,409],{"id":408},"_12-avoid-reallocations","12. Avoid Reallocations",[59,411,414],{"className":412,"code":413,"language":64,"meta":65},[62],"let mut v = Vec::with_capacity(N);\nfor x in iter { v.push(x); }\n",[54,415,413],{"__ignoreMap":65},[50,417,419,420,423],{"id":418},"_13-use-arcclone-carefully","13. Use ",[54,421,422],{},"Arc::clone"," Carefully",[14,425,426,427,429],{},"Each ",[54,428,422],{}," does an atomic increment — much cheaper than a deep clone but not free. Avoid in tightest loops.",[50,431,433,434,437,438],{"id":432},"_14-memreplace-and-memtake","14. ",[54,435,436],{},"mem::replace"," and ",[54,439,440],{},"mem::take",[59,442,445],{"className":443,"code":444,"language":64,"meta":65},[62],"let old = mem::take(&mut self.buffer);   \u002F\u002F self.buffer is now empty\nprocess(old);\n",[54,446,444],{"__ignoreMap":65},[14,448,449],{},"Avoids cloning; useful for swap-and-go state.",[50,451,453],{"id":452},"_15-reduce-trait-object-dispatch","15. Reduce Trait Object Dispatch",[59,455,458],{"className":456,"code":457,"language":64,"meta":65},[62],"\u002F\u002F Generic\nfn sum\u003CT>(v: &[T]) -> T where T: Sum + Copy { v.iter().copied().sum() }\n\n\u002F\u002F Box\u003Cdyn> — slower\nfn sum_dyn(v: &[Box\u003Cdyn Additive>]) { \u002F* vtable per call *\u002F }\n",[54,459,457],{"__ignoreMap":65},[50,461,463,464,467],{"id":462},"_16-cow-to-avoid-allocations","16. ",[54,465,466],{},"Cow"," to Avoid Allocations",[59,469,472],{"className":470,"code":471,"language":64,"meta":65},[62],"fn normalize(s: &str) -> Cow\u003Cstr> {\n    if needs_transform(s) { Cow::Owned(s.to_uppercase()) } else { Cow::Borrowed(s) }\n}\n",[54,473,471],{"__ignoreMap":65},[50,475,477],{"id":476},"_17-pre-compute-and-cache","17. Pre-compute and Cache",[59,479,482],{"className":480,"code":481,"language":64,"meta":65},[62],"struct Cached { data: Vec\u003Cu8> }\nimpl Cached {\n    fn lookup(&self, key: usize) -> u8 { self.data[key] }\n}\n",[54,483,481],{"__ignoreMap":65},[14,485,486],{},"Avoid recomputing in hot paths.",[50,488,490],{"id":489},"_18-string-interning","18. String Interning",[14,492,493,494,289,497,500],{},"For repeated short strings, use ",[54,495,496],{},"string_interner",[54,498,499],{},"lasso"," to assign integer IDs.",[50,502,504,505,508],{"id":503},"_19-use-static-where-appropriate","19. Use ",[54,506,507],{},"&'static"," Where Appropriate",[14,510,511],{},"Avoids lifetime-tracking overhead in some generic contexts. Don't overuse.",[50,513,515],{"id":514},"_20-compile-time-computation","20. Compile-Time Computation",[59,517,520],{"className":518,"code":519,"language":64,"meta":65},[62],"const N: usize = 1000;\nlet arr = [0; N];\n",[54,521,519],{"__ignoreMap":65},[14,523,524,525,289,528,531],{},"Move computation to compile time via ",[54,526,527],{},"const",[54,529,530],{},"const fn"," when possible.",[18,533,535,538],{"id":534},"release-profile-pitfalls",[54,536,537],{},"release"," Profile Pitfalls",[271,540,541,560,568,576],{},[26,542,543,548,549,552,553,171,556,559],{},[29,544,545,546],{},"Default ",[54,547,537],{},": ",[54,550,551],{},"opt-level = 3"," but ",[54,554,555],{},"lto = false",[54,557,558],{},"codegen-units = 16"," (parallel compile, less optimization). For final binaries, bump these.",[26,561,562,567],{},[29,563,564],{},[54,565,566],{},"panic = \"abort\""," can unlock more optimizations (no unwinding tables).",[26,569,570,575],{},[29,571,572],{},[54,573,574],{},"strip = \"symbols\""," reduces binary size.",[26,577,578,583],{},[29,579,580],{},[54,581,582],{},"opt-level = \"z\""," minimizes size, often at a perf cost.",[18,585,587],{"id":586},"measuring-allocations","Measuring Allocations",[14,589,590],{},"Use a custom allocator that logs:",[59,592,595],{"className":593,"code":594,"language":64,"meta":65},[62],"use std::alloc::{GlobalAlloc, Layout, System};\n\nstruct Counting;\nunsafe impl GlobalAlloc for Counting {\n    unsafe fn alloc(&self, l: Layout) -> *mut u8 { eprintln!(\"alloc {:?}\", l); System.alloc(l) }\n    unsafe fn dealloc(&self, p: *mut u8, l: Layout) { System.dealloc(p, l) }\n}\n\n#[global_allocator]\nstatic A: Counting = Counting;\n",[54,596,594],{"__ignoreMap":65},[14,598,599,600,603],{},"Or use ",[54,601,602],{},"dhat"," for heap profiling.",[18,605,607],{"id":606},"cargo-bloat",[54,608,609],{},"cargo bloat",[59,611,614],{"className":612,"code":613,"language":126,"meta":65},[124],"cargo install cargo-bloat\ncargo bloat --release\ncargo bloat --release --crates\n",[54,615,613],{"__ignoreMap":65},[14,617,618],{},"Shows which functions take the most binary size.",[18,620,622],{"id":621},"inspecting-assembly","Inspecting Assembly",[59,624,627],{"className":625,"code":626,"language":126,"meta":65},[124],"cargo install cargo-asm\ncargo asm my_crate::function\n",[54,628,626],{"__ignoreMap":65},[14,630,631],{},"Or use Godbolt (godbolt.org) — paste Rust code, see assembly.",[18,633,635],{"id":634},"common-performance-pitfalls","Common Performance Pitfalls",[271,637,638,653,666,681,696,707,721,729,740,749,757,766,785,798],{},[26,639,640,649,650,283],{},[29,641,642,645,646],{},[54,643,644],{},"String::new()"," followed by many ",[54,647,648],{},"push_str",": use ",[54,651,652],{},"with_capacity",[26,654,655,661,662,665],{},[29,656,657,660],{},[54,658,659],{},"format!"," in hot loops",": pre-format or use ",[54,663,664],{},"write!"," into a reused buffer.",[26,667,668,548,674,289,677,680],{},[29,669,670,673],{},[54,671,672],{},"Vec\u003Cu8>"," for byte parsing",[54,675,676],{},"bytes::Bytes",[54,678,679],{},"BytesMut"," are often faster.",[26,682,683,649,689,289,692,695],{},[29,684,685,688],{},[54,686,687],{},"HashMap"," with crypto-strong hash",[54,690,691],{},"FxHashMap",[54,693,694],{},"AHashMap"," for non-adversarial keys.",[26,697,698,548,704,706],{},[29,699,700,703],{},[54,701,702],{},"Vec::push"," in a counted loop",[54,705,200],{}," once.",[26,708,709,718,719,283],{},[29,710,711,714,715,717],{},[54,712,713],{},"to_string()"," on a ",[54,716,212],{}," you only need to read",": just use the ",[54,720,212],{},[26,722,723,728],{},[29,724,725,727],{},[54,726,422],{}," in inner loop",": clone once, reuse.",[26,730,731,649,736,739],{},[29,732,733,735],{},[54,734,687],{}," lookup-then-insert",[54,737,738],{},"entry"," (one hash).",[26,741,742,748],{},[29,743,744,745],{},"Locks held across ",[54,746,747],{},"await",": contention; drop lock first.",[26,750,751,756],{},[29,752,753,755],{},[54,754,282],{}," matrices",": flat layout + index math is faster.",[26,758,759,765],{},[29,760,761,764],{},[54,762,763],{},"Box\u003Cdyn>"," in inner loops",": indirect calls prevent inlining.",[26,767,768,548,777,780,781,784],{},[29,769,770,773,774],{},[54,771,772],{},"cloned()"," instead of ",[54,775,776],{},"copied()",[54,778,779],{},"copied"," is faster for ",[54,782,783],{},"Copy"," types.",[26,786,787,649,795,797],{},[29,788,789,791,792],{},[54,790,672],{}," from ",[54,793,794],{},"read_to_end",[54,796,200],{}," if size is known.",[26,799,800,548,809,812],{},[29,801,802,805,806],{},[54,803,804],{},"String::from_utf8"," then ",[54,807,808],{},"unwrap",[54,810,811],{},"from_utf8_lossy"," avoids the check.",[18,814,816],{"id":815},"memory-layout","Memory Layout",[271,818,819,825,831,837],{},[26,820,821,824],{},[54,822,823],{},"#[repr(C)]",": fixed, predictable, no padding-optimization.",[26,826,827,830],{},[54,828,829],{},"#[repr(transparent)]",": same layout as inner.",[26,832,833,836],{},[54,834,835],{},"#[repr(packed)]",": no padding, alignment 1 — slow on many platforms, UB risk.",[26,838,839],{},"Field reordering (default Rust layout) minimizes padding; let the compiler do it.",[18,841,843,846],{"id":842},"stdalloc-layout",[54,844,845],{},"std::alloc"," Layout",[14,848,849,850,853,854,289,857,859],{},"Allocations must be aligned to ",[54,851,852],{},"Layout::align",". Mismatched alignment is UB. ",[54,855,856],{},"Box::new_uninit_slice",[54,858,200],{}," handle this for you.",[18,861,863],{"id":862},"async-performance","Async Performance",[271,865,866,873,886,889],{},[26,867,868,869,872],{},"Avoid ",[54,870,871],{},"Box\u003Cdyn Future>"," in hot paths; use generics.",[26,874,868,875,878,879,289,882,885],{},[54,876,877],{},"tokio::spawn"," for short-lived work — overhead. Use ",[54,880,881],{},"join!",[54,883,884],{},"FuturesUnordered"," instead.",[26,887,888],{},"Bounded channels for backpressure (vs unbounded that grow).",[26,890,891,894],{},[54,892,893],{},"current_thread"," runtime for single-threaded apps.",[18,896,898],{"id":897},"summary","Summary",[14,900,901,902,171,904,171,907,171,909,911,912,171,915,917,918,920,921,924,925,928],{},"Profile with ",[54,903,79],{},[54,905,906],{},"flamegraph",[54,908,140],{},[54,910,609],{},". Optimize hot paths: avoid allocation, use slices, generic over ",[54,913,914],{},"dyn",[54,916,652],{},", lock granularity, SIMD. Use ",[54,919,537],{}," profile + ",[54,922,923],{},"lto = \"fat\""," + ",[54,926,927],{},"codegen-units = 1"," for final binaries. Don't trust intuition; measure. Iterate.",[14,930,931],{},"Next: Documentation.",{"title":65,"searchDepth":933,"depth":933,"links":934},2,[935,936,944,953,984,986,987,988,989,990,991,993,994],{"id":20,"depth":933,"text":21},{"id":47,"depth":933,"text":48,"children":937},[938,941,943],{"id":52,"depth":939,"text":940},3,"cargo bench (nightly)",{"id":76,"depth":939,"text":942},"criterion (stable, recommended)",{"id":99,"depth":939,"text":100},{"id":112,"depth":933,"text":113,"children":945},[946,948,949,951],{"id":116,"depth":939,"text":947},"perf (Linux)",{"id":140,"depth":939,"text":140},{"id":154,"depth":939,"text":950},"Instruments (macOS)",{"id":167,"depth":939,"text":952},"dtrace, vtune (advanced)",{"id":181,"depth":933,"text":182,"children":954},[955,956,958,959,960,962,963,965,967,968,970,971,972,974,976,977,979,980,981,983],{"id":185,"depth":939,"text":186},{"id":204,"depth":939,"text":957},"2. Use &[T] \u002F &str in APIs",{"id":227,"depth":939,"text":228},{"id":234,"depth":939,"text":235},{"id":257,"depth":939,"text":961},"5. Avoid Box\u003Cdyn Trait> in Hot Paths",{"id":268,"depth":939,"text":269},{"id":299,"depth":939,"text":964},"7. SIMD via std::simd (nightly) or wide\u002Fpulp (stable)",{"id":327,"depth":939,"text":966},"8. #[inline] Selectively",{"id":348,"depth":939,"text":349},{"id":373,"depth":939,"text":969},"10. Use &mut [T] for In-Place Mutation",{"id":390,"depth":939,"text":391},{"id":408,"depth":939,"text":409},{"id":418,"depth":939,"text":973},"13. Use Arc::clone Carefully",{"id":432,"depth":939,"text":975},"14. mem::replace and mem::take",{"id":452,"depth":939,"text":453},{"id":462,"depth":939,"text":978},"16. Cow to Avoid Allocations",{"id":476,"depth":939,"text":477},{"id":489,"depth":939,"text":490},{"id":503,"depth":939,"text":982},"19. Use &'static Where Appropriate",{"id":514,"depth":939,"text":515},{"id":534,"depth":933,"text":985},"release Profile Pitfalls",{"id":586,"depth":933,"text":587},{"id":606,"depth":933,"text":609},{"id":621,"depth":933,"text":622},{"id":634,"depth":933,"text":635},{"id":815,"depth":933,"text":816},{"id":842,"depth":933,"text":992},"std::alloc Layout",{"id":862,"depth":933,"text":863},{"id":897,"depth":933,"text":898},"md",{},true,"\u002Frust\u002F31-performance",{"title":5,"description":16},"rust\u002F31-performance","RJjv0IN7bYgvMC4fFS3VH3nWySWbfdRXGP37jOcVs5E",1785934122654]