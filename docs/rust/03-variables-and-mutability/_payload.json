350,352],{"className":29,"code":351,"language":25,"meta":31,"style":31},"const MAX_POINTS: u32 = 100_000;\n",[18,353,354],{"__ignoreMap":31},[35,355,356,359,362,365,368,371,374],{"class":37,"line":38},[35,357,358],{"class":41},"const",[35,360,361],{"class":51}," MAX_POINTS",[35,363,364],{"class":41},":",[35,366,367],{"class":192}," u32",[35,369,370],{"class":41}," =",[35,372,373],{"class":51}," 100_000",[35,375,95],{"class":44},[377,378,379,385,388,394,397,400],"ul",{},[380,381,382,384],"li",{},[18,383,358],{}," is evaluated at compile time (must be a constant expression).",[380,386,387],{},"Always annotated with a type.",[380,389,390,391,189],{},"Conventionally ",[18,392,393],{},"SCREAMING_SNAKE_CASE",[380,395,396],{},"Inlined everywhere; no fixed memory address.",[380,398,399],{},"Can be declared in any scope, including module\u002Fglobal.",[380,401,402,403,405,406,408,409,189],{},"Cannot shadow ",[18,404,116],{}," (they're always immutable); a ",[18,407,358],{}," cannot be ",[18,410,116],{},[23,412,413],{"language":25},[27,414,416],{"className":29,"code":415,"language":25,"meta":31,"style":31},"const FACTOR: f64 = 1.5;\nconst fn double(x: i32) -> i32 { x * 2 }   \u002F\u002F const fn: callable in const context\nconst ANSWER: i32 = double(21);\n",[18,417,418,437,476],{"__ignoreMap":31},[35,419,420,422,425,427,430,432,435],{"class":37,"line":38},[35,421,358],{"class":41},[35,423,424],{"class":51}," FACTOR",[35,426,364],{"class":41},[35,428,429],{"class":192}," f64",[35,431,370],{"class":41},[35,433,434],{"class":51}," 1.5",[35,436,95],{"class":44},[35,438,439,441,444,447,450,452,455,458,461,463,466,468,470,473],{"class":37,"line":62},[35,440,358],{"class":41},[35,442,443],{"class":41}," fn",[35,445,446],{"class":192}," double",[35,448,449],{"class":44},"(x",[35,451,364],{"class":41},[35,453,454],{"class":192}," i32",[35,456,457],{"class":44},") ",[35,459,460],{"class":41},"->",[35,462,454],{"class":192},[35,464,465],{"class":44}," { x ",[35,467,226],{"class":41},[35,469,229],{"class":51},[35,471,472],{"class":44}," }   ",[35,474,475],{"class":58},"\u002F\u002F const fn: callable in const context\n",[35,477,478,480,483,485,487,489,491,493,496],{"class":37,"line":83},[35,479,358],{"class":41},[35,481,482],{"class":51}," ANSWER",[35,484,364],{"class":41},[35,486,454],{"class":192},[35,488,370],{"class":41},[35,490,446],{"class":192},[35,492,243],{"class":44},[35,494,495],{"class":51},"21",[35,497,498],{"class":44},");\n",[106,500,501,504],{},[18,502,503],{},"const fn"," allows a restricted subset of Rust at compile time (no heap, limited control flow historically; improving each release).",[14,506,508],{"id":507},"statics","Statics",[277,510,512],{"id":511},"why-does-this-exist","Why does this exist?",[106,514,515,516,519,520,523,524,526,527,529,530,533,534,536,537,539,540,543],{},"A ",[18,517,518],{},"static"," is a value that lives at a ",[110,521,522],{},"single, fixed memory address for the entire program",". This is the key difference from ",[18,525,358],{},": a ",[18,528,358],{}," is ",[129,531,532],{},"inlined"," at every use site (no single home), while a ",[18,535,518],{}," has one home and every reference points to the same memory. You reach for ",[18,538,518],{}," when you need that stable identity — most commonly to obtain a ",[18,541,542],{},"&'static"," reference (e.g., handing a string or config struct to FFI, or embedding a lookup table that must outlive every function call).",[106,545,546,547,549,550,552,553,556,557,559,560,562],{},"Because ",[18,548,518],{}," has a fixed address, it also enables patterns ",[18,551,358],{}," can't: storing a heap type behind a lazy initializer (",[18,554,555],{},"OnceLock\u003CString>","), or acting as a global singleton. The tradeoff: a ",[18,558,518],{}," is a real runtime object, so it has a real memory footprint, unlike ",[18,561,358],{}," which vanishes into immediate values.",[277,564,566],{"id":565},"how-to-use-it","How to use it",[23,568,569],{"language":25},[27,570,572],{"className":29,"code":571,"language":25,"meta":31,"style":31},"static LANGUAGE: &str = \"Rust\";       \u002F\u002F &'static str — lives forever\nstatic mut COUNTER: u32 = 0;          \u002F\u002F mutable static — unsafe to read\u002Fwrite\n",[18,573,574,600],{"__ignoreMap":31},[35,575,576,578,581,583,586,589,591,594,597],{"class":37,"line":38},[35,577,518],{"class":41},[35,579,580],{"class":51}," LANGUAGE",[35,582,364],{"class":41},[35,584,585],{"class":41}," &",[35,587,588],{"class":192},"str",[35,590,370],{"class":41},[35,592,593],{"class":246}," \"Rust\"",[35,595,596],{"class":44},";       ",[35,598,599],{"class":58},"\u002F\u002F &'static str — lives forever\n",[35,601,602,604,606,609,611,613,615,618,620],{"class":37,"line":62},[35,603,518],{"class":41},[35,605,67],{"class":41},[35,607,608],{"class":51}," COUNTER",[35,610,364],{"class":41},[35,612,367],{"class":192},[35,614,370],{"class":41},[35,616,617],{"class":51}," 0",[35,619,55],{"class":44},[35,621,622],{"class":58},"\u002F\u002F mutable static — unsafe to read\u002Fwrite\n",[377,624,625,628,644],{},[380,626,627],{},"Have a fixed memory address for the program's lifetime.",[380,629,630,633,634,637,638],{},[18,631,632],{},"static mut"," requires ",[18,635,636],{},"unsafe"," to access (no synchronization) — ",[110,639,640,641,643],{},"data races on ",[18,642,632],{}," are undefined behavior.",[380,645,646,647,650,651,653,654,657],{},"Use atomics (",[18,648,649],{},"std::sync::atomic",") instead of ",[18,652,632],{}," for counters; use ",[18,655,656],{},"OnceLock"," for lazy globals.",[277,659,661,662,664,665],{"id":660},"when-to-choose-static-vs-const","When to choose ",[18,663,518],{}," vs ",[18,666,358],{},[284,668,669,679],{},[287,670,671],{},[290,672,673,676],{},[293,674,675],{},"Need",[293,677,678],{},"Reach for",[303,680,681,690,702],{},[290,682,683,686],{},[308,684,685],{},"A compile-time constant value, inlined everywhere, no address identity",[308,687,688],{},[18,689,358],{},[290,691,692,698],{},[308,693,694,695,697],{},"A stable ",[18,696,542],{}," reference, a global singleton, or a lazy-initialized global",[308,699,700],{},[18,701,518],{},[290,703,704,707],{},[308,705,706],{},"A mutable global counter \u002F flag",[308,708,709,710,712,713],{},"atomics in a ",[18,711,518],{},", never ",[18,714,632],{},[14,716,718],{"id":717},"type-inference","Type Inference",[23,720,721],{"language":25},[27,722,724],{"className":29,"code":723,"language":25,"meta":31,"style":31},"let v = vec![1, 2, 3];      \u002F\u002F Vec\u003Ci32>\nlet s = \"hi\";               \u002F\u002F &str\nlet n = 1.0;                \u002F\u002F f64 (default float)\nlet i = 1;                  \u002F\u002F i32 (default integer)\nlet b = true;\n",[18,725,726,761,779,797,814],{"__ignoreMap":31},[35,727,728,730,733,735,738,741,744,747,750,752,755,758],{"class":37,"line":38},[35,729,20],{"class":41},[35,731,732],{"class":44}," v ",[35,734,48],{"class":41},[35,736,737],{"class":192}," vec!",[35,739,740],{"class":44},"[",[35,742,743],{"class":51},"1",[35,745,746],{"class":44},", ",[35,748,749],{"class":51},"2",[35,751,746],{"class":44},[35,753,754],{"class":51},"3",[35,756,757],{"class":44},"];      ",[35,759,760],{"class":58},"\u002F\u002F Vec\u003Ci32>\n",[35,762,763,765,768,770,773,776],{"class":37,"line":62},[35,764,20],{"class":41},[35,766,767],{"class":44}," s ",[35,769,48],{"class":41},[35,771,772],{"class":246}," \"hi\"",[35,774,775],{"class":44},";               ",[35,777,778],{"class":58},"\u002F\u002F &str\n",[35,780,781,783,786,788,791,794],{"class":37,"line":83},[35,782,20],{"class":41},[35,784,785],{"class":44}," n ",[35,787,48],{"class":41},[35,789,790],{"class":51}," 1.0",[35,792,793],{"class":44},";                ",[35,795,796],{"class":58},"\u002F\u002F f64 (default float)\n",[35,798,799,801,804,806,808,811],{"class":37,"line":98},[35,800,20],{"class":41},[35,802,803],{"class":44}," i ",[35,805,48],{"class":41},[35,807,92],{"class":51},[35,809,810],{"class":44},";                  "