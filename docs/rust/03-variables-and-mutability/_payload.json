licit ",[18,1561,20],{}," to shadow, not reassignment.",[380,1564,1565,1312,1568,1571,1572,1575,1576,1579,1580,189],{},[110,1566,1567],{},"Mutable binding ≠ mutable reference",[18,1569,1570],{},"let mut x = 5; x = 6;"," works, but ",[18,1573,1574],{},"let x = 5; x = 6;"," is a compile error. A ",[18,1577,1578],{},"&mut"," reference lets you mutate if the underlying binding is ",[18,1581,116],{},[380,1583,1584,1312,1587,1511,1590,1592],{},[110,1585,1586],{},"Drop order with shadowing",[18,1588,1589],{},"let x = String::from(\"a\"); let x = String::from(\"b\");",[18,1591,1481],{}," is dropped at the end of its scope, not at the statement boundary.",[380,1594,1595,1312,1598,1601,1602,1605,1606,1609,1610,1613,1614,1617,1618,189],{},[110,1596,1597],{},"Partial moves and shadowing",[18,1599,1600],{},"let s = String::from(\"hi\"); let s = &s;"," is a rebind (not move), ",[18,1603,1604],{},"s"," is now a reference. But ",[18,1607,1608],{},"let (a, b) = (String::from(\"hi\"), 5); let a = 10;"," shadows ",[18,1611,1612],{},"a"," only, ",[18,1615,1616],{},"b"," still holds the ",[18,1619,1481],{},[380,1621,1622,1629,1630,1632,1633,1635],{},[110,1623,1624,633,1626,1628],{},[18,1625,632],{},[18,1627,636],{}," to read\u002Fwrite",": Even reading a ",[18,1631,632],{}," is undefined behavior without synchronization; use ",[18,1634,649],{}," for thread-safe access.",[14,1637,1639],{"id":1638},"spot-the-bug","🧠 Spot the Bug",[106,1641,1642],{},"What does this print?",[23,1644,1645],{"language":25},[27,1646,1648],{"className":29,"code":1647,"language":25,"meta":31,"style":31},"struct Guard(i32);\n\nimpl Drop for Guard {\n    fn drop(&mut self) {\n        println!(\"dropping {}\", self.0);\n    }\n}\n\nfn main() {\n    let g = Guard(1);\n    let g = Guard(2);\n    println!(\"end of main\");\n}\n",[18,1649,1650,1664,1668,1684,1702,1724,1729,1733,1737,1748,1766,1783,1795],{"__ignoreMap":31},[35,1651,1652,1655,1658,1660,1662],{"class":37,"line":38},[35,1653,1654],{"class":41},"struct",[35