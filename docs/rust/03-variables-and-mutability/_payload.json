[{"data":1,"prerenderedAt":489},["ShallowReactive",2],{"page-\u002Frust\u002F03-variables-and-mutability":3},{"id":4,"title":5,"body":6,"description":29,"extension":482,"meta":483,"navigation":484,"path":485,"seo":486,"stem":487,"__hash__":488},"content\u002Frust\u002F03-variables-and-mutability.md","03 — Variables & Mutability",{"type":7,"value":8,"toc":462},"minimark",[9,13,22,32,45,49,64,70,77,131,137,141,147,184,190,196,200,206,231,235,241,244,250,256,261,267,271,277,287,291,432,438,441,447,451],[10,11,5],"h1",{"id":12},"_03-variables-mutability",[14,15,17,21],"h2",{"id":16},"let-and-immutability-by-default",[18,19,20],"code",{},"let"," and Immutability by Default",[23,24,30],"pre",{"className":25,"code":27,"language":28,"meta":29},[26],"language-rust","let x = 5;          \u002F\u002F immutable\nlet mut y = 5;      \u002F\u002F mutable\ny += 1;\n\u002F\u002F x = 6;           \u002F\u002F ERROR: cannot assign twice to immutable variable\n","rust","",[18,31,27],{"__ignoreMap":29},[33,34,35,36,40,41,44],"p",{},"Rust variables are ",[37,38,39],"strong",{},"immutable by default",". You must opt into mutation with ",[18,42,43],{},"mut",". This isn't a philosophical stance — it lets the compiler reason about aliasing for ownership and concurrency guarantees.",[14,46,48],{"id":47},"shadowing","Shadowing",[33,50,51,52,54,55,59,60,63],{},"A new ",[18,53,20],{}," with the same name ",[56,57,58],"em",{},"shadows"," the previous binding. The old value still gets dropped at end of scope; shadowing creates a ",[37,61,62],{},"new"," binding (possibly a new type).",[23,65,68],{"className":66,"code":67,"language":28,"meta":29},[26],"let x = 5;\nlet x = x + 1;          \u002F\u002F shadows, same type\nlet x = x.to_string();  \u002F\u002F shadows with new type — totally fine\n\n{\n    let x = x * 2;      \u002F\u002F shadows inside block\n    println!(\"{x}\");    \u002F\u002F 12\n}\nprintln!(\"{x}\");        \u002F\u002F 6 (block shadow gone)\n",[18,69,67],{"__ignoreMap":29},[71,72,74,75],"h3",{"id":73},"shadowing-vs-mut","Shadowing vs ",[18,76,43],{},[78,79,80,96],"table",{},[81,82,83],"thead",{},[84,85,86,90,92],"tr",{},[87,88,89],"th",{},"Feature",[87,91,48],{},[87,93,94],{},[18,95,43],{},[97,98,99,111,120],"tbody",{},[84,100,101,105,108],{},[102,103,104],"td",{},"New binding?",[102,106,107],{},"Yes",[102,109,110],{},"No",[84,112,113,116,118],{},[102,114,115],{},"Can change type?",[102,117,107],{},[102,119,110],{},[84,121,122,125,128],{},[102,123,124],{},"Requires initialization at declaration?",[102,126,127],{},"No (can be uninit then assign)",[102,129,130],{},"Yes (must assign)",[33,132,133,134,136],{},"Use shadowing to transform a value into a different type\u002Fshape; use ",[18,135,43],{}," to evolve one value.",[14,138,140],{"id":139},"constants","Constants",[23,142,145],{"className":143,"code":144,"language":28,"meta":29},[26],"const MAX_POINTS: u32 = 100_000;\n",[18,146,144],{"__ignoreMap":29},[148,149,150,157,160,167,170,173],"ul",{},[151,152,153,156],"li",{},[18,154,155],{},"const"," is evaluated at compile time (must be a constant expression).",[151,158,159],{},"Always annotated with a type.",[151,161,162,163,166],{},"Conventionally ",[18,164,165],{},"SCREAMING_SNAKE_CASE",".",[151,168,169],{},"Inlined everywhere; no fixed memory address.",[151,171,172],{},"Can be declared in any scope, including module\u002Fglobal.",[151,174,175,176,178,179,181,182,166],{},"Cannot shadow ",[18,177,43],{}," (they're always immutable); a ",[18,180,155],{}," cannot be ",[18,183,43],{},[23,185,188],{"className":186,"code":187,"language":28,"meta":29},[26],"const FACTOR: f64 = 1.5;\nconst fn double(x: i32) -> i32 { x * 2 }   \u002F\u002F const fn: callable in const context\nconst ANSWER: i32 = double(21);\n",[18,189,187],{"__ignoreMap":29},[33,191,192,195],{},[18,193,194],{},"const fn"," allows a restricted subset of Rust at compile time (no heap, limited control flow historically; improving each release).",[14,197,199],{"id":198},"statics","Statics",[23,201,204],{"className":202,"code":203,"language":28,"meta":29},[26],"static LANGUAGE: &str = \"Rust\";\nstatic mut COUNTER: u32 = 0;   \u002F\u002F mutable static — unsafe to read\u002Fwrite\n",[18,205,203],{"__ignoreMap":29},[148,207,208,211,221],{},[151,209,210],{},"Have a fixed memory address for the program's lifetime.",[151,212,213,216,217,220],{},[18,214,215],{},"static mut"," requires ",[18,218,219],{},"unsafe"," to access (no synchronization).",[151,222,223,224,227,228,230],{},"Use atomics (",[18,225,226],{},"std::sync::atomic",") instead of ",[18,229,215],{}," for counters.",[14,232,234],{"id":233},"type-inference","Type Inference",[23,236,239],{"className":237,"code":238,"language":28,"meta":29},[26],"let v = vec![1, 2, 3];      \u002F\u002F Vec\u003Ci32>\nlet s = \"hi\";               \u002F\u002F &str\nlet n = 1.0;                \u002F\u002F f64 (default float)\nlet i = 1;                  \u002F\u002F i32 (default integer)\nlet b = true;\n",[18,240,238],{"__ignoreMap":29},[33,242,243],{},"When the type can't be inferred, add an annotation:",[23,245,248],{"className":246,"code":247,"language":28,"meta":29},[26],"let mut v: Vec\u003Cu8> = Vec::new();\nlet n: u64 = 42;\nlet parsed = \"42\".parse::\u003Ci32>().unwrap();\n",[18,249,247],{"__ignoreMap":29},[14,251,253,255],{"id":252},"let-patterns-destructuring",[18,254,20],{}," Patterns (Destructuring)",[33,257,258,260],{},[18,259,20],{}," is a pattern, not just a binding:",[23,262,265],{"className":263,"code":264,"language":28,"meta":29},[26],"let (a, b, c) = (1, 2, 3);\nlet [first, ..] = [1, 2, 3];        \u002F\u002F slice pattern (limited on stable)\nlet (x, ..) = (1, 2, 3, 4);         \u002F\u002F ignore rest\nlet Point { x, y } = point;          \u002F\u002F struct destructuring\nlet (Ok(v) | Err(v)) = result.map(|n| n + 1).map_err(|e| 0); \u002F\u002F or-pattern binding\n",[18,266,264],{"__ignoreMap":29},[14,268,270],{"id":269},"mutable-references-vs-mutable-variables","Mutable References vs Mutable Variables",[23,272,275],{"className":273,"code":274,"language":28,"meta":29},[26],"let mut v = vec![1, 2, 3];\nv.push(4);\n\nlet r = &mut v;     \u002F\u002F mutable reference (covered in Borrowing chapter)\nr.push(5);\n",[18,276,274],{"__ignoreMap":29},[33,278,279,280,283,284,286],{},"A ",[18,281,282],{},"&mut T"," requires the underlying binding to be ",[18,285,43],{}," too (you can't take a mutable borrow of an immutable binding).",[14,288,290],{"id":289},"edge-cases-pitfalls","Edge Cases & Pitfalls",[148,292,293,312,325,337,352,386,402,412,423],{},[151,294,295,300,301,304,305,307,308,311],{},[37,296,297,298],{},"Unused ",[18,299,43],{},": ",[18,302,303],{},"warning: variable does not need to be mutable",". Fix by removing ",[18,306,43],{}," or prefix ",[18,309,310],{},"_mut"," if intentional.",[151,313,314,300,317,320,321,324],{},[37,315,316],{},"Unused variables",[18,318,319],{},"let _x = 5;"," (leading underscore) suppresses the warning; ",[18,322,323],{},"_"," itself drops the value immediately.",[151,326,327,332,333,336],{},[37,328,329],{},[18,330,331],{},"let _ = expr;"," evaluates ",[18,334,335],{},"expr"," then immediately drops the result — useful for side effects.",[151,338,339,342,343,346,347,349,350,166],{},[37,340,341],{},"Capture in closures",": a closure capturing ",[18,344,345],{},"x"," immutably borrows; capturing mutably requires the variable to be ",[18,348,43],{}," and the closure itself ",[18,351,43],{},[151,353,354,357,358,361,362,361,365,368,369,371,372,375,376,379,380,379,383,166],{},[37,355,356],{},"Const generics \u002F types in const",": types like ",[18,359,360],{},"Vec",", ",[18,363,364],{},"String",[18,366,367],{},"Box"," can't live in ",[18,370,155],{}," context (no heap at compile time), but they can in ",[18,373,374],{},"static"," only via ",[18,377,378],{},"lazy_static","\u002F",[18,381,382],{},"once_cell",[18,384,385],{},"std::sync::OnceLock",[151,387,388,300,391,394,395,398,399,401],{},[37,389,390],{},"Shadowing footgun",[18,392,393],{},"let x = something_that_panic();"," after ",[18,396,397],{},"let x = 5;"," — the first ",[18,400,345],{}," is shadowed and dropped at scope end, but the panic happens during init of the new binding.",[151,403,404,407,408,411],{},[37,405,406],{},"Initialization required",": Rust has no \"uninitialized variable\" UB like C. ",[18,409,410],{},"let x: i32;"," followed by a read before any assignment is a compile error.",[151,413,414,300,419,422],{},[37,415,416,418],{},[18,417,20],{}," chains (unstable)",[18,420,421],{},"let Some(x) = opt && x > 0"," — not stable; use explicit checks.",[151,424,425,300,428,431],{},[37,426,427],{},"Tuples and unit",[18,429,430],{},"let () = some_fn();"," pattern-matches that the function returns unit; useful for \"I expect this to return nothing.\"",[14,433,435,437],{"id":434},"let-else-165",[18,436,20],{},"-else (1.65+)",[33,439,440],{},"Diverge if a pattern doesn't match:",[23,442,445],{"className":443,"code":444,"language":28,"meta":29},[26],"let Some(x) = maybe_value else {\n    return; \u002F\u002F or panic!, break, continue, etc.\n};\n\u002F\u002F x is bound and in scope here\n",[18,446,444],{"__ignoreMap":29},[14,448,450],{"id":449},"summary","Summary",[33,452,453,454,456,457,379,459,461],{},"Variables are immutable by default; use ",[18,455,43],{}," for evolution, shadowing for transformation, ",[18,458,155],{},[18,460,374],{}," for compile-time\u002Fglobal values. Next: the full type system.",{"title":29,"searchDepth":463,"depth":463,"links":464},2,[465,467,472,473,474,475,477,478,479,481],{"id":16,"depth":463,"text":466},"let and Immutability by Default",{"id":47,"depth":463,"text":48,"children":468},[469],{"id":73,"depth":470,"text":471},3,"Shadowing vs mut",{"id":139,"depth":463,"text":140},{"id":198,"depth":463,"text":199},{"id":233,"depth":463,"text":234},{"id":252,"depth":463,"text":476},"let Patterns (Destructuring)",{"id":269,"depth":463,"text":270},{"id":289,"depth":463,"text":290},{"id":434,"depth":463,"text":480},"let-else (1.65+)",{"id":449,"depth":463,"text":450},"md",{},true,"\u002Frust\u002F03-variables-and-mutability",{"title":5,"description":29},"rust\u002F03-variables-and-mutability","KscGt0BSYz2a7uaQXIXky7CqEk6ZZyWcInWytmaopPs",1785934755594]