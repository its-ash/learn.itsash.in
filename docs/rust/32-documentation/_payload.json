,[44,1184,85],{"class":50},[14,1186,1187,1188,1191],{},"Setup lines prefixed with ",[18,1189,1190],{},"#"," are hidden in the rendered doc but executed.",[27,1193,1195],{"id":1194},"doc-test-pitfalls","Doc Test Pitfalls",[174,1197,1198,1212,1221,1228,1241],{},[177,1199,1200,1203,1204,1207,1208,1211],{},[223,1201,1202],{},"External crate imports",": doc tests need ",[18,1205,1206],{},"extern crate"," or ",[18,1209,1210],{},"use"," lines.",[177,1213,1214,1220],{},[223,1215,1216,1217,1219],{},"Top-level ",[18,1218,1210],{}," shadowing",": each doc test is its own crate.",[177,1222,1223,1227],{},[223,1224,1225],{},[18,1226,593],{}," must be on a fenced block, and the block must actually fail to compile.",[177,1229,1230,1237,1238,1240],{},[223,1231,1232,753,1234],{},[18,1233,581],{},[18,1235,1236],{},"main",": works; ",[18,1239,581],{}," compiles but skips execution.",[177,1242,1243,1246,1247,541],{},[223,1244,1245],{},"Doc tests are slow",": skip in CI with ",[18,1248,1249],{},"cargo test --lib --bins --tests",[27,1251,1253,1256],{"id":1252},"mdbook-for-standalone-docs",[18,1254,1255],{},"mdbook"," for Standalone Docs",[14,1258,1259,1260,1262],{},"For guides\u002Fbooks, ",[18,1261,1255],{}," is the standard tool:",[32,1264,1265],{"language":467},[36,1266,1268],{"className":470,"code":1267,"language":467,"meta":40,"style":40},"cargo install mdbook\nmdbook init docs\nmdbook serve docs\n",[18,1269,1270,1280,1290],{"__ignoreMap":40},[44,1271,1272,1274,1277],{"class":46,"line":47},[44,1273,478],{"class":137},[44,1275,1276],{"class":481}," install",[44,1278,1279],{"class":481}," mdbook\n",[44,1281,1282,1284,1287],{"class":46,"line":54},[44,1283,1255],{"class":137},[44,1285,1286],{"class":481}," init",[44,1288,1289],{"class":481}," docs\n",[44,1291,1292,1294,1297],{"class":46,"line":60},[44,1293,1255],{"class":137},[44,1295,1296],{"class":481}," serve",[44,1298,1289],{"class":481},[14,1300,1301,1302,1305,1306,1305,1309,1312],{},"Many major Rust projects (",[18,1303,1304],{},"rust-lang\u002Frust",", ",[18,1307,1308],{},"tokio",[18,1310,1311],{},"bevy",") have mdbook guides alongside rustdoc.",[27,1314,1316],{"id":1315},"publishing-docs","Publishing Docs",[174,1318,1319],{},[177,1320,1321,1324,1325,145],{},[223,1322,1323],{},"docs.rs",": auto-builds and hosts docs for crates published to crates.io. Configure with ",[18,1326,1327],{},"[package.metadata.docs.rs]",[32,1329,1331],{"language":1330},"toml",[36,1332,1335],{"className":1333,"code":1334,"language":1330,"meta":40,"style":40},"language-toml shiki shiki-themes github-light github-dark","[package.metadata.docs.rs]\nfeatures = [\"full\", \"all-feature-flags\"]\nall-features = true\nrustdoc-args = [\"--cfg\", \"docsrs\"]\n",[18,1336,1337,1363,1378,1386],{"__ignoreMap":40},[44,1338,1339,1342,1345,1347,1350,1352,1355,1357,1360],{"class":46,"line":47},[44,1340,1341],{"class":141},"[",[44,1343,1344],{"class":137},"package",[44,1346,541],{"class":141},[44,1348,1349],{"class":137},"metadata",[44,1351,541],{"class":141},[44,1353,1354],{"class":137},"docs",[44,1356,541],{"class":141},[44,1358,1359],{"class":137},"rs",[44,1361,1362],{"class":141},"]\n",[44,1364,1365,1368,1371,1373,1376],{"class":46,"line":54},[44,1366,1367],{"class":141},"features = [",[44,1369,1370],{"class":481},"\"full\"",[44,1372,1305],{"class":141},[44,1374,1375],{"class":481},"\"all-feature-flags\"",[44,1377,1362],{"class":141},[44,1379,1380,1383],{"class":46,"line":60},[44,1381,1382],{"class":141},"all-features = ",[44,1384,1385],{"class":494},"true\n",[44,1387,1388,1391,1394,1396,1399],{"class":46,"line":66},[44,1389,1390],{"class":141},"rustdoc-args = [",[44,1392,1393],{"class":481},"\"--cfg\"",[44,1395,1305],{"class":141},[44,1397,1398],{"class":481},"\"docsrs\"",[44,1400,1362],{"class":141},[174,1402,1403,1412],{},[177,1404,1405,1408,1409,1411],{},[223,1406,1407],{},"GitHub Pages",": deploy ",[18,1410,540],{}," via Actions.",[177,1413,1414,1419],{},[223,1415,1416],{},[18,1417,1418],{},"cargo-docs-rs",": preview docs.rs rendering locally.",[27,1421,1423],{"id":1422},"cross-crate-doc-links","Cross-Crate Doc Links",[32,1425,1426],{"language":34},[36,1427,1429],{"className":38,"code":1428,"language":34,"meta":40,"style":40},"\u002F\u002F\u002F See the [`serde`] crate for serialization.\n\u002F\u002F\u002F See [`tokio::sync::mpsc`] for channels.\n",[18,1430,1431,1436],{"__ignoreMap":40},[44,1432,1433],{"class":46,"line":47},[44,1434,1435],{"class":50},"\u002F\u002F\u002F See the [`serde`] crate for serialization.\n",[44,1437,1438],{"class":46,"line":54},[44,1439,1440],{"class":50},"\u002F\u002F\u002F See [`tokio::sync::mpsc`] for channels.\n",[14,1442,1443,1444,541],{},"rustdoc can resolve links to external crates if they're in your ",[18,1445,1446],{},"Cargo.toml",[27,1448,1450],{"id":1449},"common-pitfalls","Common Pitfalls",[174,1452,1453,1462,1471,1477,1486,1499,1507],{},[177,1454,1455,1458,1459,541],{},[223,1456,1457],{},"Broken intra-doc links",": rustdoc warns; turn into errors with ",[18,1460,1461],{},"#![warn(rustdoc::broken_intra_doc_links)]",[177,1463,1464,1467,1468,541],{},[223,1465,1466],{},"Missing crate-level docs",": ",[18,1469,1470],{},"#![warn(rustdoc::missing_crate_level_docs)]",[177,1472,1473,1476],{},[223,1474,1475],{},"Examples don't compile",": CI runs doc tests; broken examples break releases.",[177,1478,1479,1485],{},[223,1480,1481,1484],{},[18,1482,1483],{},"#[doc(hidden)]"," on re-exports",": hides the re-export but not the original.",[177,1487,1488,1494,1495,1498],{},[223,1489,1490,1491,1493],{},"Hidden ",[18,1492,1190],{}," lines visible in source",": they're hidden in HTML but visible in ",[18,1496,1497],{},".rs"," source.",[177,1500,1501,1506],{},[223,1502,1503],{},[18,1504,1505],{},"#![doc(html_logo_url = \"...\")]",": branding on docs.",[177,1508,1509,1514],{},[223,1510,1511],{},[18,1512,1513],{},"#![doc(html_root_url = \"https:\u002F\u002Fdocs.rs\u002Fcrate\u002F1.0\")]",": helps intra-doc link resolution.",[27,1516,1518],{"id":1517},"tips-tricks","💡 Tips & Tricks",[174,1520,1521,1532,1550,1562,1574,1590],{},[177,1522,1523,1467,1525,1528,1529,1531],{},[223,1524,772],{},[18,1526,1527],{},"cargo doc --open"," after any doc-comment change is the fastest feedback loop — rendering catches malformed intra-doc links and broken Markdown that reading the raw ",[18,1530,24],{}," comments won't reveal.",[177,1533,1534,1537,1538,1541,1542,1545,1546,1549],{},[223,1535,1536],{},"Idiom",": use hidden ",[18,1539,1540],{},"# "," setup lines liberally in doc examples (",[18,1543,1544],{},"# use my_crate::Thing;",") — they keep the ",[258,1547,1548],{},"rendered"," example focused on the interesting part while still compiling and running as a real doc test with all necessary imports.",[177,1551,1552,1467,1554,1557,1558,1561],{},[223,1553,772],{},[18,1555,1556],{},"cargo test --doc -- --nocapture"," shows ",[18,1559,1560],{},"println!"," output from inside doc tests, useful when a doc example is supposed to demonstrate output but you can't tell if it's actually producing what the prose claims.",[177,1563,1564,1566,1567,1569,1570,1573],{},[223,1565,1536],{},": write the ",[18,1568,235],{}," section ",[258,1571,1572],{},"first",", before the prose — if you can't write a compiling example quickly, that's often a sign the API itself needs simplifying, not just better docs.",[177,1575,1576,1579,1580,1582,1583,1585,1586,1589],{},[223,1577,1578],{},"Performance",": doc tests compile as separate binaries and meaningfully slow down ",[18,1581,575],{}," on large crates — many projects run ",[18,1584,1249],{}," in fast CI stages and reserve full doc-test runs (",[18,1587,1588],{},"cargo test --doc",") for a slower, separate job.",[177,1591,1592,1595,1596,1598],{},[223,1593,1594],{},"Clippy\u002Flint",": turn on ",[18,1597,756],{}," early in a library's life, not late — retrofitting documentation onto a large, already-public API surface is a much bigger task than requiring docs as each item is added.",[27,1600,1602],{"id":1601},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[174,1604,1605,1620,1631,1652,1663,1683,1708],{},[177,1606,1607,1616,1617,1619],{},[223,1608,1609,1610,1612,1613],{},"A broken doc example fails ",[18,1611,575],{},", not just ",[18,1614,1615],{},"cargo doc",": doc tests are compiled and executed by ",[18,1618,575],{}," by default — a renamed function that isn't updated in a doc comment's example doesn't just produce stale documentation, it breaks the build, which surprises contributors who think of docs as \"just comments.\"",[177,1621,1622,1630],{},[223,1623,1490,1624,1626,1627,1629],{},[18,1625,1190],{}," lines are invisible in rendered HTML but fully visible in the ",[18,1628,1497],{}," source file",": anyone reading the source directly (not the generated docs) sees every hidden setup line — don't hide anything security-sensitive or misleading there, since \"hidden\" only means hidden from the doc viewer.",[177,1632,1633,1638,1639,1641,1642,1645,1646,1648,1649,1651],{},[223,1634,1635,1637],{},[18,1636,593],{}," doc tests can pass for the wrong reason",": a ",[18,1640,593],{}," block only asserts the code ",[258,1643,1644],{},"fails to compile"," — it doesn't check ",[258,1647,960],{},". A typo that produces an unrelated syntax error still satisfies ",[18,1650,593],{},", silently defeating the intent of demonstrating a specific type error.",[177,1653,1654,1638,1659,1662],{},[223,1655,1656,1658],{},[18,1657,1483],{}," hides an item from docs but does not make it private",[18,1660,1661],{},"#[doc(hidden)] pub fn"," is still fully callable by any downstream crate — hiding it from documentation is not an access-control mechanism, just a visibility hint for doc generation, a distinction that matters for semver (you can still break callers of a \"hidden\" function).",[177,1664,1665,1467,1668,1671,1672,1675,1676,1679,1680,1682],{},[223,1666,1667],{},"Intra-doc links resolve based on what's in scope at that exact item, not the whole crate",[18,1669,1670],{},"[MyType]"," inside a doc comment on a function in module ",[18,1673,1674],{},"a"," won't resolve if ",[18,1677,1678],{},"MyType"," isn't imported or reachable from module ",[18,1681,1674],{},"'s scope, even if it's a well-known type used everywhere else in the crate — the link-breakage is per-item, not global.",[177,1684,1685,1690,1691,1694,1695,1698,1699,1702,1703,1705,1706,541],{},[223,1686,1687,1689],{},[18,1688,1615],{}," succeeding locally doesn't guarantee docs.rs succeeds",": docs.rs builds with specific feature flags and sometimes a pinned toolchain; a crate that needs ",[18,1692,1693],{},"all-features = true"," or a ",[18,1696,1697],{},"docsrs","-specific ",[18,1700,1701],{},"cfg"," and doesn't declare it in ",[18,1704,1327],{}," can fail or render incompletely on docs.rs while looking fine with a plain local ",[18,1707,1615],{},[177,1709,1710,1713],{},[223,1711,1712],{},"Platform-independent trap — doc tests run with the crate's default features only, unless configured",": a doc example that references a feature-gated type without the feature enabled compiles fine when that feature happens to be a default, then breaks the moment someone changes the crate's default-features set, since doc tests don't automatically enable every feature.",[27,1715,1717],{"id":1716},"spot-the-bug","🧠 Spot the Bug",[14,1719,1720,1721,1723,1724,1727],{},"Why does ",[18,1722,575],{}," fail here, even though the function itself is correct and ",[18,1725,1726],{},"cargo build"," succeeds?",[32,1729,1730],{"language":34},[36,1731,1733],{"className":38,"code":1732,"language":34,"meta":40,"style":40},"\u002F\u002F\u002F Doubles a number.\n\u002F\u002F\u002F\n\u002F\u002F\u002F # Examples\n\u002F\u002F\u002F\n\u002F\u002F\u002F ```\n\u002F\u002F\u002F let result = double(21);\n\u002F\u002F\u002F assert_eq!(result, 42);\n\u002F\u002F\u002F ```\npub fn double(n: i32) -> i32 {\n    n * 2\n}\n",[18,1734,1735,1740,1744,1748,1752,1756,1761,1766,1770,1794,1805],{"__ignoreMap":40},[44,1736,1737],{"class":46,"line":47},[44,1738,1739],{"class":50},"\u002F\u002F\u002F Doubles a number.\n",[44,1741,1742],{"class":46,"line":54},[44,1743,57],{"class":50},[44,1745,1746],{"class":46,"line":60},[44,1747,74],{"class":50},[44,1749,1750],{"class":46,"line":66},[44,1751,57],{"class":50},[44,1753,1754],{"class":46,"line":71},[44,1755,85],{"class":50},[44,1757,1758],{"class":46,"line":77},[44,1759,1760],{"class":50},"\u002F\u002F\u002F let result = double(21);\n",[44,1762,1763],{"class":46,"line":82},[44,1764,1765],{"class":50},"\u002F\u002F\u002F assert_eq!(result, 42);\n",[44,1767,1768],{"class":46,"line":88},[44,1769,85],{"class":50},[44,1771,1772,1774,1776,1779,1781,1783,1785,1787,1789,1791],{"class":46,"line":94},[44,1773,131],{"class":130},[44,1775,134],{"class":130},[44,1777,1778],{"class":137}," double",[44,1780,1079],{"class":141},[44,1782,145],{"class":130},[44,1784,148],{"class":137},[44,1786,158],{"class":141},[44,1788,161],{"class":130},[44,1790,148],{"class":137},[44,1792,1793],{"class":141}," {\n",[44,1795,1796,1799,1802],{"class":46,"line":100},[44,1797,1798],{"class":141},"    n ",[44,1800,1801],{"class":130},"*",[44,1803,1804],{"class":494}," 2\n",[44,1806,1807],{"class":46,"line":105},[44,1808,1809],{"class":141},"}\n",[1811,1812,1813,1817,1824,1860],"details",{},[1814,1815,1816],"summary",{},"Answer",[14,1818,1819,1820,1823],{},"The doc test fails to compile: ",[18,1821,1822],{},"error[E0425]: cannot find function \\","double` in this scope`.",[14,1825,1826,1827,1830,1831,1834,1835,1838,1839,1841,1842,1845,1846,1848,1849,757,1851,1853,1854,806,1856,1859],{},"Every fenced code block in a doc comment is compiled as its ",[223,1828,1829],{},"own separate crate"," — it does not automatically have access to the items of the crate it's documenting, no matter how \"obviously nearby\" the function looks in the source file. The example calls ",[18,1832,1833],{},"double(21)"," directly, but from that isolated doc-test crate's perspective, ",[18,1836,1837],{},"double"," doesn't exist unless it's explicitly brought into scope with a ",[18,1840,1210],{}," statement, exactly as any external consumer of the published crate would have to do: ",[18,1843,1844],{},"use my_crate::double;",". This is easy to miss because ",[18,1847,1726],{}," never runs doc tests at all — only ",[18,1850,575],{},[18,1852,1588],{},") compiles and executes them, so the mistake can sit unnoticed through every ",[18,1855,1726],{},[18,1857,1858],{},"cargo check"," cycle during development.",[14,1861,1862,1865,1866,1868,1869,1872],{},[223,1863,1864],{},"The lesson",": doc tests are independent crates with no implicit access to the crate they document — always ",[18,1867,1210],{}," the item you're demonstrating, ideally as a hidden ",[18,1870,1871],{},"# use"," line to keep the rendered example clean.",[27,1874,1875],{"id":1814},"Summary",[14,1877,1878,1879,1305,1881,1883,1884,973,1886,1888,1889,1891,1892,1894,1895,1897],{},"Write doc comments (",[18,1880,24],{},[18,1882,186],{},") with standard sections (Examples, Panics, Errors, Safety). Run ",[18,1885,1615],{},[18,1887,575],{}," (doc tests). Use hidden ",[18,1890,1190],{}," lines for setup. Cross-reference with backticks. Enable ",[18,1893,740],{}," for libraries. Publish to docs.rs. Use ",[18,1896,1255],{}," for guides.",[14,1899,1900],{},"Next: Rust ecosystem tour.",[1902,1903,1904],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration