[{"data":1,"prerenderedAt":685},["ShallowReactive",2],{"page-\u002Frust\u002F32-documentation":3},{"id":4,"title":5,"body":6,"description":677,"extension":678,"meta":679,"navigation":680,"path":681,"seo":682,"stem":683,"__hash__":684},"content\u002Frust\u002F32-documentation.md","32 — Documentation",{"type":7,"value":8,"toc":650},"minimark",[9,13,26,31,41,56,62,66,167,170,174,180,183,189,193,201,208,212,218,256,262,266,272,276,282,288,292,298,301,308,314,317,321,358,362,367,373,377,383,387,393,400,404,460,467,473,479,493,497,509,517,536,540,546,552,556,620,624,647],[10,11,5],"h1",{"id":12},"_32-documentation",[14,15,16,17,21,22,25],"p",{},"Documentation is part of the Rust culture. ",[18,19,20],"code",{},"rustdoc"," produces HTML docs from ",[18,23,24],{},"\u002F\u002F\u002F"," comments; doc-tests run examples.",[27,28,30],"h2",{"id":29},"doc-comments","Doc Comments",[32,33,39],"pre",{"className":34,"code":36,"language":37,"meta":38},[35],"language-rust","\u002F\u002F\u002F Adds two integers.\n\u002F\u002F\u002F\n\u002F\u002F\u002F Returns `a + b`, panicking on overflow in debug builds.\n\u002F\u002F\u002F\n\u002F\u002F\u002F # Examples\n\u002F\u002F\u002F\n\u002F\u002F\u002F ```\n\u002F\u002F\u002F use my_crate::add;\n\u002F\u002F\u002F assert_eq!(add(2, 2), 4);\n\u002F\u002F\u002F ```\n\u002F\u002F\u002F\n\u002F\u002F\u002F # Panics\n\u002F\u002F\u002F\n\u002F\u002F\u002F Panics if `a + b` overflows in debug mode.\npub fn add(a: i32, b: i32) -> i32 { a + b }\n","rust","",[18,40,36],{"__ignoreMap":38},[42,43,44,50],"ul",{},[45,46,47,49],"li",{},[18,48,24],{}," for items (functions, types, modules).",[45,51,52,55],{},[18,53,54],{},"\u002F\u002F!"," for the enclosing item (crate root, module — used for top-level docs).",[32,57,60],{"className":58,"code":59,"language":37,"meta":38},[35],"\u002F\u002F! # My Crate\n\u002F\u002F!\n\u002F\u002F! This crate provides wonderful things.\n",[18,61,59],{"__ignoreMap":38},[27,63,65],{"id":64},"standard-sections","Standard Sections",[67,68,69,82],"table",{},[70,71,72],"thead",{},[73,74,75,79],"tr",{},[76,77,78],"th",{},"Section",[76,80,81],{},"Purpose",[83,84,85,96,106,124,137,147,157],"tbody",{},[73,86,87,93],{},[88,89,90],"td",{},[18,91,92],{},"# Examples",[88,94,95],{},"Usage examples (run as doc tests).",[73,97,98,103],{},[88,99,100],{},[18,101,102],{},"# Panics",[88,104,105],{},"When the function panics.",[73,107,108,113],{},[88,109,110],{},[18,111,112],{},"# Errors",[88,114,115,116,119,120,123],{},"For ",[18,117,118],{},"Result","-returning functions: which ",[18,121,122],{},"Err"," variants.",[73,125,126,131],{},[88,127,128],{},[18,129,130],{},"# Safety",[88,132,115,133,136],{},[18,134,135],{},"unsafe"," functions: required invariants.",[73,138,139,144],{},[88,140,141],{},[18,142,143],{},"# Arguments",[88,145,146],{},"Parameter docs (sometimes redundant with prose).",[73,148,149,154],{},[88,150,151],{},[18,152,153],{},"# Returns",[88,155,156],{},"Return value docs.",[73,158,159,164],{},[88,160,161],{},[18,162,163],{},"# Notes",[88,165,166],{},"Extra info.",[14,168,169],{},"The order convention: Examples, Panics, Errors, Safety.",[27,171,173],{"id":172},"cross-references","Cross-References",[32,175,178],{"className":176,"code":177,"language":37,"meta":38},[35],"\u002F\u002F\u002F See [`std::fs::read`] for reading a file.\n\u002F\u002F\u002F Uses [`OtherType::method`] internally.\n\u002F\u002F\u002F Implements [`MyTrait`].\n",[18,179,177],{"__ignoreMap":38},[14,181,182],{},"Backticks create hyperlinks. rustdoc resolves intra-doc links.",[32,184,187],{"className":185,"code":186,"language":37,"meta":38},[35],"\u002F\u002F\u002F [`OtherType`] is in scope.\n\u002F\u002F\u002F [`crate::sub::Thing`]\n",[18,188,186],{"__ignoreMap":38},[27,190,192],{"id":191},"building-docs","Building Docs",[32,194,199],{"className":195,"code":197,"language":198,"meta":38},[196],"language-bash","cargo doc                  # generate for the crate\ncargo doc --open           # generate and open in browser\ncargo doc --no-deps        # skip dependencies\ncargo doc --workspace      # all crates in workspace\ncargo doc --document-private-items  # include private items (rare)\n","bash",[18,200,197],{"__ignoreMap":38},[14,202,203,204,207],{},"Output goes to ",[18,205,206],{},"target\u002Fdoc\u002F",".",[27,209,211],{"id":210},"doc-tests-recap","Doc Tests (Recap)",[32,213,216],{"className":214,"code":215,"language":37,"meta":38},[35],"\u002F\u002F\u002F ```\n\u002F\u002F\u002F use my_crate::add;\n\u002F\u002F\u002F assert_eq!(add(2, 2), 4);\n\u002F\u002F\u002F ```\n",[18,217,215],{"__ignoreMap":38},[42,219,220,226,232,238,244,250],{},[45,221,222,225],{},[18,223,224],{},"cargo test"," runs them.",[45,227,228,231],{},[18,229,230],{},"no_run",": compile but don't execute.",[45,233,234,237],{},[18,235,236],{},"ignore",": skip.",[45,239,240,243],{},[18,241,242],{},"compile_fail",": assert it doesn't compile (negative test).",[45,245,246,249],{},[18,247,248],{},"rust,edition2018",": pin edition.",[45,251,252,255],{},[18,253,254],{},"# use ..."," lines are hidden in rendered docs but executed in tests.",[32,257,260],{"className":258,"code":259,"language":37,"meta":38},[35],"\u002F\u002F\u002F ```\n\u002F\u002F\u002F # use my_crate::add;\n\u002F\u002F\u002F assert_eq!(add(2, 2), 4);\n\u002F\u002F\u002F ```\n",[18,261,259],{"__ignoreMap":38},[27,263,265],{"id":264},"doc-attributes","Doc Attributes",[32,267,270],{"className":268,"code":269,"language":37,"meta":38},[35],"#[doc(hidden)]            \u002F\u002F hide from docs (still public)\n#[doc(alias = \"another\")] \u002F\u002F search alias\n#[doc = \"raw text\"]      \u002F\u002F alternative to \u002F\u002F\u002F for non-string content\n#[doc(inline)]           \u002F\u002F inline re-exports\n#[doc(no_inline)]        \u002F\u002F don't inline\n#[doc(cfg(feature = \"...\"))]  \u002F\u002F show \"Available on feature only\" banner\n",[18,271,269],{"__ignoreMap":38},[27,273,275],{"id":274},"lints","Lints",[32,277,280],{"className":278,"code":279,"language":37,"meta":38},[35],"#![warn(missing_docs)]\n#![warn(missing_debug_implementations)]\n#![warn(rustdoc::broken_intra_doc_links)]\n#![warn(rustdoc::missing_crate_level_docs)]\n",[18,281,279],{"__ignoreMap":38},[14,283,284,287],{},[18,285,286],{},"missing_docs"," forces every public item to have docs — good for libraries.",[27,289,291],{"id":290},"crate-level-docs","Crate-Level Docs",[32,293,296],{"className":294,"code":295,"language":37,"meta":38},[35],"\u002F\u002F src\u002Flib.rs\n\u002F\u002F! # My Crate\n\u002F\u002F!\n\u002F\u002F! This crate does X for Y.\n\u002F\u002F!\n\u002F\u002F! ## Quick Start\n\u002F\u002F! ```\n\u002F\u002F! use my_crate::*;\n\u002F\u002F! ```\n",[18,297,295],{"__ignoreMap":38},[14,299,300],{},"Include a quick-start at the crate root.",[27,302,304,307],{"id":303},"readmemd-inclusion",[18,305,306],{},"README.md"," Inclusion",[32,309,312],{"className":310,"code":311,"language":37,"meta":38},[35],"#![doc = include_str!(\"..\u002FREADME.md\")]\n",[18,313,311],{"__ignoreMap":38},[14,315,316],{},"Treats the README as crate-level docs. Common for projects that want one source of truth.",[27,318,320],{"id":319},"style-guide","Style Guide",[42,322,323,326,337,340,349,352,355],{},[45,324,325],{},"Write prose, not telegrams. Sentences with verbs.",[45,327,328,329,333,334,207],{},"Document the ",[330,331,332],"em",{},"why",", not just the ",[330,335,336],{},"what",[45,338,339],{},"Examples for every public function that's not obvious.",[45,341,342,343,345,346,348],{},"Use ",[18,344,102],{}," and ",[18,347,112],{}," sections consistently.",[45,350,351],{},"Cross-reference related items.",[45,353,354],{},"Keep examples small and self-contained.",[45,356,357],{},"Avoid docs on trivial getters\u002Fsetters; document the field instead.",[27,359,361],{"id":360},"examples","Examples",[363,364,366],"h3",{"id":365},"good","Good",[32,368,371],{"className":369,"code":370,"language":37,"meta":38},[35],"\u002F\u002F\u002F Computes the Fibonacci number at position `n`.\n\u002F\u002F\u002F\n\u002F\u002F\u002F Uses an iterative algorithm with O(n) time and O(1) space.\n\u002F\u002F\u002F\n\u002F\u002F\u002F # Examples\n\u002F\u002F\u002F\n\u002F\u002F\u002F ```\n\u002F\u002F\u002F use my_crate::fib;\n\u002F\u002F\u002F assert_eq!(fib(0), 0);\n\u002F\u002F\u002F assert_eq!(fib(10), 55);\n\u002F\u002F\u002F ```\n\u002F\u002F\u002F\n\u002F\u002F\u002F # Panics\n\u002F\u002F\u002F\n\u002F\u002F\u002F Panics if `n` is large enough to overflow `u64`.\npub fn fib(n: u64) -> u64 { \u002F* ... *\u002F 0 }\n",[18,372,370],{"__ignoreMap":38},[363,374,376],{"id":375},"bad","Bad",[32,378,381],{"className":379,"code":380,"language":37,"meta":38},[35],"\u002F\u002F\u002F fib function\npub fn fib(n: u64) -> u64 { 0 }\n",[18,382,380],{"__ignoreMap":38},[27,384,386],{"id":385},"hidden-examples-for-complex-setup","Hidden Examples for Complex Setup",[32,388,391],{"className":389,"code":390,"language":37,"meta":38},[35],"\u002F\u002F\u002F ```\n\u002F\u002F\u002F # use std::sync::Arc;\n\u002F\u002F\u002F # use std::sync::Mutex;\n\u002F\u002F\u002F # let state = Arc::new(Mutex::new(0));\n\u002F\u002F\u002F let _v = state.lock().unwrap();\n\u002F\u002F\u002F ```\n",[18,392,390],{"__ignoreMap":38},[14,394,395,396,399],{},"Setup lines prefixed with ",[18,397,398],{},"#"," are hidden in the rendered doc but executed.",[27,401,403],{"id":402},"doc-test-pitfalls","Doc Test Pitfalls",[42,405,406,421,430,437,451],{},[45,407,408,412,413,416,417,420],{},[409,410,411],"strong",{},"External crate imports",": doc tests need ",[18,414,415],{},"extern crate"," or ",[18,418,419],{},"use"," lines.",[45,422,423,429],{},[409,424,425,426,428],{},"Top-level ",[18,427,419],{}," shadowing",": each doc test is its own crate.",[45,431,432,436],{},[409,433,434],{},[18,435,242],{}," must be on a fenced block, and the block must actually fail to compile.",[45,438,439,447,448,450],{},[409,440,441,443,444],{},[18,442,230],{}," with ",[18,445,446],{},"main",": works; ",[18,449,230],{}," compiles but skips execution.",[45,452,453,456,457,207],{},[409,454,455],{},"Doc tests are slow",": skip in CI with ",[18,458,459],{},"cargo test --lib --bins --tests",[27,461,463,466],{"id":462},"mdbook-for-standalone-docs",[18,464,465],{},"mdbook"," for Standalone Docs",[14,468,469,470,472],{},"For guides\u002Fbooks, ",[18,471,465],{}," is the standard tool:",[32,474,477],{"className":475,"code":476,"language":198,"meta":38},[196],"cargo install mdbook\nmdbook init docs\nmdbook serve docs\n",[18,478,476],{"__ignoreMap":38},[14,480,481,482,485,486,485,489,492],{},"Many major Rust projects (",[18,483,484],{},"rust-lang\u002Frust",", ",[18,487,488],{},"tokio",[18,490,491],{},"bevy",") have mdbook guides alongside rustdoc.",[27,494,496],{"id":495},"publishing-docs","Publishing Docs",[42,498,499],{},[45,500,501,504,505,508],{},[409,502,503],{},"docs.rs",": auto-builds and hosts docs for crates published to crates.io. Configure with ",[18,506,507],{},"[package.metadata.docs.rs]",":",[32,510,515],{"className":511,"code":513,"language":514,"meta":38},[512],"language-toml","[package.metadata.docs.rs]\nfeatures = [\"full\", \"all-feature-flags\"]\nall-features = true\nrustdoc-args = [\"--cfg\", \"docsrs\"]\n","toml",[18,516,513],{"__ignoreMap":38},[42,518,519,528],{},[45,520,521,524,525,527],{},[409,522,523],{},"GitHub Pages",": deploy ",[18,526,206],{}," via Actions.",[45,529,530,535],{},[409,531,532],{},[18,533,534],{},"cargo-docs-rs",": preview docs.rs rendering locally.",[27,537,539],{"id":538},"cross-crate-doc-links","Cross-Crate Doc Links",[32,541,544],{"className":542,"code":543,"language":37,"meta":38},[35],"\u002F\u002F\u002F See the [`serde`] crate for serialization.\n\u002F\u002F\u002F See [`tokio::sync::mpsc`] for channels.\n",[18,545,543],{"__ignoreMap":38},[14,547,548,549,207],{},"rustdoc can resolve links to external crates if they're in your ",[18,550,551],{},"Cargo.toml",[27,553,555],{"id":554},"common-pitfalls","Common Pitfalls",[42,557,558,567,576,582,591,604,612],{},[45,559,560,563,564,207],{},[409,561,562],{},"Broken intra-doc links",": rustdoc warns; turn into errors with ",[18,565,566],{},"#![warn(rustdoc::broken_intra_doc_links)]",[45,568,569,572,573,207],{},[409,570,571],{},"Missing crate-level docs",": ",[18,574,575],{},"#![warn(rustdoc::missing_crate_level_docs)]",[45,577,578,581],{},[409,579,580],{},"Examples don't compile",": CI runs doc tests; broken examples break releases.",[45,583,584,590],{},[409,585,586,589],{},[18,587,588],{},"#[doc(hidden)]"," on re-exports",": hides the re-export but not the original.",[45,592,593,599,600,603],{},[409,594,595,596,598],{},"Hidden ",[18,597,398],{}," lines visible in source",": they're hidden in HTML but visible in ",[18,601,602],{},".rs"," source.",[45,605,606,611],{},[409,607,608],{},[18,609,610],{},"#![doc(html_logo_url = \"...\")]",": branding on docs.",[45,613,614,619],{},[409,615,616],{},[18,617,618],{},"#![doc(html_root_url = \"https:\u002F\u002Fdocs.rs\u002Fcrate\u002F1.0\")]",": helps intra-doc link resolution.",[27,621,623],{"id":622},"summary","Summary",[14,625,626,627,485,629,631,632,345,635,637,638,640,641,643,644,646],{},"Write doc comments (",[18,628,24],{},[18,630,54],{},") with standard sections (Examples, Panics, Errors, Safety). Run ",[18,633,634],{},"cargo doc",[18,636,224],{}," (doc tests). Use hidden ",[18,639,398],{}," lines for setup. Cross-reference with backticks. Enable ",[18,642,286],{}," for libraries. Publish to docs.rs. Use ",[18,645,465],{}," for guides.",[14,648,649],{},"Next: Rust ecosystem tour.",{"title":38,"searchDepth":651,"depth":651,"links":652},2,[653,654,655,656,657,658,659,660,661,663,664,669,670,671,673,674,675,676],{"id":29,"depth":651,"text":30},{"id":64,"depth":651,"text":65},{"id":172,"depth":651,"text":173},{"id":191,"depth":651,"text":192},{"id":210,"depth":651,"text":211},{"id":264,"depth":651,"text":265},{"id":274,"depth":651,"text":275},{"id":290,"depth":651,"text":291},{"id":303,"depth":651,"text":662},"README.md Inclusion",{"id":319,"depth":651,"text":320},{"id":360,"depth":651,"text":361,"children":665},[666,668],{"id":365,"depth":667,"text":366},3,{"id":375,"depth":667,"text":376},{"id":385,"depth":651,"text":386},{"id":402,"depth":651,"text":403},{"id":462,"depth":651,"text":672},"mdbook for Standalone Docs",{"id":495,"depth":651,"text":496},{"id":538,"depth":651,"text":539},{"id":554,"depth":651,"text":555},{"id":622,"depth":651,"text":623},"Documentation is part of the Rust culture. rustdoc produces HTML docs from \u002F\u002F\u002F comments; doc-tests run examples.","md",{},true,"\u002Frust\u002F32-documentation",{"title":5,"description":677},"rust\u002F32-documentation","TzIJQHsCSnu8p_Z7DgtAJXFwPevQVBvB7nYH9ErT9a4",1785934755943]