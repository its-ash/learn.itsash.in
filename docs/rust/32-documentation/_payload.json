nough to overflow `u64`.\n",[44,886,888,890,892,895,898,900,903,905,907,909,912,915,918],{"class":46,"line":887},16,[44,889,131],{"class":130},[44,891,134],{"class":130},[44,893,894],{"class":137}," fib",[44,896,897],{"class":141},"(n",[44,899,145],{"class":130},[44,901,902],{"class":137}," u64",[44,904,158],{"class":141},[44,906,161],{"class":130},[44,908,902],{"class":137},[44,910,911],{"class":141}," { ",[44,913,914],{"class":50},"\u002F* ... *\u002F",[44,916,917],{"class":397}," 0",[44,919,920],{"class":141}," }\n",[808,922,924],{"id":923},"bad","Bad",[32,926,927],{"language":34},[36,928,930],{"className":38,"code":929,"language":34,"meta":40,"style":40},"\u002F\u002F\u002F fib function\npub fn fib(n: u64) -> u64 { 0 }\n",[18,931,932,937],{"__ignoreMap":40},[44,933,934],{"class":46,"line":47},[44,935,936],{"class":50},"\u002F\u002F\u002F fib function\n",[44,938,939,941,943,945,947,949,951,953,955,957,959,962],{"class":46,"line":54},[44,940,131],{"class":130},[44,942,134],{"class":130},[44,944,894],{"class":137},[44,946,897],{"class":141},[44,948,145],{"class":130},[44,950,902],{"class":137},[44,952,158],{"class":141},[44,954,161],{"class":130},[44,956,902],{"class":137},[44,958,911],{"class":141},[44,960,961],{"class":397},"0",[44,963,920],{"class":141},[27,965,967],{"id":966},"hidden-examples-for-complex-setup","Hidden Examples for Complex Setup",[32,969,970],{"language":34},[36,971,973],{"className":38,"code":972,"language":34,"meta":40,"style":40},"\u002F\u002F\u002F ```\n\u002F\u002F\u002F # use std::sync::Arc;\n\u002F\u002F\u002F # use std::sync::Mutex;\n\u002F\u002F\u002F # let state = Arc::new(Mutex::new(0));\n\u002F\u002F\u002F let _v = state.lock().unwrap();\n\u002F\u002F\u002F ```\n",[18,974,975,979,984,989,994,999],{"__ignoreMap":40},[44,976,977],{"class":46,"line":47},[44,978,85],{"class":50},[44,980,981],{"class":46,"line":54},[44,982,983],{"class":50},"\u002F\u002F\u002F # use std::sync::Arc;\n",[44,985,986],{"class":46,"line":60},[44,987,988],{"class":50},"\u002F\u002F\u002F # use std::sync::Mutex;\n",[44,990,991],{"class":46,"line":66},[44,992,993],{"class":50},"\u002F\u002F\u002F # let state = Arc::new(Mutex::new(0));\n",[44,995,996],{"class":46,"line":71},[44,997,998],{"class":50},"\u002F\u002F\u002F let _v = state.lock().unwrap();\n",[44,1000,1001],{"class":46,"line":77},[44,1002,85],{"class":50},[14,1004,1005,1006,1009],{},"Setup lines prefixed with ",[18,1007,1008],{},"#"," are hidden in the rendered doc but executed.",[27,1011,1013],{"id":1012},"doc-test-pitfalls","Doc Test Pitfalls",[174,1015,1016,1031,1040,1047,1061],{},[177,1017,1018,1022,1023,1026,1027,1030],{},[1019,1020,1021],"strong",{},"External crate imports",": doc tests need ",[18,1024,1025],{},"extern crate"," or ",[18,1028,1029],{},"use"," lines.",[177,1032,1033,1039],{},[1019,1034,1035,1036,1038],{},"Top-level ",[18,1037,1029],{}," shadowing",": each doc test is its own crate.",[177,1041,1042,1046],{},[1019,1043,1044],{},[18,1045,496],{}," must be on a fenced block, and the block must actually fail to compile.",[177,1048,1049,1057,1058,1060],{},[1019,1050,1051,1053,1054],{},[18,1052,484],{}," with ",[18,1055,1056],{},"main",": works; ",[18,1059,484],{}," compiles but skips execution.",[177,1062,1063,1066,1067,444],{},[1019,1064,1065],{},"Doc tests are slow",": skip in CI with ",[18,1068,1069],{},"cargo test --lib --bins --tests",[27,1071,1073,1076],{"id":1072},"mdbook-for-standalone-docs",[18,1074,1075],{},"mdbook"," for Standalone Docs",[14,1078,1079,1080,1082],{},"For guides\u002Fbooks, ",[18,1081,1075],{}," is the standard tool:",[32,1084,1085],{"language":370},[36,1086,1088],{"className":373,"code":1087,"language":370,"meta":40,"style":40},"cargo install mdbook\nmdbook init docs\nmdbook serve docs\n",[18,1089,1090,1100,1110],{"__ignoreMap":40},[44,1091,1092,1094,1097],{"class":46,"line":47},[44,1093,381],{"class":137},[44,1095,1096],{"class":384}," install",[44,1098,1099],{"class":384}," mdbook\n",[44,1101,1102,1104,1107],{"class":46,"line":54},[44,1103,1075],{"class":137},[44,1105,1106],{"class":384}," init",[44,1108,1109],{"class":384}," docs\n",[44,1111,1112,1114,1117],{"class":46,"line":60},[44,1113,1075],{"class":137},[44,1115,1116],{"class":384}," serve",[44,1118,1109],{"class":384},[14,1120,1121,1122,1125,1126,1125,1129,1132],{},"Many major Rust projects (",[18,1123,1124],{},"rust-lang\u002Frust",", ",[18,1127,1128],{},"tokio",[18,1130,1131],{},"bevy",") have mdbook guides alongside rustdoc.",[27,1134,1136],{"id":1135},"publishing-docs","Publishing Docs",[174,1138,1139],{},[177,1140,1141,1144,1145,145],{},[1019,1142,1143],{},"docs.rs",": auto-builds and hosts docs for crates published to crates.io. Configure with ",[18,1146,1147],{},"[package.metadata.docs.rs]",[32,1149,1151],{"language":1150},"toml",[36,1152,1155],{"className":1153,"code":1154,"language":1150,"meta":40,"style":40},"language-toml shiki shiki-themes github-light github-dark","[package.metadata.docs.rs]\nfeatures = [\"full\", \"all-feature-flags\"]\nall-features = true\nrustdoc-args = [\"--cfg\", \"docsrs\"]\n",[18,1156,1157,1162,1167,1172],{"__ignoreMap":40},[44,1158,1159],{"class":46,"line":47},[44,1160,1161],{},"[package.metadata.docs.rs]\n",[44,1163,1164],{"class":46,"line":54},[44,1165,1166],{},"features = [\"full\", \"all-feature-flags\"]\n",[44,1168,1169],{"class":46,"line":60},[44,1170,1171],{},"all-features = true\n",[44,1173,1174],{"class":46,"line":66},[44,1175,1176],{},"rustdoc-args = [\"--cfg\", \"docsrs\"]\n",[174,1178,1179,1188],{},[177,1180,1181,1184,1185,1187],{},[1019,1182,1183],{},"GitHub Pages",": deploy ",[18,1186,443],{}," via Actions.",[177,1189,1190,1195],{},[1019,1191,1192],{},[18,1193,1194],{},"cargo-docs-rs",": preview docs.rs rendering locally.",[27,1197,1199],{"id":1198},"cross-crate-doc-links","Cross-Crate Doc Links",[32,1201,1202],{"language":34},[36,1203,1205],{"className":38,"code":1204,"language":34,"meta":40,"style":40},"\u002F\u002F\u002F See the [`serde`] crate for serialization.\n\u002F\u002F\u002F See [`tokio::sync::mpsc`] for channels.\n",[18,1206,1207,1212],{"__ignoreMap":40},[44,1208,1209],{"class":46,"line":47},[44,1210,1211],{"class":50},"\u002F\u002F\u002F See the [`serde`] crate for serialization.\n",[44,1213,1214],{"class":46,"line":54},[44,1215,1216],{"class":50},"\u002F\u002F\u002F See [`tokio::sync::mpsc`] for channels.\n",[14,1218,1219,1220,444],{},"rustdoc can resolve links to external crates if they're in your ",[18,1221,1222],{},"Cargo.toml",[27,1224,1226],{"id":1225},"common-pitfalls","Common Pitfalls",[174,1228,1229,1238,1247,1253,1262,1275,1283],{},[177,1230,1231,1234,1235,444],{},[1019,1232,1233],{},"Broken intra-doc links",": rustdoc warns; turn into errors with ",[18,1236,1237],{},"#![warn(rustdoc::broken_intra_doc_links)]",[177,1239,1240,1243,1244,444],{},[1019,1241,1242],{},"Missing crate-level docs",": ",[18,1245,1246],{},"#![warn(rustdoc::missing_crate_level_docs)]",[177,1248,1249,1252],{},[1019,1250,1251],{},"Examples don't compile",": CI runs doc tests; broken examples break releases.",[177,1254,1255,1261],{},[1019,1256,1257,1260],{},[18,1258,1259],{},"#[doc(hidden)]"," on re-exports",": hides the re-export but not the original.",[177,1263,1264,1270,1271,1274],{},[1019,1265,1266,1267,1269],{},"Hidden ",[18,1268,1008],{}," lines visible in source",": they're hidden in HTML but visible in ",[18,1272,1273],{},".rs"," source.",[177,1276,1277,1282],{},[1019,1278,1279],{},[18,1280,1281],{},"#![doc(html_logo_url = \"...\")]",": branding on docs.",[177,1284,1285,1290],{},[1019,1286,1287],{},[18,1288,1289],{},"#![doc(html_root_url = \"https:\u002F\u002Fdocs.rs\u002Fcrate\u002F1.0\")]",": helps intra-doc link resolution.",[27,1292,1294],{"id":1293},"tips-tricks","💡 Tips & Tricks",[174,1296,1297,1309,1327,1339,1351,1367],{},[177,1298,1299,1243,1302,1305,1306,1308],{},[1019,1300,1301],{},"Debug",[18,1303,1304],{},"cargo doc --open"," after any doc-comment change is the fastest feedback loop — rendering catches malformed intra-doc links and broken Markdown that reading the raw ",[18,1307,24],{}," comments won't reveal.",[177,1310,1311,1314,1315,1318,1319,1322,1323,1326],{},[1019,1312,1313],{},"Idiom",": use hidden ",[18,1316,1317],{},"# "," setup lines liberally in doc examples (",[18,1320,1321],{},"# use my_crate::Thing;",") — they keep the ",[775,1324,1325],{},"rendered"," example focused on the interesting part while still compiling and running as a real doc test with all necessary imports.",[177,1328,1329,1243,1331,1334,1335,1338],{},[1019,1330,1301],{},[18,1332,1333],{},"cargo test --doc -- --nocapture"," shows ",[18,1336,1337],{},"println!"," output from inside doc tests, useful when a doc example is supposed to demonstrate output but you can't tell if it's actually producing what the prose claims.",[177,1340,1341,1343,1344,1346,1347,1350],{},[1019,1342,1313],{},": write the ",[18,1345,240],{}," section ",[775,1348,1349],{},"first",", before the prose — if you can't write a compiling example quickly, that's often a sign the API itself needs simplifying, not just better docs.",[177,1352,1353,1356,1357,1359,1360,1362,1363,1366],{},[1019,1354,1355],{},"Performance",": doc tests compile as separate binaries and meaningfully slow down ",[18,1358,478],{}," on large crates — many projects run ",[18,1361,1069],{}," in fast CI stages and reserve full doc-test runs (",[18,1364,1365],{},"cargo test --doc",") for a slower, separate job.",[177,1368,1369,1372,1373,1376],{},[1019,1370,1371],{},"Clippy\u002Flint",": turn on ",[18,1374,1375],{},"#![warn(missing_docs)]"," early in a library's life, not late — retrofitting documentation onto a large, already-public API surface is a much bigger task than requiring docs as each item is added.",[27,1378,1380],{"id":1379},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[174,1382,1383,1398,1409,1430,1441,1461,1486],{},[177,1384,1385,1394,1395,1397],{},[1019,1386,1387,1388,1390,1391],{},"A broken doc example fails ",[18,1389,478],{},", not just ",[18,1392,1393],{},"cargo doc",": doc tests are compiled and executed by ",[18,1396,478],{}," by default — a renamed function that isn't updated in a doc comment's example doesn't just produce stale documentation, it breaks the build, which surprises contributors who think of docs as \"just comments.\"",[177,1399,1400,1408],{},[1019,1401,1266,1402,1404,1405,1407],{},[18,1403,1008],{}," lines are invisible in rendered HTML but fully visible in the ",[18,1406,1273],{}," source file",": anyone reading the source directly (not the generated docs) sees every hidden setup line — don't hide anything security-sensitive or misleading there, since \"hidden\" only means hidden from the doc viewer.",[177,1410,1411,1416,1417,1419,1420,1423,1424,1426,1427,1429],{},[1019,1412,1413,1415],{},[18,1414,496],{}," doc tests can pass for the wrong reason",": a ",[18,1418,496],{}," block only asserts the code ",[775,1421,1422],{},"fails to compile"," — it doesn't check ",[775,1425,777],{},". A typo that produces an unrelated syntax error still satisfies ",[18,1428,496],{},", silently defeating the intent of demonstrating a specific type error.",[177,1431,1432,1416,1437,1440],{},[1019,1433,1434,1436],{},[18,1435,1259],{}," hides an item from docs but does not make it private",[18,1438,1439],{},"#[doc(hidden)] pub fn"," is still fully callable by any downstream crate — hiding it from documentation is not an access-control mechanism, just a visibility hint for doc generation, a distinction that matters for semver (you can still break callers of a \"hidden\" function).",[177,1442,1443,1243,1446,1449,1450,1453,1454,1457,1458,1460],{},[1019,1444,1445],{},"Intra-doc links resolve based on what's in scope at that exact item, not the whole crate",[18,1447,1448],{},"[MyType]"," inside a doc comment on a function in module ",[18,1451,1452],{},"a"," won't resolve if ",[18,1455,1456],{},"MyType"," isn't imported or reachable from module ",[18,1459,1452],{},"'s scope, even if it's a well-known type used everywhere else in the crate — the link-breakage is per-item, not global.",[177,1462,1463,1468,1469,1472,1473,1476,1477,1480,1481,1483,1484,444],{},[1019,1464,1465,1467],{},[18,1466,1393],{}," succeeding locally doesn't guarantee docs.rs succeeds",": docs.rs builds with specific feature flags and sometimes a pinned toolchain; a crate that needs ",[18,1470,1471],{},"all-features = true"," or a ",[18,1474,1475],{},"docsrs","-specific ",[18,1478,1479],{},"cfg"," and doesn't declare it in ",[18,1482,1147],{}," can fail or render incompletely on docs.rs while looking fine with a plain local ",[18,1485,1393],{},[177,1487,1488,1491],{},[1019,1489,1490],{},"Platform-independent trap — doc tests run with the crate's default features only, unless configured",": a doc example that references a feature-gated type without the feature enabled compiles fine when that feature happens to be a default, then breaks the moment someone changes the crate's default-features set, since doc tests don't automatically enable every feature.",[27,1493,1495],{"id":1494},"spot-the-bug","🧠 Spot the Bug",[14,1497,1498,1499,1501,1502,1505],{},"Why does ",[18,1500,478],{}," fail here, even though the function itself is correct and ",[18,1503,1504],{},"cargo build"," succeeds?",[32,1507,1508],{"language":34},[36,1509,1511],{"className":38,"code":1510,"language":34,"meta":40,"style":40},"\u002F\u002F\u002F Doubles a number.\n\u002F\u002F\u002F\n\u002F\u002F\u002F # Examples\n\u002F\u002F\u002F\n\u002F\u002F\u002F ```\n\u002F\u002F\u002F let result = double(21);\n\u002F\u002F\u002F assert_eq!(result, 42);\n\u002F\u002F\u002F ```\npub fn double(n: i32) -> i32 {\n    n * 2\n}\n",[18,1512,1513,1518,1522,1526,1530,1534,1539,1544,1548,1572,1583],{"__ignoreMap":40},[44,1514,1515],{"class":46,"line":47},[44,1516,1517],{"class":50},"\u002F\u002F\u002F Doubles a number.\n",[44,1519,1520],{"class":46,"line":54},[44,1521,57],{"class":50},[44,1523,1524],{"class":46,"line":60},[44,1525,74],{"class":50},[44,1527,1528],{"class":46,"line":66},[44,1529,57],{"class":50},[44,1531,1532],{"class":46,"line":71},[44,1533,85],{"class":50},[44,1535,1536],{"class":46,"line":77},[44,1537,1538],{"class":50},"\u002F\u002F\u002F let result = double(21);\n",[44,1540,1541],{"class":46,"line":82},[44,1542,1543],{"class":50},"\u002F\u002F\u002F assert_eq!(result, 42);\n",[44,1545,1546],{"class":46,"line":88},[44,1547,85],{"class":50},[44,1549,1550,1552,1554,1557,1559,1561,1563,1565,1567,1569],{"class":46,"line":94},[44,1551,131],{"class":130},[44,1553,134],{"class":130},[44,1555,1556],{"class":137}," double",[44,1558,897],{"class":141},[44,1560,145],{"class":130},[44,1562,148],{"class":137},[44,1564,158],{"class":141},[44,1566,161],{"class":130},[44,1568,148],{"class":137},[44,1570,1571],{"class":141}," {\n",[44,1573,1574,1577,1580],{"class":46,"line":100},[44,1575,1576],{"class":141},"    n ",[44,1578,1579],{"class":130},"*",[44,1581,1582],{"class":397}," 2\n",[44,1584,1585],{"class":46,"line":105},[44,1586,1587],{"class":141},"}\n",[1589,1590,1591,1595,1602,1640],"details",{},[1592,1593,1594],"summary",{},"Answer",[14,1596,1597,1598,1601],{},"The doc test fails to compile: ",[18,1599,1600],{},"error[E0425]: cannot find function \\","double` in this scope`.",[14,1603,1604,1605,1608,1609,1612,1613,1616,1617,1619,1620,1623,1624,1626,1627,1629,1630,1632,1633,1635,1636,1639],{},"Every fenced code block in a doc comment is compiled as its ",[1019,1606,1607],{},"own separate crate"," — it does not automatically have access to the items of the crate it's documenting, no matter how \"obviously nearby\" the function looks in the source file. The example calls ",[18,1610,1611],{},"double(21)"," directly, but from that isolated doc-test crate's perspective, ",[18,1614,1615],{},"double"," doesn't exist unless it's explicitly brought into scope with a ",[18,1618,1029],{}," statement, exactly as any external consumer of the published crate would have to do: ",[18,1621,1622],{},"use my_crate::double;",". This is easy to miss because ",[18,1625,1504],{}," never runs doc tests at all — only ",[18,1628,478],{}," (or ",[18,1631,1365],{},") compiles and executes them, so the mistake can sit unnoticed through every ",[18,1634,1504],{},"\u002F",[18,1637,1638],{},"cargo check"," cycle during development.",[14,1641,1642,1645,1646,1648,1649,1652],{},[1019,1643,1644],{},"The lesson",": doc tests are independent crates with no implicit access to the crate they document — always ",[18,1647,1029],{}," the item you're demonstrating, ideally as a hidden ",[18,1650,1651],{},"# use"," line to keep the rendered example clean.",[27,1654,1655],{"id":1592},"Summary",[14,1657,1658,1659,1125,1661,1663,1664,790,1666,1668,1669,1671,1672,1674,1675,1677],{},"Write doc comments (",[18,1660,24],{},[18,1662,186],{},") with standard sections (Examples, Panics, Errors, Safety). Run ",[18,1665,1393],{},[18,1667,478],{}," (doc tests). Use hidden ",[18,1670,1008],{}," lines for setup. Cross-reference with backticks. Enable ",[18,1673,666],{}," for libraries. Publish to docs.rs. Use ",[18,1676,1075],{}," for guides.",[14,1679,1680],{},"Next: Rust ecosystem tour.",[1682,1683,1684],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--s