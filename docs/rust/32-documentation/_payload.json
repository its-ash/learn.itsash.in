h":54,"text":1602},{"id":1716,"depth":54,"text":1717},{"id":1814,"depth":54,"text":1875},"Documentation is part of the Rust culture. rustdoc produces HTML docs from \u002F\u002F\u002F comments; doc-tests run examples.","md",{},true,"\u002Frust\u002F32-documentation",{"title":5,"description":1937},"rust\u002F32-documentation","iwbIjNU41qVA1neCG7EEtv4jzYKawoE1Vui35dGr9eo",1787850121929]