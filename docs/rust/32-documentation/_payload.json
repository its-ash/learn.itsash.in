,"line":54},[44,1103,1075],{"class":137},[44,1105,1106],{"class":384}," init",[44,1108,1109],{"class":384}," docs\n",[44,1111,1112,1114,1117],{"class":46,"line":60},[44,1113,1075],{"class":137},[44,1115,1116],{"class":384}," serve",[44,1118,1109],{"class":384},[14,1120,1121,1122,1125,1126,1125,1129,1132],{},"Many major Rust projects (",[18,1123,1124],{},"rust-lang\u002Frust",", ",[18,1127,1128],{},"tokio",[18,1130,1131],{},"bevy",") have mdbook guides alongside rustdoc.",[27,1134,1136],{"id":1135},"publishing-docs","Publishing Docs",[174,1138,1139],{},[177,1140,1141,1144,1145,145],{},[1019,1142,1143],{},"docs.rs",": auto-builds and hosts docs for crates published to crates.io. Configure with ",[18,1146,1147],{},"[package.metadata.docs.rs]",[32,1149,1151],{"language":1150},"toml",[36,1152,1155],{"className":1153,"code":1154,"language":1150,"meta":40,"style":40},"language-toml shiki shiki-themes github-light github-dark","[package.metadata.docs.rs]\nfeatures = [\"full\", \"all-feature-flags\"]\nall-features = true\nrustdoc-args = [\"--cfg\", \"docsrs\"]\n",[18,1156,1157,1183,1198,1206],{"__ignoreMap":40},[44,1158,1159,1162,1165,1167,1170,1172,1175,1177,1180],{"class":46,"line":47},[44,1160,1161],{"class":141},"[",[44,1163,1164],{"class":137},"package",[44,1166,444],{"class":141},[44,1168,1169],{"class":137},"metadata",[44,1171,444],{"class":141},[44,1173,1174],{"class":137},"docs",[44,1176,444],{"class":141},[44,1178,1179],{"class":137},"rs",[44,1181,1182],{"class":141},"]\n",[44,1184,1185,1188,1191,1193,1196],{"class":46,"line":54},[44,1186,1187],{"class":141},"features = [",[44,1189,1190],{"class":384},"\"full\"",[44,1192,1125],{"class":141},[44,1194,1195],{"class":384},"\"all-feature-flags\"",[44,1197,1182],{"class":141},[44,1199,1200,1203],{"class":46,"line":60},[44,1201,1202],{"class":141},"all-features = ",[44,1204,1205],{"class":397},"true\n",[44,1207,1208,1211,1214,1216,1219],{"class":46,"line":66},[44,1209,1210],{"class":141},"rustdoc-args = [",[44,1212,1213],{"class":384},"\"--cfg\"",[44,1215,1125],{"class":141},[44,1217,1218],{"class":384},"\"docsrs\"",[44,1220,1182],{"class":141},[174,1222,1223,1232],{},[177,1224,1225,1228,1229,1231],{},[1019,1226,1227],{},"GitHub Pages",": deploy ",[18,1230,443],{}," via Actions.",[177,1233,1234,1239],{},[1019,1235,1236],{},[18,1237,1238],{},"cargo-docs-rs",": preview docs.rs rendering locally.",[27,1241,1243],{"id":1242},"cross-crate-doc-links","Cross-Crate Doc Links",[32,1245,1246],{"language":34},[36,1247,1249],{"className":38,"code":1248,"language":34,"meta":40,"style":40},"\u002F\u002F\u002F See the [`serde`] crate for serialization.\n\u002F\u002F\u002F See [`tokio::sync::mpsc`] for channels.\n",[18,1250,1251,1256],{"__ignoreMap":40},[44,1252,1253],{"class":46,"line":47},[44,1254,1255],{"class":50},"\u002F\u002F\u002F See the [`serde`] crate for serialization.\n",[44,1257,1258],{"class":46,"line":54},[44,1259,1260],{"class":50},"\u002F\u002F\u002F See [`tokio::sync::mpsc`] for channels.\n",[14,1262,1263,1264,444],{},"rustdoc can resolve links to external crates if they're in your ",[18,1265,1266],{},"Cargo.toml",[27,1268,1270],{"id":1269},"common-pitfalls","Common Pitfalls",[174,1272,1273,1282,1291,1297,1306,1319,1327],{},[177,1274,1275,1278,1279,444],{},[1019,1276,1277],{},"Broken intra-doc links",": rustdoc warns; turn into errors with ",[18,1280,1281],{},"#![warn(rustdoc::broken_intra_doc_links)]",[177,1283,1284,1287,1288,444],{},[1019,1285,1286],{},"Missing crate-level docs",": ",[18,1289,1290],{},"#![warn(rustdoc::missing_crate_level_docs)]",[177,1292,1293,1296],{},[1019,1294,1295],{},"Examples don't compile",": CI runs doc tests; broken examples break releases.",[177,1298,1299,1305],{},[1019,1300,1301,1304],{},[18,1302,1303],{},"#[doc(hidden)]"," on re-exports",": hides the re-export but not the original.",[177,1307,1308,1314,1315,1318],{},[1019,1309,1310,1311,1313],{},"Hidden ",[18,1312,1008],{}," lines visible in source",": they're hidden in HTML but visible in ",[18,1316,1317],{},".rs"," source.",[177,1320,1321,1326],{},[1019,1322,1323],{},[18,1324,1325],{},"#![doc(html_logo_url = \"...\")]",": branding on docs.",[177,1328,1329,1334],{},[1019,1330,1331],{},[18,1332,1333],{},"#![doc(html_root_url = \"https:\u002F\u002Fdocs.rs\u002Fcrate\u002F1.0\")]",": helps intra-doc link resolution.",[27,1336,1338],{"id":1337},"tips-tricks","💡 Tips & Tricks",[174,1340,1341,1353,1371,1383,1395,1411],{},[177,1342,1343,1287,1346,1349,1350,1352],{},[1019,1344,1345],{},"Debug",[18,1347,1348],{},"cargo doc --open"," after any doc-comment change is the fastest feedback loop — rendering catches malformed intra-doc links and broken Markdown that reading the raw ",[18,1351,24],{}," comments won't reveal.",[177,1354,1355,1358,1359,1362,1363,1366,1367,1370],{},[1019,1356,1357],{},"Idiom",": use hidden ",[18,1360,1361],{},"# "," setup lines liberally in doc examples (",[18,1364,1365],{},"# use my_crate::Thing;",") — they keep the ",[775,1368,1369],{},"rendered"," example focused on the interesting part while still compiling and running as a real doc test with all necessary imports.",[177,1372,1373,1287,1375,1378,1379,1382],{},[1019,1374,1345],{},[18,1376,1377],{},"cargo test --doc -- --nocapture"," shows ",[18,1380,1381],{},"println!"," output from inside doc tests, useful when a doc example is supposed to demonstrate output but you can't tell if it's actually producing what the prose claims.",[177,1384,1385,1387,1388,1390,1391,1394],{},[1019,1386,1357],{},": write the ",[18,1389,240],{}," section ",[775,1392,1393],{},"first",", before the prose — if you can't write a compiling example quickly, that's often a sign the API itself needs simplifying, not just better docs.",[177,1396,1397,1400,1401,1403,1404,1406,1407,1410],{},[1019,1398,1399],{},"Performance",": doc tests compile as separate binaries and meaningfully slow down ",[18,1402,478],{}," on large crates — many projects run ",[18,1405,1069],{}," in fast CI stages and reserve full doc-test runs (",[18,1408,1409],{},"cargo test --doc",") for a slower, separate job.",[177,1412,1413,1416,1417,1420],{},[1019,1414,1415],{},"Clippy\u002Flint",": turn on ",[18,1418,1419],{},"#![warn(missing_docs)]"," early in a library's life, not late — retrofitting documentation onto a large, already-public API surface is a much bigger task than requiring docs as each item is added.",[27,1422,1424],{"id":1423},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[174,1426,1427,1442,1453,1474,1485,1505,1530],{},[177,1428,1429,1438,1439,1441],{},[1019,1430,1431,1432,1434,1435],{},"A broken doc example fails ",[18,1433,478],{},", not just ",[18,1436,1437],{},"cargo doc",": doc tests are compiled and executed by ",[18,1440,478],{}," by default — a renamed function that isn't updated in a doc comment's example doesn't just produce stale documentation, it breaks the build, which surprises contributors who think of docs as \"just comments.\"",[177,1443,1444,1452],{},[1019,1445,1310,1446,1448,1449,1451],{},[18,1447,1008],{}," lines are invisible in rendered HTML but fully visible in the ",[18,1450,1317],{}," source file",": anyone reading the source directly (not the generated docs) sees every hidden setup line — don't hide anything security-sensitive or misleading there, since \"hidden\" only means hidden from the doc viewer.",[177,1454,1455,1460,1461,1463,1464,1467,1468,1470,1471,1473],{},[1019,1456,1457,1459],{},[18,1458,496],{}," doc tests can pass for the wrong reason",": a ",[18,1462,496],{}," block only asserts the code ",[775,1465,1466],{},"fails to compile"," — it doesn't check ",[775,1469,777],{},". A typo that produces an unrelated syntax error still satisfies ",[18,1472,496],{},", silently defeating the intent of demonstrating a specific type error.",[177,1475,1476,1460,1481,1484],{},[1019,1477,1478,1480],{},[18,1479,1303],{}," hides an item from docs but does not make it private",[18,1482,1483],{},"#[doc(hidden)] pub fn"," is still fully callable by any downstream crate — hiding it from documentation is not an access-control mechanism, just a visibility hint for doc generation, a distinction that matters for semver (you can still break callers of a \"hidden\" function).",[177,1486,1487,1287,1490,1493,1494,1497,1498,1501,1502,1504],{},[1019,1488,1489],{},"Intra-doc links resolve based on what's in scope at that exact item, not the whole crate",[18,1491,1492],{},"[MyType]"," inside a doc comment on a function in module ",[18,1495,1496],{},"a"," won't resolve if ",[18,1499,1500],{},"MyType"," isn't imported or reachable from module ",[18,1503,1496],{},"'s scope, even if it's a well-known type used everywhere else in the crate — the link-breakage is per-item, not global.",[177,1506,1507,1512,1513,1516,1517,1520,1521,1524,1525,1527,1528,444],{},[1019,1508,1509,1511],{},[18,1510,1437],{}," succeeding locally doesn't guarantee docs.rs succeeds",": docs.rs builds with specific feature flags and sometimes a pinned toolchain; a crate that needs ",[18,1514,1515],{},"all-features = true"," or a ",[18,1518,1519],{},"docsrs","-specific ",[18,1522,1523],{},"cfg"," and doesn't declare it in ",[18,1526,1147],{}," can fail or render incompletely on docs.rs while looking fine with a plain local ",[18,1529,1437],{},[177,1531,1532,1535],{},[1019,1533,1534],{},"Platform-independent trap — doc tests run with the crate's default features only, unless configured",": a doc example that references a feature-gated type without the feature enabled compiles fine when that feature happens to be a default, then breaks the moment someone changes the crate's default-features set, since doc tests don't automatically enable every feature.",[27,1537,1539],{"id":1538},"spot-the-bug","🧠 Spot the Bug",[14,1541,1542,1543,1545,1546,1549],{},"Why does ",[18,1544,478],{}," fail here, even though the function itself is correct and ",[18,1547,1548],{},"cargo build"," succeeds?",[32,1551,1552],{"language":34},[36,1553,1555],{"className":38,"code":1554,"language":34,"meta":40,"style":40},"\u002F\u002F\u002F Doubles a number.\n\u002F\u002F\u002F\n\u002F\u002F\u002F # Examples\n\u002F\u002F\u002F\n\u002F\u002F\u002F ```\n\u002F\u002F\u002F let result = double(21);\n\u002F\u002F\u002F assert_eq!(result, 42);\n\u002F\u002F\u002F ```\npub fn double(n: i32) -> i32 {\n    n * 2\n}\n",[18,1556,1557,1562,1566,1570,1574,1578,1583,1588,1592,1616,1627],{"__ignoreMap":40},[44,1558,1559],{"class":46,"line":47},[44,1560,1561],{"class":50},"\u002F\u002F\u002F Doubles a number.\n",[44,1563,1564],{"class":46,"line":54},[44,1565,57],{"class":50},[44,1567,1568],{"class":46,"line":60},[44,1569,74],{"class":50},[44,1571,1572],{"class":46,"line":66},[44,1573,57],{"class":50},[44,1575,1576],{"class":46,"line":71},[44,1577,85],{"class":50},[44,1579,1580],{"class":46,"line":77},[44,1581,1582],{"class":50},"\u002F\u002F\u002F let result = double(21);\n",[44,1584,1585],{"class":46,"line":82},[44,1586,1587],{"class":50},"\u002F\u002F\u002F assert_eq!(result, 42);\n",[44,1589,1590],{"class":46,"line":88},[44,1591,85],{"class":50},[44,1593,1594,1596,1598,1601,1603,1605,1607,1609,1611,1613],{"class":46,"line":94},[44,1595,131],{"class":130},[44,1597,134],{"class":130},[44,1599,1600],{"class":137}," double",[44,1602,897],{"class":141},[44,1604,145],{"class":130},[44,1606,148],{"class":137},[44,1608,158],{"class":141},[44,1610,161],{"class":130},[44,1612,148],{"class":137},[44,1614,1615],{"class":141}," {\n",[44,1617,1618,1621,1624],{"class":46,"line":100},[44,1619,1620],{"class":141},"    n ",[44,1622,1623],{"class":130},"*",[44,1625,1626],{"class":397}," 2\n",[44,1628,1629],{"class":46,"line":105},[44,1630,1631],{"class":141},"}\n",[1633,1634,1635,1639,1646,1684],"details",{},[1636,1637,1638],"summary",{},"Answer",[14,1640,1641,1642,1645],{},"The doc test fails to compile: ",[18,1643,1644],{},"error[E0425]: cannot find function \\","double` in this scope`.",[14,1647,1648,1649,1652,1653,1656,1657,1660,1661,1663,1664,1667,1668,1670,1671,1673,1674,1676,1677,1679,1680,1683],{},"Every fenced code block in a doc comment is compiled as its ",[1019,1650,1651],{},"own separate crate"," — it does not automatically have access to the items of the crate it's documenting, no matter how \"obviously nearby\" the function looks in the source file. The example calls ",[18,1654,1655],{},"double(21)"," directly, but from that isolated doc-test crate's perspective, ",[18,1658,1659],{},"double"," doesn't exist unless it's explicitly brought into scope with a ",[18,1662,1029],{}," statement, exactly as any external consumer of the published crate would have to do: ",[18,1665,1666],{},"use my_crate::double;",". This is easy to miss because ",[18,1669,1548],{}," never runs doc tests at all — only ",[18,1672,478],{}," (or ",[18,1675,1409],{},") compiles and executes them, so the mistake can sit unnoticed through every ",[18,1678,1548],{},"\u002F",[18,1681,1682],{},"cargo check"," cycle during development.",[14,1685,1686,1689,1690,1692,1693,1696],{},[1019,1687,1688],{},"The lesson",": doc tests are independent crates with no implicit access to the crate they document — always ",[18,1691,1029],{}," the item you're demonstrating, ideally as a hidden ",[18,1694,1695],{},"# use"," line to keep the rendered example clean.",[27,1698,1699],{"id":1636},"Summary",[14,1701,1702,1703,1125,1705,1707,1708,790,1710,1712,1713,1715,1716,1718,1719,1721],{},"Write doc comments (",[18,1704,24],{},[18,1706,186],{},") with standard sections (Examples, Panics, Errors, Safety). Run ",[18,1709,1437],{},[18,1711,478],{}," (doc tests). Use hidden ",[18,1714,1008],{}," lines for setup. Cross-reference with backticks. Enable ",[18,1717,666],{}," for libraries. Publish to docs.rs. Use ",[18,1720,1075],{}," for guides.",[14,1723,1724],{},"Next: Rust ecosystem tour.",[1726,1727,1728],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}ht