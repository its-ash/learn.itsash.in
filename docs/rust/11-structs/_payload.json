[{"data":1,"prerenderedAt":592},["ShallowReactive",2],{"page-\u002Frust\u002F11-structs":3},{"id":4,"title":5,"body":6,"description":16,"extension":585,"meta":586,"navigation":587,"path":588,"seo":589,"stem":590,"__hash__":591},"content\u002Frust\u002F11-structs.md","11 — Structs",{"type":7,"value":8,"toc":559},"minimark",[9,13,17,22,33,38,44,51,55,61,100,104,110,131,135,141,144,151,157,163,167,206,210,216,220,226,232,236,242,245,249,255,258,309,328,333,339,342,351,369,375,379,385,392,396,487,493,521,525,542,546,556],[10,11,5],"h1",{"id":12},"_11-structs",[14,15,16],"p",{},"Structs group related data. Rust structs come in three flavors.",[18,19,21],"h2",{"id":20},"named-field-structs","Named-Field Structs",[23,24,30],"pre",{"className":25,"code":27,"language":28,"meta":29},[26],"language-rust","struct User {\n    username: String,\n    email: String,\n    sign_in_count: u64,\n    active: bool,\n}\n\nlet u = User {\n    username: String::from(\"ada\"),\n    email: String::from(\"ada@example.com\"),\n    sign_in_count: 1,\n    active: true,\n};\n","rust","",[31,32,27],"code",{"__ignoreMap":29},[34,35,37],"h3",{"id":36},"field-init-shorthand","Field-Init Shorthand",[23,39,42],{"className":40,"code":41,"language":28,"meta":29},[26],"fn new(email: String, username: String) -> User {\n    User { email, username, active: true, sign_in_count: 0 }\n}\n",[31,43,41],{"__ignoreMap":29},[14,45,46,47,50],{},"When a variable name matches the field, omit ",[31,48,49],{},": value",".",[34,52,54],{"id":53},"struct-update-syntax","Struct Update Syntax",[23,56,59],{"className":57,"code":58,"language":28,"meta":29},[26],"let u2 = User { email: String::from(\"ada2@x.com\"), ..u };\n",[31,60,58],{"__ignoreMap":29},[62,63,64,74,89],"ul",{},[65,66,67,70,71,50],"li",{},[31,68,69],{},"..u"," copies\u002Fmoves the remaining fields from ",[31,72,73],{},"u",[65,75,76,77,80,81,84,85,88],{},"Like a partial move — ",[31,78,79],{},"u.username"," is now invalid if ",[31,82,83],{},"String"," was moved (non-",[31,86,87],{},"Copy",").",[65,90,91,92,94,95,97,98,50],{},"For ",[31,93,87],{}," fields, they're copied; for non-",[31,96,87],{},", they're moved out of ",[31,99,73],{},[18,101,103],{"id":102},"tuple-structs","Tuple Structs",[23,105,108],{"className":106,"code":107,"language":28,"meta":29},[26],"struct Color(i32, i32, i32);\nlet c = Color(255, 128, 0);\nlet r = c.0;\n",[31,109,107],{"__ignoreMap":29},[62,111,112,115,125],{},[65,113,114],{},"Look like tuples but are distinct types.",[65,116,117,118,121,122,50],{},"Useful for newtype pattern: ",[31,119,120],{},"struct Meters(f64);"," prevents mixing with other ",[31,123,124],{},"f64",[65,126,127,128,50],{},"Pattern match: ",[31,129,130],{},"let Color(r, g, b) = c;",[18,132,134],{"id":133},"unit-structs","Unit Structs",[23,136,139],{"className":137,"code":138,"language":28,"meta":29},[26],"struct AlwaysEqual;\nlet _a = AlwaysEqual;\n",[31,140,138],{"__ignoreMap":29},[14,142,143],{},"Zero-sized; useful for trait implementations with no data (e.g., marker traits, type-state).",[18,145,147,150],{"id":146},"impl-blocks",[31,148,149],{},"impl"," Blocks",[23,152,155],{"className":153,"code":154,"language":28,"meta":29},[26],"impl User {\n    fn new(email: String, username: String) -> Self {\n        User { email, username, active: true, sign_in_count: 0 }\n    }\n    fn is_active(&self) -> bool { self.active }\n    fn sign_in(&mut self) { self.sign_in_count += 1; }\n    fn deactivate(self) -> User { User { active: false, ..self } }\n}\n",[31,156,154],{"__ignoreMap":29},[14,158,159,160,162],{},"You can split ",[31,161,149],{}," across multiple blocks (common in real codebases: one for methods, one for trait impls).",[18,164,166],{"id":165},"methods-vs-associated-functions","Methods vs Associated Functions",[62,168,169,186,195],{},[65,170,171,172,175,176,175,179,182,183,50],{},"Methods take ",[31,173,174],{},"&self","\u002F",[31,177,178],{},"&mut self",[31,180,181],{},"self"," and are called on instances: ",[31,184,185],{},"u.is_active()",[65,187,188,189,191,192,50],{},"Associated functions (no ",[31,190,181],{},") are constructors: ",[31,193,194],{},"User::new(...)",[65,196,197,198,201,202,205],{},"Convention: ",[31,199,200],{},"new"," for the canonical constructor, ",[31,203,204],{},"with_x"," for variant constructors.",[18,207,209],{"id":208},"lifetime-on-structs-recap","Lifetime on Structs (recap)",[23,211,214],{"className":212,"code":213,"language":28,"meta":29},[26],"struct Excerpt\u003C'a> { part: &'a str }\nimpl\u003C'a> Excerpt\u003C'a> { fn part(&self) -> &'a str { self.part } }\n",[31,215,213],{"__ignoreMap":29},[18,217,219],{"id":218},"generic-structs","Generic Structs",[23,221,224],{"className":222,"code":223,"language":28,"meta":29},[26],"struct Point\u003CT> { x: T, y: T }\n\nimpl\u003CT> Point\u003CT> {\n    fn x(&self) -> &T { &self.x }\n}\n\nimpl Point\u003Cf64> {            \u002F\u002F specialized impl for f64\n    fn distance(&self, other: &Self) -> f64 {\n        ((self.x - other.x).powi(2) + (self.y - other.y).powi(2)).sqrt()\n    }\n}\n",[31,225,223],{"__ignoreMap":29},[14,227,228,229,50],{},"Type params can be specialized: methods exist only for a specific ",[31,230,231],{},"T",[18,233,235],{"id":234},"constants-in-structs","Constants in Structs",[23,237,240],{"className":238,"code":239,"language":28,"meta":29},[26],"struct Grid\u003Cconst W: usize, const H: usize> {\n    cells: [[u8; W]; H],\n}\nlet g: Grid\u003C10, 20> = Grid { cells: [[0; 10]; 20] };\n",[31,241,239],{"__ignoreMap":29},[14,243,244],{},"Const generics (1.51+) allow parametrizing by compile-time constants. Limited to integers\u002Fbool\u002Fchar for now (full generic constants are unstable).",[18,246,248],{"id":247},"derive-macros","Derive Macros",[23,250,253],{"className":251,"code":252,"language":28,"meta":29},[26],"#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]\nstruct Pos { x: i32, y: i32 }\n",[31,254,252],{"__ignoreMap":29},[14,256,257],{},"Common derives:",[62,259,260,269,275,283,289,301],{},[65,261,262,265,266],{},[31,263,264],{},"Debug"," → ",[31,267,268],{},"{:?}",[65,270,271,274],{},[31,272,273],{},"Clone, Copy"," → value duplication",[65,276,277,265,280],{},[31,278,279],{},"PartialEq, Eq",[31,281,282],{},"==",[65,284,285,288],{},[31,286,287],{},"PartialOrd, Ord"," → comparison and sorting",[65,290,291,294,295,175,298],{},[31,292,293],{},"Hash"," → usable in ",[31,296,297],{},"HashSet",[31,299,300],{},"HashMap",[65,302,303,265,306],{},[31,304,305],{},"Default",[31,307,308],{},"Pos::default()",[14,310,311,175,314,317,318,321,322,175,325,50],{},[31,312,313],{},"Eq",[31,315,316],{},"Ord"," require no ",[31,319,320],{},"NaN","-like values — floats only get ",[31,323,324],{},"PartialEq",[31,326,327],{},"PartialOrd",[18,329,331],{"id":330},"default",[31,332,305],{},[23,334,337],{"className":335,"code":336,"language":28,"meta":29},[26],"#[derive(Default)]\nstruct Config { host: String, port: u16 }\nlet c = Config { host: \"localhost\".into(), ..Default::default() };\n",[31,338,336],{"__ignoreMap":29},[14,340,341],{},"Idiomatic way to provide \"default with overrides\".",[18,343,345,347,348],{"id":344},"debug-vs-display",[31,346,264],{}," vs ",[31,349,350],{},"Display",[62,352,353,364],{},[65,354,355,357,358,360,361,88],{},[31,356,264],{}," is derived, machine-readable-ish (",[31,359,268],{}," \u002F pretty ",[31,362,363],{},"{:#?}",[65,365,366,368],{},[31,367,350],{}," is user-facing; you must write it manually.",[23,370,373],{"className":371,"code":372,"language":28,"meta":29},[26],"impl std::fmt::Display for User {\n    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {\n        write!(f, \"{} \u003C{}>\", self.username, self.email)\n    }\n}\n",[31,374,372],{"__ignoreMap":29},[18,376,378],{"id":377},"struct-updates-and-moves","Struct Updates and Moves",[23,380,383],{"className":381,"code":382,"language":28,"meta":29},[26],"let u = User { \u002F* filled *\u002F };\nlet email = u.email;             \u002F\u002F partial move\n\u002F\u002F u is partially moved; can still read other fields, but not u as a whole\n",[31,384,382],{"__ignoreMap":29},[14,386,387,388,391],{},"Reconstruct with ",[31,389,390],{},".."," if needed.",[18,393,395],{"id":394},"edge-cases-pitfalls","Edge Cases & Pitfalls",[62,397,398,405,422,428,438,446,454,464,474],{},[65,399,400,404],{},[401,402,403],"strong",{},"Out-of-order field initialization"," is allowed — order doesn't matter in struct literals.",[65,406,407,410,411,414,415,175,418,421],{},[401,408,409],{},"Mutability is per-binding, not per-field",": there's no ",[31,412,413],{},"mut"," field modifier. Use ",[31,416,417],{},"Cell",[31,419,420],{},"RefCell"," for interior mutability of single fields.",[65,423,424,427],{},[401,425,426],{},"No inheritance",": Rust has no class inheritance. Use composition + traits.",[65,429,430,433,434,437],{},[401,431,432],{},"Private fields",": by default, fields are private to the module. Use ",[31,435,436],{},"pub"," to expose.",[65,439,440,445],{},[401,441,442],{},[31,443,444],{},"pub(crate)",": visible within the same crate only.",[65,447,448,453],{},[401,449,450],{},[31,451,452],{},"#[non_exhaustive]"," prevents external crates from constructing the struct with literal syntax — forces them to use a constructor (future-proofing).",[65,455,456,459,460,463],{},[401,457,458],{},"Self-referential structs",": not expressible directly in safe Rust (the borrow checker can't describe the relationship); use crates like ",[31,461,462],{},"ouroboros"," or own the data.",[65,465,466,469,470,473],{},[401,467,468],{},"ZST struct",": ",[31,471,472],{},"struct Marker;"," has size 0.",[65,475,476,482,483,486],{},[401,477,478,479],{},"Field order and ",[31,480,481],{},"Drop",": struct fields drop in ",[401,484,485],{},"declaration order"," (RFC 1857), unlike locals which drop in reverse order. This can matter for field destructors that depend on each other.",[18,488,490,492],{"id":489},"impl-method-dispatch",[31,491,149],{}," Method Dispatch",[62,494,495,501,515],{},[65,496,497,498,500],{},"Methods taking ",[31,499,181],{}," by value consume the receiver.",[65,502,503,504,507,508,507,511,514],{},"Method resolution finds methods on ",[31,505,506],{},"Self",", ",[31,509,510],{},"&Self",[31,512,513],{},"&mut Self"," automatically based on call syntax.",[65,516,517,518,520],{},"Auto-ref\u002Fderef lets you call ",[31,519,174],{}," methods on owned values and vice versa.",[18,522,524],{"id":523},"memory-layout","Memory Layout",[62,526,527],{},[65,528,529,530,533,534,537,538,541],{},"Reorder fields for minimal padding — the compiler does this by default (repr optimization). Use ",[31,531,532],{},"#[repr(C)]"," to force C-compatible layout (FFI). Use ",[31,535,536],{},"#[repr(transparent)]"," for newtype wrappers (same layout as inner). Use ",[31,539,540],{},"#[repr(packed)]"," to disable padding (careful with alignment → unaligned reads are UB).",[18,543,545],{"id":544},"summary","Summary",[14,547,548,549,551,552,555],{},"Structs come in named, tuple, and unit forms. Methods live in ",[31,550,149],{}," blocks. Derive macros give you common traits for free. Const generics, generics, and lifetimes parametrize them. Memory layout can be controlled with ",[31,553,554],{},"repr"," attributes.",[14,557,558],{},"Next: Enums — Rust's algebraic data types.",{"title":29,"searchDepth":560,"depth":560,"links":561},2,[562,567,568,569,571,572,573,574,575,576,577,579,580,581,583,584],{"id":20,"depth":560,"text":21,"children":563},[564,566],{"id":36,"depth":565,"text":37},3,{"id":53,"depth":565,"text":54},{"id":102,"depth":560,"text":103},{"id":133,"depth":560,"text":134},{"id":146,"depth":560,"text":570},"impl Blocks",{"id":165,"depth":560,"text":166},{"id":208,"depth":560,"text":209},{"id":218,"depth":560,"text":219},{"id":234,"depth":560,"text":235},{"id":247,"depth":560,"text":248},{"id":330,"depth":560,"text":305},{"id":344,"depth":560,"text":578},"Debug vs Display",{"id":377,"depth":560,"text":378},{"id":394,"depth":560,"text":395},{"id":489,"depth":560,"text":582},"impl Method Dispatch",{"id":523,"depth":560,"text":524},{"id":544,"depth":560,"text":545},"md",{},true,"\u002Frust\u002F11-structs",{"title":5,"description":16},"rust\u002F11-structs","PLpOPKSGYcUDKaHZ7Z634UO0FaFo20SrP2x3VsOJWKs",1785934122319]