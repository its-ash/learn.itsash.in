[{"data":1,"prerenderedAt":716},["ShallowReactive",2],{"page-\u002Frust\u002F17-closures":3},{"id":4,"title":5,"body":6,"description":708,"extension":709,"meta":710,"navigation":711,"path":712,"seo":713,"stem":714,"__hash__":715},"content\u002Frust\u002F17-closures.md","17 — Closures",{"type":7,"value":8,"toc":677},"minimark",[9,13,22,27,38,59,63,66,72,77,127,143,149,156,159,165,173,177,183,191,195,201,208,214,218,224,229,236,242,246,252,256,262,276,287,293,299,303,306,312,319,325,338,342,345,366,372,378,405,409,415,428,432,438,441,448,454,460,464,603,611,617,635,639,667],[10,11,5],"h1",{"id":12},"_17-closures",[14,15,16,17,21],"p",{},"Closures are anonymous functions that ",[18,19,20],"strong",{},"capture"," their environment. They bridge the gap between functions and objects.",[23,24,26],"h2",{"id":25},"syntax","Syntax",[28,29,35],"pre",{"className":30,"code":32,"language":33,"meta":34},[31],"language-rust","let add = |a, b| a + b;\nlet square = |x: i32| x * x;\nlet greet = |name: &str| format!(\"hi {name}\");\nlet block = |x| { let y = x + 1; y * 2 };\nlet no_args = || 42;\nlet void_closure = || { \u002F* do something *\u002F };\n","rust","",[36,37,32],"code",{"__ignoreMap":34},[39,40,41,45,52],"ul",{},[42,43,44],"li",{},"Parameter types often inferred (especially when called immediately).",[42,46,47,48,51],{},"Single expression OR ",[36,49,50],{},"{ }"," block.",[42,53,54,55,58],{},"Can't have generic parameters (no ",[36,56,57],{},"|\u003CT> x| ...",").",[23,60,62],{"id":61},"capturing-the-environment","Capturing the Environment",[14,64,65],{},"Closures capture variables from the enclosing scope. The capture mode determines how:",[28,67,70],{"className":68,"code":69,"language":33,"meta":34},[31],"let n = 5;\nlet add_n = |x| x + n;            \u002F\u002F borrows n by reference\nlet n_mut = String::from(\"a\");\nlet consume = move || n_mut;       \u002F\u002F moves n_mut into closure\n",[36,71,69],{"__ignoreMap":34},[73,74,76],"h3",{"id":75},"capture-modes-trait-hierarchy","Capture Modes (Trait Hierarchy)",[78,79,80,93],"table",{},[81,82,83],"thead",{},[84,85,86,90],"tr",{},[87,88,89],"th",{},"Trait",[87,91,92],{},"How it captures",[94,95,96,107,117],"tbody",{},[84,97,98,104],{},[99,100,101],"td",{},[36,102,103],{},"FnOnce",[99,105,106],{},"May consume captures (move out) — callable once",[84,108,109,114],{},[99,110,111],{},[36,112,113],{},"FnMut",[99,115,116],{},"May mutate captures — callable multiple times (mutably)",[84,118,119,124],{},[99,120,121],{},[36,122,123],{},"Fn",[99,125,126],{},"Only immutable borrows — callable any number of times",[14,128,129,130,133,134,136,137,139,140,142],{},"Each is a supertrait of the next: ",[36,131,132],{},"Fn: FnMut: FnOnce",". So every ",[36,135,123],{}," is also ",[36,138,113],{}," and ",[36,141,103],{},".",[28,144,147],{"className":145,"code":146,"language":33,"meta":34},[31],"let mut s = String::from(\"hi\");\nlet push_closure = || s.push('!');       \u002F\u002F FnMut — needs mut capture\nlet consume_closure = || drop(s);         \u002F\u002F FnOnce — consumes s\n",[36,148,146],{"__ignoreMap":34},[73,150,152,155],{"id":151},"move-keyword",[36,153,154],{},"move"," Keyword",[14,157,158],{},"Forces capture by value (move) regardless of how the closure uses them:",[28,160,163],{"className":161,"code":162,"language":33,"meta":34},[31],"let s = String::from(\"hi\");\nlet f = move || println!(\"{s}\");   \u002F\u002F s moved into f; original invalid\n",[36,164,162],{"__ignoreMap":34},[14,166,167,169,170,58],{},[36,168,154],{}," is essential for thread spawning — closures sent to other threads must own their captures (",[36,171,172],{},"'static",[73,174,176],{"id":175},"disjoint-closure-captures-edition-2021","Disjoint Closure Captures (Edition 2021)",[28,178,181],{"className":179,"code":180,"language":33,"meta":34},[31],"let a = String::from(\"a\");\nlet b = String::from(\"b\");\nlet f = || println!(\"{a} {b}\");   \u002F\u002F edition 2018: borrows BOTH a and b\n                                   \u002F\u002F edition 2021: borrows only what's used in each branch\n",[36,182,180],{"__ignoreMap":34},[14,184,185,186,190],{},"The 2021 edition captures only the ",[187,188,189],"em",{},"used"," fields of disjoint structs, enabling more code to compile.",[23,192,194],{"id":193},"closures-as-arguments","Closures as Arguments",[28,196,199],{"className":197,"code":198,"language":33,"meta":34},[31],"fn apply\u003CF: Fn(i32) -> i32>(f: F, x: i32) -> i32 { f(x) }\nfn apply_mut\u003CF: FnMut(i32) -> i32>(mut f: F, x: i32) -> i32 { f(x) }\nfn apply_once\u003CF: FnOnce() -> i32>(f: F) -> i32 { f() }\n\napply(|x| x + 1, 5);\n",[36,200,198],{"__ignoreMap":34},[14,202,203,204,207],{},"Use ",[36,205,206],{},"impl Fn(...)"," for shorthand:",[28,209,212],{"className":210,"code":211,"language":33,"meta":34},[31],"fn apply(f: impl Fn(i32) -> i32, x: i32) -> i32 { f(x) }\n",[36,213,211],{"__ignoreMap":34},[23,215,217],{"id":216},"returning-closures","Returning Closures",[28,219,222],{"className":220,"code":221,"language":33,"meta":34},[31],"fn make_adder(n: i32) -> impl Fn(i32) -> i32 {\n    move |x| x + n\n}\n\nlet add5 = make_adder(5);\nadd5(10);   \u002F\u002F 15\n",[36,223,221],{"__ignoreMap":34},[14,225,203,226,228],{},[36,227,154],{}," so the closure owns its captures (otherwise it'd borrow a stack variable that's gone).",[14,230,231,232,235],{},"For multiple closure types in different branches, use ",[36,233,234],{},"Box\u003Cdyn Fn()>",":",[28,237,240],{"className":238,"code":239,"language":33,"meta":34},[31],"fn make(pred: bool) -> Box\u003Cdyn Fn(i32) -> i32> {\n    if pred { Box::new(move |x| x + 1) }\n    else    { Box::new(move |x| x - 1) }\n}\n",[36,241,239],{"__ignoreMap":34},[23,243,245],{"id":244},"closure-type-is-unique","Closure Type is Unique",[14,247,248,249,251],{},"Each closure has an anonymous, unnameable type generated by the compiler. Two structurally identical closures have different types. This is why ",[36,250,234],{}," exists for heterogeneous collections.",[23,253,255],{"id":254},"closures-implement-traits","Closures Implement Traits",[28,257,260],{"className":258,"code":259,"language":33,"meta":34},[31],"impl Fn(i32) -> i32 for SomeClosureType { ... }\n",[36,261,259],{"__ignoreMap":34},[14,263,264,265,268,269,271,272,275],{},"Function pointers ",[36,266,267],{},"fn(A) -> B"," also implement ",[36,270,123],{},", so you can pass plain functions where ",[36,273,274],{},"impl Fn"," is expected.",[23,277,279,281,282,281,284,286],{"id":278},"fnfnmutfnonce-object-safety",[36,280,123],{},"\u002F",[36,283,113],{},[36,285,103],{}," Object Safety",[28,288,291],{"className":289,"code":290,"language":33,"meta":34},[31],"let f: Box\u003Cdyn Fn(i32) -> i32> = Box::new(|x| x + 1);\nlet fm: Box\u003Cdyn FnMut(i32) -> i32> = Box::new(|x| x + 1);\nlet fo: Box\u003Cdyn FnOnce(i32) -> i32> = Box::new(|x| x + 1);\n",[36,292,290],{"__ignoreMap":34},[14,294,295,298],{},[36,296,297],{},"Box\u003Cdyn FnOnce>"," is callable since Rust 1.35 (special support).",[23,300,302],{"id":301},"closures-and-iterators","Closures and Iterators",[14,304,305],{},"Closures are the currency of iterator adapters:",[28,307,310],{"className":308,"code":309,"language":33,"meta":34},[31],"v.iter().map(|x| x * 2).filter(|x| *x > 5).for_each(|x| println!(\"{x}\"));\n",[36,311,309],{"__ignoreMap":34},[23,313,315,318],{"id":314},"in-closures",[36,316,317],{},"?"," in Closures",[28,320,323],{"className":321,"code":322,"language":33,"meta":34},[31],"let parse = |s: &str| s.parse::\u003Ci32>()?;   \u002F\u002F closure can use ?\n",[36,324,322],{"__ignoreMap":34},[14,326,327,328,330,331,334,335,58],{},"Closures can use ",[36,329,317],{}," if their return type supports it (",[36,332,333],{},"Result"," or ",[36,336,337],{},"Option",[23,339,341],{"id":340},"recursion-in-closures","Recursion in Closures",[14,343,344],{},"Closures can't easily recurse — they don't have a name. Workarounds:",[39,346,347,353,360],{},[42,348,349,350,142],{},"Use a regular ",[36,351,352],{},"fn",[42,354,355,356,359],{},"Use a ",[36,357,358],{},"Box\u003Cdyn Fn>"," and pass it to itself.",[42,361,203,362,365],{},[36,363,364],{},"Y"," combinator (academic).",[23,367,369,371],{"id":368},"move-closure-captures-and-lifetime",[36,370,154],{}," Closure Captures and Lifetime",[28,373,376],{"className":374,"code":375,"language":33,"meta":34},[31],"let s = String::from(\"hi\");\nlet f = move || println!(\"{s}\");\n\u002F\u002F s moved into f; f now owns the String\n",[36,377,375],{"__ignoreMap":34},[14,379,380,381,383,384,387,388,391,392,394,395,397,398,383,400,402,403,142],{},"Without ",[36,382,154],{},", ",[36,385,386],{},"f"," would borrow ",[36,389,390],{},"s",", which means ",[36,393,390],{}," must outlive ",[36,396,386],{},". With ",[36,399,154],{},[36,401,386],{}," owns its captures and can be ",[36,404,172],{},[23,406,408],{"id":407},"capture-by-reference-by-mut-reference-by-value","Capture By Reference, By Mut Reference, By Value",[28,410,413],{"className":411,"code":412,"language":33,"meta":34},[31],"let n = 5;\nlet f1 = || println!(\"{n}\");        \u002F\u002F &n\nlet mut m = 0;\nlet mut f2 = || m += 1;             \u002F\u002F &mut m\nlet s = String::from(\"x\");\nlet f3 = || drop(s);                 \u002F\u002F moves s out — FnOnce\nlet f4 = move || println!(\"{n}\");    \u002F\u002F copies n (i32 is Copy)\n",[36,414,412],{"__ignoreMap":34},[14,416,417,418,421,422,424,425,58],{},"The compiler picks the ",[187,419,420],{},"least restrictive"," capture mode by default. ",[36,423,154],{}," forces everything to move (or copy if ",[36,426,427],{},"Copy",[23,429,431],{"id":430},"higher-order-closures","Higher-Order Closures",[28,433,436],{"className":434,"code":435,"language":33,"meta":34},[31],"fn make\u003CF: Fn(i32) -> i32>(f: F) -> impl Fn(i32) -> i32 {\n    move |x| f(x) + 1\n}\n",[36,437,435],{"__ignoreMap":34},[14,439,440],{},"Functions returning closures returning closures — typical in functional pipelines.",[23,442,444,447],{"id":443},"partial-currying",[36,445,446],{},"partial"," \u002F Currying",[14,449,450,451,453],{},"Rust doesn't have built-in currying, but ",[36,452,154],{}," closures make it easy:",[28,455,458],{"className":456,"code":457,"language":33,"meta":34},[31],"let add = |a: i32| move |b: i32| a + b;\nlet add5 = add(5);\nadd5(3);   \u002F\u002F 8\n",[36,459,457],{"__ignoreMap":34},[23,461,463],{"id":462},"edge-cases-pitfalls","Edge Cases & Pitfalls",[39,465,466,478,495,517,526,543,559,587],{},[42,467,468,471,472,474,475,477],{},[18,469,470],{},"Capture lifetime",": a closure borrowing from local vars can't escape the local's scope. Use ",[36,473,154],{}," (often with ",[36,476,172],{}," requirement).",[42,479,480,487,488,491,492,494],{},[18,481,482,139,484],{},[36,483,103],{},[36,485,486],{},"Vec::map",": ",[36,489,490],{},"map"," consumes the iterator but only requires ",[36,493,113],{},"; if you consume captures inside, you might need a different signature.",[42,496,497,507,508,510,511,513,514,516],{},[18,498,499,501,502,501,504,506],{},[36,500,123],{}," vs ",[36,503,113],{},[36,505,103],{}," matching",": passing a ",[36,509,103],{}," closure to a function expecting ",[36,512,123],{}," won't compile. Pass ",[36,515,123],{}," when possible.",[42,518,519,522,523,525],{},[18,520,521],{},"Recursive closure",": not directly possible; use a ",[36,524,352],{}," instead.",[42,527,528,534,535,538,539,542],{},[18,529,530,531],{},"Closures with ",[36,532,533],{},"&mut self",": a method that takes a closure that ",[187,536,537],{},"also"," borrows ",[36,540,541],{},"self"," mutably conflicts. Restructure (e.g., extract a value first).",[42,544,545,551,552,555,556,558],{},[18,546,547,548],{},"Capturing by ",[36,549,550],{},"RefCell",": if you need to mutate through a closure called multiple times behind an ",[36,553,554],{},"&","-reference, use ",[36,557,550],{}," for interior mutability.",[42,560,561,487,566,569,570,573,574,576,577,580,581,583,584,586],{},[18,562,563,565],{},[36,564,154],{}," doesn't always move",[36,567,568],{},"move || println!(\"{x}\")"," for ",[36,571,572],{},"x: i32"," copies; ",[36,575,154],{}," only forces ",[187,578,579],{},"by-value"," capture (which is ",[36,582,427],{},"-duplicating for ",[36,585,427],{}," types).",[42,588,589,595,596,599,600,142],{},[18,590,591,594],{},[36,592,593],{},"move ||"," in threads",": required for ",[36,597,598],{},"std::thread::spawn"," since the closure must be ",[36,601,602],{},"'static + Send",[23,604,606,139,609],{"id":605},"threadspawn-and-static-send",[36,607,608],{},"thread::spawn",[36,610,602],{},[28,612,615],{"className":613,"code":614,"language":33,"meta":34},[31],"let data = vec![1, 2, 3];\nstd::thread::spawn(move || {\n    println!(\"{:?}\", data);   \u002F\u002F OK — data moved in\n});\n",[36,616,614],{"__ignoreMap":34},[14,618,380,619,621,622,625,626,628,629,631,632,634],{},[36,620,154],{},", you'd borrow ",[36,623,624],{},"data",", which doesn't satisfy ",[36,627,172],{},". ",[36,630,154],{}," + ",[36,633,602],{}," is the recipe for thread closures.",[23,636,638],{"id":637},"summary","Summary",[14,640,641,642,644,645,647,648,650,651,653,654,281,656,281,658,660,661,663,664,666],{},"Closures capture by ref (",[36,643,123],{},"), mut ref (",[36,646,113],{},"), or value (",[36,649,103],{},"). ",[36,652,154],{}," forces by-value. Use ",[36,655,206],{},[36,657,113],{},[36,659,103],{}," for generic APIs. Closures are essential for iterator combinators and async. Returning closures requires ",[36,662,274],{}," (single type) or ",[36,665,358],{}," (heterogeneous).",[14,668,669,670,383,672,674,675,142],{},"Next: Error handling — ",[36,671,333],{},[36,673,337],{},", and ",[36,676,317],{},{"title":34,"searchDepth":678,"depth":678,"links":679},2,[680,681,688,689,690,691,692,694,695,697,698,700,701,702,704,705,707],{"id":25,"depth":678,"text":26},{"id":61,"depth":678,"text":62,"children":682},[683,685,687],{"id":75,"depth":684,"text":76},3,{"id":151,"depth":684,"text":686},"move Keyword",{"id":175,"depth":684,"text":176},{"id":193,"depth":678,"text":194},{"id":216,"depth":678,"text":217},{"id":244,"depth":678,"text":245},{"id":254,"depth":678,"text":255},{"id":278,"depth":678,"text":693},"Fn\u002FFnMut\u002FFnOnce Object Safety",{"id":301,"depth":678,"text":302},{"id":314,"depth":678,"text":696},"? in Closures",{"id":340,"depth":678,"text":341},{"id":368,"depth":678,"text":699},"move Closure Captures and Lifetime",{"id":407,"depth":678,"text":408},{"id":430,"depth":678,"text":431},{"id":443,"depth":678,"text":703},"partial \u002F Currying",{"id":462,"depth":678,"text":463},{"id":605,"depth":678,"text":706},"thread::spawn and 'static + Send",{"id":637,"depth":678,"text":638},"Closures are anonymous functions that capture their environment. They bridge the gap between functions and objects.","md",{},true,"\u002Frust\u002F17-closures",{"title":5,"description":708},"rust\u002F17-closures","1ngdjkh5xMEyhtAY7fpeGpSXSfefWaQgDYyI-2lszcA",1785934963042]