ce is often the cause. The fix is usually to add an explicit lifetime tie or to introduce indirection (",[42,517,311],{}," makes some invariance problems tractable).",[18,520,522],{"id":521},"higher-rank-trait-bounds-hrtbs","Higher-Rank Trait Bounds (HRTBs)",[62,524,525],{"language":64},[66,526,528],{"className":68,"code":527,"language":64,"meta":70,"style":70},"fn foo\u003CF>(f: F) where F: for\u003C'a> Fn(&'a str) { \u002F* ... *\u002F }\n",[42,529,530],{"__ignoreMap":70},[74,531,532,534,537,540,543,546,548,551,554,557,559,561,564,566,568,571,574,576,579,581,583,585,587,589],{"class":76,"line":77},[74,533,81],{"class":80},[74,535,536],{"class":84}," foo",[74,538,539],{"class":88},"\u003C",[74,541,542],{"class":84},"F",[74,544,545],{"class":88},">(f",[74,547,98],{"class":80},[74,549,550],{"class":84}," F",[74,552,553],{"class":88},") ",[74,555,556],{"class":80},"where",[74,558,550],{"class":84},[74,560,98],{"class":80},[74,562,563],{"class":80}," for",[74,565,89],{"class":88},[74,567,92],{"class":84},[74,569,570],{"class":88},"> ",[74,572,573],{"class":84},"Fn",[74,575,404],{"class":88},[74,577,578],{"class":80},"&",[74,580,104],{"class":88},[74,582,92],{"class":84},[74,584,109],{"class":84},[74,586,112],{"class":88},[74,588,116],{"class":115},[74,590,119],{"class":88},[14,592,593,596,597,599,600,603,604,607],{},[42,594,595],{},"for\u003C'a>"," means \"for all possible lifetimes ",[42,598,48],{},"\". The function ",[42,601,602],{},"f"," must accept any borrowed ",[42,605,606],{},"&str",", not just one with a specific lifetime.",[209,609,611],{"id":610},"where-hrtbs-appear","Where HRTBs Appear",[170,613,614,679],{},[173,615,616,617],{},"Closures that take references without explicit lifetimes:\n",[62,618,619],{"language":64},[66,620,622],{"className":68,"code":621,"language":64,"meta":70,"style":70},"let f: impl for\u003C'a> Fn(&'a str) = |s| println!(\"{s}\");\n",[42,623,624],{"__ignoreMap":70},[74,625,626,628,631,633,636,638,640,642,644,646,648,650,652,654,656,658,660,663,666,669,672,674,677],{"class":76,"line":77},[74,627,125],{"class":80},[74,629,630],{"class":88}," f",[74,632,98],{"class":80},[74,634,635],{"class":80}," impl",[74,637,563],{"class":80},[74,639,89],{"class":88},[74,641,92],{"class":84},[74,643,570],{"class":88},[74,645,573],{"class":84},[74,647,404],{"class":88},[74,649,578],{"class":80},[74,651,104],{"class":88},[74,653,92],{"class":84},[74,655,109],{"class":84},[74,657,553],{"class":88},[74,659,392],{"class":80},[74,661,662],{"class":80}," |",[74,664,665],{"class":88},"s",[74,667,668],{"class":80},"|",[74,670,671],{"class":84}," println!",[74,673,404],{"class":88},[74,675,676],{"class":145},"\"{s}\"",[74,678,410],{"class":88},[173,680,681,683,684,683,687,690],{},[42,682,573],{},"\u002F",[42,685,686],{},"FnMut",[42,688,689],{},"FnOnce"," implicitly use HRTB on their arguments.",[209,692,694],{"id":693},"common-pattern","Common Pattern",[66,696,701],{"className":697,"code":699,"language":700},[698],"language-text","::rust\nfn apply_any(f: impl for\u003C'a> Fn(&'a [u8])) {\n    let buf = [0u8; 16];\n    f(&buf);\n}\n","text",[42,702,699],{"__ignoreMap":70},[18,704,706],{"id":705},"associated-types-vs-generics","Associated Types vs Generics",[62,708,709],{"language":64},[66,710,712],{"className":68,"code":711,"language":64,"meta":70,"style":70},"\u002F\u002F Associated type — impl picks:\ntrait Iterator { type Item; fn next(&mut self) -> Option\u003CSelf::Item>; }\n\n\u002F\u002F Generic — caller picks:\ntrait From\u003CT> { fn from(value: T) -> Self; }\n",[42,713,714,719,774,780,785],{"__ignoreMap":70},[74,715,716],{"class":76,"line":77},[74,717,718],{"class":115},"\u002F\u002F Associated type — impl picks:\n",[74,720,721,724,727,730,733,736,739,741,744,746,749,753,755,758,761,763,766,768,771],{"class":76,"line":122},[74,722,723],{"class":80},"trait",[74,725,726],{"class":84}," Iterator",[74,728,729],{"class":88}," { ",[74,731,732],{"class":80},"type",[74,734,735],{"class":84}," Item",[74,737,738],{"class":88},"; ",[74,740,81],{"class":80},[74,742,743],{"class":84}," next",[74,745,404],{"class":88},[74,747,748],{"class":80},"&mut",[74,750,752],{"class":751},"snvgF"," self",[74,754,553],{"class":88},[74,756,757],{"class":80},"->",[74,759,760],{"class":84}," Option",[74,762,539],{"class":88},[74,764,765],{"class":751},"Self",[74,767,398],{"class":80},[74,769,770],{"class":84},"Item",[74,772,773],{"class":88},">; }\n",[74,775,776],{"class":76,"line":152},[74,777,779],{"emptyLinePlaceholder":778},true,"\n",[74,781,782],{"class":76,"line":465},[74,783,784],{"class":115},"\u002F\u002F Generic — caller picks:\n",[74,786,787,789,792,794,796,799,801,804,807,809,812,814,816,819],{"class":76,"line":484},[74,788,723],{"class":80},[74,790,791],{"class":84}," From",[74,793,539],{"class":88},[74,795,247],{"class":84},[74,797,798],{"class":88},"> { ",[74,800,81],{"class":80},[74,802,803],{"class":84}," from",[74,805,806],{"class":88},"(value",[74,808,98],{"class":80},[74,810,811],{"class":84}," T",[74,813,553],{"class":88},[74,815,757],{"class":80},[74,817,818],{"class":751}," Self",[74,820,821],{"class":88},"; }\n",[14,823,824,825,828,829,259,832,835],{},"Use associated types when each impl has ",[35,826,827],{},"one"," natural type. Use generics when multiple impls can coexist (",[42,830,831],{},"From\u003C&str>",[42,833,834],{},"From\u003CString>",").",[18,837,839,842],{"id":838},"impl-trait-internals",[42,840,841],{},"impl Trait"," Internals",[14,844,845,848,849,852,853,856],{},[42,846,847],{},"fn f() -> impl Trait"," returns ",[35,850,851],{},"some"," concrete type that implements ",[42,854,855],{},"Trait",". The type is inferred per return path; if branches return different concrete types, you must box.",[14,858,859,862,863,866],{},[42,860,861],{},"fn f(x: impl Trait)"," is sugar for ",[42,864,865],{},"fn f\u003CT: Trait>(x: T)",". The caller picks the type.",[18,868,870,873],{"id":869},"dyn-trait-type-erasure",[42,871,872],{},"dyn Trait"," Type Erasure",[14,875,876,878,879,882,