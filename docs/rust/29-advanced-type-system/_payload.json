[{"data":1,"prerenderedAt":1075},["ShallowReactive",2],{"page-\u002Frust\u002F29-advanced-type-system":3},{"id":4,"title":5,"body":6,"description":16,"extension":1068,"meta":1069,"navigation":1070,"path":1071,"seo":1072,"stem":1073,"__hash__":1074},"content\u002Frust\u002F29-advanced-type-system.md","29 — Advanced Type System (Variance, HRTBs, Subtyping)",{"type":7,"value":8,"toc":1029},"minimark",[9,13,17,22,39,61,71,75,78,117,122,270,274,283,289,299,303,309,313,319,336,340,364,368,374,378,384,398,405,419,429,436,460,471,475,478,519,522,538,542,554,560,570,576,586,602,611,617,624,630,636,678,684,688,694,725,729,732,738,753,757,763,767,784,791,794,800,807,811,814,831,844,848,854,857,864,870,885,889,895,905,909,1012,1016,1026],[10,11,5],"h1",{"id":12},"_29-advanced-type-system-variance-hrtbs-subtyping",[14,15,16],"p",{},"This chapter covers the parts of the type system that most Rust developers never need to write, but should understand to read errors and design libraries.",[18,19,21],"h2",{"id":20},"subtyping-in-rust","Subtyping in Rust",[14,23,24,25,29,30,33,34,38],{},"Most languages have subtyping via inheritance (Cat : Animal). Rust's subtyping is ",[26,27,28],"strong",{},"only"," through ",[26,31,32],{},"lifetimes",": a longer lifetime is a ",[35,36,37],"em",{},"subtype"," of a shorter one.",[14,40,41,45,46,49,50,52,53,56,57,60],{},[42,43,44],"code",{},"'static"," is a subtype of ",[42,47,48],{},"'a"," for any ",[42,51,48],{},": a ",[42,54,55],{},"&'static str"," can be used where ",[42,58,59],{},"&'a str"," is expected.",[62,63,69],"pre",{"className":64,"code":66,"language":67,"meta":68},[65],"language-rust","fn takes_str\u003C'a>(s: &'a str) { \u002F* ... *\u002F }\nlet s: &'static str = \"hi\";\ntakes_str(s);    \u002F\u002F OK: 'static \u003C: 'a\n","rust","",[42,70,66],{"__ignoreMap":68},[18,72,74],{"id":73},"variance","Variance",[14,76,77],{},"Variance describes how subtyping of parameters affects subtyping of the constructed type:",[79,80,81,95,105,111],"ul",{},[82,83,84,87,88,91,92],"li",{},[26,85,86],{},"Covariant"," ",[42,89,90],{},"T \u003C: U"," → ",[42,93,94],{},"F\u003CT> \u003C: F\u003CU>",[82,96,97,87,100,91,102],{},[26,98,99],{},"Contravariant",[42,101,90],{},[42,103,104],{},"F\u003CU> \u003C: F\u003CT>",[82,106,107,110],{},[26,108,109],{},"Invariant"," no subtyping relationship",[82,112,113,116],{},[26,114,115],{},"Bivariant"," both directions (rare; only happens with unused params)",[118,119,121],"h3",{"id":120},"examples","Examples",[123,124,125,137],"table",{},[126,127,128],"thead",{},[129,130,131,135],"tr",{},[132,133,134],"th",{},"Type",[132,136,74],{},[138,139,140,157,175,186,198,214,231,248],"tbody",{},[129,141,142,148],{},[143,144,145],"td",{},[42,146,147],{},"&'a T",[143,149,150,151,153,154],{},"covariant in ",[42,152,48],{}," and ",[42,155,156],{},"T",[129,158,159,164],{},[143,160,161],{},[42,162,163],{},"&'a mut T",[143,165,150,166,168,169,172,173],{},[42,167,48],{},", ",[26,170,171],{},"invariant"," in ",[42,174,156],{},[129,176,177,182],{},[143,178,179],{},[42,180,181],{},"*const T",[143,183,150,184],{},[42,185,156],{},[129,187,188,193],{},[143,189,190],{},[42,191,192],{},"*mut T",[143,194,195,196],{},"invariant in ",[42,197,156],{},[129,199,200,205],{},[143,201,202],{},[42,203,204],{},"fn(T) -> U",[143,206,207,208,210,211],{},"contravariant in ",[42,209,156],{},", covariant in ",[42,212,213],{},"U",[129,215,216,227],{},[143,217,218,168,221,168,224],{},[42,219,220],{},"Box\u003CT>",[42,222,223],{},"Arc\u003CT>",[42,225,226],{},"Vec\u003CT>",[143,228,150,229],{},[42,230,156],{},[129,232,233,244],{},[143,234,235,168,238,168,241],{},[42,236,237],{},"Cell\u003CT>",[42,239,240],{},"RefCell\u003CT>",[42,242,243],{},"UnsafeCell\u003CT>",[143,245,195,246],{},[42,247,156],{},[129,249,250,255],{},[143,251,252],{},[42,253,254],{},"&'a mut &'b T",[143,256,150,257,259,260,263,264,153,267,269],{},[42,258,48],{},", invariant in ",[42,261,262],{},"&'b T"," (which is covariant in ",[42,265,266],{},"'b",[42,268,156],{},")",[118,271,273],{"id":272},"why-does-variance-matter","Why does variance matter?",[14,275,276,277,279,280,282],{},"If ",[42,278,163],{}," were covariant in ",[42,281,156],{},":",[62,284,287],{"className":285,"code":286,"language":67,"meta":68},[65],"let mut s = String::from(\"hi\");\nlet r: &mut &'static str = &mut s;    \u002F\u002F would-be covariance\nlet short = String::from(\"bye\");\n*r = &short;                          \u002F\u002F writes &'short str into a &'static slot\nprintln!(\"{}\", s);                    \u002F\u002F s dangling!\n",[42,288,286],{"__ignoreMap":68},[14,290,291,292,294,295,298],{},"Invariance in ",[42,293,156],{}," for ",[42,296,297],{},"&mut T"," is what prevents this. The compiler rejects the first assignment.",[118,300,302],{"id":301},"practical-implication","Practical Implication",[14,304,305,306,308],{},"When you get a weird lifetime error, invariance is often the cause. The fix is usually to add an explicit lifetime tie or to introduce indirection (",[42,307,220],{}," makes some invariance problems tractable).",[18,310,312],{"id":311},"higher-rank-trait-bounds-hrtbs","Higher-Rank Trait Bounds (HRTBs)",[62,314,317],{"className":315,"code":316,"language":67,"meta":68},[65],"fn foo\u003CF>(f: F) where F: for\u003C'a> Fn(&'a str) { \u002F* ... *\u002F }\n",[42,318,316],{"__ignoreMap":68},[14,320,321,324,325,327,328,331,332,335],{},[42,322,323],{},"for\u003C'a>"," means \"for all possible lifetimes ",[42,326,48],{},"\". The function ",[42,329,330],{},"f"," must accept any borrowed ",[42,333,334],{},"&str",", not just one with a specific lifetime.",[118,337,339],{"id":338},"where-hrtbs-appear","Where HRTBs Appear",[79,341,342,351],{},[82,343,344,345],{},"Closures that take references without explicit lifetimes:\n",[62,346,349],{"className":347,"code":348,"language":67,"meta":68},[65],"let f: impl for\u003C'a> Fn(&'a str) = |s| println!(\"{s}\");\n",[42,350,348],{"__ignoreMap":68},[82,352,353,356,357,356,360,363],{},[42,354,355],{},"Fn","\u002F",[42,358,359],{},"FnMut",[42,361,362],{},"FnOnce"," implicitly use HRTB on their arguments.",[118,365,367],{"id":366},"common-pattern","Common Pattern",[62,369,372],{"className":370,"code":371,"language":67,"meta":68},[65],"fn apply_any(f: impl for\u003C'a> Fn(&'a [u8])) {\n    let buf = [0u8; 16];\n    f(&buf);\n}\n",[42,373,371],{"__ignoreMap":68},[18,375,377],{"id":376},"associated-types-vs-generics","Associated Types vs Generics",[62,379,382],{"className":380,"code":381,"language":67,"meta":68},[65],"\u002F\u002F Associated type — impl picks:\ntrait Iterator { type Item; fn next(&mut self) -> Option\u003CSelf::Item>; }\n\n\u002F\u002F Generic — caller picks:\ntrait From\u003CT> { fn from(value: T) -> Self; }\n",[42,383,381],{"__ignoreMap":68},[14,385,386,387,390,391,168,394,397],{},"Use associated types when each impl has ",[35,388,389],{},"one"," natural type. Use generics when multiple impls can coexist (",[42,392,393],{},"From\u003C&str>",[42,395,396],{},"From\u003CString>",").",[18,399,401,404],{"id":400},"impl-trait-internals",[42,402,403],{},"impl Trait"," Internals",[14,406,407,410,411,414,415,418],{},[42,408,409],{},"fn f() -> impl Trait"," returns ",[35,412,413],{},"some"," concrete type that implements ",[42,416,417],{},"Trait",". The type is inferred per return path; if branches return different concrete types, you must box.",[14,420,421,424,425,428],{},[42,422,423],{},"fn f(x: impl Trait)"," is sugar for ",[42,426,427],{},"fn f\u003CT: Trait>(x: T)",". The caller picks the type.",[18,430,432,435],{"id":431},"dyn-trait-type-erasure",[42,433,434],{},"dyn Trait"," Type Erasure",[14,437,438,440,441,444,445,168,448,168,451,168,454,168,457,397],{},[42,439,434],{}," is a ",[26,442,443],{},"dynamic"," type — values are behind a pointer (",[42,446,447],{},"Box\u003Cdyn Trait>",[42,449,450],{},"&dyn Trait",[42,452,453],{},"Arc\u003Cdyn Trait>",[42,455,456],{},"Rc\u003Cdyn Trait>",[42,458,459],{},"Pin\u003CBox\u003Cdyn Trait>>",[14,461,462,463,466,467,470],{},"The pointer is ",[26,464,465],{},"wide"," (fat): ",[42,468,469],{},"(data_ptr, vtable_ptr)",".",[18,472,474],{"id":473},"object-safety-recap","Object Safety (Recap)",[14,476,477],{},"A trait is object-safe iff:",[79,479,480,487,490,501,506],{},[82,481,482,483,486],{},"No ",[42,484,485],{},"Self"," in argument positions or return by value.",[82,488,489],{},"No generics in methods.",[82,491,492,493,496,497,500],{},"All methods have ",[42,494,495],{},"where Self: Sized"," or take ",[42,498,499],{},"self"," by reference.",[82,502,503,504,470],{},"No associated constants without a default that depend on ",[42,505,485],{},[82,507,508,356,511,514,515,518],{},[42,509,510],{},"Send",[42,512,513],{},"Sync"," as supertraits are OK; ",[42,516,517],{},"Sized"," as a supertrait disqualifies.",[14,520,521],{},"Workarounds for non-object-safe traits:",[79,523,524,529,532],{},[82,525,526,527,470],{},"Use a wrapper trait that doesn't return ",[42,528,485],{},[82,530,531],{},"Use generic dispatch instead of trait objects.",[82,533,534,535,537],{},"Add ",[42,536,495],{}," to static methods.",[18,539,541],{"id":540},"auto-traits","Auto Traits",[14,543,544,168,546,168,548,168,551,553],{},[42,545,510],{},[42,547,513],{},[42,549,550],{},"Unpin",[42,552,517],{}," are auto traits — the compiler auto-implements them based on constituent types.",[62,555,558],{"className":556,"code":557,"language":67,"meta":68},[65],"struct MyType(Rc\u003Cu8>);   \u002F\u002F not Send, not Sync because Rc isn't\nstruct MyType2(Arc\u003Cu8>); \u002F\u002F Send + Sync\n",[42,559,557],{"__ignoreMap":68},[14,561,562,563,356,566,569],{},"You can opt out or opt in via ",[42,564,565],{},"unsafe impl",[42,567,568],{},"impl !Send"," (negative impls are unstable).",[18,571,573,575],{"id":572},"sized-trait",[42,574,517],{}," Trait",[14,577,578,579,581,582,585],{},"Most types are ",[42,580,517],{}," (known size at compile time). Exceptions are ",[42,583,584],{},"?Sized"," types:",[79,587,588],{},[82,589,590,168,593,168,596,168,598,601],{},[42,591,592],{},"str",[42,594,595],{},"[T]",[42,597,434],{},[42,599,600],{},"*const ()"," (in some contexts)",[14,603,604,605,607,608,282],{},"Generic parameters default to ",[42,606,517],{},"; relax with ",[42,609,610],{},"T: ?Sized",[62,612,615],{"className":613,"code":614,"language":67,"meta":68},[65],"fn first_byte(s: &str) -> u8 { \u002F* str is !Sized but you can take &str *\u002F }\nfn foo\u003CT: ?Sized>(x: &T) { \u002F* works for unsized T *\u002F }\n",[42,616,614],{"__ignoreMap":68},[18,618,620,623],{"id":619},"phantomdatat-marker-for-unused-type-params",[42,621,622],{},"PhantomData\u003CT>"," — Marker for Unused Type Params",[62,625,628],{"className":626,"code":627,"language":67,"meta":68},[65],"use std::marker::PhantomData;\n\nstruct Tagged\u003CTag, T> {\n    data: T,\n    _tag: PhantomData\u003CTag>,\n}\n",[42,629,627],{"__ignoreMap":68},[14,631,632,635],{},[42,633,634],{},"PhantomData"," is zero-sized but tells the compiler about ownership\u002Fvariance:",[79,637,638,646,654,666],{},[82,639,640,642,643,645],{},[42,641,622],{}," makes your type behave like it owns a ",[42,644,156],{}," for drop-checking and variance.",[82,647,648,651,652,470],{},[42,649,650],{},"PhantomData\u003C&'a T>"," makes it covariant in ",[42,653,48],{},[82,655,656,659,660,356,663,470],{},[42,657,658],{},"PhantomData\u003C*mut T>"," makes it invariant and ",[42,661,662],{},"!Send",[42,664,665],{},"!Sync",[82,667,668,671,672,153,674,356,676,470],{},[42,669,670],{},"PhantomData\u003Cfn(T) -> ()>"," makes it contravariant in ",[42,673,156],{},[42,675,662],{},[42,677,665],{},[14,679,680,681,683],{},"Picking the right ",[42,682,634],{}," variant is critical for unsafe collections.",[18,685,687],{"id":686},"newtype-pattern","Newtype Pattern",[62,689,692],{"className":690,"code":691,"language":67,"meta":68},[65],"struct Meters(f64);\nstruct Miles(f64);\n\nimpl Meters { fn to_miles(self) -> Miles { Miles(self.0 \u002F 1609.344) } }\n",[42,693,691],{"__ignoreMap":68},[79,695,696,699,706],{},[82,697,698],{},"Zero-cost wrapper for type safety.",[82,700,701,702,705],{},"No accidental mixing: ",[42,703,704],{},"Meters(5.0) + Miles(1.0)"," is a type error.",[82,707,708,709,356,712,356,715,356,718,356,721,724],{},"Implement ",[42,710,711],{},"From",[42,713,714],{},"Into",[42,716,717],{},"Display",[42,719,720],{},"Deref",[42,722,723],{},"Add"," as needed.",[18,726,728],{"id":727},"type-level-programming","Type-Level Programming",[14,730,731],{},"With traits and associated types:",[62,733,736],{"className":734,"code":735,"language":67,"meta":68},[65],"trait Peano { type Next; }\nstruct Zero;\nstruct Succ\u003CT>(T);\n\nimpl Peano for Zero { type Next = Succ\u003CZero>; }\nimpl\u003CT: Peano> Peano for Succ\u003CT> { type Next = Succ\u003CSucc\u003CT>>; }\n\ntype One = \u003CZero as Peano>::Next;\ntype Two = \u003COne as Peano>::Next;\n",[42,737,735],{"__ignoreMap":68},[14,739,740,741,744,745,748,749,752],{},"Practical for ",[42,742,743],{},"typenum"," (compile-time integers), dimension tracking (",[42,746,747],{},"uom","), and ",[42,750,751],{},"frunk","'s HList.",[18,754,756],{"id":755},"const-generics-deep","Const Generics (Deep)",[62,758,761],{"className":759,"code":760,"language":67,"meta":68},[65],"struct Arr\u003Cconst N: usize> { data: [u8; N] }\n\nimpl\u003Cconst N: usize> Arr\u003CN> {\n    fn len(&self) -> usize { N }\n}\n\nfn sum\u003Cconst N: usize>(arr: &[i32; N]) -> i32 { arr.iter().sum() }\n",[42,762,760],{"__ignoreMap":68},[118,764,766],{"id":765},"limits","Limits",[79,768,769,772,778],{},[82,770,771],{},"Only integer\u002Fbool\u002Fchar const params on stable.",[82,773,774,775,397],{},"Const expressions as params are unstable (",[42,776,777],{},"[T; N + 1]",[82,779,780,781,783],{},"Min const generics only — full generics (e.g., ",[42,782,59],{}," const param) is unstable.",[18,785,787,790],{"id":786},"min_specialization-and-full-specialization",[42,788,789],{},"min_specialization"," and Full Specialization",[14,792,793],{},"Specialization lets you provide a more specific impl overriding a general one:",[62,795,798],{"className":796,"code":797,"language":67,"meta":68},[65],"#![feature(min_specialization)]\ntrait Pick { fn pick(&self); }\nimpl\u003CT> Pick for T { default fn pick(&self) { println!(\"default\"); } }\nimpl Pick for String { fn pick(&self) { println!(\"string\"); } }  \u002F\u002F specialized\n",[42,799,797],{"__ignoreMap":68},[14,801,802,803,806],{},"Unstable. Avoid in production. Workarounds: macros, separate traits, or ",[42,804,805],{},"auto impl","-style delegation.",[18,808,810],{"id":809},"higher-kinded-types-hkt","Higher-Kinded Types (HKT)",[14,812,813],{},"Rust doesn't have HKTs (types parameterized over type constructors). Workarounds:",[79,815,816,822,825],{},[82,817,818,821],{},[42,819,820],{},"higher"," crate",[82,823,824],{},"Associated type families (unstable)",[82,826,827,828,830],{},"Manual \"Functor\" traits via ",[42,829,634],{}," (clunky)",[14,832,833,834,168,837,168,840,843],{},"The lack of HKTs limits abstracting over ",[42,835,836],{},"Option",[42,838,839],{},"Vec",[42,841,842],{},"Result"," uniformly. Most code doesn't need it.",[18,845,847],{"id":846},"gats-generic-associated-types","GATs (Generic Associated Types)",[62,849,852],{"className":850,"code":851,"language":67,"meta":68},[65],"trait LendingIterator {\n    type Item\u003C'a> where Self: 'a;\n    fn next(&mut self) -> Option\u003CSelf::Item\u003C'_>>;\n}\n",[42,853,851],{"__ignoreMap":68},[14,855,856],{},"Associated types that themselves have generic params (lifetimes\u002Ftypes). Stable since 1.65. Lets you express borrowing iterators, async traits, etc.",[18,858,860,861],{"id":859},"subtyping-and-cow","Subtyping and ",[42,862,863],{},"Cow",[62,865,868],{"className":866,"code":867,"language":67,"meta":68},[65],"fn process\u003C'a>(s: Cow\u003C'a, str>) { \u002F* ... *\u002F }\nprocess(\"static\".into());      \u002F\u002F Cow::Borrowed(&'static str)\nprocess(String::from(\"x\").into());   \u002F\u002F Cow::Owned\n",[42,869,867],{"__ignoreMap":68},[14,871,872,875,876,878,879,45,882,470],{},[42,873,874],{},"Cow\u003C'a, B>"," is variant in ",[42,877,48],{}," (covariant), so ",[42,880,881],{},"Cow\u003C'static, str>",[42,883,884],{},"Cow\u003C'a, str>",[18,886,888],{"id":887},"negative-trait-impls","Negative Trait Impls",[62,890,893],{"className":891,"code":892,"language":67,"meta":68},[65],"impl !Send for MyType {}\n",[42,894,892],{"__ignoreMap":68},[14,896,897,898,901,902,470],{},"Unstable; you can opt out of auto traits today via ",[42,899,900],{},"PhantomData\u003C*const ()>"," or ",[42,903,904],{},"Rc\u003C()>",[18,906,908],{"id":907},"common-pitfalls","Common Pitfalls",[79,910,911,924,945,959,968,981,996],{},[82,912,913,916,917,919,920,923],{},[26,914,915],{},"Forgetting variance",": writing ",[42,918,622],{}," when you needed ",[42,921,922],{},"PhantomData\u003Cfn() -> T>"," (covariant vs invariant).",[82,925,926,929,930,933,934,937,938,440,941,944],{},[26,927,928],{},"HRTB vs named lifetime",": ",[42,931,932],{},"fn(&str)"," is ",[42,935,936],{},"for\u003C'a> fn(&'a str)","; ",[42,939,940],{},"fn\u003C'a>(&'a str)",[35,942,943],{},"specific"," lifetime.",[82,946,947,952,953,955,956,470],{},[26,948,949],{},[42,950,951],{},"dyn Trait + 'static",": by default ",[42,954,434],{}," borrows for some lifetime; you usually want ",[42,957,958],{},"Box\u003Cdyn Trait + 'static>",[82,960,961,964,965,967],{},[26,962,963],{},"Object safety regression",": adding a generic method to a trait breaks all ",[42,966,434],{}," users.",[82,969,970,973,974,977,978,470],{},[26,971,972],{},"Auto-trait inference",": a struct containing a ",[42,975,976],{},"Rc"," makes the whole struct ",[42,979,980],{},"!Send + !Sync",[82,982,983,929,988,991,992,995],{},[26,984,985,987],{},[42,986,517],{}," default",[42,989,990],{},"fn foo\u003CT>()"," requires ",[42,993,994],{},"T: Sized","; unsized locals and parameters are unstable.",[82,997,998,929,1003,1005,1006,1008,1009,470],{},[26,999,1000,1001],{},"Trait objects and ",[42,1002,510],{},[42,1004,447],{}," isn't ",[42,1007,510],{}," unless you write ",[42,1010,1011],{},"Box\u003Cdyn Trait + Send>",[18,1013,1015],{"id":1014},"summary","Summary",[14,1017,1018,1019,1022,1023,1025],{},"Variance governs subtype relationships and is mostly about lifetimes (and ",[42,1020,1021],{},"&mut","'s invariance in ",[42,1024,156],{},"). HRTBs express \"for all lifetimes.\" Associated types vs generics: one natural type vs caller-supplied. Object safety limits trait objects. GATs (1.65+) enable borrowing in associated types. Const generics (1.51+) parameterize by integers\u002Fbools. PhantomData tunes variance and drop behavior. Newtype pattern is the idiomatic type-distinctness tool.",[14,1027,1028],{},"Next: Common design patterns and idiomatic Rust.",{"title":68,"searchDepth":1030,"depth":1030,"links":1031},2,[1032,1033,1039,1043,1044,1046,1048,1049,1050,1052,1054,1055,1056,1059,1061,1062,1063,1065,1066,1067],{"id":20,"depth":1030,"text":21},{"id":73,"depth":1030,"text":74,"children":1034},[1035,1037,1038],{"id":120,"depth":1036,"text":121},3,{"id":272,"depth":1036,"text":273},{"id":301,"depth":1036,"text":302},{"id":311,"depth":1030,"text":312,"children":1040},[1041,1042],{"id":338,"depth":1036,"text":339},{"id":366,"depth":1036,"text":367},{"id":376,"depth":1030,"text":377},{"id":400,"depth":1030,"text":1045},"impl Trait Internals",{"id":431,"depth":1030,"text":1047},"dyn Trait Type Erasure",{"id":473,"depth":1030,"text":474},{"id":540,"depth":1030,"text":541},{"id":572,"depth":1030,"text":1051},"Sized Trait",{"id":619,"depth":1030,"text":1053},"PhantomData\u003CT> — Marker for Unused Type Params",{"id":686,"depth":1030,"text":687},{"id":727,"depth":1030,"text":728},{"id":755,"depth":1030,"text":756,"children":1057},[1058],{"id":765,"depth":1036,"text":766},{"id":786,"depth":1030,"text":1060},"min_specialization and Full Specialization",{"id":809,"depth":1030,"text":810},{"id":846,"dep