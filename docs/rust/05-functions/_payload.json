[{"data":1,"prerenderedAt":466},["ShallowReactive",2],{"page-\u002Frust\u002F05-functions":3},{"id":4,"title":5,"body":6,"description":25,"extension":459,"meta":460,"navigation":461,"path":462,"seo":463,"stem":464,"__hash__":465},"content\u002Frust\u002F05-functions.md","05 — Functions",{"type":7,"value":8,"toc":438},"minimark",[9,13,18,29,56,60,66,85,89,92,98,106,112,118,124,128,136,160,164,170,177,183,219,229,247,251,258,264,278,282,288,301,305,308,314,320,323,329,335,339,345,348,352,428,432],[10,11,5],"h1",{"id":12},"_05-functions",[14,15,17],"h2",{"id":16},"basics","Basics",[19,20,26],"pre",{"className":21,"code":23,"language":24,"meta":25},[22],"language-rust","fn add(a: i32, b: i32) -> i32 {\n    a + b            \u002F\u002F last expression — no semicolon — is the return value\n}\n\nfn no_return() {\n    println!(\"returns ()\");\n}\n","rust","",[27,28,23],"code",{"__ignoreMap":25},[30,31,32,40,50],"ul",{},[33,34,35,36,39],"li",{},"The last expression (without ",[27,37,38],{},";",") is the return value.",[33,41,42,43,45,46,49],{},"A trailing ",[27,44,38],{}," makes it a statement returning ",[27,47,48],{},"()",".",[33,51,52,55],{},[27,53,54],{},"return x;"," is for early returns; the implicit last-expression form is idiomatic for the common case.",[14,57,59],{"id":58},"statements-vs-expressions","Statements vs Expressions",[19,61,64],{"className":62,"code":63,"language":24,"meta":25},[22],"let x = (let y = 5;);   \u002F\u002F ERROR: statements don't produce values\nlet y = {\n    let z = 5;\n    z + 1                \u002F\u002F expression — block evaluates to 6\n};\n",[27,65,63],{"__ignoreMap":25},[67,68,69,70,73,74,77,78,77,81,84],"p",{},"Blocks ",[27,71,72],{},"{ ... }"," are expressions. ",[27,75,76],{},"if",", ",[27,79,80],{},"match",[27,82,83],{},"loop"," are also expressions.",[14,86,88],{"id":87},"parameters-patterns","Parameters & Patterns",[67,90,91],{},"Parameters can be patterns:",[19,93,96],{"className":94,"code":95,"language":24,"meta":25},[22],"fn print_pair((a, b): (i32, i32)) { println!(\"{a} {b}\"); }\nfn first((a, _): (i32, i32)) -> i32 { a }\n",[27,97,95],{"__ignoreMap":25},[14,99,101,102,105],{"id":100},"diverging-functions","Diverging Functions (",[27,103,104],{},"-> !",")",[19,107,110],{"className":108,"code":109,"language":24,"meta":25},[22],"fn forever() -> ! {\n    loop {}\n}\nfn die() -> ! {\n    panic!(\"bye\");\n}\n",[27,111,109],{"__ignoreMap":25},[67,113,114,117],{},[27,115,116],{},"!"," coerces to any type, allowing it anywhere a value is expected:",[19,119,122],{"className":120,"code":121,"language":24,"meta":25},[22],"let v: i32 = match opt {\n    Some(x) => x,\n    None => die(),    \u002F\u002F ! coerces to i32\n};\n",[27,123,121],{"__ignoreMap":25},[14,125,127],{"id":126},"default-optional-parameters","Default & Optional Parameters?",[67,129,130,131,135],{},"Rust has ",[132,133,134],"strong",{},"no function overloading or default parameters",". Use:",[30,137,138,141,150],{},[33,139,140],{},"Builder pattern",[33,142,143,144,77,147,105],{},"Multiple methods (",[27,145,146],{},"new",[27,148,149],{},"with_capacity",[33,151,152,153,156,157,105],{},"Traits for \"overloading\" semantics (e.g., ",[27,154,155],{},"From","\u002F",[27,158,159],{},"Into",[14,161,163],{"id":162},"generic-functions-preview","Generic Functions (preview)",[19,165,168],{"className":166,"code":167,"language":24,"meta":25},[22],"fn first\u003CT>(v: &[T]) -> Option\u003C&T> {\n    v.first()\n}\n\nfn max\u003CT: PartialOrd + Copy>(a: T, b: T) -> T {\n    if a > b { a } else { b }\n}\n",[27,169,167],{"__ignoreMap":25},[14,171,173,176],{"id":172},"impl-blocks-methods",[27,174,175],{},"impl"," Blocks (Methods)",[19,178,181],{"className":179,"code":180,"language":24,"meta":25},[22],"struct Rect { w: u32, h: u32 }\n\nimpl Rect {\n    fn area(&self) -> u32 { self.w * self.h }          \u002F\u002F method\n    fn new(w: u32, h: u32) -> Self { Rect { w, h } }    \u002F\u002F associated fn\n    fn set(&mut self, w: u32) { self.w = w; }           \u002F\u002F mut borrow\n}\n",[27,182,180],{"__ignoreMap":25},[30,184,185,195,201,209],{},[33,186,187,190,191,194],{},[27,188,189],{},"&self"," = ",[27,192,193],{},"self: &Self"," (immutable borrow).",[33,196,197,200],{},[27,198,199],{},"&mut self"," = mutable borrow.",[33,202,203,206,207,49],{},[27,204,205],{},"self"," (by value) = consumes ",[27,208,205],{},[33,210,211,212,214,215,218],{},"Associated functions (no ",[27,213,205],{},") called as ",[27,216,217],{},"Rect::new(...)"," (like static methods).",[14,220,222,225,226,228],{"id":221},"self-and-self-keywords",[27,223,224],{},"Self"," and ",[27,227,205],{}," Keywords",[67,230,231,233,234,236,237,239,240,242,243,246],{},[27,232,224],{}," is the type the ",[27,235,175],{}," is for. ",[27,238,205],{}," is the receiver shorthand. ",[27,241,224],{}," in a ",[27,244,245],{},"trait"," body refers to the implementing type.",[14,248,250],{"id":249},"variadic-functions","Variadic Functions",[67,252,253,254,257],{},"Only ",[27,255,256],{},"extern \"C\""," FFI functions can be C-style variadic:",[19,259,262],{"className":260,"code":261,"language":24,"meta":25},[22],"extern \"C\" {\n    fn printf(fmt: *const u8, ...) -> i32;\n}\n",[27,263,261],{"__ignoreMap":25},[67,265,266,267,77,270,273,274,277],{},"Idiomatic variadic-ness comes from macros (",[27,268,269],{},"println!",[27,271,272],{},"vec!",") or slices (",[27,275,276],{},"fn sum(nums: &[i32])",").",[14,279,281],{"id":280},"function-pointers-vs-closures","Function Pointers vs Closures",[19,283,286],{"className":284,"code":285,"language":24,"meta":25},[22],"fn add(a: i32, b: i32) -> i32 { a + b }\nlet fp: fn(i32, i32) -> i32 = add;       \u002F\u002F function pointer, Copy, Sized\nlet cl = |a, b| a + b;                    \u002F\u002F closure, captures env, !Sized\n",[27,287,285],{"__ignoreMap":25},[67,289,290,291,156,294,156,297,300],{},"See the Closures chapter for ",[27,292,293],{},"Fn",[27,295,296],{},"FnMut",[27,298,299],{},"FnOnce"," distinctions.",[14,302,304],{"id":303},"recursion","Recursion",[67,306,307],{},"Rust doesn't guarantee tail-call optimization. Deep recursion can overflow the stack. For deep\u002Fiterative algorithms, convert to an explicit loop with a stack.",[19,309,312],{"className":310,"code":311,"language":24,"meta":25},[22],"fn fact(n: u64) -> u64 {\n    if n == 0 { 1 } else { n * fact(n - 1) }\n}\n",[27,313,311],{"__ignoreMap":25},[14,315,317],{"id":316},"const-fn",[27,318,319],{},"const fn",[67,321,322],{},"Compile-time-callable functions with a restricted feature set:",[19,324,327],{"className":325,"code":326,"language":24,"meta":25},[22],"const fn square(x: i32) -> i32 { x * x }\nconst N: i32 = square(5);   \u002F\u002F evaluated at compile time\n",[27,328,326],{"__ignoreMap":25},[67,330,331,332,334],{},"Each release expands what's allowed in ",[27,333,319],{}," (loops, mutable locals, etc.).",[14,336,338],{"id":337},"calling-conventions-abi","Calling Conventions & ABI",[19,340,343],{"className":341,"code":342,"language":24,"meta":25},[22],"extern \"C\" fn c_fn(x: i32) -> i32 { x + 1 }\nextern \"Rust\" fn rust_fn(x: i32) -> i32 { x + 1 }   \u002F\u002F default\nextern \"C\" { fn imported(x: i32) -> i32; }\n",[27,344,342],{"__ignoreMap":25},[67,346,347],{},"Useful for FFI and callbacks passed to C libraries.",[14,349,351],{"id":350},"edge-cases","Edge Cases",[30,353,354,375,387,401,410,416],{},[33,355,356,362,363,365,366,370,371,374],{},[132,357,358,361],{},[27,359,360],{},"return"," in a closure",": ",[27,364,360],{}," inside a closure returns from the ",[367,368,369],"em",{},"closure",", not the enclosing function (unlike some languages). Use labeled loops\u002Fbreaks or ",[27,372,373],{},"?"," carefully.",[33,376,377,380,381,383,384,386],{},[132,378,379],{},"Block-as-expression footgun",": forgetting the trailing ",[27,382,38],{}," returns the value; adding it silently changes the return type to ",[27,385,48],{},". The compiler catches this.",[33,388,389,398,399,49],{},[132,390,391,394,395],{},[27,392,393],{},"fn"," types are ",[27,396,397],{},"Copy",": you can copy function pointers freely; closures are not necessarily ",[27,400,397],{},[33,402,403,362,406,409],{},[132,404,405],{},"Lifetime elision in fn signatures",[27,407,408],{},"fn first(s: &str) -> &str"," has elided lifetimes; the compiler infers one input lifetime → output lifetime.",[33,411,412,415],{},[132,413,414],{},"Recursion + generics",": monomorphized per type — code bloat risk.",[33,417,418,423,424,427],{},[132,419,420],{},[27,421,422],{},"#[inline]",": a hint; ",[27,425,426],{},"#[inline(always)]"," can bloat code; usually trust the compiler.",[14,429,431],{"id":430},"summary","Summary",[67,433,434,435,437],{},"Functions are expressions, support patterns in parameters, can diverge, have no overloading, and methods live in ",[27,436,175],{}," blocks. Next: control flow.",{"title":25,"searchDepth":439,"depth":439,"links":440},2,[441,442,443,444,446,447,448,450,452,453,454,455,456,457,458],{"id":16,"depth":439,"text":17},{"id":58,"depth":439,"text":59},{"id":87,"depth":439,"text":88},{"id":100,"depth":439,"text":445},"Diverging Functions (-> !)",{"id":126,"depth":439,"text":127},{"id":162,"depth":439,"text":163},{"id":172,"depth":439,"text":449},"impl Blocks (Methods)",{"id":221,"depth":439,"text":451},"Self and self Keywords",{"id":249,"depth":439,"text":250},{"id":280,"depth":439,"text":281},{"id":303,"depth":439,"text":304},{"id":316,"depth":439,"text":319},{"id":337,"depth":439,"text":338},{"id":350,"depth":439,"text":351},{"id":430,"depth":439,"text":431},"md",{},true,"\u002Frust\u002F05-functions",{"title":5,"description":25},"rust\u002F05-functions","vqYAeWaYt-UYkTMrcZVaixykCAb7NqmRQbxcbqlp0EE",1785934755594]