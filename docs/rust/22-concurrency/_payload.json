[{"data":1,"prerenderedAt":812},["ShallowReactive",2],{"page-\u002Frust\u002F22-concurrency":3},{"id":4,"title":5,"body":6,"description":804,"extension":805,"meta":806,"navigation":807,"path":808,"seo":809,"stem":810,"__hash__":811},"content\u002Frust\u002F22-concurrency.md","22 — Concurrency & Multithreading",{"type":7,"value":8,"toc":770},"minimark",[9,13,31,39,60,72,75,163,167,177,207,211,217,226,237,243,251,258,264,268,274,280,285,291,295,316,320,329,335,344,347,353,363,368,374,381,386,392,401,407,411,429,435,439,476,489,493,499,502,506,520,534,540,546,552,556,659,663,715,719,738,742,767],[10,11,5],"h1",{"id":12},"_22-concurrency-multithreading",[14,15,16,17,21,22,26,27,30],"p",{},"Rust's promise: ",[18,19,20],"strong",{},"fearless concurrency",". The type system prevents data races at compile time via ",[23,24,25],"code",{},"Send"," and ",[23,28,29],{},"Sync",".",[32,33,35,26,37],"h2",{"id":34},"send-and-sync",[23,36,25],{},[23,38,29],{},[40,41,42,48],"ul",{},[43,44,45,47],"li",{},[23,46,25],{},": a type can be transferred across threads (ownership moves safely).",[43,49,50,52,53,56,57,59],{},[23,51,29],{},": ",[23,54,55],{},"&T"," can be shared across threads (multiple threads can hold ",[23,58,55],{}," simultaneously).",[14,61,62,63,66,67,69,70,30],{},"They're ",[18,64,65],{},"auto-traits",": the compiler implements them automatically when all fields are ",[23,68,25],{},"\u002F",[23,71,29],{},[14,73,74],{},"Examples:",[40,76,77,92,104,115,133,145],{},[43,78,79,82,83,82,86,52,89,30],{},[23,80,81],{},"i32",", ",[23,84,85],{},"String",[23,87,88],{},"Vec\u003CT>",[23,90,91],{},"Send + Sync",[43,93,94,97,98,100,101,103],{},[23,95,96],{},"Rc\u003CT>",": not ",[23,99,29],{}," (shared non-atomic refcount), not ",[23,102,25],{}," (cheap counter).",[43,105,106,52,109,111,112,30],{},[23,107,108],{},"Arc\u003CT>",[23,110,91],{}," if ",[23,113,114],{},"T: Send + Sync",[43,116,117,69,120,52,123,125,126,129,130,132],{},[23,118,119],{},"Cell\u003CT>",[23,121,122],{},"RefCell\u003CT>",[23,124,25],{}," (if ",[23,127,128],{},"T: Send",") but not ",[23,131,29],{}," (no synchronization).",[43,134,135,69,138,52,141,111,143,30],{},[23,136,137],{},"Mutex\u003CT>",[23,139,140],{},"RwLock\u003CT>",[23,142,91],{},[23,144,128],{},[43,146,147,148,69,151,97,154,69,156,158,159,162],{},"Raw pointers ",[23,149,150],{},"*const T",[23,152,153],{},"*mut T",[23,155,25],{},[23,157,29],{}," (the compiler is conservative; opt in with ",[23,160,161],{},"unsafe impl",").",[32,164,166],{"id":165},"spawning-threads","Spawning Threads",[168,169,175],"pre",{"className":170,"code":172,"language":173,"meta":174},[171],"language-rust","use std::thread;\nuse std::time::Duration;\n\nlet handle = thread::spawn(|| {\n    for i in 0..5 {\n        println!(\"thread: {i}\");\n        thread::sleep(Duration::from_millis(10));\n    }\n});\n\nfor i in 0..5 {\n    println!(\"main: {i}\");\n    thread::sleep(Duration::from_millis(10));\n}\n\nhandle.join().unwrap();\n","rust","",[23,176,172],{"__ignoreMap":174},[40,178,179,188,201],{},[43,180,181,184,185,30],{},[23,182,183],{},"thread::spawn"," returns a ",[23,186,187],{},"JoinHandle\u003CT>",[43,189,190,193,194,197,198,162],{},[23,191,192],{},".join()"," blocks until the thread exits, returning ",[23,195,196],{},"Result\u003CT, Box\u003Cdyn Any + Send>>"," (panic propagates as ",[23,199,200],{},"Err",[43,202,203,204,30],{},"Closures must be ",[23,205,206],{},"'static + Send",[32,208,210],{"id":209},"moving-data-into-threads","Moving Data into Threads",[168,212,215],{"className":213,"code":214,"language":173,"meta":174},[171],"let data = vec![1, 2, 3];\nlet handle = thread::spawn(move || {\n    println!(\"{:?}\", data);   \u002F\u002F data moved in\n});\n\u002F\u002F data not accessible here\nhandle.join().unwrap();\n",[23,216,214],{"__ignoreMap":174},[14,218,219,222,223,162],{},[23,220,221],{},"move"," is almost always required — captures must outlive the thread (",[23,224,225],{},"'static",[32,227,229,230,233,234],{"id":228},"shared-state-with-arc-mutex","Shared State with ",[23,231,232],{},"Arc"," + ",[23,235,236],{},"Mutex",[168,238,241],{"className":239,"code":240,"language":173,"meta":174},[171],"use std::sync::{Arc, Mutex};\nuse std::thread;\n\nlet counter = Arc::new(Mutex::new(0));\nlet mut handles = vec![];\n\nfor _ in 0..10 {\n    let counter = Arc::clone(&counter);\n    handles.push(thread::spawn(move || {\n        let mut n = counter.lock().unwrap();\n        *n += 1;\n    }));\n}\n\nfor h in handles { h.join().unwrap(); }\nprintln!(\"{:?}\", counter);   \u002F\u002F 10\n",[23,242,240],{"__ignoreMap":174},[14,244,245,247,248,250],{},[23,246,232],{}," for shared ownership; ",[23,249,236],{}," for synchronized mutation. Lock guards auto-unlock on drop (RAII).",[32,252,254,257],{"id":253},"rwlock-for-read-heavy-workloads",[23,255,256],{},"RwLock"," for Read-Heavy Workloads",[168,259,262],{"className":260,"code":261,"language":173,"meta":174},[171],"use std::sync::RwLock;\nlet lock = RwLock::new(0);\n\nlet r1 = lock.read().unwrap();\nlet r2 = lock.read().unwrap();   \u002F\u002F multiple readers OK\n\u002F\u002F let w = lock.write().unwrap();   \u002F\u002F would block above\ndrop(r1); drop(r2);\nlet mut w = lock.write().unwrap();\n*w += 1;\n",[23,263,261],{"__ignoreMap":174},[32,265,267],{"id":266},"channel-message-passing","Channel — Message Passing",[14,269,270,273],{},[23,271,272],{},"std::sync::mpsc"," (multi-producer, single-consumer):",[168,275,278],{"className":276,"code":277,"language":173,"meta":174},[171],"use std::sync::mpsc;\nuse std::thread;\n\nlet (tx, rx) = mpsc::channel();\n\nlet h = thread::spawn(move || {\n    let v = rx.recv().unwrap();\n    println!(\"got {v}\");\n});\n\ntx.send(42).unwrap();\nh.join().unwrap();\n",[23,279,277],{"__ignoreMap":174},[281,282,284],"h3",{"id":283},"multi-producer","Multi-Producer",[168,286,289],{"className":287,"code":288,"language":173,"meta":174},[171],"let (tx, rx) = mpsc::channel();\nlet tx2 = tx.clone();   \u002F\u002F multiple senders\nthread::spawn(move || tx.send(1).unwrap());\nthread::spawn(move || tx2.send(2).unwrap());\n",[23,290,288],{"__ignoreMap":174},[281,292,294],{"id":293},"sync-vs-async-channels","Sync vs Async Channels",[40,296,297,307],{},[43,298,299,302,303,306],{},[23,300,301],{},"channel()",": unbounded, ",[23,304,305],{},"send"," never blocks.",[43,308,309,312,313,315],{},[23,310,311],{},"sync_channel(n)",": bounded; ",[23,314,305],{}," blocks when buffer full (backpressure).",[281,317,319],{"id":318},"crossbeam-channels","Crossbeam Channels",[14,321,322,325,326,30],{},[23,323,324],{},"crossbeam-channel"," is more featureful: bounded\u002Funbounded, select, after\u002Ftimeout, easy multi-consumer. Often preferred over ",[23,327,328],{},"std::mpsc",[168,330,333],{"className":331,"code":332,"language":173,"meta":174},[171],"let (s, r) = crossbeam_channel::unbounded();\ns.send(5).unwrap();\n",[23,334,332],{"__ignoreMap":174},[32,336,338,26,341],{"id":337},"park-and-unpark",[23,339,340],{},"park",[23,342,343],{},"unpark",[14,345,346],{},"Threads can be paused and woken:",[168,348,351],{"className":349,"code":350,"language":173,"meta":174},[171],"let h = thread::spawn(|| {\n    thread::park();\n    println!(\"unparked\");\n});\nh.thread().unpark();\nh.join().unwrap();\n",[23,352,350],{"__ignoreMap":174},[14,354,355,356,359,360,30],{},"Low-level synchronization — usually use channels, ",[23,357,358],{},"Condvar",", or ",[23,361,362],{},"Barrier",[32,364,366],{"id":365},"condvar",[23,367,358],{},[168,369,372],{"className":370,"code":371,"language":173,"meta":174},[171],"use std::sync::{Arc, Mutex, Condvar};\n\nlet pair = Arc::new((Mutex::new(false), Condvar::new()));\nlet (lock, cvar) = Arc::clone(&pair);\n\nlet h = thread::spawn(move || {\n    let (mut started, cvar) = (&lock.0.lock().unwrap(), &lock.1);\n    while !*started {\n        started = cvar.wait(started).unwrap();\n    }\n});\n\n{\n    let (mut started, cvar) = (&lock.0.lock().unwrap(), &lock.1);\n    *started = true;\n    cvar.notify_one();\n}\n\nh.join().unwrap();\n",[23,373,371],{"__ignoreMap":174},[14,375,376,377,380],{},"The classic pattern: wait inside the lock; ",[23,378,379],{},"wait"," atomically releases + sleeps + reacquires.",[32,382,384],{"id":383},"barrier",[23,385,362],{},[168,387,390],{"className":388,"code":389,"language":173,"meta":174},[171],"use std::sync::Barrier;\nlet barrier = Arc::new(Barrier::new(3));\n\u002F\u002F each thread calls barrier.wait(); all unblock once 3 reach it\n",[23,391,389],{"__ignoreMap":174},[32,393,395,26,398],{"id":394},"once-and-oncelock",[23,396,397],{},"Once",[23,399,400],{},"OnceLock",[168,402,405],{"className":403,"code":404,"language":173,"meta":174},[171],"use std::sync::OnceLock;\nstatic INIT: OnceLock\u003CVec\u003Cu8>> = OnceLock::new();\nlet data = INIT.get_or_init(|| load_config());\n",[23,406,404],{"__ignoreMap":174},[32,408,410],{"id":409},"atomic-types","Atomic Types",[14,412,413,52,416,82,419,82,422,82,425,428],{},[23,414,415],{},"std::sync::atomic",[23,417,418],{},"AtomicBool",[23,420,421],{},"AtomicI32",[23,423,424],{},"AtomicUsize",[23,426,427],{},"AtomicPtr\u003CT>",", etc.",[168,430,433],{"className":431,"code":432,"language":173,"meta":174},[171],"use std::sync::atomic::{AtomicUsize, Ordering};\nlet n = AtomicUsize::new(0);\nn.fetch_add(1, Ordering::SeqCst);\nn.compare_exchange(0, 1, Ordering::SeqCst, Ordering::Relaxed);\n",[23,434,432],{"__ignoreMap":174},[281,436,438],{"id":437},"orderings","Orderings",[40,440,441,447,456,464,470],{},[43,442,443,446],{},[23,444,445],{},"Relaxed",": no ordering constraints, just atomicity.",[43,448,449,452,453,162],{},[23,450,451],{},"Acquire",": later reads see the latest writes (pair with ",[23,454,455],{},"Release",[43,457,458,460,461,463],{},[23,459,455],{},": prior writes are visible to ",[23,462,451],{}," readers.",[43,465,466,469],{},[23,467,468],{},"AcqRel",": both.",[43,471,472,475],{},[23,473,474],{},"SeqCst",": total order across threads (most expensive).",[14,477,478,479,481,482,69,484,69,486,488],{},"Use ",[23,480,474],{}," if unsure; switch to ",[23,483,445],{},[23,485,451],{},[23,487,455],{}," once you understand the memory model.",[32,490,492],{"id":491},"thread-local-storage","Thread-Local Storage",[168,494,497],{"className":495,"code":496,"language":173,"meta":174},[171],"use std::cell::RefCell;\nthread_local! {\n    static COUNTER: RefCell\u003Cu32> = RefCell::new(0);\n}\n\nCOUNTER.with(|c| { *c.borrow_mut() += 1; });\n",[23,498,496],{"__ignoreMap":174},[14,500,501],{},"Per-thread state, no synchronization needed.",[32,503,505],{"id":504},"async-vs-threads","Async vs Threads",[40,507,508,514],{},[43,509,510,513],{},[18,511,512],{},"Threads",": OS-level, ~1 MB stack, ~few µs context switch. Good for blocking I\u002FO.",[43,515,516,519],{},[18,517,518],{},"Async",": lightweight tasks, ~few KB stack, runtime-driven. Good for many concurrent I\u002FO-bound tasks.",[14,521,522,523,526,527,69,530,533],{},"For CPU-bound work, threads or ",[23,524,525],{},"rayon"," (data parallelism) are appropriate. For many concurrent I\u002FO operations, async (",[23,528,529],{},"tokio",[23,531,532],{},"async-std",") scales better.",[32,535,537,539],{"id":536},"rayon-for-data-parallelism",[23,538,525],{}," for Data Parallelism",[168,541,544],{"className":542,"code":543,"language":173,"meta":174},[171],"use rayon::prelude::*;\nlet v: Vec\u003Ci32> = (1..=100).collect();\nlet sum: i32 = v.par_iter().map(|x| x * 2).sum();\n",[23,545,543],{"__ignoreMap":174},[14,547,548,551],{},[23,549,550],{},"par_iter()"," runs the iteration across a thread pool. Drop-in replacement for sequential iterators in many cases.",[32,553,555],{"id":554},"common-pitfalls","Common Pitfalls",[40,557,558,564,575,595,601,610,623,629,637,643],{},[43,559,560,563],{},[18,561,562],{},"Deadlock",": inconsistent lock ordering. Acquire locks in a fixed global order, or use a single lock.",[43,565,566,572,573,30],{},[18,567,568,571],{},[23,569,570],{},"Rc"," across threads",": compile error. Use ",[23,574,232],{},[43,576,577,583,584,587,588,591,592,30],{},[18,578,579,580],{},"Holding a lock across ",[23,581,582],{},"await",": in async code, this can deadlock; use ",[23,585,586],{},"tokio::sync::Mutex"," instead of ",[23,589,590],{},"std::sync::Mutex"," for async contexts, or ",[23,593,594],{},"spawn_blocking",[43,596,597,600],{},[18,598,599],{},"Lock poisoning",": if a thread panics while holding a lock, the lock becomes poisoned. Decide on a recovery policy.",[43,602,603,609],{},[18,604,605,606],{},"Spawning without ",[23,607,608],{},"join",": detached threads can outlive main, dropping work mid-flight. Detach deliberately, not by accident.",[43,611,612,619,620,622],{},[18,613,614,616,617],{},[23,615,183],{}," requires ",[23,618,225],{},": closures can't borrow stack data unless ",[23,621,221],{},"d.",[43,624,625,628],{},[18,626,627],{},"Shared mutable state",": prefer message passing (channels) when possible — it isolates state and avoids locking.",[43,630,631,636],{},[18,632,633,635],{},[23,634,91],{}," are not enough for correctness",": they prevent data races, not logical races or deadlocks.",[43,638,639,642],{},[18,640,641],{},"Atomic orderings are subtle",": wrong ordering causes bugs that don't show on x86 (which is strongly ordered). Test on weak architectures (ARM).",[43,644,645,654,655,658],{},[18,646,647,650,651],{},[23,648,649],{},"Mutex::lock()"," returns ",[23,652,653],{},"Result",": poison is the failure mode. Don't ",[23,656,657],{},"unwrap"," blindly in production code paths.",[32,660,662],{"id":661},"patterns","Patterns",[40,664,665,674,686,696,709],{},[43,666,667,52,670,673],{},[18,668,669],{},"Work queue",[23,671,672],{},"mpsc"," channels + worker pool.",[43,675,676,52,679,69,682,685],{},[18,677,678],{},"Pub-Sub",[23,680,681],{},"async-channel",[23,683,684],{},"tokio::sync::broadcast"," for multiple receivers.",[43,687,688,691,692,695],{},[18,689,690],{},"Producer-consumer",": bounded ",[23,693,694],{},"sync_channel"," for backpressure.",[43,697,698,52,701,704,705,708],{},[18,699,700],{},"Read-mostly cache",[23,702,703],{},"RwLock\u003CHashMap\u003C...>>"," or ",[23,706,707],{},"arc-swap"," for atomic replacement.",[43,710,711,714],{},[18,712,713],{},"Sharded locks",": split data into N shards each with its own lock (reduces contention).",[32,716,718],{"id":717},"thread-pool","Thread Pool",[14,720,721,724,725,727,728,730,731,69,734,737],{},[23,722,723],{},"std::thread"," doesn't have a built-in pool. Use ",[23,726,525],{}," (data parallel), ",[23,729,529],{}," (async), or ",[23,732,733],{},"threadpool",[23,735,736],{},"crossbeam_pool"," (custom).",[32,739,741],{"id":740},"summary","Summary",[14,743,744,69,746,748,749,751,752,69,754,756,757,69,759,69,761,763,764,766],{},[23,745,25],{},[23,747,29],{}," are the foundation. Use ",[23,750,232],{}," for shared ownership, ",[23,753,236],{},[23,755,256],{}," for synchronization, channels for message passing. Atomics for low-level coordination. ",[23,758,358],{},[23,760,362],{},[23,762,400],{}," for common patterns. ",[23,765,525],{}," for data parallelism. Prefer async for I\u002FO-bound concurrency.",[14,768,769],{},"Next: Async\u002Fawait — the modern Rust concurrency story.",{"title":174,"searchDepth":771,"depth":771,"links":772},2,[773,775,776,777,779,781,787,789,790,791,793,796,797,798,800,801,802,803],{"id":34,"depth":771,"text":774},"Send and Sync",{"id":165,"depth":771,"text":166},{"id":209,"depth":771,"text":210},{"id":228,"depth":771,"text":778},"Shared State with Arc + Mutex",{"id":253,"depth":771,"text":780},"RwLock for Read-Heavy Workloads",{"id":266,"depth":771,"text":267,"children":782},[783,785,786],{"id":283,"depth":784,"text":284},3,{"id":293,"depth":784,"text":294},{"id":318,"depth":784,"text":319},{"id":337,"depth":771,"text":788},"park and unpark",{"id":365,"depth":771,"text":358},{"id":383,"depth":771,"text":362},{"id":394,"depth":771,"text":792},"Once and OnceLock",{"id":409,"depth":771,"text":410,"children":794},[795],{"id":437,"depth":784,"text":438},{"id":491,"depth":771,"text":492},{"id":504,"depth":771,"text":505},{"id":536,"depth":771,"text":799},"rayon for Data Parallelism",{"id":554,"depth":771,"text":555},{"id":661,"depth":771,"text":662},{"id":717,"depth":771,"text":718},{"id":740,"depth":771,"text":741},"Rust's promise: fearless concurrency. The type system prevents data races at compile time via Send and Sync.","md",{},true,"\u002Frust\u002F22-concurrency",{"title":5,"description":804},"rust\u002F22-concurrency","w8eg4tGR5WT_DyRw_YcxbZFdwdPWnOHcsBSv8R3DWGw",1785934755598]