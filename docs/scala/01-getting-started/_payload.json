y publishing\nlazy val core = crossProject(JVMPlatform, JSPlatform)\n  .crossType(CrossType.Pure)\n  .settings(\n    libraryDependencies ++= Seq(\n      \"org.typelevel\" %% \"cats-core\" % \"2.10.0\",\n      \"org.scalameta\" %% \"munit\"     % \"1.0.0\" % Test\n    )\n  )\n\nlazy val app = project\n  .dependsOn(core.jvm)\n  .enablePlugins(JavaAppPackaging)   \u002F\u002F sbt-native-packager → Debian\u002FRPM\u002FDocker\n",[20,399,400,405,422,436,462,466,471,489,507,523,534,547,552,557,563,590,606,612,624,644,666,672,678,683,697,703],{"__ignoreMap":30},[34,401,402],{"class":36,"line":37},[34,403,404],{"class":40},"\u002F\u002F build.sbt — production layout with cross-building and strict settings\n",[34,406,407,410,413,416,419],{"class":36,"line":44},[34,408,409],{"class":112},"ThisBuild",[34,411,412],{"class":124}," \u002F",[34,414,415],{"class":212}," scalaVersion ",[34,417,418],{"class":124},":=",[34,420,421],{"class":120}," \"3.3.3\"\n",[34,423,424,426,428,431,433],{"class":36,"line":50},[34,425,409],{"class":112},[34,427,412],{"class":124},[34,429,430],{"class":212}," organization ",[34,432,418],{"class":124},[34,434,435],{"class":120}," \"com.acme\"\n",[34,437,438,440,442,445,447,450,453,456,459],{"class":36,"line":56},[34,439,409],{"class":112},[34,441,412],{"class":124},[34,443,444],{"class":212}," version      ",[34,446,418],{"class":124},[34,448,449],{"class":212}," sys.env.getOrElse(",[34,451,452],{"class":120},"\"APP_VERSION\"",[34,454,455],{"class":212},", ",[34,457,458],{"class":120},"\"0.1.0-SNAPSHOT\"",[34,460,461],{"class":212},")\n",[34,463,464],{"class":36,"line":62},[34,465,140],{"emptyLinePlaceholder":139},[34,467,468],{"class":36,"line":68},[34,469,470],{"class":40},"\u002F\u002F Compile-time fatal warnings, unused-symbol detection\n",[34,472,473,475,477,480,483,486],{"class":36,"line":77},[34,474,409],{"class":112},[34,476,412],{"class":124},[34,478,479],{"class":212}," scalacOptions ",[34,481,482],{"class":124},"++=",[34,484,485],{"class":11