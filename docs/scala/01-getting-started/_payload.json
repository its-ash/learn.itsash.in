     \u002F\u002F immutable (preferred)\nvar count = 0                         \u002F\u002F mutable\ncount = 1\n\n\u002F\u002F Types (usually inferred, but explicit here)\nval age: Int = 30\nval pi: Double = 3.14159\nval active: Boolean = true\n\n\u002F\u002F String interpolation\nval greeting = s\"Hello, $name\"        \u002F\u002F \"Hello, Alice\"\nval msg = s\"Age: ${age + 1}\"         \u002F\u002F \"Age: 31\"\n\n\u002F\u002F Expressions (if returns a value)\nval max = if (age > 18) \"adult\" else \"minor\"\n\n\u002F\u002F Functions\ndef add(a: Int, b: Int): Int = a + b\nval result = add(5, 3)                \u002F\u002F 8\n\n\u002F\u002F Lambda (anonymous function)\nval double = (x: Int) => x * 2\ndouble(5)                              \u002F\u002F 10\n\n\u002F\u002F Collections\nval numbers = List(1, 2, 3)\nval person = Map(\"name\" -> \"Alice\", \"age\" -> 30)\nval unique = Set(1, 2, 2, 3)          \u002F\u002F Set(1, 2, 3)\n",[94,643,644,649,654,659,664,668,673,678,683,689,694,700,706,712,717,723,729,734,740,746,752,757,763,769,775,780,786,792,798],{"__ignoreMap":92},[97,645,646],{"class":99,"line":100},[97,647,648],{},"\u002F\u002F Variable declarations\n",[97,650,651],{"class":99,"line":107},[97,652,653],{},"val name = \"Alice\"                    \u002F\u002F immutable (preferred)\n",[97,655,656],{"class":99,"line":149},[97,657,658],{},"var count = 0                         \u002F\u002F mutable\n",[97,660,661],{"class":99,"line":156},[97,662,663],{},"count = 1\n",[97,665,666],{"class":99,"line":162},[97,667,153],{"emptyLinePlaceholder":152},[97,669,670],{"class":99,"line":175},[97,671,672],{},"\u002F\u002F Types (usually inferred, but explicit here)\n",[97,674,675],{"class":99,"line":180},[97,676,677],{},"val age: Int = 30\n",[97,679,680],{"class":99,"line":186},[97,681,682],{},"val pi: Double = 3.14159\n",[97,684,686],{"class":99,"line":685},9,[97,687,688],{},"val active: Boolean = true\n",[97,690,692],{"class":99,"line":691},10,[97,693,153],{"emptyLinePl