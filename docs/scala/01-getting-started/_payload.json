)\nval b = new String(\"hello\")\na == b                                \u002F\u002F true (value equality)\na eq b                                \u002F\u002F false (reference equality)\n",[94,1520,1521,1526,1531,1536],{"__ignoreMap":92},[97,1522,1523],{"class":99,"line":100},[97,1524,1525],{},"val a = new String(\"hello\")\n",[97,1527,1528],{"class":99,"line":107},[97,1529,1530],{},"val b = new String(\"hello\")\n",[97,1532,1533],{"class":99,"line":149},[97,1534,1535],{},"a == b                                \u002F\u002F true (value equality)\n",[97,1537,1538],{"class":99,"line":156},[97,1539,1540],{},"a eq b                                \u002F\u002F false (reference equality)\n",[19,1542,1543,1546],{},[23,1544,1545],{},"Default arguments are evaluated once",": Avoid mutable defaults.",[84,1548,1549],{"language":204},[88,1550,1552],{"className":225,"code":1551,"language":204,"meta":92,"style":92},"def bad(items: scala.collection.mutable.ArrayBuffer[Int] = scala.collection.mutable.ArrayBuffer()) { }\n",[94,1553,1554],{"__ignoreMap":92},[97,1555,1556],{"class":99,"line":100},[97,1557,1551],{},[19,1559,1560,1343,1563,1566,1567,1570,1571,1574,1575,1577],{},[23,1561,1562],{},"Variance gotcha",[94,1564,1565],{},"List[Dog]"," is not a subtype of ",[94,1568,1569],{},"List[Animal]",", even if ",[94,1572,1573],{},"Dog \u003C: Animal",". Use ",[94,1576,1569],{}," if you need flexibility (covariance).",[14,1579,1581],{"id":1580},"spot-the-bug","🧠 Spot the Bug",[19,1583,1584],{},"What does this print?",[84,1586,1587],{"language":204},[88,1588,1590],{"className":225,"code":1589,"language":204,"meta":92,"style":92},"val nums = List(1, 2, 3)\nval result = nums.map { x =>\n  if (x > 1) x * 2\n  else x\n}\nprintln(result)\n",[94,1591,1592,1597,1602,1607,1612,1616],{"__ignoreMap":92},[97,1593,1594],{"class":99,"line":100},[97,1595,1596],{},"val nums = List(1, 2, 3)\n",[97,1598,1599],{"class":99,"line":107},[97,1600,1601],{},"val result = nums.map { x =>\n",[97,1603,1604],{"class":