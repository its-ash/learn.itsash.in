false (reference equality)\n",[94,1510,1511,1516,1521,1526],{"__ignoreMap":92},[97,1512,1513],{"class":99,"line":100},[97,1514,1515],{},"val a = new String(\"hello\")\n",[97,1517,1518],{"class":99,"line":107},[97,1519,1520],{},"val b = new String(\"hello\")\n",[97,1522,1523],{"class":99,"line":149},[97,1524,1525],{},"a == b                                \u002F\u002F true (value equality)\n",[97,1527,1528],{"class":99,"line":156},[97,1529,1530],{},"a eq b                                \u002F\u002F false (reference equality)\n",[19,1532,1533,1536],{},[23,1534,1535],{},"Default arguments are evaluated once",": Avoid mutable defaults.",[88,1538,1540],{"className":223,"code":1539,"language":202,"meta":92,"style":92},"def bad(items: scala.collection.mutable.ArrayBuffer[Int] = scala.collection.mutable.ArrayBuffer()) { }\n",[94,1541,1542],{"__ignoreMap":92},[97,1543,1544],{"class":99,"line":100},[97,1545,1539],{},[19,1547,1548,1341,1551,1554,1555,1558,1559,1562,1563,1565],{},[23,1549,1550],{},"Variance gotcha",[94,1552,1553],{},"List[Dog]"," is not a subtype of ",[94,1556,1557],{},"List[Animal]",", even if ",[94,1560,1561],{},"Dog \u003C: Animal",". Use ",[94,1564,1557],{}," if you need flexibility (covariance).",[14,1567,1569],{"id":1568},"spot-the-bug","🧠 Spot the Bug",[19,1571,1572],{},"What does this print?",[88,1574,1576],{"className":223,"code":1575,"language":202,"meta":92,"style":92},"val nums = List(1, 2, 3)\nval result = nums.map { x =>\n  if (x > 1) x * 2\n  else x\n}\nprintln(result)\n",[94,1577,1578,1583,1588,1593,1598,1602],{"__ignoreMap":92},[97,1579,1580],{"class":99,"line":100},[97,1581,1582],{},"val nums = List(1, 2, 3)\n",[97,1584,1585],{"class":99,"line":107},[97,1586,1587],{},"val result = nums.map { x =>\n",[97,1589,1590],{"class":99,"line":149},[97,1591,1592],{},"  if (x > 1) x * 2\n",[97,1594,1595],{"class":99,"line":156},[97,1596,1597],{},"  else x\n",[97,1599,1600],{"class":99,"line":162},[97,1601,251],{},[97,1603,1604],{"class":99,"line":175},[97,1605,1606],{},"println(result)\n",[1608,1609,1610,1614,1620,1623,1655],"details",{},[1611,1612,1613],"summary",{},"Answer",[19,1615,1616,1617,1411],{},"Prints ",[94,1618,1619],{},"List(1, 4, 6)",[19,1621,1622],{},"Here's why:",[28,1624,1625,1638,1647],{},[31,1626,1627,1630,1631,1634,1635],{},[94,1628,1629],{},"1 > 1"," is false, so ",[94,1632,1633],{},"if"," returns ",[94,1636,1637],{},"1",[31,1639,1640,1643,1644],{},[94,1641,1642],{},"2 > 1"," is true, so ",[94,1645,1646],{},"2 * 2 = 4",[31,1648,1649,1643,1652],{},[94,1650,1651],{},"3 > 1",[94,1653,1654],{},"3 * 2 = 6",[19,1656,1657,1341,1660,1662],{},[23,1658,1659],{},"The lesson",[94,1661,1633],{}," is an expression in Scala (not a statement). It always returns a value, even if you don't explicitly return.",[14,1664,1666],{"id":1665},"next-steps","Next Steps",[1668,1669,1670,1677,1683,1689,1695,1702,1708,1715],"ol",{},[31,1671,1672,1673,1676],{},"Learn ",[23,1674,1675],{},"variables and data types"," (02)",[31,1678,1672,1679,1682],{},[23,1680,1681],{},"functions"," (03)",[31,1684,1672,1685,1688],{},[23,1686,1687],{},"collections"," (04)",[31,1690,1672,1691,1694],{},[23,1692,1693],{},"pattern matching"," (05)",[31,1696,1697,1698,1701],{},"Explore ",[23,1699,1700],{},"OOP"," (classes, inheritance, traits)",[31,1703,1697,1704,1707],{},[23,1705,1706],{},"FP"," (higher-order functions, monads, for-comprehensions)",[31,1709,1710,1711,1714],{},"Try ",[23,1712,1713],{},"Scala CLI"," for quick scripting",[31,1716,1717],{},"Join the Scala community (forums, Discord)",[1719,1720,1721],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-f