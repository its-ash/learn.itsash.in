44},[123,1192,993],{},[31,1194,1195,1201,1202,1205],{},[1150,1196,1197,1200],{},[19,1198,1199],{},"ensuring"," for postconditions",": Attach ",[19,1203,1204],{},".ensuring(condition)"," to an expression for defensive checks.",[115,1207,1209],{"className":117,"code":1208,"language":113,"meta":119,"style":119},"val result = (a + b).ensuring(_ >= 0)\n",[19,1210,1211],{"__ignoreMap":119},[123,1212,1213],{"class":125,"line":126},[123,1214,1208],{},[31,1216,1217,1220,1221,1224],{},[1150,1218,1219],{},"Pattern matching is powerful",": Use it instead of ",[19,1222,1223],{},"instanceof"," + casts. It's type-safe and exhaustiveness-checked.",[115,1226,1228],{"className":117,"code":1227,"language":113,"meta":119,"style":119},"val x: Any = 42\nx match {\n  case i: Int => println(s\"int: $i\")\n  case s: String => println(s\"string: $s\")\n  case _ => println(\"other\")\n}\n",[19,1229,1230,1235,1240,1245,1250,1255],{"__ignoreMap":119},[123,1231,1232],{"class":125,"line":126},[123,1233,1234],{},"val x: Any = 42\n",[123,1236,1237],{"class":125,"line":132},[123,1238,1239],{},"x match {\n",[123,1241,1242],{"class":125,"line":138},[123,1243,1244],{},"  case i: Int => println(s\"int: $i\")\n",[123,1246,1247],{"class":125,"line":144},[123,1248,1249],{},"  case s: String => println(s\"string: $s\")\n",[123,1251,1252],{"class":125,"line":151},[123,1253,1254],{},"  case _ => println(\"other\")\n",[123,1256,1257],{"class":125,"line":203},[123,1258,993],{},[31,1260,1261,1264,1265,1267,1268,1270],{},[1150,1262,1263],{},"Immutable defaults",": Always start with ",[19,1266,21],{}," and immutable collections. Switching to ",[19,1269,25],{}," or mutable collections is a local optimization, not the default design.",[14,1272,1274],{"id":1273},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[31,1276,1277,1283,1284,1287,1288,1291,1292,1295],{},[1150,1278,1279,1282],{},[19,1280,1281],{},".toInt"," on non-numeric String throws",": ",[19,1285,1286],{},"\"abc\".toInt"," crashes. Use ",[19,1289,1290],{},".toIntOption"," to get ",[19,1293,1294],{},"Option[Int]"," instead.",[115,1297,1299],{"className":117,"code":1298,"language":113,"meta":119,"style":119},"\"abc\".toInt              \u002F\u002F throws NumberFormatException\n\"abc\".toIntOption        \u002F\u002F None\n\"42\".toIntOption         \u002F\u002F Some(42)\n",[19,1300,1301,1308,1316],{"__ignoreMap":119},[123,1302,1303,1305],{"class":125,"line":126},[123,1304,1286],{},[123,1306,1307],{},"              \u002F\u002F throws NumberFormatException\n",[123,1309,1310,1313],{"class":125,"line":132},[123,1311,1312],{},"\"abc\".toIntOption",[123,1314,1315],{},"        \u002F\u002F None\n",[123,1317,1318,1321],{"class":125,"line":138},[123,1319,1320],{},"\"42\".toIntOption",[123,1322,1323],{},"         \u002F\u002F Some(42)\n",[31,1325,1326,1283,1329,1332,1333,1336],{},[1150,1327,1328],{},"Tuple access is 1-indexed",[19,1330,1331],{},"(1, 2)._1"," is the first element (not ",[19,1334,1335],{},"._0","). Confusing for developers from 0-indexed languages.",[115,1338,1340],{"className":117,"code":1339,"language":113,"meta":119,"style":119},"val t = (10, 20, 30)\nt._1                     \u002F\u002F 10 (not t._0)\nt._2                     \u002F\u002F 20\n",[19,1341,1342,1347,1352],{"__ignoreMap":119},[123,1343,1344],{"class":125,"line":126},[123,1345,1346],{},"val t = (10, 20, 30)\n",[123,1348,1349],{"class":125,"line":132},[123,1350,1351],{},"t._1                     \u002F\u002F 10 (not t._0)\n",[123,1353,1354],{"class":125,"line":138},[123,1355,1356],{},"t._2                     \u002F\u002F 20\n",[31,1358,1359,1283,1362,1365,1366,1369,1370,1373,1374,1377],{},[1150,1360,1361],{},"Empty List\u002FSet\u002FMap are still truthy",[19,1363,1364],{},"if (List().nonEmpty)"," is false, but ",[19,1367,1368],{},"if (List())"," is true. Always check ",[19,1371,1372],{},".nonEmpty"," or ",[19,1375,1376],{},".isEmpty",", not truthiness.",[115,1379,1381],{"className":117,"code":1380,"language":113,"meta":119,"style":119},"val empty = List()\nif (empty.isEmpty) { }   \u002F\u002F correct\nif (!empty.isEmpty) { }  \u002F\u002F also correct\nif (empty) { }           \u002F\u002F compile error — Scala doesn't allow this\n",[19,1382,1383,1388,1393,1398],{"__ignoreMap":119},[123,1384,1385],{"class":125,"line":126},[123,1386,1387],{},"val empty = List()\n",[123,1389,1390],{"class":125,"line":132},[123,1391,1392],{},"if (empty.isEmpty) { }   \u002F\u002F correct\n",[123,1394,1395],{"class":125,"line":138},[123,1396,1397],{},"if (!empty.isEmpty) { }  \u002F\u002F also correct\n",[123,1399,1400],{"class":125,"line":144},[123,1401,1402],{},"if (empty) { }           \u002F\u002F compile error — Scala doesn't allow this\n",[31,1404,1405,1410,1411,1414,1415,1418,1419,1422],{},[1150,1406,1407,1409],{},[19,1408,25],{}," is rare, but mutable binding != mutable object",": A ",[19,1412,1413],{},"var String"," can be reassigned, but ",[19,1416,1417],{},"String"," itself is immutable. A ",[19,1420,1421],{},"val ArrayBuffer"," is an immutable binding to a mutable collection.",[115,1424,1426],{"className":117,"code":1425,"language":113,"meta":119,"style":119},"val arr = ArrayBuffer(1, 2, 3)\narr += 4                 \u002F\u002F OK — mutating the ArrayBuffer\narr = ArrayBuffer()      \u002F\u002F ERROR — can't reassign val\n\nvar list = List(1, 2, 3)\nlist = list :+ 4        \u002F\u002F OK — reassigning to new List\n",[19,1427,1428,1433,1438,1443,1447,1452],{"__ignoreMap":119},[123,1429,1430],{"class":125,"line":126},[123,1431,1432],{},"val arr = ArrayBuffer(1, 2, 3)\n",[123,1434,1435],{"class":125,"line":132},[123,1436,1437],{},"arr += 4                 \u002F\u002F OK — mutating the ArrayBuffer\n",[123,1439,1440],{"class":125,"line":138},[123,1441,1442],{},"arr = ArrayBuffer()      \u002F\u002F ERROR — can't reassign val\n",[123,1444,1445],{"class":125,"line":144},[123,1446,148],{"emptyLinePlaceholder":147},[123,1448,1449],{"class":125,"line":151},[123,1450,1451],{},"var list = List(1, 2, 3)\n",[123,1453,1454],{"class":125,"line":203},[123,1455,1456],{},"list = list :+ 4        \u002F\u002F OK — reassigning to new List\n",[31,1458,1459,1462],{},[1150,1460,1461],{},"Default arguments evaluate once, not per call",": Avoid mutable defaults; they're shared across calls (same as Python).",[115,1464,1466],{"className":117,"code":1465,"language":113,"meta":119,"style":119},"def bad(items: List[Int] = scala.collection.mutable.ArrayBuffer()) { }  \u002F\u002F WRONG\ndef good(items: List[Int] = List()) { }  \u002F\u002F RIGHT — immutable\n",[19,1467,1468,1473],{"__ignoreMap":119},[123,1469,1470],{"class":125,"line":126},[123,1471,1472],{},"def bad(items: List[Int] = scala.collection.mutable.ArrayBuffer()) { }  \u002F\u002F WRONG\n",[123,1474,1475],{"class":125,"line":132},[123,1476,1477],{},"def good(items: List[Int] = List()) { }  \u002F\u002F RIGHT — immutable\n",[31,1479,1480,1283,1483,1486,1487,1490],{},[1150,1481,1482],{},"Type parameters can't be primitive at runtime",[19,1484,1485],{},"List[Int]"," becomes ",[19,1488,1489],{},"List[Object]"," at runtime (type erasure). This matters for reflection and some pattern matching.",[115,1492,1494],{"className":117,"code":1493,"language":113,"meta":119,"style":119},"List[Int](1, 2).isInstanceOf[List[String]]  \u002F\u002F can't distinguish — both are List\n",[19,1495,1496],{"__ignoreMap":119},[123,1497,1498],{"class":125,"line":126},[123,1499,1493],{},[14,1501,1503],{"id":1502},"spot-the-bug","🧠 Spot the Bug",[31,1505,1506],{},"What does this do?",[115,1508,1510],{"className":117,"code":1509,"language":113,"meta":119,"style":119},"val x = 5\nval y = 10\nval z = if (x > y) \"x wins\" else \"y wins\"\nval result = z match {\n  case \"x wins\" => x\n  case _ => y\n}\nprintln(result)\n",[19,1511,1512,1517,1522,1527,1532,1537,1542,1546],{"__ignoreMap":119},[123,1513,1514],{"class":125,"line":126},[123,1515,1516],{},"val x = 5\n",[123,1518,1519],{"class":125,"line":132},[123,1520,1521],{},"val y = 10\n",[123,1523,1524],{"class":125,"line":138},[123,1525,1526],{},"val z = if (x > y) \"x wins\" else \"y wins\"\n",[123,1528,1529],{"class":125,"line":144},[123,1530,1531],{},"val result = z match {\n",[123,1533,1534],{"class":125,"line":151},[123,1535,1536],{},"  case \"x wins\" => x\n",[123,1538,1539],{"class":125,"line":203},[123,1540,1541],{},"  case _ => y\n",[123,1543,1544],{"class":125,"line":346},[123,1545,993],{},[123,1547,1548],{"class":125,"line":352},[123,1549,1550],{},"println(result)\n",[1552,1553,1554,1558,1565,1568,1604],"details",{},[1555,1556,1557],"summary",{},"Answer",[31,1559,1560,1561,1564],{},"Prints ",[19,1562,1563],{},"10",".",[31,1566,1567],{},"Here's why:",[259,1569,1570,1583],{},[262,1571,1572,1575,1576,1579,1580],{},[19,1573,1574],{},"x > y"," is ",[19,1577,1578],{},"false",", so ",[19,1581,1582],{},"z = \"y wins\"",[262,1584,1585,1586,1589,1590,1593,1594,1597,1598,1601,1602,274],{},"Pattern matching: ",[19,1587,1588],{},"\"y wins\""," doesn't match ",[19,1591,1592],{},"\"x wins\"",", so the ",[19,1595,1596],{},"_"," (wildcard) matches and returns ",[19,1599,1600],{},"y"," (which is ",[19,1603,1563],{},[31,1605,1606,1609,1610,1612],{},[1150,1607,1608],{},"The lesson",": Pattern matching is exhaustive — the compiler checks all branches. If you miss a case, it errors. The wildcard ",[19,1611,1596],{}," is useful for \"anything else.\"",[14,1614,1616],{"id":1615},"key-takeaways","Key Takeaways",[259,1618,1619,1625,1631,1636,1639,1651,1654,1659,1677],{},[262,1620,1621,1622,1624],{},"Prefer ",[19,1623,21],{}," (immutable binding) and immutable collections.",[262,1626,1627,1628,1630],{},"Use ",[19,1629,25],{}," only when you must reassign the binding (rare).",[262,1632,1633,1635],{},[19,1634,29],{}," delays expensive computation until first access.",[262,1637,1638],{},"Scala uses 0-indexed arrays and strings, but 1-indexed tuples (confusing!).",[262,1640,1641,1643,1644,303,1647,1650],{},[19,1642,919],{}," replaces null; use ",[19,1645,1646],{},"Some",[19,1648,1649],{},"None"," patterns.",[262,1652,1653],{},"Type inference is powerful; annotations clarify intent.",[262,1655,1656,1657,1564],{},"Pattern matching is type-safe and exhaustiveness-checked — prefer over ",[19,1658,1223],{},[262,1660,1661,1662,1575,1665,1668,1669,1672,1673,1676],{},"Integer division ",[19,1663,1664],{},"10 \u002F 4",[19,1666,1667],{},"2",", not ",[19,1670,1671],{},"2.5","; use ",[19,1674,1675],{},"10.0 \u002F 4"," for float division.",[262,1678,1679],{},"Floating-point arithmetic has precision issues (same as all languages).",[1681,1682,1683],"style",{},"html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}",{"title":119,"searchDepth":132,"depth":132,"links":1685},[1686,1691,1694,1697,1700,1701,1702,1705,1706,1708,1709,1710,1711,1712],{"id":16,"depth":132,"text":1687,"children":1688},"Declaration: val, var, and lazy val",[1689],{"id":158,"depth":138,"text":1690},"Best practice: prefer val",{"id":209,"depth":132,"text":210,"children":1692},[1693],{"id":253,"depth":138,"text":254},{"id":277,"depth":132,"text":278,"children":1695},[1696],{"id":422,"depth":138,