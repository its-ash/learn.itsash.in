st())"," is true. Always check ",[19,1383,1384],{},".nonEmpty"," or ",[19,1387,1388],{},".isEmpty",", not truthiness.",[111,1391,1392],{"language":113},[115,1393,1395],{"className":117,"code":1394,"language":113,"meta":119,"style":119},"val empty = List()\nif (empty.isEmpty) { }   \u002F\u002F correct\nif (!empty.isEmpty) { }  \u002F\u002F also correct\nif (empty) { }           \u002F\u002F compile error — Scala doesn't allow this\n",[19,1396,1397,1402,1407,1412],{"__ignoreMap":119},[123,1398,1399],{"class":125,"line":126},[123,1400,1401],{},"val empty = List()\n",[123,1403,1404],{"class":125,"line":132},[123,1405,1406],{},"if (empty.isEmpty) { }   \u002F\u002F correct\n",[123,1408,1409],{"class":125,"line":138},[123,1410,1411],{},"if (!empty.isEmpty) { }  \u002F\u002F also correct\n",[123,1413,1414],{"class":125,"line":144},[123,1415,1416],{},"if (empty) { }           \u002F\u002F compile error — Scala doesn't allow this\n",[31,1418,1419,1424,1425,1428,1429,1432,1433,1436],{},[1152,1420,1421,1423],{},[19,1422,25],{}," is rare, but mutable binding != mutable object",": A ",[19,1426,1427],{},"var String"," can be reassigned, but ",[19,1430,1431],{},"String"," itself is immutable. A ",[19,1434,1435],{},"val ArrayBuffer"," is an immutable binding to a mutable collection.",[111,1438,1439],{"language":113},[115,1440,1442],{"className":117,"code":1441,"language":113,"meta":119,"style":119},"val arr = ArrayBuffer(1, 2, 3)\narr += 4                 \u002F\u002F OK — mutating the ArrayBuffer\narr = ArrayBuffer()      \u002F\u002F ERROR — can't reassign val\n\nvar list = List(1, 2, 3)\nlist = list :+ 4        \u002F\u002F OK — reassigning to new List\n",[19,1443,1444,1449,1454,1459,1463,1468],{"__ignoreMap":119},[123,1445,1446],{"class":125,"line":126},[123,1447,1448],{},"val arr = ArrayBuffer(1, 2, 3)\n",[123,1450,1451],{"class":125,"line":132},[123,1452,1453],{},"arr += 4                 \u002F\u002F OK — mutating the ArrayBuffer\n",[123,1455,1456],{"class":125,"line":138},[123,1457,1458],{},"arr = ArrayBuffer()      \u002F\u002F ERROR — can't reassign val\n",[123,1460,1461],{"class":125,"line":144},[123,1462,148],{"emptyLinePlaceholder":147},[123,1464,1465],{"class":125,"line":151},[123,1466,1467],{},"var list = List(1, 2, 3)\n",[123,1469,1470],{"class":125,"line":203},[123,1471,1472],{},"list = list :+ 4        \u002F\u002F OK — reassigning to new List\n",[31,1474,1475,1478],{},[1152,1476,1477],{},"Default arguments evaluate once, not per call",": Avoid mutable defaults; they're shared across calls (same as Python).",[111,1480,1481],{"language":113},[115,1482,1484],{"className":117,"code":1483,"language":113,"meta":119,"style":119},"def bad(items: List[Int] = scala.collection.mutable.ArrayBuffer()) { }  \u002F\u002F WRONG\ndef good(items: List[Int] = List()) { }  \u002F\u002F RIGHT — immutable\n",[19,1485,1486,1491],{"__ignoreMap":119},[123,1487,1488],{"class":125,"line":126},[123,1489,1490],{},"def bad(items: List[Int] = scala.collection.mutable.ArrayBuffer()) { }  \u002F\u002F WRONG\n",[123,1492,1493],{"class":125,"line":132},[123,1494,1495],{},"def good(items: List[Int] = List()) { }  \u002F\u002F RIGHT — immutable\n",[31,1497,1498,1291,1501,1504,1505,1508],{},[1152,1499,1500],{},"Type parameters can't be primitive at runtime",[19,1502,1503],{},"List[Int]"," becomes ",[19,1506,1507],{},"List[Object]"," at runtime (type erasure). This matters for reflection and some pattern matching.",[111,1510,1511],{"language":113},[115,1512,1514],{"className":117,"code":1513,"language":113,"meta":119,"style":119},"List[Int](1, 2).isInstanceOf[List[String]]  \u002F\u002F can't distinguish — both are List\n",[19,1515,1516],{"__ignoreMap":119},[123,1517,1518],{"class":125,"line":126},[123,1519,1513],{},[14,1521,1523],{"id":1522},"spot-the-bug","🧠 Spot the Bug",[31,1525,1526],{},"What does this do?",[111,1528,1529],{"language":113},[115,1530,1532],{"className":117,"code":1531,"language":113,"meta":119,"style":119},"val x = 5\nval y = 10\nval z = if (x > y) \"x wins\" else \"y wins\"\nval result = z match {\n  case \"x wins\" => x\n  case _ => y\n}\nprintln(result)\n",[19,1533,1534,1539,1544,1549,1554,1559,1564,1568],{"__ignoreMap":119},[123,1535,1536],{"class":125,"line":126},[123,1537,1538],{},"val x = 5\n",[123,1540,1541],{"class":125,"line":132},[123,1542,1543],{},"val y = 10\n",[123,1545,1546],{"class":125,"line":138},[123,1547,1548],{},"val z = if (x > y) \"x wins\" else \"y wins\"\n",[123,1550,1551],{"class":125,"line":144},[123,1552,1553],{},"val result = z match {\n",[123,1555,1556],{"class":125,"line":151},[123,1557,1558],{},"  case \"x wins\" => x\n",[123,1560,1561],{"class":125,"line":203},[123,1562,1563],{},"  case _ => y\n",[123,1565,1566],{"class":125,"line":346},[123,1567,993],{},[123,1569,1570],{"class":125,"line":352},[123,1571,1572],{},"println(result)\n",[1574,1575,1576,1580,1587,1590,1626],"details",{},[1577,1578,1579],"summary",{},"Answer",[31,1581,1582,1583,1586],{},"Prints ",[19,1584,1585],{},"10",".",[31,1588,1589],{},"Here's why:",[259,1591,1592,1605],{},[262,1593,1594,1597,1598,1601,1602],{},[19,1595,1596],{},"x > y"," is ",[19,1599,1600],{},"false",", so ",[19,1603,1604],{},"z = \"y wins\"",[262,1606,1607,1608,1611,1612,1615,1616,1619,1620,1623,1624,274],{},"Pattern matching: ",[19,1609,1610],{},"\"y wins\""," doesn't match ",[19,1613,1614],{},"\"x wins\"",", so the ",[19,1617,1618],{},"_"," (wildcard) matches and returns ",[19,1621,1622],{},"y"," (which is ",[19,1625,1585],{},[31,1627,1628,1631,1632,1634],{},[1152,1629,1630],{},"The lesson",": Pattern matching is exhaustive — the compiler checks all branches. If you miss a case, it errors. The wildcard ",[19,1633,1618],{}," is useful for \"anything else.\"",[14,1636,1638],{"id":1637},"key-takeaways","Key Takeaways",[259,1640,1641,1647,1653,1658,1661,1673,1676,1681,1699],{},[262,1642,1643,1644,1646],{},"Prefer ",[19,1645,21],{}," (immutable binding) and immutable collections.",[262,1648,1649,1650,1652],{},"Use ",[19,1651,25],{}," only when you must reassign the binding (rare).",[262,1654,1655,1657],{},[19,1656,29],{}," delays expensive computation until first access.",[262,1659,1660],{},"Scala uses 0-indexed arrays and strings, but 1-indexed tuples (confusing!).",[262,1662,1663,1665,1666,303,1669,1672],{},[19,1664,919],{}," replaces null; use ",[19,1667,1668],{},"Some",[19,1670,1671],{},"None"," patterns.",[262,1674,1675],{},"Type inference is powerful; annotations clarify intent.",[262,1677,1678,1679,1586],{},"Pattern matching is type-safe and exhaustiveness-checked — prefer over ",[19,1680,1229],{},[262,1682,1683,1684,1597,1687,1690,1691,1694,1695,1698],{},"Integer division ",[19,1685,1686],{},"10 \u002F 4",[19,1688,1689],{},"2",", not ",[19,1692,1693],{},"2.5","; use ",[19,1696,1697],{},"10.0 \u002F 4"," for float division.",[262,1700,1701],{},"Floating-point arithmetic has precision issues (same as all languages).",[1703,1704,1705],"style",{},"html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}",{"title":119,"searchDepth":132,"depth":132,"links":1707},[1708,1713,1716,1719,1722