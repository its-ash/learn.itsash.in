[{"data":1,"prerenderedAt":1741},["ShallowReactive",2],{"page-\u002Fscala\u002F02-variables-and-data-types":3},{"id":4,"title":5,"body":6,"description":119,"extension":1735,"meta":1736,"navigation":147,"path":1737,"seo":1738,"stem":1739,"__hash__":1740},"content\u002Fscala\u002F02-variables-and-data-types.md","02 — Variables & Data Types",{"type":7,"value":8,"toc":1706},"minimark",[9,13,30,34,110,155,162,170,207,211,214,251,255,258,275,279,308,420,424,465,469,472,561,565,620,624,684,688,691,755,759,762,861,865,910,914,929,1045,1053,1079,1083,1090,1100,1110,1145,1149,1171,1197,1210,1221,1231,1267,1279,1283,1304,1334,1347,1369,1390,1417,1437,1473,1479,1496,1509,1520,1524,1527,1573,1635,1639,1702],[10,11,5],"h1",{"id":12},"_02-variables-data-types",[14,15,17,18,22,23,26,27],"h2",{"id":16},"declaration-val-var-and-lazy-val","Declaration: ",[19,20,21],"code",{},"val",", ",[19,24,25],{},"var",", and ",[19,28,29],{},"lazy val",[31,32,33],"p",{},"Scala encourages immutability by default.",[35,36,37,59],"table",{},[38,39,40],"thead",{},[41,42,43,47,50,53,56],"tr",{},[44,45,46],"th",{},"Keyword",[44,48,49],{},"Mutable",[44,51,52],{},"Reassignable",[44,54,55],{},"Lazily Evaluated",[44,57,58],{},"Best For",[60,61,62,79,95],"tbody",{},[41,63,64,69,72,74,76],{},[65,66,67],"td",{},[19,68,21],{},[65,70,71],{},"No",[65,73,71],{},[65,75,71],{},[65,77,78],{},"Default — constants and immutable bindings",[41,80,81,85,87,90,92],{},[65,82,83],{},[19,84,25],{},[65,86,71],{},[65,88,89],{},"Yes",[65,91,71],{},[65,93,94],{},"When you must reassign the binding",[41,96,97,101,103,105,107],{},[65,98,99],{},[19,100,29],{},[65,102,71],{},[65,104,71],{},[65,106,89],{},[65,108,109],{},"Expensive computations deferred to first access",[111,112,114],"code-wrapper",{"language":113},"scala",[115,116,120],"pre",{"className":117,"code":118,"language":113,"meta":119,"style":119},"language-scala shiki shiki-themes github-light github-dark","val name = \"Alice\"              \u002F\u002F immutable binding, immutable String\nvar count = 0                   \u002F\u002F mutable binding (can reassign)\ncount = 1                       \u002F\u002F OK\n\nlazy val expensive = fibonacci(1000)  \u002F\u002F computed only when first accessed\n","",[19,121,122,130,136,142,149],{"__ignoreMap":119},[123,124,127],"span",{"class":125,"line":126},"line",1,[123,128,129],{},"val name = \"Alice\"              \u002F\u002F immutable binding, immutable String\n",[123,131,133],{"class":125,"line":132},2,[123,134,135],{},"var count = 0                   \u002F\u002F mutable binding (can reassign)\n",[123,137,139],{"class":125,"line":138},3,[123,140,141],{},"count = 1                       \u002F\u002F OK\n",[123,143,145],{"class":125,"line":144},4,[123,146,148],{"emptyLinePlaceholder":147},true,"\n",[123,150,152],{"class":125,"line":151},5,[123,153,154],{},"lazy val expensive = fibonacci(1000)  \u002F\u002F computed only when first accessed\n",[156,157,159,160],"h3",{"id":158},"best-practice-prefer-val","Best practice: prefer ",[19,161,21],{},[31,163,164,166,167,169],{},[19,165,21],{}," is the default. Use ",[19,168,25],{}," only when you genuinely need to reassign the binding (rare in functional Scala).",[111,171,172],{"language":113},[115,173,175],{"className":117,"code":174,"language":113,"meta":119,"style":119},"val user = User(name = \"Alice\")  \u002F\u002F never changes\nuser.copy(name = \"Bob\")          \u002F\u002F immutable update pattern\n\n\u002F\u002F Don't do this:\nvar user = User(name = \"Alice\")\nuser = User(name = \"Bob\")        \u002F\u002F reassigning binding (vs updating object)\n",[19,176,177,182,187,191,196,201],{"__ignoreMap":119},[123,178,179],{"class":125,"line":126},[123,180,181],{},"val user = User(name = \"Alice\")  \u002F\u002F never changes\n",[123,183,184],{"class":125,"line":132},[123,185,186],{},"user.copy(name = \"Bob\")          \u002F\u002F immutable update pattern\n",[123,188,189],{"class":125,"line":138},[123,190,148],{"emptyLinePlaceholder":147},[123,192,193],{"class":125,"line":144},[123,194,195],{},"\u002F\u002F Don't do this:\n",[123,197,198],{"class":125,"line":151},[123,199,200],{},"var user = User(name = \"Alice\")\n",[123,202,204],{"class":125,"line":203},6,[123,205,206],{},"user = User(name = \"Bob\")        \u002F\u002F reassigning binding (vs updating object)\n",[14,208,210],{"id":209},"type-inference","Type Inference",[31,212,213],{},"Scala infers types from context, but explicit annotations are often clearer.",[111,215,216],{"language":113},[115,217,219],{"className":117,"code":218,"language":113,"meta":119,"style":119},"val x = 42                    \u002F\u002F Int (inferred)\nval y: Int = 42               \u002F\u002F explicit annotation\nval z: Long = 42L             \u002F\u002F force Long type\nval s = \"hello\"               \u002F\u002F String\nval d = 3.14                  \u002F\u002F Double\nval b = true                  \u002F\u002F Boolean\n",[19,220,221,226,231,236,241,246],{"__ignoreMap":119},[123,222,223],{"class":125,"line":126},[123,224,225],{},"val x = 42                    \u002F\u002F Int (inferred)\n",[123,227,228],{"class":125,"line":132},[123,229,230],{},"val y: Int = 42               \u002F\u002F explicit annotation\n",[123,232,233],{"class":125,"line":138},[123,234,235],{},"val z: Long = 42L             \u002F\u002F force Long type\n",[123,237,238],{"class":125,"line":144},[123,239,240],{},"val s = \"hello\"               \u002F\u002F String\n",[123,242,243],{"class":125,"line":151},[123,244,245],{},"val d = 3.14                  \u002F\u002F Double\n",[123,247,248],{"class":125,"line":203},[123,249,250],{},"val b = true                  \u002F\u002F Boolean\n",[156,252,254],{"id":253},"when-to-annotate","When to annotate",[31,256,257],{},"Annotate when:",[259,260,261,265,268],"ul",{},[262,263,264],"li",{},"The inferred type isn't obvious to a reader",[262,266,267],{},"You're defining a function parameter or return type",[262,269,270,271,274],{},"You want to force a parent type (e.g., ",[19,272,273],{},"val x: Number = 42",")",[14,276,278],{"id":277},"numeric-types","Numeric Types",[31,280,281,282,22,285,22,288,22,291,22,294,22,297,26,300,303,304,307],{},"Scala has a complete numeric hierarchy: ",[19,283,284],{},"Byte",[19,286,287],{},"Short",[19,289,290],{},"Int",[19,292,293],{},"Long",[19,295,296],{},"Float",[19,298,299],{},"Double",[19,301,302],{},"BigInt","\u002F",[19,305,306],{},"BigDecimal"," for arbitrary precision.",[111,309,310],{"language":113},[115,311,313],{"className":117,"code":312,"language":113,"meta":119,"style":119},"val b: Byte = 127              \u002F\u002F 8-bit: -128 to 127\nval s: Short = 32767          \u002F\u002F 16-bit\nval i = 42                     \u002F\u002F Int (default integer)\nval l = 42L                    \u002F\u002F Long (64-bit)\n\nval f = 3.14f                  \u002F\u002F Float (32-bit)\nval d = 3.14                   \u002F\u002F Double (default float)\n\nval big = BigInt(\"999999999999999999\")\nval decimal = BigDecimal(\"0.1\")\n\n\u002F\u002F Arithmetic\n10 + 5                         \u002F\u002F 15\n10 - 5                         \u002F\u002F 5\n10 * 5                         \u002F\u002F 50\n10 \u002F 5                         \u002F\u002F 2 (integer division)\n10.0 \u002F 5                       \u002F\u002F 2.0 (float division)\n10 % 3                         \u002F\u002F 1\n2 ^ 64                         \u002F\u002F won't compile (use Math.pow or BigInt)\n",[19,314,315,320,325,330,335,339,344,350,355,361,367,372,378,384,390,396,402,408,414],{"__ignoreMap":119},[123,316,317],{"class":125,"line":126},[123,318,319],{},"val b: Byte = 127              \u002F\u002F 8-bit: -128 to 127\n",[123,321,322],{"class":125,"line":132},[123,323,324],{},"val s: Short = 32767          \u002F\u002F 16-bit\n",[123,326,327],{"class":125,"line":138},[123,328,329],{},"val i = 42                     \u002F\u002F Int (default integer)\n",[123,331,332],{"class":125,"line":144},[123,333,334],{},"val l = 42L                    \u002F\u002F Long (64-bit)\n",[123,336,337],{"class":125,"line":151},[123,338,148],{"emptyLinePlaceholder":147},[123,340,341],{"class":125,"line":203},[123,342,343],{},"val f = 3.14f                  \u002F\u002F Float (32-bit)\n",[123,345,347],{"class":125,"line":346},7,[123,348,349],{},"val d = 3.14                   \u002F\u002F Double (default float)\n",[123,351,353],{"class":125,"line":352},8,[123,354,148],{"emptyLinePlaceholder":147},[123,356,358],{"class":125,"line":357},9,[123,359,360],{},"val big = BigInt(\"999999999999999999\")\n",[123,362,364],{"class":125,"line":363},10,[123,365,366],{},"val decimal = BigDecimal(\"0.1\")\n",[123,368,370],{"class":125,"line":369},11,[123,371,148],{"emptyLinePlaceholder":147},[123,373,375],{"class":125,"line":374},12,[123,376,377],{},"\u002F\u002F Arithmetic\n",[123,379,381],{"class":125,"line":380},13,[123,382,383],{},"10 + 5                         \u002F\u002F 15\n",[123,385,387],{"class":125,"line":386},14,[123,388,389],{},"10 - 5                         \u002F\u002F 5\n",[123,391,393],{"class":125,"line":392},15,[123,394,395],{},"10 * 5                         \u002F\u002F 50\n",[123,397,399],{"class":125,"line":398},16,[123,400,401],{},"10 \u002F 5                         \u002F\u002F 2 (integer division)\n",[123,403,405],{"class":125,"line":404},17,[123,406,407],{},"10.0 \u002F 5                       \u002F\u002F 2.0 (float division)\n",[123,409,411],{"class":125,"line":410},18,[123,412,413],{},"10 % 3                         \u002F\u002F 1\n",[123,415,417],{"class":125,"line":416},19,[123,418,419],{},"2 ^ 64                         \u002F\u002F won't compile (use Math.pow or BigInt)\n",[156,421,423],{"id":422},"edge-case-integer-division","Edge case: integer division",[111,425,426],{"language":113},[115,427,429],{"className":117,"code":428,"language":113,"meta":119,"style":119},"10 \u002F 4                         \u002F\u002F 2 (not 2.5)\n10 \u002F 4.0                       \u002F\u002F 2.5 (at least one operand is Double)\n10.0 \u002F 4                       \u002F\u002F 2.5\n\n\u002F\u002F Floating-point precision (same as JavaScript)\n0.1 + 0.2 == 0.3               \u002F\u002F false\n(0.1 + 0.2) - 0.3 \u003C 1e-9       \u002F\u002F true (epsilon comparison)\n",[19,430,431,436,441,446,450,455,460],{"__ignoreMap":119},[123,432,433],{"class":125,"line":126},[123,434,435],{},"10 \u002F 4                         \u002F\u002F 2 (not 2.5)\n",[123,437,438],{"class":125,"line":132},[123,439,440],{},"10 \u002F 4.0                       \u002F\u002F 2.5 (at least one operand is Double)\n",[123,442,443],{"class":125,"line":138},[123,444,445],{},"10.0 \u002F 4                       \u002F\u002F 2.5\n",[123,447,448],{"class":125,"line":144},[123,449,148],{"emptyLinePlaceholder":147},[123,451,452],{"class":125,"line":151},[123,453,454],{},"\u002F\u002F Floating-point precision (same as JavaScript)\n",[123,456,457],{"class":125,"line":203},[123,458,459],{},"0.1 + 0.2 == 0.3               \u002F\u002F false\n",[123,461,462],{"class":125,"line":346},[123,463,464],{},"(0.1 + 0.2) - 0.3 \u003C 1e-9       \u002F\u002F true (epsilon comparison)\n",[14,466,468],{"id":467},"strings","Strings",[31,470,471],{},"Immutable sequences of characters (UTF-16).",[111,473,474],{"language":113},[115,475,477],{"className":117,"code":476,"language":113,"meta":119,"style":119},"val s = \"hello\"\nval t = 'c'                    \u002F\u002F single character is Char, not String\n\n\u002F\u002F String interpolation\nval name = \"Alice\"\nval age = 30\ns\"Hello $name, age $age\"       \u002F\u002F \"Hello Alice, age 30\"\ns\"Next year: ${age + 1}\"       \u002F\u002F \"Next year: 31\"\n\n\u002F\u002F Raw strings (no escaping)\nraw\"C:\\path\\to\\file\"           \u002F\u002F \"C:\\path\\to\\file\" (no double backslash needed)\n\n\u002F\u002F Multi-line strings\nval poem = \"\"\"\n  |Roses are red\n  |Violets are blue\n  |\"\"\".stripMargin              \u002F\u002F remove leading whitespace\n",[19,478,479,484,489,493,498,503,508,513,518,522,527,532,536,541,546,551,556],{"__ignoreMap":119},[123,480,481],{"class":125,"line":126},[123,482,483],{},"val s = \"hello\"\n",[123,485,486],{"class":125,"line":132},[123,487,488],{},"val t = 'c'                    \u002F\u002F single character is Char, not String\n",[123,490,491],{"class":125,"line":138},[123,492,148],{"emptyLinePlaceholder":147},[123,494,495],{"class":125,"line":144},[123,496,497],{},"\u002F\u002F String interpolation\n",[123,499,500],{"class":125,"line":151},[123,501,502],{},"val name = \"Alice\"\n",[123,504,505],{"class":125,"line":203},[123,506,507],{},"val age = 30\n",[123,509,510],{"class":125,"line":346},[123,511,512],{},"s\"Hello $name, age $age\"       \u002F\u002F \"Hello Alice, age 30\"\n",[123,514,515],{"class":125,"line":352},[123,516,517],{},"s\"Next year: ${age + 1}\"       \u002F\u002F \"Next year: 31\"\n",[123,519,520],{"class":125,"line":357},[123,521,148],{"emptyLinePlaceholder":147},[123,523,524],{"class":125,"line":363},[123,525,526],{},"\u002F\u002F Raw strings (no escaping)\n",[123,528,529],{"class":125,"line":369},[123,530,531],{},"raw\"C:\\path\\to\\file\"           \u002F\u002F \"C:\\path\\to\\file\" (no double backslash needed)\n",[123,533,534],{"class":125,"line":374},[123,535,148],{"emptyLinePlaceholder":147},[123,537,538],{"class":125,"line":380},[123,539,540],{},"\u002F\u002F Multi-line strings\n",[123,542,543],{"class":125,"line":386},[123,544,545],{},"val poem = \"\"\"\n",[123,547,548],{"class":125,"line":392},[123,549,550],{},"  |Roses are red\n",[123,552,553],{"class":125,"line":398},[123,554,555],{},"  |Violets are blue\n",[123,557,558],{"class":125,"line":404},[123,559,560],{},"  |\"\"\".stripMargin              \u002F\u002F remove leading whitespace\n",[156,562,564],{"id":563},"string-methods","String methods",[111,566,567],{"language":113},[115,568,570],{"className":117,"code":569,"language":113,"meta":119,"style":119},"\"hello\".length                 \u002F\u002F 5\n\"hello\"(0)                     \u002F\u002F 'h' (0-indexed, unlike Lua!)\n\"hello\".substring(1, 4)        \u002F\u002F \"ell\"\n\"hello\".toUpperCase()          \u002F\u002F \"HELLO\"\n\"hello\".startsWith(\"he\")       \u002F\u002F true\n\"hello world\".split(\" \")       \u002F\u002F Array(\"hello\", \"world\")\n",[19,571,572,580,588,596,604,612],{"__ignoreMap":119},[123,573,574,577],{"class":125,"line":126},[123,575,576],{},"\"hello\".length",[123,578,579],{},"                 \u002F\u002F 5\n",[123,581,582,585],{"class":125,"line":132},[123,583,584],{},"\"hello\"(0)",[123,586,587],{},"                     \u002F\u002F 'h' (0-indexed, unlike Lua!)\n",[123,589,590,593],{"class":125,"line":138},[123,591,592],{},"\"hello\".substring(1, 4)",[123,594,595],{},"        \u002F\u002F \"ell\"\n",[123,597,598,601],{"class":125,"line":144},[123,599,600],{},"\"hello\".toUpperCase()",[123,602,603],{},"          \u002F\u002F \"HELLO\"\n",[123,605,606,609],{"class":125,"line":151},[123,607,608],{},"\"hello\".startsWith(\"he\")",[123,610,611],{},"       \u002F\u002F true\n",[123,613,614,617],{"class":125,"line":203},[123,615,616],{},"\"hello world\".split(\" \")",[123,618,619],{},"       \u002F\u002F Array(\"hello\", \"world\")\n",[14,621,623],{"id":622},"booleans","Booleans",[111,625,626],{"language":113},[115,627,629],{"className":117,"code":628,"language":113,"meta":119,"style":119},"val a = true\nval b = false\n\n\u002F\u002F Logical operators\na && b                         \u002F\u002F false (logical AND)\na || b                         \u002F\u002F true (logical OR)\n!a                             \u002F\u002F false (logical NOT)\n\n\u002F\u002F Short-circuit evaluation\na || expensive()               \u002F\u002F doesn't call expensive() if a is true\nb && expensive()               \u002F\u002F doesn't call expensive() if b is false\n",[19,630,631,636,641,645,650,655,660,665,669,674,679],{"__ignoreMap":119},[123,632,633],{"class":125,"line":126},[123,634,635],{},"val a = true\n",[123,637,638],{"class":125,"line":132},[123,639,640],{},"val b = false\n",[123,642,643],{"class":125,"line":138},[123,644,148],{"emptyLinePlaceholder":147},[123,646,647],{"class":125,"line":144},[123,648,649],{},"\u002F\u002F Logical operators\n",[123,651,652],{"class":125,"line":151},[123,653,654],{},"a && b                         \u002F\u002F false (logical AND)\n",[123,656,657],{"class":125,"line":203},[123,658,659],{},"a || b                         \u002F\u002F true (logical OR)\n",[123,661,662],{"class":125,"line":346},[123,663,664],{},"!a                             \u002F\u002F false (logical NOT)\n",[123,666,667],{"class":125,"line":352},[123,668,148],{"emptyLinePlaceholder":147},[123,670,671],{"class":125,"line":357},[123,672,673],{},"\u002F\u002F Short-circuit evaluation\n",[123,675,676],{"class":125,"line":363},[123,677,678],{},"a || expensive()               \u002F\u002F doesn't call expensive() if a is true\n",[123,680,681],{"class":125,"line":369},[123,682,683],{},"b && expensive()               \u002F\u002F doesn't call expensive() if b is false\n",[14,685,687],{"id":686},"tuples","Tuples",[31,689,690],{},"Fixed-size heterogeneous collections.",[111,692,693],{"language":113},[115,694,696],{"className":117,"code":695,"language":113,"meta":119,"style":119},"val pair = (1, \"hello\")\nval triple = (1, \"hello\", 3.14)\n\npair._1                        \u002F\u002F 1 (1-indexed access, like Lua!)\npair._2                        \u002F\u002F \"hello\"\n\n\u002F\u002F Destructuring\nval (x, y) = (1, 2)\nval (a, b, c) = (1, \"hello\", 3.14)\n\n\u002F\u002F Ignoring elements\nval (first, _) = (1, 2)\n",[19,697,698,703,708,712,717,722,726,731,736,741,745,750],{"__ignoreMap":119},[123,699,700],{"class":125,"line":126},[123,701,702],{},"val pair = (1, \"hello\")\n",[123,704,705],{"class":125,"line":132},[123,706,707],{},"val triple = (1, \"hello\", 3.14)\n",[123,709,710],{"class":125,"line":138},[123,711,148],{"emptyLinePlaceholder":147},