[{"data":1,"prerenderedAt":1187},["ShallowReactive",2],{"page-\u002Fscala":3},{"id":4,"title":5,"body":6,"description":1180,"extension":1181,"meta":1182,"navigation":801,"path":1183,"seo":1184,"stem":1185,"__hash__":1186},"content\u002Fscala\u002Findex.md","Learn Scala — From Scratch to Advanced",{"type":7,"value":8,"toc":1154},"minimark",[9,14,18,21,26,74,78,104,108,113,203,207,263,267,309,313,355,359,363,377,381,404,408,425,429,443,447,464,468,582,586,686,690,757,761,958,962,965,1028,1032,1064,1068,1106,1110,1117,1131,1140,1144,1147,1150],[10,11,13],"h1",{"id":12},"learn-scala-from-scratch-to-advanced","📖 Learn Scala — From Scratch to Advanced",[15,16,17],"p",{},"A comprehensive, edge-case-covering Scala curriculum. Each document is self-contained and covers its concept deeply enough that a careful reader can go from beginner to advanced Scala developer.",[15,19,20],{},"Scala is a statically-typed, compiled language that runs on the JVM and combines object-oriented and functional programming paradigms. It's used in data engineering (Apache Spark, Kafka), backend services (Twitter, LinkedIn), distributed systems (Akka), and anywhere Java runs but you want better expressiveness.",[22,23,25],"h2",{"id":24},"how-to-use-this-course","How to Use This Course",[27,28,29,37,43,58,68],"ol",{},[30,31,32,36],"li",{},[33,34,35],"strong",{},"Read sequentially"," for a structured path (01 → 11).",[30,38,39,42],{},[33,40,41],{},"Jump to a chapter"," as a reference when you hit a concept in the wild.",[30,44,45,48,49,53,54,57],{},[33,46,47],{},"Run the examples"," using ",[50,51,52],"code",{},"scala-cli"," for quick experimentation or ",[50,55,56],{},"sbt"," for projects.",[30,59,60,63,64,67],{},[33,61,62],{},"Use the REPL",": Type ",[50,65,66],{},"scala"," to start an interactive prompt.",[30,69,70,73],{},[33,71,72],{},"Compare to Java",": If you know Java, note how Scala simplifies or extends it.",[22,75,77],{"id":76},"prerequisites","Prerequisites",[79,80,81,91,98,101],"ul",{},[30,82,83,86,87,90],{},[33,84,85],{},"Java 11+"," installed (",[50,88,89],{},"java -version"," to verify).",[30,92,93,94,97],{},"Scala installed (",[50,95,96],{},"brew install scala"," on macOS, or download from scala-lang.org).",[30,99,100],{},"A text editor (VS Code, IntelliJ IDEA, Vim).",[30,102,103],{},"Basic programming experience (familiarity with Java, Python, or similar).",[22,105,107],{"id":106},"curriculum","Curriculum",[109,110,112],"h3",{"id":111},"part-i-foundations","Part I — Foundations",[114,115,116,132],"table",{},[117,118,119],"thead",{},[120,121,122,126,129],"tr",{},[123,124,125],"th",{},"#",[123,127,128],{},"Topic",[123,130,131],{},"Why It Matters",[133,134,135,151,175,189],"tbody",{},[120,136,137,141,148],{},[138,139,140],"td",{},"01",[138,142,143],{},[144,145,147],"a",{"href":146},"\u002Fscala\u002F01-getting-started","Getting Started",[138,149,150],{},"Installation, REPL, scala-cli, sbt setup, from-Java perspective.",[120,152,153,156,162],{},[138,154,155],{},"02",[138,157,158],{},[144,159,161],{"href":160},"\u002Fscala\u002F02-variables-and-data-types","Variables & Data Types",[138,163,164,167,168,167,171,174],{},[50,165,166],{},"val","\u002F",[50,169,170],{},"var",[50,172,173],{},"lazy val",", type inference, primitives, tuples, type hierarchy.",[120,176,177,180,186],{},[138,178,179],{},"03",[138,181,182],{},[144,183,185],{"href":184},"\u002Fscala\u002F03-functions","Functions",[138,187,188],{},"Declarations, lambdas, higher-order functions, closures, currying.",[120,190,191,194,200],{},[138,192,193],{},"04",[138,195,196],{},[144,197,199],{"href":198},"\u002Fscala\u002F04-control-flow","Control Flow",[138,201,202],{},"If\u002Felse (expressions!), pattern matching, loops, try\u002Fcatch, Option\u002FEither.",[109,204,206],{"id":205},"part-ii-collections-oop","Part II — Collections & OOP",[114,208,209,219],{},[117,210,211],{},[120,212,213,215,217],{},[123,214,125],{},[123,216,128],{},[123,218,131],{},[133,220,221,235,249],{},[120,222,223,226,232],{},[138,224,225],{},"05",[138,227,228],{},[144,229,231],{"href":230},"\u002Fscala\u002F05-collections","Collections",[138,233,234],{},"List, Set, Map, Vector, operations (map\u002Ffilter\u002Ffold), mutability trade-offs.",[120,236,237,240,246],{},[138,238,239],{},"06",[138,241,242],{},[144,243,245],{"href":244},"\u002Fscala\u002F06-classes-and-objects","Classes & Objects",[138,247,248],{},"Class definitions, inheritance, traits, singleton objects, case classes.",[120,250,251,254,260],{},[138,252,253],{},"07",[138,255,256],{},[144,257,259],{"href":258},"\u002Fscala\u002F07-case-classes-and-pattern-matching","Case Classes & Pattern Matching",[138,261,262],{},"Sealed hierarchies, exhaustiveness checking, destructuring, extractors.",[109,264,266],{"id":265},"part-iii-type-system-advanced-features","Part III — Type System & Advanced Features",[114,268,269,279],{},[117,270,271],{},[120,272,273,275,277],{},[123,274,125],{},[123,276,128],{},[123,278,131],{},[133,280,281,295],{},[120,282,283,286,292],{},[138,284,285],{},"08",[138,287,288],{},[144,289,291],{"href":290},"\u002Fscala\u002F08-type-system","Type System",[138,293,294],{},"Generics, bounds, variance, type aliases, implicit parameters, phantom types.",[120,296,297,300,306],{},[138,298,299],{},"09",[138,301,302],{},[144,303,305],{"href":304},"\u002Fscala\u002F09-concurrent-programming","Concurrent Programming",[138,307,308],{},"Futures, async operations, Promise, Try, thread safety, ExecutionContext.",[109,310,312],{"id":311},"part-iv-production","Part IV — Production",[114,314,315,325],{},[117,316,317],{},[120,318,319,321,323],{},[123,320,125],{},[123,322,128],{},[123,324,131],{},[133,326,327,341],{},[120,328,329,332,338],{},[138,330,331],{},"10",[138,333,334],{},[144,335,337],{"href":336},"\u002Fscala\u002F10-testing","Testing",[138,339,340],{},"ScalaTest, matchers, fixtures, property-based testing, mocking.",[120,342,343,346,352],{},[138,344,345],{},"11",[138,347,348],{},[144,349,351],{"href":350},"\u002Fscala\u002F11-java-interoperability","Java Interoperability",[138,353,354],{},"Using Java from Scala, collection conversion, calling Scala from Java.",[22,356,358],{"id":357},"learning-path-suggestions","Learning Path Suggestions",[109,360,362],{"id":361},"if-youre-new-to-programming","If you're new to programming",[27,364,365,368,371,374],{},[30,366,367],{},"Read 01–04 in order (covers fundamentals with Scala perspective).",[30,369,370],{},"Read 05 (Collections) — you'll use these constantly.",[30,372,373],{},"Read 06–07 (OOP and pattern matching — core Scala skills).",[30,375,376],{},"Do small projects before moving to advanced topics.",[109,378,380],{"id":379},"if-youre-coming-from-java","If you're coming from Java",[27,382,383,392,395,398,401],{},[30,384,385,386,388,389,391],{},"Skim 01–03 (Java basics translate easily; note ",[50,387,166],{}," vs ",[50,390,170],{}," and lambdas).",[30,393,394],{},"Read 06 carefully (classes are simpler, traits are powerful).",[30,396,397],{},"Read 07 (case classes and pattern matching are major improvements over Java).",[30,399,400],{},"Read 08 for Scala's type system features (generics, implicits).",[30,402,403],{},"Skip 11 (you know Java interop already).",[109,405,407],{"id":406},"if-youre-coming-from-pythonruby","If you're coming from Python\u002FRuby",[27,409,410,413,416,419,422],{},[30,411,412],{},"Read 02 (type system, type inference).",[30,414,415],{},"Read 03–04 (functions and control flow are different; expressions vs statements).",[30,417,418],{},"Read 05 (collections have different methods; more functional).",[30,420,421],{},"Read 06–07 (OOP and pattern matching replace Python's duck typing).",[30,423,424],{},"Read 09 (async model different from Python; Scala is more JVM-centric).",[109,426,428],{"id":427},"if-youre-coming-from-haskellfunctional-languages","If you're coming from Haskell\u002Ffunctional languages",[27,430,431,434,437,440],{},[30,432,433],{},"Skim 01–06 (you'll find most concepts familiar).",[30,435,436],{},"Read 08 (generics and variance — different from Haskell's approach).",[30,438,439],{},"Read 07 (pattern matching is similar but with different syntax).",[30,441,442],{},"Read 11 (Java interop is unique to Scala).",[109,444,446],{"id":445},"if-youre-a-senior-engineer","If you're a senior engineer",[27,448,449,452,455,458,461],{},[30,450,451],{},"Skim 01–05 (fundamentals review).",[30,453,454],{},"Read 06–07 closely (OOP + pattern matching is Scala's sweet spot).",[30,456,457],{},"Read 08 (type system — implicit parameters are powerful and subtle).",[30,459,460],{},"Read 09 (concurrency and Futures).",[30,462,463],{},"Use 10–11 as references for teams\u002Fprojects.",[22,465,467],{"id":466},"key-differences-from-java","Key Differences from Java",[114,469,470,483],{},[117,471,472],{},[120,473,474,477,480],{},[123,475,476],{},"Concept",[123,478,479],{},"Scala",[123,481,482],{},"Java",[133,484,485,501,512,526,536,547,558,568],{},[120,486,487,490,495],{},[138,488,489],{},"Variables",[138,491,492,494],{},[50,493,166],{}," (immutable, default)",[138,496,497,500],{},[50,498,499],{},"final"," type (verbose)",[120,502,503,506,509],{},[138,504,505],{},"Type inference",[138,507,508],{},"Automatic in many cases",[138,510,511],{},"Rarely inferred",[120,513,514,517,523],{},[138,515,516],{},"Null",[138,518,519,520],{},"Avoided with ",[50,521,522],{},"Option[T]",[138,524,525],{},"Everywhere (nullable)",[120,527,528,530,533],{},[138,529,185],{},[138,531,532],{},"First-class, lambdas",[138,534,535],{},"Objects, verbose anonymous classes",[120,537,538,541,544],{},[138,539,540],{},"Pattern matching",[138,542,543],{},"Built-in, exhaustive",[138,545,546],{},"No language support",[120,548,549,552,555],{},[138,550,551],{},"Traits",[138,553,554],{},"Multiple inheritance via mixins",[138,556,557],{},"Interfaces only",[120,559,560,562,565],{},[138,561,231],{},[138,563,564],{},"Functional methods built-in",[138,566,567],{},"Streams API (verbose)",[120,569,570,573,579],{},[138,571,572],{},"Concurrency",[138,574,575,578],{},[50,576,577],{},"Future","\u002Fasync-await style",[138,580,581],{},"Threads, callbacks, CompletableFuture",[22,583,585],{"id":584},"key-differences-from-python","Key Differences from Python",[114,587,588,599],{},[117,589,590],{},[120,591,592,594,596],{},[123,593,476],{},[123,595,479],{},[123,597,598],{},"Python",[133,600,601,612,622,633,647,664,675],{},[120,602,603,606,609],{},[138,604,605],{},"Type system",[138,607,608],{},"Static, checked at compile-time",[138,610,611],{},"Dynamic, checked at runtime",[120,613,614,616,619],{},[138,615,505],{},[138,617,618],{},"Yes, powerful",[138,620,621],{},"No",[120,623,624,627,630],{},[138,625,626],{},"Performance",[138,628,629],{},"Compiled to JVM bytecode",[138,631,632],{},"Interpreted, slow",[120,634,635,638,644],{},[138,636,637],{},"Immutability",[138,639,640,641,643],{},"Default (",[50,642,166],{},")",[138,645,646],{},"Not default (mutable everything)",[120,648,649,651,659],{},[138,650,516],{},[138,652,653,655,656,643],{},[50,654,522],{}," (not ",[50,657,658],{},"None",[138,660,661,663],{},[50,662,658],{}," (not optional)",[120,665,666,669,672],{},[138,667,668],{},"Async",[138,670,671],{},"Futures, non-blocking",[138,673,674],{},"async\u002Fawait (simpler)",[120,676,677,680,683],{},[138,678,679],{},"Syntax",[138,681,682],{},"More verbose",[138,684,685],{},"Minimal",[22,687,689],{"id":688},"companion-resources","Companion Resources",[79,691,692,701,709,717,725,733,741,749],{},[30,693,694,700],{},[144,695,699],{"href":696,"rel":697},"https:\u002F\u002Fdocs.scala-lang.org",[698],"nofollow","Scala 3 Docs"," — official documentation (modern, comprehensive).",[30,702,703,708],{},[144,704,707],{"href":705,"rel":706},"https:\u002F\u002Fdocs.scala-lang.org\u002Fscala3\u002Fbook\u002Fintroduction.html",[698],"Scala 2 Book"," — foundational concepts.",[30,710,711,716],{},[144,712,715],{"href":713,"rel":714},"https:\u002F\u002Fwww.scala-lang.org\u002Fapi\u002F",[698],"Scala API"," — standard library documentation.",[30,718,719,724],{},[144,720,723],{"href":721,"rel":722},"https:\u002F\u002Fakka.io",[698],"Akka Documentation"," — actor model for distributed systems.",[30,726,727,732],{},[144,728,731],{"href":729,"rel":730},"https:\u002F\u002Fdocs.scala-lang.org\u002Foverviews\u002Fcollections-2.13\u002Foverview.html",[698],"Scala Collections"," — deep dive on collections.",[30,734,735,740],{},[144,736,739],{"href":737,"rel":738},"https:\u002F\u002Ftwitter.github.io\u002Fscala_school\u002F",[698],"Scala School"," — Twitter's introduction (older but good).",[30,742,743,748],{},[144,744,747],{"href":745,"rel":746},"https:\u002F\u002Fwww.manning.com\u002Fbooks\u002Ffunctional-programming-in-scala",[698],"Functional Programming in Scala"," — the book (exercises online).",[30,750,751,756],{},[144,752,755],{"href":753,"rel":754},"https:\u002F\u002Fstackoverflow.com\u002Fquestions\u002Ftagged\u002Fscala",[698],"Stack Overflow"," — Scala tag (active community).",[22,758,760],{"id":759},"tooling-to-install","Tooling to Install",[762,763,765],"code-wrapper",{"language":764},"bash",[766,767,771],"pre",{"className":768,"code":769,"language":764,"meta":770,"style":770},"language-bash shiki shiki-themes github-light github-dark","# Java (required)\njava -version  # verify you have Java 11+\n\n# Scala via Homebrew (macOS)\nbrew install scala\n\n# Or via SDKMAN (all platforms)\ncurl -s \"https:\u002F\u002Fget.sdkman.io\" | bash\nsdk install scala\n\n# Scala CLI (quick experimentation)\nsdk install scala-cli\n# Or: brew install scala-cli\n\n# SBT (project build tool)\nsdk install sbt\n# Or: brew install sbt\n\n# IDE (recommended)\n# - IntelliJ IDEA (best for Scala, free Community Edition)\n# - VS Code with Metals extension (lightweight)\n\n# Linting and formatting\nsbt scalafixAll\n","",[50,772,773,782,796,803,809,822,827,833,852,862,867,873,883,889,894,900,910,916,921,927,933,939,944,950],{"__ignoreMap":770},[774,775,778],"span",{"class":776,"line":777},"line",1,[774,779,781],{"cla