557,1685,1686,1691,1694],{},[1575,1687,1688],{},[26,1689,1690],{},"onScroll",[1575,1692,1693],{},"Element scrolled",[1575,1695,1696],{},"Infinite scroll, sticky headers",[14,1698,1700],{"id":1699},"debouncing-and-throttling-handlers","Debouncing and Throttling Handlers",[19,1702,1703,1704,33,1706,33,1709,1711],{},"High-frequency events (",[26,1705,1690],{},[26,1707,1708],{},"onMouseMove",[26,1710,457],{}," on a search box hitting an API) need debouncing\u002Fthrottling to avoid overwhelming the app or network.",[45,1713,1714],{"language":47},[49,1715,1717],{"className":51,"code":1716,"language":47,"meta":53,"style":53},"function SearchBox({ onSearch }) {\n  const [query, setQuery] = useState('')\n\n  useEffect(() => {\n    if (query === '') return\n    const timeoutId = setTimeout(() => onSearch(query), 300)\n    return () => clearTimeout(timeoutId)  \u002F\u002F cancels the previous timer on every keystroke\n  }, [query, onSearch])\n\n  return \u003Cinput value={query} onChange={e => setQuery(e.target.value)} placeholder=\"Search…\" \u002F>\n}\n",[26,1718,1719,1733,1759,1763,1775,1794,1821,1839,1844,1848,1888],{"__ignoreMap":53},[57,1720,1721,1723,1726,1728,1731],{"class":59,"line":60},[57,1722,64],{"class":63},[57,1724,1725],{"class":67}," SearchBox",[57,1727,308],{"class":71},[57,1729,1730],{"class":87},"onSearch",[57,1732,314],{"class":71},[57,1734,1735,1737,1739,1742,1744,1747,1749,1751,1753,1755,1757],{"class":59,"line":75},[57,1736,923],{"class":63},[57,1738,926],{"class":71},[57,1740,1741],{"class":116},"query",[57,1743,33],{"class":71},[57,1745,1746],{"class":116},"setQuery",[57,1748,937],{"class":71},[57,1750,196],{"class":63},[57,1752,942],{"class":67},[57,1754,84],{"class":71},[57,1756,947],{"class":137},[57,1758,141],{"class":71},[57,1760,1761],{"class":59,"line":94},[57,1762,171],{"emptyLinePlaceholder":170},[57,1764,1765,1768,1771,1773],{"class":59,"line":110},[57,1766,1767],{"class":67},"  useEffect",[57,1769,1770],{"class":71},"(() ",[57,1772,343],{"class":63},[57,1774,346],{"class":71},[57,1776,1777,1780,1783,1786,1789,1791],{"class":59,"line":144},[57,1778,1779],{"class":63},"    if",[57,1781,1782],{"class":71}," (query ",[57,1784,1785],{"class":63},"===",[57,1787,1788],{"class":137}," ''",[57,1790,340],{"class":71},[57,1792,1793],{"class":63},"return\n",[57,1795,1796,1798,1801,1803,1806,1808,1810,1813,1816,1819],{"class":59,"line":161},[57,1797,113],{"class":63},[57,1799,1800],{"class":116}," timeoutId",[57,1802,120],{"class":63},[57,1804,1805],{"class":67}," setTimeout",[57,1807,1770],{"class":71},[57,1809,343],{"class":63},[57,1811,1812],{"class":67}," onSearch",[57,1814,1815],{"class":71},"(query), ",[57,1817,1818],{"class":116},"300",[57,1820,141],{"class":71},[57,1822,1823,1826,1828,1830,1833,1836],{"class":59,"line":167},[57,1824,1825],{"class":63},"    return",[57,1827,640],{"class":71},[57,1829,343],{"class":63},[57,1831,1832],{"class":67}," clearTimeout",[57,1834,1835],{"class":71},"(timeoutId)  ",[57,1837,1838],{"class":106},"\u002F\u002F cancels the previous timer on every keystroke\n",[57,1840,1841],{"class":59,"line":174},[57,1842,1843],{"class":71},"  }, [query, onSearch])\n",[57,1845,1846],{"class":59,"line":183},[57,1847,171],{"emptyLinePlaceholder":170},[57,1849,1850,1852,1854,1856,1858,1860,1863,1865,1867,1869,1871,1873,1876,1878,1881,1883,1886],{"class":59,"line":202},[57,1851,177],{"class":63},[57,1853,1240],{"class":71},[57,1855,208],{"class":189},[57,1857,1045],{"class":67},[57,1859,196],{"class":63},[57,1861,1862],{"class":71},"{query} ",[57,1864,457],{"class":67},[57,1866,196],{"class":63},[57,1868,537],{"class":71},[57,1870,337],{"class":87},[57,1872,738],{"class":63},[57,1874,1875],{"class":67}," setQuery",[57,1877,1066],{"class":71},[57,1879,1880],{"class":67},"placeholder",[57,1882,196],{"class":63},[57,1884,1885],{"class":137},"\"Search…\"",[57,1887,227],{"class":71},[57,1889,1890],{"class":59,"line":230},[57,1891,272],{"class":71},[19,1893,1894,1895,1898,1899,1902],{},"This pattern — debounce via ",[26,1896,1897],{},"useEffect"," + ",[26,1900,1901],{},"setTimeout"," + cleanup — is covered in full in chapter 6; it's included here because it's the standard fix for \"an event handler fires too often.\"",[14,1904,1906],{"id":1905},"tips-tricks","💡 Tips & Tricks",[720,1908,1909,1924,1936,1949,1964],{},[748,1910,1911,1914,1915,1917,1918,1920,1921,1923],{},[23,1912,1913],{},"Idiom"," — Prefer ",[26,1916,290],{}," over ",[26,1919,286],{}," when you need \"the element this handler is attached to,\" especially for delegated click handlers on elements with nested icons\u002Fspans — ",[26,1922,39],{}," can be any descendant the user actually clicked.",[748,1925,1926,1929,1930,1932,1933,1935],{},[23,1927,1928],{},"Debug"," — If a form mysteriously reloads the page or an app's whole state resets on submit, check for a missing ",[26,1931,1154],{}," in the ",[26,1934,916],{}," handler first — it's the single most common cause of \"my app just refreshed for no reason.\"",[748,1937,1938,1941,1942,1945,1946,1948],{},[23,1939,1940],{},"Performance"," — Inline arrow functions in ",[26,1943,1944],{},"onClick={() => doThing(id)}"," inside list items are not a performance problem for the vast majority of apps; don't reach for ",[26,1947,882],{}," here until you've actually measured a re-render problem (see chapter 9 for when it does matter).",[748,1950,1951,1953,1954,441,1956,1958,1959,441,1961,1963],{},[23,1952,1913],{}," — Use ",[26,1955,1667],{},[26,1957,1670],{}," instead of ",[26,1960,1676],{},[26,1962,1679],{}," for hover UI — the Enter\u002FLeave pair doesn't bubble through child elements, avoiding flicker when the pointer crosses internal element boundaries within the hovered area.",[748,1965,1966,1968,1969,1971,1972,1975,1976,1979],{},[23,1967,1928],{}," — When ",[26,1970,1651],{}," handlers seem to \"miss\" certain keys, check whether the element is focusable — click handlers on a non-interactive ",[26,1973,1974],{},"\u003Cdiv>"," fire fine on click, but keyboard events require the element to be in the tab order (",[26,1977,1978],{},"tabIndex={0}",") or be a naturally focusable element.",[14,1981,1983],{"id":1982},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[720,1985,1986,1997,2021,2033,2048],{},[748,1987,1988,1996],{},[23,1989,1151,1990,1992,1993,1995],{},[26,1991,1154],{}," in ",[26,1994,916],{}," reloads the page and wipes all state"," — the browser's default form behavior is a full navigation; React state doesn't survive it, and the bug often looks unrelated to the form itself since the whole app remounts from scratch.",[748,1998,1999,2005,2006,1958,2009,2012,2013,2016,2017,2020],{},[23,2000,2001,2004],{},[26,2002,2003],{},"onClick={fn()}"," calls the function during render, not on click"," — a very easy typo (",[26,2007,2008],{},"onClick={handleDelete(id)}",[26,2010,2011],{},"onClick={() => handleDelete(id)}",") that runs the handler immediately on every render, and — because ",[26,2014,2015],{},"handleDelete"," probably returns ",[26,2018,2019],{},"undefined"," — silently makes the button inert with no error.",[748,2022,2023,2028,2029,2032],{},[23,2024,2025,2027],{},[26,2026,457],{}," in React fires on every keystroke, not on blur\u002Fcommit like plain HTML"," — code ported from a non-React mental model that expects ",[26,2030,2031],{},"change"," to fire only when focus leaves the field will see far more invocations than expected; this is a deliberate React normalization, not a bug (see chapter 14 for the controlled-input model this supports).",[748,2034,2035,2040,2041,2043,2044,2047],{},[23,2036,2037,2039],{},[26,2038,36],{}," inside a child can silently break unrelated ancestor logic"," — a modal's inner click handler calling ",[26,2042,36],{}," to avoid triggering the overlay's close handler also prevents ",[499,2045,2046],{},"any other"," ancestor listener (e.g., an analytics \"track all clicks\" listener higher in the tree) from ever seeing that click.",[748,2049,2050,2053,2054,2057,2058,2060,2061,2064],{},[23,2051,2052],{},"Synthetic event objects are pooled in React ≤16 and reused across events"," — accessing ",[26,2055,2056],{},"event.type"," asynchronously (e.g., inside a ",[26,2059,1901],{}," after the handler returns) throws or reads ",[26,2062,2063],{},"null"," in React 16 and earlier, because the pooled event object gets recycled. React 17+ removed event pooling, so this specific gotcha is legacy-only — but it still explains a class of \"works in a new project, breaks in this old codebase\" bugs.",[14,2066,2068],{"id":2067},"spot-the-bug","🧠 Spot the Bug",[19,2070,2071],{},"A \"select all\" checkbox is supposed to toggle every row, but clicking it does nothing and the console shows no errors.",[45,2073,2074],{"language":47},[49,2075,2077],{"className":51,"code":2076,"language":47,"meta":53,"style":53},"function SelectAllCheckbox({ onSelectAll }) {\n  return \u003Cinput type=\"checkbox\" onClick={onSelectAll(true)} \u002F>\n}\n",[26,2078,2079,2093,2124],{"__ignoreMap":53},[57,2080,2081,2083,2086,2088,2091],{"class":59,"line":60},[57,2082,64],{"class":63},[57,2084,2085],{"class":67}," SelectAllCheckbox",[57,2087,308],{"class":71},[57,2089,2090],{"class":87},"onSelectAll",[57,2092,314],{"class":71},[57,2094,2095,2097,2099,2101,2103,2105,2108,2110,2112,2114,2116,2118,2121],{"class":59,"line":75},[57,2096,177],{"class":63},[57,2098,1240],{"class":71},[57,2100,208],{"class":189},[57,2102,219],{"class":67},[57,2104,196],{"class":63},[57,2106,2107],{"class":137},"\"checkbox\"",[57,2109,329],{"class":67},[57,2111,196],{"class":63},[57,2113,537],{"class":71},[57,2115,2090],{"class":67},[57,2117,84],{"class":71},[57,2119,2120],{"class":116},"true",[57,2122,2123],{"class":71},")} \u002F>\n",[57,2125,2126],{"class":59,"line":94},[57,2127,272],{"class":71},[2129,2130,2131,2135,2157],"details",{},[2132,2133,2134],"summary",{},"Answer",[19,2136,2137,2140,2141,2144,2145,2147,2148,2150,2151,2153,2154,2156],{},[26,2138,2139],{},"onSelectAll(true)"," is ",[499,2142,2143],{},"called immediately"," during render, because it's an invocation, not a reference. Whatever ",[26,2146,2139],{}," returns (likely ",[26,2149,2019],{},", if it's a void function that just runs some side effect once at render time) is what actually gets assigned to ",[26,2152,454],{},". The checkbox's real click handler ends up being ",[26,2155,2019],{},", so clicking it does nothing — while the \"select all\" logic already ran once, immediately, during the initial render, without user interaction.",[19,2158,2159,2162,2163,2166,2167,2170,2171,2174],{},[23,2160,2161],{},"The lesson",": JSX event props need a function ",[499,2164,2165],{},"reference",", not a function ",[499,2168,2169],{},"call"," — wrap any handler that needs arguments in an arrow function (",[26,2172,2173],{},"onClick={() => onSelectAll(true)}",") so it only executes when the event actually fires.",[14,2176,2178],{"id":2177},"key-takeaways","Key Takeaways",[720,2180,2181,2196,2202,2205,2214,2222],{},[748,2182,2183,2184,2186,2187,33,2189,33,2191,33,2193,2195],{},"React wraps native events in ",[26,2185,28],{},"; the API mirrors native events (",[26,2188,100],{},[26,2190,1408],{},[26,2192,39],{},[26,2194,42],{},").",[748,2197,2198,2199,2201],{},"Since React 17, event listeners are delegated to the root container element (not ",[26,2200,429],{},"), which matters mainly when multiple React versions coexist on one page.",[748,2203,2204],{},"Event handler props need a function reference — wrap calls that need arguments in an arrow function; never call the handler directly in JSX.",[748,2206,2207,2208,2210,2211,2213],{},"Missing ",[26,2209,1154],{}," on a form's ",[26,2212,916],{}," triggers a full page reload, which is the most common cause of \"my React state randomly reset.\"",[748,2215,2216,2218,2219,2221],{},[26,2217,457],{}," in React fires per keystroke on text inputs (not on blur, unlike plain HTML ",[26,2220,2031],{},") — this underpins the controlled-input model in chapter 14.",[748,2223,2224,2226,2227,2230],{},[26,2225,36],{}," blocks bubbling for ",[499,2228,2229],{},"all"," ancestor listeners, not just the one you're trying to avoid — use it deliberately, not reflexively.",[2232,2233,2234],"style",{},"html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sCrzJ, html code.shiki .sCrzJ{--shiki-default:#E36209;--shiki-github-dark:#FFAB70}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .sk71V, html code.shiki .sk71V{--shiki-default:#22863A;--shiki-github-dark:#85E89D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-