ached a single listener for each event type to ",[26,428,429],{},"document",", and dispatched synthetic events from there — a technique called event delegation, done for performance (one listener instead of thousands) and consistency. ",[23,432,433,434,436],{},"React 17 changed the attachment point from ",[26,435,429],{}," to the root DOM container"," (the element passed to ",[26,439,440],{},"createRoot","\u002F",[26,443,444],{},"ReactDOM.render","), which matters specifically for apps embedding multiple React versions or non-React widgets on the same page — with the old model, a React 16 app's global listener on ",[26,447,429],{}," could intercept events meant for an unrelated React 17 tree (or vice versa) before it reached its target; rooting each tree's listeners at its own container isolates them properly.",[19,450,451,452,33,455,458],{},"For everyday component code this change is invisible — you still just write ",[26,453,454],{},"onClick",[26,456,457],{},"onChange",", etc. — but it's a well-known \"why did this event stop working when I mixed two React versions\" root cause worth knowing.",[45,460,461],{"language":47},[49,462,464],{"className":51,"code":463,"language":47,"meta":53,"style":53},"\u002F\u002F You never manually attach these listeners — React delegates internally.\n\u002F\u002F Conceptually (React 17+):\n\u002F\u002F rootContainerElement.addEventListener('click', dispatchToSyntheticSystem)\n\u002F\u002F rootContainerElement.addEventListener('change', dispatchToSyntheticSystem)\n\u002F\u002F ...and so on for every supported event type, attached ONCE at the root.\n",[26,465,466,471,476,481,486],{"__ignoreMap":53},[57,467,468],{"class":59,"line":60},[57,469,470],{"class":106},"\u002F\u002F You never manually attach these listeners — React delegates internally.\n",[57,472,473],{"class":59,"line":75},[57,474,475],{"class":106},"\u002F\u002F Conceptually (React 17+):\n",[57,477,478],{"class":59,"line":94},[57,479,480],{"class":106},"\u002F\u002F rootContainerElement.addEventListener('click', dispatchToSyntheticSystem)\n",[57,482,483],{"class":59,"line":110},[57,484,485],{"class":106},"\u002F\u002F rootContainerElement.addEventListener('change', dispatchToSyntheticSystem)\n",[57,487,488],{"class":59,"line":144},[57,489,490],{"class":106},"\u002F\u002F ...and so on for every supported event type, attached ONCE at the root.\n",[14,492,494],{"id":493},"passing-arguments-to-handlers","Passing Arguments to Handlers",[19,496,497,498,502,503,506],{},"The handler prop expects a ",[499,500,501],"em",{},"function reference",", not a function call. Calling the function directly in JSX (",[26,504,505],{},"onClick={doSomething()}",") invokes it immediately during render, not on click.",[45,508,509],{"language":47},[49,510,512],{"className":51,"code":511,"language":47,"meta":53,"style":53},"\u002F\u002F BUG: doSomething() is CALLED during render, not on click.\n\u002F\u002F Whatever it returns (probably undefined) becomes the onClick handler.\n\u003Cbutton onClick={doSomething()}>Click\u003C\u002Fbutton>\n",[26,513,514,519,524],{"__ignoreMap":53},[57,515,516],{"class":59,"line":60},[57,517,518],{"class":106},"\u002F\u002F BUG: doSomething() is CALLED during render, not on click.\n",[57,520,521],{"class":59,"line":75},[57,522,523],{"class":106},"\u002F\u002F Whatever it returns (probably undefined) becomes the onClick handler.\n",[57,525,526,529,531,533,535,538,541,544,546],{"class":59,"line":94},[57,527,528],{"class":71},"\u003C",[57,530,235],{"class":189},[57,532,329],{"class":67},[57,534,196],{"class":63},[57,536,537],{"class":71},"{",[57,539,540],{"class":67},"doSomething",[57,542,543],{"class":71},"()}>Click\u003C\u002F",[57,545,235],{"class":189},[57,547,250],{"class":71},[45,549,550],{"language":47},[49,551,553],{"className":51,"code":552,"language":47,"meta":53,"style":53},"\u002F\u002F Correct: pass a reference (no parens) when the function takes no arguments\n\u003Cbutton onClick={doSomething}>Click\u003C\u002Fbutton>\n\n\u002F\u002F Correct: wrap in an arrow function when you need to pass arguments\n\u003Cbutton onClick={() => deleteItem(item.id)}>Delete\u003C\u002Fbutton>\n\n\u002F\u002F Also correct: a handler factory returning a bound function\nfunction makeDeleteHandler(id) {\n  return () => deleteItem(id)\n}\n\u003Cbutton onClick={makeDeleteHandler(item.id)}>Delete\u003C\u002Fbutton>\n",[26,554,555,560,577,581,586,611,615,620,634,648,652],{"__ignoreMap":53},[57,556,557],{"class":59,"line":60},[57,558,559],{"class":106},"\u002F\u002F Correct: pass a reference (no parens) when the function takes no arguments\n",[57,561,562,564,566,568,570,573,575],{"class":59,"line":75},[57,563,528],{"class":71},[57,565,235],{"class":189},[57,567,329],{"class":67},[57,569,196],{"class":63},[57,571,572],{"class":71},"{doSomething}>Click\u003C\u002F",[57,574,235],{"class":189},[57,576,250],{"class":71},[57,578,579],{"class":59,"line":94},[57,580,171],{"emptyLinePlaceholder":170},[57,582,583],{"class":59,"line":110},[57,584,585],{"class":106},"\u002F\u002F Correct: wrap in an arrow function when you need to pass arguments\n",[57,587,588,590,592,594,596,599,601,604,607,609],{"class":59,"line":144},[57,589,528],{"class":71},[57,591,235],{"class":189},[57,593,329],{"class":67},[57,595,196],{"class":63},[57,597,598],{"class":71},"{() ",[57,600,343],{"class":63},[57,602,603],{"class":67}," deleteItem",[57,605,606],{"class":71},"(item.id)}>Delete\u003C\u002F",[57,608,235],{"class":189},[57,610,250],{"class":71},[57,612,613],{"class":59,"line":161},[57,614,171],{"emptyLinePlaceholder":170},[57,616,617],{"class":59,"line":167},[57,618,619],{"class":106},"\u002F\u002F Also correct: a handler factory returning a bound function\n",[57,621,622,624,627,629,632],{"class":59,"line":174},[57,623,64],{"class":63},[57,625,626],{"class":67}," makeDeleteHandler",[57,628,84],{"class":71},[57,630,631],{"class":87},"id",[57,633,91],{"class":71},[57,635,636,638,641,643,645],{"class":59,"line":183},[57,637,177],{"class":