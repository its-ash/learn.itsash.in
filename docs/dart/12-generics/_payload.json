,1835,1837],{"id":1836},"spot-the-bug","🧠 Spot the Bug",[14,1839,1840],{},"A developer creates a generic cache, but retrieving an item with the wrong type fails at runtime with a confusing error:",[23,1842,1843],{"language":25},[27,1844,1846],{"className":29,"code":1845,"language":25,"meta":31,"style":31},"class Cache {\n    final _cache = \u003CString, Object>{};\n\n    void put(String key, Object value) => _cache[key] = value;\n\n    T get\u003CT>(String key) => _cache[key] as T;\n}\n\nvoid main() {\n    final cache = Cache();\n    cache.put('count', 42);\n    final name = cache.get\u003CString>('count');   \u002F\u002F crashes\n    print(name);\n}\n",[33,1847,1848,1856,1876,1880,1906,1910,1937,1941,1945,1955,1967,1987,2013,2020],{"__ignoreMap":31},[36,1849,1850,1852,1854],{"class":38,"line":39},[36,1851,212],{"class":49},[36,1853,537],{"class":63},[36,1855,540],{"class":53},[36,1857,1858,1860,1862,1864,1866,1868,1870,1872,1874],{"class":38,"line":46},[36,1859,228],{"class":49},[36,1861,547],{"class":53},[36,1863,57],{"class":49},[36,1865,236],{"class":49},[36,1867,336],{"class":63},[36,1869,67],{"class":53},[36,1871,558],{"class":63},[36,1873,241],{"class":49},[36,1875,563],{"class":53},[36,1877,1878],{"class":38,"line":81},[36,1879,129],{"emptyLinePlaceholder":128},[36,1881,1882,1884,1887,1889,1891,1893,1895,1898,1900,1902,1904],{"class":38,"line":104},[36,1883,253],{"class":49},[36,1885,1886],{"class":87}," put",[36,1888,91],{"class":53},[36,1890,336],{"class":63},[36,1892,584],{"class":53},[36,1894,558],{"class":63},[36,1896,1897],{"class":53}," value) ",[36,1899,266],{"class":49},[36,1901,614],{"class":53},[36,1903,57],{"class":49},[36,1905,653],{"class":53},[36,1907,1908],{"class":38,"line":125},[36,1909,129],{"emptyLinePlaceholder":128},[36,1911,1912,1914,1916,1918,1920,1922,1924,1927,1929,1931,1933,1935],{"class":38,"line":132},[36,1913,279],{"class":63},[36,1915,303],{"class":87},[36,1917,144],{"class":53},[36,1919,220],{"class":63},[36,1921,432],{"class"