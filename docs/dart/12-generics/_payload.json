49},[36,2248,537],{"class":63},[36,2250,295],{"class":53},[36,2252,2253,2255,2257,2259,2261,2263,2265],{"class":38,"line":693},[36,2254,1971],{"class":53},[36,2256,1974],{"class":87},[36,2258,91],{"class":53},[36,2260,1979],{"class":94},[36,2262,67],{"class":53},[36,2264,1984],{"class":63},[36,2266,356],{"class":53},[36,2268,2270,2272,2275,2277,2279,2281,2283,2285,2287,2289,2292],{"class":38,"line":2269},16,[36,2271,228],{"class":49},[36,2273,2274],{"class":53}," count ",[36,2276,57],{"class":49},[36,2278,703],{"class":53},[36,2280,706],{"class":87},[36,2282,144],{"class":53},[36,2284,147],{"class":63},[36,2286,432],{"class":53},[36,2288,1979],{"class":94},[36,2290,2291],{"class":53},");    ",[36,2293,2294],{"class":42},"\u002F\u002F 42\n",[36,2296,2298,2300,2302,2304,2306,2308,2310,2312,2314,2316,2318],{"class":38,"line":2297},17,[36,2299,228],{"class":49},[36,2301,1993],{"class":53},[36,2303,57],{"class":49},[36,2305,703],{"class":53},[36,2307,706],{"class":87},[36,2309,144],{"class":53},[36,2311,336],{"class":63},[36,2313,432],{"class":53},[36,2315,1979],{"class":94},[36,2317,98],{"class":53},[36,2319,2320],{"class":42},"\u002F\u002F null (type mismatch, no crash)\n",[36,2322,2324,2326,2329],{"class":38,"line":2323},18,[36,2325,1436],{"class":87},[36,2327,2328],{"class":53},"(name);   ",[36,2330,2331],{"class":42},"\u002F\u002F null\n",[36,2333,2335],{"class":38,"line":2334},19,[36,2336,316],{"class":53},[14,2338,2339,2340,2343,2344,2346,2347,2349,2350,2352,2353,407],{},"::\nUsing ",[33,2341,2342],{},"if (value is T)"," (a runtime check, thanks to reified generics) returns the value only if it's actually a ",[33,2345,220],{},", else ",[33,2348,1616],{},". No ",[33,2351,1672],{}," — the caller handles the ",[33,2354,1616],{},[14,2356,2357,1656,2360,2362,2363,2365,2366,2369,2370,2372,2373,2375],{},[1184,2358,2359],{},"The lesson",[33,2361,2079],{}," in a generic cache blindly trusts the caller's type parameter and throws ",[33,2364,1672],{}," on mismatch. Use ",[33,2367,2368],{},"is T"," (reified check) to validate, returning ",[33,2371,1616],{}," (or a clear error) on mismatch. Don't let type errors surface as confusing ",[33,2374,1672],{},"s deep in the cache.",[18,2377,2378],{"id":2031},"Summary",[14,2380,2381,2382,2384,2385,2388,2389,2392,2393,67,2395,67,2397,2399,2400,2402,2403,2405,2406,1620,2408,2410,2411,2413,2414,2416],{},"You can write generic classes (",[33,2383,398],{},"), functions (",[33,2386,2387],{},"firstOf\u003CT>","), methods (",[33,2390,2391],{},"Cache.get\u003CT>","), bounded type parameters (",[33,2394,900],{},[33,2396,1021],{},[33,2398,1145],{},"), generic typedefs, and use Dart's reified generics (",[33,2401,1262],{}," at runtime, ",[33,2404,1734],{}," preserved) and covariance (",[33,2407,1279],{},[33,2409,1283],{},") — with the ",[33,2412,2079],{},"-throws-on-mismatch trap avoided via ",[33,2415,2368],{},". Next: packages and libraries.",[2418,2419,2420],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki