671,1672,1673,1691,1706,1718,1731],"ul",{},[1674,1675,1676,1679,1680,1682,1683,1686,1687,1690],"li",{},[1077,1677,1678],{},"Idiom",": use named parameters (",[18,1681,398],{},") for functions with many optional params or boolean flags — ",[18,1684,1685],{},"createUser(name: 'Alice', admin: true)"," is clearer than ",[18,1688,1689],{},"createUser('Alice', null, true)",". Named params self-document at the call site.",[1674,1692,1693,1695,1696,1698,1699,1702,1703,1705],{},[1077,1694,1678],{},": use ",[18,1697,499],{}," for mandatory named params — ",[18,1700,1701],{},"{required String name}"," ensures the caller provides it, with a clear error if missing. Use named params for clarity, ",[18,1704,499],{}," for mandatory ones.",[1674,1707,1708,1710,1711,1713,1714,1717],{},[1077,1709,1678],{},": use arrow functions (",[18,1712,123],{},") for single-expression functions — ",[18,1715,1716],{},"int square(int x) => x * x;"," is concise and readable. Use for simple transformations, getters, and callbacks.",[1674,1719,1720,1695,1722,1724,1725,1686,1728,1730],{},[1077,1721,1678],{},[18,1723,861],{}," for function types — ",[18,1726,1727],{},"typedef IntOp = int Function(int, int);",[18,1729,934],{}," everywhere. Use for callbacks and higher-order function signatures.",[1674,1732,1733,1735,1736,1739],{},[1077,1734,1678],{},": use closures to capture and configure behavior — ",[18,1737,1738],{},"makeAdder(5)"," returns a function that adds 5. Useful for partial application, callbacks, and stateful handlers.",[27,1741,1743],{"id":1742},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1671,1745,1746,1763,1778,1798,1816,1826,1851,1865,1878,1904],{},[1674,1747,1748,1754,1755,1758,1759,1762],{},[1077,1749,1750,1751,1753],{},"Optional positional params (",[18,1752,271],{},") must come after required",": ",[18,1756,1757],{},"void f(int a, [int b])"," is valid; ",[18,1760,1761],{},"void f([int b], int a)"," is not.",[1674,1764,1765,1754,1771,1758,1774,1777],{},[1077,1766,1767,1768,1770],{},"Named params (",[18,1769,398],{},") must come after positional",[18,1772,1773],{},"void f(int a, {int b})",[18,1775,1776],{},"void f({int b}, int a)"," is not (actually, named after positional is the rule — named always last).",[1674,1779,1780,1754,1783,1786,1787,1790,1791,1793,1794,1797],{},[1077,1781,1782],{},"Default values must be compile-time constants",[18,1784,1785],{},"void f({int x = someVar})"," fails if ",[18,1788,1789],{},"someVar"," isn't const. Use ",[18,1792,319],{}," default + ",[18,1795,1796],{},"??"," inside for runtime defaults.",[1674,1799,1800,1754,1805,1808,1809,1812,1813,1815],{},[1077,1801,1802,1804],{},[18,1803,796],{}," type is untyped",[18,1806,1807],{},"Function fn"," accepts any function. Use ",[18,1810,1811],{},"int Function(int)"," for type safety. ",[18,1814,796],{}," defeats type checking.",[1674,1817,1818,1821,1822,1825],{},[1077,1819,1820],{},"Closures capture by reference",": the captured variable is shared, not copied. ",[18,1823,1824],{},"var i = 0; functions.add(() => i); i = 5;"," — calling the function returns 5 (current value), not 0.",[1674,1827,1828,1754,1835,1838,1839,1842,1843,1845,1846,1848,1849,25],{},[1077,1829,1830,1832,1833],{},[18,1831,20],{}," functions return ",[18,1834,1245],{},[18,1836,1837],{},"int f() async { return 5; }"," returns ",[18,1840,1841],{},"Future\u003Cint>",", not ",[18,1844,51],{},". The ",[18,1847,20],{}," keyword wraps the return in a ",[18,1850,1245],{},[1674,1852,1853,1754,1862,1864],{},[1077,1854,1855,1857,1858,21,1860],{},[18,1856,1430],{}," only in ",[18,1859,1370],{},[18,1861,1374],{},[18,1863,1430],{}," outside a generator function is a compile error.",[1674,1866,1867,1870,1871,1874,1875,1877],{},[1077,1868,1869],{},"Lexical scope, not dynamic",": a function defined in ",[18,1872,1873],{},"outer"," accesses ",[18,1876,1873],{},"'s variables, even if called from elsewhere. Scope is by code structure, not call stack.",[1674,1879,1880,1754,1885,1888,1889,1838,1892,255,1894,1897,1898,1900,1901,1903],{},[1077,1881,1882,1884],{},[18,1883,149],{}," can't be used as a value",[18,1886,1887],{},"var x = voidFn();"," — if ",[18,1890,1891],{},"voidFn",[18,1893,149],{},[18,1895,1896],{},"x"," is ",[18,1899,149],{},", can't be used. Use ",[18,1902,796],{}," or ignore the return.",[1674,1905,1906,1754,1911,1914,1915,1918,1919,1922],{},[1077,1907,1908,1910],{},[18,1909,1557],{}," makes a class callable",[18,1912,1913],{},"obj(args)"," calls ",[18,1916,1917],{},"obj.call(args)",". Subtle — a \"function call\" on an object invokes ",[18,1920,1921],{},"call",". Use for callable objects (multipliers, validators).",[27,1924,1926],{"id":1925},"spot-the-bug","🧠 Spot the Bug",[14,1928,1929],{},"A developer creates a list of callbacks in a loop, but all callbacks return the same value:",[32,1931,1932],{"language":34},[36,1933,1935],{"className":38,"code":1934,"language":34,"meta":40,"style":40},"var callbacks = [];\nfor (var i = 0; i \u003C 3; i++) {\n    callbacks.add(() => i);\n}\nprint(callbacks.map((f) => f()).toList());   \u002F\u002F [3, 3, 3]? or [0, 1, 2]?\n",[18,1936,1937,1949,1981,1995,1999],{"__ignoreMap":40},[44,1938,1939,1941,1944,1946],{"class":46,"line":47},[44,1940,672],{"class":75},[44,1942,1943],{"class":58}," callbacks ",[44,1945,594],{"class":75},[44,1947,1948],{"class":58}," [];\n",[44,1950,1951,1954,1956,1958,1961,1963,1966,1969,1971,1974,1977,1979],{"class":46,"line":72},[44,1952,1953],{"class":75},"for",[44,1955,743],{"class":58},[44,1957,672],{"class":75},[44,1959,1960],{"class":58}," i ",[44,1962,594],{"class":75},[44,1964,1965],{"class":50}," 0",[44,1967,1968],{"class":58},"; i ",[44,1970,1248],{"class":75},[44,1972,1973],{"class":50}," 3",[44,1975,1976],{"class":58},"; i",[44,1978,1436],{"class":75},[44,1980,1489],{"class":58},[44,1982,1983,1986,1988,1990,1992],{"class":46,"line":88},[44,1984,1985],{"class":58},"    callbacks.",[44,1987,247],{"class":54},[44,1989,826],{"class":58},[44,1991,123],{"class":75},[44,1993,1994],{"class":58}," i);\n",[44,1996,1997],{"class":46,"line":94},[44,1998,91],{"class":58},[44,2000,2001,2004,2007,2010,2013,2015,2018,2021,2024,2027],{"class":46,"line":101},[44,2002,2003],{"class":54},"print",[44,2005,2006],{"class":58},"(callbacks.",[44,2008,2009],{"class":54},"map",[44,2011,2012],{"class":58},"((f) ",[44,2014,123],{"class":75},[44,2016,2017],{"class":54}," f",[44,2019,2020],{"class":58},"()).",[44,2022,2023],{"class":54},"toList",[44,2025,2026],{"class":58},"());   ",[44,2028,2029],{"class":104},"\u002F\u002F [3, 3, 3]? or [0, 1, 2]?\n",[14,2031,2032],{},"What's the output and why?",[2034,2035,2036,2040,2065,2091,2103,2109,2195,2202,2258,2268],"details",{},[2037,2038,2039],"summary",{},"Answer",[14,2041,2042,2043,2046,2047,2049,2050,2054,2055,2058,2059,2061,2062,2064],{},"In Dart, the output is ",[18,2044,2045],{},"[0, 1, 2]"," — because in a ",[18,2048,1953],{}," loop, each iteration creates a ",[2051,2052,2053],"em",{},"new"," ",[18,2056,2057],{},"i"," (Dart's ",[18,2060,1953],{}," loop variable is fresh per iteration, unlike JavaScript's ",[18,2063,672],{},").",[14,2066,2067,2068,2071,2072,2074,2075,2077,2078,2080,2081,2084,2085,2087,2088,25],{},"Wait, let me verify. In Dart, ",[18,2069,2070],{},"for (var i = 0; ...)"," — is ",[18,2073,2057],{}," fresh per iteration? Actually, in Dart, the loop variable ",[18,2076,2057],{}," is a single variable that's reassigned each iteration (like JS ",[18,2079,672],{},"), not fresh (like JS ",[18,2082,2083],{},"let"," or Rust). So the closures all capture the same ",[18,2086,2057],{},", which ends at 3. The output would be ",[18,2089,2090],{},"[3, 3, 3]",[14,2092,2093,2094,2097,2098,2100,2101,25],{},"Hmm, let me reconsider. Testing: in Dart, ",[18,2095,2096],{},"for (var i = 0; i \u003C 3; i++) { callbacks.add(() => i); }"," — all closures capture the same ",[18,2099,2057],{},", which is 3 after the loop. So ",[18,2102,2090],{},[14,2104,2105,2106,2108],{},"The fix — capture ",[18,2107,2057],{}," in a local variable per iteration:",[36,2110,2112],{"className":38,"code":2111,"language":34,"meta":40,"style":40},"for (var i = 0; i \u003C 3; i++) {\n    final captured = i;   \u002F\u002F fresh per iteration\n    callbacks.add(() => captured);\n}\nprint(callbacks.map((f) => f()).toList());   \u002F\u002F [0, 1, 2]\n",[18,2113,2114,2140,2155,2168,2172],{"__ignoreMap":40},[44,2115,2116,2118,2120,2122,2124,2126,2128,2130,2132,2134,2136,2138],{"class":46,"line":47},[44,2117,1953],{"class":75},[44,2119,743],{"class":58},[44,2121,672],{"class":75},[44,2123,1960],{"class":58},[44,2125,594],{"class":75},[44,2127,1965],{"class":50},[44,2129,1968],{"class":58},[44,2131,1248],{"class":75},[44,2133,1973],{"class":50},[44,2135,1976],{"class":58},[44,2137,1436],{"class":75},[44,2139,1489],{"class":58},[44,2141,2142,2144,2147,2149,2152],{"class":46,"line":72},[44,2143,1586],{"class":75},[44,2145,2146],{"class":58}," captured ",[44,2148,594],{"class":75},[44,2150,2151],{"class":58}," i;   ",[44,2153,2154],{"class":104},"\u002F\u002F fresh per iteration\n",[44,2156,2157,2159,2161,2163,2165],{"class":46,"line":88},[44,2158,1985],{"class":58},[44,2160,247],{"class":54},[44,2162,826],{"class":58},[44,2164,123],{"class":75},[44,2166,2167],{"class":58}," captured);\n",[44,2169,2170],{"class":46,"line":94},[44,2171,91],{"class":58},[44,2173,2174,2176,2178,2180,2182,2184,2186,2188,2190,2192],{"class":46,"line":101},[44,2175,2003],{"class":54},[44,2177,2006],{"class":58},[44,2179,2009],{"class":54},[44,2181,2012],{"class":58},[44,2183,123],{"class":75},[44,2185,2017],{"class":54},[44,2187,2020],{"class":58},[44,2189,2023],{"class":54},[44,2191,2026],{"class":58},[44,2193,2194],{"class":104},"\u002F\u002F [0, 1, 2]\n",[14,2196,2197,2198,2201],{},"::\nOr use ",[18,2199,2200],{},"for-in"," with a collection (each item is fresh):",[36,2203,2205],{"className":38,"code":2204,"language":34,"meta":40,"style":40},"for (var i in [0, 1, 2]) {\n    callbacks.add(() => i);   \u002F\u002F i is the list item, fresh per iteration? Actually same issue\n}\n",[18,2206,2207,2238,2254],{"__ignoreMap":40},[44,2208,2209,2211,2213,2215,2217,2220,2223,2226,2228,2231,2233,2235],{"class":46,"line":47},[44,2210,1953],{"class":75},[44,2212,743],{"class":58},[44,2214,672],{"class":75},[44,2216,1960],{"class":58},[44,2218,2219],{"class":75},"in",[44,2221,2222],{"class":58}," [",[44,2224,2225],{"class":50},"0",[44,2227,255],{"class":58},[44,2229,2230],{"class":50},"1",[44,2232,255],{"class":58},[44,2234,252],{"class":50},[44,2236,2237],{"class":58},"]) {\n",[44,2239,2240,2242,2244,2246,2248,2251],{"class":46,"line":72},[44,2241,1985],{"class":58},[44,2243,247],{"class":54},[44,2245,826],{"class":58},[44,2247,123],{"class":75},[44,2249,2250],{"class":58}," i);   ",[44,2252,2253],{"class":104},"\u002F\u002F i is the list item, fresh per iteration? Actually same issue\n",[44,2255,2256],{"class":46,"line":88},[44,2257,91],{"class":58},[14,2259,2260,2261,2263,2264,2267],{},"::\nActually, ",[18,2262,2200],{}," in Dart also reuses the loop variable. The safe pattern is the ",[18,2265,2266],{},"final captured = i;"," inside the loop body.",[14,2269,2270,2273,2274,2276,2277,2280],{},[1077,2271,2272],{},"The lesson",": Dart's ",[18,2275,1953],{}," loop variable is a single variable reassigned each iteration. Closures capture it by reference, so all closures see the final value. To capture per-iteration, assign to a fresh ",[18,2278,2279],{},"final"," local inside the loop body.",[27,2282,2283],{"id":2037},"Summary",[14,2285,2286,2287,2289,2290,2292,2293,255,2295,2297,2298,2300,2301,21,2303,2305,2306,21,2308,2310,2311,2313,2314,2316,2317,2319],{},"You can declare functions (arrow, ",[18,2288,149],{},"), use parameters (required, optional positional ",[18,2291,271],{},", named ",[18,2294,398],{},[18,2296,499],{},", defaults), use first-class functions and ",[18,2299,861],{},"s, closures (capture by reference), lexical scope, ",[18,2302,20],{},[18,2304,24],{}," (brief), generators (",[18,2307,1370],{},[18,2309,1374],{}," with ",[18,2312,1430],{},"), and ",[18,2315,1557],{}," — with the loop-variable-capture and ",[18,2318,796],{},"-untyped traps avoided. Next: collections.",[2321,2322,2323],"style",{},"html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}",{"title":40,"searchDepth":72,"depth":72,"links":2325},[2326,2327,2337,2339,2342,2343,2344,2346,2348,2350,2351,2352,2353],{"id":29,"depth":72,"text":30},{"id":204,"depth":72,"text":205,"children":2328},[2329,2330,23