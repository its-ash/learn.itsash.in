,246],{"class":176},[36,1346,1347],{"class":42},"     # allow print in CLI tools\n",[36,1349,1350,1352],{"class":38,"line":139},[36,1351,1248],{"class":129},[36,1353,1354],{"class":163},"prefer_const_constructors\n",[36,1356,1357,1359],{"class":38,"line":145},[36,1358,1248],{"class":129},[36,1360,1361],{"class":163},"prefer_final_locals\n",[36,1363,1364,1366],{"class":38,"line":154},[36,1365,1248],{"class":129},[36,1367,1368],{"class":163},"prefer_final_in_for_each\n",[36,1370,1371,1373],{"class":38,"line":170},[36,1372,1248],{"class":129},[36,1374,1375],{"class":163},"require_trailing_commas\n",[36,1377,1378,1380,1383],{"class":38,"line":183},[36,1379,1248],{"class":129},[36,1381,1382],{"class":163},"unawaited_futures",[36,1384,1385],{"class":42},"       # flags `future();` without await\u002Funawaited()\n",[36,1387,1388,1390,1393],{"class":38,"line":189},[36,1389,1248],{"class":129},[36,1391,1392],{"class":163},"cancel_subscriptions",[36,1394,1395],{"class":42},"    # flags StreamSubscription not cancelled\n",[14,1397,1399],{"id":1398},"tips-tricks","💡 Tips & Tricks",[1401,1402,1403,1414,1427,1436,1448],"ul",{},[1404,1405,1406,243,1410,1413],"li",{},[1407,1408,1409],"strong",{},"Performance",[33,1411,1412],{},"dart compile exe"," produces a tree-shaken AOT binary — no compiler at runtime, ~50ms cold start. Use for Docker, CLI tools, and serverless. The binary includes the Dart runtime but not the compiler.",[1404,1415,1416,243,1419,1422,1423,1426],{},[1407,1417,1418],{},"Debug",[33,1420,1421],{},"dart run --observe bin\u002Fserver.dart"," starts the VM service (debugger protocol, CPU profiling). Connect VS Code or DevTools. ",[33,1424,1425],{},"--observe=8181"," pins the port.",[1404,1428,1429,243,1432,1435],{},[1407,1430,1431],{},"Idiom",[33,1433,1434],{},"const String.fromEnvironment('dart.vm.product')"," is a compile-time constant — the compiler resolves it and dead-code-eliminates the unused branch. Use it (not runtime checks) for platform\u002Fmode conditionals.",[1404,1437,1438,243,1440,1443,1444,1447],{},[1407,1439,1431],{},[33,1441,1442],{},"publish_to: none"," in pubspec.yaml for private apps — prevents accidental ",[33,1445,1446],{},"dart pub publish"," to pub.dev. Remove only when publishing a library.",[1404,1449,1450,243,1453,1456],{},[1407,1451,1452],{},"Tooling",[33,1454,1455],{},"dart pub deps --style=compact"," shows the dependency tree without long paths. Useful for auditing transitive dependencies.",[14,1458,1460],{"id":1459},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[1401,1462,1463,1475,1493,1508,1525,1546,1557,1576],{},[1404,1464,1465,1471,1472,226],{},[1407,1466,1467,1470],{},[33,1468,1469],{},"assert"," is stripped in AOT",": the entire assertion expression (including side effects) vanishes in release builds. Never put business logic or side effects inside ",[33,1473,1474],{},"assert(() { ... }())",[1404,1476,1477,1482,1483,1485,1486,1488,1489,1492],{},[1407,1478,1479,1481],{},[33,1480,468],{}," on web is a JS double",": on native, ",[33,1484,468],{}," is 64-bit. On web (dart2js\u002FDDC), ",[33,1487,468],{}," is a JS number (IEEE 754 double) — values above 2^53 lose precision. Use ",[33,1490,1491],{},"BigInt"," for arbitrary-precision integers on web.",[1404,1494,1495,1501,1502,1504,1505,683],{},[1407,1496,1497,1500],{},[33,1498,1499],{},"dart:io"," is native-only",": importing ",[33,1503,1499],{}," in a web project fails at compile time. Use conditional imports (",[33,1506,1507],{},"if (dart.library.html)",[1404,1509,1510,1517,1518,237,1521,1524],{},[1407,1511,1512,1513,1516],{},"No ",[33,1514,1515],{},"dart:mirrors"," on web \u002F AOT",": runtime reflection is unsupported in dart2js and AOT. Use code generation (",[33,1519,1520],{},"json_serializable",[33,1522,1523],{},"freezed",") instead.",[1404,1526,1527,243,1536,1538,1539,1542,1543,1545],{},[1407,1528,1529,1532,1533],{},[33,1530,1531],{},"dart run"," vs ",[33,1534,1535],{},"dart file.dart",[33,1537,1531],{}," resolves the package and runs ",[33,1540,1541],{},"bin\u002F\u003Cpackage_name>.dart",". ",[33,1544,1535],{}," compiles the file standalone (no package resolution for relative imports).",[1404,1547,1548,1553,1554,1556],{},[1407,1549,1550,1552],{},[33,1551,947],{}," for libraries",": if you commit ",[33,1555,947],{}," for a library, it can conflict with the consumer's resolution. Omit it for published libraries; commit it for apps.",[1404,1558,1559,1565,1566,1569,1570,1572,1573,683],{},[1407,1560,1561,1562],{},"Hot reload doesn't re-run ",[33,1563,1564],{},"initState",": in Flutter, hot reload preserves state (including ",[33,1567,1568],{},"State"," objects). Changes to ",[33,1571,1564],{}," logic require a hot restart (",[33,1574,1575],{},"R",[1404,1577,1578,243,1581,1584,1585,1588],{},[1407,1579,1580],{},"SDK constraint floor",[33,1582,1583],{},"sdk: '>=3.4.0 \u003C4.0.0'"," — using a Dart 3.4 feature (e.g., pattern guards) in a project with ",[33,1586,1587],{},"sdk: '>=3.0.0'"," fails at analysis. Bump the floor to match feature usage.",[14,1590,1592],{"id":1591},"spot-the-bug","🧠 Spot the Bug",[19,1594,1595],{},"A developer ships a server with an assert guarding a critical side effect. In production, the side effect never runs:",[23,1597,1598],{"language":25},[27,1599,1601],{"className":29,"code":1600,"language":25,"meta":31,"style":31},"void processOrder(Order order) {\n  assert(_sendNotification(order), 'Notification failed');\n  _commitOrder(order);\n}\n",[33,1602,1603,1618,1635,1643],{"__ignoreMap":31},[36,1604,1605,1607,1610,1612,1615],{"class":38,"line":39},[36,1606,122],{"class":121},[36,1608,1609],{"class":125}," processOrder",[36,1611,160],{"class":129},[36,1613,1614],{"class":176},"Order",[36,1616,1617],{"class":129}," order) {\n",[36,1619,1620,1622,1624,1627,1630,1633],{"class":38,"line":46},[36,1621,148],{"class":121},[36,1623,160],{"class":129},[36,1625,1626],{"class":125},"_sendNotification",[36,1628,1629],{"class":129},"(order), ",[36,1631,1632],{"class":163},"'Notification failed'",[36,1634,167],{"class":129},[36,1636,1637,1640],{"class":38,"line":52},[36,1638,1639],{"class":125},"  _commitOrder",[36,1641,1642],{"class":129},"(order);\n",[36,1644,1645],{"class":38,"line":58},[36,1646,272],{"class":129},[19,1648,1649],{},"What happens in the AOT release build?",[1651,1652,1653,1657,1671,1676,1754],"details",{},[1654,1655,1656],"summary",{},"Answer",[19,1658,1659,1660,1662,1663,1666,1667,1670],{},"In AOT (release), ",[33,1661,1469],{}," is completely stripped — the expression ",[33,1664,1665],{},"_sendNotification(order)"," is never evaluated. The notification is silently skipped. Only ",[33,1668,1669],{},"_commitOrder"," runs.",[19,1672,1673,1674,661],{},"The fix — use an explicit check, not ",[33,1675,1469],{},[27,1677,1679],{"className":29,"code":1678,"language":25,"meta":31,"style":31},"void processOrder(Order order) {\n  if (!_sendNotification(order)) {\n    throw StateError('Notification failed for order ${order.id}');\n  }\n  _commitOrder(order);\n}\n",[33,1680,1681,1693,1709,1739,1744,1750],{"__ignoreMap":31},[36,1682,1683,1685,1687,1689,1691],{"class":38,"line":39},[36,1684,122],{"class":121},[36,1686,1609],{"class":125},[36,1688,160],{"class":129},[36,1690,1614],{"class":176},[36,1692,1617],{"class":129},[36,1694,1695,1698,1701,1704,1706],{"class":38,"line":46},[36,1696,1697],{"class":121},"  if",[36,1699,1700],{"class":129}," (",[36,1702,1703],{"class":121},"!",[36,1705,1626],{"class":125},[36,1707,1708],{"class":129},"(order)) {\n",[36,1710,1711,1714,1717,1719,1722,1724,1727,1729,1732,1734,1737],{"class":38,"line":52},[36,1712,1713],{"class":121},"    throw",[36,1715,1716],{"class":176}," StateError",[36,1718,160],{"class":129},[36,1720,1721],{"class":163},"'Notification failed for order ",[36,1723,217],{"class":163},[36,1725,1726],{"class":176},"order",[36,1728,226],{"class":163},[36,1730,1731],{"class":176},"id",[36,1733,261],{"class":163},[36,1735,1736],{"class":163},"'",[36,1738,167],{"class":129},[36,1740,1741],{"class":38,"line":58},[36,1742,1743],{"class":129},"  }\n",[36,1745,1746,1748],{"class":38,"line":64},[36,1747,1639],{"class":125},[36,1749,1642],{"class":129},[36,1751,1752],{"class":38,"line":70},[36,1753,272],{"class":129},[19,1755,1756,1758,1759,1762,1763,1766,1767,1769],{},[33,1757,1469],{}," is for development-time invariants (conditions that should never fail if the code is correct). Runtime validation (especially side effects) must use ",[33,1760,1761],{},"if","\u002F",[33,1764,1765],{},"throw",". The ",[33,1768,1469],{}," body is dead code in release.",[1771,1772,1773],"style",{},"html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html pre.shiki code .sk71V, html code.shiki .sk71V{--shiki-default:#22863A;--shiki-github-dark:#85E89D}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shik