[{"data":1,"prerenderedAt":1080},["ShallowReactive",2],{"page-\u002Fdart\u002F01-introduction-and-setup":3},{"id":4,"title":5,"body":6,"description":16,"extension":1074,"meta":1075,"navigation":734,"path":1076,"seo":1077,"stem":1078,"__hash__":1079},"content\u002Fdart\u002F01-introduction-and-setup.md","01 — Introduction & Setup",{"type":7,"value":8,"toc":1066},"minimark",[9,13,17,22,57,61,66,1062],[10,11,5],"h1",{"id":12},"_01-introduction-setup",[14,15,16],"p",{},"Dart is a client-optimized language for fast apps on any platform — web, mobile (Flutter), and server. It's the language behind Flutter.",[18,19,21],"h2",{"id":20},"why-dart","Why Dart?",[23,24,25,33,39,45,51],"ul",{},[26,27,28,32],"li",{},[29,30,31],"strong",{},"Client-optimized"," — designed for UI: fast allocation, garbage collection, event loop, isolates.",[26,34,35,38],{},[29,36,37],{},"AOT and JIT"," — compiled ahead-of-time for fast startup (mobile) or just-in-time for fast dev cycles (hot reload).",[26,40,41,44],{},[29,42,43],{},"Type-safe"," — sound null safety, strong typing, type inference.",[26,46,47,50],{},[29,48,49],{},"Familiar syntax"," — C-family syntax (like Java\u002FC#\u002FJavaScript\u002FTypeScript).",[26,52,53,56],{},[29,54,55],{},"Multi-platform"," — web (compiled to JS\u002FWASM), mobile (Flutter), desktop, server.",[18,58,60],{"id":59},"installing-the-dart-sdk","Installing the Dart SDK",[62,63,65],"h3",{"id":64},"macos-homebrew","macOS (Homebrew)",[67,68,70,106,110,979,982,1045,1048],"code-wrapper",{"language":69},"bash",[71,72,76],"pre",{"className":73,"code":74,"language":69,"meta":75,"style":75},"language-bash shiki shiki-themes github-light github-dark","brew tap dart-lang\u002Fdart\nbrew install dart\n","",[77,78,79,95],"code",{"__ignoreMap":75},[80,81,84,88,92],"span",{"class":82,"line":83},"line",1,[80,85,87],{"class":86},"sIsaT","brew",[80,89,91],{"class":90},"sJ6F3"," tap",[80,93,94],{"class":90}," dart-lang\u002Fdart\n",[80,96,98,100,103],{"class":82,"line":97},2,[80,9