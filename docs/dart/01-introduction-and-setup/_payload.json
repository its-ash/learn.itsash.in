902,905,906],{},[77,903,904],{},"dart run"," vs ",[77,907,908],{},"dart file.dart",[77,910,904],{}," (no arg) runs ",[77,913,914],{},"bin\u002F\u003Cpackage_name>.dart",[77,916,917],{},"dart run path\u002Fto\u002Ffile.dart"," runs a specific file. ",[77,920,908],{}," (no ",[77,923,924],{},"run",") is the older form.",[26,927,928,444,933,936,937,940],{},[29,929,930,932],{},[77,931,524],{}," allows patch and minor, not major",[77,934,935],{},"^1.2.3"," = ",[77,938,939],{},">=1.2.3 \u003C2.0.0",". A 2.0 release is breaking and won't be chosen.",[18,942,944],{"id":943},"spot-the-bug","🧠 Spot the Bug",[14,946,947],{},"A developer runs their first Dart program, but gets an error:",[67,949,950],{"language":170},[71,951,953],{"className":190,"code":952,"language":170,"meta":75,"style":75},"void main() {\n    print(\"Hello, Dart!\")\n}\n",[77,954,955,963,975],{"__ignoreMap":75},[80,956,957,959,961],{"class":82,"line":83},[80,958,199],{"class":198},[80,960,202],{"class":86},[80,962,206],{"class":205},[80,964,965,967,969,972],{"class":82,"line":97},[80,966,211],{"class":86},[80,968,214],{"class":205},[80,970,971],{"class":90},"\"Hello, Dart!\"",[80,973,974],{"class":205},")\n",[80,976,977],{"class":82,"line":223},[80,978,226],{"class":205},[14,980,981],{},"What's wrong?",[983,984,985,989,1006,1009,1036],"details",{},[986,987,988],"summary",{},"Answer",[14,990,991,992,995,996,998,999,1001,1002,1005],{},"Missing semicolon after ",[77,993,994],{},"print(...)",". Dart statements end with ",[77,997,261],{}," (like C\u002FJava\u002FJS). The compiler expects a ",[77,1000,261],{}," after the ",[77,1003,1004],{},"print(\"Hello, Dart!\")"," statement.",[14,1007,1008],{},"The fix:",[71,1010,1012],{"className":190,"code":1011,"language":170,"meta":75,"style":75},"void main() {\n    print(\"Hello, Dart!\");\n}\n",[77,1013,1014,1022,1032],{"__ignoreMap":75},[80,1015,1016,1018,1020],{"class":82,"line":83},[80,1017,199],{"class":198},[80,1019,202],{"class":86},[80,1021,206],{"class":205},[80,1023,1024,1026,1028,1030],{"class":82,"line":97},[80,1025,211],{"class":86},[80,1027,214],{"class":205},[80,1029,971],{"class":90},[80,1031,220],{"class":205},[80,1033,1034],{"class":82,"line":223},[80,1035,226],{"class":205},[14,1037,1038,1041,1042,1044],{},[29,1039,1040],{},"The lesson",": Dart is a C-family language — statements end with semicolons. Forgetting the ",[77,1043,261],{}," is a common error for developers coming from Python or Go (which don't require them).",[18,1046,1047],{"id":986},"Summary",[14,1049,1050,1051,1053,1054,1056,1057,1056,1059,1061],{},"You installed the Dart SDK, ran your first program, understand AOT vs JIT, project structure, ",[77,1052,341],{}," for packages, and the tooling (",[77,1055,606],{},", ",[77,1058,598],{},[77,1060,617],{},"). Next: variables and data types.",[1063,1064,1065],"style",{},"html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki