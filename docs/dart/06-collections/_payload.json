38,2339,2342,2343,2347,2348,2350,2351,1507,2353,2355,2356,2359,2360,2362,2363,2366,2367,2370,2371,2373],{},[18,2340,2341],{},"sort()"," sorts the list ",[2344,2345,2346],"em",{},"in-place"," and returns ",[18,2349,2116],{}," (not the sorted list). So ",[18,2352,2123],{},[18,2354,2116],{},", and ",[18,2357,2358],{},"print(sorted)"," prints ",[18,2361,1495],{}," (or errors, depending on context). The original ",[18,2364,2365],{},"numbers"," is sorted to ",[18,2368,2369],{},"[1, 2, 3]",", but ",[18,2372,2123],{}," doesn't hold it.",[14,2375,2376],{},"The fix — sort a copy, or sort in-place then use the original:",[40,2378,2380],{"className":42,"code":2379,"language":38,"meta":44,"style":44},"\u002F\u002F Option 1: sort a copy\nvar numbers = [3, 1, 2];\nvar sorted = [...numbers]..sort();   \u002F\u002F spread to copy, cascade sort\nprint(sorted);   \u002F\u002F [1, 2, 3]\nprint(numbers);  \u002F\u002F [3, 1, 2] (unchanged)\n\n\u002F\u002F Option 2: sort in-place, use the original\nvar numbers = [3, 1, 2];\nnumbers.sort();\nprint(numbers);  \u002F\u002F [1, 2, 3]\n",[18,2381,2382,2387,2409,2427,2436,2446,2450,2455,2477,2486],{"__ignoreMap":44},[48,2383,2384],{"class":50,"line":51},[48,2385,2386],{"class":137},"\u002F\u002F Option 1: sort a copy\n",[48,2388,2389,2391,2393,2395,2397,2399,2401,2403,2405,2407],{"class":50,"line":86},[48,2390,55],{"class":54},[48,2392,59],{"class":58},[48,2394,62],{"class":54},[48,2396,65],{"class":58},[48,2398,80],{"class":68},[48,2400,72],{"class":58},[48,2402,69],{"class":68},[48,2404,72],{"class":58},[48,2406,75],{"class":68},[48,2408,83],{"class":58},[48,2410,2411,2413,2415,2417,2420,2422,2424],{"class":50,"line":115},[48,2412,55],{"class":54},[48,2414,2305],{"class":58},[48,2416,62],{"class":54},[48,2418,2419],{"class":58}," [...numbers]..",[48,2421,484],{"class":161},[48,2423,1842],{"class":58},[48,2425,2426],{"class":137},"\u002F\u002F spread to copy, cascade sort\n",[48,2428,2429,2431,2433],{"class":50,"line":141},[48,2430,2320],{"class":161},[48,2432,2323],{"class":58},[48,2434,2435],{"class":137},"\u002F\u002F [1, 2, 3]\n",[48,2437,2438,2440,2443],{"class":50,"line":249},[48,2439,2320],{"class":161},[48,2441,2442],{"class":58},"(numbers);  ",[48,2444,2445],{"class":137},"\u002F\u002F [3, 1, 2] (unchanged)\n",[48,2447,2448],{"class":50,"line":258},[48,2449,874],{"emptyLinePlaceholder":873},[48,2451,2452],{"class":50,"line":278},[48,2453,2454],{"class":137},"\u002F\u002F Option 2: sort in-place, use the original\n",[48,2456,2457,2459,2461,2463,2465,2467,2469,2471,2473,2475],{"class":50,"line":300},[48,2458,55],{"class":54},[48,2460,59],{"class":58},[48,2462,62],{"class":54},[48,2464,65],{"class":58},[48,2466,80],{"class":68},[48,2468,72],{"class":58},[48,2470,69],{"class":68},[48,2472,72],{"class":58},[48,2474,75],{"class":68},[48,2476,83],{"class":58},[48,2478,2479,2482,2484],{"class":50,"line":318},[48,2480,2481],{"class":58},"numbers.",[48,2483,484],{"class":161},[48,2485,2315],{"class":58},[48,2487,2488,2490,2492],{"class":50,"line":335},[48,2489,2320],{"class":161},[48,2491,2442],{"class":58},[48,2493,2435],{"class":137},[14,2495,2496,2499,2500,2503],{},[18,2497,2498],{},"[...numbers]"," creates a copy (spread), and ",[18,2501,2502],{},"..sort()"," (cascade) sorts it and returns the list. This gives a sorted copy without mutating the original.",[14,2505,2506,2509,2510,2513,2514,2516,2517,2520,2521,2523,2524,1558],{},[1959,2507,2508],{},"The lesson",": Dart's ",[18,2511,2512],{},"List.sort()"," is in-place and returns ",[18,2515,2116],{}," (like Java, unlike Python's ",[18,2518,2519],{},"sorted()","). To get a sorted copy, spread to a new list and cascade-sort: ",[18,2522,2129],{},". Don't assign the result of ",[18,2525,2341],{},[31,2527,2528],{"id":2334},"Summary",[14,2530,2531,2532,2534,2535,721,2537,721,2539,721,2541,2543,2544,2546,2547,2549,2550,2553,2554,2556,2557,2559,2560,72,2562,2564,2565,2567,2568,2570],{},"You can use ",[18,2533,20],{}," (access, methods, ",[18,2536,399],{},[18,2