"depth":87,"text":2384},"setUp and tearDown",{"id":949,"depth":87,"text":950},{"id":1151,"depth":87,"text":2387},"Mocking with mockito",{"id":1394,"depth":87,"text":2389},"Mocking with mocktail (simpler)",{"id":1594,"depth":87,"text":1595},{"id":1722,"depth":87,"text":1723},{"id":1740,"depth":87,"text":1741},{"id":1773,"depth":87,"text":1774},{"id":1841,"depth":87,"text":1842},{"id":1924,"depth":87,"text":1925},{"id":2083,"depth":87,"text":2084},{"id":2148,"depth":87,"text":2329},"Dart's test package provides a clean testing framework. Tests go in test\u002F and run with dart test.","md",{},"\u002Fdart\u002F14-testing",{"title":5,"description":2398},"dart\u002F14-testing","2NwEhzphpspGUx9SJInVHvGfjpEr3snfrwJU27uxDS0",1787401090721]