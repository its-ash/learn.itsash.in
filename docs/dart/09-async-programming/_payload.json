 APIs).",[44,1592,1594,797,1596],{"id":1593},"future-vs-stream",[15,1595,17],{},[15,1597,36],{},[280,1599,1600,1607],{},[283,1601,1602,1606],{},[55,1603,1604],{},[15,1605,506],{}," — one value, eventually (or an error). Like a Promise.",[283,1608,1609,1615],{},[55,1610,36,1611],{},[1612,1613,1614],"t",{},"`"," — multiple values over time (or an error). Like an Observable\u002FAsyncIterator.",[28,1617,1618,1619,1621,1622,1624],{},"Use ",[15,1620,17],{}," for one-shot operations (HTTP request, file read). Use ",[15,1623,36],{}," for ongoing sequences (clicks, WebSocket messages, sensor data).",[44,1626,1628],{"id":1627},"zones","Zones",[28,1630,1631,1632,1635],{},"Zones are an advanced feature — an execution context that intercepts async errors, timers, etc. Rarely used directly; ",[15,1633,1634],{},"runZonedGuarded"," catches uncaught async errors:",[71,1637,1638],{"language":73},[75,1639,1641],{"className":77,"code":1640,"language":73,"meta":79,"style":79},"runZonedGuarded(() {\n    \u002F\u002F async code\n}, (error, stack) {\n    print('Uncaught: $error');\n});\n",[15,1642,1643,1650,1655,1660,1677],{"__ignoreMap":79},[83,1644,1645,1647],{"class":85,"line":86},[83,1646,1634],{"class":102},[83,1648,1649],{"class":92},"(() {\n",[83,1651,1652],{"class":85,"line":109},[83,1653,1654],{"class":265},"    \u002F\u002F async code\n",[83,1656,1657],{"class":85,"line":153},[83,1658,1659],{"class":92},"}, (error, stack) {\n",[83,1661,1662,1664,1666,1669,1671,1673,1675],{"class":85,"line":159},[83,1663,254],{"class":102},[83,1665,125],{"class":92},[83,1667,1668],{"class":146},"'Uncaught: ",[83,1670,203],{"class":146},[83,1672,238],{"class":89},[83,1674,209],{"class":146},[83,1676,150],{"class":92},[83,1678,1679],{"class":85,"line":166},[83,1680,1681],{"class":92},"});\n",[44,1683,1685],{"id":1684},"tips-tricks","💡 Tips & Tricks",[280,1687,1688,1708,1723,1742,1756],{},[283,1689,1690,1693,1694,22,1696,1698,1699,1701,1702,1704,1705,1707],{},[55,1691,1692],{},"Idiom",": use ",[15,1695,21],{},[15,1697,25],{}," (not ",[15,1700,818],{}," chains) — linear, readable async code. ",[15,1703,25],{}," makes the code look synchronous while staying non-blocking. Use ",[15,1706,818],{}," only for simple one-step chains.",[283,1709,1710,1693,1712,1714,1715,1718,1719,1722],{},[55,1711,1692],{},[15,1713,626],{}," for parallel async operations — ",[15,1716,1717],{},"await Future.wait([fetchA(), fetchB()])"," runs both in parallel and waits for all. Much faster than ",[15,1720,1721],{},"await fetchA(); await fetchB();"," (sequential).",[283,1724,1725,1693,1727,22,1729,809,1731,1733,1734,1737,1738,1741],{},[55,1726,1692],{},[15,1728,780],{},[15,1730,728],{},[15,1732,25],{}," for error handling — ",[15,1735,1736],{},"try { await f() } on SpecificError catch (e) { ... }",". Clearer than ",[15,1739,1740],{},".catchError()",". Catch specific exceptions first.",[283,1743,1744,1693,1746,1748,1749,1751,1752,1755],{},[55,1745,1692],{},[15,1747,36],{}," for multi-shot async sequences — clicks, WebSocket messages, sensor data. Use ",[15,1750,17],{}," for one-shot (HTTP). ",[15,1753,1754],{},"await for (var x in stream)"," is the clean way to consume a stream sequentially.",[283,1757,1758,1693,1760,1762,1763,1765,1766,1769],{},[55,1759,1692],{},[15,1761,998],{}," + ",[15,1764,1347],{}," for lazy stream generation — ",[15,1767,1768],{},"Stream\u003Cint> gen() async* { for (...) yield i; }"," produces values on demand. Use for sequences that are produced lazily or over time.",[44,1771,1773],{"id":1772},"️-edge-cases-gotchas","⚠️ Edge Cases & Gotchas",[280,1775,1776,1792,1815,1833,1851,1865,1881,1897,1915,1930],{},[283,1777,1778,1783,1784,1787,1788,1791],{},[55,1779,1780,1782],{},[15,1781,25],{}," in a loop is sequential",": ",[15,1785,1786],{},"for (var x in items) await fetch(x)"," runs one at a time. Use ",[15,1789,1790],{},"Future.wait(items.map(fetch))"," for parallel.",[283,1793,1794,1783,1801,1804,1805,1808,1809,1811,1812,1814],{},[55,1795,1796,1798,1799],{},[15,1797,21],{}," function returns ",[15,1800,17],{},[15,1802,1803],{},"int f() async { return 5; }"," returns ",[15,1806,1807],{},"Future\u003Cint>",", not ",[15,1810,983],{},". The ",[15,1813,21],{}," wraps the return.",[283,1816,1817,1783,1825,1828,1829,1832],{},[55,1818,1819,1821,1822,1824],{},[15,1820,21],{}," functions can't return ",[15,1823,169],{}," meaningfully",[15,1826,1827],{},"void f() async { }"," is allowed but the caller can't await or catch errors. Use ",[15,1830,1831],{},"Future\u003Cvoid> f() async { }"," for awaitable.",[283,1834,1835,1783,1840,1843,1844,1846,1847,1850],{},[55,1836,1837,1838],{},"Forgetting ",[15,1839,25],{},[15,1841,1842],{},"fetchUser();"," (no ",[15,1845,25],{},") starts the future but doesn't wait — the result is lost (unawaited future). Use ",[15,1848,1849],{},"unawaited(future)"," to suppress the lint if intentional.",[283,1852,1853,1783,1856,1843,1859,1861,1862,1864],{},[55,1854,1855],{},"Unawaited futures' errors are uncaught",[15,1857,1858],{},"fetchUser()",[15,1860,25],{},") — if it throws, the error is \"uncaught in the zone\" (may crash or be silently swallowed). Always ",[15,1863,25],{}," or handle.",[283,1866,1867,1783,1870,1873,1874,1877,1878,1880],{},[55,1868,1869],{},"Single-subscription streams allow one listener",[15,1871,1872],{},"stream.listen(...)"," twice throws ",[15,1875,1876],{},"StateError",". Use ",[15,1879,1446],{}," for multiple listeners (but broadcast streams can't be paused\u002Fbuffered like single-subscription).",[283,1882,1883,1783,1889,1892,1893,1896],{},[55,1884,1885,1888],{},[15,1886,1887],{},"Stream.toList()"," waits for close",[15,1890,1891],{},"stream.toList()"," returns a ",[15,1894,1895],{},"Future\u003CList>"," that completes when the stream closes. For an infinite stream, it never completes.",[283,1898,1899,1783,1904,1907,1908,1910,1911,1914],{},[55,1900,1901,1903],{},[15,1902,1257],{}," blocks until the stream closes",[15,1905,1906],{},"await for (var x in stream) { ... }"," doesn't exit until the stream closes (or ",[15,1909,1309],{},"). For an infinite stream, use ",[15,1912,1913],{},".listen()"," instead.",[283,1916,1917,1922,1923,1925,1926,951,1928,954],{},[55,1918,1919,1921],{},[15,1920,863],{}," for callback-based APIs",": when a library gives you a callback, use a ",[15,1924,863],{}," to bridge to a ",[15,1927,17],{},[15,1929,17],{},[283,1931,1932,1783,1937,1804,1940,1943],{},[55,1933,1934,1936],{},[15,1935,626],{}," preserves order",[15,1938,1939],{},"Future.wait([a, b])",[15,1941,1942],{},"[resultA, resultB]"," in the same order as the input, regardless of which completes first.",[44,1945,1947],{"id":1946},"spot-the-bug","🧠 Spot the Bug",[28,1949,1950],{},"A developer fetches three URLs sequentially, making the page slow:",[71,1952,1953],{"language":73},[75,1954,1956],{"className":77,"code":1955,"language":73,"meta":79,"style":79},"Future\u003Cvoid> main() async {\n    var a = await fetch('url-a');\n    var b = await fetch('url-b');\n    var c = await fetch('url-c');\n    print([a, b, c]);\n}\n",[15,1957,1958,1976,1996,2016,2036,2043],{"__ignoreMap":79},[83,1959,1960,1962,1964,1966,1968,1970,1972,1974],{"class":85,"line":86},[83,1961,17],{"class":89},[83,1963,93],{"class":92},[83,1965,169],{"class":112},[83,1967,99],{"class":92},[83,1969,418],{"class":102},[83,1971,359],{"class":92},[83,1973,21],{"class":112},[83,1975,364],{"class":92},[83,1977,1978,1980,1983,1985,1987,1989,1991,1994],{"class":85,"line":109},[83,1979,439],{"class":112},[83,1981,1982],{"class":92}," a ",[83,1984,445],{"class":112},[83,1986,448],{"class":112},[83,1988,568],{"class":102},[83,1990,125],{"class":92},[83,1992,1993],{"class":146},"'url-a'",[83,1995,150],{"class":92},[83,1997,1998,2000,2003,2005,2007,2009,2011,2014],{"class":85,"line":153},[83,1999,439],{"class":112},[83,2001,2002],{"class":92}," b ",[83,2004,445],{"class":112},[83,2006,448],{"class":112},[83,2008,568],{"class":102},[83,2010,125],{"class":92},[83,2012,2013],{"class":146},"'url-b'",[83,2015,150],{"class":92},[83,2017,2018,2020,2023,2025,2027,2029,2031,2034],{"class":85,"line":159},[83,2019,439],{"class":112},[83,2021,2022],{"class":92}," c ",[83,2024,445],{"class":112},[83,2026,448],{"class":112},[83,2028,568],{"class":102},[83,2030,125],{"class":92},[83,2032,2033],{"class":146},"'url-c'",[83,2035,150],{"class":92},[83,2037,2038,2040],{"class":85,"line":166},[83,2039,254],{"class":102},[83,2041,2042],{"class":92},"([a, b, c]);\n",[83,2044,2045],{"class":85,"line":177},[83,2046,156],{"class":92},[28,2048,2049],{},"What's wrong and how to fix it?",[2051,2052,2053,2057,2064,2070,2163,2166,2172],"details",{},[2054,2055,2056],"summary",{},"Answer",[28,2058,2059,2060,2063],{},"The three ",[15,2061,2062],{},"fetch"," calls are sequential — each waits for the previous to complete. If each takes 1 second, the total is 3 seconds. The fetches are independent (no dependency between them), so they should run in parallel.",[28,2065,2066,2067,2069],{},"The fix — use ",[15,2068,626],{}," to run them in parallel:",[75,2071,2073],{"className":77,"code":2072,"language":73,"meta":79,"style":79},"Future\u003Cvoid> main() async {\n    var results = await Future.wait([\n        fetch('url-a'),\n        fetch('url-b'),\n        fetch('url-c'),\n    ]);\n    print(results);   \u002F\u002F [a, b, c] in input order\n}\n",[15,2074,2075,2093,2112,2124,2134,2144,2149,2159],{"__ignoreMap":79},[83,2076,2077,2079,2081,2083,2085,2087,2089,2091],{"class":85,"line":86},[83,2078,17],{"class":89},[83,2080,93],{"class":92},[83,2082,169],{"class":112},[83,2084,99],{"class":92},[83,2086,418],{"class":102},[83,2088,359],{"class":92},[83,2090,21],{"class":112},[83,2092,364],{"class":92},[83,2094,2095,2097,2099,2101,2103,2105,2107,2109],{"class":85,"line":109},[83,2096,439],{"class":112},[83,2098,598],{"class":92},[83,2100,445],{"class":112},[83,2102,448],{"class":112},[83,2104,116],{"class":89},[83,2106,119],{"class":92},[83,2108,609],{"class":102},[83,2110,2111],{"class":92},"([\n",[83,2113,2114,2117,2119,2121],{"class":85,"line":153},[83,2115,2116],{"class":102},"        fetch",[83,2118,125],{"class":92},[83,2120,1993],{"class":146},[83,2122,2123],{"class":92},"),\n",[83,2125,2126,2128,2130,2132],{"class":85,"line":159},[83,2127,2116],{"class":102},[83,2129,125],{"class":92},[83,2131,2013],{"class":146},[83,2133,2123],{"class":92},[83,2135,2136,2138,2140,2142],{"class":85,"line":166},[83,2137,2116],{"class":102},[83,2139,125],{"class":92},[83,2141,2033],{"class":146},[83,2143,2123],{"class":92},[83,2145,2146],{"class":85,"line":177},[83,2147,2148],{"class":92},"    ]);\n",[83,2150,2151,2153,2156],{"class":85,"line":192},[83,2152,254],{"class":102},[83,2154,2155],{"class":92},"(results);   ",[83,2157,2158],{"class":265},"\u002F\u002F [a, b, c] in input order\n",[83,2160,2161],{"class":85,"line":214},[83,2162,156],{"class":92},[28,2164,2165],{},"::\nNow all three fetches start immediately and run concurrently. The total time is ~1 second (the slowest one), not 3 seconds.",[28,2167,2168,2169,2171],{},"If the fetches depend on each other (b needs a's result), keep them sequential. But for independent operations, ",[15,2170,626],{}," is much faster.",[28,2173,2174,2177,2178,2180,2181,2184],{},[55,2175,2176],{},"The lesson",": sequential ",[15,2179,25],{},"s are sequential — each waits for the previous. For independent async operations, use ",[15,2182,2183],{},"Future.wait([...])"," to run them in parallel. The result order matches the input order, regardless of completion order.",[44,2186,2187],{"id":2054},"Summary",[28,2189,2190,2191,2193,2194,18,2197,2200,2201,22,2203,2205,2206,22,2208,18,2210,2212,2213,2215,2216,2218,2219,18,2222,18,2224,22,2226,2228,2229,2200,2231,2233,2234,2236],{},"You can use ",[15,2192,17],{}," (constructors, ",[15,2195,2196],{},".then",[15,2198,2199],{},".catchError","), ",[15,2202,21],{},[15,2204,25],{}," (linear async, error handling with ",[15,2207,780],{},[15,2209,728],{},[15,2211,626],{}," for parallel, ",[15,2214,25],{}," in loops), ",[15,2217,36],{}," (async sequences, ",[15,2220,2221],{},".listen",[15,2223,1257],{},[15,2225,998],{},[15,2227,1347],{},", single-subscription vs broadcast, ",[15,2230,1501],{},[15,2232,863],{}," for callback bridges, and ",[15,2235,1634],{}," for uncaught errors — with the sequential-await and unawaited-future traps avoided. Next: isolates and concurrency.",[2238,2239,2240],"style",{},"html pre.shiki code .snvgF, html code.shiki .snvgF{--shiki-default:#005CC5;--shiki-github-dark:#79B8FF}html pre.shiki code .ssxIu, html code.shiki .ssxIu{--shiki-default:#24292E;--shiki-github-dark:#E1E4E8}html pre.shiki code .sIsaT, html code.shiki .sIsaT{--shiki-default:#6F42C1;--shiki-github-dark:#B392F0}html pre.shiki code .svdQ7, html code.shiki .svdQ7{--shiki-default:#D73A49;--shiki-github-dark:#F97583}html pre.shiki code .sJ6F3, html code.shiki .sJ6F3{--shiki-default:#032F62;--shiki-github-dark:#9ECBFF}html pre.shiki code .sdCPZ, html code.shiki .sdCPZ{--shiki-default:#6A737D;--shiki-github-dark:#6A737D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}html.github-dark .shiki span {color: var(--shiki-github-dark);background: var(--shiki-github-dark-bg);font-style: var(--shiki-github-dark-font-style);font-weight: var(--shiki-github-dark-font-weight);text-decoration: var(--shiki-github-dark-text-decoration);}",{"title":79,"searchDepth":109,"depth":109,"links":2242},[2243,2244,2248,2253,2257,2258,2265,2266,2268,2269,2270,2271,2272],{"id":46,"depth":109,"text":47},{"id":61,"depth":109,"text":17,"children":2245},[2246],{"id":275,"depth":153,"text":2247},"Future constructors",{"id":322,"depth":109,"text":2249,"children":2250},"async \u002F await",[2251],{"id":520,"depth":153,"text":2252},"await in a loop",{"id":630,"depth":109,"text":631,"children":2254},[2255],{"id":793,"depth":153,"text":2256},"Future.catchError vs try\u002Fcatch",{"id":860,"depth":109,"text":863},{"id":957,"depth":109,"text":36,"children":2259},[2260,2261,2262,2264],{"id":1133,"depth":153,"text":1134},{"id":1254,"depth":153,"text":1257},{"id":1333,"depth":153,"text":2263},"async* generators",{"id":1428,"depth":153,"text":1429},{"id":1498,"depth":109,"text":1501},{"id":1593,"depth":109,"text":2267},"Future vs Stream",{"id":1627,"depth":109,"text":1628},{"id":1684,"depth":109,"text":1685},{"id":1772,"depth":109,"text":1773},{"id":1946,"depth":109,"text":1947},{"id":2054,"depth":109,"text":2187},"Dart is single-threaded with an event loop. Asynchronous code uses Future (one-shot) and Stream (multi-shot), with async\u002Fawait syntax.","md",{},"\u002Fdart\u002F09-async-programming",{"title":5,"description":2273},"dart\u002F09-async-programming","jTqtasx38X65aBaBxraloAMJ5MHCV3r7dNv9ehk14a0",1787401090667]